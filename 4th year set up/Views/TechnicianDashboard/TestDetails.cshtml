@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model _4th_year_set_up.Models.TestItem
@using _4th_year_set_up.Models
@{
    ViewData["Title"] = Model.ReqNum;
    Layout = null;
    var email = ViewBag.Email?.ToString();
    var initial = string.IsNullOrEmpty(email) ? "T" : email.Substring(0, 1).ToUpper();

    var queueActive = !(Model.AssignedToMe && Model.IsInQueue) ? "active" : "";
    var mineActive = (Model.AssignedToMe && Model.IsInQueue) ? "active" : "";
    var sampleActive = "";
    var resultActive = "";


    var flash = TempData["Flash"] as string;
    var flashType = TempData["FlashType"] as string ?? "ok";

    var p = Model.PatientDetails;
    var stageCss = Model.StageCss;
    var tatCss = Model.Tat switch
    {
        TatStatus.Overdue => "badge-overdue",
        TatStatus.NearingTat => "badge-nearing",
        _ => "badge-ontrack"
    };
    var hasPrecautions = !string.IsNullOrWhiteSpace(p.Precautions) && !p.Precautions.StartsWith("None");
    var lastEvent = Model.LastEvent;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.ReqNum — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/technician.css" />
</head>
<body>

    @* ===== TOPBAR + SIDEBAR: identical to Index.cshtml. Only the "active" class moves. ===== *@
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">NMB-HLabSys<span>Haematology Lab System</span></div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@initial</div>
                <span class="user-email">@email</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">
        <aside class="sidebar">
            <a asp-controller="TechnicianDashboard" asp-action="Index" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10.5L12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" /><path d="M9 21v-6h6v6" /></svg>
                Dashboard
            </a>

            <div class="nav-label">Samples and Requests</div>
            <a asp-controller="TechnicianDashboard" asp-action="ReceiveSamples" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6" /><polyline points="16 6 12 10 8 6" /><line x1="12" y1="10" x2="12" y2="2" /></svg>
                Receive Samples
            </a>

            <a asp-controller="TechnicianDashboard" asp-action="SampleVerification" class="nav-item @sampleActive">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 2v6.5L4.5 17a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L15 8.5V2" /><polyline points="9 14 11 16 15 12" /></svg>
                Sample Verification
            </a>

            <div class="nav-label">Tests</div>
            <a asp-controller="TechnicianDashboard" asp-action="TestQueue" class="nav-item @queueActive">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 2v6.5L4.5 17a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L15 8.5V2" /><line x1="9" y1="2" x2="15" y2="2" /></svg>
                Testing Queue
            </a>
            <a asp-controller="TechnicianDashboard" asp-action="MyTests" class="nav-item @mineActive">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                My Tests
            </a>

            <div class="nav-label">Results</div>
            <a asp-controller="TechnicianDashboard" asp-action="CaptureResults" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="2" /><line x1="8" y1="8" x2="16" y2="8" /><line x1="8" y1="12" x2="16" y2="12" /><line x1="8" y1="16" x2="13" y2="16" /></svg>
                Capture Results
            </a>
            <a asp-controller="TechnicianDashboard" asp-action="Verification" class="nav-item @resultActive">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="9 12 11 14 15 10" /></svg>
                Result Verification
            </a>
            <a asp-controller="TechnicianDashboard" asp-action="ReleaseResults" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13" /><path d="M22 2l-7 20-4-9-9-4 20-7z" /></svg>
                Release Results
            </a>

            <div class="nav-label">Reports</div>
            <a asp-controller="TechnicianDashboard" asp-action="Reports" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="19" x2="20" y2="19" /><rect x="5" y="10" width="3" height="7" /><rect x="10.5" y="6" width="3" height="11" /><rect x="16" y="3" width="3" height="14" /></svg>
                Reporting
            </a>

            <div class="nav-label">System</div>
            <a asp-controller="TechnicianDashboard" asp-action="Profile" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                Profile
            </a>
        </aside>
        @* ===== END shared topbar + sidebar ===== *@

        <main class="main">

            @if (!string.IsNullOrEmpty(flash))
            {
                <div class="flash flash-@flashType" role="status">@flash</div>
            }


            <div class="detail-head">
                <div>
                    <h1>@Model.ReqNum — @Model.Test</h1>
                    <div class="detail-badges">
                        <span class="badge @(Model.IsUrgent ? "badge-urgent" : "badge-routine")">@(Model.IsUrgent ? "Urgent" : "Routine")</span>
                        @if (Model.IsActive)
                        {
                            <span class="badge @tatCss">@Model.TatLabel</span>
                        }
                        <span class="badge @stageCss">@Model.StageLabel</span>
                        @if (Model.AssignedToMe && Model.IsInQueue)
                        {
                            <span class="badge badge-mine" style="margin-left:0">Mine</span>
                        }
                        <span class="due-text" style="align-self:center">@Model.DueText</span>
                    </div>
                </div>
                <div class="detail-actions">
                    <a class="btn btn-ghost" href="javascript:history.back()">← Back</a>
                    <partial name="_TestActions" model="Model" />
                </div>
            </div>

            @if (Model.InMultiTestRequest || Model.Request.IsReleased)
            {
                <div class="card sibling-strip">
                    <div class="sibling-title">@(Model.InMultiTestRequest ? "Also on " + Model.ReqNum : Model.ReqNum)</div>
                    @foreach (var sib in Model.Request.Tests)
                    {
                        if (sib == Model)
                        {
                            <span class="sibling-chip sibling-current">@sib.Test · @sib.StageLabel <em>(this test)</em></span>
                        }
                        else
                        {
                            <a class="sibling-chip" asp-controller="TechnicianDashboard" asp-action="TestDetails" asp-route-id="@sib.TestId">@sib.Test · @sib.StageLabel</a>
                        }
                    }
                    <div class="sibling-note @(Model.Request.IsReadyToRelease ? "sibling-ok" : Model.Request.IsHeld ? "sibling-held" : "")">
                        @if (Model.Request.IsReleased)
                        {
                            <text>Released on @Model.Request.ReleasedAt?.ToString("dd MMM yyyy, HH:mm")</text>
                        }
                        else if (Model.Request.IsReadyToRelease)
                        {
                            <text>Every test is verified. Ready to release.</text>
                        }
                        else if (Model.Request.IsHeld)
                        {
                            <text>Release held: @Model.Request.HoldReason. Results go out together.</text>
                        }
                        else
                        {
                            <text>Results are released together once every test is verified.</text>
                        }
                    </div>
                </div>
            }

            <div class="confidential">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                Confidential patient information — use only for processing this request.
            </div>

            @if (Model.Stage == TestStage.ToBeReviewed && !string.IsNullOrWhiteSpace(Model.ReviewNote))
            {
                <div class="alert-box alert-review"><strong>Returned for review</strong>@Model.ReviewNote</div>
            }
            @if (Model.Stage == TestStage.SampleRejected && !string.IsNullOrWhiteSpace(Model.SampleRejectReason))
            {
                <div class="alert-box alert-danger"><strong>Sample rejected</strong>@Model.SampleRejectReason</div>
            }
            @if (hasPrecautions)
            {
                <div class="alert-box"><strong>Handling precautions</strong>@p.Precautions</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SampleCondition) && Model.SampleCondition != "Acceptable")
            {
                <div class="alert-box"><strong>Sample condition</strong>@Model.SampleCondition</div>
            }

            <div class="detail-grid">

                <div class="card">
                    <div class="detail-card-title">Patient</div>
                    <dl class="info-list">
                        <dt>Name</dt><dd>@p.FirstName</dd>
                        <dt>Surname</dt><dd>@p.Surname</dd>
                        <dt>Patient ID</dt><dd>@p.PatientId</dd>
                        <dt>Date of birth</dt><dd>@p.DateOfBirth.ToString("dd MMM yyyy") (@p.Age years)</dd>
                        <dt>Sex</dt><dd>@p.Sex</dd>
                        @if (p.IsPregnant.HasValue)
                        {
                            <dt>Pregnant</dt><dd>@(p.IsPregnant.Value ? "Yes" : "No")</dd>
                        }
                        <dt>Allergies</dt><dd>@p.Allergies</dd>
                        <dt>Fasting</dt><dd>@p.FastingStatus</dd>
                    </dl>
                </div>

                <div class="card">
                    <div class="detail-card-title">Request &amp; sample</div>
                    <dl class="info-list">
                        <dt>Test</dt><dd>@Model.Test</dd>
                        <dt>Requested by</dt><dd>@Model.RequestingDoctor</dd>
                        <dt>Ward / clinic</dt><dd>@Model.Ward</dd>
                        <dt>Sample type</dt><dd>@Model.SampleType</dd>
                        <dt>Tube</dt><dd>@Model.Tube</dd>
                        <dt>Collected</dt><dd>@Model.CollectedAt.ToString("dd MMM yyyy, HH:mm")</dd>
                        <dt>Received</dt><dd>@Model.ReceivedAt.ToString("dd MMM yyyy, HH:mm")</dd>
                        <dt>Sample condition</dt><dd>@Model.SampleCondition</dd>
                    </dl>
                </div>

                <div class="card">
                    <div class="detail-card-title">Medical condition</div>
                    <p style="font-size:0.88rem; line-height:1.5;">@p.Conditions</p>
                    <div class="detail-card-title" style="margin-top:20px;">Previous result</div>
                    <p style="font-size:0.88rem;">@(string.IsNullOrWhiteSpace(Model.PreviousResult) ? "None on record" : Model.PreviousResult)</p>
                </div>

                <div class="card">
                    <div class="detail-card-title">Current medication</div>
                    @if (p.Medications.Count == 0)
                    {
                        <p style="font-size:0.85rem; color:var(--muted);">No medication recorded.</p>
                    }
                    else
                    {
                        <ul class="med-list">
                            @foreach (var m in p.Medications)
                            {
                                <li>
                                    <strong>@m.Name</strong> <span class="med-dose">— @m.Dose</span>
                                    @if (!string.IsNullOrWhiteSpace(m.LabNote))
                                    {
                                        <span class="med-note">@m.LabNote</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>

                <div class="card span-2">
                    <div class="detail-card-title">Verification record</div>
                    <dl class="info-list">
                        <dt>Sample</dt>
                        <dd>
                            @if (Model.Stage == TestStage.AwaitingSampleVerification)
                            {
                                <text>Not yet verified</text>
                            }
                            else if (Model.Stage == TestStage.SampleRejected)
                            {
                                <text>Rejected by @TechnicianNames.Of(Model.SampleVerifiedBy) on @Model.SampleVerifiedAt?.ToString("dd MMM yyyy, HH:mm")</text>
                            }
                            else
                            {
                                <text>Verified by @TechnicianNames.Of(Model.SampleVerifiedBy) on @Model.SampleVerifiedAt?.ToString("dd MMM yyyy, HH:mm")</text>
                            }
                        </dd>
                        <dt>Result</dt>
                        <dd>
                            @if (Model.Stage == TestStage.Verified)
                            {
                                <text>Verified by @TechnicianNames.Of(Model.VerifiedBy) on @Model.VerifiedAt?.ToString("dd MMM yyyy, HH:mm")</text>
                            }
                            else if (Model.Stage == TestStage.Complete)
                            {
                                <text>Captured by @TechnicianNames.Of(Model.CapturedBy). Awaiting verification.</text>
                            }
                            else if (Model.Stage == TestStage.ToBeReviewed)
                            {
                                <text>Returned to @TechnicianNames.Of(Model.CapturedBy) for review.</text>
                            }
                            else
                            {
                                <text>No results captured yet</text>
                            }
                        </dd>
                    </dl>

                    @if (Model.Results.Count > 0)
                    {
                        <div class="table-wrap" style="margin-top:16px;">
                            <table class="table">
                                <thead><tr><th>Parameter</th><th>Result</th><th>Unit</th><th>Reference range</th><th>Flag</th></tr></thead>
                                <tbody>
                                    @foreach (var r in Model.Results)
                                    {
                                        <tr>
                                            <td>@r.Parameter</td>
                                            <td><strong>@r.Value</strong></td>
                                            <td>@r.Unit</td>
                                            <td>@r.Range</td>
                                            <td><span class="badge @r.FlagCss">@r.Flag</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="card span-2">
                    <div class="detail-card-title">Clinical notes from requester</div>
                    <div class="notes-box">@Model.ClinicalNotes</div>
                </div>

                @* ===== HISTORY: collapsed to one line by default; expands to the full audit trail ===== *@
                <div class="card span-2 history-card">
                    <details class="history">
                        <summary>
                            <span class="detail-card-title">History</span>
                            @if (lastEvent != null)
                            {
                                <span class="history-last">@lastEvent.Action · @TechnicianNames.Of(lastEvent.By) · @lastEvent.At.ToString("dd MMM HH:mm")</span>
                            }
                            else
                            {
                                <span class="history-last">No activity recorded yet</span>
                            }
                            @if (Model.History.Count > 0)
                            {
                                <span class="badge badge-review history-attempt">Attempt @Model.Attempt</span>
                            }
                            <span class="history-toggle" aria-hidden="true"></span>
                        </summary>

                        <ol class="timeline">
                            @foreach (var e in Model.Timeline)
                            {
                                <li class="tl-item @e.ToneCss">
                                    <span class="tl-time">@e.At.ToString("dd MMM, HH:mm")</span>
                                    <span class="tl-dot" aria-hidden="true"></span>
                                    <div class="tl-body">
                                        <div class="tl-head">
                                            <span class="tl-action">@e.Action</span>
                                            @if (e.Attempt.HasValue && Model.History.Count > 0)
                                            {
                                                <span class="tl-tag">Attempt @e.Attempt</span>
                                            }
                                            @if (e.Scope != EventScope.Test)
                                            {
                                                <span class="tl-tag">@(e.Scope == EventScope.Sample ? "Sample" : "Request")</span>
                                            }
                                            <span class="tl-by">@(TechnicianNames.Of(e.By) + (e.By == CurrentUser.Id ? " (you)" : ""))</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(e.Detail))
                                        {
                                            <div class="tl-detail">@e.Detail</div>
                                        }
                                        @if (e.Changes.Count > 0)
                                        {
                                            <ul class="tl-changes">
                                                @foreach (var c in e.Changes)
                                                {
                                                    <li>
                                                        @c.Parameter
                                                        @if (c.From != null)
                                                        {
                                                            <span class="tl-old">@c.From</span>
                                                            <text>→</text>
                                                        }
                                                        <strong>@c.To</strong> @c.Unit
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    </details>
                </div>
            </div>

        </main>
    </div>
</body>
</html>
