@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model System.Collections.Generic.List<_4th_year_set_up.Models.ReceiveRow>
@using _4th_year_set_up.Models
@{
    ViewData["Title"] = "Receive Samples";
    Layout = null;
    var email = ViewBag.Email?.ToString();
    var initial = string.IsNullOrEmpty(email) ? "T" : email.Substring(0, 1).ToUpper();

    var queueActive = "";
    var mineActive = "";
    var sampleActive = "";
    var resultActive = "";

    var flash = TempData["Flash"] as string;
    var flashType = TempData["FlashType"] as string ?? "ok";

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/technician.css" />
    <style>
        .scan-row { display: flex; gap: 10px; flex-wrap: wrap; margin: 6px 0 8px; }
        .scan-input { height: 40px; min-width: 260px; font-size: 15px; }
        .scan-row .btn { height: 40px; padding: 0 20px; }
    </style>
</head>
<body>

    @* ===== TOPBAR + SIDEBAR: identical to Index.cshtml. Only the "active" class moves. ===== *@
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">NMB-HLabSys<span>Haematology Lab System</span></div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@initial</div>
                <span class="user-email">@email</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">
        <aside class="sidebar">
            <a asp-controller="TechnicianDashboard" asp-action="Index" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10.5L12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" /><path d="M9 21v-6h6v6" /></svg>
                Dashboard
            </a>

            <div class="nav-label">Samples and Requests</div>
            <a asp-controller="TechnicianDashboard" asp-action="ReceiveSamples" class="nav-item @sampleActive">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6" /><polyline points="16 6 12 10 8 6" /><line x1="12" y1="10" x2="12" y2="2" /></svg>
                Receive Samples
            </a>

            <a asp-controller="TechnicianDashboard" asp-action="SampleVerification" class="nav-item @sampleActive">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 2v6.5L4.5 17a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L15 8.5V2" /><polyline points="9 14 11 16 15 12" /></svg>
                Sample Verification
            </a>

            <div class="nav-label">Tests</div>
            <a asp-controller="TechnicianDashboard" asp-action="TestQueue" class="nav-item @queueActive">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 2v6.5L4.5 17a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L15 8.5V2" /><line x1="9" y1="2" x2="15" y2="2" /></svg>
                Testing Queue
            </a>
            <a asp-controller="TechnicianDashboard" asp-action="MyTests" class="nav-item @mineActive">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                My Tests
            </a>

            <div class="nav-label">Results</div>
    
            <a asp-controller="TechnicianDashboard" asp-action="Verification" class="nav-item @resultActive">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="9 12 11 14 15 10" /></svg>
                Result Verification
            </a>
            <a asp-controller="TechnicianDashboard" asp-action="ReleaseResults" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13" /><path d="M22 2l-7 20-4-9-9-4 20-7z" /></svg>
                Release Results
            </a>

            <div class="nav-label">Reports</div>
            <a asp-controller="TechnicianDashboard" asp-action="Reports" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="19" x2="20" y2="19" /><rect x="5" y="10" width="3" height="7" /><rect x="10.5" y="6" width="3" height="11" /><rect x="16" y="3" width="3" height="14" /></svg>
                Reporting
            </a>

            <div class="nav-label">System</div>
            <a asp-controller="TechnicianDashboard" asp-action="Profile" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                Profile
            </a>
        </aside>
        @* ===== END shared topbar + sidebar ===== *@

        <main class="main">

            @if (!string.IsNullOrEmpty(flash))
            {
                <div class="flash flash-@flashType" role="status">@flash</div>
            }
            <div class="card">
                <div class="card-header">
                    <div>
                        <div class="card-title">Expected tubes</div>
                        <div class="card-sub">@Model.Count tube@(Model.Count == 1 ? "" : "s") not yet received. Urgent requests first, then oldest collection.</div>
                    </div>
                </div>

                @if (Model.Count == 0)
                {
                    <div class="empty-state">No tubes are waiting to be received. New tubes appear here as soon as a doctor submits a request.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr><th>Barcode</th><th>Request #</th><th>Tests</th><th>Sample</th><th>Priority</th><th>Collected</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model)
                                {
                                    <tr>
                                        <td><strong>@t.Barcode</strong></td>
                                        <td>@t.ReqNum</td>
                                        <td>@t.Tests</td>
                                        <td>@t.Sample</td>
                                        <td><span class="badge @(t.IsUrgent ? "badge-urgent" : "badge-routine")">@t.Priority</span></td>
                                        <td>@t.Waited</td>
                                        <td>
                                            <form method="post" asp-controller="TechnicianDashboard" asp-action="ReceiveSample" class="inline-form">
                                                <input type="hidden" name="barcode" value="@t.Barcode" />
                                                <button type="submit" class="btn btn-primary">Receive</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

        </main>
    </div>

    <div class="modal-overlay" id="rcModal" aria-hidden="true">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="rcTitle">
            <div class="modal-header">
                <div><div class="modal-title" id="rcTitle"></div><div class="card-sub" id="rcSub"></div></div>
                <button type="button" class="modal-close" id="rcClose" aria-label="Close">✕</button>
            </div>
            <div class="detail-card-title">Consumables needed for these tests</div>
            <p class="muted-note" id="rcNone" hidden>No consumables are linked to these tests yet, so there is nothing to check. The tube can be received.</p>
            <div class="table-wrap" id="rcTableWrap" hidden>
                <table class="table">
                    <thead><tr><th>Consumable</th><th>Needed</th><th>In stock</th><th></th></tr></thead>
                    <tbody id="rcRows"></tbody>
                </table>
            </div>
            <div class="alert-box alert-danger" id="rcShort" hidden></div>
            <form method="post" asp-controller="TechnicianDashboard" asp-action="ReceiveSample">
                <input type="hidden" name="barcode" id="rcBarcode" />
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" id="rcCancel">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="rcConfirm">Receive tube</button>
                </div>
            </form>
        </div>
    </div>
    <script>
        (function () {
            var overlay = document.getElementById('rcModal');
            function esc(t) { var d = document.createElement('div'); d.textContent = t == null ? '' : t; return d.innerHTML; }
            function close() { overlay.classList.remove('open'); overlay.setAttribute('aria-hidden', 'true'); }
            document.addEventListener('click', function (e) {
                var b = e.target.closest('.js-receive'); if (!b) return;
                var d = b.dataset, needs = [];
                try { needs = JSON.parse(d.needs || '[]'); } catch (x) { }
                document.getElementById('rcTitle').textContent = 'Receive tube ' + d.barcode;
                document.getElementById('rcSub').textContent = d.req + ' · ' + d.tests + ' · ' + d.sample;
                document.getElementById('rcBarcode').value = d.barcode;
                var rows = document.getElementById('rcRows'), shortList = []; rows.innerHTML = '';
                needs.forEach(function (n) {
                    var short = n.onHand < n.needed;
                    if (short) shortList.push(n.name + ' (need ' + n.needed + ', have ' + n.onHand + ')');
                    rows.insertAdjacentHTML('beforeend', '<tr><td>' + esc(n.name) + '</td><td>' + n.needed + '</td><td><strong>' + n.onHand +
                        '</strong></td><td><span class="badge ' + (short ? 'badge-overdue">Short' : 'badge-ontrack">OK') + '</span></td></tr>');
                });
                document.getElementById('rcNone').hidden = needs.length > 0;
                document.getElementById('rcTableWrap').hidden = needs.length === 0;
                var warn = document.getElementById('rcShort');
                warn.hidden = shortList.length === 0;
                warn.textContent = shortList.length ? 'Not enough stock: ' + shortList.join(', ') + '. Ask the lab manager to restock before receiving this tube.' : '';
                document.getElementById('rcConfirm').disabled = shortList.length > 0;
                overlay.classList.add('open'); overlay.setAttribute('aria-hidden', 'false');
            });
            document.getElementById('rcClose').addEventListener('click', close);
            document.getElementById('rcCancel').addEventListener('click', close);
            overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
        })();
    </script>
</body>
</html>
