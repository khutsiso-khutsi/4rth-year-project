@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Receive Samples";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Receive Samples — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --teal: #0d9488;
            --teal-light: rgba(13,148,136,0.1);
            --orange: #ea580c;
            --orange-light: rgba(234,88,12,0.1);
            --amber: #d97706;
            --amber-light: rgba(217,119,6,0.1);
            --red: #dc2626;
            --red-light: rgba(220,38,38,0.1);
            --green: #16a34a;
            --green-light: rgba(22,163,74,0.1);
            --blue: #2563eb;
            --blue-light: rgba(37,99,235,0.1);
            --purple: #7c3aed;
            --purple-light: rgba(124,58,237,0.1);
            --slate: #475569;
            --slate-light: rgba(71,85,105,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --muted-light: rgba(107,122,153,0.12);
            --border: #dde4f0;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
        }

        .topbar {
            background: var(--navy);
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-logo {
            width: 34px;
            height: 34px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .brand-logo svg {
                width: 18px;
                height: 18px;
                fill: white;
            }

        .brand-name {
            font-family: 'DM Serif Display', serif;
            color: white;
            font-size: 1.1rem;
            line-height: 1.1;
        }

            .brand-name span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.6rem;
                font-weight: 300;
                color: rgba(255,255,255,0.4);
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 6px 14px 6px 8px;
        }

        .user-avatar {
            width: 28px;
            height: 28px;
            background: var(--orange);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
        }

        .user-email {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.75);
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .logout-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.8);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }

            .logout-btn:hover {
                background: rgba(255,255,255,0.15);
                color: white;
            }

            .logout-btn svg {
                width: 14px;
                height: 14px;
            }

        .page {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        .sidebar {
            width: 220px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 24px 0;
            flex-shrink: 0;
            position: sticky;
            top: 64px;
            height: calc(100vh - 64px);
            overflow-y: auto;
        }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 20px;
            margin-bottom: 4px;
            margin-top: 16px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all 0.15s;
        }

            .nav-item:hover {
                background: var(--offwhite);
                color: var(--navy);
            }

            .nav-item.active {
                background: var(--orange-light);
                color: var(--orange);
                border-left-color: var(--orange);
            }

            .nav-item svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        .main {
            flex: 1;
            padding: 32px 40px;
        }

        .welcome-banner {
            background: linear-gradient(135deg, var(--navy) 0%, var(--navy2) 100%);
            border-radius: 20px;
            padding: 32px 36px;
            margin-bottom: 28px;
            position: relative;
            overflow: hidden;
        }

            .welcome-banner::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 60% 80% at 90% 50%, rgba(234,88,12,0.2) 0%, transparent 60%);
            }

            .welcome-banner::after {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
                background-size: 40px 40px;
            }

        .welcome-inner {
            position: relative;
            z-index: 2;
        }

        .welcome-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(234,88,12,0.2);
            border: 1px solid rgba(234,88,12,0.3);
            color: #fdba74;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 100px;
            margin-bottom: 12px;
        }

            .welcome-tag::before {
                content: '';
                width: 5px;
                height: 5px;
                background: #fdba74;
                border-radius: 50%;
            }

        .welcome-banner h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.8rem;
            color: white;
            margin-bottom: 6px;
        }

            .welcome-banner h1 em {
                font-style: italic;
                color: #fdba74;
            }

        .welcome-banner p {
            color: rgba(255,255,255,0.5);
            font-size: 0.875rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
        }

        .stat-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }

        .stat-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .stat-icon svg {
                width: 18px;
                height: 18px;
            }

        .stat-trend {
            font-size: 0.72rem;
            font-weight: 600;
            padding: 3px 8px;
            border-radius: 100px;
        }

        .trend-up {
            background: var(--green-light);
            color: var(--green);
        }

        .trend-warn {
            background: var(--amber-light);
            color: var(--amber);
        }

        .trend-danger {
            background: var(--red-light);
            color: var(--red);
        }

        .stat-value {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            color: var(--navy);
            line-height: 1;
            margin-bottom: 4px;
        }

        .stat-label {
            font-size: 0.78rem;
            color: var(--muted);
            font-weight: 500;
        }

        .card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .card-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.05rem;
            color: var(--navy);
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .card-title svg {
                width: 17px;
                height: 17px;
                stroke: var(--orange);
            }

        .table {
            width: 100%;
            border-collapse: collapse;
        }

            .table th {
                font-size: 0.7rem;
                font-weight: 600;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: 0.08em;
                padding: 0 0 10px;
                text-align: left;
                border-bottom: 1px solid var(--border);
            }

            .table td {
                padding: 12px 0;
                font-size: 0.83rem;
                color: var(--navy);
                border-bottom: 1px solid var(--offwhite);
                vertical-align: middle;
            }

            .table tr:last-child td {
                border-bottom: none;
            }

        .badge {
            display: inline-block;
            padding: 3px 9px;
            border-radius: 100px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .badge-released {
            background: var(--slate-light);
            color: var(--slate);
        }

        .btn {
            padding: 6px 14px;
            border: none;
            border-radius: 8px;
            font-size: 0.78rem;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
            font-weight: 600;
            transition: all 0.15s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .btn-primary {
            background: var(--teal);
            color: white;
        }

            .btn-primary:hover {
                background: #0b7a70;
            }

        .btn-danger {
            background: white;
            border: 1px solid var(--red);
            color: var(--red);
        }

            .btn-danger:hover {
                background: var(--red-light);
            }

        .btn-ghost {
            background: var(--offwhite);
            border: 1px solid var(--border);
            color: var(--navy);
        }

            .btn-ghost:hover {
                border-color: var(--teal);
                color: var(--teal);
            }

        .empty-state {
            padding: 20px;
            text-align: center;
            font-size: 14px;
            color: var(--muted);
        }

        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(11,31,58,0.5);
            z-index: 200;
            align-items: center;
            justify-content: center;
        }

            .modal-overlay.open {
                display: flex;
            }

        .modal {
            background: white;
            border-radius: 20px;
            padding: 32px;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .modal-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            color: var(--navy);
        }

        .modal-close {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--muted);
            font-size: 1.2rem;
            padding: 4px;
        }

            .modal-close:hover {
                color: var(--navy);
            }

        .field label {
            display: block;
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.07em;
            margin-bottom: 6px;
        }

        .field textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.85rem;
            font-family: 'DM Sans', sans-serif;
            color: var(--navy);
            resize: vertical;
        }

            .field textarea:focus {
                outline: none;
                border-color: var(--red);
            }

        @@media (max-width: 1100px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 768px) {
            .topbar {
                padding: 0 20px;
            }

            .user-email {
                display: none;
            }

            .sidebar {
                display: none;
            }

            .main {
                padding: 20px 16px;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo"><svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg></div>
            <div class="brand-name">NMB-HLabSys<span>Haematology Lab System</span></div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "T")</div>
                <span class="user-email">@ViewBag.Email</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">
        <aside class="sidebar">
            <div class="nav-label">Main</div>
            <a asp-controller="Lab" asp-action="Index" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                Dashboard
            </a>
            <a asp-controller="Lab" asp-action="DoctorOrders" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" /><rect x="9" y="3" width="6" height="4" rx="1" /><polyline points="9 14 11 16 15 12" /></svg>
                Doctor Orders
            </a>
            <a asp-controller="Lab" asp-action="ReceiveSamples" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6" />
                    <polyline points="16 6 12 10 8 6" />
                    <line x1="12" y1="10" x2="12" y2="2" />
                </svg>
                Receive Samples
            </a>
            <a asp-controller="Lab" asp-action="TestingQueue" class="nav-item active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 2v6.5L4.5 17a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L15 8.5V2" />
                    <line x1="9" y1="2" x2="15" y2="2" />
                </svg>                Testing Queue
            </a>
            <a asp-controller="Lab" asp-action="Verification" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="9 12 11 14 15 10" />
                </svg>
                Verification
            </a>
            <div class="nav-label">System</div>
            <a asp-controller="Lab" asp-action="Profile" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                Profile
            </a>
            <a asp-controller="Lab" asp-action="ActivityLog" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
                Activity Log
            </a>
        </aside>

        <main class="main">
            <div class="welcome-banner">
                <div class="welcome-inner">
                    <div class="welcome-tag">Receiving Technician</div>
                    <h1>Welcome back, <em>Technician</em></h1>
                    <p>Samples waiting to be checked in — @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon" style="background:var(--slate-light)"><svg viewBox="0 0 24 24" fill="none" stroke="var(--slate)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg></div>
                        <span class="stat-trend trend-warn">Awaiting</span>
                    </div>
                    <div class="stat-value">2</div>
                    <div class="stat-label">Awaiting Receipt</div>
                </div>
                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon" style="background:var(--teal-light)"><svg viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="2" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg></div>
                        <span class="stat-trend trend-up">+4 today</span>
                    </div>
                    <div class="stat-value">7</div>
                    <div class="stat-label">Received Today</div>
                </div>
                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon" style="background:var(--red-light)"><svg viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg></div>
                        <span class="stat-trend trend-danger">Today</span>
                    </div>
                    <div class="stat-value">1</div>
                    <div class="stat-label">Rejected Today</div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <div class="card-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><path d="M9 2v6l-5 10a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3l-5-10V2" /><line x1="9" y1="2" x2="15" y2="2" /></svg>
                        Samples Awaiting Check-In
                    </div>
                </div>

                <table class="table">
                    <thead>
                        <tr><th>Request #</th><th>Patient</th><th>Tests</th><th>Ordering Doctor</th><th></th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>REQ-0151</strong></td>
                            <td>Andile Mthembu, 31</td>
                            <td>Urea &amp; Electrolytes</td>
                            <td>Dr. J. Whitfield</td>
                            <td style="text-align:right">
                                <button class="btn btn-danger" onclick="openReject('REQ-0151','Andile Mthembu')">Reject Sample</button>
                                <a href="#" class="btn btn-primary">Receive Sample</a>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>REQ-0154</strong></td>
                            <td>Nomsa Radebe, 58</td>
                            <td>Full Blood Count</td>
                            <td>Dr. A. Okafor</td>
                            <td style="text-align:right">
                                <button class="btn btn-danger" onclick="openReject('REQ-0154','Nomsa Radebe')">Reject Sample</button>
                                <a href="#" class="btn btn-primary">Receive Sample</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <div class="modal-overlay" id="rejectModal">
        <div class="modal">
            <div class="modal-header">
                <div class="modal-title" id="rejectModalTitle">Reject Sample</div>
                <button class="modal-close" onclick="closeReject()">✕</button>
            </div>
            <p style="font-size:0.82rem;color:var(--muted);margin-bottom:16px;" id="rejectModalSubtitle"></p>
            <div class="field">
                <label>Reason for rejection</label>
                <textarea rows="3" placeholder="e.g. Sample haemolysed, insufficient volume, mislabeled tube..."></textarea>
            </div>
            <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:18px;">
                <button class="btn btn-ghost" onclick="closeReject()">Cancel</button>
                <button class="btn btn-danger" style="background:var(--red);color:white;border:none" onclick="closeReject()">Confirm Rejection</button>
            </div>
        </div>
    </div>

    <script>
        function openReject(reqNum, patient) {
            document.getElementById('rejectModalTitle').textContent = 'Reject Sample — ' + reqNum;
            document.getElementById('rejectModalSubtitle').textContent = 'Patient: ' + patient + '. This will alert the ordering doctor by banner and email.';
            document.getElementById('rejectModal').classList.add('open');
        }
        function closeReject() {
            document.getElementById('rejectModal').classList.remove('open');
        }
        document.getElementById('rejectModal').addEventListener('click', function (e) {
            if (e.target === this) closeReject();
        });
    </script>

</body>
</html>
