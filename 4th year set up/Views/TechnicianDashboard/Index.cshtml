@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model _4th_year_set_up.Models.DashboardViewModel
@{
    ViewData["Title"] = "Index";
    Layout = null;
    var email = ViewBag.Email?.ToString();
    var initial = string.IsNullOrEmpty(email) ? "T" : email.Substring(0, 1).ToUpper();
    var flash = TempData["Flash"] as string;
    var flashType = TempData["FlashType"] as string ?? "ok";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Technician Dashboard — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/technician.css" />
</head>
<body>
//mmmmm
    @* ===== TOPBAR + SIDEBAR: copy this block unchanged into every technician screen. Only move the "active" class. ===== *@
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">NMB-HLabSys<span>Haematology Lab System</span></div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@initial</div>
                <span class="user-email">@email</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">
        <aside class="sidebar">
            <a asp-controller="TechnicianDashboard" asp-action="Index" class="nav-item active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10.5L12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" /><path d="M9 21v-6h6v6" /></svg>
                Dashboard
            </a>

            <div class="nav-label">Samples and Requests</div>
            <a asp-controller="TechnicianDashboard" asp-action="ReceiveSamples" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6" /><polyline points="16 6 12 10 8 6" /><line x1="12" y1="10" x2="12" y2="2" /></svg>
                Receive Samples
            </a>

            <a asp-controller="TechnicianDashboard" asp-action="SampleVerification" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 2v6.5L4.5 17a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L15 8.5V2" /><polyline points="9 14 11 16 15 12" /></svg>
                Sample Verification
            </a>

            <div class="nav-label">Tests</div>
            <a asp-controller="TechnicianDashboard" asp-action="TestQueue" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 2v6.5L4.5 17a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L15 8.5V2" /><line x1="9" y1="2" x2="15" y2="2" /></svg>
                Testing Queue
            </a>
            <a asp-controller="TechnicianDashboard" asp-action="MyTests" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                My Tests
            </a>

            <div class="nav-label">Results</div>
            <a asp-controller="TechnicianDashboard" asp-action="CaptureResults" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="2" /><line x1="8" y1="8" x2="16" y2="8" /><line x1="8" y1="12" x2="16" y2="12" /><line x1="8" y1="16" x2="13" y2="16" /></svg>
                Capture Results
            </a>
            <a asp-controller="TechnicianDashboard" asp-action="Verification" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="9 12 11 14 15 10" /></svg>
                Result Verification
            </a>
            <a asp-controller="TechnicianDashboard" asp-action="ReleaseResults" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13" /><path d="M22 2l-7 20-4-9-9-4 20-7z" /></svg>
                Release Results
            </a>

            <div class="nav-label">Reports</div>
            <a asp-controller="TechnicianDashboard" asp-action="Reports" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="19" x2="20" y2="19" /><rect x="5" y="10" width="3" height="7" /><rect x="10.5" y="6" width="3" height="11" /><rect x="16" y="3" width="3" height="14" /></svg>
                Reporting
            </a>

            <div class="nav-label">System</div>
            <a asp-controller="TechnicianDashboard" asp-action="Profile" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                Profile
            </a>
        </aside>
        @* ===== END shared topbar + sidebar ===== *@

        <main class="main">

            @if (!string.IsNullOrEmpty(flash))
            {
                <div class="flash flash-@flashType" role="status">@flash</div>
            }

            <div class="welcome-banner">
                <div class="welcome-inner">
                    <div class="welcome-tag">Lab Technician Portal</div>
                    <h1>Welcome back, <em>Technician</em></h1>
                    <p>Your test queue for today — @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
                </div>
            </div>

            <!-- CLICKABLE TILES -->
            <div class="stats-grid">

                <a asp-controller="TechnicianDashboard" asp-action="TestQueue" class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon" style="background:var(--orange-light)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round"><path d="M9 2v6.5L4.5 17a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L15 8.5V2" /><line x1="9" y1="2" x2="15" y2="2" /></svg>
                        </div>
                        <span class="stat-trend trend-warn">Active</span>
                    </div>
                    <div class="stat-value">@Model.QueueCount</div>
                    <div class="stat-label">Test queue</div>
                    <div class="stat-go">Open queue →</div>
                </a>

                <a asp-controller="TechnicianDashboard" asp-action="MyTests" class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon" style="background:var(--blue-light)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        </div>
                        <span class="stat-trend trend-info">Mine</span>
                    </div>
                    <div class="stat-value">@Model.MineCount</div>
                    <div class="stat-label">Tests selected by me</div>
                    <div class="stat-go">Open my tests →</div>
                </a>

                <a asp-controller="TechnicianDashboard" asp-action="AwaitingAssignment" class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon" style="background:var(--amber-light)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                        </div>
                        <span class="stat-trend trend-warn">Unassigned</span>
                    </div>
                    <div class="stat-value">@Model.AwaitingCount</div>
                    <div class="stat-label">Tests awaiting assignment</div>
                    <div class="stat-go">View unassigned →</div>
                </a>

                <a asp-controller="TechnicianDashboard" asp-action="Verified" class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon" style="background:var(--green-light)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="9 12 11 14 15 10" /></svg>
                        </div>
                        <span class="stat-trend trend-up">Done</span>
                    </div>
                    <div class="stat-value">@Model.VerifiedCount</div>
                    <div class="stat-label">Verified tests</div>
                    <div class="stat-go">View verified →</div>
                </a>
            </div>

            @if (Model.IsSenior)
            {
                <div class="section-label">Senior technician tasks</div>
                <div class="stats-grid senior">
                    <a asp-controller="TechnicianDashboard" asp-action="SampleVerification" class="stat-card">
                        <div class="stat-top">
                            <div class="stat-icon" style="background:var(--amber-light)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round"><path d="M9 2v6.5L4.5 17a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L15 8.5V2" /><polyline points="9 14 11 16 15 12" /></svg>
                            </div>
                            <span class="stat-trend trend-warn">Before testing</span>
                        </div>
                        <div class="stat-value">@Model.SamplesToVerifyCount</div>
                        <div class="stat-label">Tubes to verify</div>
                        <div class="stat-go">Verify samples →</div>
                    </a>

                    <a asp-controller="TechnicianDashboard" asp-action="Verification" class="stat-card">
                        <div class="stat-top">
                            <div class="stat-icon" style="background:var(--orange-light)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="9 12 11 14 15 10" /></svg>
                            </div>
                            <span class="stat-trend trend-warn">Before release</span>
                        </div>
                        <div class="stat-value">@Model.ResultsToVerifyCount</div>
                        <div class="stat-label">Results to verify</div>
                        <div class="stat-go">Verify results →</div>
                    </a>

                    <a asp-controller="TechnicianDashboard" asp-action="ReleaseResults" class="stat-card">
                        <div class="stat-top">
                            <div class="stat-icon" style="background:var(--green-light)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round"><path d="M22 2L11 13" /><path d="M22 2l-7 20-4-9-9-4 20-7z" /></svg>
                            </div>
                            <span class="stat-trend trend-up">Final step</span>
                        </div>
                        <div class="stat-value">@Model.ReadyToReleaseCount</div>
                        <div class="stat-label">Ready for doctor release</div>
                        <div class="stat-go">Release results →</div>
                    </a>
                </div>
            }

            <!-- MY TESTS PREVIEW -->
            <div class="card">
                <div class="card-header">
                    <div>
                        <div class="card-title">My Tests</div>
                        <div class="card-sub">Tests you've selected, most pressing first</div>
                    </div>
                    <a asp-controller="TechnicianDashboard" asp-action="MyTests" class="card-action">View all (@Model.MineCount) →</a>
                </div>

                @if (Model.MyTestsPreview.Count == 0)
                {
                    <div class="empty-state">You haven't selected any tests yet.
                        <a asp-controller="TechnicianDashboard" asp-action="AwaitingAssignment" class="card-action">Pick one from the unassigned list</a>
                    </div>
                }
                else
                {
                    <div class="filter-bar">
                        <input type="text" id="filterReqNum" class="form-control form-control--search" placeholder="Search request # or patient" oninput="filterMine()" aria-label="Search my tests" />
                        <button type="button" class="chip active" data-filter="all" onclick="setMineFilter('all')">All <span class="chip-count">@Model.MyTestsPreview.Count</span></button>
                        <button type="button" class="chip chip-urgent" data-filter="urgent" onclick="setMineFilter('urgent')">Urgent <span class="chip-count">@Model.MyTestsPreview.Count(x => x.IsUrgent)</span></button>
                        <button type="button" class="chip chip-overdue" data-filter="overdue" onclick="setMineFilter('overdue')">Overdue <span class="chip-count">@Model.MyTestsPreview.Count(x => x.Tat == _4th_year_set_up.Models.TatStatus.Overdue)</span></button>
                        <button type="button" class="chip chip-nearing" data-filter="nearing" onclick="setMineFilter('nearing')">Nearing TAT <span class="chip-count">@Model.MyTestsPreview.Count(x => x.Tat == _4th_year_set_up.Models.TatStatus.NearingTat)</span></button>
                        <button type="button" class="btn btn-ghost" onclick="setMineFilter('all', true)">Reset</button>
                    </div>

                    <div class="table-wrap">
                        <table class="table" id="myTestsTable">
                            <thead>
                                <tr>
                                    <th>Request #</th>
                                    <th>Patient</th>
                                    <th>Test</th>
                                    <th>Priority</th>
                                    <th>Turnaround</th>
                                    <th>Stage</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.MyTestsPreview)
                                {
                                    var stageCss = t.StageCss;
                                    var tatCss = t.Tat == _4th_year_set_up.Models.TatStatus.Overdue ? "badge-overdue"
                                               : t.Tat == _4th_year_set_up.Models.TatStatus.NearingTat ? "badge-nearing" : "badge-ontrack";
                                    <tr class="@(t.Tat == _4th_year_set_up.Models.TatStatus.Overdue ? "row-overdue" : "") @(t.InMultiTestRequest ? "req-group" : "")"
                                        data-search="@((t.ReqNum + " " + t.Patient + " " + t.Test).ToLower())"
                                        data-urgent="@(t.IsUrgent ? "1" : "0")"
                                        data-tat="@(t.Tat == _4th_year_set_up.Models.TatStatus.Overdue ? "overdue" : t.Tat == _4th_year_set_up.Models.TatStatus.NearingTat ? "nearing" : "ontrack")">
                                        <td><partial name="_ReqLink" model="t" /></td>
                                        <td>@t.Patient</td>
                                        <td>@t.Test</td>
                                        <td><span class="badge @(t.IsUrgent ? "badge-urgent" : "badge-routine")">@(t.IsUrgent ? "Urgent" : "Routine")</span></td>
                                        <td>
                                            <span class="badge @tatCss">@t.TatLabel</span>
                                            <span class="due-text">@t.DueText</span>
                                        </td>
                                        <td>
                                            <span class="badge @stageCss">@t.StageLabel</span>
                                            @if (t.Stage == _4th_year_set_up.Models.TestStage.ToBeReviewed && !string.IsNullOrEmpty(t.ReviewNote))
                                            {
                                                <span class="due-text">Note: @t.ReviewNote</span>
                                            }
                                        </td>
                                        <td class="actions-cell"><partial name="_TestActions" model="t" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="noResultsMsg" class="empty-state" style="display:none;">No matching tests found.</div>
                }
            </div>

        </main>
    </div>

    <script>
        var mineFilter = 'all';
        function setMineFilter(f, clearSearch) {
            mineFilter = f;
            if (clearSearch) document.getElementById('filterReqNum').value = '';
            filterMine();
        }
        function filterMine() {
            var table = document.getElementById('myTestsTable');
            if (!table) return;
            var q = document.getElementById('filterReqNum').value.trim().toLowerCase();
            var visible = 0;
            table.querySelectorAll('tbody tr').forEach(function (row) {
                var okFilter = mineFilter === 'all' ||
                    (mineFilter === 'urgent' && row.dataset.urgent === '1') ||
                    mineFilter === row.dataset.tat;
                var show = okFilter && (!q || row.dataset.search.indexOf(q) !== -1);
                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            document.querySelectorAll('.filter-bar .chip[data-filter]').forEach(function (c) {
                c.classList.toggle('active', c.dataset.filter === mineFilter);
            });
            document.getElementById('noResultsMsg').style.display = visible === 0 ? 'block' : 'none';
        }
    </script>
    <partial name="_TestModal" />
    <script src="~/js/test-modal.js"></script>
</body>
</html>
