@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Enter Test Results";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Enter Results — NMB-HLabSys</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --teal: #0d9488;
            --teal-light: rgba(13,148,136,0.1);
            --orange: #ea580c;
            --orange-light: rgba(234,88,12,0.1);
            --amber: #d97706;
            --amber-light: rgba(217,119,6,0.1);
            --green: #16a34a;
            --green-light: rgba(22,163,74,0.1);
            --red: #dc2626;
            --red-light: rgba(220,38,38,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
        }

        /* TOPBAR */
        .topbar {
            background: var(--navy);
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-logo {
            width: 34px;
            height: 34px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .brand-logo svg {
                width: 18px;
                height: 18px;
                fill: white;
            }

        .brand-name {
            font-family: 'DM Serif Display', serif;
            color: white;
            font-size: 1.1rem;
            line-height: 1.1;
        }

            .brand-name span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.6rem;
                font-weight: 300;
                color: rgba(255,255,255,0.4);
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 6px 14px 6px 8px;
        }

        .user-avatar {
            width: 28px;
            height: 28px;
            background: var(--orange);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
        }

        .user-email {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.75);
        }

        .logout-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.8);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
        }

        /* LAYOUT */
        .page {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        /* SIDEBAR */
        .sidebar {
            width: 220px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 24px 0;
            flex-shrink: 0;
        }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 20px;
            margin-bottom: 4px;
            margin-top: 16px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            border-left: 3px solid transparent;
        }

            .nav-item.active {
                background: var(--orange-light);
                color: var(--orange);
                border-left-color: var(--orange);
            }

        /* MAIN */
        .main {
            flex: 1;
            padding: 32px 40px;
        }

        /* PAGE HEADER */
        .page-header {
            margin-bottom: 24px;
        }

        .page-tag {
            display: inline-block;
            background: var(--orange-light);
            color: var(--orange);
            padding: 5px 10px;
            border-radius: 100px;
            font-size: 0.72rem;
            font-weight: 600;
            margin-bottom: 12px;
        }

        .page-title {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            margin-bottom: 6px;
        }

        .page-subtitle {
            color: var(--muted);
            font-size: 0.9rem;
        }

        /* CARD */
        .card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 32px;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
        }

        /* PATIENT INFO */
        .patient-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        .info-box {
            background: var(--offwhite);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 16px;
        }

        .info-label {
            font-size: 0.72rem;
            color: var(--muted);
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .info-value {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--navy);
        }

        /* FORM */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .form-group label {
            display: block;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--muted);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid var(--border);
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.9rem;
            outline: none;
            transition: 0.15s;
            background: white;
        }

            .form-group input:focus,
            .form-group select:focus,
            .form-group textarea:focus {
                border-color: var(--teal);
            }

        .form-group textarea {
            min-height: 120px;
            resize: vertical;
        }

        .full-width {
            grid-column: span 2;
        }

        .range-hint {
            font-size: 0.72rem;
            color: var(--muted);
            margin-top: 6px;
        }

        /* BADGES */
        .badge {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 100px;
            font-size: 0.72rem;
            font-weight: 600;
        }

        .badge-urgent {
            background: var(--red-light);
            color: var(--red);
        }

        /* BUTTONS */
        .actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 32px;
        }

        .btn {
            border: none;
            border-radius: 10px;
            padding: 12px 18px;
            font-family: 'DM Sans', sans-serif;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--teal);
            color: white;
        }

            .btn-primary:hover {
                background: #0b7a70;
            }

        .btn-ghost {
            background: white;
            border: 1px solid var(--border);
            color: var(--navy);
        }

        @@media (max-width: 900px) {
            .patient-grid,
            .form-grid {
                grid-template-columns: 1fr;
            }

            .full-width {
                grid-column: span 1;
            }

            .sidebar {
                display: none;
            }

            .main {
                padding: 20px;
            }
        }
    </style>
</head>

<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24">
                    <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" />
                </svg>
            </div>
            <div class="brand-name">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>
        </a>

        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">T</div>
                <span class="user-email">tech@nmbhlab.com</span>
            </div>

            <a href="#" class="logout-btn">Sign Out</a>
        </div>
    </div>

    <div class="page">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="nav-label">Main</div>

            <a href="/TechnicianDashboard/Index" class="nav-item">
                Dashboard
            </a>

            <a href="/TechnicianDashboard/EnterResults" class="nav-item active">
                Enter Results
            </a>
            <a asp-controller="TechnicianDashboard" asp-action="ViewResults" class="nav-item">
                
                View Results
            </a>
            <a href="#" class="nav-item">
                Completed
            </a>

        </aside>

        <!-- MAIN -->
        <main class="main">

            <!-- PAGE HEADER -->
            <div class="page-header">
                <div class="page-tag">Laboratory Result Entry</div>

                <h1 class="page-title">
                    Enter Test Results
                </h1>

                <p class="page-subtitle">
                    Capture and submit laboratory findings for processing.
                </p>
            </div>

            <!-- FORM CARD -->
            <div class="card">

                <!-- PATIENT INFO -->
                <div class="patient-grid">

                    <div class="info-box">
                        <div class="info-label">Request Number</div>
                        <div class="info-value">REQ-0148</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Patient</div>
                        <div class="info-value">Thabo Nkosi</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Test Type</div>
                        <div class="info-value">Full Blood Count</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Priority</div>
                        <span class="badge badge-urgent">Urgent</span>
                    </div>

                </div>

                <!-- FORM -->
                <form>

                    <div class="form-grid">

                        <div class="form-group">
                            <label>Result Value</label>
                            <input type="number" step="0.01" placeholder="e.g. 13.5" />

                            <div class="range-hint">
                                Normal range: 12.0 – 17.5
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Unit</label>

                            <select>
                                <option>g/dL</option>
                                <option>cells/µL</option>
                                <option>×10³/µL</option>
                                <option>mm/hr</option>
                                <option>%</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Status</label>

                            <select>
                                <option>In Progress</option>
                                <option>Completed</option>
                                <option>Requires Review</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Abnormal?</label>

                            <select>
                                <option>No</option>
                                <option>Yes — High</option>
                                <option>Yes — Low</option>
                            </select>
                        </div>

                        <div class="form-group full-width">
                            <label>Technician Notes</label>

                            <textarea placeholder="Add additional laboratory observations..."></textarea>
                        </div>

                    </div>

                    <!-- ACTIONS -->
                    <div class="actions">

                        <a href="/TechnicianDashboard/Index" class="btn btn-ghost">
                            Cancel
                        </a>

                        @* <button type="submit" class="btn btn-primary">
                            Save Results
                        </button> *@
                        <button type="button" class="btn btn-primary" onclick="saveResult()">
                            Save Results
                        </button>
                    </div>

                </form>

            </div>

        </main>

    </div>
    <script>
        function saveResult() {
            const btn = document.querySelector(".btn-primary");
            btn.innerText = "Saved ✔";
            btn.style.background = "#16a34a";

            setTimeout(() => {
                window.location.href = "/TechnicianDashboard/Index";
            }, 1200);
        }
    </script>
</body>
</html>