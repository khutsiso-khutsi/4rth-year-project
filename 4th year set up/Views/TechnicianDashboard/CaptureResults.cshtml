@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model _4th_year_set_up.Models.CaptureResultsViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Capture Results";
    Layout = null;

    var flash = TempData["Flash"] as string;
    var flashType = TempData["FlashType"] as string ?? "ok";
    var item = Model.Item;

    // Optional: the controller can fill these later to switch on the Previous and Change columns.
    //   ViewBag.Previous     = Dictionary<string, decimal>  (parameter key -> last verified value)
    //   ViewBag.PreviousDate = DateTime                      (when that result was verified)
    var prevMap = ViewBag.Previous as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
    var hasPrev = prevMap.Count > 0;
    var prevDate = ViewBag.PreviousDate as DateTime?;
    var cols = hasPrev ? 6 : 4;

    string F(decimal d) => d.ToString("0.##", CultureInfo.InvariantCulture);
    string GroupOf(string key) => key switch
    {
        "rbc" or "hb" or "hct" or "mcv" or "mch" or "mchc" => "Red cells",
        "wbc" => "White cells",
        "plt" => "Platelets",
        "neut" or "lymp" or "mono" or "eos" or "baso" => "Differential",
        _ => ""
    };

    var pd = item.PatientDetails;
    var sexDob = pd == null ? "—" : string.Join(" · ", new[] { pd.DateOfBirth.Year > 1900 ? pd.DateOfBirth.ToString("d MMM yyyy") : null, pd.Sex }.Where(s => !string.IsNullOrWhiteSpace(s)));
    if (string.IsNullOrWhiteSpace(sexDob)) { sexDob = "—"; }
    var collected = item.CollectedAt.Year < 2000 ? "—" : item.CollectedAt.ToString("d MMM, HH:mm");
    var sampleCheck = item.SampleVerifiedAt.HasValue ? "Accepted " + item.SampleVerifiedAt.Value.ToString("HH:mm") : "—";
    var priority = item.Request?.Priority ?? (item.IsUrgent ? "Urgent" : "Routine");
    var lastGroup = "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capture Results — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --navy: #0b1f3a; --navy2: #122848; --teal: #0d9488; --teal-light: rgba(13,148,136,0.1);
            --orange: #ea580c; --orange-light: rgba(234,88,12,0.1); --amber: #d97706; --amber-light: rgba(217,119,6,0.12);
            --red: #dc2626; --red-light: rgba(220,38,38,0.1); --green: #16a34a; --green-light: rgba(22,163,74,0.1);
            --white: #ffffff; --offwhite: #f4f7fb; --muted: #6b7a99; --border: #dde4f0;
        }
        body { font-family: 'DM Sans', sans-serif; background: var(--offwhite); color: var(--navy); min-height: 100vh; }

        /* shared topbar + sidebar */
        .topbar { background: var(--navy); padding: 0 40px; display: flex; align-items: center; justify-content: space-between; height: 64px; position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 20px rgba(0,0,0,0.15); }
        .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
        .brand-logo { width: 34px; height: 34px; background: var(--teal); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
        .brand-logo svg { width: 18px; height: 18px; fill: white; }
        .brand-name { font-family: 'DM Serif Display', serif; color: white; font-size: 1.1rem; line-height: 1.1; }
        .brand-name span { display: block; font-family: 'DM Sans', sans-serif; font-size: 0.6rem; font-weight: 300; color: rgba(255,255,255,0.4); letter-spacing: 0.1em; text-transform: uppercase; }
        .topbar-right { display: flex; align-items: center; gap: 16px; }
        .user-chip { display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.1); border-radius: 100px; padding: 6px 14px 6px 8px; }
        .user-avatar { width: 28px; height: 28px; background: var(--orange); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 600; color: white; }
        .user-email { font-size: 0.8rem; color: rgba(255,255,255,0.75); max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .logout-btn { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); color: rgba(255,255,255,0.8); padding: 8px 16px; border-radius: 8px; text-decoration: none; font-size: 0.82rem; font-weight: 500; display: flex; align-items: center; gap: 6px; transition: all 0.2s; }
        .logout-btn:hover { background: rgba(255,255,255,0.15); color: white; }
        .logout-btn svg { width: 14px; height: 14px; }
        .page { display: flex; min-height: calc(100vh - 64px); }
        .sidebar { width: 220px; background: white; border-right: 1px solid var(--border); padding: 24px 0; flex-shrink: 0; position: sticky; top: 64px; height: calc(100vh - 64px); overflow-y: auto; }
        .nav-label { font-size: 0.65rem; font-weight: 600; color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; padding: 0 20px; margin-bottom: 4px; margin-top: 16px; }
        .nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 20px; color: var(--muted); text-decoration: none; font-size: 0.85rem; font-weight: 500; border-left: 3px solid transparent; transition: all 0.15s; }
        .nav-item:hover { background: var(--offwhite); color: var(--navy); }
        .nav-item.active { background: var(--orange-light); color: var(--orange); border-left-color: var(--orange); }
        .nav-item svg { width: 16px; height: 16px; flex-shrink: 0; }
        .main { flex: 1; padding: 28px 40px; min-width: 0; }

        /* page */
        .back-link { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: var(--muted); text-decoration: none; margin-bottom: 16px; padding: 7px 12px; border: 1px solid var(--border); border-radius: 7px; background: var(--white); transition: all 0.15s; }
        .back-link:hover { color: var(--navy); border-color: var(--teal); background: var(--teal-light); }
        .back-link svg { width: 14px; height: 14px; }
        .flash { padding: 12px 16px; border-radius: 10px; font-size: 0.85rem; font-weight: 500; margin-bottom: 16px; border: 1px solid var(--border); background: white; }
        .flash-ok { border-color: rgba(22,163,74,0.35); background: var(--green-light); color: #166534; }
        .flash-warn { border-color: rgba(217,119,6,0.4); background: var(--amber-light); color: #92400e; }

        .banner { background: var(--navy); border-radius: 16px; padding: 18px 26px; margin-bottom: 14px; display: flex; align-items: center; justify-content: space-between; gap: 16px; position: relative; overflow: hidden; }
        .banner::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 50% 90% at 92% 50%, rgba(234,88,12,0.22) 0%, transparent 60%); pointer-events: none; }
        .banner > * { position: relative; z-index: 1; }
        .banner-tag { display: inline-flex; align-items: center; background: rgba(234,88,12,0.2); border: 1px solid rgba(234,88,12,0.3); color: #fdba74; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; padding: 3px 10px; border-radius: 100px; margin-bottom: 8px; }
        .banner h1 { font-family: 'DM Serif Display', serif; font-size: 1.65rem; color: white; font-weight: 400; line-height: 1.2; }
        .banner h1 em { font-style: italic; color: #fdba74; }
        .banner-note { font-size: 0.8rem; color: rgba(255,255,255,0.6); margin-top: 4px; }
        .counter { text-align: right; color: white; flex-shrink: 0; }
        .counter b { font-family: 'DM Serif Display', serif; font-size: 2.1rem; font-weight: 400; line-height: 1; }
        .counter span { display: block; font-size: 0.75rem; color: rgba(255,255,255,0.55); }

        .review-note { background: var(--orange-light); border: 1px solid rgba(234,88,12,0.3); border-radius: 12px; padding: 12px 16px; margin-bottom: 14px; font-size: 0.85rem; }
        .review-note strong { display: block; font-size: 0.72rem; color: var(--orange); margin-bottom: 3px; }

        .card { background: white; border: 1px solid var(--border); border-radius: 16px; padding: 14px 18px; margin-bottom: 14px; }
        .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px 18px; font-size: 0.85rem; }
        .facts .wide { grid-column: span 4; }
        .k { font-size: 0.72rem; color: var(--muted); margin-bottom: 1px; }
        .chip { display: inline-block; font-size: 0.72rem; padding: 2px 9px; border-radius: 100px; font-weight: 600; white-space: nowrap; }
        .chip-urgent { background: var(--amber-light); color: #92400e; }
        .chip-routine { background: rgba(71,85,105,0.1); color: #475569; }

        .tw { background: white; border: 1px solid var(--border); border-radius: 16px; overflow-x: auto; margin-bottom: 14px; }
        .tbl { width: 100%; border-collapse: collapse; table-layout: fixed; min-width: 560px; }
        .tbl th { font-size: 0.68rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.07em; font-weight: 600; text-align: left; padding: 10px 10px; border-bottom: 1px solid var(--border); background: var(--offwhite); }
        .tbl td { padding: 6px 10px; border-bottom: 1px solid #eef2f8; vertical-align: middle; font-size: 0.85rem; }
        .tbl tr.sec td { font-family: 'DM Serif Display', serif; font-size: 0.95rem; background: #fafcff; padding: 9px 10px 5px; }
        .rn { font-weight: 600; }
        .ru { font-size: 0.7rem; color: var(--muted); }
        .in { width: 100%; height: 36px; font-size: 0.95rem; font-family: 'DM Sans', sans-serif; font-weight: 500; color: var(--navy); background: white; border: 1px solid var(--border); border-radius: 8px; padding: 0 10px; }
        .in:focus { outline: none; border-color: var(--teal); box-shadow: 0 0 0 3px rgba(13,148,136,0.15); }
        .in.sm { height: 32px; font-size: 0.82rem; font-weight: 400; }
        tr.is-warn { background: rgba(245,158,11,0.07); }
        tr.is-warn .in { border-color: #f59e0b; }
        tr.is-crit { background: #fef2f2; }
        tr.is-crit .in { border-color: var(--red); }
        .flag-low, .flag-high { background: var(--amber-light); color: #92400e; }
        .flag-ok { background: var(--green-light); color: #166534; }
        .flag-crit { background: rgba(220,38,38,0.14); color: #991b1b; }
        .bad-text { font-size: 0.75rem; color: var(--red); }
        .prev { color: var(--muted); }
        .delta-big { color: #92400e; font-weight: 600; }

        tr.cpn td { background: #fef2f2; padding: 9px 12px 12px; border-bottom: 1px solid #fecaca; }
        .cpn-title { font-size: 0.78rem; font-weight: 600; color: #991b1b; margin-bottom: 7px; }
        .cpn-grid { display: grid; grid-template-columns: 1.5fr 0.7fr 1.3fr; gap: 10px; align-items: end; font-size: 0.72rem; color: #991b1b; }
        .cpn-grid label { display: block; }
        .cpn-grid .readback { display: flex; align-items: center; gap: 6px; height: 32px; font-size: 0.82rem; cursor: pointer; }

        .note-label { font-size: 0.72rem; color: var(--muted); margin-bottom: 4px; }
        .note-input { width: 100%; height: 36px; font-size: 0.85rem; font-family: 'DM Sans', sans-serif; color: var(--navy); background: white; border: 1px solid var(--border); border-radius: 8px; padding: 0 10px; }
        .note-input:focus { outline: none; border-color: var(--teal); }
        .err { font-size: 0.82rem; color: var(--red); min-height: 20px; margin: 8px 0 4px; }
        .foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
        .hint { font-size: 0.75rem; color: var(--muted); }
        .btn { padding: 9px 18px; border: none; border-radius: 8px; font-size: 0.82rem; cursor: pointer; font-family: 'DM Sans', sans-serif; font-weight: 600; transition: all 0.15s; }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .btn-primary { background: var(--teal); color: white; }
        .btn-primary:hover:not(:disabled) { background: #0b7a70; }
        .btn-ghost { background: var(--offwhite); border: 1px solid var(--border); color: var(--navy); }
        .btn-ghost:hover { border-color: var(--teal); color: var(--teal); }
        .btn-danger { background: var(--red); color: white; }
        .summary { display: none; margin-top: 14px; }
        .summary.show { display: block; }
        .summary .foot + .hint { margin-top: 10px; }

        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(11,31,58,0.5); z-index: 200; align-items: center; justify-content: center; padding: 16px; }
        .modal-overlay.open { display: flex; }
        .modal { background: white; border-radius: 20px; padding: 28px; width: 100%; max-width: 440px; box-shadow: 0 20px 60px rgba(0,0,0,0.2); }
        .modal-title { font-family: 'DM Serif Display', serif; font-size: 1.2rem; margin-bottom: 8px; }
        .modal p { font-size: 0.85rem; color: var(--muted); margin-bottom: 18px; }
        .modal-actions { display: flex; gap: 10px; justify-content: flex-end; }

        @@media (max-width: 900px) {
            .topbar { padding: 0 20px; }
            .user-email { display: none; }
            .sidebar { display: none; }
            .main { padding: 18px 16px; }
            .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .facts .wide { grid-column: span 2; }
            .cpn-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <partial name="_TechnicianTopbar" />

    <div class="page">

        <aside class="sidebar">
            <a asp-controller="TechnicianDashboard" asp-action="Index" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10.5L12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" /><path d="M9 21v-6h6v6" /></svg>
                Dashboard
            </a>

            <div class="nav-label">Samples and Requests</div>
            <a asp-controller="TechnicianDashboard" asp-action="ReceiveSamples" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6" /><polyline points="16 6 12 10 8 6" /><line x1="12" y1="10" x2="12" y2="2" /></svg>
                Receive Samples
            </a>
            <a asp-controller="TechnicianDashboard" asp-action="SampleVerification" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 2v6.5L4.5 17a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L15 8.5V2" /><polyline points="9 14 11 16 15 12" /></svg>
                Sample Verification
            </a>

            <div class="nav-label">Tests</div>
            <a asp-controller="TechnicianDashboard" asp-action="TestQueue" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 2v6.5L4.5 17a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L15 8.5V2" /><line x1="9" y1="2" x2="15" y2="2" /></svg>
                Testing Queue
            </a>
            <a asp-controller="TechnicianDashboard" asp-action="MyTests" class="nav-item active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                My Tests
            </a>

            <div class="nav-label">Results</div>
            <a asp-controller="TechnicianDashboard" asp-action="Verification" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="9 12 11 14 15 10" /></svg>
                Result Verification
            </a>

            <div class="nav-label">Reports</div>
            <a asp-controller="TechnicianDashboard" asp-action="Reports" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="19" x2="20" y2="19" /><rect x="5" y="10" width="3" height="7" /><rect x="10.5" y="6" width="3" height="11" /><rect x="16" y="3" width="3" height="14" /></svg>
                Reporting
            </a>

            <div class="nav-label">System</div>
            <a asp-controller="TechnicianDashboard" asp-action="Profile" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                Profile
            </a>
        </aside>

        <main class="main">

            <a asp-controller="TechnicianDashboard" asp-action="MyTests" class="back-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
                Back to My Tests
            </a>

            @if (!string.IsNullOrEmpty(flash))
            {
                <div class="flash flash-@flashType" role="status">@flash</div>
            }

            <div class="banner">
                <div>
                    <div class="banner-tag">@(Model.IsReview ? "To be reviewed · attempt " + item.Attempt : "Capture Results")</div>
                    <h1>Processing <em>@item.Test</em></h1>
                    <div class="banner-note">@item.ReqNum</div>
                </div>
                @if (Model.Parameters.Count > 1)
                {
                    <div class="counter"><b id="counter">0/@Model.Parameters.Count</b><span>captured</span></div>
                }
            </div>

            @if (Model.IsReview && !string.IsNullOrEmpty(item.ReviewNote))
            {
                <div class="review-note">
                    <strong>Returned by verification</strong>
                    @item.ReviewNote
                </div>
            }

            <div class="card">
                <div class="facts">
                    <div><div class="k">Patient</div>@(item.Patient ?? "—")</div>
                    <div><div class="k">Date of birth · Sex</div>@sexDob</div>
                    <div><div class="k">Tube barcode</div>@(item.Sample?.TubeId ?? "—")</div>
                    <div><div class="k">Priority</div><span class="chip @(item.IsUrgent ? "chip-urgent" : "chip-routine")">@priority</span></div>
                    <div><div class="k">Sample</div>@(string.IsNullOrWhiteSpace(item.Tube) ? item.SampleType : item.Tube)</div>
                    <div><div class="k">Collected</div>@collected</div>
                    <div><div class="k">Ward</div>@(string.IsNullOrWhiteSpace(item.Ward) ? "—" : item.Ward)</div>
                    <div><div class="k">Sample check</div>@sampleCheck</div>
                    <div class="wide"><div class="k">Clinical notes</div>@(string.IsNullOrWhiteSpace(item.ClinicalNotes) ? "—" : item.ClinicalNotes)</div>
                </div>
            </div>

            <div class="tw">
                <table class="tbl">
                    <colgroup>
                        @if (hasPrev)
                        {
                            <col style="width:22%" /><col style="width:18%" /><col style="width:17%" /><col style="width:15%" /><col style="width:15%" /><col style="width:13%" />
                        }
                        else
                        {
                            <col style="width:30%" /><col style="width:26%" /><col style="width:24%" /><col style="width:20%" />
                        }
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Parameter</th>
                            <th>Result</th>
                            <th>Reference</th>
                            <th>Flag</th>
                            @if (hasPrev)
                            {
                                <th>Previous</th>
                                <th>Change</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Parameters)
                        {
                            var group = GroupOf(p.Key);
                            if (group != "" && group != lastGroup)
                            {
                                <tr class="sec"><td colspan="@cols">@group</td></tr>
                                lastGroup = group;
                            }
                            var critText = (p.CritLow.HasValue || p.CritHigh.HasValue)
                                ? "critical " + (p.CritLow.HasValue ? "< " + F(p.CritLow.Value) : "") + (p.CritLow.HasValue && p.CritHigh.HasValue ? ", " : "") + (p.CritHigh.HasValue ? "> " + F(p.CritHigh.Value) : "")
                                : null;
                            <tr id="r_@p.Key">
                                <td>
                                    <div class="rn">@p.Name</div>
                                    @if (!string.IsNullOrEmpty(p.Unit))
                                    {
                                        <div class="ru">@p.Unit</div>
                                    }
                                </td>
                                <td><input class="in" type="text" id="i_@p.Key" data-key="@p.Key" autocomplete="off" inputmode="@(p.IsText ? "text" : "decimal")" aria-label="@p.Name result" /></td>
                                <td>
                                    @p.RangeText
                                    @if (critText != null)
                                    {
                                        <div class="ru">@critText</div>
                                    }
                                </td>
                                <td id="f_@p.Key"></td>
                                @if (hasPrev)
                                {
                                    <td class="prev">
                                        @if (prevMap.TryGetValue(p.Key, out var pv))
                                        {
                                            @F(pv)
                                            @if (prevDate.HasValue)
                                            {
                                                <div class="ru">@prevDate.Value.ToString("d MMM")</div>
                                            }
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                    <td id="d_@p.Key"></td>
                                }
                            </tr>
                            <tr class="cpn" id="c_@p.Key" style="display:none">
                                <td colspan="@cols">
                                    <div class="cpn-title">Critical value. Phone the requesting clinician before you submit.</div>
                                    <div class="cpn-grid">
                                        <label>Who was notified<input class="in sm" type="text" id="n_@p.Key" placeholder="Name and role" autocomplete="off" /></label>
                                        <label>Time<input class="in sm" type="text" id="t_@p.Key" placeholder="HH:MM" autocomplete="off" /></label>
                                        <label class="readback"><input type="checkbox" id="k_@p.Key" />Result read back and confirmed</label>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="margin-bottom:12px">
                <div class="note-label">Note to verifier (optional)</div>
                <input class="note-input" type="text" id="verifierNoteInput" maxlength="300" placeholder="e.g. repeated on the analyser, same result" autocomplete="off" />
            </div>

            <div class="err" id="err" role="alert"></div>
            <div class="foot">
                <span class="hint">Tab or Enter moves to the next result. Commas work as decimals.</span>
                <button type="button" class="btn btn-primary" id="reviewBtn">Review and submit</button>
            </div>

            <div class="card summary" id="summary"></div>

            <form id="saveForm" method="post" asp-controller="TechnicianDashboard" asp-action="SaveResults">
                <input type="hidden" name="id" value="@item.TestId" />
                <input type="hidden" name="resultsJson" id="resultsJson" />
                <input type="hidden" name="verifierNote" id="verifierNote" />
            </form>

        </main>
    </div>

    <div class="modal-overlay" id="discardModal">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="discardTitle">
            <div class="modal-title" id="discardTitle">Discard entered results?</div>
            <p>You have results that haven't been submitted. If you leave now, they will be lost.</p>
            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" id="keepBtn">Keep editing</button>
                <button type="button" class="btn btn-danger" id="leaveBtn">Discard and leave</button>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var params = @Json.Serialize(Model.Parameters);
            var existing = @Json.Serialize(Model.Existing);
            var prev = @Json.Serialize(prevMap);
            var DELTA_LIMIT = 20;
            var dirty = false, pendingUrl = null;

            function el(id) { return document.getElementById(id); }
            function norm(s) { return (s || '').trim().replace(',', '.'); }
            function isNum(s) { return /^-?\d+(\.\d+)?$/.test(s); }
            function hhmm() { var d = new Date(); return ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2); }

            function flagOf(p, raw) {
                if (p.isText) return raw.trim() ? 'text' : '';
                var s = norm(raw);
                if (!s) return '';
                if (!isNum(s)) return 'invalid';
                var v = parseFloat(s);
                if (p.critLow != null && v < p.critLow) return 'crit-low';
                if (p.critHigh != null && v > p.critHigh) return 'crit-high';
                if (p.low != null && v < p.low) return 'low';
                if (p.high != null && v > p.high) return 'high';
                return 'normal';
            }
            var LABEL = {
                'normal': ['Normal', 'flag-ok'], 'low': ['Low ↓', 'flag-low'], 'high': ['High ↑', 'flag-high'],
                'crit-low': ['Critical ↓', 'flag-crit'], 'crit-high': ['Critical ↑', 'flag-crit']
            };
            function isCrit(f) { return f === 'crit-low' || f === 'crit-high'; }

            function update(p) {
                var raw = el('i_' + p.key).value, f = flagOf(p, raw);
                var row = el('r_' + p.key), fc = el('f_' + p.key), dc = el('d_' + p.key), cp = el('c_' + p.key);
                row.classList.remove('is-warn', 'is-crit');
                fc.textContent = '';
                if (dc) { dc.textContent = ''; dc.className = ''; dc.removeAttribute('title'); }

                if (f === 'invalid') {
                    var bad = document.createElement('span');
                    bad.className = 'bad-text'; bad.textContent = 'Enter a number';
                    fc.appendChild(bad);
                } else if (LABEL[f]) {
                    var chip = document.createElement('span');
                    chip.className = 'chip ' + LABEL[f][1]; chip.textContent = LABEL[f][0];
                    fc.appendChild(chip);
                    if (f === 'low' || f === 'high') row.classList.add('is-warn');
                    if (isCrit(f)) row.classList.add('is-crit');

                    var pv = prev[p.key];
                    if (dc && pv != null && pv !== 0) {
                        var v = parseFloat(norm(raw)), diff = v - pv, pct = Math.round(diff / pv * 100);
                        dc.textContent = (pct > 0 ? '+' : pct < 0 ? '−' : '') + Math.abs(pct) + '%';
                        dc.title = 'Change of ' + (diff > 0 ? '+' : '−') + Math.abs(diff).toFixed(2) + ' ' + (p.unit || '') + ' since the previous result';
                        if (Math.abs(pct) >= DELTA_LIMIT) { dc.className = 'delta-big'; dc.textContent += ' ⚠'; }
                        else { dc.className = 'prev'; }
                    }
                }

                var crit = isCrit(f);
                cp.style.display = crit ? '' : 'none';
                if (crit && !el('t_' + p.key).value) el('t_' + p.key).value = hhmm();
                if (!crit) { el('k_' + p.key).checked = false; }
                progress();
            }

            function done() {
                return params.filter(function (p) { var f = flagOf(p, el('i_' + p.key).value); return f && f !== 'invalid'; }).length;
            }
            function progress() {
                var c = el('counter');
                if (c) c.textContent = done() + '/' + params.length;
                el('err').textContent = '';
            }
            function showError(msg, focusId) {
                el('err').textContent = msg;
                if (focusId && el(focusId)) el(focusId).focus();
            }

            existing.forEach(function (r) {
                var inp = el('i_' + r.key);
                if (inp && r.value) inp.value = r.value;
            });
            params.forEach(function (p) { if (el('i_' + p.key).value) update(p); });
            progress();

            params.forEach(function (p, i) {
                var inp = el('i_' + p.key);
                inp.addEventListener('input', function () { dirty = true; update(p); });
                inp.addEventListener('keydown', function (e) {
                    if (e.key !== 'Enter') return;
                    e.preventDefault();
                    var next = params[i + 1];
                    if (next) el('i_' + next.key).focus(); else el('verifierNoteInput').focus();
                });
                ['n_', 't_', 'k_'].forEach(function (pre) {
                    el(pre + p.key).addEventListener('input', function () { dirty = true; el('err').textContent = ''; });
                });
            });
            el('verifierNoteInput').addEventListener('input', function () { dirty = true; });

            function review() {
                var summary = el('summary');
                summary.classList.remove('show');
                var normal = 0, abnormal = 0, critical = 0;

                for (var i = 0; i < params.length; i++) {
                    var p = params[i], raw = el('i_' + p.key).value, f = flagOf(p, raw);
                    if (!f) { showError('Enter a result for ' + p.name + '.', 'i_' + p.key); return; }
                    if (f === 'invalid') { showError(p.name + ' must be a number, for example 12.5.', 'i_' + p.key); return; }
                    if (isCrit(f)) {
                        if (!el('n_' + p.key).value.trim()) { showError('Record who was notified of the critical ' + p.name + '.', 'n_' + p.key); return; }
                        if (!/^\d{1,2}:\d{2}$/.test(el('t_' + p.key).value.trim())) { showError('Enter the time of the call for ' + p.name + ', for example 14:30.', 't_' + p.key); return; }
                        if (!el('k_' + p.key).checked) { showError('Tick the read-back for the critical ' + p.name + '.', 'k_' + p.key); return; }
                        critical++;
                    } else if (f === 'low' || f === 'high') { abnormal++; }
                    else { normal++; }
                }

                el('err').textContent = '';
                summary.innerHTML = '';
                var foot = document.createElement('div'); foot.className = 'foot';
                var chips = document.createElement('div'); chips.style.cssText = 'display:flex;gap:8px;flex-wrap:wrap';
                [['Normal', 'flag-ok', normal], ['Abnormal', 'flag-low', abnormal], ['Critical', 'flag-crit', critical]].forEach(function (c) {
                    var s = document.createElement('span'); s.className = 'chip ' + c[1]; s.textContent = c[0] + ': ' + c[2]; chips.appendChild(s);
                });
                var btns = document.createElement('div'); btns.style.cssText = 'display:flex;gap:8px';
                var back = document.createElement('button'); back.type = 'button'; back.className = 'btn btn-ghost'; back.textContent = 'Go back';
                var go = document.createElement('button'); go.type = 'button'; go.className = 'btn btn-primary'; go.id = 'confirmBtn'; go.textContent = 'Confirm and submit';
                btns.appendChild(back); btns.appendChild(go);
                foot.appendChild(chips); foot.appendChild(btns);
                var hint = document.createElement('div'); hint.className = 'hint';
                hint.textContent = 'A different technician must verify these results before release.';
                summary.appendChild(foot); summary.appendChild(hint);
                summary.classList.add('show');
                back.addEventListener('click', function () { summary.classList.remove('show'); });
                go.addEventListener('click', submitForm);
            }

            function submitForm() {
                var payload = [];
                params.forEach(function (p) {
                    var raw = el('i_' + p.key).value.trim();
                    if (!raw) return;
                    var f = flagOf(p, raw), comment = '';
                    if (isCrit(f)) {
                        comment = 'Critical value: ' + el('n_' + p.key).value.trim() + ' notified at ' + el('t_' + p.key).value.trim() + ', result read back';
                    }
                    payload.push({ key: p.key, value: p.isText ? raw : norm(raw), comment: comment });
                });
                el('resultsJson').value = JSON.stringify(payload);
                el('verifierNote').value = el('verifierNoteInput').value.trim();
                el('confirmBtn').disabled = true;
                dirty = false;
                el('saveForm').submit();
            }

            el('reviewBtn').addEventListener('click', review);

            document.addEventListener('click', function (e) {
                var a = e.target.closest('a[href]');
                if (!a || !dirty) return;
                e.preventDefault();
                pendingUrl = a.href;
                el('discardModal').classList.add('open');
            });
            el('keepBtn').addEventListener('click', function () { el('discardModal').classList.remove('open'); });
            el('leaveBtn').addEventListener('click', function () { dirty = false; if (pendingUrl) window.location.href = pendingUrl; });
            el('discardModal').addEventListener('click', function (e) { if (e.target === this) this.classList.remove('open'); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') el('discardModal').classList.remove('open'); });
            window.addEventListener('beforeunload', function (e) { if (dirty) { e.preventDefault(); e.returnValue = ''; } });
        })();
    </script>

</body>
</html>
