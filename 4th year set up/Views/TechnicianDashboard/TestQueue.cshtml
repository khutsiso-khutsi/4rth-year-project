@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Testing Queue";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Testing Queue — NMB-HLabSys</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">

    <style>
        :root {
            --navy: #0b1f33;
            --navy2: #132d46;
            --teal: #087f8c;
            --teal-light: #e5f5f6;
            --orange: #e67e22;
            --orange-light: #fdf0e5;
            --amber: #d99a00;
            --red: #c0392b;
            --green: #27804d;
            --blue: #3269a8;
            --purple: #7353a6;
            --slate: #64748b;
            --white: #ffffff;
            --offwhite: #f7f9fa;
            --muted: #6b7c8f;
            --border: #e1e7ec;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
        }

        /* TOPBAR */
        .topbar {
            height: 70px;
            background: var(--navy);
            color: var(--white);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 32px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-mark {
            width: 38px;
            height: 38px;
            background: var(--teal);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
        }

        .brand-text {
            font-family: 'DM Serif Display', serif;
            font-size: 20px;
        }

            .brand-text span {
                color: #65c8cf;
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .system-status {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 12px;
            color: #a8bdcf;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background: #48c78e;
            border-radius: 50%;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: var(--teal);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
        }

        .user-name {
            font-size: 13px;
            font-weight: 600;
        }

        .user-role {
            font-size: 11px;
            color: #a8bdcf;
        }

        /* LAYOUT */
        .layout {
            display: flex;
            min-height: calc(100vh - 70px);
        }

        /* SIDEBAR */
        .sidebar {
            width: 220px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 24px 0;
            flex-shrink: 0;
            position: sticky;
            top: 80px;
            height: calc(100vh - 64px);
            overflow-y: auto;
        }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 20px;
            margin-bottom: 4px;
            margin-top: 16px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all 0.15s;
        }

            .nav-item:hover {
                background: var(--offwhite);
                color: var(--navy);
            }

            .nav-item.active {
                background: var(--orange-light);
                color: var(--orange);
                border-left-color: var(--orange);
            }

            .nav-item svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        /* MAIN */
        .main {
            flex: 1;
            padding: 32px 38px;
            min-width: 0;
        }

        /* WELCOME */
        .welcome {
            background: var(--navy);
            border-radius: 12px;
            padding: 25px 28px;
            color: var(--white);
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
        }

            .welcome::after {
                content: "";
                position: absolute;
                width: 230px;
                height: 230px;
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 50%;
                right: -70px;
                top: -100px;
            }

        .welcome-tag {
            display: inline-block;
            background: rgba(101,200,207,0.14);
            color: #65c8cf;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 5px 9px;
            border-radius: 4px;
            margin-bottom: 8px;
        }

        .welcome h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 27px;
            font-weight: 400;
            margin-bottom: 5px;
        }

            .welcome h1 em {
                color: #65c8cf;
                font-style: normal;
            }

        .welcome p {
            color: #a8bdcf;
            font-size: 12px;
        }

        /* STATS */
        .stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 18px;
            position: relative;
            transition: box-shadow 0.2s;
        }

            .stat-card.pulse {
                box-shadow: 0 0 0 3px rgba(8,127,140,0.25);
            }

        .stat-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .stat-label {
            font-size: 11px;
            color: var(--muted);
            font-weight: 500;
        }

        .stat-icon {
            width: 30px;
            height: 30px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
        }

        .stat-number {
            font-size: 28px;
            font-weight: 700;
            margin-top: 10px;
            line-height: 1;
        }

        .stat-footer {
            font-size: 10px;
            color: var(--muted);
            margin-top: 7px;
        }

            .stat-footer strong {
                color: var(--green);
            }

        .icon-amber {
            background: #fff5d9;
            color: var(--amber);
        }

        .icon-blue {
            background: #eaf2fb;
            color: var(--blue);
        }

        .icon-orange {
            background: var(--orange-light);
            color: var(--orange);
        }

        .icon-green {
            background: #e7f5ed;
            color: var(--green);
        }

        /* CONTENT GRID */
        .content-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr;
            gap: 20px;
        }

        .card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
        }

        .card-header {
            padding: 18px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .card-title {
            font-size: 14px;
            font-weight: 700;
        }

        .card-subtitle {
            font-size: 11px;
            color: var(--muted);
            margin-top: 3px;
        }

        /* FILTERS */
        .filters {
            padding: 14px 20px;
            background: #fafbfc;
            border-bottom: 1px solid var(--border);
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .search-box {
            flex: 1;
        }

            .search-box input,
            .filters select {
                width: 100%;
                border: 1px solid var(--border);
                border-radius: 6px;
                padding: 8px 10px;
                font-family: 'DM Sans', sans-serif;
                font-size: 11px;
                color: var(--navy);
                background: var(--white);
            }

        .filters select {
            width: auto;
            min-width: 120px;
        }

        .btn {
            border: none;
            border-radius: 6px;
            padding: 8px 12px;
            font-family: 'DM Sans', sans-serif;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn:disabled {
                opacity: 0.55;
                cursor: not-allowed;
            }

        .btn-primary {
            background: var(--teal);
            color: var(--white);
        }

            .btn-primary:hover {
                background: #076c77;
            }

        .btn-ghost {
            background: #f1f5f7;
            color: var(--navy);
        }

            .btn-ghost:hover {
                background: #e5eaee;
            }

        /* TABLE */
        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .6px;
            color: #8998a6;
            font-weight: 700;
            padding: 11px 20px;
            background: #fafbfc;
            border-bottom: 1px solid var(--border);
        }

        td {
            padding: 13px 20px;
            border-bottom: 1px solid #edf0f2;
            font-size: 11px;
            color: #435466;
            vertical-align: middle;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover {
            background: #fafcfd;
        }

        td strong {
            color: var(--navy);
            font-weight: 600;
        }

        /* BADGES */
        .badge {
            display: inline-block;
            padding: 4px 7px;
            border-radius: 4px;
            font-size: 9px;
            font-weight: 700;
        }

        .badge-urgent {
            background: #fde8e6;
            color: var(--red);
        }

        .badge-pending {
            background: #fff5d9;
            color: var(--amber);
        }

        .badge-inprogress {
            background: #eaf2fb;
            color: var(--blue);
        }

        .badge-complete {
            background: #e7f5ed;
            color: var(--green);
        }

        .badge-review {
            background: var(--orange-light);
            color: var(--orange);
        }

        /* EMPTY STATE */
        .empty-state {
            padding: 35px 20px;
            text-align: center;
            color: var(--muted);
        }

        .empty-icon {
            font-size: 26px;
            margin-bottom: 8px;
        }

        .empty-state strong {
            display: block;
            color: var(--navy);
            font-size: 13px;
            margin-bottom: 4px;
        }

        .empty-state p {
            font-size: 11px;
        }

        /* WARNING BANNER (low/insufficient stock) */
        .stock-warning {
            display: none;
            align-items: flex-start;
            gap: 10px;
            background: #fff5d9;
            border: 1px solid #f0d78c;
            color: #6b5200;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 11.5px;
            margin: 16px 20px 0;
        }

            .stock-warning.show {
                display: flex;
            }

            .stock-warning .close-warning {
                margin-left: auto;
                background: none;
                border: none;
                cursor: pointer;
                color: #6b5200;
                font-size: 13px;
            }

        /* TOAST */
        .toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: var(--navy);
            color: white;
            padding: 12px 18px;
            border-radius: 8px;
            font-size: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.25);
            z-index: 300;
            display: none;
            max-width: 320px;
        }

            .toast.show {
                display: block;
            }

        /* RESPONSIVE */
        @@media (max-width: 1100px) {
            .stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .content-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 800px) {
            .sidebar {
                width: 190px;
            }

            .main {
                padding: 25px;
            }
        }

        @@media (max-width: 650px) {
            .sidebar {
                display: none;
            }

            .main {
                padding: 18px;
            }

            .stats {
                grid-template-columns: 1fr 1fr;
            }

            .topbar {
                padding: 0 18px;
            }

            .system-status {
                display: none;
            }
        }
    </style>
</head>

<body>

    <!-- TOPBAR -->
    <header class="topbar">
        <div class="brand">
            <div class="brand-mark">HL</div>
            <div class="brand-text">NMB-<span>HLabSys</span></div>
        </div>

        <div class="topbar-right">
            <div class="system-status">
                <span class="status-dot"></span>
                System Online
            </div>

            <div class="user-info">
                <div class="avatar">LT</div>
                <div>
                    <div class="user-name">Lab Technician</div>
                    <div class="user-role">Testing Department</div>
                </div>
            </div>
        </div>
    </header>


    <div class="layout">

        <aside class="sidebar">

            <a asp-controller="TechnicianDashboard" asp-action="Index" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 10.5L12 3l9 7.5" />
                    <path d="M5 9.5V21h14V9.5" />
                    <path d="M9 21v-6h6v6" />
                </svg>
                Dashboard
            </a>

            <div class="nav-label">Samples and Requests</div>

            <a asp-controller="TechnicianDashboard" asp-action="ReceiveSamples" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6" />
                    <polyline points="16 6 12 10 8 6" />
                    <line x1="12" y1="10" x2="12" y2="2" />
                </svg>
                Receive Samples
            </a>

            <div class="nav-label">Tests</div>

            <a asp-controller="TechnicianDashboard" asp-action="TestQueue" class="nav-item active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 2v6.5L4.5 17a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L15 8.5V2" />
                    <line x1="9" y1="2" x2="15" y2="2" />
                </svg>
                Testing Queue
            </a>

            <div class="nav-label">Results</div>

            <a asp-controller="TechnicianDashboard" asp-action="CaptureResults" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="4" y="3" width="16" height="18" rx="2" />
                    <line x1="8" y1="8" x2="16" y2="8" />
                    <line x1="8" y1="12" x2="16" y2="12" />
                    <line x1="8" y1="16" x2="13" y2="16" />
                </svg>
                Capture Results
            </a>

            <a asp-controller="TechnicianDashboard" asp-action="Verification" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="9 12 11 14 15 10" />
                </svg>
                Verification
            </a>

            <div class="nav-label">Reports</div>

            <a asp-controller="TechnicianDashboard" asp-action="Reports" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="4" y1="19" x2="20" y2="19" />
                    <rect x="5" y="10" width="3" height="7" />
                    <rect x="10.5" y="6" width="3" height="11" />
                    <rect x="16" y="3" width="3" height="14" />
                </svg>
                Reporting
            </a>

            <div class="nav-label">System</div>

            <a asp-controller="TechnicianDashboard" asp-action="Profile" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                Profile
            </a>

        </aside>

        <!-- MAIN CONTENT -->
        <main class="main">

            <!-- WELCOME -->
            <section class="welcome">
                <div class="welcome-tag">Testing Technician</div>
                <h1>Welcome back, <em>Technician</em></h1>
                <p>
                    Select eligible tests, begin processing, and monitor your turnaround time —
                    @DateTime.Now.ToString("dddd, dd MMMM yyyy")
                </p>
            </section>

            <!-- STATS -->
            <section class="stats">

                <div class="stat-card" id="statCardAvailable">
                    <div class="stat-top">
                        <div class="stat-label">Available to Claim</div>
                        <div class="stat-icon icon-amber">▣</div>
                    </div>
                    <div class="stat-number" id="statAvailable">0</div>
                    <div class="stat-footer">Open</div>
                </div>

                <div class="stat-card" id="statCardActive">
                    <div class="stat-top">
                        <div class="stat-label">My Active Tests</div>
                        <div class="stat-icon icon-blue">◷</div>
                    </div>
                    <div class="stat-number" id="statActive">0</div>
                    <div class="stat-footer">Active</div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-label">Returned for Review</div>
                        <div class="stat-icon icon-orange">!</div>
                    </div>
                    <div class="stat-number" id="statReview">1</div>
                    <div class="stat-footer">Needs work</div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-label">Completed Today</div>
                        <div class="stat-icon icon-green">✓</div>
                    </div>
                    <div class="stat-number" id="statCompleted">6</div>
                    <div class="stat-footer"><strong>+3 today</strong></div>
                </div>

            </section>

            <!-- STOCK WARNING BANNER -->
            <div class="stock-warning" id="stockWarning">
                <span>⚠</span>
                <span id="stockWarningText"></span>
                <button class="close-warning" onclick="dismissWarning()">✕</button>
            </div>

            <!-- CONTENT GRID -->
            <section class="content-grid">

                <!-- AVAILABLE TESTS -->
                <div class="card">
                    <div class="card-header">
                        <div>
                            <div class="card-title">Available Tests</div>
                            <div class="card-subtitle">Tests you are authorized for and ready to claim</div>
                        </div>
                    </div>

                    <div class="filters">
                        <div class="search-box">
                            <input type="text" id="searchInput" placeholder="Search Request #" oninput="renderAvailable()" />
                        </div>
                        <select id="urgencyFilter" onchange="renderAvailable()">
                            <option value="">All Urgency</option>
                            <option value="STAT">STAT</option>
                            <option value="Routine">Routine</option>
                        </select>
                        <select id="categoryFilter" onchange="renderAvailable()">
                            <option value="">All Categories</option>
                            <option>Full Blood Count</option>
                            <option>Blood Film</option>
                            <option>Liver Function Panel</option>
                            <option>Coagulation Studies</option>
                        </select>
                        <button type="button" class="btn btn-ghost" onclick="resetFilters()">Reset</button>
                    </div>

                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Request #</th>
                                    <th>Test</th>
                                    <th>Urgency</th>
                                    <th>Due By</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="availableTableBody">
                                <!-- rendered by JS -->
                            </tbody>
                        </table>
                    </div>
                    <div class="empty-state" id="availableEmptyState" style="display:none;">
                        <div class="empty-icon">✓</div>
                        <strong>All caught up</strong>
                        <p>No tests currently waiting to be claimed.</p>
                    </div>
                </div>

                <!-- MY ACTIVE TESTS -->
                <div class="card">
                    <div class="card-header">
                        <div>
                            <div class="card-title">My Active Tests</div>
                            <div class="card-subtitle">Tests currently assigned to you</div>
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Request</th>
                                    <th>Test</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="activeTableBody">
                                <!-- rendered by JS -->
                            </tbody>
                        </table>
                    </div>
                    <div class="empty-state" id="activeEmptyState" style="display:none;">
                        <div class="empty-icon">◷</div>
                        <strong>No active tests</strong>
                        <p>Claim a test from the left to get started.</p>
                    </div>
                </div>

            </section>

        </main>

    </div>

    <div class="toast" id="toast"></div>

    <script>
        // ---------------------------------------------------------------
        // In-memory demo data only - no database/back end dependency.
        // Each test object represents one row of TestRequest_TestType,
        // i.e. one test type on one request, awaiting a technician.
        // ---------------------------------------------------------------
        let nextId = 100;
        function makeTest(reqNumber, testName, urgency, dueBy, category, lowStock) {
            return {
                id: nextId++,
                requestNumber: reqNumber,
                testName: testName,
                urgency: urgency,      // "STAT" | "Routine"
                dueBy: dueBy,
                category: category,
                lowStock: !!lowStock,  // simulates a consumable at/below reorder level
                status: 'Submitted',
                startTime: null
            };
        }

        let availableTests = [
            makeTest('REQ-0150', 'Full Blood Count', 'STAT', '14:30', 'Full Blood Count', false),
            makeTest('REQ-0150', 'Blood Film', 'Routine', '16:00', 'Blood Film', true),
            makeTest('REQ-0152', 'Liver Function Panel', 'Routine', '17:00', 'Liver Function Panel', false)
        ];

        // Pre-seeded so the "My Active Tests" panel isn't empty on load,
        // matching the two rows in the original static mock-up.
        let activeTests = [
            { id: 1, requestNumber: 'REQ-0152', testName: 'Serum Potassium', status: 'In Progress' },
            { id: 2, requestNumber: 'REQ-0149', testName: 'Platelet Count', status: 'To Be Reviewed' }
        ];

        // Base path to the Capture Results action, resolved server-side so it
        // still works wherever the app is hosted/published (e.g. the SICT server).
        const captureResultsBaseUrl = '@Url.Action("CaptureResults", "TechnicianDashboard")';

        function buildCaptureResultsUrl(test) {
            const params = new URLSearchParams({
                id: test.id,
                req: test.requestNumber,
                test: test.testName,
                review: test.status === 'To Be Reviewed' ? '1' : '0'
            });
            return `${captureResultsBaseUrl}?${params.toString()}`;
        }

        function badgeClassForUrgency(urgency) {
            return urgency === 'STAT' ? 'badge-urgent' : 'badge-pending';
        }

        function badgeClassForStatus(status) {
            switch (status) {
                case 'In Progress': return 'badge-inprogress';
                case 'To Be Reviewed': return 'badge-review';
                case 'Completed': return 'badge-complete';
                default: return 'badge-pending';
            }
        }

        function renderAvailable() {
            const search = document.getElementById('searchInput').value.trim().toLowerCase();
            const urgency = document.getElementById('urgencyFilter').value;
            const category = document.getElementById('categoryFilter').value;

            const filtered = availableTests.filter(t => {
                if (search && !t.requestNumber.toLowerCase().includes(search)) return false;
                if (urgency && t.urgency !== urgency) return false;
                if (category && t.category !== category) return false;
                return true;
            });

            const tbody = document.getElementById('availableTableBody');
            tbody.innerHTML = '';

            filtered.forEach(t => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><strong>${t.requestNumber}</strong></td>
                    <td>${t.testName}${t.lowStock ? ' <span title="Linked consumable is low on stock">⚠</span>' : ''}</td>
                    <td><span class="badge ${badgeClassForUrgency(t.urgency)}">${t.urgency}</span></td>
                    <td>${t.dueBy}</td>
                    <td style="text-align:right">
                        <button type="button" class="btn btn-primary" onclick="claimTest(${t.id})">Assign to Me</button>
                    </td>`;
                tbody.appendChild(tr);
            });

            document.getElementById('availableEmptyState').style.display = filtered.length === 0 ? 'block' : 'none';
            document.querySelector('#availableTableBody').closest('.table-wrap').style.display = filtered.length === 0 ? 'none' : 'block';

            updateStats();
        }

        function renderActive() {
            const tbody = document.getElementById('activeTableBody');
            tbody.innerHTML = '';

            activeTests.forEach(t => {
                const tr = document.createElement('tr');
                const openUrl = buildCaptureResultsUrl(t);
                const isReview = t.status === 'To Be Reviewed';
                tr.innerHTML = `
                    <td><strong>${t.requestNumber}</strong></td>
                    <td>${t.testName}</td>
                    <td><span class="badge ${badgeClassForStatus(t.status)}">${t.status}</span></td>
                    <td style="text-align:right">
                        <a href="${openUrl}" class="btn btn-ghost">Open</a>
                    </td>`;
                tbody.appendChild(tr);
            });

            document.getElementById('activeEmptyState').style.display = activeTests.length === 0 ? 'block' : 'none';
            document.querySelector('#activeTableBody').closest('.table-wrap').style.display = activeTests.length === 0 ? 'none' : 'block';

            updateStats();
        }

        function updateStats() {
            document.getElementById('statAvailable').textContent = availableTests.length;
            document.getElementById('statActive').textContent = activeTests.filter(t => t.status === 'In Progress').length;
        }

        function pulse(cardId) {
            const card = document.getElementById(cardId);
            card.classList.add('pulse');
            setTimeout(() => card.classList.remove('pulse'), 600);
        }

        // Claiming a test: mirrors UC-LT-02
        //  - removes it from the Available list
        //  - stamps start time / status In Progress
        //  - adds it to My Active Tests
        //  - shows a stock warning instead of blocking, per the "allow with warning" rule
        //  - no un-claim path is provided, by design
        function claimTest(testId) {
            const index = availableTests.findIndex(t => t.id === testId);
            if (index === -1) return; // already claimed / stale click

            const test = availableTests[index];
            availableTests.splice(index, 1);

            test.status = 'In Progress';
            test.startTime = new Date();

            activeTests.unshift({
                id: test.id,
                requestNumber: test.requestNumber,
                testName: test.testName,
                status: 'In Progress'
            });

            renderAvailable();
            renderActive();
            pulse('statCardAvailable');
            pulse('statCardActive');

            showToast(`"${test.testName}" (${test.requestNumber}) assigned to you. Consumables deducted from stock.`);

            if (test.lowStock) {
                showStockWarning(`Warning: a consumable linked to "${test.testName}" is now at or below its reorder level. The test has still been assigned — please notify the Laboratory Manager.`);
            }
        }

        function showStockWarning(message) {
            document.getElementById('stockWarningText').textContent = message;
            document.getElementById('stockWarning').classList.add('show');
        }

        function dismissWarning() {
            document.getElementById('stockWarning').classList.remove('show');
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 4000);
        }

        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('urgencyFilter').value = '';
            document.getElementById('categoryFilter').value = '';
            renderAvailable();
        }

        // Initial render
        renderAvailable();
        renderActive();
    </script>

</body>
</html>
