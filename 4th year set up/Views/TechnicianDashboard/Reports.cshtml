@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model _4th_year_set_up.Models.ReportsPageViewModel
@using _4th_year_set_up.Models
@{
    ViewData["Title"] = "Reporting";
    Layout = null;
    var email = ViewBag.Email?.ToString();
    var initial = string.IsNullOrEmpty(email) ? "T" : email.Substring(0, 1).ToUpper();

    var queueActive = "";
    var mineActive = "";
    var sampleActive = "";
    var resultActive = "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reporting — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/technician.css" />
    <style>
        .kinds { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; margin-bottom: 22px; }
        .kind { position: relative; display: block; border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; cursor: pointer; background: #fff; }
        .kind input { position: absolute; opacity: 0; }
        .kind strong { display: block; font-size: .92rem; margin-bottom: 4px; }
        .kind span { font-size: .8rem; color: var(--muted); line-height: 1.4; }
        .kind:has(input:checked) { border-color: var(--orange); background: var(--orange-light); }
        .kind:has(input:focus-visible) { outline: 2px solid var(--navy); outline-offset: 2px; }
        .rep-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-bottom: 18px; }
        .rep-grid .form-control { width: 100%; }
        .field-label { display: block; font-size: .75rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; }
        .graphs { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 22px; }
        .graph { border: 1px solid var(--border); border-radius: 100px; padding: 8px 18px; font-size: .85rem; font-weight: 600; cursor: pointer; background: #fff; }
        .graph input { position: absolute; opacity: 0; }
        .graph:has(input:checked) { background: var(--navy); color: #fff; border-color: var(--navy); }
        .graph:has(input:focus-visible) { outline: 2px solid var(--orange); outline-offset: 2px; }
        .rep-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
        .rep-actions .btn { height: 40px; padding: 0 22px; font-size: .85rem; }
        .rep-note { font-size: .8rem; color: var(--muted); margin-top: 14px; max-width: 680px; line-height: 1.5; }
        .check { display: flex; align-items: center; gap: 8px; font-size: .88rem; height: 34px; }
        .rep-error { color: var(--red); font-size: .82rem; margin: -8px 0 14px; display: none; }
    </style>
</head>
<body>

    @* ===== TOPBAR + SIDEBAR: identical to Index.cshtml. Only the "active" class moves. ===== *@
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">NMB-HLabSys<span>Haematology Lab System</span></div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@initial</div>
                <span class="user-email">@email</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">
        <aside class="sidebar">
            <a asp-controller="TechnicianDashboard" asp-action="Index" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10.5L12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" /><path d="M9 21v-6h6v6" /></svg>
                Dashboard
            </a>

            <div class="nav-label">Samples and Requests</div>
            <a asp-controller="TechnicianDashboard" asp-action="ReceiveSamples" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6" /><polyline points="16 6 12 10 8 6" /><line x1="12" y1="10" x2="12" y2="2" /></svg>
                Receive Samples
            </a>

            <a asp-controller="TechnicianDashboard" asp-action="SampleVerification" class="nav-item @sampleActive">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 2v6.5L4.5 17a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L15 8.5V2" /><polyline points="9 14 11 16 15 12" /></svg>
                Sample Verification
            </a>

            <div class="nav-label">Tests</div>
            <a asp-controller="TechnicianDashboard" asp-action="TestQueue" class="nav-item @queueActive">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 2v6.5L4.5 17a2 2 0 0 0 1.7 3h11.6a2 2 0 0 0 1.7-3L15 8.5V2" /><line x1="9" y1="2" x2="15" y2="2" /></svg>
                Testing Queue
            </a>
            <a asp-controller="TechnicianDashboard" asp-action="MyTests" class="nav-item @mineActive">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                My Tests
            </a>

            <div class="nav-label">Results</div>
            <a asp-controller="TechnicianDashboard" asp-action="Verification" class="nav-item @resultActive">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="9 12 11 14 15 10" /></svg>
                Result Verification
            </a>

            <div class="nav-label">Reports</div>
            <a asp-controller="TechnicianDashboard" asp-action="Reports" class="nav-item active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="19" x2="20" y2="19" /><rect x="5" y="10" width="3" height="7" /><rect x="10.5" y="6" width="3" height="11" /><rect x="16" y="3" width="3" height="14" /></svg>
                Reporting
            </a>

            <div class="nav-label">System</div>
            <a asp-controller="TechnicianDashboard" asp-action="Profile" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                Profile
            </a>
        </aside>
        @* ===== END shared topbar + sidebar ===== *@

        <main class="main">

            <div class="card">
                <div class="card-header">
                    <div>
                        <div class="card-title">Reporting</div>
                        <div class="card-sub">Choose a report, a period and a graph. The report opens as a clean A4 page you can print or save as PDF.</div>
                    </div>
                    <a class="btn btn-ghost" asp-controller="TechnicianDashboard" asp-action="Index">← Dashboard</a>
                </div>

                <form method="get" asp-controller="TechnicianDashboard" asp-action="ReportDocument" target="_blank" id="repForm">

                    <div class="field-label">1. Report</div>
                    <div class="kinds" role="radiogroup" aria-label="Report">
                        <label class="kind"><input type="radio" name="kind" value="Turnaround" checked /><strong>Test turnaround</strong><span>Average time from sample received to result verified, against each test's target.</span></label>
                        <label class="kind"><input type="radio" name="kind" value="Outstanding" /><strong>Outstanding tests</strong><span>Tests still open, by stage and how overdue they are.</span></label>
                        <label class="kind"><input type="radio" name="kind" value="Rejections" /><strong>Rejections and returns</strong><span>Samples rejected and results returned for review, with the reasons.</span></label>
                    </div>

                    <div class="field-label">2. Period and filters</div>
                    <div class="rep-grid">
                        <div><label class="field-label" for="from">From</label><input type="date" id="from" name="from" class="form-control" value="@Model.From.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
                        <div><label class="field-label" for="to">To</label><input type="date" id="to" name="to" class="form-control" value="@Model.To.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
                        <div>
                            <label class="field-label" for="testTypeId">Test type</label>
                            <select id="testTypeId" name="testTypeId" class="form-control">
                                <option value="">All tests</option>
                                @foreach (var t in Model.TestTypes) { <option value="@t.Key">@t.Value</option> }
                            </select>
                        </div>
                        <div>
                            <label class="field-label" for="priority">Priority</label>
                            <select id="priority" name="priority" class="form-control">
                                <option value="">All priorities</option>
                                <option>Routine</option><option>Urgent</option><option>STAT</option>
                            </select>
                        </div>
                        <div>
                            <label class="field-label" for="technicianId">Technician</label>
                            <select id="technicianId" name="technicianId" class="form-control">
                                <option value="">All technicians</option>
                                @foreach (var t in Model.Technicians) { <option value="@t.Key">@t.Value</option> }
                            </select>
                        </div>
                        <div>
                            <span class="field-label">Scope</span>
                            <label class="check"><input type="checkbox" name="onlyMine" value="true" /> Only my work</label>
                        </div>
                    </div>
                    <div class="rep-error" id="repError" role="alert">The start date must be on or before the end date.</div>

                    <div class="field-label">3. Graph</div>
                    <div class="graphs" role="radiogroup" aria-label="Graph type">
                        <label class="graph"><input type="radio" name="graph" value="bar" checked /> Bar graph</label>
                        <label class="graph"><input type="radio" name="graph" value="line" /> Line graph (trend by week)</label>
                    </div>

                    <div class="rep-actions">
                        <button type="submit" class="btn btn-orange">Preview report</button>
                        <button type="submit" name="print" value="true" class="btn btn-ghost">Print / Save as PDF</button>
                    </div>
                    <p class="rep-note">Reports show request numbers, test names and technician names only. No patient names or ID numbers appear on a report. In the print box choose <strong>Save as PDF</strong> and keep <em>Headers and footers</em> switched off, because the report has its own header and page numbers.</p>
                </form>
            </div>

        </main>
    </div>

    <script>
        document.getElementById('repForm').addEventListener('submit', function (e) {
            var f = document.getElementById('from').value, t = document.getElementById('to').value;
            var bad = f && t && f > t;
            document.getElementById('repError').style.display = bad ? 'block' : 'none';
            if (bad) e.preventDefault();
        });
    </script>
</body>
</html>
