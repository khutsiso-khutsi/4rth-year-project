@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model _4th_year_set_up.Models.TestItem
@using _4th_year_set_up.Models
@* The action buttons for a test, based on its stage. Used by the list rows and the details page. *@
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var inDetails = (ViewContext.RouteData.Values["action"] as string) == "TestDetails";
    var enterCss = Model.IsUrgent ? "btn-orange" : "btn-ghost";

    // Everything the sample-verification modal shows for this test's tube (patient data and consumable stock).
    var stock = ViewBag.Consumables as Dictionary<int, ConsumableCheck>;
    string NeedsJson()
    {
        var list = stock != null && Model.Sample != null && stock.TryGetValue(Model.Sample.BarcodeId, out var cc) ? cc.Needs : new List<ConsumableNeed>();
        return System.Text.Json.JsonSerializer.Serialize(list.Select(n => new { name = n.Name, needed = n.Needed, onHand = n.OnHand }));
    }
    string MissingJson()
    {
        var list = stock != null && Model.Sample != null && stock.TryGetValue(Model.Sample.BarcodeId, out var cm) ? cm.MissingTests : new List<string>();
        return System.Text.Json.JsonSerializer.Serialize(list);
    }
    var pt = Model.PatientDetails;
    var medsText = pt == null ? "" : string.Join("||", pt.Medications.Select(m => $"{m.Name} {m.Dose}"));
}

@switch (Model.Stage)
{
    case TestStage.AwaitingSampleVerification:
        <button type="button" class="btn btn-primary js-verify-sample"
                data-id="@Model.TestId" data-req="@Model.ReqNum" data-tube="@Model.Sample.TubeId" data-tests="@Model.Sample.TestsLabel"
                data-patient="@(pt == null ? "" : $"{pt.FullName} ({pt.Age} y, {pt.Sex})")"
                data-allergies="@pt?.Allergies" data-conditions="@pt?.Conditions" data-meds="@medsText"
                data-precautions="@pt?.Precautions" data-notes="@Model.ClinicalNotes" data-needs="@NeedsJson()" data-missing="@MissingJson()">Verify sample</button>
        break;

    case TestStage.SampleRejected:
        <span class="muted-note">Recollection requested</span>
        break;

    case TestStage.AwaitingAssignment:
        <form method="post" asp-controller="TechnicianDashboard" asp-action="SelectTest" class="inline-form">
            <input type="hidden" name="id" value="@Model.TestId" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" class="btn btn-primary">Select test</button>
        </form>
        break;

    case TestStage.ToBeReviewed:
        if (Model.AssignedToMe)
        {
            <a asp-controller="TechnicianDashboard" asp-action="CaptureResults" asp-route-id="@Model.TestId"
               class="btn btn-orange">Review &amp; re-enter</a>
        }
        else
        {
            <span class="muted-note">Assigned to another technician</span>
        }
        break;

    case TestStage.Assigned:
    case TestStage.InProgress:
        if (Model.AssignedToMe)
        {
            <a asp-controller="TechnicianDashboard" asp-action="CaptureResults" asp-route-id="@Model.TestId"
               class="btn @enterCss">Enter Results</a>
            if (Model.Stage == TestStage.Assigned)
            {
                <form method="post" asp-controller="TechnicianDashboard" asp-action="ReleaseTest" class="inline-form">
                    <input type="hidden" name="id" value="@Model.TestId" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn btn-ghost">Return to pool</button>
                </form>
            }
        }
        else
        {
            <span class="muted-note">Assigned to another technician</span>
        }
        break;

    case TestStage.Complete:
        if (CurrentUser.CanVerifyResult(Model))
        {
            <a asp-controller="TechnicianDashboard" asp-action="VerifyResult" asp-route-id="@Model.TestId" class="btn btn-orange">Verify result</a>
        }
        else
        {
            <span class="muted-note">Awaiting another technician</span>
        }
        break;

    case TestStage.Verified:
        if (!inDetails)
        {
            <a asp-controller="TechnicianDashboard" asp-action="TestDetails" asp-route-id="@Model.TestId" class="btn btn-ghost">View</a>
        }
        break;
}
