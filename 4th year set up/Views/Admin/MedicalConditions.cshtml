@{
    ViewData["Title"] = "Medical conditions";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Medical conditions — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --blue: #1a4f8a;
            --accent: #e8f0fe;
            --teal: #0d9488;
            --teal-light: #e8f5f3;
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --sidebar-width: 240px;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .topnav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            background: var(--navy);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            height: 64px;
            box-shadow: 0 2px 20px rgba(0,0,0,0.25);
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .nav-logo {
            width: 36px;
            height: 36px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .nav-logo svg {
                width: 20px;
                height: 20px;
                fill: white;
            }

        .nav-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.05rem;
            color: white;
            line-height: 1.2;
        }

            .nav-title span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.62rem;
                font-weight: 300;
                color: rgba(255,255,255,0.45);
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .nav-user {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 8px;
            padding: 6px 14px 6px 8px;
        }

        .nav-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--teal);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            color: white;
        }

        .nav-user-info {
            line-height: 1.3;
        }

        .nav-user-name {
            font-size: 13px;
            font-weight: 500;
            color: white;
        }

        .nav-user-role {
            font-size: 11px;
            color: rgba(255,255,255,0.45);
        }

        .btn-signout {
            display: flex;
            align-items: center;
            gap: 7px;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.18);
            color: rgba(255,255,255,0.7);
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            padding: 7px 16px;
            border-radius: 7px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s;
        }

            .btn-signout:hover {
                background: rgba(255,255,255,0.08);
                color: white;
            }

            .btn-signout svg {
                width: 14px;
                height: 14px;
            }

        .app-body {
            display: flex;
            padding-top: 64px;
            min-height: 100vh;
        }

        .sidebar {
            width: var(--sidebar-width);
            background: var(--white);
            border-right: 1px solid var(--border);
            position: fixed;
            top: 64px;
            bottom: 0;
            left: 0;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            padding: 24px 0 20px;
        }

        .sidebar-section {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--muted);
            padding: 0 20px;
            margin: 20px 0 8px;
        }

            .sidebar-section:first-child {
                margin-top: 0;
            }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 20px;
            font-size: 13.5px;
            font-weight: 400;
            color: var(--muted);
            text-decoration: none;
            transition: all 0.15s;
            border-left: 3px solid transparent;
            cursor: pointer;
        }

            .nav-item:hover {
                background: var(--offwhite);
                color: var(--navy);
            }

            .nav-item.active {
                background: var(--teal-light);
                color: var(--teal);
                border-left-color: var(--teal);
                font-weight: 500;
            }

            .nav-item svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        .sidebar-bottom {
            margin-top: auto;
            border-top: 1px solid var(--border);
            padding-top: 16px;
        }

        .nav-item.danger {
            color: var(--red);
        }

            .nav-item.danger:hover {
                background: #fef2f2;
            }

        .main {
            margin-left: var(--sidebar-width);
            flex: 1;
            padding: 32px 36px;
        }

        .page-header {
            margin-bottom: 28px;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
        }

        .page-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--teal);
            margin-bottom: 6px;
        }

        .page-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.8rem;
            color: var(--navy);
            line-height: 1.2;
        }

        .page-sub {
            font-size: 13.5px;
            color: var(--muted);
            margin-top: 4px;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--teal);
            color: white;
            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            font-weight: 500;
            padding: 10px 20px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s;
        }

            .btn-primary:hover {
                background: #0f7a70;
            }

            .btn-primary svg {
                width: 15px;
                height: 15px;
            }

        .card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 22px 24px;
            margin-bottom: 24px;
        }

        .search-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
        }

        .search-input {
            flex: 1;
            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            padding: 9px 14px;
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--navy);
            outline: none;
            transition: border-color 0.2s;
        }

            .search-input:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(13,148,136,0.1);
            }

        .filter-select {
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            padding: 9px 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--navy);
            outline: none;
            background: var(--white);
        }

            .filter-select:focus {
                border-color: var(--teal);
            }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        th {
            text-align: left;
            padding: 10px 14px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--muted);
            border-bottom: 1px solid var(--border);
        }

        td {
            padding: 13px 14px;
            color: var(--navy);
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background: var(--offwhite);
        }

        .pill {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 100px;
            font-size: 11px;
            font-weight: 500;
        }

        .pill-red {
            background: #fef2f2;
            color: var(--red);
        }

        /* Inactive row badge (was used in the view but not defined) */
        .pill-inactive {
            background: #f1f5f9;
            color: var(--muted);
            margin-left: 6px;
        }

        .action-btns {
            display: flex;
            gap: 8px;
        }

        .btn-sm {
            font-family: 'DM Sans', sans-serif;
            font-size: 12px;
            font-weight: 500;
            padding: 5px 12px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--white);
            color: var(--navy);
            cursor: pointer;
            text-decoration: none;
            transition: all 0.15s;
        }

            .btn-sm:hover {
                background: var(--offwhite);
            }

            .btn-sm.danger {
                color: var(--red);
                border-color: #fecaca;
            }

                .btn-sm.danger:hover {
                    background: #fef2f2;
                }

        .empty-state {
            text-align: center;
            padding: 48px 24px;
            color: var(--muted);
        }

            .empty-state svg {
                width: 40px;
                height: 40px;
                margin: 0 auto 12px;
                display: block;
                opacity: 0.4;
            }

            .empty-state p {
                font-size: 14px;
            }

        .modal-bg {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(11,31,58,0.45);
            z-index: 200;
            align-items: center;
            justify-content: center;
        }

            .modal-bg.open {
                display: flex;
            }

        .modal {
            background: var(--white);
            border-radius: 16px;
            padding: 32px;
            width: 100%;
            max-width: 480px;
            border: 1px solid var(--border);
        }

        .modal-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.3rem;
            color: var(--navy);
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-label {
            display: block;
            font-size: 12.5px;
            font-weight: 500;
            color: var(--navy);
            margin-bottom: 6px;
        }

        .form-input, .form-select, .form-textarea {
            width: 100%;
            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            padding: 9px 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--navy);
            background: var(--white);
            outline: none;
            transition: border-color 0.2s;
        }

            .form-input:focus, .form-select:focus, .form-textarea:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(13,148,136,0.1);
            }

        .form-textarea {
            resize: vertical;
            min-height: 80px;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 24px;
        }

        .btn-cancel {
            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            font-weight: 500;
            padding: 9px 20px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--white);
            color: var(--muted);
            cursor: pointer;
            transition: all 0.15s;
        }

            .btn-cancel:hover {
                background: var(--offwhite);
            }

        .btn-submit {
            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            font-weight: 500;
            padding: 9px 22px;
            border-radius: 8px;
            border: none;
            background: var(--teal);
            color: white;
            cursor: pointer;
            transition: all 0.15s;
        }

            .btn-submit:hover {
                background: #0f7a70;
            }

        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 16px;
        }

        .alert-success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .alert-error {
            background: #fef2f2;
            color: var(--red);
            border: 1px solid #fecaca;
        }
    
        .dup-warn { margin-top:6px; font-size:12.5px; color:#b45309; background:#fffbeb; border:1px solid #fde68a; border-radius:8px; padding:6px 10px; }
        .existing-count { font-weight:400; color:var(--muted); font-size:12px; }
        .existing-list { max-height:170px; overflow:auto; border:1px solid var(--border, #e2e8f0); border-radius:10px; padding:8px; display:flex; flex-wrap:wrap; gap:6px; background:#f8fafc; }
        .existing-chip { font-size:12px; padding:3px 9px; border-radius:999px; background:#e0f2f1; color:#0f766e; }
        .existing-chip.gone { background:#f1f5f9; color:#94a3b8; text-decoration:line-through; }
        .existing-empty { font-size:12.5px; color:var(--muted); }
        a.nav-user { text-decoration: none; transition: background .15s; }
        a.nav-user:hover { background: rgba(255,255,255,0.14); }
    </style>
</head>
<body>

    <nav class="topnav">
        <a class="nav-brand" href="#">
            <div class="nav-logo">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" />
                    <circle cx="12" cy="17" r="4" opacity="0.6" />
                </svg>
            </div>
            <div class="nav-title">NMB-HLabSys <span>Haematology Lab System</span></div>
        </a>
        <div class="nav-right">
            <a class="nav-user" asp-controller="Admin" asp-action="Profile" title="My profile">
                <div class="nav-avatar">A</div>
                <div class="nav-user-info">
                    <div class="nav-user-name">@ViewData["AdminEmail"]</div>
                    <div class="nav-user-role">Admin</div>
                </div>
            </a>
            <a asp-controller="Home" asp-action="Logout" class="btn-signout">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </nav>

    <div class="app-body">
        <aside class="sidebar">
            <div class="sidebar-section">Main</div>
            <a class="nav-item" asp-controller="Admin" asp-action="Dashboard">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                Dashboard
            </a>
            <div class="sidebar-section">Manage Reference Data</div>
            <a class="nav-item" asp-controller="Admin" asp-action="ConditionCategories">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h7" /></svg>
                Condition categories
            </a>
            <a class="nav-item active" asp-controller="Admin" asp-action="MedicalConditions">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4" /><circle cx="12" cy="12" r="4" /></svg>
                Medical conditions
            </a>
            <a class="nav-item" asp-controller="Admin" asp-action="AllergyCategories">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h7" /></svg>
                Allergy categories
            </a>
            <a class="nav-item" asp-controller="Admin" asp-action="Allergies">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                Allergies
            </a>
            <a class="nav-item" asp-controller="Admin" asp-action="MedicationCategories">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h7" /></svg>
                Medication categories
            </a>
            <a class="nav-item" asp-controller="Admin" asp-action="Medications">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="2" width="18" height="20" rx="2" /><line x1="12" y1="18" x2="12.01" y2="18" /><path d="M8 6h8M8 10h6" /></svg>
                Medications
            </a>
            <div class="sidebar-section">System</div>
            <a class="nav-item" asp-controller="Admin" asp-action="ActivityLog">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                Activity log
            </a>
            <div class="sidebar-section">Account</div>
            <a class="nav-item" asp-controller="Admin" asp-action="Profile">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                My profile
            </a>
            <div class="sidebar-bottom">
                <a class="nav-item danger" asp-controller="Home" asp-action="Logout">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                    Sign out
                </a>
            </div>
        </aside>

        <main class="main">
            <div class="page-header">
                <div>
                    <div class="page-label">Reference Data</div>
                    <h1 class="page-title">Medical conditions</h1>
                    <p class="page-sub">Manage conditions and their categories.</p>
                </div>
                <button class="btn-primary" onclick="openModal('addModal')">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                    Add condition
                </button>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">@TempData["Error"]</div>
            }

            <div class="card">
                <div class="search-bar">
                    <input class="search-input" type="text" id="searchInput" placeholder="Search conditions..." onkeyup="filterTable()" />
                    <button type="button" class="btn-sm" id="searchBtn" onclick="filterTable()">Search</button>
                    <button type="button" class="btn-sm" id="clearBtn" onclick="clearSearch()">Clear</button>
                    <select class="filter-select" id="categoryFilter" onchange="filterTable()">
                        <option value="">All categories</option>
                        @foreach (var cat in (ViewData["Categories"] as List<admin.Models.ConditionCategory> ?? new()))
                        {
                            <option value="@cat.CategoryName">@cat.CategoryName</option>
                        }
                    </select>
                    <label style="margin-left:12px;display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);cursor:pointer;">
                        <input type="checkbox" id="showInactive" /> Show inactive
                    </label>
                </div>

                @{
                    var conditions = ViewData["Conditions"] as List<admin.Models.MedicalCondition>;
                }

                @if (conditions == null || !conditions.Any())
                {
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                        <p>No conditions found. Add one to get started.</p>
                    </div>
                }
                else
                {
                    <table id="conditionsTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Condition name</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var condition in conditions)
                            {
                                var inactive = condition.IsActive == false;
                                <tr class="@(inactive ? "inactive-row" : "")" data-active="@(inactive ? "0" : "1")">
                                    <td>@condition.ConditionID</td>
                                    <td>
                                        <strong style="@(inactive ? "text-decoration:line-through;opacity:0.6;" : "")">@condition.ConditionName</strong>
                                        @if (inactive)
                                        {
                                            <span class="pill pill-inactive">Inactive</span>
                                        }
                                    </td>
                                    <td><span class="pill pill-red">@((!string.IsNullOrWhiteSpace(condition.CategoryName) ? condition.CategoryName : "—"))</span></td>
                                    <td style="@(inactive ? "opacity:0.6;" : "")">@(condition.Description ?? "—")</td>
                                    <td>
                                        <div class="action-btns">
                                            @if (!inactive)
                                            {
                                                <button class="btn-sm" onclick="openEditModal(@condition.ConditionID, '@condition.ConditionName.Replace("'", "\\'")', '@(condition.Description?.Replace("'", "\\'") ?? "")', @condition.ConditionCategoryID)">Edit</button>
                                                <button class="btn-sm danger" onclick="openDeleteModal(@condition.ConditionID, '@condition.ConditionName.Replace("'", "\\'")')">Delete</button>
                                            }
                                            else
                                            {
                                                <form method="post" asp-controller="AdminRestore" asp-action="RestoreCondition" style="display:inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@condition.ConditionID" />
                                                    <button type="submit" class="btn-sm">Restore</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </main>
    </div>

    <!-- ADD MODAL -->
    <div class="modal-bg" id="addModal">
        <div class="modal">
            <div class="modal-title">Add condition</div>
            <form method="post" asp-controller="Admin" asp-action="CreateCondition">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="form-label">Condition name <span style="color:var(--red)">*</span></label>
                    <input class="form-input" name="ConditionName" id="addName" required placeholder="e.g. Hypertension" autocomplete="off" />
                    <div id="dupWarn" class="dup-warn" style="display:none"></div>
                </div>
                <div class="form-group">
                    <label class="form-label">Category <span style="color:var(--red)">*</span></label>
                    <select class="form-select" name="ConditionCategoryID" id="addCategory" required>
                        <option value="">Select a category...</option>
                        @foreach (var cat in (ViewData["Categories"] as List<admin.Models.ConditionCategory> ?? new()))
                        {
                            <option value="@cat.ConditionCategoryID">@cat.CategoryName</option>
                        }
                    </select>
                </div>
                <div class="form-group" id="existingBox" style="display:none">
                    <label class="form-label">Already under <strong id="existingCat"></strong> <span id="existingCount" class="existing-count"></span></label>
                    <div class="existing-list" id="existingList"></div>
                </div>
                <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea class="form-textarea" name="Description" placeholder="Optional description..."></textarea>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn-cancel" onclick="closeModal('addModal')">Cancel</button>
                    <button type="submit" class="btn-submit">Save condition</button>
                </div>
            </form>
        </div>
    </div>

    <!-- EDIT MODAL -->
    <div class="modal-bg" id="editModal">
        <div class="modal">
            <div class="modal-title">Edit condition</div>
            <form method="post" asp-controller="Admin" asp-action="EditCondition">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ConditionID" id="editId" />
                <div class="form-group">
                    <label class="form-label">Condition name <span style="color:var(--red)">*</span></label>
                    <input class="form-input" name="ConditionName" id="editName" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Category <span style="color:var(--red)">*</span></label>
                    <select class="form-select" name="ConditionCategoryID" id="editCategoryID" required>
                        @foreach (var cat in (ViewData["Categories"] as List<admin.Models.ConditionCategory> ?? new()))
                        {
                            <option value="@cat.ConditionCategoryID">@cat.CategoryName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea class="form-textarea" name="Description" id="editDesc"></textarea>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn-cancel" onclick="closeModal('editModal')">Cancel</button>
                    <button type="submit" class="btn-submit">Save changes</button>
                </div>
            </form>
        </div>
    </div>

    <!-- DELETE MODAL -->
    <div class="modal-bg" id="deleteModal">
        <div class="modal">
            <div class="modal-title">Delete condition</div>
            <p style="font-size:13.5px;color:var(--muted);margin-bottom:20px;">Are you sure you want to delete <strong id="deleteName"></strong>? It will be marked inactive and can be restored later.</p>
            <form method="post" asp-controller="Admin" asp-action="DeleteCondition">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteId" />
                <div class="modal-actions">
                    <button type="button" class="btn-cancel" onclick="closeModal('deleteModal')">Cancel</button>
                    <button type="submit" class="btn-submit" style="background:var(--red);">Delete</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openModal(id) { document.getElementById(id).classList.add('open'); }
        function closeModal(id) { document.getElementById(id).classList.remove('open'); }

        function openEditModal(id, name, desc, categoryId) {
            document.getElementById('editId').value = id;
            document.getElementById('editName').value = name;
            document.getElementById('editDesc').value = desc;
            document.getElementById('editCategoryID').value = categoryId;
            openModal('editModal');
        }

        function openDeleteModal(id, name) {
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteName').textContent = name;
            openModal('deleteModal');
        }

        // ---- existing conditions, by category (used by the Add modal) ----
        const allConditions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (ViewData["Conditions"] as List<admin.Models.MedicalCondition> ?? new())
                .Select(c => new { n = c.ConditionName, c = c.ConditionCategoryID, a = c.IsActive != false })));

        function showExisting() {
            const sel = document.getElementById('addCategory');
            const box = document.getElementById('existingBox');
            const list = document.getElementById('existingList');
            const typed = document.getElementById('addName').value.trim().toLowerCase();
            list.innerHTML = '';
            if (!sel.value) { box.style.display = 'none'; document.getElementById('dupWarn').style.display = 'none'; return; }
            const items = allConditions.filter(x => String(x.c) === sel.value)
                                       .sort((a, b) => a.n.localeCompare(b.n));
            document.getElementById('existingCat').textContent = sel.options[sel.selectedIndex].text;
            document.getElementById('existingCount').textContent = '(' + items.filter(x => x.a).length + ')';
            if (!items.length) {
                list.innerHTML = '<span class="existing-empty">No conditions in this category yet.</span>';
            }
            items.forEach(x => {
                if (typed && !x.n.toLowerCase().includes(typed)) return;
                const chip = document.createElement('span');
                chip.className = 'existing-chip' + (x.a ? '' : ' gone');
                chip.textContent = x.n;
                if (!x.a) chip.title = 'Inactive - restore it from the table instead';
                list.appendChild(chip);
            });
            box.style.display = '';
            // duplicate warning (any category)
            const warn = document.getElementById('dupWarn');
            const dup = typed && allConditions.find(x => x.n.toLowerCase() === typed);
            if (dup) {
                warn.textContent = dup.a ? 'A condition with this name already exists.'
                                         : 'This condition exists but is inactive - restore it from the table.';
                warn.style.display = '';
            } else warn.style.display = 'none';
        }
        document.getElementById('addCategory').addEventListener('change', showExisting);
        document.getElementById('addName').addEventListener('input', showExisting);

        function clearSearch() {
            document.getElementById('searchInput').value = '';
            document.getElementById('categoryFilter').value = '';
            filterTable();
        }
        document.getElementById('searchInput').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); filterTable(); } });

        // Search + category + "Show inactive" all handled here, in the browser.
        // The controller must send ALL rows (active + inactive) to this page.
        function filterTable() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const category = document.getElementById('categoryFilter').value.toLowerCase();
            const showInactive = document.getElementById('showInactive').checked;
            document.querySelectorAll('#conditionsTable tbody tr').forEach(row => {
                const text = row.textContent.toLowerCase();
                const isInactive = row.dataset.active === '0';
                const matches = text.includes(search) && (category === '' || text.includes(category));
                row.style.display = (matches && (showInactive || !isInactive)) ? '' : 'none';
            });
        }
        document.getElementById('showInactive').addEventListener('change', filterTable);
        filterTable(); // hides inactive rows on first load

        document.querySelectorAll('.modal-bg').forEach(bg => {
            bg.addEventListener('click', e => { if (e.target === bg) bg.classList.remove('open'); });
        });
        // arriving from the dashboard's "Add ..." buttons
        if (new URLSearchParams(window.location.search).get('add') === '1' && document.getElementById('addModal')) openModal('addModal');
    </script>

</body>
</html>
