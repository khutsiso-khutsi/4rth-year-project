@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --blue: #1a4f8a;
            --accent: #e8f0fe;
            --teal: #0d9488;
            --teal-light: #e8f5f3;
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --sidebar-width: 240px;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ── TOP NAV ── */
        .topnav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            background: var(--navy);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            height: 64px;
            box-shadow: 0 2px 20px rgba(0,0,0,0.25);
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .nav-logo {
            width: 36px;
            height: 36px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .nav-logo svg {
                width: 20px;
                height: 20px;
                fill: white;
            }

        .nav-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.05rem;
            color: white;
            line-height: 1.2;
        }

            .nav-title span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.62rem;
                font-weight: 300;
                color: rgba(255,255,255,0.45);
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .nav-user {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 8px;
            padding: 6px 14px 6px 8px;
        }

        .nav-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--teal);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            color: white;
        }

        .nav-user-info {
            line-height: 1.3;
        }

        .nav-user-name {
            font-size: 13px;
            font-weight: 500;
            color: white;
        }

        .nav-user-role {
            font-size: 11px;
            color: rgba(255,255,255,0.45);
        }

        .btn-signout {
            display: flex;
            align-items: center;
            gap: 7px;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.18);
            color: rgba(255,255,255,0.7);
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            padding: 7px 16px;
            border-radius: 7px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s;
        }

            .btn-signout:hover {
                background: rgba(255,255,255,0.08);
                color: white;
            }

            .btn-signout svg {
                width: 14px;
                height: 14px;
            }

        /* ── LAYOUT ── */
        .app-body {
            display: flex;
            padding-top: 64px;
            min-height: 100vh;
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--white);
            border-right: 1px solid var(--border);
            position: fixed;
            top: 64px;
            bottom: 0;
            left: 0;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            padding: 24px 0 20px;
        }

        .sidebar-section {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--muted);
            padding: 0 20px;
            margin: 20px 0 8px;
        }

            .sidebar-section:first-child {
                margin-top: 0;
            }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 20px;
            font-size: 13.5px;
            font-weight: 400;
            color: var(--muted);
            text-decoration: none;
            border-radius: 0;
            transition: all 0.15s;
            border-left: 3px solid transparent;
            cursor: pointer;
        }

            .nav-item:hover {
                background: var(--offwhite);
                color: var(--navy);
            }

            .nav-item.active {
                background: var(--teal-light);
                color: var(--teal);
                border-left-color: var(--teal);
                font-weight: 500;
            }

            .nav-item svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        .sidebar-bottom {
            margin-top: auto;
            border-top: 1px solid var(--border);
            padding-top: 16px;
        }

        .nav-item.danger {
            color: var(--red);
        }

            .nav-item.danger:hover {
                background: #fef2f2;
            }

        /* ── MAIN CONTENT ── */
        .main {
            margin-left: var(--sidebar-width);
            flex: 1;
            padding: 32px 36px;
            max-width: 100%;
        }

        /* ── PAGE HEADER ── */
        .page-header {
            margin-bottom: 28px;
        }

        .page-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--teal);
            margin-bottom: 6px;
        }

        .page-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.8rem;
            color: var(--navy);
            line-height: 1.2;
        }

        .page-sub {
            font-size: 13.5px;
            color: var(--muted);
            margin-top: 4px;
        }

        /* ── STATS GRID ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0,1fr));
            gap: 16px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 20px 22px;
            transition: box-shadow 0.2s;
        }

            .stat-card:hover {
                box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            }

        .stat-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .stat-icon-wrap {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .stat-icon-wrap svg {
                width: 18px;
                height: 18px;
            }

        .stat-badge {
            font-size: 11px;
            font-weight: 500;
            padding: 3px 10px;
            border-radius: 100px;
        }

        .stat-num {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            color: var(--navy);
            line-height: 1;
            margin-bottom: 4px;
        }

        .stat-lbl {
            font-size: 12.5px;
            color: var(--muted);
        }

        /* ── SECTION GRID ── */
        .section-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        .card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 22px 24px;
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
        }

        .card-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--navy);
        }

        .card-link {
            font-size: 12px;
            color: var(--teal);
            text-decoration: none;
            font-weight: 500;
        }

            .card-link:hover {
                text-decoration: underline;
            }

        /* ── LOOKUP TABLE ── */
        .lookup-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

            .lookup-table th {
                text-align: left;
                padding: 8px 12px;
                font-size: 11px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: var(--muted);
                border-bottom: 1px solid var(--border);
            }

            .lookup-table td {
                padding: 11px 12px;
                color: var(--navy);
                border-bottom: 1px solid var(--border);
                vertical-align: middle;
            }

            .lookup-table tr:last-child td {
                border-bottom: none;
            }

            .lookup-table tr:hover td {
                background: var(--offwhite);
            }

        .pill {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 100px;
            font-size: 11px;
            font-weight: 500;
        }

        .pill-green {
            background: #dcfce7;
            color: #166534;
        }

        .pill-blue {
            background: var(--accent);
            color: var(--blue);
        }

        .action-btns {
            display: flex;
            gap: 8px;
        }

        .btn-sm {
            font-family: 'DM Sans', sans-serif;
            font-size: 12px;
            font-weight: 500;
            padding: 5px 12px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--white);
            color: var(--navy);
            cursor: pointer;
            text-decoration: none;
            transition: all 0.15s;
        }

            .btn-sm:hover {
                background: var(--offwhite);
                border-color: #bbc5d8;
            }

            .btn-sm.teal {
                background: var(--teal);
                color: white;
                border-color: var(--teal);
            }

                .btn-sm.teal:hover {
                    background: #0f7a70;
                }

            .btn-sm.danger {
                color: var(--red);
                border-color: #fecaca;
            }

                .btn-sm.danger:hover {
                    background: #fef2f2;
                }

        /* ── QUICK ACTIONS ── */
        .quick-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0,1fr));
            gap: 12px;
        }

        .quick-card {
            background: var(--offwhite);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 18px 16px;
            text-align: center;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            transition: all 0.2s;
            display: block;
        }

            .quick-card:hover {
                border-color: var(--teal);
                background: var(--teal-light);
                transform: translateY(-2px);
            }

        .quick-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            margin: 0 auto 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .quick-icon svg {
                width: 18px;
                height: 18px;
            }

        .quick-label {
            font-size: 13px;
            font-weight: 500;
            color: var(--navy);
        }

        .quick-sub {
            font-size: 11px;
            color: var(--muted);
            margin-top: 3px;
        }

        /* ── ACTIVITY ── */
        .activity-list {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .activity-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 11px 0;
            border-bottom: 1px solid var(--border);
        }

            .activity-item:last-child {
                border-bottom: none;
            }

        .activity-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-top: 5px;
            flex-shrink: 0;
        }

        .activity-text {
            font-size: 13px;
            color: var(--navy);
            line-height: 1.5;
        }

        .activity-time {
            font-size: 11px;
            color: var(--muted);
            margin-top: 2px;
        }

        /* ── FULL WIDTH CARD ── */
        .full-card {
            margin-bottom: 24px;
        }

        /* ── ADD MODAL FORM ── */
        .modal-bg {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(11,31,58,0.45);
            z-index: 200;
            align-items: center;
            justify-content: center;
        }

            .modal-bg.open {
                display: flex;
            }

        .modal {
            background: var(--white);
            border-radius: 16px;
            padding: 32px;
            width: 100%;
            max-width: 480px;
            border: 1px solid var(--border);
        }

        .modal-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.3rem;
            color: var(--navy);
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-label {
            display: block;
            font-size: 12.5px;
            font-weight: 500;
            color: var(--navy);
            margin-bottom: 6px;
        }

        .form-input, .form-select, .form-textarea {
            width: 100%;
            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            padding: 9px 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--navy);
            background: var(--white);
            outline: none;
            transition: border-color 0.2s;
        }

            .form-input:focus, .form-select:focus, .form-textarea:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(13,148,136,0.1);
            }

        .form-textarea {
            resize: vertical;
            min-height: 80px;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 24px;
        }

        .btn-cancel {
            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            font-weight: 500;
            padding: 9px 20px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--white);
            color: var(--muted);
            cursor: pointer;
            transition: all 0.15s;
        }

            .btn-cancel:hover {
                background: var(--offwhite);
            }

        .btn-submit {
            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            font-weight: 500;
            padding: 9px 22px;
            border-radius: 8px;
            border: none;
            background: var(--teal);
            color: white;
            cursor: pointer;
            transition: all 0.15s;
        }

            .btn-submit:hover {
                background: #0f7a70;
            }
    </style>
</head>
<body>

    <!-- TOP NAV -->
    <nav class="topnav">
        <a class="nav-brand" href="#">
            <div class="nav-logo">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" />
                    <circle cx="12" cy="17" r="4" opacity="0.6" />
                </svg>
            </div>
            <div class="nav-title">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>
        </a>
        <div class="nav-right">
            <div class="nav-user">
                <div class="nav-avatar">A</div>
                <div class="nav-user-info">
                    <div class="nav-user-name">@ViewData["AdminEmail"] ?? "admin@nmb.ac.za"</div>
                    <div class="nav-user-role">Admin</div>
                </div>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="btn-signout">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </nav>

    <div class="app-body">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-section">Main</div>

            <a class="nav-item active" asp-controller="Admin" asp-action="Dashboard">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>
                Dashboard
            </a>

            <div class="sidebar-section">Manage Reference Data</div>

            <a class="nav-item" asp-controller="Admin" asp-action="ConditionCategories">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M4 6h16M4 12h16M4 18h7" />
                </svg>
                Condition categories
            </a>

            <a class="nav-item" asp-controller="Admin" asp-action="MedicalConditions">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4" />
                    <circle cx="12" cy="12" r="4" />
                </svg>
                Medical conditions
            </a>

            <a class="nav-item" asp-controller="Admin" asp-action="AllergyCategories">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M4 6h16M4 12h16M4 18h7" />
                </svg>
                Allergy categories
            </a>

            <a class="nav-item" asp-controller="Admin" asp-action="Allergies">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                Allergies
            </a>

            <a class="nav-item" asp-controller="Admin" asp-action="MedicationCategories">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M4 6h16M4 12h16M4 18h7" />
                </svg>
                Medication categories
            </a>

            <a class="nav-item" asp-controller="Admin" asp-action="Medications">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="3" y="2" width="18" height="20" rx="2" />
                    <line x1="12" y1="18" x2="12.01" y2="18" />
                    <path d="M8 6h8M8 10h6" />
                </svg>
                Medications
            </a>

            <div class="sidebar-section">System</div>

            <a class="nav-item" asp-controller="Admin" asp-action="ActivityLog">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
                Activity log
            </a>

            <div class="sidebar-bottom">
                <a class="nav-item danger" asp-controller="Home" asp-action="Logout">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <polyline points="16 17 21 12 16 7" />
                        <line x1="21" y1="12" x2="9" y2="12" />
                    </svg>
                    Sign out
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="main">

            <!-- Page Header -->
            <div class="page-header">
                <div class="page-label">Admin Portal</div>
                <h1 class="page-title">Dashboard</h1>
                <p class="page-sub">Manage medical conditions, allergies and medications across the system.</p>
            </div>

            <!-- Stats -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-card-top">
                        <div class="stat-icon-wrap" style="background:#e8f5f3;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2" stroke-linecap="round">
                                <circle cx="12" cy="12" r="10" />
                                <path d="M12 8v4M12 16h.01" />
                            </svg>
                        </div>
                        <span class="stat-badge" style="background:#e8f5f3;color:#0d9488;">@ViewData["ConditionCount"] entries</span>
                    </div>
                    <div class="stat-num">@(ViewData["ConditionCount"] ?? 7)</div>
                    <div class="stat-lbl">Medical conditions</div>
                </div>

                <div class="stat-card">
                    <div class="stat-card-top">
                        <div class="stat-icon-wrap" style="background:#fef2f2;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="12" y1="8" x2="12" y2="12" />
                                <line x1="12" y1="16" x2="12.01" y2="16" />
                            </svg>
                        </div>
                        <span class="stat-badge" style="background:#fef2f2;color:#dc2626;">@ViewData["AllergyCount"] entries</span>
                    </div>
                    <div class="stat-num">@(ViewData["AllergyCount"] ?? 7)</div>
                    <div class="stat-lbl">Allergies</div>
                </div>

                <div class="stat-card">
                    <div class="stat-card-top">
                        <div class="stat-icon-wrap" style="background:#e8eef8;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#1a4f8a" stroke-width="2" stroke-linecap="round">
                                <rect x="3" y="2" width="18" height="20" rx="2" />
                                <path d="M8 6h8M8 10h6" />
                            </svg>
                        </div>
                        <span class="stat-badge" style="background:#e8eef8;color:#1a4f8a;">@ViewData["MedicationCount"] entries</span>
                    </div>
                    <div class="stat-num">@(ViewData["MedicationCount"] ?? 7)</div>
                    <div class="stat-lbl">Medications</div>
                </div>

                <div class="stat-card">
                    <div class="stat-card-top">
                        <div class="stat-icon-wrap" style="background:#f0ebff;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round">
                                <path d="M4 6h16M4 12h16M4 18h7" />
                            </svg>
                        </div>
                        <span class="stat-badge" style="background:#f0ebff;color:#7c3aed;">Total</span>
                    </div>
                    <div class="stat-num">@(ViewData["CategoryCount"] ?? 0)</div>
                    <div class="stat-lbl">Categories managed</div>
                </div>
            </div>

            <!-- Quick Actions + Activity -->
            <div class="section-grid">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Quick actions</div>
                    </div>
                    <div class="quick-grid">
                        <a class="quick-card" asp-controller="Admin" asp-action="CreateCondition">
                            <div class="quick-icon" style="background:#e8f5f3;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2" stroke-linecap="round">
                                    <circle cx="12" cy="12" r="10" />
                                    <path d="M12 8v8M8 12h8" />
                                </svg>
                            </div>
                            <div class="quick-label">Add condition</div>
                            <div class="quick-sub">New medical condition</div>
                        </a>
                        <a class="quick-card" asp-controller="Admin" asp-action="CreateAllergy">
                            <div class="quick-icon" style="background:#fef2f2;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round">
                                    <circle cx="12" cy="12" r="10" />
                                    <path d="M12 8v8M8 12h8" />
                                </svg>
                            </div>
                            <div class="quick-label">Add allergy</div>
                            <div class="quick-sub">New allergy entry</div>
                        </a>
                        <a class="quick-card" asp-controller="Admin" asp-action="CreateMedication">
                            <div class="quick-icon" style="background:#e8eef8;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#1a4f8a" stroke-width="2" stroke-linecap="round">
                                    <rect x="3" y="2" width="18" height="20" rx="2" />
                                    <path d="M12 8v8M8 12h8" />
                                </svg>
                            </div>
                            <div class="quick-label">Add medication</div>
                            <div class="quick-sub">New medication</div>
                        </a>
                        <a class="quick-card" asp-controller="Admin" asp-action="ConditionCategories">
                            <div class="quick-icon" style="background:#e8f5f3;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2" stroke-linecap="round">
                                    <path d="M4 6h16M4 12h16M4 18h7" />
                                </svg>
                            </div>
                            <div class="quick-label">Condition categories</div>
                            <div class="quick-sub">View &amp; manage</div>
                        </a>
                        <a class="quick-card" asp-controller="Admin" asp-action="AllergyCategories">
                            <div class="quick-icon" style="background:#fef2f2;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round">
                                    <path d="M4 6h16M4 12h16M4 18h7" />
                                </svg>
                            </div>
                            <div class="quick-label">Allergy categories</div>
                            <div class="quick-sub">View &amp; manage</div>
                        </a>
                        <a class="quick-card" asp-controller="Admin" asp-action="MedicationCategories">
                            <div class="quick-icon" style="background:#e8eef8;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#1a4f8a" stroke-width="2" stroke-linecap="round">
                                    <path d="M4 6h16M4 12h16M4 18h7" />
                                </svg>
                            </div>
                            <div class="quick-label">Medication categories</div>
                            <div class="quick-sub">View &amp; manage</div>
                        </a>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Recent activity</div>
                        <a class="card-link" asp-controller="Admin" asp-action="ActivityLog">View all</a>
                    </div>
                    <div class="activity-list">
                        @if (ViewData["RecentActivity"] != null)
                        {
                            <!-- Bind from ViewData["RecentActivity"] in controller -->
                        }
                        else
                        {
                            <div class="activity-item">
                                <div class="activity-dot" style="background:#0d9488;"></div>
                                <div>
                                    <div class="activity-text">Medical condition added: Polycythaemia</div>
                                    <div class="activity-time">Today, 09:14</div>
                                </div>
                            </div>
                            <div class="activity-item">
                                <div class="activity-dot" style="background:#1a4f8a;"></div>
                                <div>
                                    <div class="activity-text">Medication updated: Warfarin</div>
                                    <div class="activity-time">Today, 08:47</div>
                                </div>
                            </div>
                            <div class="activity-item">
                                <div class="activity-dot" style="background:#0d9488;"></div>
                                <div>
                                    <div class="activity-text">Allergy added: Latex</div>
                                    <div class="activity-time">Yesterday, 15:32</div>
                                </div>
                            </div>
                            <div class="activity-item">
                                <div class="activity-dot" style="background:#dc2626;"></div>
                                <div>
                                    <div class="activity-text">Condition category deleted: Obsolete</div>
                                    <div class="activity-time">Yesterday, 11:05</div>
                                </div>
                            </div>
                            <div class="activity-item">
                                <div class="activity-dot" style="background:#1a4f8a;"></div>
                                <div>
                                    <div class="activity-text">Medication category updated: Anticoagulants</div>
                                    <div class="activity-time">Apr 6, 14:20</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Lookup Data Summary -->
            <div class="card full-card">
                <div class="card-header">
                    <div class="card-title">Reference data summary</div>
                </div>
                <table class="lookup-table">
                    <thead>
                        <tr>
                            <th>Data type</th>
                            <th>Categories</th>
                            <th>Total items</th>
                            <th>Last updated</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Medical conditions</strong></td>
                            <span class="pill pill-blue">@(ViewData["ConditionCatCount"] ?? 0) categories</span>
                            <td>@(ViewData["ConditionCount"] ?? 7)</td>
                            <td>Today</td>
                            <td>
                                <div class="action-btns">
                                    <a class="btn-sm teal" asp-controller="Admin" asp-action="MedicalConditions">View all</a>
                                    <a class="btn-sm" asp-controller="Admin" asp-action="CreateCondition">+ Add</a>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Allergies</strong></td>
                            <span class="pill pill-blue">@(ViewData["AllergyCatCount"] ?? 0) categories</span>
                            <td>@(ViewData["AllergyCount"] ?? 7)</td>
                            <td>Today</td>
                            <td>
                                <div class="action-btns">
                                    <a class="btn-sm teal" asp-controller="Admin" asp-action="Allergies">View all</a>
                                    <a class="btn-sm" asp-controller="Admin" asp-action="CreateAllergy">+ Add</a>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Medications</strong></td>
                            <span class="pill pill-blue">@(ViewData["MedCatCount"] ?? 0) categories</span>

                            <td>@(ViewData["MedicationCount"] ?? 7)</td>
                            <td>Apr 6, 2026</td>
                            <td>
                                <div class="action-btns">
                                    <a class="btn-sm teal" asp-controller="Admin" asp-action="Medications">View all</a>
                                    <a class="btn-sm" asp-controller="Admin" asp-action="CreateMedication">+ Add</a>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </main>
    </div>

</body>
</html>
