@using LabManager.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@model StaffViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    ViewData["Title"] = "User Management";

    // Number of rows shown per page in each table (doctors and technicians)
    const int RowsPerPage = 5;

    // Test types for the technician checklist (controller sets ViewBag.TestType as a list of SelectListItem)
    var testTypeOptions = (ViewBag.TestType as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>()).ToList();
    var testNameById = testTypeOptions
        .GroupBy(o => o.Value)
        .ToDictionary(g => g.Key, g => g.First().Text);

    // TechnicianId -> list of assigned TestTypeIds (controller sets ViewBag.TechnicianTestTypes)
    var techTestMap = ViewBag.TechnicianTestTypes as IDictionary<int, List<int>>
                      ?? new Dictionary<int, List<int>>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Management — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        [hidden] { display: none !important; }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --teal: #0d9488;
            --teal-dark: #0b7c72;
            --teal-light: rgba(13,148,136,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --red-dark: #b91c1c;
            --red-light: rgba(220,38,38,0.1);
            --green: #16a34a;
            --green-light: rgba(22,163,74,0.1);
            --amber: #d97706;
            --amber-light: rgba(217,119,6,0.1);
            --purple: #4f46e5;
            --purple-light: rgba(79,70,229,0.1);
            --radius: 16px;
            --shadow: 0 2px 8px rgba(11,31,58,.04);
            --shadow-lg: 0 20px 60px rgba(11,31,58,.20);
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
            line-height: 1.5;
        }

        button, input, select { font-family: inherit; }

        /* ── TOPBAR ── */
        .topbar {
            background: var(--navy);
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }

        .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }

        .brand-logo {
            width: 34px; height: 34px;
            background: var(--teal);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
        }

        .brand-logo svg { width: 18px; height: 18px; fill: white; }

        .brand-name {
            font-family: 'DM Serif Display', serif;
            color: white;
            font-size: 1.1rem;
            line-height: 1.1;
        }

        .brand-name span {
            display: block;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.6rem;
            font-weight: 300;
            color: rgba(255,255,255,0.4);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .topbar-right { display: flex; align-items: center; gap: 16px; }

        .user-chip {
            display: flex; align-items: center; gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 6px 14px 6px 8px;
        }

        .user-avatar {
            width: 28px; height: 28px;
            background: var(--teal);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.75rem; font-weight: 600; color: white;
        }

        .user-email {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.75);
            max-width: 160px;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }

        .logout-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.8);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.82rem; font-weight: 500;
            display: flex; align-items: center; gap: 6px;
            transition: all 0.2s;
            cursor: pointer;
        }

        .logout-btn:hover { background: rgba(255,255,255,0.15); color: white; }
        .logout-btn svg { width: 14px; height: 14px; }

        /* ── LAYOUT ── */
        .page { display: flex; min-height: calc(100vh - 64px); }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 220px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 24px 0;
            flex-shrink: 0;
            position: sticky;
            top: 64px;
            height: calc(100vh - 64px);
            overflow-y: auto;
        }

        .nav-section { margin-bottom: 8px; }

        .nav-label {
            font-size: 0.65rem; font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em; text-transform: uppercase;
            padding: 0 20px; margin-bottom: 4px;
        }

        .nav-item {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 20px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem; font-weight: 500;
            transition: all 0.15s;
            border-left: 3px solid transparent;
        }

        .nav-item:hover { background: var(--offwhite); color: var(--navy); }

        .nav-item.active {
            background: var(--teal-light);
            color: var(--teal);
            border-left-color: var(--teal);
            font-weight: 600;
        }

        .nav-item svg { width: 16px; height: 16px; flex-shrink: 0; }
        .nav-item:focus-visible { outline: 2px solid var(--teal); outline-offset: -2px; }

        /* ── MAIN ── */
        .main { flex: 1; padding: clamp(24px, 3vw, 40px); overflow-y: auto; min-width: 0; }

        .page-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 24px; flex-wrap: wrap; gap: 16px;
        }

        .page-header h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.8rem; font-weight: 400; color: var(--navy);
        }

        .page-header p { color: var(--muted); margin: 6px 0 0; font-size: 0.85rem; font-weight: 300; }

        /* ── BUTTONS ── */
        .btn {
            border: none;
            border-radius: 10px;
            padding: 9px 15px;
            cursor: pointer;
            font-family: inherit; font-weight: 600; font-size: 0.82rem;
            transition: all .18s ease;
        }

        .btn:hover { transform: translateY(-1px); }

        .btn-primary { background: var(--teal); color: white; box-shadow: 0 2px 8px rgba(13,148,136,0.25); }
        .btn-primary:hover { background: var(--teal-dark); }

        .btn-secondary { background: var(--offwhite); color: var(--navy); border: 1px solid var(--border); }
        .btn-secondary:hover { border-color: var(--teal); color: var(--teal); }

        .btn-danger { background: var(--red-light); color: var(--red); }
        .btn-danger:hover { background: rgba(220,38,38,0.2); }

        .btn-sm { padding: 6px 11px; font-size: 0.75rem; border-radius: 8px; white-space: nowrap; }

        .btn-edit {
            background: var(--purple-light);
            color: var(--purple);
            border: none;
        }

        .btn-edit:hover { background: rgba(79,70,229,0.2); }

        /* ── CARDS ── */
        .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start; }

        .card {
            background: white;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            min-width: 0;
        }

        .card-scroll { overflow-x: auto; }

        .card-header {
            display: flex; justify-content: space-between; align-items: center;
            padding: 17px 22px;
            border-bottom: 1px solid var(--border);
            gap: 10px;
        }

        .card-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.05rem; font-weight: 400; color: var(--navy);
        }

        .count {
            background: var(--teal-light);
            color: var(--teal);
            padding: 4px 10px;
            border-radius: 100px;
            font-size: 0.72rem; font-weight: 700;
            margin-left: 8px;
        }

        /* ── TABLE ── */
        table { width: 100%; border-collapse: collapse; }

        th {
            text-align: left;
            padding: 12px 16px;
            background: var(--offwhite);
            color: var(--muted);
            font-size: 0.7rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: .06em;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        td {
            padding: 14px 16px;
            border-top: 1px solid var(--offwhite);
            font-size: 0.82rem;
            color: var(--navy);
            vertical-align: middle;
        }

        .row-clickable { cursor: pointer; }
        .row-clickable:hover { background: var(--offwhite); }

        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 100px;
            font-size: 0.68rem; font-weight: 700;
        }

        .active { background: var(--green-light); color: var(--green); }
        .inactive { background: var(--red-light); color: var(--red); }

        .id-tag {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.75rem;
            color: var(--navy);
            background: var(--offwhite);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 2px 7px;
            white-space: nowrap;
        }

        .badge-wrap { display: flex; flex-wrap: wrap; gap: 4px; }

        .test-badge {
            display: inline-block;
            background: var(--teal-light);
            color: var(--teal);
            padding: 4px 9px;
            border-radius: 6px;
            font-size: 0.68rem; font-weight: 600;
        }

        .test-badge.more { background: var(--purple-light); color: var(--purple); }

        .muted { color: #94a3b8; }

        .empty { text-align: center; padding: 35px; color: var(--muted); font-size: 0.82rem; }

        /* ── PAGINATION (5 rows per table) ── */
        .pagination-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            padding: 12px 18px;
            border-top: 1px solid var(--border);
            background: white;
        }

        .page-info { font-size: 0.74rem; color: var(--muted); }
        .page-info strong { color: var(--navy); }

        .pager { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; }

        .pg-btn {
            min-width: 30px;
            height: 30px;
            padding: 0 9px;
            border: 1px solid var(--border);
            background: var(--white);
            color: var(--navy);
            border-radius: 8px;
            font-size: 0.76rem;
            font-weight: 600;
            cursor: pointer;
            transition: all .15s ease;
        }

        .pg-btn:hover:not(:disabled):not(.current) {
            border-color: var(--teal);
            color: var(--teal);
            background: var(--teal-light);
        }

        .pg-btn.current {
            background: var(--teal);
            border-color: var(--teal);
            color: var(--white);
            cursor: default;
        }

        .pg-btn:disabled { opacity: .45; cursor: not-allowed; }

        .pg-gap { color: var(--muted); padding: 0 2px; font-size: .8rem; }

        /* ── ALERTS ── */
        .alert {
            padding: 13px 16px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 0.82rem; font-weight: 600;
        }

        .alert-success { background: var(--green-light); color: var(--green); border: 1px solid rgba(22,163,74,0.25); }
        .alert-error { background: var(--red-light); color: var(--red); border: 1px solid rgba(220,38,38,0.25); }

        /* ── MODAL ── */
        .modal {
            display: none;
            position: fixed; inset: 0;
            background: rgba(11,31,58,.45);
            backdrop-filter: blur(3px);
            align-items: center; justify-content: center;
            z-index: 2000;
            padding: 20px;
        }

        .modal.show { display: flex; }

        .modal-box {
            width: 100%;
            max-width: 550px;
            background: white;
            border-radius: var(--radius);
            box-shadow: var(--shadow-lg);
            max-height: 90vh;
            overflow-y: auto;
            animation: modalIn .18s ease;
        }

        @@keyframes modalIn {
            from { opacity: 0; transform: translateY(8px) scale(.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .modal-header {
            padding: 19px 22px;
            border-bottom: 1px solid var(--border);
            display: flex; justify-content: space-between; align-items: center;
        }

        .modal-header h2 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem; font-weight: 400; color: var(--navy);
        }

        .close {
            width: 32px; height: 32px;
            border: none;
            background: var(--offwhite);
            color: var(--muted);
            border-radius: 8px;
            cursor: pointer;
            font-size: 18px;
            transition: background .18s ease, color .18s ease;
        }

        .close:hover { background: var(--border); color: var(--navy); }

        .modal-body { padding: 22px; }

        .form-group { margin-bottom: 17px; }

        .form-group > label {
            display: block;
            margin-bottom: 7px;
            font-size: 0.75rem; font-weight: 700; color: var(--navy);
        }

        .req { color: var(--red); margin-left: 2px; }

        .form-control {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
            outline: none;
            font-family: inherit; font-size: 0.85rem;
            background: white; color: var(--navy);
        }

        .form-control:focus { border-color: var(--teal); box-shadow: 0 0 0 3px var(--teal-light); }

        .form-control[readonly] {
            background: var(--offwhite);
            color: var(--muted);
            cursor: not-allowed;
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        }

        .hint { display: block; margin-top: 5px; font-size: 0.7rem; color: var(--muted); }

        .field-error { display: none; margin-top: 5px; font-size: 0.72rem; font-weight: 600; color: var(--red); }
        .field-error.show { display: block; }

        /* multi-select checklist */
        .check-list {
            border: 1px solid var(--border);
            border-radius: 8px;
            max-height: 190px;
            overflow-y: auto;
            padding: 6px;
            background: white;
        }

        .check-list.is-invalid { border-color: var(--red); box-shadow: 0 0 0 3px var(--red-light); }

        .form-group label.check-item {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
            padding: 8px 10px;
            border-radius: 6px;
            font-size: 0.82rem;
            font-weight: 500;
            cursor: pointer;
        }

        .check-item:hover { background: var(--offwhite); }
        .check-item input { width: 16px; height: 16px; accent-color: var(--teal); flex-shrink: 0; }

        .modal-footer {
            padding: 16px 22px;
            border-top: 1px solid var(--border);
            display: flex; justify-content: flex-end; gap: 10px;
            background: var(--offwhite);
        }

        .detail-row {
            display: flex; justify-content: space-between; gap: 20px;
            padding: 12px 0;
            border-bottom: 1px solid var(--offwhite);
        }

        .detail-label { color: var(--muted); font-size: 0.8rem; flex-shrink: 0; }
        .detail-value { font-weight: 700; color: var(--navy); text-align: right; }
        .detail-value.chips { display: flex; flex-wrap: wrap; gap: 5px; justify-content: flex-end; }

        /* ── RESPONSIVE ── */
        @@media (max-width: 1000px) { .cards { grid-template-columns: 1fr; } }

        @@media (max-width: 768px) {
            .topbar { padding: 0 20px; }
            .user-email { display: none; }
            .sidebar { display: none; }
            .main { padding: 20px 16px; }
            .page-header { flex-direction: column; align-items: flex-start; }
            .pagination-bar { justify-content: center; }
        }
    </style>
</head>
<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "M")</div>
                <span class="user-email">@(ViewBag.Email ?? "Laboratory Manager")</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn" id="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="nav-section">
                <div class="nav-label">Main</div>

                <a asp-controller="ManagerDashboard" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                    </svg>
                    Dashboard
                </a>

                <a asp-controller="TestCatalogue" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M9 3v11a3 3 0 006 0V3" />
                        <line x1="6" y1="3" x2="18" y2="3" />
                    </svg>
                    Test Catalogue
                </a>

                <a asp-controller="Consumables" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                    </svg>
                    Consumables
                </a>

                <a asp-controller="Staff" asp-action="Index" class="nav-item active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Staff
                </a>

                <a asp-controller="ConsumableOrder" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                    </svg>
                    Orders
                </a>

                <a asp-controller="TestsByCategory" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                    Reports
                </a>
            </div>

            <div class="nav-section">
                <div class="nav-label">System</div>

                <a asp-controller="User" asp-action="Profile" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Profile
                </a>

                
            </div>
        </aside>

        <!-- MAIN -->
        <main class="main">

            <div class="page-header">
                <div>
                    <h1>User Management</h1>
                    <p>Manage doctors and laboratory technicians.</p>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">✓ @TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">⚠ @TempData["Error"]</div>
            }

            <div class="cards">

                <!-- ═════════ DOCTORS ═════════ -->
                <section class="card">

                    <div class="card-header">
                        <div>
                            <span class="card-title">Doctors</span>
                            <span class="count">@Model.Doctors.Count()</span>
                        </div>

                        <button type="button" class="btn btn-primary" onclick="openAddDoctor()">
                            + Add Doctor
                        </button>
                    </div>

                    @if (Model.Doctors.Any())
                    {
                        <div class="card-scroll">
                            <table id="doctor-table" data-per-page="@RowsPerPage">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>HPCSA</th>
                                        <th>Email</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in Model.Doctors)
                                    {
                                        <tr class="row-clickable data-row"
                                            data-id="@d.Id"
                                            data-fullname="@d.FullName"
                                            data-firstname="@d.FirstName"
                                            data-lastname="@d.LastName"
                                            data-email="@d.EmailAddress"
                                            data-hpcsa="@d.HCPSANumber"
                                            data-contact="@d.ContactNumber"
                                            data-active="@d.IsActive.ToString().ToLower()"
                                            onclick="openDoctorView(this)">

                                            <td><strong>@d.FullName</strong></td>
                                            <td><span class="id-tag">@d.HCPSANumber</span></td>
                                            <td>@d.EmailAddress</td>
                                            <td>
                                                @if (d.IsActive)
                                                {
                                                    <span class="status-badge active">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge inactive">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-edit"
                                                        onclick="event.stopPropagation(); openEditDoctor(this.closest('tr'))">
                                                    ✎ Edit
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="pagination-bar" id="doctor-pagination" hidden>
                            <div class="page-info" id="doctor-info"></div>
                            <div class="pager" id="doctor-pager"></div>
                        </div>
                    }
                    else
                    {
                        <div class="empty">No doctors found.</div>
                    }

                </section>

                <!-- ═════════ TECHNICIANS ═════════ -->
                <section class="card">

                    <div class="card-header">
                        <div>
                            <span class="card-title">Laboratory Technicians</span>
                            <span class="count">@Model.Technicians.Count()</span>
                        </div>

                        <button type="button" class="btn btn-primary" onclick="openAddTechnician()">
                            + Add Technician
                        </button>
                    </div>

                    @if (Model.Technicians.Any())
                    {
                        <div class="card-scroll">
                            <table id="technician-table" data-per-page="@RowsPerPage">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Employee No.</th>
                                        <th>Test Types</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.Technicians)
                                    {
                                        // Assigned test type ids: join table first, legacy single TestTypeID as fallback
                                        var assignedIds = new List<int>();
                                        if (techTestMap.TryGetValue(t.Id, out var mappedIds) && mappedIds != null)
                                        {
                                            assignedIds.AddRange(mappedIds);
                                        }
                                        if (assignedIds.Count == 0
                                            && int.TryParse(t.TestTypeID.ToString(), out var legacyId) && legacyId > 0)
                                        {
                                            assignedIds.Add(legacyId);
                                        }

                                        var assignedNames = assignedIds
                                            .Distinct()
                                            .Select(i => testNameById.TryGetValue(i.ToString(), out var nm) ? nm : null)
                                            .Where(s => !string.IsNullOrWhiteSpace(s))
                                            .ToList();

                                        <tr class="row-clickable data-row"
                                            data-id="@t.Id"
                                            data-fullname="@t.FullName"
                                            data-firstname="@t.FirstName"
                                            data-lastname="@t.LastName"
                                            data-email="@t.EmailAddress"
                                            data-employee="@t.EmployeeNumber"
                                            data-testtypeids="@(string.Join(",", assignedIds.Distinct()))"
                                            data-testnames="@(string.Join("|", assignedNames))"
                                            data-active="@t.IsActive.ToString().ToLower()"
                                            onclick="openTechnicianView(this)">

                                            <td><strong>@t.FullName</strong></td>
                                            <td><span class="id-tag">@t.EmployeeNumber</span></td>
                                            <td>
                                                @if (assignedNames.Count == 0)
                                                {
                                                    <span class="muted">—</span>
                                                }
                                                else
                                                {
                                                    <div class="badge-wrap">
                                                        @foreach (var shown in assignedNames.Take(2))
                                                        {
                                                            <span class="test-badge">@shown</span>
                                                        }
                                                        @if (assignedNames.Count > 2)
                                                        {
                                                            <span class="test-badge more" title="@(string.Join(", ", assignedNames.Skip(2)))">+@(assignedNames.Count - 2) more</span>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                @if (t.IsActive)
                                                {
                                                    <span class="status-badge active">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge inactive">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-edit"
                                                        onclick="event.stopPropagation(); openEditTechnician(this.closest('tr'))">
                                                    ✎ Edit
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="pagination-bar" id="technician-pagination" hidden>
                            <div class="page-info" id="technician-info"></div>
                            <div class="pager" id="technician-pager"></div>
                        </div>
                    }
                    else
                    {
                        <div class="empty">No laboratory technicians found.</div>
                    }

                </section>

            </div>

        </main>
    </div>

    <!-- ============================================================
         DOCTOR VIEW MODAL
         ============================================================ -->
    <div id="doctorViewModal" class="modal">
        <div class="modal-box">
            <div class="modal-header">
                <h2>Doctor Details</h2>
                <button type="button" class="close" onclick="closeModal('doctorViewModal')">&times;</button>
            </div>

            <div class="modal-body">
                <div class="detail-row"><span class="detail-label">Name</span><span id="viewDoctorName" class="detail-value"></span></div>
                <div class="detail-row"><span class="detail-label">HPCSA Number</span><span id="viewDoctorHpcsa" class="detail-value"></span></div>
                <div class="detail-row"><span class="detail-label">Email</span><span id="viewDoctorEmail" class="detail-value"></span></div>
                <div class="detail-row"><span class="detail-label">Contact</span><span id="viewDoctorContact" class="detail-value"></span></div>
                <div class="detail-row"><span class="detail-label">Status</span><span id="viewDoctorStatus" class="detail-value"></span></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('doctorViewModal')">Close</button>
                <button type="button" class="btn btn-primary" onclick="editCurrentDoctor()">✎ Edit</button>
            </div>
        </div>
    </div>

    <!-- ============================================================
         ADD / EDIT DOCTOR
         ============================================================ -->
    <div id="doctorModal" class="modal">
        <div class="modal-box">
            <div class="modal-header">
                <h2 id="doctorModalTitle">Add Doctor</h2>
                <button type="button" class="close" onclick="closeModal('doctorModal')">&times;</button>
            </div>

            <form id="doctorForm" method="post"
                  action="@Url.Action("AddDoctor", "Staff")"
                  data-add-url="@Url.Action("AddDoctor", "Staff")"
                  data-edit-url="@Url.Action("EditDoctor", "Staff")">
                @Html.AntiForgeryToken()

                <input type="hidden" id="doctorId" name="id" value="0" />

                <div class="modal-body">

                    <div class="form-group">
                        <label for="doctorFirstName">First Name<span class="req">*</span></label>
                        <input type="text" id="doctorFirstName" name="firstName" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label for="doctorLastName">Last Name<span class="req">*</span></label>
                        <input type="text" id="doctorLastName" name="lastName" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label for="doctorHpcsa">HPCSA Number</label>
