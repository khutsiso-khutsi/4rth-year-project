                               required />

                        <label for="technicianFirstName">First Name<span class="req">*</span></label>
                        <input type="text" id="technicianFirstName" name="firstName" class="form-control" required />
                    </div>


                    <div class="form-group">

                        <label>
                            Last Name
                        </label>

                        <input type="text"
                               id="technicianLastName"
                               name="lastName"
                               class="form-control"
                               required />

                        <label for="technicianLastName">Last Name<span class="req">*</span></label>
                        <input type="text" id="technicianLastName" name="lastName" class="form-control" required />
                    </div>


                    <div class="form-group">

                        <label>
                            Employee Number
                        </label>

                        <input type="text"
                               id="technicianEmployeeNumber"
                               name="employeeNumber"
                               class="form-control"
                               required />

                        <label for="technicianEmployeeNumber">Employee Number</label>
                        <!-- display only: no name attribute, so it is never posted -->
                        <input type="text" id="technicianEmployeeNumber" class="form-control" readonly tabindex="-1"
                               placeholder="Generated automatically on save" />
                        <span class="hint">Assigned by the system and cannot be edited.</span>
                    </div>


                    <div class="form-group">

                        <label>
                            Email Address
                        </label>

                        <input type="email"
                               id="technicianEmail"
                               name="email"
                               class="form-control"
                               required />

                        <label for="technicianEmail">Email Address<span class="req">*</span></label>
                        <input type="email" id="technicianEmail" name="email" class="form-control" required />
                    </div>


                    <!-- =================================================
                         TEST TYPE FOREIGN KEY DROPDOWN
                         ================================================= -->

                    <div class="form-group">

                        <label for="technicianTestType">

                            Test Type

                        <label>Test Types<span class="req">*</span></label>
                        <div class="check-list" id="technicianTestTypes">
                            @foreach (var opt in testTypeOptions)
                            {
                                <label class="check-item">
                                    <input type="checkbox" name="testTypeIDs" value="@opt.Value" />
                                    <span>@opt.Text</span>
                        </label>

                        <select id="technicianTestType"
                                name="testTypeID"
                                class="form-control"
                                required>

                            <option value="">
                                -- Select Test Type --
                            </option>

                            @foreach (var testType in Model.TestTypes)
                            }
                            @if (!testTypeOptions.Any())
                            {
                                <option value="@testType.TestId">
                                    @testType.TestName
                                </option>
                                <div class="empty" style="padding:14px;">No test types available. Add them in the Test Catalogue first.</div>
                            }

                        </select>

                        </div>
                        <span class="hint" id="technicianTestTypeCount">Select one or more test types.</span>
                        <span class="field-error" id="technicianTestTypeError">Select at least one test type.</span>
                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="closeModal('technicianModal')">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        Save Technician

                    </button>

                    <button type="button" class="btn btn-secondary" onclick="closeModal('technicianModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Technician</button>
                </div>

            </form>
        </div>
    </div>

    <!-- LOGOUT CONFIRMATION MODAL -->
    <div id="logout-modal" role="dialog" aria-modal="true" aria-labelledby="logout-modal-title"
         style="display:none;position:fixed;inset:0;z-index:2100;background:rgba(11,31,58,0.45);align-items:center;justify-content:center;">
        <div style="background:white;border-radius:20px;padding:32px 28px;max-width:380px;width:90%;box-shadow:0 20px 60px rgba(11,31,58,0.2);animation:modalIn 0.18s ease;">
            <div style="width:52px;height:52px;background:#fee2e2;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
            </div>
            <h3 id="logout-modal-title" style="font-family:'DM Serif Display',serif;font-size:1.2rem;color:var(--navy);margin-bottom:8px;">Sign out?</h3>
            <p style="font-size:0.85rem;color:var(--muted);margin-bottom:24px;line-height:1.6;">You'll be returned to the login screen. Any unsaved changes will be lost.</p>
            <div style="display:flex;gap:10px;">
                <button id="logout-cancel" style="flex:1;padding:10px;border:1px solid var(--border);border-radius:10px;background:white;color:var(--navy);font-size:0.85rem;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;">Cancel</button>
                <a id="logout-confirm" href="#" style="flex:1;padding:10px;border:none;border-radius:10px;background:#dc2626;color:white;font-size:0.85rem;font-weight:600;cursor:pointer;text-align:center;text-decoration:none;font-family:'DM Sans',sans-serif;">Sign Out</a>
            </div>
        </div>

    </div>


    <!-- ============================================================
         JAVASCRIPT
         ============================================================ -->

    <script>

            let currentDoctorRow = null;
            let currentTechnicianRow = null;


            // ============================================================
            // GENERAL MODAL
            // ============================================================

            function closeModal(id) {
        var currentDoctorRow = null;
        var currentTechnicianRow = null;

                document
                    .getElementById(id)
                    .classList.remove("show");
        // ── GENERAL MODAL ──
        function openModal(id) { document.getElementById(id).classList.add("show"); }
        function closeModal(id) { document.getElementById(id).classList.remove("show"); }

        function statusBadge(isActive) {
            return isActive
                ? '<span class="status-badge active">Active</span>'
                : '<span class="status-badge inactive">Inactive</span>';
            }


            // ============================================================
            // DOCTOR VIEW
            // ============================================================

        // ══════════════ DOCTORS ══════════════
            function openDoctorView(row) {

                currentDoctorRow = row;

                document.getElementById("viewDoctorName").textContent =
                    row.dataset.fullname || "";

                document.getElementById("viewDoctorHpcsa").textContent =
                    row.dataset.hpcsa || "";

                document.getElementById("viewDoctorEmail").textContent =
                    row.dataset.email || "";

                document.getElementById("viewDoctorContact").textContent =
                    row.dataset.contact || "";

                const active =
                    row.dataset.active === "true";

                document.getElementById("viewDoctorStatus").innerHTML =
                    active
                        ? '<span class="status-badge active">Active</span>'
                        : '<span class="status-badge inactive">Inactive</span>';

                document
                    .getElementById("doctorViewModal")
                    .classList.add("show");
            document.getElementById("viewDoctorName").textContent = row.dataset.fullname || "";
            document.getElementById("viewDoctorHpcsa").textContent = row.dataset.hpcsa || "";
            document.getElementById("viewDoctorEmail").textContent = row.dataset.email || "";
            document.getElementById("viewDoctorContact").textContent = row.dataset.contact || "—";
            document.getElementById("viewDoctorStatus").innerHTML = statusBadge(row.dataset.active === "true");

            openModal("doctorViewModal");
            }


            // ============================================================
            // ADD DOCTOR
            // ============================================================

            function openAddDoctor() {

                const form =
                    document.getElementById("doctorForm");

                form.action =
                    "/Staff/AddDoctor";

                document.getElementById("doctorModalTitle").textContent =
                    "Add Doctor";

                document.getElementById("doctorId").value =
                    "0";

                document.getElementById("doctorFirstName").value =
                    "";

                document.getElementById("doctorLastName").value =
                    "";

                document.getElementById("doctorHpcsa").value =
                    "";

                document.getElementById("doctorEmail").value =
                    "";

                document.getElementById("doctorContact").value =
                    "";
            var form = document.getElementById("doctorForm");
            form.action = form.dataset.addUrl;

                document
                    .getElementById("doctorModal")
                    .classList.add("show");
            document.getElementById("doctorModalTitle").textContent = "Add Doctor";
            document.getElementById("doctorId").value = "0";
            document.getElementById("doctorFirstName").value = "";
            document.getElementById("doctorLastName").value = "";
            document.getElementById("doctorHpcsa").value = "";          // generated on save
            document.getElementById("doctorEmail").value = "";
            document.getElementById("doctorContact").value = "";

            openModal("doctorModal");
            }


            // ============================================================
            // EDIT DOCTOR
            // ============================================================

            function editCurrentDoctor() {

                if (!currentDoctorRow)
                    return;

        function openEditDoctor(row) {
            if (!row) return;
            currentDoctorRow = row;
                closeModal("doctorViewModal");

                const row =
                    currentDoctorRow;

                document.getElementById("doctorId").value =
                    row.dataset.id;

                document.getElementById("doctorFirstName").value =
                    row.dataset.firstname || "";

                document.getElementById("doctorLastName").value =
                    row.dataset.lastname || "";
            var form = document.getElementById("doctorForm");
            form.action = form.dataset.editUrl;

                document.getElementById("doctorHpcsa").value =
                    row.dataset.hpcsa || "";
            document.getElementById("doctorModalTitle").textContent = "Edit Doctor";
            document.getElementById("doctorId").value = row.dataset.id || "0";
            document.getElementById("doctorFirstName").value = row.dataset.firstname || "";
            document.getElementById("doctorLastName").value = row.dataset.lastname || "";
            document.getElementById("doctorHpcsa").value = row.dataset.hpcsa || "";
            document.getElementById("doctorEmail").value = row.dataset.email || "";
            document.getElementById("doctorContact").value = row.dataset.contact || "";

                document.getElementById("doctorEmail").value =
                    row.dataset.email || "";
            openModal("doctorModal");
        }

                document.getElementById("doctorContact").value =
                    row.dataset.contact || "";
        function editCurrentDoctor() { openEditDoctor(currentDoctorRow); }

                document.getElementById("doctorModalTitle").textContent =
                    "Edit Doctor";
        // ══════════════ TECHNICIANS ══════════════
        function testTypeBoxes() {
            return document.querySelectorAll('#technicianTestTypes input[type="checkbox"]');
        }

                document.getElementById("doctorForm").action =
                    "/Staff/EditDoctor";
        function updateTestTypeCount() {
            var n = 0;
            testTypeBoxes().forEach(function (cb) { if (cb.checked) n++; });

                document
                    .getElementById("doctorModal")
                    .classList.add("show");
            document.getElementById("technicianTestTypeCount").textContent =
                n === 0 ? "Select one or more test types." : n + " selected";

            if (n > 0) {
                document.getElementById("technicianTestTypeError").classList.remove("show");
                document.getElementById("technicianTestTypes").classList.remove("is-invalid");
            }
            return n;
            }


            // ============================================================
            // TECHNICIAN VIEW
            // ============================================================
        function setSelectedTestTypes(ids) {
            var wanted = {};
            ids.forEach(function (id) { wanted[id] = true; });
            testTypeBoxes().forEach(function (cb) { cb.checked = !!wanted[cb.value]; });
            updateTestTypeCount();
        }

            function openTechnicianView(row) {

                currentTechnicianRow = row;

                document.getElementById("viewTechnicianName").textContent =
                    row.dataset.fullname || "";

                document.getElementById("viewTechnicianEmployee").textContent =
                    row.dataset.employee || "";

                document.getElementById("viewTechnicianEmail").textContent =
                    row.dataset.email || "";

                document.getElementById("viewTechnicianTestType").textContent =
                    row.dataset.testname || "";

                const active =
                    row.dataset.active === "true";

                document.getElementById("viewTechnicianStatus").innerHTML =
                    active
                        ? '<span class="status-badge active">Active</span>'
                        : '<span class="status-badge inactive">Inactive</span>';

                document
                    .getElementById("technicianViewModal")
                    .classList.add("show");
            document.getElementById("viewTechnicianName").textContent = row.dataset.fullname || "";
            document.getElementById("viewTechnicianEmployee").textContent = row.dataset.employee || "";
            document.getElementById("viewTechnicianEmail").textContent = row.dataset.email || "";
            document.getElementById("viewTechnicianStatus").innerHTML = statusBadge(row.dataset.active === "true");

            var box = document.getElementById("viewTechnicianTestTypes");
            box.innerHTML = "";
            var names = (row.dataset.testnames || "").split("|").filter(Boolean);
            if (names.length === 0) {
                box.textContent = "—";
            } else {
                names.forEach(function (name) {
                    var chip = document.createElement("span");
                    chip.className = "test-badge";
                    chip.textContent = name;
                    box.appendChild(chip);
                });
            }


            // ============================================================
            // ADD TECHNICIAN
            // ============================================================
            openModal("technicianViewModal");
        }

            function openAddTechnician() {

                document.getElementById("technicianForm").action =
                    "/Staff/AddTechnician";

                document.getElementById("technicianModalTitle").textContent =
                    "Add Laboratory Technician";

                document.getElementById("technicianId").value =
                    "0";

                document.getElementById("technicianFirstName").value =
                    "";

                document.getElementById("technicianLastName").value =
                    "";

                document.getElementById("technicianEmployeeNumber").value =
                    "";

                document.getElementById("technicianEmail").value =
                    "";

                document.getElementById("technicianTestType").value =
                    "";
            var form = document.getElementById("technicianForm");
            form.action = form.dataset.addUrl;

                document
                    .getElementById("technicianModal")
                    .classList.add("show");
            document.getElementById("technicianModalTitle").textContent = "Add Laboratory Technician";
            document.getElementById("technicianId").value = "0";
            document.getElementById("technicianFirstName").value = "";
            document.getElementById("technicianLastName").value = "";
            document.getElementById("technicianEmployeeNumber").value = "";   // generated on save
            document.getElementById("technicianEmail").value = "";
            setSelectedTestTypes([]);
            document.getElementById("technicianTestTypeError").classList.remove("show");
            document.getElementById("technicianTestTypes").classList.remove("is-invalid");

            openModal("technicianModal");
            }


            // ============================================================
            // EDIT TECHNICIAN
            // ============================================================

            function editCurrentTechnician() {

                if (!currentTechnicianRow)
                    return;

        function openEditTechnician(row) {
            if (!row) return;
            currentTechnicianRow = row;
                closeModal("technicianViewModal");

                const row =
                    currentTechnicianRow;

                document.getElementById("technicianId").value =
                    row.dataset.id;

                document.getElementById("technicianFirstName").value =
                    row.dataset.firstname || "";
            var form = document.getElementById("technicianForm");
            form.action = form.dataset.editUrl;

                document.getElementById("technicianLastName").value =
                    row.dataset.lastname || "";
            document.getElementById("technicianModalTitle").textContent = "Edit Laboratory Technician";
            document.getElementById("technicianId").value = row.dataset.id || "0";
            document.getElementById("technicianFirstName").value = row.dataset.firstname || "";
            document.getElementById("technicianLastName").value = row.dataset.lastname || "";
            document.getElementById("technicianEmployeeNumber").value = row.dataset.employee || "";
            document.getElementById("technicianEmail").value = row.dataset.email || "";
            setSelectedTestTypes((row.dataset.testtypeids || "").split(",").filter(Boolean));
            document.getElementById("technicianTestTypeError").classList.remove("show");
            document.getElementById("technicianTestTypes").classList.remove("is-invalid");

                document.getElementById("technicianEmployeeNumber").value =
                    row.dataset.employee || "";
            openModal("technicianModal");
        }

                document.getElementById("technicianEmail").value =
                    row.dataset.email || "";
        function editCurrentTechnician() { openEditTechnician(currentTechnicianRow); }

                document.getElementById("technicianTestType").value =
                    row.dataset.testtypeid || "";
        document.getElementById("technicianTestTypes").addEventListener("change", updateTestTypeCount);

                document.getElementById("technicianModalTitle").textContent =
                    "Edit Laboratory Technician";
        // At least one test type is required
        document.getElementById("technicianForm").addEventListener("submit", function (e) {
            if (updateTestTypeCount() === 0) {
                e.preventDefault();
                document.getElementById("technicianTestTypeError").classList.add("show");
                document.getElementById("technicianTestTypes").classList.add("is-invalid");
                return;
            }

                document.getElementById("technicianForm").action =
                    "/ManagerDashboard/EditTechnician";
            // novalidate is on the form, so check the other required fields ourselves
            var form = e.target;
            if (!form.checkValidity()) {
                e.preventDefault();
                form.reportValidity();
            }
        });

                document
                    .getElementById("technicianModal")
                    .classList.add("show");
        // ── CLOSE MODAL WHEN CLICKING OUTSIDE / PRESSING ESC ──
        window.addEventListener("click", function (event) {
            document.querySelectorAll(".modal").forEach(function (modal) {
                if (event.target === modal) modal.classList.remove("show");
            });
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                document.querySelectorAll(".modal.show").forEach(function (modal) {
                    modal.classList.remove("show");
                });
            }

        });

            // ============================================================
            // CLOSE MODAL WHEN CLICKING OUTSIDE
            // ============================================================
        setTimeout(function () {
            document.querySelectorAll(".alert").forEach(function (alert) {
                alert.style.transition = "opacity .4s ease";
                alert.style.opacity = "0";
                setTimeout(function () { alert.remove(); }, 400);
            });
        }, 6000);

            window.addEventListener("click", function (event) {
        // ── LOGOUT MODAL ──
        (function () {
            var logoutBtn = document.getElementById("logout-btn");
            var logoutModal = document.getElementById("logout-modal");
            var logoutCancel = document.getElementById("logout-cancel");
            var logoutConfirm = document.getElementById("logout-confirm");

                document
                    .querySelectorAll(".modal")
                    .forEach(function (modal) {
            if (!logoutBtn || !logoutModal) return;

                        if (event.target === modal) {
            logoutConfirm.href = logoutBtn.href;

                            modal.classList.remove("show");
            logoutBtn.addEventListener("click", function (e) {
                e.preventDefault();
                logoutModal.style.display = "flex";
                logoutCancel.focus();
            });

            function closeLogoutModal() {
                logoutModal.style.display = "none";
                logoutBtn.focus();
                        }

            logoutCancel.addEventListener("click", closeLogoutModal);
            logoutModal.addEventListener("click", function (e) {
                if (e.target === logoutModal) closeLogoutModal();
                    });

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape" && logoutModal.style.display === "flex") closeLogoutModal();
            });

        })();
    </script>

</body>

</html>
