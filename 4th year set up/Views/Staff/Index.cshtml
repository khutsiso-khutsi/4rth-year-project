@using LabManager.Models
@model StaffViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    ViewData["Title"] = "Staff Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Management — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --navy: #0b1f3a;
                --navy2: #122848;
                --teal: #0d9488;
                --teal-dark: #0b7c72;
                --teal-light: rgba(13,148,136,0.1);
                --white: #ffffff;
                --offwhite: #f4f7fb;
                --muted: #6b7a99;
                --border: #dde4f0;
                --red: #dc2626;
                --red-dark: #b91c1c;
                --red-light: rgba(220,38,38,0.1);
                --green: #16a34a;
                --green-light: rgba(22,163,74,0.1);
                --amber: #d97706;
                --amber-light: rgba(217,119,6,0.1);
                --purple: #4f46e5;
                --purple-light: rgba(79,70,229,0.1);
                --radius: 16px;
                --shadow: 0 2px 8px rgba(11,31,58,.04);
                --shadow-lg: 0 20px 60px rgba(11,31,58,.20);
            }

            body {
                font-family: 'DM Sans', sans-serif;
                background: var(--offwhite);
                color: var(--navy);
                min-height: 100vh;
                line-height: 1.5;
            }

            button, input, select {
                font-family: inherit;
            }

            /* ── TOPBAR (matches dashboard) ── */
            .topbar {
                background: var(--navy);
                padding: 0 40px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                height: 64px;
                position: sticky;
                top: 0;
                z-index: 100;
                box-shadow: 0 2px 20px rgba(0,0,0,0.15);
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

            .brand-icon {
                width: 34px;
                height: 34px;
                background: var(--teal);
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .brand-icon svg {
                    width: 18px;
                    height: 18px;
                    fill: white;
                }

            .brand-name {
                font-family: 'DM Serif Display', serif;
                color: white;
                font-size: 1.1rem;
                line-height: 1.1;
            }

                .brand-name span {
                    display: block;
                    font-family: 'DM Sans', sans-serif;
                    font-size: 0.6rem;
                    font-weight: 300;
                    color: rgba(255,255,255,0.4);
                    letter-spacing: 0.1em;
                    text-transform: uppercase;
                }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .user-chip {
                display: flex;
                align-items: center;
                gap: 10px;
                background: rgba(255,255,255,0.07);
                border: 1px solid rgba(255,255,255,0.1);
                border-radius: 100px;
                padding: 6px 14px 6px 8px;
            }

            .user-avatar {
                width: 28px;
                height: 28px;
                background: var(--teal);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.75rem;
                font-weight: 600;
                color: white;
            }

            .user-email {
                font-size: 0.8rem;
                color: rgba(255,255,255,0.75);
                max-width: 160px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .logout-btn {
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.12);
                color: rgba(255,255,255,0.8);
                padding: 8px 16px;
                border-radius: 8px;
                text-decoration: none;
                font-size: 0.82rem;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 6px;
                transition: all 0.2s;
                cursor: pointer;
            }

                .logout-btn:hover {
                    background: rgba(255,255,255,0.15);
                    color: white;
                }

                .logout-btn svg {
                    width: 14px;
                    height: 14px;
                }

            /* ── LAYOUT ── */
            .page {
                display: flex;
                min-height: calc(100vh - 64px);
            }

            /* ── SIDEBAR (matches dashboard, includes Profile + Audit Log) ── */
            .sidebar {
                width: 220px;
                background: white;
                border-right: 1px solid var(--border);
                padding: 24px 0;
                flex-shrink: 0;
                position: sticky;
                top: 64px;
                height: calc(100vh - 64px);
                overflow-y: auto;
            }

            .nav-section {
                margin-bottom: 8px;
            }

            .nav-label {
                font-size: 0.65rem;
                font-weight: 600;
                color: var(--muted);
                letter-spacing: 0.1em;
                text-transform: uppercase;
                padding: 0 20px;
                margin-bottom: 4px;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 20px;
                color: var(--muted);
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 500;
                transition: all 0.15s;
                border-left: 3px solid transparent;
            }

                .nav-item:hover {
                    background: var(--offwhite);
                    color: var(--navy);
                }

                .nav-item.active {
                    background: var(--teal-light);
                    color: var(--teal);
                    border-left-color: var(--teal);
                    font-weight: 600;
                }

                .nav-item svg {
                    width: 16px;
                    height: 16px;
                    flex-shrink: 0;
                }

                .nav-item:focus-visible {
                    outline: 2px solid var(--teal);
                    outline-offset: -2px;
                }

            /* ── MAIN (matches dashboard) ── */
            .main {
                flex: 1;
                padding: clamp(24px, 3vw, 40px);
                overflow-y: auto;
            }

            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 24px;
                flex-wrap: wrap;
                gap: 16px;
            }

                .page-header h1 {
                    font-family: 'DM Serif Display', serif;
                    font-size: 1.8rem;
                    font-weight: 400;
                    color: var(--navy);
                }

                .page-header p {
                    color: var(--muted);
                    margin: 6px 0 0;
                    font-size: 0.85rem;
                    font-weight: 300;
                }

            /* ── BUTTONS (recolored to dashboard palette) ── */
            .btn {
                border: none;
                border-radius: 10px;
                padding: 9px 15px;
                cursor: pointer;
                font-family: inherit;
                font-weight: 600;
                font-size: 0.82rem;
                transition: all .18s ease;
            }

                .btn:hover {
                    transform: translateY(-1px);
                }

            .btn-primary {
                background: var(--teal);
                color: white;
                box-shadow: 0 2px 8px rgba(13,148,136,0.25);
            }

                .btn-primary:hover {
                    background: var(--teal-dark);
                }

            .btn-secondary {
                background: var(--offwhite);
                color: var(--navy);
                border: 1px solid var(--border);
            }

                .btn-secondary:hover {
                    border-color: var(--teal);
                    color: var(--teal);
                }

            .btn-danger {
                background: var(--red-light);
                color: var(--red);
            }

                .btn-danger:hover {
                    background: rgba(220,38,38,0.2);
                }

            /* ── CARDS ── */
            .cards {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 20px;
            }

            .card {
                background: white;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                overflow: hidden;
                box-shadow: var(--shadow);
            }

            .card-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 17px 22px;
                border-bottom: 1px solid var(--border);
            }

            .card-title {
                font-family: 'DM Serif Display', serif;
                font-size: 1.05rem;
                font-weight: 400;
                color: var(--navy);
            }

            .count {
                background: var(--teal-light);
                color: var(--teal);
                padding: 4px 10px;
                border-radius: 100px;
                font-size: 0.72rem;
                font-weight: 700;
                margin-left: 8px;
            }

            /* ── TABLE ── */
            table {
                width: 100%;
                border-collapse: collapse;
            }

            th {
                text-align: left;
                padding: 12px 20px;
                background: var(--offwhite);
                color: var(--muted);
                font-size: 0.7rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .06em;
                border-bottom: 1px solid var(--border);
            }

            td {
                padding: 15px 20px;
                border-top: 1px solid var(--offwhite);
                font-size: 0.82rem;
                color: var(--navy);
            }

            .row-clickable {
                cursor: pointer;
            }

                .row-clickable:hover {
                    background: var(--offwhite);
                }

            .status-badge {
                display: inline-block;
                padding: 4px 10px;
                border-radius: 100px;
                font-size: 0.68rem;
                font-weight: 700;
            }

            .active {
                background: var(--green-light);
                color: var(--green);
            }

            .inactive {
                background: var(--red-light);
                color: var(--red);
            }

            .test-badge {
                display: inline-block;
                background: var(--teal-light);
                color: var(--teal);
                padding: 4px 9px;
                border-radius: 6px;
                font-size: 0.68rem;
                font-weight: 600;
            }

            .empty {
                text-align: center;
                padding: 35px;
                color: var(--muted);
                font-size: 0.82rem;
            }

            /* ── ALERTS ── */
            .alert {
                padding: 13px 16px;
                border-radius: 10px;
                margin-bottom: 20px;
                font-size: 0.82rem;
                font-weight: 600;
            }

            .alert-success {
                background: var(--green-light);
                color: var(--green);
                border: 1px solid rgba(22,163,74,0.25);
            }

            .alert-error {
                background: var(--red-light);
                color: var(--red);
                border: 1px solid rgba(220,38,38,0.25);
            }

            /* ── MODAL ── */
            .modal {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(11,31,58,.45);
                backdrop-filter: blur(3px);
                align-items: center;
                justify-content: center;
                z-index: 2000;
                padding: 20px;
            }

                .modal.show {
                    display: flex;
                }

            .modal-box {
                width: 100%;
                max-width: 550px;
                background: white;
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                max-height: 90vh;
                overflow-y: auto;
                animation: modalIn .18s ease;
            }

            @@keyframes modalIn {
                from {
                    opacity: 0;
                    transform: translateY(8px) scale(.98);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            .modal-header {
                padding: 19px 22px;
                border-bottom: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .modal-header h2 {
                    font-family: 'DM Serif Display', serif;
                    font-size: 1.2rem;
                    font-weight: 400;
                    color: var(--navy);
                }

            .close {
                width: 32px;
                height: 32px;
                border: none;
                background: var(--offwhite);
                color: var(--muted);
                border-radius: 8px;
                cursor: pointer;
                font-size: 18px;
                transition: background .18s ease, color .18s ease;
            }

                .close:hover {
                    background: var(--border);
                    color: var(--navy);
                }

            .modal-body {
                padding: 22px;
            }

            .form-group {
                margin-bottom: 17px;
            }

                .form-group label {
                    display: block;
                    margin-bottom: 7px;
                    font-size: 0.75rem;
                    font-weight: 700;
                    color: var(--navy);
                }

            .form-control {
                width: 100%;
                padding: 10px 12px;
                border: 1px solid var(--border);
                border-radius: 8px;
                outline: none;
                font-family: inherit;
                font-size: 0.85rem;
                background: white;
                color: var(--navy);
            }

                .form-control:focus {
                    border-color: var(--teal);
                    box-shadow: 0 0 0 3px var(--teal-light);
                }

            .modal-footer {
                padding: 16px 22px;
                border-top: 1px solid var(--border);
                display: flex;
                justify-content: flex-end;
                gap: 10px;
                background: var(--offwhite);
            }

            .detail-row {
                display: flex;
                justify-content: space-between;
                gap: 20px;
                padding: 12px 0;
                border-bottom: 1px solid var(--offwhite);
            }

            .detail-label {
                color: var(--muted);
                font-size: 0.8rem;
            }

            .detail-value {
                font-weight: 700;
                color: var(--navy);
                text-align: right;
            }

            /* ── RESPONSIVE (matches dashboard breakpoints) ── */
            @@media (max-width: 1000px) {
                .cards {
                    grid-template-columns: 1fr;
                }
            }

            @@media (max-width: 768px) {
                .topbar {
                    padding: 0 20px;
                }

                .user-email {
                    display: none;
                }

                .sidebar {
                    display: none;
                }

                .main {
                    padding: 20px 16px;
                }

                .page-header {
                    flex-direction: column;
                    align-items: flex-start;
                }
            }
    </style>
</head>
<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-icon">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "M")</div>
                <span class="user-email">@(ViewBag.Email ?? "Laboratory Manager")</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn" id="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">

        <!-- SIDEBAR (Main + System, matches dashboard) -->
        <aside class="sidebar">
            <div class="nav-section">
                <div class="nav-label">Main</div>

                <a asp-controller="ManagerDashboard" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                    </svg>
                    Dashboard
                </a>

                <a asp-controller="TestCatalogue" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M9 3v11a3 3 0 006 0V3" />
                        <line x1="6" y1="3" x2="18" y2="3" />
                    </svg>
                    Test Catalogue
                </a>

                <a asp-controller="Consumable" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                    </svg>
                    Consumables
                </a>

                <a asp-controller="Staff" asp-action="Index" class="nav-item active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Staff
                </a>

                <a asp-controller="ConsumableOrder" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                    </svg>
                    Orders
                </a>

                <a asp-controller="ManagerDashboard" asp-action="TestsByCategory" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                    Reports
                </a>
            </div>

            <div class="nav-section">
                <div class="nav-label">System</div>

                <a asp-controller="ManagerDashboard" asp-action="Profile" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Profile
                </a>

                <a asp-controller="ManagerDashboard" asp-action="AuditLog" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                    Audit Log
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="main">

            <div class="page-header">
                <div>
                    <h1>Staff Management</h1>
                    <p>Manage doctors and laboratory technicians.</p>
                </div>
            </div>

            <!-- ALERTS -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">✓ @TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">⚠ @TempData["Error"]</div>
            }

            <div class="cards">

                <!-- DOCTORS -->
                <section class="card">

                    <div class="card-header">
                        <div>
                            <span class="card-title">Doctors</span>
                            <span class="count">@Model.Doctors.Count()</span>
                        </div>

                        <button type="button" class="btn btn-primary" onclick="openAddDoctor()">
                            + Add Doctor
                        </button>
                    </div>

                    @if (Model.Doctors.Any())
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>HPCSA</th>
                                    <th>Email</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Doctors)
                                {
                                    <tr class="row-clickable"
                                        data-id="@d.Id"
                                        data-fullname="@d.FullName"
                                        data-firstname="@d.FirstName"
                                        data-lastname="@d.LastName"
                                        data-email="@d.EmailAddress"
                                        data-hpcsa="@d.HCPSANumber"
                                        data-contact="@d.ContactNumber"
                                        data-active="@d.IsActive.ToString().ToLower()"
                                        onclick="openDoctorView(this)">

                                        <td><strong>@d.FullName</strong></td>
                                        <td>@d.HCPSANumber</td>
                                        <td>@d.EmailAddress</td>
                                        <td>
                                            @if (d.IsActive)
                                            {
                                                <span class="status-badge active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge inactive">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty">No doctors found.</div>
                    }

                </section>

                <!-- TECHNICIANS -->
                <section class="card">

                    <div class="card-header">
                        <div>
                            <span class="card-title">Laboratory Technicians</span>
                            <span class="count">@Model.Technicians.Count()</span>
                        </div>

                        <button type="button" class="btn btn-primary" onclick="openAddTechnician()">
                            + Add Technician
                        </button>
                    </div>

                    @if (Model.Technicians.Any())
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Employee No.</th>
                                    <th>Test Type</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.Technicians)
                                {
                                    <tr class="row-clickable"
                                        data-id="@t.Id"
                                        data-fullname="@t.FullName"
                                        data-firstname="@t.FirstName"
                                        data-lastname="@t.LastName"
                                        data-email="@t.EmailAddress"
                                        data-employee="@t.EmployeeNumber"
                                        data-testtypeid="@t.TestTypeID"
                                        data-testname="@t.TestName"
                                        data-active="@t.IsActive.ToString().ToLower()"
                                        onclick="openTechnicianView(this)">

                                        <td><strong>@t.FullName</strong></td>
                                        <td>@t.EmployeeNumber</td>
                                        <td><span class="test-badge">@t.TestName</span></td>
                                        <td>
                                            @if (t.IsActive)
                                            {
                                                <span class="status-badge active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge inactive">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty">No laboratory technicians found.</div>
                    }

                </section>

            </div>

        </main>
    </div>

    <!-- ============================================================
         DOCTOR VIEW MODAL
         ============================================================ -->
    <div id="doctorViewModal" class="modal">
        <div class="modal-box">
            <div class="modal-header">
                <h2>Doctor Details</h2>
                <button class="close" onclick="closeModal('doctorViewModal')">&times;</button>
            </div>

            <div class="modal-body">
                <div class="detail-row">
                    <span class="detail-label">Name</span>
                    <span id="viewDoctorName" class="detail-value"></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">HPCSA Number</span>
                    <span id="viewDoctorHpcsa" class="detail-value"></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Email</span>
                    <span id="viewDoctorEmail" class="detail-value"></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Contact</span>
                    <span id="viewDoctorContact" class="detail-value"></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Status</span>
                    <span id="viewDoctorStatus" class="detail-value"></span>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('doctorViewModal')">Close</button>
                <button type="button" class="btn btn-primary" onclick="editCurrentDoctor()">Edit</button>
            </div>
        </div>
    </div>

    <!-- ============================================================
         ADD / EDIT DOCTOR
         ============================================================ -->
    <div id="doctorModal" class="modal">
        <div class="modal-box">
            <div class="modal-header">
                <h2 id="doctorModalTitle">Add Doctor</h2>
                <button class="close" onclick="closeModal('doctorModal')">&times;</button>
            </div>

            <form id="doctorForm" method="post" action="/Staff/AddDoctor">
                @Html.AntiForgeryToken()

                <input type="hidden" id="doctorId" name="id" value="0" />

                <div class="modal-body">

                    <div class="form-group">
                        <label>First Name</label>
                        <input type="text" id="doctorFirstName" name="firstName" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label>Last Name</label>
                        <input type="text" id="doctorLastName" name="lastName" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label>HPCSA Number</label>
                        <input type="text" id="doctorHpcsa" name="hpcsaNumber" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" id="doctorEmail" name="email" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label>Contact Number</label>
                        <input type="text" id="doctorContact" name="contactNumber" class="form-control" />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('doctorModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Doctor</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ============================================================
         TECHNICIAN VIEW MODAL
         ============================================================ -->
    <div id="technicianViewModal" class="modal">
        <div class="modal-box">
            <div class="modal-header">
                <h2>Technician Details</h2>
                <button class="close" onclick="closeModal('technicianViewModal')">&times;</button>
            </div>

            <div class="modal-body">
                <div class="detail-row">
                    <span class="detail-label">Name</span>
                    <span id="viewTechnicianName" class="detail-value"></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Employee Number</span>
                    <span id="viewTechnicianEmployee" class="detail-value"></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Email</span>
                    <span id="viewTechnicianEmail" class="detail-value"></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Test Type</span>
                    <span id="viewTechnicianTestType" class="detail-value"></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Status</span>
                    <span id="viewTechnicianStatus" class="detail-value"></span>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('technicianViewModal')">Close</button>
                <button type="button" class="btn btn-primary" onclick="editCurrentTechnician()">Edit</button>
            </div>
        </div>
    </div>

    <!-- ============================================================
         ADD / EDIT TECHNICIAN
         ============================================================ -->
    <div id="technicianModal" class="modal">
        <div class="modal-box">
            <div class="modal-header">
                <h2 id="technicianModalTitle">Add Laboratory Technician</h2>
                <button class="close" onclick="closeModal('technicianModal')">&times;</button>
            </div>

            <form id="technicianForm" method="post" action="/Staff/AddTechnician">
                @Html.AntiForgeryToken()

                <input type="hidden" id="technicianId" name="id" value="0" />

                <div class="modal-body">

                    <div class="form-group">
                        <label>First Name</label>
                        <input type="text" id="technicianFirstName" name="firstName" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label>Last Name</label>
                        <input type="text" id="technicianLastName" name="lastName" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label>Employee Number</label>
                        <input type="text" id="technicianEmployeeNumber" name="employeeNumber" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" id="technicianEmail" name="email" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label for="technicianTestType">Test Type</label>
                        <select id="technicianTestType" name="testTypeID" class="form-control" required>
                            <option value="">-- Select Test Type --</option>
                            @foreach (var testType in Model.TestTypes)
                            {
                                <option value="@testType.TestId">@testType.TestName</option>
                            }
                        </select>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('technicianModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Technician</button>
                </div>
            </form>
        </div>
    </div>

    <!-- LOGOUT CONFIRMATION MODAL (matches dashboard) -->
    <div id="logout-modal" role="dialog" aria-modal="true" aria-labelledby="logout-modal-title"
         style="display:none;position:fixed;inset:0;z-index:2100;background:rgba(11,31,58,0.45);align-items:center;justify-content:center;">
        <div style="background:white;border-radius:20px;padding:32px 28px;max-width:380px;width:90%;box-shadow:0 20px 60px rgba(11,31,58,0.2);animation:modalIn 0.18s ease;">
            <div style="width:52px;height:52px;background:#fee2e2;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
            </div>
            <h3 id="logout-modal-title" style="font-family:'DM Serif Display',serif;font-size:1.2rem;color:var(--navy);margin-bottom:8px;">Sign out?</h3>
            <p style="font-size:0.85rem;color:var(--muted);margin-bottom:24px;line-height:1.6;">You'll be returned to the login screen. Any unsaved changes will be lost.</p>
            <div style="display:flex;gap:10px;">
                <button id="logout-cancel" style="flex:1;padding:10px;border:1px solid var(--border);border-radius:10px;background:white;color:var(--navy);font-size:0.85rem;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;">Cancel</button>
                <a id="logout-confirm" href="#" style="flex:1;padding:10px;border:none;border-radius:10px;background:#dc2626;color:white;font-size:0.85rem;font-weight:600;cursor:pointer;text-align:center;text-decoration:none;font-family:'DM Sans',sans-serif;">Sign Out</a>
            </div>
        </div>
    </div>

    <!-- ============================================================
         JAVASCRIPT
         ============================================================ -->
    <script>

            let currentDoctorRow = null;
            let currentTechnicianRow = null;

            // ── GENERAL MODAL ──
            function closeModal(id) {
                document.getElementById(id).classList.remove("show");
            }

            // ── DOCTOR VIEW ──
            function openDoctorView(row) {
                currentDoctorRow = row;

                document.getElementById("viewDoctorName").textContent = row.dataset.fullname || "";
                document.getElementById("viewDoctorHpcsa").textContent = row.dataset.hpcsa || "";
                document.getElementById("viewDoctorEmail").textContent = row.dataset.email || "";
                document.getElementById("viewDoctorContact").textContent = row.dataset.contact || "";

                const active = row.dataset.active === "true";
                document.getElementById("viewDoctorStatus").innerHTML =
                    active
                        ? '<span class="status-badge active">Active</span>'
                        : '<span class="status-badge inactive">Inactive</span>';

                document.getElementById("doctorViewModal").classList.add("show");
            }

            // ── ADD DOCTOR ──
            function openAddDoctor() {
                const form = document.getElementById("doctorForm");
                form.action = "/Staff/AddDoctor";

                document.getElementById("doctorModalTitle").textContent = "Add Doctor";
                document.getElementById("doctorId").value = "0";
                document.getElementById("doctorFirstName").value = "";
                document.getElementById("doctorLastName").value = "";
                document.getElementById("doctorHpcsa").value = "";
                document.getElementById("doctorEmail").value = "";
                document.getElementById("doctorContact").value = "";

                document.getElementById("doctorModal").classList.add("show");
            }

            // ── EDIT DOCTOR ──
            function editCurrentDoctor() {
                if (!currentDoctorRow) return;

                closeModal("doctorViewModal");

                const row = currentDoctorRow;

                document.getElementById("doctorId").value = row.dataset.id;
                document.getElementById("doctorFirstName").value = row.dataset.firstname || "";
                document.getElementById("doctorLastName").value = row.dataset.lastname || "";
                document.getElementById("doctorHpcsa").value = row.dataset.hpcsa || "";
                document.getElementById("doctorEmail").value = row.dataset.email || "";
                document.getElementById("doctorContact").value = row.dataset.contact || "";

                document.getElementById("doctorModalTitle").textContent = "Edit Doctor";
                document.getElementById("doctorForm").action = "/Staff/EditDoctor";

                document.getElementById("doctorModal").classList.add("show");
            }

            // ── TECHNICIAN VIEW ──
            function openTechnicianView(row) {
                currentTechnicianRow = row;

                document.getElementById("viewTechnicianName").textContent = row.dataset.fullname || "";
                document.getElementById("viewTechnicianEmployee").textContent = row.dataset.employee || "";
                document.getElementById("viewTechnicianEmail").textContent = row.dataset.email || "";
                document.getElementById("viewTechnicianTestType").textContent = row.dataset.testname || "";

                const active = row.dataset.active === "true";
                document.getElementById("viewTechnicianStatus").innerHTML =
                    active
                        ? '<span class="status-badge active">Active</span>'
                        : '<span class="status-badge inactive">Inactive</span>';

                document.getElementById("technicianViewModal").classList.add("show");
            }

            // ── ADD TECHNICIAN ──
            function openAddTechnician() {
                document.getElementById("technicianForm").action = "/Staff/AddTechnician";

                document.getElementById("technicianModalTitle").textContent = "Add Laboratory Technician";
                document.getElementById("technicianId").value = "0";
                document.getElementById("technicianFirstName").value = "";
                document.getElementById("technicianLastName").value = "";
                document.getElementById("technicianEmployeeNumber").value = "";
                document.getElementById("technicianEmail").value = "";
                document.getElementById("technicianTestType").value = "";

                document.getElementById("technicianModal").classList.add("show");
            }

            // ── EDIT TECHNICIAN ──
            function editCurrentTechnician() {
                if (!currentTechnicianRow) return;

                closeModal("technicianViewModal");

                const row = currentTechnicianRow;

                document.getElementById("technicianId").value = row.dataset.id;
                document.getElementById("technicianFirstName").value = row.dataset.firstname || "";
                document.getElementById("technicianLastName").value = row.dataset.lastname || "";
                document.getElementById("technicianEmployeeNumber").value = row.dataset.employee || "";
                document.getElementById("technicianEmail").value = row.dataset.email || "";
                document.getElementById("technicianTestType").value = row.dataset.testtypeid || "";

                document.getElementById("technicianModalTitle").textContent = "Edit Laboratory Technician";
                document.getElementById("technicianForm").action = "/ManagerDashboard/EditTechnician";

                document.getElementById("technicianModal").classList.add("show");
            }

            // ── CLOSE MODAL WHEN CLICKING OUTSIDE ──
            window.addEventListener("click", function (event) {
                document.querySelectorAll(".modal").forEach(function (modal) {
                    if (event.target === modal) {
                        modal.classList.remove("show");
                    }
                });
            });

            // ── LOGOUT MODAL ──
            (function () {
                var logoutBtn     = document.getElementById('logout-btn');
                var logoutModal   = document.getElementById('logout-modal');
                var logoutCancel  = document.getElementById('logout-cancel');
                var logoutConfirm = document.getElementById('logout-confirm');

                if (logoutBtn && logoutModal) {
                    logoutConfirm.href = logoutBtn.href;

                    logoutBtn.addEventListener('click', function (e) {
                        e.preventDefault();
                        logoutModal.style.display = 'flex';
                        logoutCancel.focus();
                    });

                    function closeLogoutModal() {
                        logoutModal.style.display = 'none';
                        logoutBtn.focus();
                    }

                    logoutCancel.addEventListener('click', closeLogoutModal);
                    logoutModal.addEventListener('click', function (e) {
                        if (e.target === logoutModal) closeLogoutModal();
                    });
                    document.addEventListener('keydown', function (e) {
                        if (e.key === 'Escape' && logoutModal.style.display === 'flex') closeLogoutModal();
                    });
                }
            })();

    </script>

</body>
</html>
