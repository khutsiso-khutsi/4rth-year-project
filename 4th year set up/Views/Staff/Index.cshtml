    <div id="technicianViewModal" class="modal">
        <div class="modal-box">
            <div class="modal-header">
                <h2>Technician Details</h2>
                <button type="button" class="close" onclick="closeModal('technicianViewModal')">&times;</button>
            </div>

            <div class="modal-body">
                <div class="detail-row"><span class="detail-label">Name</span><span id="viewTechnicianName" class="detail-value"></span></div>
                <div class="detail-row"><span class="detail-label">Employee Number</span><span id="viewTechnicianEmployee" class="detail-value"></span></div>
                <div class="detail-row"><span class="detail-label">Email</span><span id="viewTechnicianEmail" class="detail-value"></span></div>
                <div class="detail-row"><span class="detail-label">Test Types</span><span id="viewTechnicianTestTypes" class="detail-value chips"></span></div>
                <div class="detail-row"><span class="detail-label">Status</span><span id="viewTechnicianStatus" class="detail-value"></span></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('technicianViewModal')">Close</button>
                <button type="button" class="btn btn-primary" onclick="editCurrentTechnician()">✎ Edit</button>
            </div>
        </div>
    </div>

    <!-- ============================================================
         ADD / EDIT TECHNICIAN
         ============================================================ -->
    <div id="technicianModal" class="modal">
        <div class="modal-box">
            <div class="modal-header">
                <h2 id="technicianModalTitle">Add Laboratory Technician</h2>
                <button type="button" class="close" onclick="closeModal('technicianModal')">&times;</button>
            </div>

            <form id="technicianForm" method="post" novalidate
                  action="@Url.Action("AddTechnician", "Staff")"
                  data-add-url="@Url.Action("AddTechnician", "Staff")"
                  data-edit-url="@Url.Action("EditTechnician", "Staff")">
                @Html.AntiForgeryToken()

                <input type="hidden" id="technicianId" name="id" value="0" />

                <div class="modal-body">

                    <div class="form-group">
                        <label for="technicianFirstName">First Name<span class="req">*</span></label>
                        <input type="text" id="technicianFirstName" name="firstName" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label for="technicianLastName">Last Name<span class="req">*</span></label>
                        <input type="text" id="technicianLastName" name="lastName" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label for="technicianEmployeeNumber">Employee Number</label>
                        <!-- display only: no name attribute, so it is never posted -->
                        <input type="text" id="technicianEmployeeNumber" class="form-control" readonly tabindex="-1"
                               placeholder="Generated automatically on save" />
                        <span class="hint">Assigned by the system and cannot be edited.</span>
                    </div>

                    <div class="form-group">
                        <label for="technicianEmail">Email Address<span class="req">*</span></label>
                        <input type="email" id="technicianEmail" name="email" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label>Test Types<span class="req">*</span></label>
                        <div class="check-list" id="technicianTestTypes">
