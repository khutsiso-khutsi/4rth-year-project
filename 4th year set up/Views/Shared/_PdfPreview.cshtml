@* Views/Shared/_PdfPreview.cshtml
   Adds an "eye" (preview) button next to every PDF download link / button on the page
   and opens the same document in a pop-up before it is downloaded.
   Include ONCE per page, just before </body>:   <partial name="_PdfPreview" />
   Works on its own: it finds the links by their address (ReportPdf, ResultsPdf,
   PrintResult, PatientDashboard/Report). Any other link can opt in with  data-pdf-preview. *@
<style>
    .pp-eye {
        display: inline-flex; align-items: center; justify-content: center;
        width: 34px; height: 34px; margin-left: 6px; padding: 0; vertical-align: middle; flex-shrink: 0;
        border: 1px solid var(--border, #d7dde5); border-radius: 8px;
        background: var(--white, #fff); color: var(--teal, #0d9488); cursor: pointer;
        transition: background .15s, border-color .15s;
    }
    .pp-eye:hover { background: var(--offwhite, #f1f5f9); border-color: var(--teal, #0d9488); }
    .pp-eye:focus-visible { outline: 2px solid var(--teal, #0d9488); outline-offset: 2px; }

    .pp-backdrop {
        position: fixed; inset: 0; z-index: 10000; display: flex; align-items: center; justify-content: center;
        padding: 20px; background: rgba(10, 25, 47, .6);
    }
    .pp-backdrop[hidden] { display: none; }
    .pp-box {
        display: flex; flex-direction: column; width: min(1000px, 100%); height: min(92vh, 900px);
        background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 20px 60px rgba(0, 0, 0, .35);
    }
    .pp-head {
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
        padding: 12px 16px; border-bottom: 1px solid #e5e7eb; background: #f8fafc;
    }
    .pp-head strong { font-size: 15px; color: #0f172a; }
    .pp-actions { display: flex; gap: 8px; }
    .pp-btn {
        display: inline-block; padding: 8px 16px; border-radius: 8px; font-size: 13.5px; font-weight: 600;
        border: 1px solid #d7dde5; background: #fff; color: #0f172a; cursor: pointer; text-decoration: none;
    }
    .pp-btn.primary { background: var(--teal, #0d9488); border-color: var(--teal, #0d9488); color: #fff; }
    .pp-frame { flex: 1; width: 100%; border: 0; background: #e5e7eb; }
    @@media (max-width: 640px) {
        .pp-backdrop { padding: 0; }
        .pp-box { height: 100vh; border-radius: 0; }
    }
</style>

<div id="ppModal" class="pp-backdrop" hidden>
    <div class="pp-box" role="dialog" aria-modal="true" aria-labelledby="ppTitle">
        <div class="pp-head">
            <strong id="ppTitle">Document preview</strong>
            <div class="pp-actions">
                <a id="ppDownload" class="pp-btn primary" href="#" data-pp-done="1">Download</a>
                <button type="button" id="ppClose" class="pp-btn">Close</button>
            </div>
        </div>
        <iframe id="ppFrame" class="pp-frame" title="Document preview"></iframe>
    </div>
</div>

<script>
    (function () {
        if (window.__ppInit) return;
        window.__ppInit = true;

        var LINK = /\/(ReportPdf|ResultsPdf|PrintResult)(?=[\/?#]|$)|\/PatientDashboard\/Report(?=[?#]|$)/i;
        var EYE = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" ' +
                  'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
                  '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>';

        var modal = document.getElementById('ppModal');
        var frame = document.getElementById('ppFrame');
        var dl = document.getElementById('ppDownload');
        var title = document.getElementById('ppTitle');
        var closeBtn = document.getElementById('ppClose');
        var lastFocus = null;

        function previewUrl(href) {
            var u = new URL(href, window.location.href);
            u.searchParams.set('preview', '1');
            return u.toString();
        }
        function openPreview(href, label) {
            lastFocus = document.activeElement;
            title.textContent = label || 'Document preview';
            dl.href = href;
            frame.src = previewUrl(href);
            modal.hidden = false;
            document.body.style.overflow = 'hidden';
            closeBtn.focus();
        }
        function closePreview() {
            modal.hidden = true;
            frame.src = 'about:blank';
            document.body.style.overflow = '';
            if (lastFocus && lastFocus.focus) lastFocus.focus();
        }
        function makeEye(label, onClick) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'pp-eye';
            b.title = 'Preview PDF before downloading';
            b.setAttribute('aria-label', 'Preview PDF: ' + label);
            b.innerHTML = EYE;
            b.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();   // so a click inside a clickable card header doesn't also toggle the card
                onClick();
            });
            return b;
        }
        // put the eye right after the button it belongs to and size it to match
        function place(ref, b) {
            ref.insertAdjacentElement('afterend', b);
            var h = ref.offsetHeight;
            if (h >= 24 && h <= 56) { b.style.width = h + 'px'; b.style.height = h + 'px'; }
            var p = ref.parentElement;
            if (p && /flex/.test(window.getComputedStyle(p).display)) b.style.marginLeft = '0';
        }
        // hide the eye whenever the button it belongs to is hidden (e.g. result not released yet)
        function follow(ref, b) {
            function sync() { b.style.display = (ref.style.display === 'none' || ref.hidden) ? 'none' : ''; }
            sync();
            new MutationObserver(sync).observe(ref, { attributes: true, attributeFilter: ['style', 'hidden'] });
        }

        function enhance(root) {
            // links, e.g. <a href="/Doctor/ReportPdf?from=...">
            root.querySelectorAll('a[href]').forEach(function (a) {
                if (a.dataset.ppDone) return;
                if (!a.hasAttribute('data-pdf-preview') && !LINK.test(a.getAttribute('href'))) return;
                a.dataset.ppDone = '1';
                var label = (a.getAttribute('data-pdf-title') || a.textContent || 'document').trim();
                var eye = makeEye(label, function () {
                    if (a.getAttribute('href') === '#') return;   // link not filled in yet
                    openPreview(a.href, label);
                });
                place(a, eye);
                follow(a, eye);
            });
            // GET forms whose button creates the PDF (e.g. a date range form)
            root.querySelectorAll('form[action]').forEach(function (f) {
                if (f.dataset.ppDone) return;
                if (!f.hasAttribute('data-pdf-preview') && !LINK.test(f.getAttribute('action'))) return;
                if ((f.getAttribute('method') || 'get').toLowerCase() !== 'get') return;
                var btn = f.querySelector('button[type=submit], input[type=submit], button:not([type])');
                if (!btn) return;
                f.dataset.ppDone = '1';
                var label = (f.getAttribute('data-pdf-title') || 'report').trim();
                var eyeF = makeEye(label, function () {
                    if (f.reportValidity && !f.reportValidity()) return;   // e.g. a date is missing
                    var qs = new URLSearchParams(new FormData(f)).toString();
                    openPreview(f.action.split('?')[0] + (qs ? '?' + qs : ''), label);
                });
                place(btn, eyeF);
                follow(btn, eyeF);
            });
        }

        closeBtn.addEventListener('click', closePreview);
        modal.addEventListener('click', function (e) { if (e.target === modal) closePreview(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) closePreview(); });

        enhance(document);
        // content that is loaded into the page later (pop-ups, AJAX panels)
        new MutationObserver(function (muts) {
            muts.forEach(function (m) {
                m.addedNodes.forEach(function (n) { if (n.nodeType === 1 && n !== modal) enhance(n); });
            });
        }).observe(document.body, { childList: true, subtree: true });
    })();
</script>
