@* The report table. On Reports.cshtml use:   <partial name="_ReportTable" model="Model.Requests" /> *@
@model IEnumerable<Doctor.Models.DoctorTestRequestSummary>
@{
    var rows = Model?.ToList() ?? new List<Doctor.Models.DoctorTestRequestSummary>();
}
<style>
    .rt-top { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:10px; flex-wrap:wrap; }
    .rt-count { font-size:13px; color:#64748b; }
    .rt-search { padding:9px 12px; border:1px solid #cbd5e1; border-radius:10px; font:inherit; font-size:14px; min-width:240px; }
    .rt-table { width:100%; border-collapse:collapse; font-size:14px; }
    .rt-table th { text-align:left; font-size:12px; text-transform:uppercase; letter-spacing:.04em; color:#64748b; padding:10px 12px; border-bottom:1px solid #e2e8f0; white-space:nowrap; }
    .rt-table td { padding:11px 12px; border-bottom:1px solid #f1f5f9; vertical-align:top; }
    .rt-pill { display:inline-block; padding:2px 10px; border-radius:999px; font-size:12px; background:#e2e8f0; color:#334155; }
    .rt-urgent { background:#fee2e2; color:#b91c1c; }
    .rt-empty { text-align:center; color:#64748b; padding:28px; }
</style>

<div class="rt-top">
    <span class="rt-count" id="rtCount">@rows.Count request@(rows.Count == 1 ? "" : "s")</span>
    <input type="text" class="rt-search" id="rtSearch" placeholder="Search this report..." />
</div>

<table class="rt-table" id="reportTable">
    <thead>
        <tr>
            <th>Request no.</th>
            <th>Request date</th>
            <th>Patient</th>
            <th>Urgency</th>
            <th>Status</th>
            <th>Released date</th>
            <th>Clinical notes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in rows)
        {
            <tr>
                <td><strong>@r.RequestNumber</strong></td>
                <td>@r.RequestDate.ToString("d MMM yyyy")</td>
                <td>@r.PatientName</td>
                <td><span class="rt-pill @(string.Equals(r.Urgency, "routine", StringComparison.OrdinalIgnoreCase) ? "" : "rt-urgent")">@r.Urgency</span></td>
                <td><span class="rt-pill">@r.RequestStatus</span></td>
                <td>@(r.ReleasedDate.HasValue ? r.ReleasedDate.Value.ToString("d MMM yyyy") : "—")</td>
                <td>@(string.IsNullOrWhiteSpace(r.ClinicalNotes) ? "—" : r.ClinicalNotes)</td>
            </tr>
        }
        @if (rows.Count == 0)
        {
            <tr><td colspan="7" class="rt-empty">No requests match these filters.</td></tr>
        }
    </tbody>
</table>

<script>
    (function () {
        const input = document.getElementById('rtSearch');
        const body = document.querySelector('#reportTable tbody');
        const count = document.getElementById('rtCount');
        input.addEventListener('input', function () {
            const q = input.value.toLowerCase();
            let shown = 0;
            body.querySelectorAll('tr').forEach(function (tr) {
                if (tr.children.length < 7) return;
                const ok = tr.textContent.toLowerCase().includes(q);
                tr.style.display = ok ? '' : 'none';
                if (ok) shown++;
            });
            count.textContent = shown + ' request' + (shown === 1 ? '' : 's');
        });
    })();
</script>
