<script>
    function generateReport() {
        const msg = document.getElementById('report-msg');
        msg.classList.add('visible');
        setTimeout(() => msg.classList.remove('visible'), 3000);
    }

    function printPreview() {
        window.print();
    }

    function viewRequest(id) {
        alert('Viewing request: ' + id);
    }

    // Update preview range label when dates change
    const dateFrom = document.getElementById('date-from');
    const dateTo = document.getElementById('date-to');
    const rangeLabel = document.getElementById('preview-range');

    function updateRangeLabel() {
        const from = dateFrom.value ? new Date(dateFrom.value).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }) : '';
        const to = dateTo.value ? new Date(dateTo.value).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }) : '';
        if (from && to) rangeLabel.textContent = from + ' – ' + to;
    }

    dateFrom.addEventListener('change', updateRangeLabel);
    dateTo.addEventListener('change', updateRangeLabel);
</script>

