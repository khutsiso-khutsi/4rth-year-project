@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Doctor.Models.CreateTestRequestViewModel
@{
    var history = ViewBag.History as List<Doctor.Models.DoctorTestRequestSummary> ?? new();
    ViewData["Title"] = "Test Requests";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test Requests — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --teal: #0d9488;
            --teal-light: rgba(13,148,136,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
            --amber: #d97706;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
        }

        /* ── TOPBAR ── */
        .topbar {
            background: var(--navy);
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-logo {
            width: 34px;
            height: 34px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .brand-logo svg {
            width: 18px;
            height: 18px;
            fill: white;
        }

        .brand-name {
            font-family: 'DM Serif Display', serif;
            color: white;
            font-size: 1.1rem;
            line-height: 1.1;
        }

        .brand-name span {
            display: block;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.6rem;
            font-weight: 300;
            color: rgba(255,255,255,0.4);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 6px 14px 6px 8px;
        }

        .user-avatar {
            width: 28px;
            height: 28px;
            background: var(--teal);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
        }

        .user-email {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.75);
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .logout-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.8);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .logout-btn:hover {
            background: rgba(255,255,255,0.15);
            color: white;
        }

        .logout-btn svg {
            width: 14px;
            height: 14px;
        }

        /* ── LAYOUT ── */
        .page {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 220px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 24px 0;
            flex-shrink: 0;
            position: sticky;
            top: 64px;
            height: calc(100vh - 64px);
            overflow-y: auto;
        }

        .nav-section {
            margin-bottom: 8px;
        }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 20px;
            margin-bottom: 4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.15s;
            border-left: 3px solid transparent;
        }

        .nav-item:hover {
            background: var(--offwhite);
            color: var(--navy);
        }

        .nav-item.active {
            background: var(--teal-light);
            color: var(--teal);
            border-left-color: var(--teal);
        }

        .nav-item svg {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }

        /* ── MAIN ── */
        .main {
            flex: 1;
            padding: clamp(24px, 3vw, 40px);
            overflow-y: auto;
        }

        /* ── HERO ── */
        .hero {
            background: var(--navy);
            border-radius: 20px;
            padding: 32px 36px;
            margin-bottom: 32px;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 60% 80% at 90% 50%, rgba(13,148,136,0.2) 0%, transparent 60%);
        }

        .hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(13,148,136,0.15);
            border: 1px solid rgba(13,148,136,0.3);
            color: #5eead4;
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 100px;
            margin-bottom: 14px;
        }

        .hero-tag::before {
            content: '';
            width: 5px;
            height: 5px;
            background: #5eead4;
            border-radius: 50%;
        }

        .hero h1 {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.5rem, 2.5vw, 2.2rem);
            color: white;
            margin-bottom: 8px;
            line-height: 1.2;
        }

        .hero h1 span {
            color: #5eead4;
            font-style: italic;
        }

        .hero p {
            color: rgba(255,255,255,0.5);
            font-size: 0.88rem;
            font-weight: 300;
        }

        /* ── SECTION HEADER ── */
        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .section-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            color: var(--navy);
        }

        /* ── FORM BOX ── */
        .report-box {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
            margin-bottom: 32px;
        }

        /* ── TABS ── */
        .tabs {
            display: flex;
            border-bottom: 1px solid var(--border);
            padding: 0 24px;
            background: var(--offwhite);
        }

        .tab {
            background: none;
            border: none;
            border-bottom: 2px solid transparent;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--muted);
            padding: 14px 18px;
            cursor: pointer;
            margin-bottom: -1px;
            transition: all 0.15s;
        }

        .tab:hover {
            color: var(--navy);
        }

        .tab.active {
            color: var(--teal);
            border-bottom-color: var(--teal);
        }

        .tab-body {
            padding: 28px;
        }

        .form-section-title {
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--muted);
            margin-bottom: 14px;
            margin-top: 22px;
        }

        .form-section-title:first-child {
            margin-top: 0;
        }

        .date-grid,
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group.full {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.85rem;
            padding: 10px 14px;
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--navy);
            outline: none;
            background: var(--offwhite);
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 3px rgba(13,148,136,0.12);
            background: white;
        }

        .form-group input[readonly] {
            color: var(--muted);
            cursor: default;
        }

        .form-group textarea {
            resize: vertical;
            min-height: 80px;
        }

        /* ── CHECKBOXES ── */
        .checkbox-group {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-bottom: 20px;
        }

        .checkbox-label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
            color: var(--navy);
            background: var(--offwhite);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 10px 14px;
            cursor: pointer;
            transition: all 0.15s;
        }

        .checkbox-label:hover {
            border-color: var(--teal);
            background: var(--teal-light);
        }

        .checkbox-label input[type="checkbox"] {
            accent-color: var(--teal);
            width: 15px;
            height: 15px;
        }

        /* ── BARCODE ── */
        .barcode-info {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.78rem;
            color: var(--muted);
            background: var(--offwhite);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 10px 14px;
            margin-bottom: 14px;
        }

        .barcode-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--teal);
            flex-shrink: 0;
        }

        .barcode-row {
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            gap: 12px;
            align-items: end;
            margin-bottom: 20px;
        }

        /* ── BUTTONS ── */
        .btn-row {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--teal);
            color: white;
        }

        .btn-primary:hover {
            background: #0b7a70;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(13,148,136,0.3);
        }

        .btn-outline {
            background: white;
            color: var(--navy);
            border: 1px solid var(--border);
        }

        .btn-outline:hover {
            background: var(--offwhite);
            border-color: var(--teal);
            color: var(--teal);
        }

        /* ── TABLE ── */
        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead tr {
            background: var(--offwhite);
            border-bottom: 2px solid var(--border);
        }

        thead th {
            padding: 12px 16px;
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            text-align: left;
            white-space: nowrap;
        }

        tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background 0.15s;
        }

        tbody tr:last-child {
            border-bottom: none;
        }

        tbody tr:hover {
            background: var(--offwhite);
        }

        tbody td {
            padding: 14px 16px;
            font-size: 0.84rem;
            color: var(--navy);
            vertical-align: middle;
        }

        .mono {
            font-family: 'Courier New', monospace;
            font-size: 0.8rem;
            color: var(--teal);
            font-weight: 600;
            background: var(--teal-light);
            padding: 3px 7px;
            border-radius: 5px;
        }

        /* ── BADGES ── */
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 100px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .badge-stat { background: #fee2e2; color: var(--red); }
        .badge-urgent { background: #fef3c7; color: var(--amber); }
        .badge-routine { background: var(--offwhite); color: var(--muted); }
        .badge-verified,
        .badge-completed { background: #dcfce7; color: var(--green); }
        .badge-inprogress,
        .badge-released { background: #dbeafe; color: #1d4ed8; }
        .badge-submitted { background: #f0fdf4; color: #15803d; }
        .badge-received { background: #fef3c7; color: var(--amber); }
        .badge-cancelled { background: #fee2e2; color: var(--red); }

        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .topbar { padding: 0 20px; }
            .user-email { display: none; }
            .sidebar { display: none; }
            .main { padding: 20px 16px; }
            .hero { padding: 24px 20px; }
            .date-grid, .form-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<!-- TOPBAR -->
<div class="topbar">
    <a class="brand" asp-controller="Home" asp-action="Index">
        <div class="brand-logo">
            <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
        </div>
        <div class="brand-name">
            NMB-HLabSys
            <span>Haematology Lab System</span>
        </div>
    </a>
    <div class="topbar-right">
        <div class="user-chip">
            <div class="user-avatar">@((string.IsNullOrEmpty(ViewBag.Email as string) ? "D" : ((string)ViewBag.Email).Substring(0, 1).ToUpper()))</div>
            <span class="user-email">@(ViewBag.Email ?? "Doctor")</span>
        </div>
        <a asp-controller="Home" asp-action="Logout" class="logout-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
            Sign Out
        </a>
    </div>
</div>

<div class="page">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="nav-section">
            <div class="nav-label">Main</div>
            <a asp-controller="Doctor" asp-action="DoctorDashboard" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                Dashboard
            </a>
            <a asp-controller="Doctor" asp-action="TestRequests" class="nav-item active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                Test Requests
            </a>
            <a asp-controller="Doctor" asp-action="ViewResults" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                View Results
            </a>
            <a asp-controller="Doctor" asp-action="PatientRecords" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                Patient Records
            </a>
            <a asp-controller="Doctor" asp-action="Reports" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" /></svg>
                Reports
            </a>
            <a asp-controller="Doctor" asp-action="Alerts" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                Alerts
            </a>
        </div>
        <div class="nav-section">
            <div class="nav-label">Account</div>
            <a asp-controller="Doctor" asp-action="Profile" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                My Profile
            </a>
        </div>
        <div class="nav-section">
            <div class="nav-label">Support</div>
            <a href="#" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                Help
            </a>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main">

        <!-- HERO -->
        <div class="hero">
            <div class="hero-content">
                <div class="hero-tag">Doctor Portal</div>
                <h1>Test <span>Requests</span></h1>
                <p>Submit and track laboratory test requests for your patients.</p>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="report-box" style="border-color:var(--green);color:var(--green);padding:16px 24px;margin-bottom:16px;">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="report-box" style="border-color:var(--red);color:var(--red);padding:16px 24px;margin-bottom:16px;">@TempData["Error"]</div>
        }

        <div class="section-header">
            <h2 class="section-title">Test Requests</h2>
        </div>

        <div class="report-box">
            <div class="tabs">
                <button class="tab active" onclick="switchTab('new')">New Request</button>
                <button class="tab" onclick="switchTab('history')">Request History</button>
            </div>

            <!-- New Request Tab -->
            <div id="tab-new" class="tab-body">
                <form method="post" asp-controller="Doctor" asp-action="SubmitTestRequest">
                    @Html.AntiForgeryToken()
                    <div class="form-section-title">Patient &amp; Urgency</div>
                    <div class="form-grid" style="margin-bottom: 4px;">
                        <div class="form-group">
                            <label>Patient</label>
                            <select name="PatientID" required>
                                <option value="">Select patient…</option>
                                @foreach (var p in Model.Patients)
                                {
                                    <option value="@p.PatientID">@p.FullName (@p.IDNumber)</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Urgency</label>
                            <select name="Urgency">
                                <option>Routine</option>
                                <option>Urgent</option>
                                <option>STAT</option>
                            </select>
                        </div>
                        <div class="form-group full">
                            <label>Clinical Notes</label>
                            <textarea name="ClinicalNotes" placeholder="Describe symptoms, reason for tests..."></textarea>
                        </div>
                    </div>

                    <div class="form-section-title">Select Test Types (at least one required)</div>
                    <div class="checkbox-group">
                        @if (Model.TestTypes.Count == 0)
                        {
                            <span style="color:var(--muted);font-size:0.78rem;">
                                No test types are configured yet — see the TestTypes table.
                            </span>
                        }
                        @foreach (var t in Model.TestTypes)
                        {
                            <label class="checkbox-label">
                                <input type="checkbox" name="TestTypeIDs" value="@t.TestTypeID" onchange="refreshRequiredSamples()" /> @t.TestName
                            </label>
                        }
                    </div>
                    <div id="required-samples-hint" class="barcode-info" style="display:none;">
                        <div class="barcode-dot"></div>
                        <span id="required-samples-text"></span>
                    </div>

                    <div class="form-section-title">Sample Barcodes (at least one required)</div>
                    <div class="barcode-info">
                        <div class="barcode-dot"></div>
                        Record one barcode per sample collected, and the sample type it was collected into.
                    </div>
                    <div id="barcode-list">
                        <div class="barcode-row">
                            <div class="form-group">
                                <label>Barcode</label>
                                <input type="text" name="Samples[0].BarcodeNumber" placeholder="e.g. BC-2025-03-0441" />
                            </div>
                            <div class="form-group">
                                <label>Sample Type</label>
                                <select name="Samples[0].SampleTypeID">
                                    <option value="">Select…</option>
                                    @foreach (var st in Model.SampleTypes)
                                    {
                                        <option value="@st.SampleTypeID">@st.SampleTypeName</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="btn-row" style="margin-bottom:20px;">
                        <button type="button" class="btn btn-outline" onclick="addBarcodeRow()">+ Add Sample</button>
                    </div>

                    <div class="btn-row">
                        <button type="submit" class="btn btn-primary">Submit Request</button>
                    </div>
                </form>
            </div>

            <!-- History Tab -->
            <div id="tab-history" class="tab-body" style="display:none; padding: 0;">
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Request #</th>
                                <th>Patient</th>
                                <th>Date</th>
                                <th>Urgency</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (history.Count == 0)
                            {
                                <tr><td colspan="6" style="text-align:center;color:var(--muted);">No test requests yet.</td></tr>
                            }
                            @foreach (var r in history)
                            {
                                var badgeClass = r.Urgency switch
                                {
                                    "STAT" => "badge-stat",
                                    "Urgent" => "badge-urgent",
                                    _ => "badge-routine"
                                };
                                var statusClass = r.RequestStatus switch
                                {
                                    Doctor.Models.TestRequestStatus.Submitted => "badge-submitted",
                                    Doctor.Models.TestRequestStatus.SamplesReceived => "badge-received",
                                    Doctor.Models.TestRequestStatus.InProgress => "badge-inprogress",
                                    Doctor.Models.TestRequestStatus.Completed => "badge-completed",
                                    Doctor.Models.TestRequestStatus.ReleasedByDoctor => "badge-released",
                                    Doctor.Models.TestRequestStatus.Cancelled => "badge-cancelled",
                                    _ => "badge-routine"
                                };
                                <tr>
                                    <td><span class="mono">@r.RequestNumber</span></td>
                                    <td>@r.PatientName</td>
                                    <td>@r.RequestDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge @badgeClass">@r.Urgency</span></td>
                                    <td><span class="badge @statusClass">@r.RequestStatus</span></td>
                                    <td>
                                        @if (r.CanCancel)
                                        {
                                            <form method="post" asp-controller="Doctor" asp-action="CancelTestRequest" onsubmit="return promptCancelReason(this)">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="RequestID" value="@r.RequestID" />
                                                <input type="hidden" name="Reason" class="cancel-reason-input" />
                                                <button type="submit" class="btn btn-outline" style="padding:5px 12px;font-size:0.75rem;">Cancel</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </main>
</div>

<script>
    function switchTab(tab) {
        document.getElementById('tab-new').style.display = tab === 'new' ? 'block' : 'none';
        document.getElementById('tab-history').style.display = tab === 'history' ? 'block' : 'none';
        document.querySelectorAll('.tab').forEach((t, i) => {
            t.classList.toggle('active', (tab === 'new' && i === 0) || (tab === 'history' && i === 1));
        });
    }

    const sampleTypeOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.SampleTypes.Select(s => new { s.SampleTypeID, s.SampleTypeName })));
    let barcodeRowCount = 1;

    function addBarcodeRow() {
        const list = document.getElementById('barcode-list');
        const row = document.createElement('div');
        row.className = 'barcode-row';
        const idx = barcodeRowCount++;
        let options = '<option value="">Select…</option>' +
            sampleTypeOptions.map(st => `<option value="${st.SampleTypeID}">${st.SampleTypeName}</option>`).join('');
        row.innerHTML =
            '<div class="form-group"><label>Barcode</label>' +
            `<input type="text" name="Samples[${idx}].BarcodeNumber" placeholder="e.g. BC-2025-03-0442" /></div>` +
            '<div class="form-group"><label>Sample Type</label>' +
            `<select name="Samples[${idx}].SampleTypeID">${options}</select></div>`;
        list.appendChild(row);
    }

    function refreshRequiredSamples() {
        const ids = Array.from(document.querySelectorAll('input[name="TestTypeIDs"]:checked')).map(cb => cb.value);
        const hint = document.getElementById('required-samples-hint');
        const text = document.getElementById('required-samples-text');
        if (ids.length === 0) { hint.style.display = 'none'; return; }

        const qs = ids.map(id => 'testTypeIds=' + encodeURIComponent(id)).join('&');
        fetch('@Url.Action("RequiredSamples", "Doctor")?' + qs)
            .then(r => r.ok ? r.json() : [])
            .then(samples => {
                if (!samples || samples.length === 0) { hint.style.display = 'none'; return; }
                text.textContent = 'Required sample type(s) for the selected tests: ' +
                    samples.map(s => s.sampleTypeName).join(', ');
                hint.style.display = 'flex';
            })
            .catch(() => { hint.style.display = 'none'; });
    }

    function promptCancelReason(form) {
        const reason = prompt('Reason for cancelling this test request:');
        if (!reason) return false;
        form.querySelector('.cancel-reason-input').value = reason;
        return true;
    }
</script>

</body>
</html>
