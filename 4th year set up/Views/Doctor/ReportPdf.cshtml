@model Doctor.Models.DoctorReportViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <style>
        body { font-family: 'DM Sans', Arial, sans-serif; color: #0b1f3a; padding: 30px; }
        h1 { font-size: 20px; margin-bottom: 4px; }
        .muted { color: #6b7a99; font-size: 12px; margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; font-size: 12px; }
        th, td { border-bottom: 1px solid #dde4f0; padding: 8px; text-align: left; }
    </style>
</head>
<body>
    <h1>NMB-HLabSys — Doctor Report</h1>
    <div class="muted">
        Dr. @Model.DoctorName · @Model.FromDate.ToString("yyyy-MM-dd") to @Model.ToDate.ToString("yyyy-MM-dd")
        · @Model.Requests.Count request(s)
    </div>
    <table>
        <thead>
            <tr><th>Request #</th><th>Patient</th><th>Date</th><th>Urgency</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Requests)
            {
                <tr>
                    <td>@r.RequestNumber</td>
                    <td>@r.PatientName</td>
                    <td>@r.RequestDate.ToString("yyyy-MM-dd")</td>
                    <td>@r.Urgency</td>
                    <td>@r.RequestStatus</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
