@model Patient.Models.TestRequest
@using Patient.Models
@{
    ViewData["Title"] = "Shared Test Request";
    Layout = null;
    var p = ViewBag.Patient as ProfileViewModel;
    var patientName = p == null ? "Patient" : $"{p.FirstName} {p.LastName}".Trim();
    bool released = Model.RequestStatus == "Released";

    string Num(decimal? v) => v.HasValue ? v.Value.ToString("0.##") : "—";
    string Range(TestRequestItem i) =>
        i.NormalRangeMin.HasValue && i.NormalRangeMax.HasValue ? $"{Num(i.NormalRangeMin)} – {Num(i.NormalRangeMax)}" :
        i.NormalRangeMax.HasValue ? $"≤ {Num(i.NormalRangeMax)}" :
        i.NormalRangeMin.HasValue ? $"≥ {Num(i.NormalRangeMin)}" : "—";
    string Flag(TestRequestItem i) =>
        i.ResultValue.HasValue && i.NormalRangeMax.HasValue && i.ResultValue > i.NormalRangeMax ? "High" :
        i.ResultValue.HasValue && i.NormalRangeMin.HasValue && i.ResultValue < i.NormalRangeMin ? "Low" :
        i.IsAbnormal ? "Abnormal" : "";

    var byCategory = Model.Items
        .GroupBy(i => string.IsNullOrWhiteSpace(i.CategoryName) ? "Other" : i.CategoryName)
        .OrderBy(g => g.Key)
        .ToList();
    var outCount = Model.Items.Count(i => Flag(i) != "");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.RequestNumber — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy: #0b1f3a;
            --teal: #0d9488;
            --teal-light: rgba(13,148,136,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
            --amber: #d97706;
        }

        body { font-family: 'DM Sans', sans-serif; background: var(--offwhite); color: var(--navy); min-height: 100vh; }

        .topbar { background: var(--navy); padding: 0 40px; display: flex; align-items: center; justify-content: space-between; height: 64px; position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 20px rgba(0,0,0,0.15); }
        .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
        .brand-logo { width: 34px; height: 34px; background: var(--teal); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
        .brand-logo svg { width: 18px; height: 18px; fill: white; }
        .brand-name { font-family: 'DM Serif Display', serif; font-size: 1.05rem; color: white; }
        .brand-name span { display: block; font-family: 'DM Sans', sans-serif; font-size: 0.6rem; font-weight: 300; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.08em; }
        .topbar-right { display: flex; align-items: center; gap: 16px; }
        .user-chip { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.8); font-size: 13px; }
        .user-avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--teal); color: white; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 13px; }
        .logout-btn { display: flex; align-items: center; gap: 6px; color: rgba(255,255,255,0.7); text-decoration: none; font-size: 13px; border: 1px solid rgba(255,255,255,0.2); padding: 6px 12px; border-radius: 6px; }
        .logout-btn:hover { color: white; border-color: rgba(255,255,255,0.4); }
        .logout-btn svg { width: 15px; height: 15px; }

        .main { max-width: 1000px; margin: 0 auto; padding: 32px 24px 60px; }
        .back { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); text-decoration: none; font-size: 13px; margin-bottom: 18px; }
        .back:hover { color: var(--teal); }

        .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; margin-bottom: 22px; }
        .eyebrow { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--teal); font-weight: 600; margin-bottom: 4px; }
        h1 { font-family: 'DM Serif Display', serif; font-size: 1.9rem; font-weight: 400; }
        .sub { color: var(--muted); font-size: 13.5px; margin-top: 4px; }

        .badge { display: inline-block; padding: 4px 12px; border-radius: 100px; font-size: 12px; font-weight: 600; }
        .badge.released { background: rgba(22,163,74,0.1); color: var(--green); }
        .badge.pending { background: rgba(217,119,6,0.1); color: var(--amber); }
        .badge.cancelled { background: rgba(220,38,38,0.08); color: var(--red); }

        .info { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 22px; }
        .info > div { background: var(--white); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; }
        .info .k { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
        .info .v { font-weight: 600; font-size: 14px; margin-top: 3px; }
        .info .v.red { color: var(--red); }

        .notice { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; border-radius: 10px; padding: 12px 16px; font-size: 13px; margin-bottom: 20px; }
        .shared-note { background: var(--teal-light); color: #0b5e57; border-radius: 10px; padding: 10px 16px; font-size: 12.5px; margin-bottom: 20px; }

        .card { background: var(--white); border: 1px solid var(--border); border-radius: 14px; margin-bottom: 18px; overflow: hidden; }
        .card h2 { font-size: 14px; padding: 12px 18px; background: #f8fafc; border-bottom: 1px solid var(--border); }
        .card h2 span { font-weight: 400; color: var(--muted); font-size: 12px; }
        table { width: 100%; border-collapse: collapse; min-width: 520px; }
        th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); padding: 10px 18px; border-bottom: 1px solid var(--border); font-weight: 600; }
        td { padding: 11px 18px; border-bottom: 1px solid #eef2f7; font-size: 13.5px; vertical-align: top; }
        tr:last-child td { border-bottom: none; }
        td.num { text-align: right; font-weight: 700; white-space: nowrap; }
        tr.out td.num { color: var(--red); }
        td.unit, td.range { color: var(--muted); white-space: nowrap; }
        .flag { font-size: 11px; font-weight: 700; color: var(--red); background: #fde8e8; padding: 2px 8px; border-radius: 100px; }
        .rnote { font-size: 12px; color: var(--muted); margin-top: 3px; }

        .notes { background: var(--white); border: 1px solid var(--border); border-radius: 14px; padding: 16px 18px; font-size: 13.5px; margin-bottom: 18px; }
        .notes b { display: block; font-size: 12px; color: var(--muted); margin-bottom: 4px; font-weight: 600; }

        @@media (max-width: 760px) {
            .topbar { padding: 0 16px; }
            .user-email { display: none; }
            .main { padding: 22px 16px 48px; }
            .info { grid-template-columns: 1fr 1fr; }
            .card { overflow-x: auto; }
            th, td { padding: 9px 12px; }
        }
    </style>
</head>
<body>

<div class="topbar">
    <a class="brand" asp-controller="Doctor" asp-action="DoctorDashboard">
        <div class="brand-logo">
            <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
        </div>
        <div class="brand-name">NMB-HLabSys <span>Haematology Lab System</span></div>
    </a>
    <div class="topbar-right">
        <div class="user-chip">
            <div class="user-avatar">@((string.IsNullOrEmpty(ViewBag.Email as string) ? "D" : ((string)ViewBag.Email).Substring(0, 1).ToUpper()))</div>
            <span class="user-email">@(ViewBag.Email ?? "Doctor")</span>
        </div>
        <a asp-controller="Home" asp-action="Logout" class="logout-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
            Sign Out
        </a>
    </div>
</div>

<main class="main">
    <a class="back" asp-controller="Doctor" asp-action="PatientRecords">← Back to My Patients</a>

    <div class="head">
        <div>
            <div class="eyebrow">Shared by the patient</div>
            <h1>@Model.RequestNumber</h1>
            <div class="sub">@patientName · requested @Model.RequestDate.ToString("d MMMM yyyy")@(string.IsNullOrEmpty(Model.DoctorName) ? "" : " by Dr " + Model.DoctorName)</div>
        </div>
        <span class="badge @(released ? "released" : Model.RequestStatus == "Cancelled" ? "cancelled" : "pending")">@Model.RequestStatus</span>
    </div>

    <div class="shared-note">
        @patientName chose to share this test request with you on their Consent page. They can withdraw access at any time.
    </div>

    <div class="info">
        <div><div class="k">Patient</div><div class="v">@patientName</div></div>
        <div><div class="k">Urgency</div><div class="v">@(string.IsNullOrEmpty(Model.Urgency) ? "—" : Model.Urgency)</div></div>
        <div><div class="k">Tests</div><div class="v">@Model.Items.Count</div></div>
        <div><div class="k">Outside range</div><div class="v @(outCount > 0 ? "red" : "")">@(released ? outCount.ToString() : "—")</div></div>
    </div>

    @if (!released)
    {
        <div class="notice">
            Results for this request have not been released yet, so only the tests ordered are shown.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ClinicalNotes))
    {
        <div class="notes"><b>Clinical notes</b>@Model.ClinicalNotes</div>
    }

    @if (!Model.Items.Any())
    {
        <div class="notes">No tests are recorded on this request.</div>
    }

    @foreach (var cat in byCategory)
    {
        <div class="card">
            <h2>@cat.Key <span>· @cat.Count() test@(cat.Count() == 1 ? "" : "s")</span></h2>
            <table>
                <thead>
                    <tr>
                        <th>Test</th>
                        <th style="width:14%;text-align:right">Result</th>
                        <th style="width:14%">Unit</th>
                        <th style="width:18%">Normal range</th>
                        <th style="width:12%">Flag</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in cat.OrderBy(i => i.TestName))
                    {
                        var flag = Flag(i);
                        <tr class="@(flag != "" ? "out" : "")">
                            <td>
                                @i.TestName
                                @if (!string.IsNullOrWhiteSpace(i.ResultNotes))
                                {
                                    <div class="rnote">@i.ResultNotes</div>
                                }
                            </td>
                            <td class="num">@(released ? Num(i.ResultValue) : "—")</td>
                            <td class="unit">@i.UnitName</td>
                            <td class="range">@Range(i)</td>
                            <td>@if (flag != "") { <span class="flag">@flag</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (released && !string.IsNullOrWhiteSpace(Model.ReleaseNotes))
    {
        <div class="notes"><b>Release notes@(Model.ReleasedDate.HasValue ? " · " + Model.ReleasedDate.Value.ToString("d MMM yyyy") : "")</b>@Model.ReleaseNotes</div>
    }
</main>

</body>
</html>
