@{
    ViewData["Title"] = "Alerts";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alerts — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy: #0b1f3a;
            --blue: #1a4f8a;
            --teal: #0d9488;
            --teal-light: #e8f5f3;
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --orange: #c2410c;
            --sidebar-width: 240px;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ── TOPNAV ── */
        .topnav {
            position: fixed; top: 0; left: 0; right: 0; z-index: 100;
            background: var(--navy);
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 28px; height: 64px;
            box-shadow: 0 2px 20px rgba(0,0,0,0.25);
        }
        .nav-brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
        .nav-logo {
            width: 36px; height: 36px; background: var(--teal);
            border-radius: 8px; display: flex; align-items: center; justify-content: center;
        }
        .nav-logo svg { width: 20px; height: 20px; fill: white; }
        .nav-title { font-family: 'DM Serif Display', serif; font-size: 1.05rem; color: white; line-height: 1.2; }
        .nav-title span {
            display: block; font-family: 'DM Sans', sans-serif;
            font-size: 0.62rem; font-weight: 300; color: rgba(255,255,255,0.45);
            letter-spacing: 0.08em; text-transform: uppercase;
        }
        .nav-right { display: flex; align-items: center; gap: 14px; }
        .nav-user {
            display: flex; align-items: center; gap: 10px;
            background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12);
            border-radius: 8px; padding: 6px 14px 6px 8px;
        }
        .nav-avatar {
            width: 30px; height: 30px; border-radius: 50%;
            background: var(--teal); display: flex; align-items: center;
            justify-content: center; font-size: 12px; font-weight: 600; color: white;
        }
        .nav-user-info { line-height: 1.3; }
        .nav-user-name { font-size: 13px; font-weight: 500; color: white; }
        .nav-user-role { font-size: 11px; color: rgba(255,255,255,0.45); }
        .btn-signout {
            display: flex; align-items: center; gap: 7px;
            background: transparent; border: 1px solid rgba(255,255,255,0.18);
            color: rgba(255,255,255,0.7); font-family: 'DM Sans', sans-serif;
            font-size: 13px; padding: 7px 16px; border-radius: 7px;
            cursor: pointer; text-decoration: none; transition: all 0.2s;
        }
        .btn-signout:hover { background: rgba(255,255,255,0.08); color: white; }
        .btn-signout svg { width: 14px; height: 14px; }

        /* ── LAYOUT ── */
        .app-body { display: flex; padding-top: 64px; min-height: 100vh; }

        .sidebar {
            width: var(--sidebar-width); background: var(--white);
            border-right: 1px solid var(--border);
            position: fixed; top: 64px; bottom: 0; left: 0;
            overflow-y: auto; display: flex; flex-direction: column;
            padding: 24px 0 20px;
        }
        .sidebar-section {
            font-size: 10px; font-weight: 600; text-transform: uppercase;
            letter-spacing: 0.1em; color: var(--muted);
            padding: 0 20px; margin: 20px 0 8px;
        }
        .sidebar-section:first-child { margin-top: 0; }
        .nav-item {
            display: flex; align-items: center; gap: 10px;
            padding: 9px 20px; font-size: 13.5px; font-weight: 400;
            color: var(--muted); text-decoration: none; transition: all 0.15s;
            border-left: 3px solid transparent;
        }
        .nav-item:hover { background: var(--offwhite); color: var(--navy); }
        .nav-item.active {
            background: var(--teal-light); color: var(--teal);
            border-left-color: var(--teal); font-weight: 500;
        }
        .nav-item svg { width: 16px; height: 16px; flex-shrink: 0; }
        .sidebar-bottom { margin-top: auto; border-top: 1px solid var(--border); padding-top: 16px; }
        .nav-item.danger { color: var(--red); }
        .nav-item.danger:hover { background: #fef2f2; }

        .main { margin-left: var(--sidebar-width); flex: 1; padding: 32px 36px; }

        /* ── PAGE HEADER ── */
        .page-header { margin-bottom: 28px; }
        .page-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--teal); margin-bottom: 6px; }
        .page-title { font-family: 'DM Serif Display', serif; font-size: 1.8rem; color: var(--navy); line-height: 1.2; }
        .page-sub { font-size: 13.5px; color: var(--muted); margin-top: 4px; }

        /* ── CARD ── */
        .card {
            background: var(--white); border: 1px solid var(--border);
            border-radius: 14px; overflow: hidden; margin-bottom: 24px;
        }

        /* ── FILTER ROW ── */
        .filter-row {
            display: flex; align-items: flex-end; gap: 14px;
            padding: 18px 24px; border-bottom: 1px solid var(--border);
        }
        .form-group { display: flex; flex-direction: column; gap: 5px; }
        .form-group label {
            font-size: 11px; font-weight: 600; text-transform: uppercase;
            letter-spacing: 0.08em; color: var(--muted);
        }
        .form-group input[type="date"] {
            font-family: 'DM Sans', sans-serif; font-size: 13.5px;
            padding: 8px 12px; border: 1px solid var(--border);
            border-radius: 8px; color: var(--navy); outline: none;
            background: var(--white); transition: border-color 0.2s;
        }
        .form-group input[type="date"]:focus {
            border-color: var(--teal); box-shadow: 0 0 0 3px rgba(13,148,136,0.1);
        }

        /* ── BUTTONS ── */
        .btn {
            display: inline-flex; align-items: center; gap: 6px;
            font-family: 'DM Sans', sans-serif; font-weight: 500;
            border-radius: 8px; cursor: pointer; transition: all 0.2s; text-decoration: none;
        }
        .btn-primary { background: var(--teal); color: white; border: none; }
        .btn-primary:hover { background: #0b7a70; }
        .btn-outline {
            background: transparent; border: 1px solid var(--border); color: var(--navy);
        }
        .btn-outline:hover { border-color: var(--teal); color: var(--teal); background: var(--teal-light); }
        .btn-sm { font-size: 12px; padding: 7px 14px; }

        /* ── TABLE ── */
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th {
            text-align: left; padding: 10px 18px;
            font-size: 11px; font-weight: 600; text-transform: uppercase;
            letter-spacing: 0.06em; color: var(--muted); border-bottom: 1px solid var(--border);
        }
        td {
            padding: 13px 18px; color: var(--navy);
            border-bottom: 1px solid var(--border); vertical-align: middle;
        }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: var(--offwhite); }
        .mono { font-family: monospace; font-size: 12.5px; }
        .result-abnormal { color: #fb923c; font-family: monospace; font-weight: 700; font-size: 13px; }

        /* ── PATIENT CELL WITH ALERT DOT ── */
        .patient-cell { display: flex; align-items: center; gap: 8px; }
        .alert-dot {
            width: 7px; height: 7px; border-radius: 50%;
            background: var(--red); flex-shrink: 0;
        }

        /* ── BADGES ── */
        .badge {
            display: inline-block; padding: 3px 10px;
            border-radius: 100px; font-size: 11px; font-weight: 500;
        }
        .badge-critical { background: #fef2f2; color: var(--red); }
        .badge-urgent   { background: #fff7ed; color: var(--orange); }
        .badge-routine  { background: var(--offwhite); color: var(--muted); }

        /* ── MODAL OVERLAY ── */
        .modal-overlay {
            display: none;
            position: fixed; inset: 0; z-index: 200;
            background: rgba(11, 31, 58, 0.45);
            align-items: center; justify-content: center;
        }
        .modal-overlay.open { display: flex; }

        /* ── MODAL BOX ── */
        .modal {
            background: var(--white); border-radius: 16px;
            border: 1px solid var(--border);
            width: 480px; max-width: 94vw;
            overflow: hidden;
        }
        .modal-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 20px 24px 16px;
            border-bottom: 1px solid var(--border);
        }
        .modal-header-left { display: flex; flex-direction: column; gap: 3px; }
        .modal-label {
            font-size: 10px; font-weight: 600; text-transform: uppercase;
            letter-spacing: 0.1em; color: var(--teal);
        }
        .modal-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem; color: var(--navy); line-height: 1.2;
        }
        .modal-close {
            background: none; border: none; cursor: pointer;
            color: var(--muted); padding: 4px; border-radius: 6px;
            transition: all 0.15s; line-height: 0;
        }
        .modal-close:hover { background: var(--offwhite); color: var(--navy); }
        .modal-close svg { width: 18px; height: 18px; }

        /* ── MODAL BODY ── */
        .modal-body { padding: 20px 24px; }

        .result-banner {
            display: flex; align-items: center; gap: 12px;
            background: #fff7ed; border: 1px solid #fed7aa;
            border-radius: 10px; padding: 14px 16px; margin-bottom: 20px;
        }
        .result-banner-icon {
            width: 36px; height: 36px; background: #fb923c;
            border-radius: 8px; display: flex; align-items: center;
            justify-content: center; flex-shrink: 0;
        }
        .result-banner-icon svg { width: 18px; height: 18px; stroke: white; fill: none; }
        .result-banner-text { line-height: 1.4; }
        .result-banner-value { font-size: 1.1rem; font-weight: 600; color: #c2410c; }
        .result-banner-range { font-size: 12px; color: #9a3412; }

        .detail-grid {
            display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
            margin-bottom: 16px;
        }
        .detail-item { display: flex; flex-direction: column; gap: 3px; }
        .detail-label {
            font-size: 10px; font-weight: 600; text-transform: uppercase;
            letter-spacing: 0.08em; color: var(--muted);
        }
        .detail-value { font-size: 13.5px; color: var(--navy); font-weight: 500; }

        .modal-divider { border: none; border-top: 1px solid var(--border); margin: 16px 0; }

        .modal-footer {
            display: flex; align-items: center; justify-content: flex-end; gap: 10px;
            padding: 14px 24px 20px;
            border-top: 1px solid var(--border);
        }
    </style>
</head>
<body>

<nav class="topnav">
    <a class="nav-brand" href="#">
        <div class="nav-logo">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z"/>
                <circle cx="12" cy="17" r="4" opacity="0.6"/>
            </svg>
        </div>
        <div class="nav-title">NMB-HLabSys <span>Haematology Lab System</span></div>
    </a>
    <div class="nav-right">
        <div class="nav-user">
            <div class="nav-avatar">D</div>
            <div class="nav-user-info">
                <div class="nav-user-name">@ViewBag.Email</div>
                <div class="nav-user-role">Doctor</div>
            </div>
        </div>
        <a asp-controller="Home" asp-action="Logout" class="btn-signout">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            Sign Out
        </a>
    </div>
</nav>

<div class="app-body">
    <aside class="sidebar">
        <div class="sidebar-section">Main</div>
        <a class="nav-item" asp-controller="Doctor" asp-action="DoctorDashboard">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            Dashboard
        </a>
        <a class="nav-item" asp-controller="Doctor" asp-action="PatientRecords">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            My Patients
        </a>
        <a class="nav-item" asp-controller="Doctor" asp-action="TestRequests">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Test Requests
        </a>
        <a class="nav-item" asp-controller="Doctor" asp-action="ViewResults">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            Results
        </a>
        <div class="sidebar-section">System</div>
        <a class="nav-item active" asp-controller="Doctor" asp-action="Alerts">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Activity Log
        </a>
        <div class="sidebar-bottom">
            <a class="nav-item danger" asp-controller="Home" asp-action="Logout">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Sign out
            </a>
        </div>
    </aside>

    <main class="main">
        <div class="page-header">
            <div class="page-label">Doctor Portal</div>
            <h1 class="page-title">Abnormal Result Alerts</h1>
            <p class="page-sub">Abnormal results from the last 5 days</p>
        </div>

        <div class="card">
            <div class="filter-row">
                <div class="form-group">
                    <label>From</label>
                    <input type="date" value="2025-02-26" />
                </div>
                <div class="form-group">
                    <label>To</label>
                    <input type="date" value="2025-03-03" />
                </div>
                <button class="btn btn-primary btn-sm">Filter</button>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Test</th>
                        <th>Result</th>
                        <th>Normal Range</th>
                        <th>Request #</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><div class="patient-cell"><div class="alert-dot"></div>K. Mashamba</div></td>
                        <td>Haemoglobin</td>
                        <td class="result-abnormal">9.2 g/dL</td>
                        <td class="mono">12.0–17.5</td>
                        <td class="mono">REQ-889</td>
                        <td>2025-03-01</td>
                        <td>
                            <button class="btn btn-primary btn-sm"
                                onclick="openModal('K. Mashamba', 'Haemoglobin', '9.2 g/dL', '12.0–17.5 g/dL', 'REQ-889', '2025-03-01', 'Low haemoglobin — possible anaemia. Review iron studies and reticulocyte count.')">
                                View
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td><div class="patient-cell"><div class="alert-dot"></div>K. Mashamba</div></td>
                        <td>Platelet Count</td>
                        <td class="result-abnormal">88 ×10⁹/µL</td>
                        <td class="mono">150–400</td>
                        <td class="mono">REQ-889</td>
                        <td>2025-03-01</td>
                        <td>
                            <button class="btn btn-primary btn-sm"
                                onclick="openModal('K. Mashamba', 'Platelet Count', '88 ×10⁹/µL', '150–400 ×10⁹/µL', 'REQ-889', '2025-03-01', 'Thrombocytopenia detected. Consider peripheral blood film review and clinical correlation.')">
                                View
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td><div class="patient-cell"><div class="alert-dot"></div>P. Ndlovu</div></td>
                        <td>PT (Prothrombin)</td>
                        <td class="result-abnormal">18.2 sec</td>
                        <td class="mono">11–13.5</td>
                        <td class="mono">REQ-890</td>
                        <td>2025-03-02</td>
                        <td>
                            <button class="btn btn-outline btn-sm"
                                onclick="openModal('P. Ndlovu', 'PT (Prothrombin Time)', '18.2 sec', '11–13.5 sec', 'REQ-890', '2025-03-02', 'Prolonged PT. Evaluate for coagulation factor deficiency or anticoagulant therapy effect.')">
                                View
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </main>
</div>

<!-- ── RESULT DETAIL MODAL ── -->
<div class="modal-overlay" id="resultModal" onclick="handleOverlayClick(event)">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-header-left">
                <div class="modal-label">Abnormal Result</div>
                <div class="modal-title" id="modal-test-name">—</div>
            </div>
            <button class="modal-close" onclick="closeModal()" aria-label="Close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>

        <div class="modal-body">
            <!-- Abnormal value banner -->
            <div class="result-banner">
                <div class="result-banner-icon">
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                        <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                </div>
                <div class="result-banner-text">
                    <div class="result-banner-value" id="modal-result-value">—</div>
                    <div class="result-banner-range">Normal range: <span id="modal-normal-range">—</span></div>
                </div>
            </div>

            <!-- Detail fields -->
            <div class="detail-grid">
                <div class="detail-item">
                    <div class="detail-label">Patient</div>
                    <div class="detail-value" id="modal-patient">—</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Request #</div>
                    <div class="detail-value" id="modal-request" style="font-family: monospace; font-size: 13px;">—</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Date</div>
                    <div class="detail-value" id="modal-date">—</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Status</div>
                    <div class="detail-value"><span class="badge badge-critical">Abnormal</span></div>
                </div>
            </div>

            <hr class="modal-divider" />

            <div class="detail-item">
                <div class="detail-label">Clinical Note</div>
                <div class="detail-value" id="modal-note" style="font-weight: 400; font-size: 13px; line-height: 1.6; color: #374151; margin-top: 4px;">—</div>
            </div>
        </div>

        <div class="modal-footer">
            <button class="btn btn-outline btn-sm" onclick="closeModal()">Close</button>
            <a class="btn btn-primary btn-sm" asp-controller="Doctor" asp-action="ViewResults">
                View Full Results
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="width:13px;height:13px;">
                    <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                </svg>
            </a>
        </div>
    </div>
</div>

<script>
    function openModal(patient, test, result, range, reqNum, date, note) {
        document.getElementById('modal-test-name').textContent   = test;
        document.getElementById('modal-result-value').textContent = result;
        document.getElementById('modal-normal-range').textContent = range;
        document.getElementById('modal-patient').textContent     = patient;
        document.getElementById('modal-request').textContent     = reqNum;
        document.getElementById('modal-date').textContent        = date;
        document.getElementById('modal-note').textContent        = note;
        document.getElementById('resultModal').classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        document.getElementById('resultModal').classList.remove('open');
        document.body.style.overflow = '';
    }

    function handleOverlayClick(e) {
        if (e.target === document.getElementById('resultModal')) closeModal();
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeModal();
    });
</script>

</body>
</html>
