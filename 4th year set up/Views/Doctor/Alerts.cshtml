@model Doctor.Models.AlertsPageViewModel
@{
    ViewData["Title"] = "Alerts";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alerts — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --teal: #0d9488;
            --teal-light: rgba(13,148,136,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
            --amber: #d97706;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
        }

        /* ── TOPBAR ── */
        .topbar {
            background: var(--navy);
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-logo {
            width: 34px;
            height: 34px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .brand-logo svg {
            width: 18px;
            height: 18px;
            fill: white;
        }

        .brand-name {
            font-family: 'DM Serif Display', serif;
            color: white;
            font-size: 1.1rem;
            line-height: 1.1;
        }

        .brand-name span {
            display: block;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.6rem;
            font-weight: 300;
            color: rgba(255,255,255,0.4);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 6px 14px 6px 8px;
        }

        .user-avatar {
            width: 28px;
            height: 28px;
            background: var(--teal);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
        }

        .user-email {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.75);
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .logout-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.8);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .logout-btn:hover {
            background: rgba(255,255,255,0.15);
            color: white;
        }

        .logout-btn svg {
            width: 14px;
            height: 14px;
        }

        /* ── LAYOUT ── */
        .page {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 220px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 24px 0;
            flex-shrink: 0;
            position: sticky;
            top: 64px;
            height: calc(100vh - 64px);
            overflow-y: auto;
        }

        .nav-section {
            margin-bottom: 8px;
        }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 20px;
            margin-bottom: 4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.15s;
            border-left: 3px solid transparent;
        }

        .nav-item:hover {
            background: var(--offwhite);
            color: var(--navy);
        }

        .nav-item.active {
            background: var(--teal-light);
            color: var(--teal);
            border-left-color: var(--teal);
        }

        .nav-item svg {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }

        /* ── MAIN ── */
        .main {
            flex: 1;
            padding: clamp(24px, 3vw, 40px);
            overflow-y: auto;
        }

        /* ── HERO ── */
        .hero {
            background: var(--navy);
            border-radius: 20px;
            padding: 32px 36px;
            margin-bottom: 32px;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 60% 80% at 90% 50%, rgba(13,148,136,0.2) 0%, transparent 60%);
        }

        .hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(13,148,136,0.15);
            border: 1px solid rgba(13,148,136,0.3);
            color: #5eead4;
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 100px;
            margin-bottom: 14px;
        }

        .hero-tag::before {
            content: '';
            width: 5px;
            height: 5px;
            background: #5eead4;
            border-radius: 50%;
        }

        .hero h1 {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.5rem, 2.5vw, 2.2rem);
            color: white;
            margin-bottom: 8px;
            line-height: 1.2;
        }

        .hero h1 span {
            color: #5eead4;
            font-style: italic;
        }

        .hero p {
            color: rgba(255,255,255,0.5);
            font-size: 0.88rem;
            font-weight: 300;
        }

        /* ── CARD ── */
        .card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
            margin-bottom: 24px;
        }

        /* ── FILTER ROW ── */
        .filter-row {
            display: flex;
            align-items: flex-end;
            gap: 14px;
            padding: 20px 24px;
            border-bottom: 1px solid var(--border);
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group label {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .form-group input[type="date"] {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.85rem;
            padding: 9px 14px;
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--navy);
            outline: none;
            background: white;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-group input[type="date"]:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 3px rgba(13,148,136,0.12);
        }

        /* ── BUTTONS ── */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--teal);
            color: white;
        }

        .btn-primary:hover {
            background: #0b7a70;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(13,148,136,0.3);
        }

        .btn-outline {
            background: white;
            color: var(--navy);
            border: 1px solid var(--border);
        }

        .btn-outline:hover {
            background: var(--offwhite);
            border-color: var(--teal);
            color: var(--teal);
        }

        .btn-sm {
            padding: 7px 14px;
            font-size: 0.78rem;
        }

        /* ── TABLE ── */
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.84rem;
        }

        th {
            text-align: left;
            padding: 12px 24px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--muted);
            border-bottom: 1px solid var(--border);
        }

        td {
            padding: 14px 24px;
            color: var(--navy);
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background: var(--offwhite);
        }

        .mono {
            font-family: 'Courier New', monospace;
            font-size: 0.78rem;
        }

        .result-abnormal {
            color: var(--red);
            font-family: 'Courier New', monospace;
            font-weight: 700;
            font-size: 0.84rem;
        }

        /* ── PATIENT CELL WITH ALERT DOT ── */
        .patient-cell {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .alert-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--red);
            flex-shrink: 0;
        }

        /* ── MODAL OVERLAY ── */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 200;
            background: rgba(11, 31, 58, 0.45);
            align-items: center;
            justify-content: center;
        }

        .modal-overlay.open {
            display: flex;
        }

        /* ── MODAL BOX ── */
        .modal {
            background: white;
            border-radius: 16px;
            border: 1px solid var(--border);
            width: 480px;
            max-width: 94vw;
            overflow: hidden;
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 24px 16px;
            border-bottom: 1px solid var(--border);
        }

        .modal-header-left {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .modal-label {
            font-size: 0.65rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--teal);
        }

        .modal-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            color: var(--navy);
            line-height: 1.2;
        }

        .modal-close {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--muted);
            padding: 4px;
            border-radius: 6px;
            transition: all 0.15s;
            line-height: 0;
        }

        .modal-close:hover {
            background: var(--offwhite);
            color: var(--navy);
        }

        .modal-close svg {
            width: 18px;
            height: 18px;
        }

        /* ── MODAL BODY ── */
        .modal-body {
            padding: 20px 24px;
        }

        .result-banner {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #fff7ed;
            border: 1px solid #fed7aa;
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 20px;
        }

        .result-banner-icon {
            width: 36px;
            height: 36px;
            background: #fb923c;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .result-banner-icon svg {
            width: 18px;
            height: 18px;
            stroke: white;
            fill: none;
        }

        .result-banner-text {
            line-height: 1.4;
        }

        .result-banner-value {
            font-size: 1.1rem;
            font-weight: 600;
            color: #c2410c;
        }

        .result-banner-range {
            font-size: 0.75rem;
            color: #9a3412;
        }

        .detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 16px;
        }

        .detail-item {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .detail-label {
            font-size: 0.65rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--muted);
        }

        .detail-value {
            font-size: 0.84rem;
            color: var(--navy);
            font-weight: 500;
        }

        .modal-divider {
            border: none;
            border-top: 1px solid var(--border);
            margin: 16px 0;
        }

        .modal-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            padding: 14px 24px 20px;
            border-top: 1px solid var(--border);
        }

        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .topbar { padding: 0 20px; }
            .user-email { display: none; }
            .sidebar { display: none; }
            .main { padding: 20px 16px; }
            .hero { padding: 24px 20px; }
        }
    </style>
</head>
<body>

<!-- TOPBAR -->
<div class="topbar">
    <a class="brand" asp-controller="Home" asp-action="Index">
        <div class="brand-logo">
            <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
        </div>
        <div class="brand-name">
            NMB-HLabSys
            <span>Haematology Lab System</span>
        </div>
    </a>
    <div class="topbar-right">
        <div class="user-chip">
            <div class="user-avatar">@((string.IsNullOrEmpty(ViewBag.Email as string) ? "D" : ((string)ViewBag.Email).Substring(0, 1).ToUpper()))</div>
            <span class="user-email">@(ViewBag.Email ?? "Doctor")</span>
        </div>
        <a asp-controller="Home" asp-action="Logout" class="logout-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
            Sign Out
        </a>
    </div>
</div>

<div class="page">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="nav-section">
            <div class="nav-label">Main</div>
            <a asp-controller="Doctor" asp-action="DoctorDashboard" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                Dashboard
            </a>
            <a asp-controller="Doctor" asp-action="TestRequests" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                Test Requests
            </a>
            <a asp-controller="Doctor" asp-action="ViewResults" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                View Results
            </a>
            <a asp-controller="Doctor" asp-action="PatientRecords" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                Patient Records
            </a>
            <a asp-controller="Doctor" asp-action="Reports" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" /></svg>
                Reports
            </a>
            <a asp-controller="Doctor" asp-action="Alerts" class="nav-item active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                Alerts
            </a>
        </div>
        <div class="nav-section">
            <div class="nav-label">Account</div>
            <a asp-controller="Doctor" asp-action="Profile" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                My Profile
            </a>
        </div>
        <div class="nav-section">
            <div class="nav-label">Support</div>
            <a href="#" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                Help
            </a>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main">

        <!-- HERO -->
        <div class="hero">
            <div class="hero-content">
                <div class="hero-tag">Doctor Portal</div>
                <h1>Abnormal <span>Alerts</span></h1>
                <p>Abnormal results from the last 5 days.</p>
            </div>
        </div>

        <div class="card">
            <form class="filter-row" method="get" asp-controller="Doctor" asp-action="Alerts">
                <div class="form-group">
                    <label>From</label>
                    <input type="date" name="from" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-group">
                    <label>To</label>
                    <input type="date" name="to" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                </div>
                <button type="submit" class="btn btn-primary btn-sm">Filter</button>
            </form>

            <table>
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Test</th>
                        <th>Result</th>
                        <th>Normal Range</th>
                        <th>Request #</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Alerts.Count == 0)
                    {
                        <tr><td colspan="7" style="text-align:center;color:var(--muted);">No abnormal results in this date range.</td></tr>
                    }
                    @foreach (var a in Model.Alerts)
                    {
                        var range = $"{a.NormalRangeMin}–{a.NormalRangeMax} {a.UnitName}";
                        var result = $"{a.ResultValue} {a.UnitName}";
                        <tr>
                            <td><div class="patient-cell"><div class="alert-dot"></div>@a.PatientName</div></td>
                            <td>@a.TestName</td>
                            <td class="result-abnormal">@result</td>
                            <td class="mono">@range</td>
                            <td class="mono">@a.RequestNumber</td>
                            <td>@a.RequestDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <button class="btn btn-primary btn-sm"
                                    onclick="openModal('@a.PatientName', '@a.TestName', '@result', '@range', '@a.RequestNumber', '@a.RequestDate.ToString("yyyy-MM-dd")', '@Html.Raw(a.ResultNotes)')">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>

<!-- ── RESULT DETAIL MODAL ── -->
<div class="modal-overlay" id="resultModal" onclick="handleOverlayClick(event)">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-header-left">
                <div class="modal-label">Abnormal Result</div>
                <div class="modal-title" id="modal-test-name">—</div>
            </div>
            <button class="modal-close" onclick="closeModal()" aria-label="Close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>

        <div class="modal-body">
            <!-- Abnormal value banner -->
            <div class="result-banner">
                <div class="result-banner-icon">
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                        <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                </div>
                <div class="result-banner-text">
                    <div class="result-banner-value" id="modal-result-value">—</div>
                    <div class="result-banner-range">Normal range: <span id="modal-normal-range">—</span></div>
                </div>
            </div>

            <!-- Detail fields -->
            <div class="detail-grid">
                <div class="detail-item">
                    <div class="detail-label">Patient</div>
                    <div class="detail-value" id="modal-patient">—</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Request #</div>
                    <div class="detail-value mono" id="modal-request">—</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Date</div>
                    <div class="detail-value" id="modal-date">—</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Status</div>
                    <div class="detail-value"><span class="badge badge-stat">Abnormal</span></div>
                </div>
            </div>

            <hr class="modal-divider" />

            <div class="detail-item">
                <div class="detail-label">Clinical Note</div>
                <div class="detail-value" id="modal-note" style="font-weight: 400; font-size: 0.82rem; line-height: 1.6; color: #374151; margin-top: 4px;">—</div>
            </div>
        </div>

        <div class="modal-footer">
            <button class="btn btn-outline btn-sm" onclick="closeModal()">Close</button>
            <a class="btn btn-primary btn-sm" asp-controller="Doctor" asp-action="ViewResults">
                View Full Results
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="width:13px;height:13px;">
                    <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                </svg>
            </a>
        </div>
    </div>
</div>

<script>
    function openModal(patient, test, result, range, reqNum, date, note) {
        document.getElementById('modal-test-name').textContent   = test;
        document.getElementById('modal-result-value').textContent = result;
        document.getElementById('modal-normal-range').textContent = range;
        document.getElementById('modal-patient').textContent     = patient;
        document.getElementById('modal-request').textContent     = reqNum;
        document.getElementById('modal-date').textContent        = date;
        document.getElementById('modal-note').textContent        = note;
        document.getElementById('resultModal').classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        document.getElementById('resultModal').classList.remove('open');
        document.body.style.overflow = '';
    }

    function handleOverlayClick(e) {
        if (e.target === document.getElementById('resultModal')) closeModal();
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeModal();
    });
</script>

</body>
</html>
