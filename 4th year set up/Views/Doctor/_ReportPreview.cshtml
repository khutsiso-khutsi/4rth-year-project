@model List<Doctor.Models.DoctorTestRequestSummary>
<table style="width:100%;border-collapse:collapse;font-size:0.84rem;">
    <thead>
        <tr><th>Request #</th><th>Patient</th><th>Date</th><th>Status</th></tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.RequestNumber</td>
                <td>@r.PatientName</td>
                <td>@r.RequestDate.ToString("yyyy-MM-dd")</td>
                <td>@r.RequestStatus</td>
            </tr>
        }
    </tbody>
</table>
