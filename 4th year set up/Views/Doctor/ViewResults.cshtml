    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Test Results — NMB-HLabSys</title>
        <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
        <style>
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --navy: #0b1f3a;
                --blue: #1a4f8a;
                --teal: #0d9488;
                --teal-light: #e8f5f3;
                --white: #ffffff;
                --offwhite: #f4f7fb;
                --muted: #6b7a99;
                --border: #dde4f0;
                --red: #dc2626;
                --sidebar-width: 240px;
            }

            body {
                font-family: 'DM Sans', sans-serif;
                background: var(--offwhite);
                color: var(--navy);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* ── TOPNAV ── */
            .topnav {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 100;
                background: var(--navy);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 28px;
                height: 64px;
                box-shadow: 0 2px 20px rgba(0,0,0,0.25);
            }

            .nav-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
            }

            .nav-logo {
                width: 36px;
                height: 36px;
                background: var(--teal);
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .nav-logo svg {
                    width: 20px;
                    height: 20px;
                    fill: white;
                }

            .nav-title {
                font-family: 'DM Serif Display', serif;
                font-size: 1.05rem;
                color: white;
                line-height: 1.2;
            }

                .nav-title span {
                    display: block;
                    font-family: 'DM Sans', sans-serif;
                    font-size: 0.62rem;
                    font-weight: 300;
                    color: rgba(255,255,255,0.45);
                    letter-spacing: 0.08em;
                    text-transform: uppercase;
                }

            .nav-right {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .nav-user {
                display: flex;
                align-items: center;
                gap: 10px;
                background: rgba(255,255,255,0.07);
                border: 1px solid rgba(255,255,255,0.12);
                border-radius: 8px;
                padding: 6px 14px 6px 8px;
            }

            .nav-avatar {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: var(--teal);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
                font-weight: 600;
                color: white;
            }

            .nav-user-info {
                line-height: 1.3;
            }

            .nav-user-name {
                font-size: 13px;
                font-weight: 500;
                color: white;
            }

            .nav-user-role {
                font-size: 11px;
                color: rgba(255,255,255,0.45);
            }

            .btn-signout {
                display: flex;
                align-items: center;
                gap: 7px;
                background: transparent;
                border: 1px solid rgba(255,255,255,0.18);
                color: rgba(255,255,255,0.7);
                font-family: 'DM Sans', sans-serif;
                font-size: 13px;
                padding: 7px 16px;
                border-radius: 7px;
                cursor: pointer;
                text-decoration: none;
                transition: all 0.2s;
            }

                .btn-signout:hover {
                    background: rgba(255,255,255,0.08);
                    color: white;
                }

                .btn-signout svg {
                    width: 14px;
                    height: 14px;
                }

            /* ── LAYOUT ── */
            .app-body {
                display: flex;
                padding-top: 64px;
                min-height: 100vh;
            }

            .sidebar {
                width: var(--sidebar-width);
                background: var(--white);
                border-right: 1px solid var(--border);
                position: fixed;
                top: 64px;
                bottom: 0;
                left: 0;
                overflow-y: auto;
                display: flex;
                flex-direction: column;
                padding: 24px 0 20px;
            }

            .sidebar-section {
                font-size: 10px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                color: var(--muted);
                padding: 0 20px;
                margin: 20px 0 8px;
            }

                .sidebar-section:first-child {
                    margin-top: 0;
                }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 20px;
                font-size: 13.5px;
                font-weight: 400;
                color: var(--muted);
                text-decoration: none;
                transition: all 0.15s;
                border-left: 3px solid transparent;
            }

                .nav-item:hover {
                    background: var(--offwhite);
                    color: var(--navy);
                }

                .nav-item.active {
                    background: var(--teal-light);
                    color: var(--teal);
                    border-left-color: var(--teal);
                    font-weight: 500;
                }

                .nav-item svg {
                    width: 16px;
                    height: 16px;
                    flex-shrink: 0;
                }

            .sidebar-bottom {
                margin-top: auto;
                border-top: 1px solid var(--border);
                padding-top: 16px;
            }

            .nav-item.danger {
                color: var(--red);
            }

                .nav-item.danger:hover {
                    background: #fef2f2;
                }

            .main {
                margin-left: var(--sidebar-width);
                flex: 1;
                padding: 32px 36px;
            }

            /* ── PAGE HEADER ── */
            .page-header {
                margin-bottom: 28px;
            }

            .page-label {
                font-size: 11px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                color: var(--teal);
                margin-bottom: 6px;
            }

            .page-title {
                font-family: 'DM Serif Display', serif;
                font-size: 1.8rem;
                color: var(--navy);
                line-height: 1.2;
            }

            .page-sub {
                font-size: 13.5px;
                color: var(--muted);
                margin-top: 4px;
            }

            /* ── CARD ── */
            .card {
                background: var(--white);
                border: 1px solid var(--border);
                border-radius: 14px;
                overflow: hidden;
                margin-bottom: 24px;
            }

            /* ── BADGES ── */
            .badge {
                display: inline-block;
                padding: 3px 10px;
                border-radius: 100px;
                font-size: 11px;
                font-weight: 500;
            }

            .badge-stat {
                background: #fef2f2;
                color: var(--red);
            }

            .badge-urgent {
                background: #fff7ed;
                color: #c2410c;
            }

            .badge-routine {
                background: var(--offwhite);
                color: var(--muted);
            }

            .badge-verified {
                background: #dcfce7;
                color: #166534;
            }

            .badge-inprogress {
                background: #e8f0fe;
                color: var(--blue);
            }

            .badge-submitted {
                background: #f0fdf4;
                color: #15803d;
            }

            /* ── RESULT HEADER BAR ── */
            .result-header-bar {
                padding: 16px 24px;
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

            .result-req-id {
                font-family: monospace;
                font-size: 13px;
                font-weight: 600;
                color: var(--navy);
            }

            .result-patient {
                font-size: 13.5px;
                color: var(--navy);
            }

            .result-date {
                font-size: 12.5px;
                color: var(--muted);
            }

            /* ── ALERT BAR ── */
            .result-alert {
                margin: 16px 24px 4px;
                padding: 10px 14px;
                background: #fffbeb;
                border: 1px solid #fde68a;
                border-radius: 8px;
                font-size: 12.5px;
                color: #92400e;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            /* ── SECTION TITLE ── */
            .result-section-title {
                font-size: 11px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                color: var(--muted);
                padding: 16px 24px 10px;
            }

            /* ── RESULT ROWS ── */
            .result-row {
                display: grid;
                grid-template-columns: 1fr auto auto;
                align-items: center;
                gap: 16px;
                padding: 11px 24px;
                border-bottom: 1px solid var(--border);
            }

                .result-row:last-of-type {
                    border-bottom: none;
                }

            .result-name {
                font-size: 13.5px;
                color: var(--navy);
            }

            .result-val {
                font-size: 13.5px;
                font-weight: 500;
                font-family: monospace;
                white-space: nowrap;
            }

                .result-val.abnormal {
                    color: var(--red);
                }

                .result-val.normal {
                    color: #059669;
                }

            .result-range {
                font-size: 12px;
                color: var(--muted);
                white-space: nowrap;
            }

            .abnormal-indicator {
                display: inline-block;
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--red);
                margin-right: 6px;
                vertical-align: middle;
            }

            /* ── ACTIONS BAR ── */
            .actions-bar {
                padding: 20px 24px;
                border-top: 1px solid var(--border);
                background: var(--offwhite);
            }

            /* ── FORM ── */
            .form-group {
                display: flex;
                flex-direction: column;
                gap: 6px;
                margin-bottom: 16px;
            }

                .form-group label {
                    font-size: 12px;
                    font-weight: 500;
                    color: var(--muted);
                }

                .form-group textarea {
                    font-family: 'DM Sans', sans-serif;
                    font-size: 13.5px;
                    padding: 9px 12px;
                    border: 1px solid var(--border);
                    border-radius: 8px;
                    color: var(--navy);
                    outline: none;
                    background: var(--white);
                    transition: border-color 0.2s;
                    resize: vertical;
                    min-height: 80px;
                }

                    .form-group textarea:focus {
                        border-color: var(--teal);
                        box-shadow: 0 0 0 3px rgba(13,148,136,0.1);
                    }

            /* ── BUTTONS ── */
            .btn-primary {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                background: var(--teal);
                color: white;
                font-family: 'DM Sans', sans-serif;
                font-size: 13.5px;
                font-weight: 500;
                padding: 9px 20px;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                transition: background 0.2s;
            }

                .btn-primary:hover {
                    background: #0b7a70;
                }

            .btn-outline {
                background: transparent;
                border: 1px solid var(--border);
                color: var(--navy);
                font-family: 'DM Sans', sans-serif;
                font-size: 12.5px;
                padding: 9px 14px;
                border-radius: 8px;
                cursor: pointer;
                white-space: nowrap;
                transition: all 0.15s;
            }

                .btn-outline:hover {
                    border-color: var(--teal);
                    color: var(--teal);
                    background: var(--teal-light);
                }

            /* ── SUCCESS MSG ── */
            .submit-msg {
                display: flex;
                align-items: center;
                gap: 6px;
                font-size: 12.5px;
                color: #059669;
                opacity: 0;
                transition: opacity 0.3s;
            }

                .submit-msg .dot {
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background: #059669;
                    flex-shrink: 0;
                }
        </style>
    </head>
    <body>

        <nav class="topnav">
            <a class="nav-brand" href="#">
                <div class="nav-logo">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" />
                        <circle cx="12" cy="17" r="4" opacity="0.6" />
                    </svg>
                </div>
                <div class="nav-title">NMB-HLabSys <span>Haematology Lab System</span></div>
            </a>
            <div class="nav-right">
                <div class="nav-user">
                    <div class="nav-avatar">D</div>
                    <div class="nav-user-info">
                        <div class="nav-user-name">doctor@nmb.ac.za</div>
                        <div class="nav-user-role">Doctor</div>
                    </div>
                </div>
                <a href="#" class="btn-signout">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <polyline points="16 17 21 12 16 7" />
                        <line x1="21" y1="12" x2="9" y2="12" />
                    </svg>
                    Sign Out
                </a>
            </div>
        </nav>

        <div class="app-body">
            <aside class="sidebar">
                <div class="sidebar-section">Main</div>
                <a class="nav-item" href="#">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                    Dashboard
                </a>
                <a class="nav-item" href="#">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    My Patients
                </a>
                <a class="nav-item" href="#">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    Test Requests
                </a>
                <a class="nav-item active" href="#">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                    Results
                </a>
                <div class="sidebar-section">System</div>
                <a class="nav-item" href="#">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    Activity Log
                </a>
                <div class="sidebar-bottom">
                    <a class="nav-item danger" href="#">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        Sign out
                    </a>
                </div>
            </aside>

            <main class="main">
                <div class="page-header">
                    <div class="page-label">Doctor Portal</div>
                    <h1 class="page-title">Test Results</h1>
                    <p class="page-sub">View and release results to patients</p>
                </div>

                <div class="card">
                    <div class="result-header-bar">
                        <span class="result-req-id">REQ-2025-089</span>
                        <span class="result-patient">K. Mashamba</span>
                        <span class="result-date">2025-03-01</span>
                        <span class="badge badge-stat">STAT</span>
                        <span class="badge badge-verified">Verified</span>
                    </div>

                    <div class="result-alert">
                        ⚠ 2 abnormal results detected — highlighted below
                    </div>

                    <div class="result-section-title">Full Blood Count</div>

                    <div class="result-row">
                        <span class="result-name"><span class="abnormal-indicator"></span>Haemoglobin</span>
                        <span class="result-val abnormal">9.2 g/dL</span>
                        <span class="result-range">Normal: 12.0–17.5 g/dL</span>
                    </div>
                    <div class="result-row">
                        <span class="result-name">WBC Count</span>
                        <span class="result-val normal">7.8 ×10⁹/µL</span>
                        <span class="result-range">Normal: 4.5–11.0 ×10⁹/µL</span>
                    </div>
                    <div class="result-row">
                        <span class="result-name"><span class="abnormal-indicator"></span>Platelet Count</span>
                        <span class="result-val abnormal">88 ×10⁹/µL</span>
                        <span class="result-range">Normal: 150–400 ×10⁹/µL</span>
                    </div>
                    <div class="result-row">
                        <span class="result-name">MCV</span>
                        <span class="result-val normal">86.4 fL</span>
                        <span class="result-range">Normal: 80–100 fL</span>
                    </div>

                    <div class="actions-bar">
                        <div class="form-group">
                            <label>Note to Patient</label>
                            <textarea placeholder="e.g. Please make an appointment to discuss these results..."></textarea>
                        </div>
                        <div style="display:flex; align-items:center; gap:16px;">
                            <button class="btn-primary" onclick="releaseResult()">Release to Patient</button>
                            <button class="btn-outline">Download PDF</button>
                            <span class="submit-msg" id="release-msg">
                                <span class="dot"></span>
                                Results released! Patient notified via email with PDF.
                            </span>
                        </div>
                    </div>
                </div>
            </main>
        </div>

        <script>
            function releaseResult() {
                const msg = document.getElementById('release-msg');
                msg.style.opacity = '1';
                setTimeout(() => msg.style.opacity = '0', 4000);
            }
        </script>

    </body>
    </html>
}
