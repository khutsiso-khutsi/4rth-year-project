@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<Doctor.Models.DoctorTestRequestSummary>
@{
    ViewData["Title"] = "Test Results";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test Results — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --teal: #0d9488;
            --teal-light: rgba(13,148,136,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
            --amber: #d97706;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
        }

        /* ── TOPBAR ── */
        .topbar {
            background: var(--navy);
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-logo {
            width: 34px;
            height: 34px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .brand-logo svg {
            width: 18px;
            height: 18px;
            fill: white;
        }

        .brand-name {
            font-family: 'DM Serif Display', serif;
            color: white;
            font-size: 1.1rem;
            line-height: 1.1;
        }

        .brand-name span {
            display: block;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.6rem;
            font-weight: 300;
            color: rgba(255,255,255,0.4);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 6px 14px 6px 8px;
        }

        .user-avatar {
            width: 28px;
            height: 28px;
            background: var(--teal);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
        }

        .user-email {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.75);
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .logout-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.8);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .logout-btn:hover {
            background: rgba(255,255,255,0.15);
            color: white;
        }

        .logout-btn svg {
            width: 14px;
            height: 14px;
        }

        /* ── LAYOUT ── */
        .page {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 220px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 24px 0;
            flex-shrink: 0;
            position: sticky;
            top: 64px;
            height: calc(100vh - 64px);
            overflow-y: auto;
        }

        .nav-section {
            margin-bottom: 8px;
        }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 20px;
            margin-bottom: 4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.15s;
            border-left: 3px solid transparent;
        }

        .nav-item:hover {
            background: var(--offwhite);
            color: var(--navy);
        }

        .nav-item.active {
            background: var(--teal-light);
            color: var(--teal);
            border-left-color: var(--teal);
        }

        .nav-item svg {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }

        /* ── MAIN ── */
        .main {
            flex: 1;
            padding: clamp(24px, 3vw, 40px);
            overflow-y: auto;
        }

        /* ── HERO ── */
        .hero {
            background: var(--navy);
            border-radius: 20px;
            padding: 32px 36px;
            margin-bottom: 32px;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 60% 80% at 90% 50%, rgba(13,148,136,0.2) 0%, transparent 60%);
        }

        .hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(13,148,136,0.15);
            border: 1px solid rgba(13,148,136,0.3);
            color: #5eead4;
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 100px;
            margin-bottom: 14px;
        }

        .hero-tag::before {
            content: '';
            width: 5px;
            height: 5px;
            background: #5eead4;
            border-radius: 50%;
        }

        .hero h1 {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.5rem, 2.5vw, 2.2rem);
            color: white;
            margin-bottom: 8px;
            line-height: 1.2;
        }

        .hero h1 span {
            color: #5eead4;
            font-style: italic;
        }

        .hero p {
            color: rgba(255,255,255,0.5);
            font-size: 0.88rem;
            font-weight: 300;
        }

        /* ── SECTION HEADER ── */
        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .section-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            color: var(--navy);
        }

        /* ── CARD ── */
        .card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
            margin-bottom: 24px;
        }

        /* ── BADGES ── */
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 100px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .badge-stat { background: #fee2e2; color: var(--red); }
        .badge-urgent { background: #fef3c7; color: var(--amber); }
        .badge-routine { background: var(--offwhite); color: var(--muted); }
        .badge-verified { background: #dcfce7; color: var(--green); }
        .badge-inprogress { background: #dbeafe; color: #1d4ed8; }
        .badge-submitted { background: #f0fdf4; color: #15803d; }

        /* ── RESULT HEADER BAR ── */
        .result-header-bar {
            padding: 16px 24px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .result-req-id {
            font-family: 'Courier New', monospace;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--teal);
            background: var(--teal-light);
            padding: 3px 7px;
            border-radius: 5px;
        }

        .result-patient {
            font-size: 0.85rem;
            color: var(--navy);
            font-weight: 500;
        }

        .result-date {
            font-size: 0.78rem;
            color: var(--muted);
        }

        /* ── ALERT BAR ── */
        .result-alert {
            margin: 16px 24px 4px;
            padding: 10px 14px;
            background: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 10px;
            font-size: 0.78rem;
            color: #92400e;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ── SECTION TITLE (inner) ── */
        .result-section-title {
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--muted);
            padding: 16px 24px 10px;
        }

        /* ── RESULT ROWS ── */
        .result-row {
            display: grid;
            grid-template-columns: 1fr auto auto;
            align-items: center;
            gap: 16px;
            padding: 11px 24px;
            border-bottom: 1px solid var(--border);
        }

        .result-row:last-of-type {
            border-bottom: none;
        }

        .result-name {
            font-size: 0.84rem;
            color: var(--navy);
        }

        .result-val {
            font-size: 0.84rem;
            font-weight: 600;
            font-family: 'Courier New', monospace;
            white-space: nowrap;
        }

        .result-val.abnormal {
            color: var(--red);
        }

        .result-val.normal {
            color: var(--green);
        }

        .result-range {
            font-size: 0.75rem;
            color: var(--muted);
            white-space: nowrap;
        }

        .abnormal-indicator {
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--red);
            margin-right: 6px;
            vertical-align: middle;
        }

        /* ── ACTIONS BAR ── */
        .actions-bar {
            padding: 20px 24px;
            border-top: 1px solid var(--border);
            background: var(--offwhite);
        }

        /* ── FORM ── */
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 16px;
        }

        .form-group label {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .form-group textarea {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.85rem;
            padding: 10px 14px;
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--navy);
            outline: none;
            background: white;
            transition: border-color 0.2s, box-shadow 0.2s;
            resize: vertical;
            min-height: 80px;
        }

        .form-group textarea:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 3px rgba(13,148,136,0.12);
        }

        /* ── BUTTONS ── */
        .btn-row {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--teal);
            color: white;
        }

        .btn-primary:hover {
            background: #0b7a70;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(13,148,136,0.3);
        }

        .btn-outline {
            background: white;
            color: var(--navy);
            border: 1px solid var(--border);
        }

        .btn-outline:hover {
            background: var(--offwhite);
            border-color: var(--teal);
            color: var(--teal);
        }

        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .topbar { padding: 0 20px; }
            .user-email { display: none; }
            .sidebar { display: none; }
            .main { padding: 20px 16px; }
            .hero { padding: 24px 20px; }
        }
    </style>
</head>
<body>

<!-- TOPBAR -->
<div class="topbar">
    <a class="brand" asp-controller="Home" asp-action="Index">
        <div class="brand-logo">
            <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
        </div>
        <div class="brand-name">
            NMB-HLabSys
            <span>Haematology Lab System</span>
        </div>
    </a>
    <div class="topbar-right">
        <div class="user-chip">
            <div class="user-avatar">@((string.IsNullOrEmpty(ViewBag.Email as string) ? "D" : ((string)ViewBag.Email).Substring(0, 1).ToUpper()))</div>
            <span class="user-email">@(ViewBag.Email ?? "Doctor")</span>
        </div>
        <a asp-controller="Home" asp-action="Logout" class="logout-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
            Sign Out
        </a>
    </div>
</div>

<div class="page">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="nav-section">
            <div class="nav-label">Main</div>
            <a asp-controller="Doctor" asp-action="DoctorDashboard" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                Dashboard
            </a>
            <a asp-controller="Doctor" asp-action="TestRequests" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                Test Requests
            </a>
            <a asp-controller="Doctor" asp-action="ViewResults" class="nav-item active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                View Results
            </a>
            <a asp-controller="Doctor" asp-action="PatientRecords" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                Patient Records
            </a>
            <a asp-controller="Doctor" asp-action="Reports" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" /></svg>
                Reports
            </a>
            <a asp-controller="Doctor" asp-action="Alerts" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                Alerts
            </a>
        </div>
        <div class="nav-section">
            <div class="nav-label">Account</div>
            <a asp-controller="Doctor" asp-action="Profile" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                My Profile
            </a>
        </div>
        <div class="nav-section">
            <div class="nav-label">Support</div>
            <a href="#" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                Help
            </a>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main">

        <!-- HERO -->
        <div class="hero">
            <div class="hero-content">
                <div class="hero-tag">Doctor Portal</div>
                <h1>View <span>Results</span></h1>
                <p>View and release completed test results to your patients.</p>
            </div>
        </div>

        <div class="section-header">
            <h2 class="section-title">Completed Requests</h2>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="card" style="padding:24px;color:var(--muted);">No completed test requests awaiting review yet.</div>
        }
        @foreach (var req in Model ?? new())
        {
            <div class="card">
                <div class="result-header-bar">
                    <span class="result-req-id">@req.RequestNumber</span>
                    <span class="result-patient">@req.PatientName</span>
                    <span class="result-date">@req.RequestDate.ToString("yyyy-MM-dd")</span>
                    <span class="badge @(req.Urgency == "STAT" ? "badge-stat" : req.Urgency == "Urgent" ? "badge-urgent" : "badge-routine")">@req.Urgency</span>
                    <span class="badge @(req.RequestStatus == Doctor.Models.TestRequestStatus.ReleasedByDoctor ? "badge-verified" : "badge-inprogress")">@req.RequestStatus</span>
                </div>

                @if (req.HasAbnormalResult)
                {
                    <div class="result-alert">
                        ⚠ @req.Items.Count(i => i.IsAbnormal) abnormal result(s) detected — highlighted below
                    </div>
                }

                <div class="result-section-title">Results</div>

                @foreach (var item in req.Items)
                {
                    <div class="result-row">
                        <span class="result-name">
                            @if (item.IsAbnormal) { <span class="abnormal-indicator"></span> }
                            @item.TestName
                        </span>
                        <span class="result-val @(item.IsAbnormal ? "abnormal" : "normal")">@(item.ResultValue?.ToString() ?? "—") @item.UnitName</span>
                        <span class="result-range">Normal: @item.NormalRangeMin–@item.NormalRangeMax @item.UnitName</span>
                    </div>
                }

                @if (req.RequestStatus == Doctor.Models.TestRequestStatus.Completed)
                {
                    <div class="actions-bar">
                        <form method="post" asp-controller="Doctor" asp-action="ReleaseResults">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="RequestID" value="@req.RequestID" />
                            <div class="form-group">
                                <label>Note to Patient</label>
                                <textarea name="ReleaseNotes" placeholder="e.g. Please make an appointment to discuss these results..."></textarea>
                            </div>
                            <label style="font-size:0.78rem;display:flex;align-items:center;gap:6px;margin-bottom:14px;font-weight:400;text-transform:none;letter-spacing:normal;color:var(--navy);">
                                <input type="checkbox" name="AskPatientToBookAppointment" value="true" />
                                Ask patient to book an appointment instead of e-mailing raw results
                            </label>
                            <div class="btn-row">
                                <button type="submit" class="btn btn-primary">Release to Patient</button>
                                <a class="btn btn-outline" href="@Url.Action("ResultsPdf", "Doctor", new { requestId = req.RequestID })">Download PDF</a>
                            </div>
                        </form>
                    </div>
                }
                else
                {
                    <div class="actions-bar">
                        <div class="btn-row">
                            <a class="btn btn-outline" href="@Url.Action("ResultsPdf", "Doctor", new { requestId = req.RequestID })">Download PDF</a>
                            <span style="font-size:0.78rem;color:var(--muted);">
                                Released @req.ReleasedDate?.ToString("yyyy-MM-dd") — @req.ReleaseNotes
                            </span>
                        </div>
                    </div>
                }
            </div>
        }

    </main>
</div>

</body>
</html>
