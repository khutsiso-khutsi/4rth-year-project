@using LabManager.Models
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<ConsumableOrder>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Consumable Orders";
    Layout = null;

    var statusFilter = ViewBag.StatusFilter as string ?? "All Statuses";

    var suppliers = ViewBag.Suppliers as IEnumerable<Supplier>
                    ?? Enumerable.Empty<Supplier>();

    // Use one consistent SelectListItem collection for the view and JavaScript.
    var consumableItems =
        ViewBag.Consumables as IEnumerable<SelectListItem>
        ?? ViewBag.Consumable as IEnumerable<SelectListItem>
        ?? Enumerable.Empty<SelectListItem>();


     var supplierDictionary = new Dictionary<string, string>();

    if (ViewBag.Supplier is IEnumerable<dynamic> supplier)
    {
        // Populate the dictionary with valid fridge data
        supplierDictionary = supplier.ToDictionary(supplier => (string)supplier.Value, supplier => (string)supplier.Text);
    }


    var consumableDictionary = new Dictionary<string, string>();

    if (ViewBag.Consumables is IEnumerable<dynamic> consumable)
    {
        // Populate the dictionary with valid fridge data
        consumableDictionary = consumable.ToDictionary(consumable => (string)consumable.Value, consumable => (string)consumable .Text);
    }



    var email = ViewBag.Email as string ?? "";

    var successMessage = TempData["Success"] as string;
    var errorMessage = TempData["Error"] as string;

    var orders = Model ?? Enumerable.Empty<ConsumableOrder>();



}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Consumable Orders — NMB-HLabSys</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --teal: #0d9488;
            --teal-dark: #0b7c72;
            --teal-light: rgba(13,148,136,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --red-dark: #b91c1c;
            --red-light: rgba(220,38,38,0.1);
            --green: #16a34a;
            --green-dark: #128a3e;
            --green-light: rgba(22,163,74,0.1);
            --amber: #d97706;
            --amber-light: rgba(217,119,6,0.1);
            --purple: #4f46e5;
            --purple-light: rgba(79,70,229,0.1);
            --radius: 16px;
            --shadow: 0 2px 8px rgba(11,31,58,.04);
            --shadow-lg: 0 20px 60px rgba(11,31,58,.20);
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
            line-height: 1.5;
        }

        button, input, select, textarea {
            font-family: inherit;
        }

        .topbar {
            background: var(--navy);
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-icon {
            width: 34px;
            height: 34px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .brand-icon svg {
                width: 18px;
                height: 18px;
                fill: white;
            }

        .brand-name {
            font-family: 'DM Serif Display', serif;
            color: white;
            font-size: 1.1rem;
            line-height: 1.1;
        }

            .brand-name span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.6rem;
                font-weight: 300;
                color: rgba(255,255,255,0.4);
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 6px 14px 6px 8px;
        }

        .user-avatar {
            width: 28px;
            height: 28px;
            background: var(--teal);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
        }

        .user-email {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.75);
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .logout-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.8);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
            cursor: pointer;
        }

            .logout-btn:hover {
                background: rgba(255,255,255,0.15);
                color: white;
            }

            .logout-btn svg {
                width: 14px;
                height: 14px;
            }

        .page {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        .sidebar {
            width: 220px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 24px 0;
            flex-shrink: 0;
            position: sticky;
            top: 64px;
            height: calc(100vh - 64px);
            overflow-y: auto;
        }

        .nav-section {
            margin-bottom: 8px;
        }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 20px;
            margin-bottom: 4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.15s;
            border-left: 3px solid transparent;
        }

            .nav-item:hover {
                background: var(--offwhite);
                color: var(--navy);
            }

            .nav-item.active {
                background: var(--teal-light);
                color: var(--teal);
                border-left-color: var(--teal);
                font-weight: 600;
            }

            .nav-item svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

            .nav-item:focus-visible {
                outline: 2px solid var(--teal);
                outline-offset: -2px;
            }

        .main {
            flex: 1;
            padding: clamp(24px, 3vw, 40px);
            overflow-y: auto;
        }

        .header-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 24px;
            gap: 20px;
            flex-wrap: wrap;
        }

        .heading h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.8rem;
            font-weight: 400;
            color: var(--navy);
        }

        .heading p {
            margin: 6px 0 0;
            color: var(--muted);
            font-size: 0.85rem;
            font-weight: 300;
        }

        .btn {
            border: none;
            border-radius: 10px;
            padding: 10px 16px;
            cursor: pointer;
            font-size: 0.82rem;
            font-weight: 600;
            transition: all .18s ease;
        }

            .btn:hover {
                transform: translateY(-1px);
            }

            .btn:disabled {
                opacity: .6;
                cursor: not-allowed;
                transform: none;
            }

        .btn-primary {
            background: var(--teal);
            color: white;
            box-shadow: 0 2px 8px rgba(13,148,136,0.25);
        }

            .btn-primary:hover {
                background: var(--teal-dark);
            }

        .btn-success {
            background: var(--green);
            color: white;
            box-shadow: 0 2px 8px rgba(22,163,74,0.2);
        }

            .btn-success:hover {
                background: var(--green-dark);
            }

        .btn-danger {
            background: var(--red);
            color: white;
            box-shadow: 0 2px 8px rgba(220,38,38,0.2);
        }

            .btn-danger:hover {
                background: var(--red-dark);
            }

        .btn-outline {
            background: white;
            color: var(--navy);
            border: 1px solid var(--border);
        }

            .btn-outline:hover {
                border-color: var(--teal);
                color: var(--teal);
            }

        .btn-small {
            padding: 7px 11px;
            font-size: 0.72rem;
        }

        .alert {
            border-radius: 10px;
            padding: 13px 16px;
            margin-bottom: 20px;
            font-size: 0.82rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .alert-success {
            background: var(--green-light);
            color: var(--green);
            border: 1px solid rgba(22,163,74,0.25);
        }

        .alert-error {
            background: var(--red-light);
            color: var(--red);
            border: 1px solid rgba(220,38,38,0.25);
        }

        .alert-close {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 18px;
            color: inherit;
        }

        .filter-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 18px;
            margin-bottom: 20px;
            box-shadow: var(--shadow);
        }

        .filter-form {
            display: flex;
            gap: 15px;
            align-items: end;
            flex-wrap: wrap;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .form-label {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--navy);
        }

        .form-input,
        .form-select,
        .form-textarea {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 12px;
            background: white;
            color: var(--navy);
            outline: none;
            font-size: 0.82rem;
        }

            .form-input:focus,
            .form-select:focus,
            .form-textarea:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 3px var(--teal-light);
            }

        .search-box {
            min-width: 260px;
        }

        .table-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .table-header {
            padding: 17px 22px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .table-header h2 {
                font-family: 'DM Serif Display', serif;
                font-size: 1.05rem;
                font-weight: 400;
                color: var(--navy);
            }

        .table-count {
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--muted);
            background: var(--offwhite);
            border: 1px solid var(--border);
            padding: 5px 10px;
            border-radius: 100px;
        }

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 950px;
        }

        th {
            background: var(--offwhite);
            color: var(--muted);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: .08em;
            text-align: left;
            padding: 12px 18px;
            border-bottom: 1px solid var(--border);
        }

        td {
            padding: 15px 18px;
            border-bottom: 1px solid var(--offwhite);
            font-size: 0.83rem;
            vertical-align: middle;
            color: var(--navy);
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover {
            background: var(--offwhite);
        }

        .order-number {
            font-weight: 700;
            color: var(--navy);
        }

        .supplier-name {
            font-weight: 600;
        }

        .items {
            color: var(--muted);
            max-width: 320px;
            line-height: 1.5;
        }

        .date {
            color: var(--muted);
            white-space: nowrap;
        }

        .status {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 100px;
            font-size: 0.7rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .status-ordered {
            color: var(--purple);
            background: var(--purple-light);
        }

        .status-partial {
            color: var(--amber);
            background: var(--amber-light);
        }

        .status-complete {
            color: var(--green);
            background: var(--green-light);
        }

        .status-cancelled {
            color: var(--red);
            background: var(--red-light);
        }

        .actions {
            display: flex;
            gap: 7px;
            flex-wrap: wrap;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--muted);
        }

        .empty-icon {
            width: 70px;
            height: 70px;
            margin: 0 auto 17px;
            border-radius: 50%;
            background: var(--teal-light);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
        }

        .empty-state h3 {
            font-size: 1rem;
            font-weight: 700;
            color: var(--navy);
            margin-bottom: 5px;
        }

        .empty-state p {
            font-size: 0.8rem;
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(11,31,58,.45);
            backdrop-filter: blur(3px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 20px;
        }

            .modal-overlay.show {
                display: flex;
            }

        .modal {
            width: 100%;
            max-width: 560px;
            background: white;
            border-radius: var(--radius);
            box-shadow: var(--shadow-lg);
            max-height: 90vh;
            overflow-y: auto;
            animation: modalIn .18s ease;
        }

        @@keyframes modalIn {
            from {
                opacity: 0;
                transform: scale(0.96) translateY(8px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .modal-large {
            max-width: 700px;
        }

        .modal-header {
            padding: 19px 22px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            font-weight: 400;
            color: var(--navy);
        }

        .modal-close {
            width: 32px;
            height: 32px;
            border: none;
            background: var(--offwhite);
            border-radius: 8px;
            font-size: 20px;
            color: var(--muted);
            cursor: pointer;
            transition: background .18s ease, color .18s ease;
        }

            .modal-close:hover {
                background: var(--border);
                color: var(--navy);
            }

        .modal-body {
            padding: 22px;
        }

        .modal-footer {
            padding: 16px 22px;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            background: var(--offwhite);
        }

        .modal-subtitle {
            color: var(--muted);
            font-size: 0.82rem;
            margin: 5px 0 20px;
        }

        .modal-form-group {
            margin-bottom: 17px;
        }

        .required {
            color: var(--red);
        }

        .receive-info {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-bottom: 20px;
        }

        .info-box {
            background: var(--offwhite);
            border: 1px solid var(--border);
            padding: 12px;
            border-radius: 10px;
        }

        .info-label {
            font-size: 0.65rem;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 4px;
        }

        .info-value {
            font-size: 0.83rem;
            font-weight: 700;
            color: var(--navy);
        }

        .receive-item {
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 13px;
            margin-bottom: 10px;
            display: grid;
            grid-template-columns: 1fr 120px 140px;
            gap: 15px;
            align-items: center;
        }

        .receive-item-name {
            font-weight: 700;
            font-size: 0.83rem;
            color: var(--navy);
        }

        .receive-item-qty {
            font-size: 0.75rem;
            color: var(--muted);
        }

        @@media (max-width: 768px) {
            .topbar {
                padding: 0 20px;
            }

            .user-email {
                display: none;
            }

            .sidebar {
                display: none;
            }

            .main {
                padding: 20px 16px;
            }

            .header-row {
                flex-direction: column;
                align-items: flex-start;
            }

            .receive-item {
                grid-template-columns: 1fr;
            }

            .receive-info {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <!-- ============================================================
         TOPBAR
         ============================================================ -->
    <div class="topbar">

        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" />
                    <circle cx="12" cy="17" r="4" opacity="0.6" />
                </svg>
            </div>
            <div class="brand-name">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>
        </a>

        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">
                    @(string.IsNullOrWhiteSpace(email) ? "M" : email.Substring(0, 1).ToUpper())
                </div>
                <span class="user-email">@email</span>
            </div>

            <a asp-controller="Home" asp-action="Logout" class="logout-btn" id="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>

    </div>

    <div class="page">

        <!-- ============================================================
             SIDEBAR
             ============================================================ -->
        <aside class="sidebar">

            <div class="nav-section">
                <div class="nav-label">Main</div>

                <a asp-controller="ManagerDashboard" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                    </svg>
                    Dashboard
                </a>

                <a asp-controller="TestCatalogue" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M9 3v11a3 3 0 006 0V3" />
                        <line x1="6" y1="3" x2="18" y2="3" />
                    </svg>
                    Test Catalogue
                </a>

                <a asp-controller="Consumable" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                    </svg>
                    Consumables
                </a>

                <a asp-controller="Staff" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Staff
                </a>

                <a asp-controller="ConsumableOrder" asp-action="Index" class="nav-item active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                    </svg>
                    Orders
                </a>

                <a asp-controller="ManagerDashboard" asp-action="TestsByCategory" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                    Reports
                </a>
            </div>

            <div class="nav-section">
                <div class="nav-label">System</div>

                <a asp-controller="ManagerDashboard" asp-action="Profile" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Profile
                </a>

                <a asp-controller="ManagerDashboard" asp-action="AuditLog" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                    Audit Log
                </a>
            </div>

        </aside>

        <!-- ============================================================
             MAIN
             ============================================================ -->
        <main class="main">

            <div class="header-row">
                <div class="heading">
                    <h1>Orders</h1>
                    <p>Create, receive and manage consumable orders.</p>
                </div>

                <button type="button" class="btn btn-primary" onclick="openModal('m-create-order')">
                    + Create Order
                </button>
            </div>

            <!-- ALERTS -->
            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success" id="success-alert">
                    <span>✓ @successMessage</span>
                    <button type="button" class="alert-close" onclick="closeAlert('success-alert')">×</button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-error" id="error-alert">
                    <span>⚠ @errorMessage</span>
                    <button type="button" class="alert-close" onclick="closeAlert('error-alert')">×</button>
                </div>
            }

            <!-- FILTER -->
            <div class="filter-card">
                <form method="get" action="@Url.Action("Index", "ConsumableOrder")" class="filter-form">

                    <div class="form-group">
                        <label class="form-label">Order Status</label>
                        <select class="form-select" name="status" onchange="this.form.submit()">
                            <option value="All Statuses" selected="@(statusFilter == "All Statuses")">All Statuses</option>
                            <option value="Ordered" selected="@(statusFilter == "Ordered")">Ordered</option>
                            <option value="Partially Complete" selected="@(statusFilter == "Partially Complete")">Partially Complete</option>
                            <option value="Complete" selected="@(statusFilter == "Complete")">Complete</option>
                            <option value="Cancelled" selected="@(statusFilter == "Cancelled")">Cancelled</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Search</label>
                        <input type="text"
                               id="order-search"
                               class="form-input search-box"
                               placeholder="Search order, supplier or consumable..."
                               autocomplete="off" />
                    </div>

                </form>
            </div>

            <!-- ORDERS TABLE -->
            <div class="table-card">

                <div class="table-header">
                    <h2>Consumable Orders</h2>
                    <span class="table-count" id="table-count">@orders.Count() order(s)</span>
                </div>

                <div class="table-wrapper">
                    <table id="orders-table">

                        <thead>
                            <tr>
                                <th>Order Number</th>
                                <th>Supplier</th>
                                <th>Consumable</th>
                                <th>Order Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (orders.Any())
                            {
                                foreach (var order in orders)
                                {
                                    var statusClass =
                                        order.Status == "Ordered"
                                            ? "status-ordered"
                                            : order.Status == "Partially Complete"
                                                ? "status-partial"
                                                : order.Status == "Complete"
                                                    ? "status-complete"
                                                    : "status-cancelled";

                                    var supplierName =
                                        suppliers
                                            .FirstOrDefault(s => s.SupplierID == order.SupplierID)
                                            ?.SupplierName
                                        ?? $"Supplier #{order.SupplierID}";

                                    <tr class="order-row"
                                        data-search="@($"{order.OrderNumber} {supplierName} {order.Items} {order.Status}")"
                                        data-order-id="@order.Id"
                                        data-order-number="@order.OrderNumber"
                                        data-supplier="@supplierName"
                                        data-order-date="@order.OrderDate.ToString("dd MMM yyyy HH:mm")"
                                        data-items="@order.Items">

                                        <td><div class="order-number">@order.OrderNumber</div></td>
                                        <td><div class="supplier-name">
                                             @{
                                                var supplierItem = ((IEnumerable<SelectListItem>)ViewBag.Supplier)
                                                    .FirstOrDefault(s => s.Value == order.SupplierID.ToString());
                                            }
                                            @(supplierItem?.Text ?? "No supplier")
                                        </div></td>
                                        <td><div class="items">
                                             @{
                                                var consumableItem = consumableItems
                                                    .FirstOrDefault(s => s.Value == order.ConsumableID.ToString());
                                            }
                                            @(consumableItem?.Text ?? "No consumable")
                                        </div></td>
                                        <td><div class="date">@order.OrderDate.ToString("dd MMM yyyy HH:mm")</div></td>
                                        <td><span class="status @statusClass">@order.Status</span></td>

                                        <td>
                                            <div class="actions">

                                                @if (order.Status == "Ordered" || order.Status == "Partially Complete")
                                                {
                                                    <button type="button"
                                                            class="btn btn-success btn-small receive-order-btn"
                                                            data-order-id="@order.Id"
                                                            data-order-number="@order.OrderNumber"
                                                            data-supplier="@supplierName"
                                                            data-order-date="@order.OrderDate.ToString("dd MMM yyyy HH:mm")"
                                                            data-items="@order.Items">
                                                        Receive
                                                    </button>
                                                }

                                                @if (order.Status == "Ordered")
                                                {
                                                    <button type="button"
                                                            class="btn btn-danger btn-small cancel-order-btn"
                                                            data-order-id="@order.Id"
                                                            data-order-number="@order.OrderNumber"
                                                            data-supplier="@supplierName">
                                                        Cancel
                                                    </button>
                                                }

                                                @if (order.Status == "Complete")
                                                {
                                                    <span style="font-size:12px;color:var(--green);">✓ Completed</span>
                                                }

                                                @if (order.Status == "Cancelled")
                                                {
                                                    <span style="font-size:12px;color:var(--red);">Cancelled</span>
                                                }

                                            </div>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6">
                                        <div class="empty-state">
                                            <div class="empty-icon">📦</div>
                                            <h3>No orders found</h3>
                                            <p>There are currently no consumable orders matching your filter.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>

        </main>

    </div>

    <!-- ANTIFORGERY TOKEN -->
    <form id="antiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <!-- ============================================================
         CREATE ORDER MODAL
         ============================================================ -->
    <div class="modal-overlay" id="m-create-order">
        <div class="modal">

            <div class="modal-header">
                <h2 class="modal-title">Create Consumable Order</h2>
                <button type="button" class="modal-close" onclick="closeModal('m-create-order')">×</button>
            </div>

            <form method="post" action="@Url.Action("CreateOrder", "ConsumableOrder")" id="create-order-form">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <p class="modal-subtitle">Create a new order for laboratory consumables.</p>

                    <!-- ORDER NUMBER -->
                    <div class="modal-form-group">
                        <label class="form-label">Order Number</label>
                        <input type="text" class="form-input" value="Automatically generated" readonly />
                        <small style="display:block; margin-top:5px; color:var(--muted);">
                            The order number will be generated automatically.
                        </small>
                    </div>

                    <!-- SUPPLIER -->
                    <div class="modal-form-group">
                        <label class="form-label">
                            Supplier <span class="required">*</span>
                        </label>

                        <select class="form-select" name="supplierId" id="order-supplier" required>
                            <option value="">Select Supplier</option>

                            @foreach (var supplier in ViewBag.Supplier)
                            {
                                <option value="@supplier.Value">@supplier.Text</option>
                            }
                        </select>
                    </div>

                    <!-- ORDER ITEMS -->
                    <div class="modal-form-group">

                        <label class="form-label">
                            Consumables <span class="required">*</span>
                        </label>

                        <div id="order-items-container">

                            <div class="order-item-row"
                                 style="display:flex; gap:10px; margin-bottom:10px; align-items:center;">

                                <div style="flex:2;">
                                    <select class="form-select consumable-select" required style="width:100%;">
                                        <option value="">Select Consumable</option>
                                        @foreach (var c in consumableItems)
                                        {
                                            <option value="@c.Value">@c.Text</option>
                                        }
                                    </select>
                                </div>

                                <input type="number"
                                       class="form-input quantity-input"
                                       min="1"
                                       step="1"
                                       placeholder="Quantity"
                                       required
                                       style="flex:1;" />

                                <button type="button" class="btn btn-outline remove-item-btn">Remove</button>

                            </div>

                        </div>

                        <button type="button"
                                class="btn btn-outline"
                                id="add-item-btn"
                                style="margin-top:5px;">
                            + Add Consumable
                        </button>

                        <input type="hidden" name="items" id="order-items-json" />

                        <small style="display:block; margin-top:6px; color:var(--muted);">
                            Select a consumable and enter the quantity required.
                        </small>

                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" onclick="closeModal('m-create-order')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Order</button>
                </div>

            </form>

        </div>
    </div>

    <!-- ============================================================
         RECEIVE ORDER MODAL
         ============================================================ -->
    <div class="modal-overlay" id="m-receive-order">
        <div class="modal modal-large">

            <div class="modal-header">
                <div>
                    <h2 class="modal-title">Receive Order</h2>
                    <div class="modal-subtitle" id="recv-sub" style="margin-bottom:0;"></div>
                </div>
                <button type="button" class="modal-close" onclick="closeModal('m-receive-order')">×</button>
            </div>

            <div class="modal-body">

                <div class="receive-info">
                    <div class="info-box">
                        <div class="info-label">Order</div>
                        <div class="info-value" id="recv-order-number"></div>
                    </div>
                    <div class="info-box">
                        <div class="info-label">Supplier</div>
                        <div class="info-value" id="recv-supplier"></div>
                    </div>
                    <div class="info-box">
                        <div class="info-label">Order Date</div>
                        <div class="info-value" id="recv-date"></div>
                    </div>
                </div>

                <p style="font-size:13px; color:var(--muted); margin-bottom:15px;">
                    Enter the quantity received for each item.
                    Only received quantities will be added to stock.
                </p>

                <div id="recv-items-list"></div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('m-receive-order')">Cancel</button>
                <button type="button" id="recv-confirm-btn" class="btn btn-success">
                    Confirm Receipt &amp; Update Stock
                </button>
            </div>

        </div>
    </div>

    <!-- ============================================================
         CANCEL ORDER MODAL
         ============================================================ -->
    <div class="modal-overlay" id="m-cancel-order">
        <div class="modal">

            <div class="modal-header">
                <h2 class="modal-title">Cancel Order</h2>
                <button type="button" class="modal-close" onclick="closeModal('m-cancel-order')">×</button>
            </div>

            <form id="cancel-order-form" method="post" action="@Url.Action("CancelOrder", "ConsumableOrder")">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <div style="background:var(--red-light); color:var(--red); border:1px solid rgba(220,38,38,.25); padding:13px; border-radius:10px; margin-bottom:18px; font-size:13px;">
                        You are about to cancel the following order:
                        <strong id="cancel-sub" style="display:block;margin-top:5px;"></strong>
                    </div>

                    <input type="hidden" id="cancel-order-id" name="orderId" />

                    <div class="modal-form-group">
                        <label class="form-label">
                            Cancellation Reason <span class="required">*</span>
                        </label>

                        <textarea id="cancel-reason"
                                  class="form-textarea"
                                  name="cancellationReason"
                                  rows="5"
                                  style="width:100%;"
                                  placeholder="Enter the reason for cancelling this order..."
                                  required></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" onclick="closeModal('m-cancel-order')">Go Back</button>
                    <button type="submit" class="btn btn-danger">Cancel Order &amp; Notify Supplier</button>
                </div>

            </form>

        </div>
    </div>

    <!-- ============================================================
         LOGOUT MODAL
         ============================================================ -->
    <div id="logout-modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="logout-modal-title"
         style="display:none; position:fixed; inset:0; z-index:1100; background:rgba(11,31,58,0.45); align-items:center; justify-content:center;">

        <div style="background:white; border-radius:20px; padding:32px 28px; max-width:380px; width:90%; box-shadow:0 20px 60px rgba(11,31,58,0.2); animation:modalIn 0.18s ease;">

            <div style="width:52px; height:52px; background:#fee2e2; border-radius:14px; display:flex; align-items:center; justify-content:center; margin-bottom:18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
            </div>

            <h3 id="logout-modal-title"
                style="font-family:'DM Serif Display',serif; font-size:1.2rem; color:var(--navy); margin-bottom:8px;">
                Sign out?
            </h3>

            <p style="font-size:0.85rem; color:var(--muted); margin-bottom:24px; line-height:1.6;">
                You'll be returned to the login screen. Any unsaved changes will be lost.
            </p>

            <div style="display:flex;gap:10px;">
                <button id="logout-cancel"
                        style="flex:1; padding:10px; border:1px solid var(--border); border-radius:10px; background:white; color:var(--navy); font-size:0.85rem; font-weight:600; cursor:pointer; font-family:'DM Sans',sans-serif;">
                    Cancel
                </button>

                <a id="logout-confirm"
                   href="@Url.Action("Logout", "Home")"
                   style="flex:1; padding:10px; border:none; border-radius:10px; background:#dc2626; color:white; font-size:0.85rem; font-weight:600; cursor:pointer; text-align:center; text-decoration:none; font-family:'DM Sans',sans-serif;">
                    Sign Out
                </a>
            </div>

        </div>
    </div>

    <!-- ============================================================
         JAVASCRIPT
         ============================================================ -->
    <script>
       document.addEventListener("DOMContentLoaded", function () {

    /* =========================================================
       DATA FROM RAZOR
    ========================================================= */

    const consumableOptions = @Html.Raw(
        JsonSerializer.Serialize(
            consumableItems.Select(c => new
            {
                id = c.Value,
                name = c.Text
            })
        )
    );

            /* =========================================================
               HELPERS
            ========================================================= */

            function normalizeName(value) {
                return (value || "")
                    .toString()
                    .trim()
                    .toLowerCase()
                    .replace(/\s+/g, " ");
            }

            function findConsumable(searchText) {
                const search = normalizeName(searchText);
                if (!search) return null;

                const exact = consumableOptions.find(function (item) {
                    return normalizeName(item.name) === search;
                });
                if (exact) return exact;

                const partial = consumableOptions.find(function (item) {
                    return normalizeName(item.name).includes(search);
                });
                return partial || null;
            }

            function escapeHtml(value) {
                return (value || "")
                    .toString()
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function getAntiForgeryToken() {
                const token = document.querySelector(
                    '#antiForgeryForm input[name="__RequestVerificationToken"]'
                );
                return token ? token.value : "";
            }

            /* =========================================================
               MODAL + ALERT FUNCTIONS
            ========================================================= */

            window.openModal = function (id) {
                const modal = document.getElementById(id);
                if (!modal) return;
                modal.classList.add("show");
                modal.style.display = "flex";
            };

            window.closeModal = function (id) {
                const modal = document.getElementById(id);
                if (!modal) return;
                modal.classList.remove("show");
                modal.style.display = "none";
            };

            window.closeAlert = function (id) {
                const el = document.getElementById(id);
                if (el) el.remove();
            };

            /* =========================================================
               ORDER ITEM ROWS (DROPDOWN)
            ========================================================= */

            function resetRow(row) {
                const select = row.querySelector(".consumable-select");
                const quantity = row.querySelector(".quantity-input");
                if (select) select.selectedIndex = 0;
                if (quantity) quantity.value = "";
            }

            const addItemButton = document.getElementById("add-item-btn");

            if (addItemButton) {
                addItemButton.addEventListener("click", function () {
                    const container = document.getElementById("order-items-container");
                    if (!container) return;

                    const firstRow = container.querySelector(".order-item-row");
                    if (!firstRow) return;

                    const newRow = firstRow.cloneNode(true);
                    resetRow(newRow);
                    container.appendChild(newRow);
                });
            }

            document.addEventListener("click", function (event) {
                const removeButton = event.target.closest(".remove-item-btn");
                if (!removeButton) return;

                const container = document.getElementById("order-items-container");
                if (!container) return;

                const rows = container.querySelectorAll(".order-item-row");

                // Always keep at least one row; just clear it.
                if (rows.length <= 1) {
                    if (rows[0]) resetRow(rows[0]);
                    return;
                }

                const row = removeButton.closest(".order-item-row");
                if (row) row.remove();
            });

            /* =========================================================
               CREATE ORDER FORM
            ========================================================= */

            const createOrderForm = document.getElementById("create-order-form");

            if (createOrderForm) {
                createOrderForm.addEventListener("submit", function (event) {
                    event.preventDefault();

                    const supplierElement = document.getElementById("order-supplier");

                    if (!supplierElement || !supplierElement.value) {
                        alert("Please select a supplier.");
                        if (supplierElement) supplierElement.focus();
                        return;
                    }

                    const container = document.getElementById("order-items-container");

                    if (!container) {
                        alert("Unable to find the consumable items section.");
                        return;
                    }

                    const rows = container.querySelectorAll(".order-item-row");
                    const orderItems = [];
                    const usedConsumables = new Set();

                    for (const row of rows) {
                        const select = row.querySelector(".consumable-select");
                        const quantityInput = row.querySelector(".quantity-input");

                        const consumableId = select ? parseInt(select.value, 10) : 0;
                        const quantity = quantityInput ? parseInt(quantityInput.value, 10) : 0;
                        const name = select && select.selectedIndex > 0
                            ? select.options[select.selectedIndex].text
                            : "";

                        // Ignore completely empty rows
                        if (!consumableId && !quantity) continue;

                        if (!consumableId) {
                            alert("Please select a consumable.");
                            if (select) select.focus();
                            return;
                        }

                        if (!Number.isInteger(quantity) || quantity <= 0) {
                            alert(`Please enter a valid quantity for "${name}".`);
                            if (quantityInput) quantityInput.focus();
                            return;
                        }

                        if (usedConsumables.has(consumableId)) {
                            alert(`"${name}" has already been added to this order.`);
                            if (select) select.focus();
                            return;
                        }

                        usedConsumables.add(consumableId);

                        orderItems.push({
                            ConsumableID: consumableId,
                            QuantityOrdered: quantity
                        });
                    }

                    if (orderItems.length === 0) {
                        alert("Please add at least one consumable with a valid quantity.");
                        return;
                    }

                    const jsonInput = document.getElementById("order-items-json");

                    if (!jsonInput) {
                        alert("Unable to prepare the order items.");
                        return;
                    }

                    jsonInput.value = JSON.stringify(orderItems);

                    createOrderForm.submit();
                });
            }

            /* =========================================================
               RECEIVE ORDER
            ========================================================= */

            let currentReceiveOrderId = 0;

            function parseOrderItems(itemsText) {

                if (!itemsText) return [];

                // 1) JSON format
                try {
                    const parsed = JSON.parse(itemsText);

                    if (Array.isArray(parsed)) {
                        return parsed.map(function (item) {

                            const id = parseInt(
                                item.ConsumableID ?? item.consumableID ?? item.Id ?? item.id ?? 0,
                                10
                            );

                            const quantity = parseInt(
                                item.QuantityOrdered ?? item.quantityOrdered ?? item.Quantity ?? item.quantity ?? 0,
                                10
                            );

                            let name =
                                item.ConsumableName ?? item.consumableName ?? item.Name ?? item.name ?? "";

                            if (!name && id) {
                                const c = consumableOptions.find(function (o) {
                                    return parseInt(o.id, 10) === id;
                                });
                                if (c) name = c.name;
                            }

                            return {
                                id: id,
                                name: name || "Unknown Consumable",
                                quantity: quantity
                            };
                        });
                    }
                } catch (error) {
                    // Not JSON - fall through to legacy text parsing
                }

                // 2) Legacy format: "EDTA Tubes (20), Gloves (50)"
                const result = [];

                itemsText.split(",").forEach(function (part) {
                    const text = part.trim();
                    if (!text) return;

                    const match = text.match(/^(.+?)\s*\((\d+)\)\s*$/);

                    if (match) {
                        const name = match[1].trim();
                        const quantity = parseInt(match[2], 10);
                        const consumable = findConsumable(name);

                        result.push({
                            id: consumable ? parseInt(consumable.id, 10) : 0,
                            name: consumable ? consumable.name : name,
                            quantity: quantity
                        });
                    } else {
                        const consumable = findConsumable(text);

                        result.push({
                            id: consumable ? parseInt(consumable.id, 10) : 0,
                            name: consumable ? consumable.name : text,
                            quantity: 0
                        });
                    }
                });

                return result;
            }

            function createReceiveItem(item) {

                const wrapper = document.createElement("div");
                wrapper.className = "receive-item";
                wrapper.dataset.consumableId = item.id || "0";
                wrapper.dataset.consumableName = item.name || "";

                wrapper.innerHTML = `
                    <div class="receive-item-name">${escapeHtml(item.name)}</div>
                    <div class="receive-item-qty">Ordered: ${item.quantity || 0}</div>
                    <div>
                        <input type="number"
                               class="form-input receive-quantity"
                               min="0"
                               step="1"
                               value="${item.quantity || 0}"
                               data-consumable-id="${item.id || 0}"
                               style="width:100%;" />
                    </div>
                `;

                return wrapper;
            }

            document.addEventListener("click", function (event) {

                const receiveButton = event.target.closest(".receive-order-btn");
                if (!receiveButton) return;

                const orderRow = receiveButton.closest(".order-row");
                if (!orderRow) return;

                currentReceiveOrderId = parseInt(
                    receiveButton.dataset.orderId || orderRow.dataset.orderId || "0",
                    10
                );

                if (!currentReceiveOrderId) {
                    alert("Invalid order.");
                    return;
                }

                const orderNumber = orderRow.dataset.orderNumber || "";
                const supplier = orderRow.dataset.supplier || "";
                const orderDate = orderRow.dataset.orderDate || "";
                const itemsText = orderRow.dataset.items || "";

                document.getElementById("recv-order-number").textContent = orderNumber;
                document.getElementById("recv-supplier").textContent = supplier;
                document.getElementById("recv-date").textContent = orderDate;
                document.getElementById("recv-sub").textContent = `Receive items for order ${orderNumber}`;

                const itemsContainer = document.getElementById("recv-items-list");
                if (!itemsContainer) return;

                itemsContainer.innerHTML = "";

                const items = parseOrderItems(itemsText);

                if (items.length === 0) {
                    itemsContainer.innerHTML =
                        '<div style="padding:15px;">No consumable items were found for this order.</div>';
                } else {
                    items.forEach(function (item) {
                        itemsContainer.appendChild(createReceiveItem(item));
                    });
                }

                openModal("m-receive-order");
            });

            /* =========================================================
               CONFIRM RECEIVE ORDER
            ========================================================= */

            const receiveConfirmButton = document.getElementById("recv-confirm-btn");

            if (receiveConfirmButton) {

                receiveConfirmButton.addEventListener("click", async function () {

                    if (!currentReceiveOrderId) {
                        alert("Invalid order.");
                        return;
                    }

                    const receiveInputs = document.querySelectorAll(
                        "#recv-items-list .receive-quantity"
                    );

                    const receivedItems = [];

                    for (const input of receiveInputs) {

                        const quantity = parseInt(input.value || "0", 10);
                        const consumableId = parseInt(input.dataset.consumableId || "0", 10);

                        if (!Number.isInteger(quantity) || quantity < 0) {
                            alert("Please enter valid received quantities.");
                            input.focus();
                            return;
                        }

                        // Only send items with quantity > 0
                        if (quantity > 0) {

                            if (!consumableId) {
                                alert("A consumable could not be identified.");
                                return;
                            }

                            receivedItems.push({
                                ConsumableID: consumableId,
                                QuantityReceived: quantity
                            });
                        }
                    }

                    if (receivedItems.length === 0) {
                        alert("Please enter at least one received quantity.");
                        return;
                    }

                    const originalText = receiveConfirmButton.textContent;
                    receiveConfirmButton.disabled = true;
                    receiveConfirmButton.textContent = "Processing...";

                    try {

                        const response = await fetch(
                            '@Url.Action("ReceiveOrder", "ConsumableOrder")',
                            {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json",
                                    "RequestVerificationToken": getAntiForgeryToken()
                                },
                                body: JSON.stringify({
                                    orderId: currentReceiveOrderId,
                                    receivedItems: receivedItems
                                })
                            }
                        );

                        if (!response.ok) {
                            throw new Error("Unable to receive order.");
                        }

                        const contentType = response.headers.get("content-type") || "";

                        if (contentType.includes("application/json")) {
                            const result = await response.json();

                            if (result && result.success === false) {
                                throw new Error(result.message || "Unable to receive order.");
                            }
                        }

                        closeModal("m-receive-order");
                        window.location.reload();

                    } catch (error) {

                        alert(error.message || "An error occurred while receiving the order.");

                    } finally {

                        receiveConfirmButton.disabled = false;
                        receiveConfirmButton.textContent = originalText;
                    }
                });
            }

            /* =========================================================
               CANCEL ORDER
            ========================================================= */

            document.addEventListener("click", function (event) {

                const cancelButton = event.target.closest(".cancel-order-btn");
                if (!cancelButton) return;

                const orderId = cancelButton.dataset.orderId || "";
                const orderNumber = cancelButton.dataset.orderNumber || "";
                const supplier = cancelButton.dataset.supplier || "";

                const orderIdInput = document.getElementById("cancel-order-id");
                const reasonInput = document.getElementById("cancel-reason");
                const subElement = document.getElementById("cancel-sub");

                if (orderIdInput) orderIdInput.value = orderId;
                if (reasonInput) reasonInput.value = "";
                if (subElement) subElement.textContent = `Order ${orderNumber} — ${supplier}`;

                openModal("m-cancel-order");
            });

            const cancelOrderForm = document.getElementById("cancel-order-form");

            if (cancelOrderForm) {
                cancelOrderForm.addEventListener("submit", function (event) {

                    const orderId = document.getElementById("cancel-order-id");
                    const reason = document.getElementById("cancel-reason");

                    if (!orderId || !orderId.value || parseInt(orderId.value, 10) <= 0) {
                        event.preventDefault();
                        alert("Invalid order.");
                        return;
                    }

                    if (!reason || !reason.value.trim()) {
                        event.preventDefault();
                        alert("Please enter a cancellation reason.");
                        if (reason) reason.focus();
                        return;
                    }
                });
            }

            /* =========================================================
               LOGOUT MODAL
            ========================================================= */

            const logoutButton = document.getElementById("logout-btn");
            const logoutModal = document.getElementById("logout-modal");
            const logoutConfirm = document.getElementById("logout-confirm");
            const logoutCancel = document.getElementById("logout-cancel");

            if (logoutButton && logoutModal) {
                logoutButton.addEventListener("click", function (event) {
                    event.preventDefault();
                    if (logoutConfirm) logoutConfirm.href = logoutButton.href;
                    logoutModal.style.display = "flex";
                });
            }

            if (logoutCancel && logoutModal) {
                logoutCancel.addEventListener("click", function () {
                    logoutModal.style.display = "none";
                });
            }

            /* =========================================================
               ESC KEY + CLICK OUTSIDE MODAL
            ========================================================= */

            document.addEventListener("keydown", function (event) {
                if (event.key !== "Escape") return;

                document.querySelectorAll(".modal-overlay.show").forEach(function (modal) {
                    modal.classList.remove("show");
                    modal.style.display = "none";
                });

                if (logoutModal) logoutModal.style.display = "none";
            });

            document.addEventListener("click", function (event) {
                if (event.target.classList.contains("modal-overlay")) {
                    event.target.classList.remove("show");
                    event.target.style.display = "none";
                }
            });

            /* =========================================================
               SEARCH ORDERS
            ========================================================= */

            const searchInput = document.getElementById("order-search");

            if (searchInput) {
                searchInput.addEventListener("input", function () {

                    const search = normalizeName(this.value);
                    const rows = document.querySelectorAll("#orders-table tbody .order-row");
                    let visible = 0;

                    rows.forEach(function (row) {
                        const rowText = normalizeName(row.dataset.search || row.textContent);

                        if (!search || rowText.includes(search)) {
                            row.style.display = "";
                            visible++;
                        } else {
                            row.style.display = "none";
                        }
                    });

                    const count = document.getElementById("table-count");
                    if (count) count.textContent = `${visible} order(s)`;
                });
            }

        });
    </script>

</body>

</html>
