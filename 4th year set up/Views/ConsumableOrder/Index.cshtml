                                                @order.OrderDate.ToString("dd MMM yyyy HH:mm")
                                            </div>

                                        </td>

                                        <td>

                                            <span class="status @statusClass">
                                                @order.Status
                                            </span>

                                        </td>

                                        <td>

                                            <div class="actions">

                                                @if (order.Status == "Ordered" ||
                                                     order.Status == "Partially Complete")
                                                @if (order.Status == "Ordered" || order.Status == "Partially Complete")
                                                {
                                                    <button type="button"
                                                            class="btn btn-success btn-small"
                                                            onclick='openReceiveModal(
                                                        @order.Id,
                                                        @Json.Serialize(order.OrderNumber),
                                                        @Json.Serialize(order.Supplier),
                                                        @Json.Serialize(order.OrderDate.ToString("dd MMM yyyy HH:mm")),
                                                        @Json.Serialize(order.Items)
                                                        )'>

                                                    <button type="button" class="btn btn-success btn-small receive-order-btn"
                                                            data-order-id="@order.Id"
                                                            data-order-number="@order.OrderNumber"
                                                            data-supplier="@supplierName"
                                                            data-order-date="@order.OrderDate.ToString("dd MMM yyyy HH:mm")">
                                                        Receive

                                                    </button>
                                                }

                                                @if (order.Status == "Ordered")
                                                {
                                                    <button type="button"
                                                            class="btn btn-danger btn-small"
                                                            onclick='openCancelModal(
                                                        @order.Id,
                                                        @Json.Serialize(order.OrderNumber),
                                                        @Json.Serialize(order.Supplier)
                                                        )'>

                                                    <button type="button" class="btn btn-danger btn-small cancel-order-btn"
                                                            data-order-id="@order.Id"
                                                            data-order-number="@order.OrderNumber"
                                                            data-supplier="@supplierName">
                                                        Cancel

                                                    </button>
                                                }

                                                @if (order.Status == "Complete")
