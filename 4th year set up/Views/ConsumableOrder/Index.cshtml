@using LabManager.Models
@using System.Text.Json
@model IEnumerable<ConsumableOrder>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Consumable Orders";
    Layout = null;

    var statusFilter = ViewBag.StatusFilter as string ?? "All Statuses";

    var suppliers = ViewBag.Suppliers as IEnumerable<Supplier>
                    ?? Enumerable.Empty<Supplier>();

    var consumables = ViewBag.Consumables as IEnumerable<Consumable>
                      ?? Enumerable.Empty<Consumable>();

    var email = ViewBag.Email as string ?? "";

    var successMessage = TempData["Success"] as string;
    var errorMessage = TempData["Error"] as string;

    var orders = Model ?? Enumerable.Empty<ConsumableOrder>();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Consumable Orders — NMB-HLabSys</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <style>

            /* ============================================================
                       EXISTING STYLE
                       ============================================================ */

            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --navy: #0b1f3a;
                --navy2: #122848;
                --teal: #0d9488;
                --teal-dark: #0b7c72;
                --teal-light: rgba(13,148,136,0.1);
                --white: #ffffff;
                --offwhite: #f4f7fb;
                --muted: #6b7a99;
                --border: #dde4f0;
                --red: #dc2626;
                --red-dark: #b91c1c;
                --red-light: rgba(220,38,38,0.1);
                --green: #16a34a;
                --green-dark: #128a3e;
                --green-light: rgba(22,163,74,0.1);
                --amber: #d97706;
                --amber-light: rgba(217,119,6,0.1);
                --purple: #4f46e5;
                --purple-light: rgba(79,70,229,0.1);
                --radius: 16px;
                --shadow: 0 2px 8px rgba(11,31,58,.04);
                --shadow-lg: 0 20px 60px rgba(11,31,58,.20);
            }

            body {
                font-family: 'DM Sans', sans-serif;
                background: var(--offwhite);
                color: var(--navy);
                min-height: 100vh;
                line-height: 1.5;
            }

            button,
            input,
            select,
            textarea {
                font-family: inherit;
            }

            .topbar {
                background: var(--navy);
                padding: 0 40px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                height: 64px;
                position: sticky;
                top: 0;
                z-index: 100;
                box-shadow: 0 2px 20px rgba(0,0,0,0.15);
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

            .brand-icon {
                width: 34px;
                height: 34px;
                background: var(--teal);
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .brand-icon svg {
                    width: 18px;
                    height: 18px;
                    fill: white;
                }

            .brand-name {
                font-family: 'DM Serif Display', serif;
                color: white;
                font-size: 1.1rem;
                line-height: 1.1;
            }

                .brand-name span {
                    display: block;
                    font-family: 'DM Sans', sans-serif;
                    font-size: 0.6rem;
                    font-weight: 300;
                    color: rgba(255,255,255,0.4);
                    letter-spacing: 0.1em;
                    text-transform: uppercase;
                }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .user-chip {
                display: flex;
                align-items: center;
                gap: 10px;
                background: rgba(255,255,255,0.07);
                border: 1px solid rgba(255,255,255,0.1);
                border-radius: 100px;
                padding: 6px 14px 6px 8px;
            }

            .user-avatar {
                width: 28px;
                height: 28px;
                background: var(--teal);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.75rem;
                font-weight: 600;
                color: white;
            }

            .user-email {
                font-size: 0.8rem;
                color: rgba(255,255,255,0.75);
                max-width: 160px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .logout-btn {
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.12);
                color: rgba(255,255,255,0.8);
                padding: 8px 16px;
                border-radius: 8px;
                text-decoration: none;
                font-size: 0.82rem;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 6px;
                transition: all 0.2s;
                cursor: pointer;
            }

                .logout-btn:hover {
                    background: rgba(255,255,255,0.15);
                    color: white;
                }

                .logout-btn svg {
                    width: 14px;
                    height: 14px;
                }

            .page {
                display: flex;
                min-height: calc(100vh - 64px);
            }

            .sidebar {
                width: 220px;
                background: white;
                border-right: 1px solid var(--border);
                padding: 24px 0;
                flex-shrink: 0;
                position: sticky;
                top: 64px;
                height: calc(100vh - 64px);
                overflow-y: auto;
            }

            .nav-section {
                margin-bottom: 8px;
            }

            .nav-label {
                font-size: 0.65rem;
                font-weight: 600;
                color: var(--muted);
                letter-spacing: 0.1em;
                text-transform: uppercase;
                padding: 0 20px;
                margin-bottom: 4px;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 20px;
                color: var(--muted);
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 500;
                transition: all 0.15s;
                border-left: 3px solid transparent;
            }

                .nav-item:hover {
                    background: var(--offwhite);
                    color: var(--navy);
                }

                .nav-item.active {
                    background: var(--teal-light);
                    color: var(--teal);
                    border-left-color: var(--teal);
                    font-weight: 600;
                }

                .nav-item svg {
                    width: 16px;
                    height: 16px;
                    flex-shrink: 0;
                }

                .nav-item:focus-visible {
                    outline: 2px solid var(--teal);
                    outline-offset: -2px;
                }

            .main {
                flex: 1;
                padding: clamp(24px, 3vw, 40px);
                overflow-y: auto;
            }

            .header-row {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                margin-bottom: 24px;
                gap: 20px;
                flex-wrap: wrap;
            }

            .heading h1 {
                font-family: 'DM Serif Display', serif;
                font-size: 1.8rem;
                font-weight: 400;
                color: var(--navy);
            }

            .heading p {
                margin: 6px 0 0;
                color: var(--muted);
                font-size: 0.85rem;
                font-weight: 300;
            }

            .btn {
                border: none;
                border-radius: 10px;
                padding: 10px 16px;
                cursor: pointer;
                font-size: 0.82rem;
                font-weight: 600;
                transition: all .18s ease;
            }

                .btn:hover {
                    transform: translateY(-1px);
                }

            .btn-primary {
                background: var(--teal);
                color: white;
                box-shadow: 0 2px 8px rgba(13,148,136,0.25);
            }

                .btn-primary:hover {
                    background: var(--teal-dark);
                }

            .btn-success {
                background: var(--green);
                color: white;
                box-shadow: 0 2px 8px rgba(22,163,74,0.2);
            }

                .btn-success:hover {
                    background: var(--green-dark);
                }

            .btn-danger {
                background: var(--red);
                color: white;
                box-shadow: 0 2px 8px rgba(220,38,38,0.2);
            }

                .btn-danger:hover {
                    background: var(--red-dark);
                }

            .btn-outline {
                background: white;
                color: var(--navy);
                border: 1px solid var(--border);
            }

                .btn-outline:hover {
                    border-color: var(--teal);
                    color: var(--teal);
                }

            .btn-small {
                padding: 7px 11px;
                font-size: 0.72rem;
            }

            .alert {
                border-radius: 10px;
                padding: 13px 16px;
                margin-bottom: 20px;
                font-size: 0.82rem;
                font-weight: 600;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .alert-success {
                background: var(--green-light);
                color: var(--green);
                border: 1px solid rgba(22,163,74,0.25);
            }

            .alert-error {
                background: var(--red-light);
                color: var(--red);
                border: 1px solid rgba(220,38,38,0.25);
            }

            .alert-close {
                background: none;
                border: none;
                cursor: pointer;
                font-size: 18px;
                color: inherit;
            }

            .filter-card {
                background: white;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                padding: 18px;
                margin-bottom: 20px;
                box-shadow: var(--shadow);
            }

            .filter-form {
                display: flex;
                gap: 15px;
                align-items: end;
                flex-wrap: wrap;
            }

            .form-group {
                display: flex;
                flex-direction: column;
                gap: 7px;
            }

            .form-label {
                font-size: 0.72rem;
                font-weight: 700;
                color: var(--navy);
            }

            .form-input,
            .form-select,
            .form-textarea {
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 10px 12px;
                background: white;
                color: var(--navy);
                outline: none;
                font-size: 0.82rem;
            }

                .form-input:focus,
                .form-select:focus,
                .form-textarea:focus {
                    border-color: var(--teal);
                    box-shadow: 0 0 0 3px var(--teal-light);
                }

            .search-box {
                min-width: 260px;
            }

            .table-card {
                background: white;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                overflow: hidden;
                box-shadow: var(--shadow);
            }

            .table-header {
                padding: 17px 22px;
                border-bottom: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .table-header h2 {
                    font-family: 'DM Serif Display', serif;
                    font-size: 1.05rem;
                    font-weight: 400;
                    color: var(--navy);
                }

            .table-count {
                font-size: 0.72rem;
                font-weight: 600;
                color: var(--muted);
                background: var(--offwhite);
                border: 1px solid var(--border);
                padding: 5px 10px;
                border-radius: 100px;
            }

            .table-wrapper {
                width: 100%;
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 950px;
            }

            th {
                background: var(--offwhite);
                color: var(--muted);
                font-size: 0.7rem;
                text-transform: uppercase;
                letter-spacing: .08em;
                text-align: left;
                padding: 12px 18px;
                border-bottom: 1px solid var(--border);
            }

            td {
                padding: 15px 18px;
                border-bottom: 1px solid var(--offwhite);
                font-size: 0.83rem;
                vertical-align: middle;
                color: var(--navy);
            }

            tbody tr:last-child td {
                border-bottom: none;
            }

            tbody tr:hover {
                background: var(--offwhite);
            }

            .order-number {
                font-weight: 700;
                color: var(--navy);
            }

            .supplier-name {
                font-weight: 600;
            }

            .items {
                color: var(--muted);
                max-width: 320px;
                line-height: 1.5;
            }

            .date {
                color: var(--muted);
                white-space: nowrap;
            }

            .status {
                display: inline-flex;
                align-items: center;
                padding: 4px 10px;
                border-radius: 100px;
                font-size: 0.7rem;
                font-weight: 700;
                white-space: nowrap;
            }

            .status-ordered {
                color: var(--purple);
                background: var(--purple-light);
            }

            .status-partial {
                color: var(--amber);
                background: var(--amber-light);
            }

            .status-complete {
                color: var(--green);
                background: var(--green-light);
            }

            .status-cancelled {
                color: var(--red);
                background: var(--red-light);
            }

            .actions {
                display: flex;
                gap: 7px;
                flex-wrap: wrap;
            }

            .empty-state {
                text-align: center;
                padding: 60px 20px;
                color: var(--muted);
            }

            .empty-icon {
                width: 70px;
                height: 70px;
                margin: 0 auto 17px;
                border-radius: 50%;
                background: var(--teal-light);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 32px;
            }

            .empty-state h3 {
                font-size: 1rem;
                font-weight: 700;
                color: var(--navy);
                margin-bottom: 5px;
            }

            .empty-state p {
                font-size: 0.8rem;
            }

            .modal-overlay {
                position: fixed;
                inset: 0;
                background: rgba(11,31,58,.45);
                backdrop-filter: blur(3px);
                display: none;
                align-items: center;
                justify-content: center;
                z-index: 1000;
                padding: 20px;
            }

                .modal-overlay.show {
                    display: flex;
                }

            .modal {
                width: 100%;
                max-width: 560px;
                background: white;
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                max-height: 90vh;
                overflow-y: auto;
                animation: modalIn .18s ease;
            }

            @@keyframes modalIn {

                from {
                    opacity: 0;
                    transform: scale(0.96) translateY(8px);
                }

                to {
                    opacity: 1;
                    transform: scale(1) translateY(0);
                }
            }

            .modal-large {
                max-width: 700px;
            }

            .modal-header {
                padding: 19px 22px;
                border-bottom: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .modal-title {
                font-family: 'DM Serif Display', serif;
                font-size: 1.2rem;
                font-weight: 400;
                color: var(--navy);
            }

            .modal-close {
                width: 32px;
                height: 32px;
                border: none;
                background: var(--offwhite);
                border-radius: 8px;
                font-size: 20px;
                color: var(--muted);
                cursor: pointer;
                transition: background .18s ease, color .18s ease;
            }

                .modal-close:hover {
                    background: var(--border);
                    color: var(--navy);
                }

            .modal-body {
                padding: 22px;
            }

            .modal-footer {
                padding: 16px 22px;
                border-top: 1px solid var(--border);
                display: flex;
                justify-content: flex-end;
                gap: 10px;
                background: var(--offwhite);
            }

            .modal-subtitle {
                color: var(--muted);
                font-size: 0.82rem;
                margin: 5px 0 20px;
            }

            .modal-form-group {
                margin-bottom: 17px;
            }

            .required {
                color: var(--red);
            }

            .receive-info {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 10px;
                margin-bottom: 20px;
            }

            .info-box {
                background: var(--offwhite);
                border: 1px solid var(--border);
                padding: 12px;
                border-radius: 10px;
            }

            .info-label {
                font-size: 0.65rem;
                text-transform: uppercase;
                color: var(--muted);
                margin-bottom: 4px;
            }

            .info-value {
                font-size: 0.83rem;
                font-weight: 700;
                color: var(--navy);
            }

            .receive-item {
                border: 1px solid var(--border);
                border-radius: 10px;
                padding: 13px;
                margin-bottom: 10px;
                display: grid;
                grid-template-columns: 1fr 100px 160px;
                gap: 15px;
                align-items: center;
            }

            .receive-item-name {
                font-weight: 700;
                font-size: 0.83rem;
                color: var(--navy);
            }

            .receive-item-qty {
                font-size: 0.75rem;
                color: var(--muted);
            }

            @@media (max-width: 768px) {

                .topbar {
                    padding: 0 20px;
                }

                .user-email {
                    display: none;
                }

                .sidebar {
                    display: none;
                }

                .main {
                    padding: 20px 16px;
                }

                .header-row {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .receive-item {
                    grid-template-columns: 1fr;
                }

                .receive-info {
                    grid-template-columns: 1fr;
                }
            }

    </style>

</head>


<body>


    <!-- ============================================================
         TOPBAR
         ============================================================ -->

    <div class="topbar">

        <a class="brand"
           asp-controller="Home"
           asp-action="Index">

            <div class="brand-icon">

                <svg viewBox="0 0 24 24">

                    <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" />

                    <circle cx="12"
                            cy="17"
                            r="4"
                            opacity="0.6" />

                </svg>

            </div>


            <div class="brand-name">

                NMB-HLabSys

                <span>
                    Haematology Lab System
                </span>

            </div>

        </a>


        <div class="topbar-right">

            <div class="user-chip">

                <div class="user-avatar">

                    @(string.IsNullOrWhiteSpace(email)
                        ? "M"
                        : email.Substring(0, 1).ToUpper())

                </div>

                <span class="user-email">
                    @email
                </span>

            </div>


            <a asp-controller="Home"
               asp-action="Logout"
               class="logout-btn"
               id="logout-btn">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round">

                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />

                    <polyline points="16 17 21 12 16 7" />

                    <line x1="21"
                          y1="12"
                          x2="9"
                          y2="12" />

                </svg>

                Sign Out

            </a>

        </div>

    </div>


    <div class="page">


        <!-- ============================================================
             SIDEBAR
             ============================================================ -->

        <aside class="sidebar">

            <div class="nav-section">

                <div class="nav-label">
                    Main
                </div>


                <a asp-controller="ManagerDashboard"
                   asp-action="Index"
                   class="nav-item">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round">

                        <rect x="3"
                              y="3"
                              width="7"
                              height="7" />

                        <rect x="14"
                              y="3"
                              width="7"
                              height="7" />

                        <rect x="3"
                              y="14"
                              width="7"
                              height="7" />

                        <rect x="14"
                              y="14"
                              width="7"
                              height="7" />

                    </svg>

                    Dashboard

                </a>


                <a asp-controller="TestCatalogue"
                   asp-action="Index"
                   class="nav-item">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round">

                        <path d="M9 3v11a3 3 0 006 0V3" />

                        <line x1="6"
                              y1="3"
                              x2="18"
                              y2="3" />

                    </svg>

                    Test Catalogue

                </a>


                <a asp-controller="Consumable"
                   asp-action="Index"
                   class="nav-item">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round">

                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />

                        <polyline points="14 2 14 8 20 8" />

                    </svg>

                    Consumables

                </a>


                <a asp-controller="Staff"
                   asp-action="Index"
                   class="nav-item">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round">

                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />

                        <circle cx="12"
                                cy="7"
                                r="4" />

                    </svg>

                    Staff

                </a>


                <a asp-controller="ConsumableOrder"
                   asp-action="Index"
                   class="nav-item active">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round">

                        <path d="M22 12h-4l-3 9L9 3l-3 9H2" />

                    </svg>

                    Orders

                </a>


                <a asp-controller="ManagerDashboard"
                   asp-action="TestsByCategory"
                   class="nav-item">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round">

                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />

                        <polyline points="14 2 14 8 20 8" />

                        <line x1="16"
                              y1="13"
                              x2="8"
                              y2="13" />

                        <line x1="16"
                              y1="17"
                              x2="8"
                              y2="17" />

                    </svg>

                    Reports

                </a>

            </div>


            <div class="nav-section">

                <div class="nav-label">
                    System
                </div>


                <a asp-controller="ManagerDashboard"
                   asp-action="Profile"
                   class="nav-item">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round">

                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />

                        <circle cx="12"
                                cy="7"
                                r="4" />

                    </svg>

                    Profile

                </a>


                <a asp-controller="ManagerDashboard"
                   asp-action="AuditLog"
                   class="nav-item">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round">

                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />

