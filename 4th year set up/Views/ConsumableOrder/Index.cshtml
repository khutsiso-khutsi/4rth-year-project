                          id="table-count">

                        @orders.Count() order(s)

                    </span>

                </div>


                <div class="table-wrapper">

                    <table id="orders-table">

                        <thead>

                            <tr>

                                <th>
                                    Order Number
                                </th>

                                <th>
                                    Supplier
                                </th>

                                <th>
                                    Items
                                </th>

                                <th>
                                    Order Date
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @if (orders.Any())
                            {
                                foreach (var order in orders)
                                {
                                    var statusClass =
                                        order.Status == "Ordered"
                                            ? "status-ordered"
                                            : order.Status == "Partially Complete"
                                                ? "status-partial"
                                                : order.Status == "Complete"
                                                    ? "status-complete"
                                                    : "status-cancelled";


                                    var supplierName =
                                        suppliers
                                            .FirstOrDefault(
                                                s => s.SupplierID == order.SupplierID
                                            )
                                            ?.SupplierName
                                        ?? $"Supplier #{order.SupplierID}";


                                    <tr class="order-row"
                                        data-search="@($"{order.OrderNumber} {supplierName} {order.Items} {order.Status}")"
                                        data-order-id="@order.Id"
                                        data-order-number="@order.OrderNumber"
                                        data-supplier="@supplierName"
                                        data-order-date="@order.OrderDate.ToString("dd MMM yyyy HH:mm")"
                                        data-items="@order.Items">

                                        <td>

                                            <div class="order-number">
                                                @order.OrderNumber
                                            </div>

                                        </td>


                                        <td>

                                            <div class="supplier-name">
                                                @supplierName
