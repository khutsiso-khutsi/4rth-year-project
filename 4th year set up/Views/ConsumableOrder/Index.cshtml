    <!-- ============================================================
         JAVASCRIPT
         ============================================================ -->

    <script>
            document.addEventListener("DOMContentLoaded", function () {

                /* =========================================================
                   DATA FROM RAZOR
                ========================================================= */

                const consumableOptions = @Html.Raw(
                                    JsonSerializer.Serialize(
                                            consumables.Select(c => new
                                            {
                                                    id = c.ConsumableID,
                                                    name = c.ConsumableName
                                            })
                                    )
                            );

                const supplierOptions = @Html.Raw(
                                    JsonSerializer.Serialize(
                                            suppliers.Select(s => new
                                            {
                                                    id = s.SupplierID,
                                                    name = s.SupplierName
                                            })
                                    )
                            );


                /* =========================================================
                   HELPER FUNCTIONS
                ========================================================= */

                function normalizeName(value) {

                    return (value || "")
                        .toString()
                        .trim()
                        .toLowerCase()
                        .replace(/\s+/g, " ");
                }


                function findConsumables(searchText) {

                    const search = normalizeName(searchText);

                    if (!search) {
                        return [];
                    }

                    return consumableOptions.filter(function (item) {

                        const itemName = normalizeName(item.name);

                        return itemName.includes(search);
                    });
                }


                function findConsumable(searchText) {

                    const search = normalizeName(searchText);

                    if (!search) {
                        return null;
                    }

                    /*
                     * First look for an exact match.
                     */
                    let match = consumableOptions.find(function (item) {

                        return normalizeName(item.name) === search;
                    });

                    if (match) {
                        return match;
                    }

                    /*
                     * If there is no exact match, allow partial matching.
                     *
                     * Example:
                     * "Tubes" -> "EDTA Tubes"
                     * "EDTA"  -> "EDTA Tubes"
                     */
                    const matches = findConsumables(search);

                    /*
                     * Only automatically select a partial match
                     * when there is exactly ONE possible match.
                     */
                    if (matches.length === 1) {
                        return matches[0];
                    }

                    return null;
                }


                function getAntiForgeryToken() {

                    const token = document.querySelector(
                        '#antiForgeryForm input[name="__RequestVerificationToken"]'
                    );

                    return token ? token.value : "";
                }


                /* =========================================================
                   GLOBAL MODAL FUNCTIONS
                ========================================================= */

                window.openModal = function (id) {

                    const modal = document.getElementById(id);

                    if (!modal) {
                        return;
                    }

                    modal.classList.add("show");
                    modal.style.display = "flex";
                };


                window.closeModal = function (id) {

                    const modal = document.getElementById(id);

                    if (!modal) {
                        return;
                    }

                    modal.classList.remove("show");
                    modal.style.display = "none";
                };


                window.closeAlert = function (id) {

                    const alertElement = document.getElementById(id);

                    if (alertElement) {
                        alertElement.remove();
                    }
                };


                /* =========================================================
                   ALERT CLOSE BUTTONS
                ========================================================= */

                document.querySelectorAll(".alert-close").forEach(function (button) {

                    button.addEventListener("click", function () {

                        const alertElement = this.closest(".alert");

                        if (alertElement) {
                            alertElement.remove();
                        }
                    });
                });


                /* =========================================================
                   CONSUMABLE AUTOCOMPLETE
                ========================================================= */

                function bindConsumableAutocomplete(row) {

                    if (!row) {
                        return;
                    }

                    const input = row.querySelector(".consumable-input");
                    const hiddenId = row.querySelector(".consumable-id");
                    const results = row.querySelector(".consumable-results");

                    if (!input || !hiddenId || !results) {
                        return;
                    }


                    /*
                     * INPUT
                     */
                    input.addEventListener("input", function () {

                        const search = normalizeName(this.value);

                        /*
                         * The user changed the name,
                         * therefore the previous ID may no longer be valid.
                         */
                        hiddenId.value = "";

                        results.innerHTML = "";
                        results.style.display = "none";

                        if (!search) {
                            return;
                        }


                        const matches = findConsumables(search);

                        if (matches.length === 0) {
                            return;
                        }


                        matches.forEach(function (consumable) {

                            const result = document.createElement("div");

                            result.className = "consumable-result";

                            result.textContent = consumable.name;

                            result.dataset.id = consumable.id;


                            /*
                             * Use mousedown instead of click.
                             *
                             * This prevents the input blur event from
                             * happening before the suggestion is selected.
                             */
                            result.addEventListener("mousedown", function (event) {

                                event.preventDefault();

                                input.value = consumable.name;

                                hiddenId.value = consumable.id;

                                results.innerHTML = "";
                                results.style.display = "none";
                            });


                            results.appendChild(result);
                        });


                        results.style.display = "block";
                    });


                    /*
                     * BLUR
                     */
                    input.addEventListener("blur", function () {

                        setTimeout(function () {

                            const typedName = input.value.trim();

                            if (!typedName) {

                                hiddenId.value = "";

                                results.innerHTML = "";
                                results.style.display = "none";

                                return;
                            }


                            /*
                             * Try to automatically resolve the name.
                             */
                            const match = findConsumable(typedName);


                            if (match) {

                                input.value = match.name;

                                hiddenId.value = match.id;
                            }


                            results.innerHTML = "";
                            results.style.display = "none";

                        }, 200);
                    });


                    /*
                     * ENTER
                     */
                    input.addEventListener("keydown", function (event) {

                        if (event.key !== "Enter") {
                            return;
                        }

                        event.preventDefault();


                        const typedName = input.value.trim();

                        if (!typedName) {
                            return;
                        }


                        /*
                         * Exact or unique partial match.
                         */
                        const match = findConsumable(typedName);

                        if (match) {

                            input.value = match.name;

                            hiddenId.value = match.id;

                            results.innerHTML = "";
                            results.style.display = "none";

                            return;
                        }


                        /*
                         * If there are multiple matches,
                         * select the first suggestion.
                         *
                         * Example:
                         *
                         * Tubes
                         *   -> EDTA Tubes
                         *   -> Citrate Tubes
                         *
                         * The suggestions remain available,
                         * and the first result can be selected.
                         */
                        const matches = findConsumables(typedName);

                        if (matches.length > 0) {

                            const firstMatch = matches[0];

                            input.value = firstMatch.name;

                            hiddenId.value = firstMatch.id;

                            results.innerHTML = "";
                            results.style.display = "none";
                        }
                    });
                }


                /* =========================================================
                   INITIALISE FIRST ORDER ITEM
                ========================================================= */

                const firstOrderRow = document.querySelector(
                    "#order-items-container .order-item-row"
                );

                if (firstOrderRow) {

                    bindConsumableAutocomplete(firstOrderRow);
                }


                /* =========================================================
                   ADD CONSUMABLE BUTTON
                ========================================================= */

                const addItemButton = document.getElementById("add-item-btn");

                if (addItemButton) {

                    addItemButton.addEventListener("click", function () {

                        const container = document.getElementById(
                            "order-items-container"
                        );

                        if (!container) {
                            return;
                        }


                        const existingRows = container.querySelectorAll(
                            ".order-item-row"
                        );


                        if (existingRows.length === 0) {
                            return;
                        }


                        const firstRow = existingRows[0];

                        const newRow = firstRow.cloneNode(true);


                        /*
                         * Clear the cloned values.
                         */
                        const input = newRow.querySelector(
                            ".consumable-input"
                        );

                        const hiddenId = newRow.querySelector(
                            ".consumable-id"
                        );

                        const quantity = newRow.querySelector(
                            ".quantity-input"
                        );

                        const results = newRow.querySelector(
                            ".consumable-results"
                        );


                        if (input) {
                            input.value = "";
                        }

                        if (hiddenId) {
                            hiddenId.value = "";
                        }

                        if (quantity) {
                            quantity.value = "";
                        }

                        if (results) {
                            results.innerHTML = "";
                            results.style.display = "none";
                        }


                        /*
                         * Add the new row.
                         */
                        container.appendChild(newRow);


                        /*
                         * Bind autocomplete to the new row.
                         */
                        bindConsumableAutocomplete(newRow);
                    });
                }


                /* =========================================================
                   REMOVE CONSUMABLE ITEM
                ========================================================= */

                document.addEventListener("click", function (event) {

                    const removeButton = event.target.closest(
                        ".remove-item-btn"
                    );

                    if (!removeButton) {
                        return;
                    }


                    const container = document.getElementById(
                        "order-items-container"
                    );

                    if (!container) {
                        return;
                    }


                    const rows = container.querySelectorAll(
                        ".order-item-row"
                    );


                    /*
                     * Always keep at least one row.
                     */
                    if (rows.length <= 1) {

                        const row = rows[0];

                        if (row) {

                            const input = row.querySelector(
                                ".consumable-input"
                            );

                            const hiddenId = row.querySelector(
                                ".consumable-id"
                            );

                            const quantity = row.querySelector(
                                ".quantity-input"
                            );

                            const results = row.querySelector(
                                ".consumable-results"
                            );


                            if (input) {
                                input.value = "";
                            }

                            if (hiddenId) {
                                hiddenId.value = "";
                            }

                            if (quantity) {
                                quantity.value = "";
                            }

                            if (results) {
                                results.innerHTML = "";
                                results.style.display = "none";
                            }
                        }

                        return;
                    }


                    const row = removeButton.closest(".order-item-row");

                    if (row) {
                        row.remove();
                    }
                });


                /* =========================================================
                   CREATE ORDER FORM
                ========================================================= */

                const createOrderForm = document.getElementById(
                    "create-order-form"
                );


                if (createOrderForm) {

                    createOrderForm.addEventListener("submit", function (event) {

                        event.preventDefault();


                        const supplierElement = document.getElementById(
                            "order-supplier"
                        );


                        if (!supplierElement || !supplierElement.value) {

                            alert("Please select a supplier.");

                            if (supplierElement) {
                                supplierElement.focus();
                            }

                            return;
                        }


                        const container = document.getElementById(
                            "order-items-container"
                        );


                        if (!container) {

                            alert(
                                "Unable to find the consumable items section."
                            );

                            return;
                        }


                        const rows = container.querySelectorAll(
                            ".order-item-row"
                        );


                        const orderItems = [];

                        const usedConsumables = new Set();


                        for (const row of rows) {

                            const input = row.querySelector(
                                ".consumable-input"
                            );

                            const hiddenId = row.querySelector(
                                ".consumable-id"
                            );

                            const quantityInput = row.querySelector(
                                ".quantity-input"
                            );


                            const typedName = input
                                ? input.value.trim()
                                : "";


                            const quantity = quantityInput
                                ? parseInt(quantityInput.value, 10)
                                : 0;


                            /*
                             * Ignore completely empty rows.
                             */
                            if (!typedName && !quantity) {
                                continue;
                            }


                            /*
                             * If the user entered a name but
                             * the hidden ID is empty, resolve it now.
                             */
                            let consumableId = hiddenId
                                ? parseInt(hiddenId.value, 10)
                                : 0;


                            if (!consumableId && typedName) {

                                const match = findConsumable(typedName);


                                if (match) {

                                    consumableId = parseInt(
                                        match.id,
                                        10
                                    );


                                    if (input) {
                                        input.value = match.name;
                                    }


                                    if (hiddenId) {
                                        hiddenId.value = consumableId;
                                    }
                                }
                            }


                            /*
                             * If there are multiple partial matches,
                             * try to find a name that starts with the
                             * typed value.
                             */
                            if (!consumableId && typedName) {

                                const normalizedTypedName =
                                    normalizeName(typedName);


                                const startsWithMatch =
                                    consumableOptions.find(function (item) {

                                        return normalizeName(item.name)
                                            .startsWith(normalizedTypedName);
                                    });


                                if (startsWithMatch) {

                                    consumableId = parseInt(
                                        startsWithMatch.id,
                                        10
                                    );


                                    if (input) {
                                        input.value =
                                            startsWithMatch.name;
                                    }


                                    if (hiddenId) {
                                        hiddenId.value =
                                            startsWithMatch.id;
                                    }
                                }
                            }


                            /*
                             * No valid consumable found.
                             */
                            if (!consumableId) {

                                alert(
                                    `"${typedName}" was not found. ` +
                                    "Please select a consumable from the suggestions."
                                );


                                if (input) {
                                    input.focus();
                                }

                                return;
                            }


                            /*
                             * Validate quantity.
                             */
                            if (
                                !Number.isInteger(quantity) ||
                                quantity <= 0
                            ) {

                                alert(
                                    `Please enter a valid quantity for "${typedName}".`
                                );


                                if (quantityInput) {
                                    quantityInput.focus();
                                }

                                return;
                            }


                            /*
                             * Prevent duplicate consumables.
                             */
                            if (usedConsumables.has(consumableId)) {

                                alert(
                                    `"${typedName}" has already been added to this order.`
                                );

                                if (input) {
                                    input.focus();
                                }

                                return;
                            }


                            usedConsumables.add(consumableId);


                            /*
                             * IMPORTANT:
                             *
                             * Only IDs and quantities are sent to SQL.
                             *
                             * This prevents:
                             *
                             * JSON text is not properly formatted
                             *
                             * errors caused by sending display text.
                             */
                            orderItems.push({
                                ConsumableID: consumableId,
                                QuantityOrdered: quantity
                            });
                        }


                        /*
                         * No valid items.
                         */
                        if (orderItems.length === 0) {

                            alert(
                                "Please add at least one consumable with a valid quantity."
                            );

                            return;
                        }


                        /*
                         * Convert to valid JSON.
                         */
                        const jsonInput = document.getElementById(
                            "order-items-json"
                        );


                        if (!jsonInput) {

                            alert(
                                "Unable to prepare the order items."
                            );

                            return;
                        }


                        jsonInput.value = JSON.stringify(orderItems);


                        /*
                         * Submit the form normally.
                         */
                        createOrderForm.submit();
                    });
                }


                /* =========================================================
                   RECEIVE ORDER
                ========================================================= */

                let currentReceiveOrderId = 0;


                function parseOrderItems(itemsText) {

                    if (!itemsText) {
                        return [];
                    }


                    /*
                     * First try JSON.
                     */
                    try {

                        const parsed = JSON.parse(itemsText);

                        if (Array.isArray(parsed)) {

                            return parsed.map(function (item) {

                                const id = parseInt(
                                    item.ConsumableID ??
                                    item.consumableID ??
                                    item.Id ??
                                    item.id ??
                                    0,
                                    10
                                );


                                const quantity = parseInt(
                                    item.QuantityOrdered ??
                                    item.quantityOrdered ??
                                    item.Quantity ??
                                    item.quantity ??
                                    0,
                                    10
                                );


                                let name =
                                    item.ConsumableName ??
                                    item.consumableName ??
                                    item.Name ??
                                    item.name ??
                                    "";


                                if (!name && id) {

                                    const consumable =
                                        consumableOptions.find(function (c) {

                                            return parseInt(c.id, 10) === id;
                                        });


                                    if (consumable) {
                                        name = consumable.name;
                                    }
                                }


                                return {
                                    id: id,
                                    name: name || "Unknown Consumable",
                                    quantity: quantity
                                };
                            });
                        }

                    } catch (error) {

                        /*
                         * Not JSON.
                         * Continue to legacy text parsing.
                         */
                    }


                    /*
                     * Legacy format:
                     *
                     * EDTA Tubes (20), Gloves (50)
                     */
                    const result = [];


                    const parts = itemsText.split(",");


                    parts.forEach(function (part) {

                        const text = part.trim();

                        if (!text) {
                            return;
                        }


                        const match = text.match(
                            /^(.+?)\s*\((\d+)\)\s*$/
                        );


                        if (match) {

                            const name = match[1].trim();

                            const quantity = parseInt(
                                match[2],
                                10
                            );


                            const consumable =
                                findConsumable(name);


                            result.push({
                                id: consumable
                                    ? parseInt(consumable.id, 10)
                                    : 0,

                                name: consumable
                                    ? consumable.name
                                    : name,

                                quantity: quantity
                            });

                        } else {

                            const consumable =
                                findConsumable(text);


                            result.push({
                                id: consumable
                                    ? parseInt(consumable.id, 10)
                                    : 0,

                                name: consumable
                                    ? consumable.name
                                    : text,

                                quantity: 0
                            });
                        }
                    });


                    return result;
                }


                function createReceiveItem(item) {

                    const wrapper = document.createElement("div");

                    wrapper.className = "receive-item";


                    wrapper.dataset.consumableId =
                        item.id || "0";


                    wrapper.dataset.consumableName =
                        item.name || "";


                    wrapper.innerHTML = `
                        <div>
                            <strong>${escapeHtml(item.name)}</strong>
                        </div>

                        <div>
                            <input
                                type="number"
                                class="form-input receive-quantity"
                                min="0"
                                step="1"
                                value="${item.quantity || 0}"
                                data-consumable-id="${item.id || 0}"
                                style="width:100%;"
                            />
                        </div>
                    `;


                    return wrapper;
                }


                function escapeHtml(value) {

                    return (value || "")
                        .toString()
                        .replace(/&/g, "&amp;")
                        .replace(/</g, "&lt;")
                        .replace(/>/g, "&gt;")
                        .replace(/"/g, "&quot;")
                        .replace(/'/g, "&#039;");
                }


                document.addEventListener("click", function (event) {

                    const receiveButton =
                        event.target.closest(".receive-order-btn");


                    if (!receiveButton) {
                        return;
                    }


                    const orderRow =
                        receiveButton.closest(".order-row");


                    if (!orderRow) {
                        return;
                    }


                    currentReceiveOrderId =
                        parseInt(
                            receiveButton.dataset.orderId ||
                            orderRow.dataset.orderId ||
                            "0",
                            10
                        );


                    if (!currentReceiveOrderId) {

                        alert("Invalid order.");

                        return;
                    }


                    const orderNumber =
                        orderRow.dataset.orderNumber || "";


                    const supplier =
                        orderRow.dataset.supplier || "";


                    const orderDate =
                        orderRow.dataset.orderDate || "";


                    const itemsText =
                        orderRow.dataset.items || "";


                    /*
                     * Populate modal information.
                     */
                    const orderNumberElement =
                        document.getElementById("recv-order-number");


                    const supplierElement =
                        document.getElementById("recv-supplier");


                    const dateElement =
                        document.getElementById("recv-date");


                    const subElement =
                        document.getElementById("recv-sub");


                    if (orderNumberElement) {
                        orderNumberElement.textContent =
                            orderNumber;
                    }


                    if (supplierElement) {
                        supplierElement.textContent =
                            supplier;
                    }


                    if (dateElement) {
                        dateElement.textContent =
                            orderDate;
                    }


                    if (subElement) {

                        subElement.textContent =
                            `Receive items for order ${orderNumber}`;
                    }


                    /*
                     * Populate receive items.
                     */
                    const itemsContainer =
                        document.getElementById("recv-items-list");


                    if (!itemsContainer) {
                        return;
                    }


                    itemsContainer.innerHTML = "";


                    const items =
                        parseOrderItems(itemsText);


                    if (items.length === 0) {

                        itemsContainer.innerHTML = `
                            <div style="padding:15px;">
                                No consumable items were found for this order.
                            </div>
                        `;

                    } else {

                        items.forEach(function (item) {

                            itemsContainer.appendChild(
                                createReceiveItem(item)
                            );
                        });
                    }


                    openModal("m-receive-order");
                });


                /* =========================================================
                   CONFIRM RECEIVE ORDER
                ========================================================= */

                const receiveForm =
                    document.getElementById("receive-order-form");


                if (receiveForm) {

                    receiveForm.addEventListener(
                        "submit",
                        async function (event) {

                            event.preventDefault();


                            if (!currentReceiveOrderId) {

                                alert("Invalid order.");

                                return;
                            }


                            const receiveInputs =
                                document.querySelectorAll(
                                    "#recv-items-list .receive-quantity"
                                );


                            const receivedItems = [];


                            for (const input of receiveInputs) {

                                const quantity =
                                    parseInt(
                                        input.value || "0",
                                        10
                                    );


                                const consumableId =
                                    parseInt(
                                        input.dataset.consumableId ||
                                        "0",
                                        10
                                    );


                                if (
                                    !Number.isInteger(quantity) ||
                                    quantity < 0
                                ) {

                                    alert(
                                        "Please enter valid received quantities."
                                    );

                                    input.focus();

                                    return;
                                }


                                /*
                                 * Only send items with quantity > 0.
                                 */
                                if (quantity > 0) {

                                    if (!consumableId) {

                                        alert(
                                            "A consumable could not be identified."
                                        );

                                        return;
                                    }


                                    receivedItems.push({
                                        ConsumableID:
                                            consumableId,

                                        QuantityReceived:
                                            quantity
                                    });
                                }
                            }


                            if (receivedItems.length === 0) {

                                alert(
                                    "Please enter at least one received quantity."
                                );

                                return;
                            }


                            const submitButton =
                                receiveForm.querySelector(
                                    'button[type="submit"]'
                                );


                            const originalText =
                                submitButton
                                    ? submitButton.textContent
                                    : "";


                            if (submitButton) {

                                submitButton.disabled = true;

                                submitButton.textContent =
                                    "Processing...";
                            }


                            try {

                                const response =
                                    await fetch(
                                        '@Url.Action("ReceiveOrder", "ConsumableOrder")',
                                        {
                                            method: "POST",

                                            headers: {
                                                "Content-Type":
                                                    "application/json",

                                                "RequestVerificationToken":
                                                    getAntiForgeryToken()
                                            },

                                            body: JSON.stringify({
                                                orderId:
                                                    currentReceiveOrderId,

                                                receivedItems:
                                                    receivedItems
                                            })
                                        }
                                    );


                                if (!response.ok) {

                                    throw new Error(
                                        "Unable to receive order."
                                    );
                                }


                                const contentType =
                                    response.headers.get(
                                        "content-type"
                                    ) || "";


                                if (
                                    contentType.includes(
                                        "application/json"
                                    )
                                ) {

                                    const result =
                                        await response.json();


                                    if (
                                        result &&
                                        result.success === false
                                    ) {

                                        throw new Error(
                                            result.message ||
                                            "Unable to receive order."
                                        );
                                    }
                                }


                                closeModal("m-receive-order");

                                window.location.reload();

                            } catch (error) {

                                alert(
                                    error.message ||
                                    "An error occurred while receiving the order."
                                );

                            } finally {

                                if (submitButton) {

                                    submitButton.disabled = false;

                                    submitButton.textContent =
                                        originalText;
                                }
                            }
                        }
                    );
                }


                /* =========================================================
                   CANCEL ORDER
                ========================================================= */

                document.addEventListener("click", function (event) {

                    const cancelButton =
                        event.target.closest(".cancel-order-btn");


                    if (!cancelButton) {
                        return;
                    }


                    const orderId =
                        cancelButton.dataset.orderId || "";


                    const orderNumber =
                        cancelButton.dataset.orderNumber || "";


                    const supplier =
                        cancelButton.dataset.supplier || "";


                    const orderIdInput =
                        document.getElementById("cancel-order-id");


                    const reasonInput =
                        document.getElementById("cancel-reason");


                    const subElement =
                        document.getElementById("cancel-sub");


                    if (orderIdInput) {

                        orderIdInput.value =
                            orderId;
                    }


                    if (reasonInput) {

                        reasonInput.value = "";
                    }


                    if (subElement) {

                        subElement.textContent =
                            `Order ${orderNumber} — ${supplier}`;
                    }


                    openModal("m-cancel-order");
                });


                /* =========================================================
                   CANCEL ORDER FORM
                ========================================================= */

                const cancelOrderForm =
                    document.getElementById("cancel-order-form");


                if (cancelOrderForm) {

                    cancelOrderForm.addEventListener(
                        "submit",
                        function (event) {

                            const orderId =
                                document.getElementById(
                                    "cancel-order-id"
                                );


                            const reason =
                                document.getElementById(
                                    "cancel-reason"
                                );


                            if (
                                !orderId ||
                                !orderId.value ||
                                parseInt(orderId.value, 10) <= 0
                            ) {

                                event.preventDefault();

                                alert("Invalid order.");

                                return;
                            }


                            if (
                                !reason ||
                                !reason.value.trim()
                            ) {

                                event.preventDefault();

                                alert(
                                    "Please enter a cancellation reason."
                                );

                                if (reason) {
                                    reason.focus();
                                }

                                return;
                            }
                        }
                    );
                }


                /* =========================================================
                   LOGOUT MODAL
                ========================================================= */

                const logoutButton =
                    document.getElementById("logout-btn");


                const logoutModal =
                    document.getElementById("logout-modal");


                const logoutConfirm =
                    document.getElementById("logout-confirm");


                const logoutCancel =
                    document.getElementById("logout-cancel");


                if (logoutButton && logoutModal) {

                    logoutButton.addEventListener(
                        "click",
                        function (event) {

                            event.preventDefault();


                            if (logoutConfirm) {

                                logoutConfirm.href =
                                    logoutButton.href;
                            }


                            logoutModal.style.display =
                                "flex";
                        }
                    );
                }


                if (logoutCancel && logoutModal) {

                    logoutCancel.addEventListener(
                        "click",
                        function () {

                            logoutModal.style.display =
                                "none";
                        }
                    );
                }


                /* =========================================================
                   ESC KEY
                ========================================================= */

                document.addEventListener(
                    "keydown",
                    function (event) {

                        if (event.key !== "Escape") {
                            return;
                        }


                        document
                            .querySelectorAll(".modal-overlay.show")
                            .forEach(function (modal) {

                                modal.classList.remove("show");

                                modal.style.display = "none";
                            });


                        if (logoutModal) {

                            logoutModal.style.display =
                                "none";
                        }
                    }
                );


                /* =========================================================
                   CLICK OUTSIDE MODAL
                ========================================================= */

                document.addEventListener(
                    "click",
                    function (event) {

                        if (
                            event.target.classList.contains(
                                "modal-overlay"
                            )
                        ) {

                            event.target.classList.remove(
                                "show"
                            );

                            event.target.style.display =
                                "none";
                        }
                    }
                );


                /* =========================================================
                   SEARCH ORDERS
                ========================================================= */

                const searchInput =
                    document.getElementById("order-search");


                if (searchInput) {

                    searchInput.addEventListener(
                        "input",
                        function () {

                            const search =
                                normalizeName(
                                    this.value
                                );


                            const rows =
                                document.querySelectorAll(
                                    "#orders-table tbody .order-row"
                                );


                            rows.forEach(function (row) {

                                const rowText =
                                    normalizeName(
                                        row.dataset.search ||
                                        row.textContent
                                    );


                                if (
                                    !search ||
                                    rowText.includes(search)
                                ) {

                                    row.style.display = "";

                                } else {

                                    row.style.display =
                                        "none";
                                }
                            });
                        }
                    );
                }


                /* =========================================================
                   CLOSE BUTTONS FOR MODALS
                ========================================================= */

                document.querySelectorAll(
                    "[data-close-modal]"
                ).forEach(function (button) {

                    button.addEventListener(
                        "click",
                        function () {

                            const modalId =
                                this.dataset.closeModal;


                            if (modalId) {

                                closeModal(modalId);
                            }
                        }
                    );
                });


                /* =========================================================
                   END
                ========================================================= */

            });
    </script>

</body>

</html>