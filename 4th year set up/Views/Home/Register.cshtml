@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@@0;1&family=DM+Sans:wght@@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --teal: #0d9488;
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--navy);
            color: var(--navy);
            min-height: 100vh;
            display: flex;
            overflow: hidden;
        }

        /* LEFT PANEL */
        .left-panel {
            width: 42%;
            min-width: 280px;
            background: var(--navy);
            display: flex;
            flex-direction: column;
            padding: clamp(24px, 4vw, 48px);
            position: relative;
            overflow: hidden;
            flex-shrink: 0;
        }

            .left-panel::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 70% 60% at 80% 30%, rgba(13,148,136,0.15) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 10% 80%, rgba(26,79,138,0.25) 0%, transparent 55%);
            }

            .left-panel::after {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
                background-size: 48px 48px;
            }

        .panel-content {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            height: 100%;
            justify-content: space-between;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .brand-logo {
            width: 38px;
            height: 38px;
            background: var(--teal);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .brand-logo svg {
                width: 20px;
                height: 20px;
                fill: white;
            }

        .brand-title {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(0.95rem, 1.2vw, 1.15rem);
            color: var(--white);
            line-height: 1.2;
        }

            .brand-title span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.62rem;
                font-weight: 300;
                color: rgba(255,255,255,0.45);
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

        .panel-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: clamp(24px, 4vh, 60px) 0 clamp(16px, 3vh, 40px);
        }

        .panel-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(13,148,136,0.15);
            border: 1px solid rgba(13,148,136,0.3);
            color: #5eead4;
            font-size: 0.7rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 5px 12px;
            border-radius: 100px;
            margin-bottom: clamp(12px, 2vh, 24px);
            width: fit-content;
        }

            .panel-tag::before {
                content: '';
                width: 6px;
                height: 6px;
                background: #5eead4;
                border-radius: 50%;
            }

        .panel-heading {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.6rem, 2.5vw, 2.8rem);
            color: white;
            line-height: 1.2;
            margin-bottom: clamp(10px, 1.5vh, 20px);
        }

            .panel-heading em {
                font-style: italic;
                color: #5eead4;
            }

        .panel-desc {
            color: rgba(255,255,255,0.5);
            font-size: clamp(0.8rem, 0.9vw, 0.9rem);
            line-height: 1.75;
            font-weight: 300;
            max-width: 320px;
        }

        .info-tiles {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .info-tile {
            display: flex;
            align-items: center;
            gap: 14px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 12px;
            padding: 12px 16px;
        }

        .tile-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .tile-icon svg {
                width: 15px;
                height: 15px;
            }

        .tile-text {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.55);
            line-height: 1.4;
        }

            .tile-text strong {
                display: block;
                color: rgba(255,255,255,0.85);
                font-weight: 500;
                margin-bottom: 2px;
            }

        /* RIGHT PANEL */
        .right-panel {
            flex: 1;
            background: var(--offwhite);
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: clamp(16px, 3vw, 40px);
            overflow-y: auto;
            height: 100vh;
        }

        .form-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: clamp(24px, 3vw, 40px) clamp(20px, 2.5vw, 36px);
            width: 100%;
            max-width: 420px;
            box-shadow: 0 4px 40px rgba(11,31,58,0.08);
            margin: auto 0;
        }

        .form-header {
            margin-bottom: clamp(16px, 2vh, 28px);
        }

            .form-header h2 {
                font-family: 'DM Serif Display', serif;
                font-size: clamp(1.4rem, 2vw, 1.8rem);
                color: var(--navy);
                margin-bottom: 6px;
            }

            .form-header p {
                color: var(--muted);
                font-size: 0.85rem;
                line-height: 1.5;
            }

        .field {
            margin-bottom: clamp(10px, 1.5vh, 16px);
        }

            .field label {
                display: block;
                font-size: 0.8rem;
                font-weight: 600;
                color: var(--navy);
                margin-bottom: 5px;
                letter-spacing: 0.01em;
            }

        .input-wrap {
            position: relative;
        }

            .input-wrap input, .input-wrap select {
                width: 100%;
                padding: 10px 14px;
                border: 1.5px solid var(--border);
                border-radius: 9px;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.88rem;
                color: var(--navy);
                background: var(--offwhite);
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
                appearance: none;
            }

                .input-wrap input:focus, .input-wrap select:focus {
                    border-color: var(--teal);
                    background: white;
                    box-shadow: 0 0 0 3px rgba(13,148,136,0.1);
                }

                .input-wrap input.valid, .input-wrap select.valid {
                    border-color: var(--green);
                    background: white;
                }

                .input-wrap input.invalid, .input-wrap select.invalid {
                    border-color: var(--red);
                    background: white;
                }

        .select-arrow {
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            pointer-events: none;
            color: var(--muted);
        }

        .toggle-pw {
            position: absolute;
            right: 11px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            color: var(--muted);
            display: flex;
            align-items: center;
            transition: color 0.2s;
        }

            .toggle-pw:hover {
                color: var(--navy);
            }

            .toggle-pw svg {
                width: 16px;
                height: 16px;
            }

        .val-msg {
            font-size: 0.73rem;
            margin-top: 4px;
            min-height: 16px;
            display: flex;
            align-items: center;
            gap: 5px;
            opacity: 0;
            transition: opacity 0.2s;
        }

            .val-msg.show {
                opacity: 1;
            }

            .val-msg.error {
                color: var(--red);
            }

            .val-msg.success {
                color: var(--green);
            }

            .val-msg svg {
                width: 12px;
                height: 12px;
                flex-shrink: 0;
            }

        .strength-bar {
            display: flex;
            gap: 4px;
            margin-top: 6px;
        }

            .strength-bar span {
                flex: 1;
                height: 3px;
                border-radius: 100px;
                background: var(--border);
                transition: background 0.3s;
            }

        .strength-label {
            font-size: 0.7rem;
            color: var(--muted);
            margin-top: 4px;
            min-height: 14px;
        }

        .alert-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 9px;
            padding: 10px 14px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 16px;
            font-size: 0.82rem;
            color: var(--red);
        }

            .alert-error svg {
                width: 15px;
                height: 15px;
                flex-shrink: 0;
                margin-top: 1px;
            }

        .btn-submit {
            width: 100%;
            background: var(--teal);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 9px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.92rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 6px;
        }

            .btn-submit:hover {
                background: #0f7a70;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(13,148,136,0.3);
            }

            .btn-submit svg {
                width: 16px;
                height: 16px;
            }

        .signin-link {
            text-align: center;
            margin-top: 16px;
            font-size: 0.82rem;
            color: var(--muted);
        }

            .signin-link a {
                color: var(--teal);
                text-decoration: none;
                font-weight: 500;
            }

                .signin-link a:hover {
                    text-decoration: underline;
                }

        /* RESPONSIVE */
        @@media (max-width: 960px) {
            .left-panel {
                width: 36%;
                min-width: 220px;
            }

            .info-tiles {
                display: none;
            }

            .panel-desc {
                display: none;
            }
        }

        @@media (max-width: 700px) {
            body {
                flex-direction: column;
                overflow: auto;
            }

            .left-panel {
                width: 100%;
                min-width: unset;
                padding: 20px 24px;
                flex-shrink: 0;
            }

            .panel-body {
                padding: 12px 0;
            }

            .panel-heading {
                font-size: 1.4rem;
            }

            .right-panel {
                height: auto;
                padding: 20px 16px 32px;
            }

            .form-card {
                border-radius: 16px;
            }
        }
    </style>
</head>
<body>

    <!-- LEFT PANEL -->
    <div class="left-panel">
        <div class="panel-content">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <div class="brand-logo">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" />
                        <circle cx="12" cy="17" r="4" opacity="0.6" />
                    </svg>
                </div>
                <div class="brand-title">
                    NMB-HLabSys
                    <span>Haematology Lab System</span>
                </div>
            </a>

            <div class="panel-body">
                <div class="panel-tag">New Account</div>
                <h2 class="panel-heading">Join <em>NMB</em><br />HLabSys</h2>
                <p class="panel-desc">Create your account to access your role-based portal — whether you're a doctor, technician, patient or administrator.</p>
            </div>

            <div class="info-tiles">
                <div class="info-tile">
                    <div class="tile-icon" style="background:rgba(13,148,136,0.15)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#5eead4" stroke-width="2" stroke-linecap="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </div>
                    <div class="tile-text">
                        <strong>Role-Based Access</strong>
                        Your portal loads automatically based on your role.
                    </div>
                </div>
                <div class="info-tile">
                    <div class="tile-icon" style="background:rgba(26,79,138,0.15)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#93c5fd" stroke-width="2" stroke-linecap="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        </svg>
                    </div>
                    <div class="tile-text">
                        <strong>Secure &amp; Private</strong>
                        All data is encrypted and access is fully audited.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="right-panel">
        <div class="form-card">
            <div class="form-header">
                <h2>Create Account</h2>
                <p>Fill in your details to get started.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div class="alert-error">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        <span>@error.ErrorMessage</span>
                    </div>
                }
            }

            <form id="registerForm" asp-controller="Home" asp-action="Register" method="post" novalidate>
                @Html.AntiForgeryToken()

                <!-- Username -->
                <div class="field">
                    <label for="username">Username</label>
                    <div class="input-wrap">
                        <input type="text" id="username" name="Username" placeholder="Choose a username" autocomplete="username" />
                    </div>
                    <div class="val-msg" id="username-msg"></div>
                </div>

                <!-- Email -->
                <div class="field">
                    <label for="email">Email</label>
                    <div class="input-wrap">
                        <input type="email" id="email" name="Email" placeholder="Enter your email address" autocomplete="email" />
                    </div>
                    <div class="val-msg" id="email-msg"></div>
                </div>

                <!-- Role -->
                <div class="field">
                    <label for="role">Role</label>
                    <div class="input-wrap">
                        <select id="role" name="RoleID">
                            <option value="">Select your role</option>
                            @if (ViewBag.Roles != null)
                            {
                                foreach (var role in ViewBag.Roles)
                                {
                                    <option value="@role.Item1">@role.Item2</option>
                                }
                            }
                        </select>
                        <div class="select-arrow">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9" /></svg>
                        </div>
                    </div>
                    <div class="val-msg" id="role-msg"></div>
                </div>

                <!-- Password -->
                <div class="field">
                    <label for="password">Password</label>
                    <div class="input-wrap">
                        <input type="password" id="password" name="Password" placeholder="Create a password" autocomplete="new-password" />
                        <button type="button" class="toggle-pw" id="togglePw1">
                            <svg id="eye1Show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg id="eye1Hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" /><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                        </button>
                    </div>
                    <div class="strength-bar"><span id="s1"></span><span id="s2"></span><span id="s3"></span><span id="s4"></span></div>
                    <div class="strength-label" id="strengthLabel"></div>
                    <div class="val-msg" id="password-msg"></div>
                </div>

                <!-- Confirm Password -->
                <div class="field">
                    <label for="confirmPassword">Confirm Password</label>
                    <div class="input-wrap">
                        <input type="password" id="confirmPassword" name="ConfirmPassword" placeholder="Repeat your password" autocomplete="new-password" />
                        <button type="button" class="toggle-pw" id="togglePw2">
                            <svg id="eye2Show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg id="eye2Hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" /><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                        </button>
                    </div>
                    <div class="val-msg" id="confirm-msg"></div>
                </div>

                <button type="submit" class="btn-submit">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="8.5" cy="7" r="4" />
                        <line x1="20" y1="8" x2="20" y2="14" />
                        <line x1="23" y1="11" x2="17" y2="11" />
                    </svg>
                    Create Account
                </button>
            </form>

            <p class="signin-link">Already have an account? <a asp-controller="Home" asp-action="Login">Sign in</a></p>
        </div>
    </div>

    <script>
        function setupToggle(btnId, inputId, showId, hideId) {
            document.getElementById(btnId).addEventListener('click', () => {
                const input = document.getElementById(inputId);
                const isHidden = input.type === 'password';
                input.type = isHidden ? 'text' : 'password';
                document.getElementById(showId).style.display = isHidden ? 'none' : '';
                document.getElementById(hideId).style.display = isHidden ? '' : 'none';
            });
        }
        setupToggle('togglePw1', 'password', 'eye1Show', 'eye1Hide');
        setupToggle('togglePw2', 'confirmPassword', 'eye2Show', 'eye2Hide');

        const bars = ['s1','s2','s3','s4'].map(id => document.getElementById(id));
        const strengthLabel = document.getElementById('strengthLabel');
        const strengthColors = ['#dc2626','#ea580c','#ca8a04','#16a34a'];
        const strengthNames = ['Weak','Fair','Good','Strong'];

        function getStrength(val) {
            let score = 0;
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;
            return score;
        }

        document.getElementById('password').addEventListener('input', function() {
            const val = this.value;
            if (!val) { bars.forEach(b => b.style.background = ''); strengthLabel.textContent = ''; return; }
            const score = getStrength(val);
            bars.forEach((b, i) => b.style.background = i < score ? strengthColors[score - 1] : '');
            strengthLabel.style.color = strengthColors[score - 1];
            strengthLabel.textContent = strengthNames[score - 1] + ' password';
        });

        function showMsg(id, type, text) {
            const el = document.getElementById(id);
            el.className = 'val-msg show ' + type;
            el.innerHTML = type === 'error'
                ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>${text}`
                : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>${text}`;
        }
        function clearMsg(id) { const el = document.getElementById(id); el.className = 'val-msg'; el.innerHTML = ''; }
        function setInputState(input, state) { input.classList.remove('valid','invalid'); if (state) input.classList.add(state); }

        const usernameInput = document.getElementById('username');
        const emailInput = document.getElementById('email');
        const roleInput = document.getElementById('role');
        const passwordInput = document.getElementById('password');
        const confirmInput = document.getElementById('confirmPassword');

        function validateUsername() {
            const val = usernameInput.value.trim();
            if (!val) { setInputState(usernameInput,'invalid'); showMsg('username-msg','error','Username is required.'); return false; }
            if (val.length < 3) { setInputState(usernameInput,'invalid'); showMsg('username-msg','error','At least 3 characters.'); return false; }
            if (/\s/.test(val)) { setInputState(usernameInput,'invalid'); showMsg('username-msg','error','No spaces allowed.'); return false; }
            setInputState(usernameInput,'valid'); showMsg('username-msg','success','Looks good!'); return true;
        }

        function validateEmail() {
            const val = emailInput.value.trim();
            if (!val) { setInputState(emailInput,'invalid'); showMsg('email-msg','error','Email is required.'); return false; }
            if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(val)) { setInputState(emailInput,'invalid'); showMsg('email-msg','error','Enter a valid email.'); return false; }
            setInputState(emailInput,'valid'); showMsg('email-msg','success','Looks good!'); return true;
        }

        function validateRole() {
            if (!roleInput.value) { setInputState(roleInput,'invalid'); showMsg('role-msg','error','Please select a role.'); return false; }
            setInputState(roleInput,'valid'); clearMsg('role-msg'); return true;
        }

        function validatePassword() {
            const val = passwordInput.value;
            if (!val) { setInputState(passwordInput,'invalid'); showMsg('password-msg','error','Password is required.'); return false; }
            if (val.length < 6) { setInputState(passwordInput,'invalid'); showMsg('password-msg','error','At least 6 characters.'); return false; }
            setInputState(passwordInput,'valid'); clearMsg('password-msg'); return true;
        }

        function validateConfirm() {
            const val = confirmInput.value;
            if (!val) { setInputState(confirmInput,'invalid'); showMsg('confirm-msg','error','Please confirm your password.'); return false; }
            if (val !== passwordInput.value) { setInputState(confirmInput,'invalid'); showMsg('confirm-msg','error','Passwords do not match.'); return false; }
            setInputState(confirmInput,'valid'); showMsg('confirm-msg','success','Passwords match!'); return true;
        }

        usernameInput.addEventListener('blur', validateUsername);
        emailInput.addEventListener('blur', validateEmail);
        roleInput.addEventListener('change', validateRole);
        passwordInput.addEventListener('blur', validatePassword);
        confirmInput.addEventListener('blur', validateConfirm);
        confirmInput.addEventListener('input', () => { if (confirmInput.classList.contains('invalid')) validateConfirm(); });

        document.getElementById('registerForm').addEventListener('submit', function(e) {
            const ok = [validateUsername(), validateEmail(), validateRole(), validatePassword(), validateConfirm()];
            if (ok.includes(false)) e.preventDefault();
        });
    </script>
</body>
</html>
