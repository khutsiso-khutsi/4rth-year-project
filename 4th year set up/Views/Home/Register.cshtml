@{
    ViewData["Title"] = "Register";
    Layout = null;
}
@functions {
    // After a failed submit the server sends this page back. Refill what the
    // user already typed (never the passwords) so they don't start over.
    string Posted(string key) =>
        Context.Request.HasFormContentType ? Context.Request.Form[key].ToString() : "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@@0;1&family=DM+Sans:wght@@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --teal: #0d9488;
            --teal-dark: #0f7a70;
            --teal-light: rgba(13,148,136,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--navy);
            color: var(--navy);
            min-height: 100vh;
            display: flex;
            overflow: hidden;
        }

        /* ── LEFT PANEL ── */
        .left-panel {
            width: 38%;
            min-width: 260px;
            background: var(--navy);
            display: flex;
            flex-direction: column;
            padding: clamp(24px, 4vw, 48px);
            position: relative;
            overflow: hidden;
            flex-shrink: 0;
        }

            .left-panel::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 70% 60% at 80% 30%, rgba(13,148,136,0.15) 0%, transparent 60%);
            }

            .left-panel::after {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
                background-size: 48px 48px;
            }

        .panel-content {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            height: 100%;
            justify-content: space-between;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .brand-logo {
            width: 38px;
            height: 38px;
            background: var(--teal);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .brand-logo svg {
                width: 20px;
                height: 20px;
                fill: white;
            }

        .brand-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: white;
            line-height: 1.2;
        }

            .brand-title span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.62rem;
                font-weight: 300;
                color: rgba(255,255,255,0.45);
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

        .panel-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 40px 0 24px;
        }

        .panel-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(13,148,136,0.15);
            border: 1px solid rgba(13,148,136,0.3);
            color: #5eead4;
            font-size: 0.7rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 5px 12px;
            border-radius: 100px;
            margin-bottom: 20px;
            width: fit-content;
        }

            .panel-tag::before {
                content: '';
                width: 6px;
                height: 6px;
                background: #5eead4;
                border-radius: 50%;
            }

        .panel-heading {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.6rem, 2.5vw, 2.8rem);
            color: white;
            line-height: 1.2;
            margin-bottom: 16px;
        }

            .panel-heading em {
                font-style: italic;
                color: #5eead4;
            }

        .panel-desc {
            color: rgba(255,255,255,0.5);
            font-size: 0.88rem;
            line-height: 1.75;
            font-weight: 300;
            max-width: 320px;
        }

        /* "What you can do" list */
        .benefits {
            list-style: none;
            margin-top: 28px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

            .benefits li {
                display: flex;
                align-items: center;
                gap: 12px;
                color: rgba(255,255,255,0.72);
                font-size: 0.84rem;
            }

            .benefits .tick {
                width: 22px;
                height: 22px;
                border-radius: 50%;
                background: rgba(13,148,136,0.2);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

                .benefits .tick svg {
                    width: 12px;
                    height: 12px;
                    stroke: #5eead4;
                }

        .info-tiles {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .info-tile {
            display: flex;
            align-items: center;
            gap: 14px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 12px;
            padding: 12px 16px;
        }

        .tile-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .tile-icon svg {
                width: 15px;
                height: 15px;
            }

        .tile-text {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.55);
            line-height: 1.4;
        }

            .tile-text strong {
                display: block;
                color: rgba(255,255,255,0.85);
                font-weight: 500;
                margin-bottom: 2px;
            }

        /* ── RIGHT PANEL ── */
        .right-panel {
            flex: 1;
            background: var(--offwhite);
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: clamp(16px, 3vw, 36px);
            overflow-y: auto;
            height: 100vh;
        }

        .form-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: clamp(24px, 3vw, 36px) clamp(20px, 2.8vw, 36px);
            width: 100%;
            max-width: 540px;
            box-shadow: 0 4px 40px rgba(11,31,58,0.08);
            margin: auto 0;
        }

        .form-header {
            margin-bottom: 22px;
        }

            .form-header h2 {
                font-family: 'DM Serif Display', serif;
                font-size: 1.75rem;
                color: var(--navy);
                margin-bottom: 6px;
            }

            .form-header p {
                color: var(--muted);
                font-size: 0.85rem;
            }

        /* Step indicator (the three sections of the form) */
        .steps {
            display: flex;
            gap: 8px;
            margin-bottom: 22px;
        }

        .step {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 6px;
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.04em;
        }

            .step .bar {
                height: 4px;
                border-radius: 100px;
                background: var(--border);
                overflow: hidden;
            }

                .step .bar i {
                    display: block;
                    height: 100%;
                    width: 0;
                    background: var(--teal);
                    border-radius: 100px;
                    transition: width 0.3s ease;
                }

            .step.done {
                color: var(--teal);
            }

        /* Section heading inside the form */
        .section-label {
            font-size: 0.68rem;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin: 22px 0 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .section-label:first-of-type {
                margin-top: 0;
            }

            .section-label::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border);
            }

        .field {
            margin-bottom: 10px;
        }

            .field label {
                display: block;
                font-size: 0.8rem;
                font-weight: 600;
                color: var(--navy);
                margin-bottom: 6px;
            }

                .field label .opt {
                    font-weight: 400;
                    color: var(--muted);
                }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        /* Input with an icon on the left */
        .input-wrap {
            position: relative;
        }

            .input-wrap .icon {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                width: 16px;
                height: 16px;
                color: var(--muted);
                pointer-events: none;
                transition: color 0.2s;
            }

            .input-wrap input {
                width: 100%;
                padding: 11px 14px 11px 38px;
                border: 1.5px solid var(--border);
                border-radius: 10px;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.88rem;
                color: var(--navy);
                background: var(--offwhite);
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            }

                .input-wrap input::placeholder {
                    color: #a3adc2;
                }

                .input-wrap input:focus {
                    border-color: var(--teal);
                    background: white;
                    box-shadow: 0 0 0 3px var(--teal-light);
                }

                .input-wrap input:focus ~ .icon {
                    color: var(--teal);
                }

                .input-wrap input.valid {
                    border-color: var(--green);
                    background: white;
                }

                .input-wrap input.invalid {
                    border-color: var(--red);
                    background: white;
                }

                .input-wrap input[readonly] {
                    cursor: default;
                }

            .input-wrap.has-toggle input {
                padding-right: 42px;
            }

        /* ── Searchable dropdown (province / city) ── */
        .combo input {
            padding-right: 38px !important;
            cursor: text;
        }

        .combo input:disabled {
            cursor: not-allowed;
            opacity: 0.6;
        }

        .combo-chevron {
            position: absolute;
            right: 12px;
            top: 50%;
            width: 16px;
            height: 16px;
            transform: translateY(-50%);
            color: var(--muted);
            pointer-events: none;
            transition: transform 0.2s;
        }

        .combo.open .combo-chevron {
            transform: translateY(-50%) rotate(180deg);
        }

        .combo-list {
            display: none;
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            right: 0;
            z-index: 30;
            max-height: 240px;
            overflow-y: auto;
            list-style: none;
            background: white;
            border: 1px solid var(--border);
            border-radius: 10px;
            box-shadow: 0 12px 32px rgba(11,31,58,0.14);
            padding: 6px;
        }

        .combo.open .combo-list {
            display: block;
        }

        .combo-list li {
            padding: 9px 12px;
            border-radius: 7px;
            font-size: 0.86rem;
            color: var(--navy);
            cursor: pointer;
        }

            .combo-list li.active {
                background: var(--teal-light);
                color: #0b5e57;
            }

            .combo-list li mark {
                background: none;
                color: var(--teal);
                font-weight: 700;
            }

            .combo-list li.combo-empty {
                color: var(--muted);
                cursor: default;
                font-size: 0.8rem;
            }

            .combo-list li.combo-custom {
                border-top: 1px solid var(--border);
                margin-top: 4px;
                padding-top: 10px;
                color: var(--teal);
                font-weight: 600;
            }

        .combo-list li.combo-count {
            font-size: 0.7rem;
            color: var(--muted);
            padding: 4px 12px 6px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            cursor: default !important;
        }

        /* Fixed +27 prefix for the cellphone */
        .phone-prefix {
            position: absolute;
            left: 38px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 0.88rem;
            color: var(--muted);
            pointer-events: none;
        }

        .input-wrap.has-prefix input {
            padding-left: 74px;
        }

        .toggle-pw {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            padding: 6px;
            border-radius: 6px;
            color: var(--muted);
            display: flex;
            align-items: center;
            transition: color 0.2s, background 0.2s;
        }

            .toggle-pw:hover,
            .toggle-pw:focus-visible {
                color: var(--navy);
                background: var(--offwhite);
                outline: none;
            }

            .toggle-pw svg {
                width: 16px;
                height: 16px;
            }

        .hint {
            font-size: 0.72rem;
            color: var(--muted);
            margin-top: 5px;
            line-height: 1.4;
        }

        .val-msg {
            font-size: 0.73rem;
            margin-top: 5px;
            min-height: 16px;
            display: flex;
            align-items: center;
            gap: 5px;
            opacity: 0;
            transition: opacity 0.2s;
        }

            .val-msg.show {
                opacity: 1;
            }

            .val-msg.error {
                color: var(--red);
            }

            .val-msg.success {
                color: var(--green);
            }

            .val-msg svg {
                width: 12px;
                height: 12px;
                flex-shrink: 0;
            }

        /* Password strength + requirements */
        .strength-bar {
            display: flex;
            gap: 4px;
            margin-top: 8px;
        }

            .strength-bar span {
                flex: 1;
                height: 4px;
                border-radius: 100px;
                background: var(--border);
                transition: background 0.3s;
            }

        .pw-rules {
            list-style: none;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5px 12px;
            margin-top: 10px;
        }

            .pw-rules li {
                display: flex;
                align-items: center;
                gap: 7px;
                font-size: 0.74rem;
                color: var(--muted);
                transition: color 0.2s;
            }

                .pw-rules li .dot {
                    width: 16px;
                    height: 16px;
                    border-radius: 50%;
                    border: 1.5px solid var(--border);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    flex-shrink: 0;
                    transition: background 0.2s, border-color 0.2s;
                }

                    .pw-rules li .dot svg {
                        width: 10px;
                        height: 10px;
                        stroke: white;
                        opacity: 0;
                        transition: opacity 0.2s;
                    }

                .pw-rules li.met {
                    color: var(--green);
                }

                    .pw-rules li.met .dot {
                        background: var(--green);
                        border-color: var(--green);
                    }

                        .pw-rules li.met .dot svg {
                            opacity: 1;
                        }

        /* Server-side error banner */
        .alert-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 10px;
            padding: 11px 14px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 18px;
            font-size: 0.82rem;
            color: var(--red);
        }

            .alert-error svg {
                width: 15px;
                height: 15px;
                flex-shrink: 0;
                margin-top: 1px;
            }

            .alert-error a {
                color: inherit;
                font-weight: 600;
            }

        .btn-submit {
            width: 100%;
            background: var(--teal);
            color: white;
            border: none;
            padding: 13px;
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.92rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s, box-shadow 0.2s, opacity 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 18px;
        }

            .btn-submit:hover:not(:disabled) {
                background: var(--teal-dark);
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(13,148,136,0.3);
            }

            .btn-submit:disabled {
                opacity: 0.75;
                cursor: wait;
            }

            .btn-submit svg {
                width: 16px;
                height: 16px;
            }

        .spinner {
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255,255,255,0.4);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
            display: none;
        }

        .btn-submit.loading .spinner {
            display: block;
        }

        .btn-submit.loading .btn-icon {
            display: none;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .privacy-note {
            display: flex;
            gap: 8px;
            align-items: flex-start;
            font-size: 0.72rem;
            color: var(--muted);
            line-height: 1.5;
            margin-top: 14px;
        }

            .privacy-note svg {
                width: 14px;
                height: 14px;
                flex-shrink: 0;
                margin-top: 1px;
                stroke: var(--teal);
            }

        .signin-link {
            text-align: center;
            margin-top: 18px;
            padding-top: 18px;
            border-top: 1px solid var(--border);
            font-size: 0.84rem;
            color: var(--muted);
        }

            .signin-link a {
                color: var(--teal);
                text-decoration: none;
                font-weight: 600;
            }

                .signin-link a:hover {
                    text-decoration: underline;
                }

        @@media (max-width: 760px) {
            body {
                flex-direction: column;
                overflow: auto;
                height: auto;
            }

            .left-panel {
                width: 100%;
                min-width: unset;
                padding: 20px 20px 24px;
            }

            .panel-body {
                padding: 24px 0 0;
            }

            .panel-heading {
                margin-bottom: 0;
            }

            .panel-desc,
            .benefits,
            .info-tiles {
                display: none;
            }

            .right-panel {
                height: auto;
                overflow: visible;
                padding: 16px 12px 32px;
            }

            .form-row,
            .pw-rules {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- LEFT PANEL -->
    <div class="left-panel">
        <div class="panel-content">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <div class="brand-logo">
                    <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
                </div>
                <div class="brand-title">
                    NMB-HLabSys
                    <span>Haematology Lab System</span>
                </div>
            </a>

            <div class="panel-body">
                <div class="panel-tag">Patient Registration</div>
                <h1 class="panel-heading">Your lab results,<br /><em>in one place</em></h1>
                <p class="panel-desc">Create your patient account to follow your test requests and see your results once your doctor releases them.</p>
                <ul class="benefits">
                    <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg></span>Track every test request from sample to result</li>
                    <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg></span>Download your results as a PDF</li>
                    <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg></span>Keep your conditions, allergies and medication up to date</li>
                    <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg></span>Choose which doctors can see your history</li>
                </ul>
            </div>

            <div class="info-tiles">
                <div class="info-tile">
                    <div class="tile-icon" style="background:rgba(26,79,138,0.15)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#93c5fd" stroke-width="2" stroke-linecap="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        </svg>
                    </div>
                    <div class="tile-text">
                        <strong>Secure &amp; Private</strong>
                        Your password is encrypted and only you and the doctors you allow can see your records.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="right-panel">
        <div class="form-card">
            <div class="form-header">
                <h2>Create your account</h2>
                <p>It takes about two minutes. All fields are required unless marked optional.</p>
            </div>

            <!-- Progress through the three sections -->
            <div class="steps" aria-hidden="true">
                <div class="step" id="step-account"><div class="bar"><i></i></div>Account</div>
                <div class="step" id="step-personal"><div class="bar"><i></i></div>Personal</div>
                <div class="step" id="step-security"><div class="bar"><i></i></div>Password</div>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div class="alert-error" role="alert">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        <span>
                            @error.ErrorMessage
                            @if (error.ErrorMessage.Contains("already"))
                            {
                                <text> <a asp-controller="Home" asp-action="Login">Sign in instead</a> or <a asp-controller="Home" asp-action="ForgotPassword">reset your password</a>.</text>
                            }
                        </span>
                    </div>
                }
            }

            <form id="registerForm" asp-controller="Home" asp-action="Register" method="post" novalidate>
                @Html.AntiForgeryToken()

                <!-- Your e-mail address is your username (spec: "E-mail address is used as the username") -->
                <input type="hidden" id="username" name="Username" value="@Posted("Email")" />

                <!-- ACCOUNT -->
                <div class="section-label">Account</div>

                <div class="field">
                    <label for="email">Email address</label>
                    <div class="input-wrap">
                        <input type="email" id="email" name="Email" value="@Posted("Email")" placeholder="you@example.com" autocomplete="email" inputmode="email" data-step="account" />
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="4" width="20" height="16" rx="2" /><polyline points="22 6 12 13 2 6" /></svg>
                    </div>
                    <div class="hint">You'll use this to sign in, and we'll e-mail you about your results here.</div>
                    <div class="val-msg" id="email-msg" aria-live="polite"></div>
                </div>

                <!-- PERSONAL -->
                <div class="section-label">Personal details</div>

                <div class="form-row">
                    <div class="field">
                        <label for="firstName">First name</label>
                        <div class="input-wrap">
                            <input type="text" id="firstName" name="FirstName" value="@Posted("FirstName")" placeholder="e.g. Thandiwe" autocomplete="given-name" data-step="personal" />
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        </div>
                        <div class="val-msg" id="firstname-msg" aria-live="polite"></div>
                    </div>
                    <div class="field">
                        <label for="lastName">Surname</label>
                        <div class="input-wrap">
                            <input type="text" id="lastName" name="LastName" value="@Posted("LastName")" placeholder="e.g. Mokoena" autocomplete="family-name" data-step="personal" />
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        </div>
                        <div class="val-msg" id="lastname-msg" aria-live="polite"></div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="field">
                        <label for="idNumber">SA ID number</label>
                        <div class="input-wrap">
                            <input type="text" id="idNumber" name="IDNumber" value="@Posted("IDNumber")" placeholder="13 digits" maxlength="13" inputmode="numeric" autocomplete="off" data-step="personal" />
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="5" width="20" height="14" rx="2" /><circle cx="8" cy="12" r="2" /><line x1="13" y1="10" x2="18" y2="10" /><line x1="13" y1="14" x2="18" y2="14" /></svg>
                        </div>
                        <div class="val-msg" id="idnumber-msg" aria-live="polite"></div>
                    </div>
                    <div class="field">
                        <label for="dateOfBirth">Date of birth</label>
                        <div class="input-wrap">
                            <input type="date" id="dateOfBirth" name="DateOfBirth" value="@Posted("DateOfBirth")" autocomplete="bday" data-step="personal" />
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                        </div>
                        <div class="hint" id="dob-hint">Filled in from your ID number.</div>
                        <div class="val-msg" id="dob-msg" aria-live="polite"></div>
                    </div>
                </div>

                <div class="field">
                    <label for="cellphone">Cellphone number</label>
                    <div class="input-wrap has-prefix">
                        <input type="tel" id="cellphone" name="CellphoneNumber" value="@Posted("CellphoneNumber")" placeholder="082 123 4567" maxlength="13" inputmode="tel" autocomplete="tel-national" data-step="personal" />
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="5" y="2" width="14" height="20" rx="2" /><line x1="12" y1="18" x2="12.01" y2="18" /></svg>
                        <span class="phone-prefix">+27 |</span>
                    </div>
                    <div class="val-msg" id="cellphone-msg" aria-live="polite"></div>
                </div>

                <!-- HOME ADDRESS (saved as one line, e.g. "12 Cape Road, Mill Park, Gqeberha, 6045") -->
                <div class="section-label">Home address</div>

                <div class="field">
                    <label for="addressLine1">Address line 1</label>
                    <div class="input-wrap">
                        <input type="text" id="addressLine1" name="AddressLine1" value="@Posted("AddressLine1")" placeholder="Street number and name, e.g. 12 Cape Road" autocomplete="address-line1" maxlength="100" data-step="personal" />
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                    </div>
                    <div class="val-msg" id="address1-msg" aria-live="polite"></div>
                </div>

                <div class="field">
                    <label for="addressLine2">Address line 2 <span class="opt">(optional)</span></label>
                    <div class="input-wrap">
                        <input type="text" id="addressLine2" name="AddressLine2" value="@Posted("AddressLine2")" placeholder="Unit, complex or suburb, e.g. Mill Park" autocomplete="address-line2" maxlength="100" data-step="personal" />
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                    </div>
                    <div class="val-msg" id="address2-msg" aria-live="polite"></div>
                </div>

                <div class="form-row">
                    <div class="field">
                        <label for="province">Province</label>
                        <div class="input-wrap combo" id="province-combo">
                            <input type="text" id="province" name="Province" value="@Posted("Province")" placeholder="Choose or type a province" autocomplete="address-level1" maxlength="30" data-step="personal"
                                   role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="province-list" />
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" /><line x1="8" y1="2" x2="8" y2="18" /><line x1="16" y1="6" x2="16" y2="22" /></svg>
                            <svg class="combo-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9" /></svg>
                            <ul class="combo-list" id="province-list" role="listbox"></ul>
                        </div>
                        <div class="val-msg" id="province-msg" aria-live="polite"></div>
                    </div>
                    <div class="field">
                        <label for="city">City / town</label>
                        <div class="input-wrap combo" id="city-combo">
                            <input type="text" id="city" name="City" value="@Posted("City")" placeholder="Choose a province first" autocomplete="address-level2" maxlength="60" data-step="personal"
                                   role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="city-list" />
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                            <svg class="combo-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9" /></svg>
                            <ul class="combo-list" id="city-list" role="listbox"></ul>
                        </div>
                        <div class="val-msg" id="city-msg" aria-live="polite"></div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="field">
                        <label for="postalCode">Postal code</label>
                        <div class="input-wrap">
                            <input type="text" id="postalCode" name="PostalCode" value="@Posted("PostalCode")" placeholder="e.g. 6045" autocomplete="postal-code" inputmode="numeric" maxlength="4" data-step="personal" />
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="9" x2="20" y2="9" /><line x1="4" y1="15" x2="20" y2="15" /><line x1="10" y1="3" x2="8" y2="21" /><line x1="16" y1="3" x2="14" y2="21" /></svg>
                        </div>
                        <div class="val-msg" id="postal-msg" aria-live="polite"></div>
                    </div>
                </div>

                <!-- PASSWORD -->
                <div class="section-label">Password</div>

                <div class="field">
                    <label for="password">Create a password</label>
                    <div class="input-wrap has-toggle">
                        <input type="password" id="password" name="Password" placeholder="Create a strong password" autocomplete="new-password" aria-describedby="pw-rules" data-step="security" />
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        <button type="button" class="toggle-pw" data-toggle="password" aria-label="Show password">
                            <svg class="eye-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg class="eye-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" /><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                        </button>
                    </div>
                    <div class="strength-bar" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                    <ul class="pw-rules" id="pw-rules">
                        <li data-rule="length"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke-width="4" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg></span>At least 8 characters</li>
                        <li data-rule="upper"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke-width="4" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg></span>One uppercase letter</li>
                        <li data-rule="number"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke-width="4" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg></span>One number</li>
                        <li data-rule="special"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke-width="4" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg></span>One special character (e.g. ! # ?)</li>
                    </ul>
                    <div class="val-msg" id="password-msg" aria-live="polite"></div>
                </div>

                <div class="field">
                    <label for="confirmPassword">Confirm password</label>
                    <div class="input-wrap has-toggle">
                        <input type="password" id="confirmPassword" name="ConfirmPassword" placeholder="Type it again" autocomplete="new-password" data-step="security" />
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        <button type="button" class="toggle-pw" data-toggle="confirmPassword" aria-label="Show password">
                            <svg class="eye-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg class="eye-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" /><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                        </button>
                    </div>
                    <div class="val-msg" id="confirm-msg" aria-live="polite"></div>
                </div>

                <button type="submit" class="btn-submit" id="submitBtn">
                    <span class="spinner" aria-hidden="true"></span>
                    <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="8.5" cy="7" r="4" />
                        <line x1="20" y1="8" x2="20" y2="14" />
                        <line x1="23" y1="11" x2="17" y2="11" />
                    </svg>
                    <span class="btn-text">Create account</span>
                </button>

                <p class="privacy-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    Your details are used only to manage your lab tests and results. Doctors can only see your history if you give them access.
                </p>
            </form>

            <p class="signin-link">Already have an account? <a asp-controller="Home" asp-action="Login">Sign in</a></p>
        </div>
    </div>

    <script>
        (function () {
            'use strict';

            var $ = function (id) { return document.getElementById(id); };
            var form = $('registerForm');
            var touched = {};   // only show errors after the user has left a field (or pressed submit)

            var CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>';
            var ALERT = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';

            function showMsg(id, type, text) {
                var el = $(id);
                el.className = 'val-msg show ' + type;
                el.innerHTML = (type === 'error' ? ALERT : CHECK);
                el.appendChild(document.createTextNode(text));
            }
            function clearMsg(id) { var el = $(id); el.className = 'val-msg'; el.innerHTML = ''; }
            function setState(input, state) {
                input.classList.remove('valid', 'invalid');
                if (state) input.classList.add(state);
                input.setAttribute('aria-invalid', state === 'invalid' ? 'true' : 'false');
            }

            // Each check returns '' when fine, or the error message.
            function result(input, msgId, error, okText, show) {
                if (!show) return !error;
                if (error) { setState(input, 'invalid'); showMsg(msgId, 'error', error); return false; }
                setState(input, 'valid');
                if (okText) showMsg(msgId, 'success', okText); else clearMsg(msgId);
                return true;
            }

            // ── SA ID number helpers ──────────────────────────────
            // Format: YYMMDD SSSS C A Z  (date of birth, sequence, citizenship, 8/9, check digit)
            function luhnValid(id) {
                var sum = 0;
                for (var i = 0; i < id.length; i++) {
                    var d = +id.charAt(id.length - 1 - i);
                    if (i % 2 === 1) { d *= 2; if (d > 9) d -= 9; }
                    sum += d;
                }
                return sum % 10 === 0;
            }
            function dobFromId(id) {
                if (!/^\d{6}/.test(id)) return null;
                var yy = +id.substr(0, 2), mm = +id.substr(2, 2), dd = +id.substr(4, 2);
                var now = new Date();
                var year = (yy > now.getFullYear() % 100 ? 1900 : 2000) + yy;
                var date = new Date(year, mm - 1, dd);
                if (date.getFullYear() !== year || date.getMonth() !== mm - 1 || date.getDate() !== dd) return null;
                if (date > now) return null;
                return year + '-' + (mm < 10 ? '0' : '') + mm + '-' + (dd < 10 ? '0' : '') + dd;
            }
            function idPrefixFromDob(iso) {
                return iso.substr(2, 2) + iso.substr(5, 2) + iso.substr(8, 2);
            }

            // ── Field checks ──────────────────────────────────────
            var checks = {
                email: function (show) {
                    var v = $('email').value.trim();
                    var err = !v ? 'Email address is required.'
                        : !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/.test(v) ? 'Enter a valid email address, e.g. you@example.com.'
                        : '';
                    return result($('email'), 'email-msg', err, '', show);
                },
                firstName: function (show) {
                    var v = $('firstName').value.trim();
                    var err = !v ? 'First name is required.'
                        : v.length < 2 ? 'At least 2 letters.'
                        : !/^[A-Za-zÀ-ÿ' -]+$/.test(v) ? 'Letters, spaces, hyphens and apostrophes only.'
                        : '';
                    return result($('firstName'), 'firstname-msg', err, '', show);
                },
                lastName: function (show) {
                    var v = $('lastName').value.trim();
                    var err = !v ? 'Surname is required.'
                        : v.length < 2 ? 'At least 2 letters.'
                        : !/^[A-Za-zÀ-ÿ' -]+$/.test(v) ? 'Letters, spaces, hyphens and apostrophes only.'
                        : '';
                    return result($('lastName'), 'lastname-msg', err, '', show);
                },
                idNumber: function (show) {
                    var v = $('idNumber').value.trim();
                    var dob = $('dateOfBirth').value;
                    var err = !v ? 'SA ID number is required.'
                        : !/^\d{13}$/.test(v) ? 'Must be exactly 13 digits (' + v.length + ' so far).'
                        : !dobFromId(v) ? 'The first 6 digits must be a valid date of birth (YYMMDD).'
                        : !luhnValid(v) ? "This isn't a valid SA ID number. Please check it."
                        : (dob && v.substr(0, 6) !== idPrefixFromDob(dob)) ? "Doesn't match your date of birth."
                        : '';
                    return result($('idNumber'), 'idnumber-msg', err, 'Valid ID number', show);
                },
                dateOfBirth: function (show) {
                    var v = $('dateOfBirth').value;
                    var today = new Date().toISOString().slice(0, 10);
                    var err = !v ? 'Date of birth is required.'
                        : v > today ? "Date of birth can't be in the future."
                        : v < '1900-01-01' ? 'Please check the year.'
                        : '';
                    return result($('dateOfBirth'), 'dob-msg', err, '', show);
                },
                cellphone: function (show) {
                    var digits = $('cellphone').value.replace(/\D/g, '');
                    if (digits.indexOf('27') === 0 && digits.length === 11) digits = '0' + digits.substr(2);
                    var err = !digits ? 'Cellphone number is required.'
                        : !/^0[6-8]\d{8}$/.test(digits) ? 'Enter a 10-digit SA cellphone number, e.g. 082 123 4567.'
                        : '';
                    return result($('cellphone'), 'cellphone-msg', err, '', show);
                },
                addressLine1: function (show) {
                    var v = $('addressLine1').value.trim();
                    var err = !v ? 'Address line 1 is required.'
                        : v.length < 4 ? 'Please enter your street number and name.'
                        : '';
                    return result($('addressLine1'), 'address1-msg', err, '', show);
                },
                addressLine2: function (show) {
                    // optional
                    return result($('addressLine2'), 'address2-msg', '', '', show && $('addressLine2').value.trim() !== '');
                },
                province: function (show) {
                    var v = $('province').value.trim();
                    var err = !v ? 'Province is required.'
                        : !matchProvince(v) ? 'Choose a province from the list.'
                        : '';
                    return result($('province'), 'province-msg', err, '', show);
                },
                city: function (show) {
                    var v = $('city').value.trim();
                    var err = !$('province').value.trim() ? 'Choose your province first.'
                        : !v ? 'City or town is required.'
                        : !/^[A-Za-zÀ-ÿ' ().-]{2,}$/.test(v) ? 'Letters only, e.g. Gqeberha.'
                        : '';
                    return result($('city'), 'city-msg', err, '', show);
                },
                postalCode: function (show) {
                    var v = $('postalCode').value.trim();
                    var err = !v ? 'Postal code is required.'
                        : !/^\d{4}$/.test(v) ? 'SA postal codes are 4 digits, e.g. 6045.'
                        : '';
                    return result($('postalCode'), 'postal-msg', err, '', show);
                },
                password: function (show) {
                    var r = pwRules($('password').value);
                    var err = !$('password').value ? 'Password is required.'
                        : !(r.length && r.upper && r.number && r.special) ? 'Your password needs all four of the items above.'
                        : '';
                    return result($('password'), 'password-msg', err, '', show);
                },
                confirmPassword: function (show) {
                    var v = $('confirmPassword').value;
                    var err = !v ? 'Please type your password again.'
                        : v !== $('password').value ? "Passwords don't match."
                        : '';
                    return result($('confirmPassword'), 'confirm-msg', err, 'Passwords match', show);
                }
            };

            // ── Provinces and their main cities / towns ───────────
            var PLACES = {
                'Eastern Cape': ['Gqeberha (Port Elizabeth)', 'East London', 'Mthatha', 'Makhanda (Grahamstown)', 'Kariega (Uitenhage)', 'Despatch', 'Jeffreys Bay', 'Humansdorp', 'Graaff-Reinet', 'Komani (Queenstown)', 'Qonce (King William\'s Town)', 'Bhisho', 'Butterworth', 'Port Alfred', 'Cradock', 'Aliwal North', 'Somerset East', 'Kirkwood', 'Alice', 'Stutterheim', 'Port St Johns', 'Lusikisiki', 'Mount Frere', 'Matatiele'],
                'Free State': ['Bloemfontein', 'Welkom', 'Bethlehem', 'Kroonstad', 'Sasolburg', 'Parys', 'Harrismith', 'Virginia', 'Phuthaditjhaba', 'Botshabelo', 'Thaba Nchu', 'Odendaalsrus', 'Ficksburg', 'Ladybrand', 'Frankfort', 'Heilbron', 'Senekal', 'Clarens', 'Zastron', 'Jagersfontein'],
                'Gauteng': ['Johannesburg', 'Pretoria', 'Soweto', 'Sandton', 'Midrand', 'Centurion', 'Randburg', 'Roodepoort', 'Fourways', 'Germiston', 'Benoni', 'Boksburg', 'Kempton Park', 'Tembisa', 'Alberton', 'Edenvale', 'Springs', 'Brakpan', 'Katlehong', 'Krugersdorp', 'Randfontein', 'Vereeniging', 'Vanderbijlpark', 'Meyerton', 'Heidelberg', 'Bronkhorstspruit', 'Cullinan', 'Soshanguve', 'Mamelodi', 'Atteridgeville'],
                'KwaZulu-Natal': ['Durban', 'Pietermaritzburg', 'Umhlanga', 'Ballito', 'Pinetown', 'Umlazi', 'Amanzimtoti', 'Richards Bay', 'Empangeni', 'Newcastle', 'Ladysmith', 'Dundee', 'Vryheid', 'Ulundi', 'Eshowe', 'KwaDukuza (Stanger)', 'Port Shepstone', 'Margate', 'Scottburgh', 'Kokstad', 'Estcourt', 'Howick', 'Mtubatuba'],
                'Limpopo': ['Polokwane', 'Seshego', 'Thohoyandou', 'Tzaneen', 'Mokopane', 'Lephalale', 'Musina', 'Makhado (Louis Trichardt)', 'Bela-Bela', 'Modimolle', 'Phalaborwa', 'Giyani', 'Burgersfort', 'Thabazimbi', 'Hoedspruit', 'Lebowakgomo'],
                'Mpumalanga': ['Mbombela (Nelspruit)', 'eMalahleni (Witbank)', 'Middelburg', 'Secunda', 'Ermelo', 'Standerton', 'Bethal', 'Barberton', 'White River', 'Hazyview', 'Sabie', 'Graskop', 'Mashishing (Lydenburg)', 'eMkhondo (Piet Retief)', 'KwaMhlanga', 'Delmas', 'Komatipoort', 'Malelane'],
                'North West': ['Rustenburg', 'Mahikeng', 'Potchefstroom', 'Klerksdorp', 'Brits', 'Hartbeespoort', 'Lichtenburg', 'Vryburg', 'Zeerust', 'Mogwase', 'Ga-Rankuwa', 'Orkney', 'Christiana', 'Wolmaransstad', 'Schweizer-Reneke', 'Koster'],
                'Northern Cape': ['Kimberley', 'Upington', 'Springbok', 'Kuruman', 'Kathu', 'De Aar', 'Colesberg', 'Postmasburg', 'Prieska', 'Calvinia', 'Port Nolloth', 'Kakamas', 'Douglas', 'Hartswater', 'Victoria West', 'Sutherland'],
                'Western Cape': ['Cape Town', 'Bellville', 'Khayelitsha', 'Mitchells Plain', 'Somerset West', 'Strand', 'Stellenbosch', 'Paarl', 'Wellington', 'Franschhoek', 'Malmesbury', 'Worcester', 'Ceres', 'Robertson', 'Swellendam', 'Caledon', 'Hermanus', 'George', 'Mossel Bay', 'Knysna', 'Plettenberg Bay', 'Oudtshoorn', 'Beaufort West', 'Saldanha', 'Vredenburg', 'Langebaan', 'Clanwilliam']
            };
            var PROVINCES = Object.keys(PLACES);
            function matchProvince(v) {
                v = (v || '').trim().toLowerCase();
                for (var i = 0; i < PROVINCES.length; i++) if (PROVINCES[i].toLowerCase() === v) return PROVINCES[i];
                return null;
            }

            // ── Searchable dropdown ───────────────────────────────
            // Type to filter, arrow keys + Enter to pick, Esc to close.
            // allowCustom: if the place isn't listed, offer to use what was typed.
            function combo(opts) {
                var input = $(opts.input), box = $(opts.box), list = $(opts.list);
                var items = [], active = -1;

                function esc(t) { return t.replace(/[&<>"']/g, function (c) { return '&#' + c.charCodeAt(0) + ';'; }); }
                function highlight(text, q) {
                    if (!q) return esc(text);
                    var i = text.toLowerCase().indexOf(q.toLowerCase());
                    if (i < 0) return esc(text);
                    return esc(text.slice(0, i)) + '<mark>' + esc(text.slice(i, i + q.length)) + '</mark>' + esc(text.slice(i + q.length));
                }

                function render() {
                    var all = opts.source();
                    var q = input.value.trim();
                    // show everything while the box still holds a full chosen value
                    var exact = all.some(function (x) { return x.toLowerCase() === q.toLowerCase(); });
                    var filter = exact ? '' : q;
                    items = all.filter(function (x) { return x.toLowerCase().indexOf(filter.toLowerCase()) >= 0; });
                    var html = '';
                    if (opts.countLabel && all.length) html += '<li class="combo-count">' + esc(opts.countLabel()) + '</li>';
                    items.forEach(function (x, i) {
                        html += '<li role="option" data-i="' + i + '" class="' + (i === active ? 'active' : '') + '">' + highlight(x, filter) + '</li>';
                    });
                    if (!items.length) html += '<li class="combo-empty">No matches for “' + esc(q) + '”</li>';
                    if (opts.allowCustom && q && !exact) {
                        html += '<li class="combo-custom" data-custom="1">Use “' + esc(q) + '”</li>';
                    }
                    list.innerHTML = html;
                }

                function open() {
                    if (input.disabled) return;
                    active = -1;
                    render();
                    box.classList.add('open');
                    input.setAttribute('aria-expanded', 'true');
                }
                function close() {
                    box.classList.remove('open');
                    input.setAttribute('aria-expanded', 'false');
                }
                function choose(value) {
                    input.value = value;
                    close();
                    if (opts.onChoose) opts.onChoose(value);
                    input.dispatchEvent(new Event('input'));
                    touched[opts.input] = true;
                    checks[opts.input](true);
                    updateSteps();
                }
                function move(d) {
                    if (!box.classList.contains('open')) { open(); return; }
                    if (!items.length) return;
                    active = (active + d + items.length) % items.length;
                    render();
                    var el = list.querySelector('li.active');
                    if (el) el.scrollIntoView({ block: 'nearest' });
                }

                input.addEventListener('focus', open);
                input.addEventListener('click', open);
                input.addEventListener('input', function (e) { if (e.isTrusted) { active = -1; render(); box.classList.add('open'); } });
                input.addEventListener('keydown', function (e) {
                    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
                    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
                    else if (e.key === 'Enter' && box.classList.contains('open')) {
                        e.preventDefault();
                        if (active >= 0 && items[active]) choose(items[active]);
                        else if (items.length === 1) choose(items[0]);
                        else if (opts.allowCustom && input.value.trim()) choose(input.value.trim());
                    }
                    else if (e.key === 'Escape') close();
                    else if (e.key === 'Tab') close();
                });
                // mousedown (not click) so it fires before the input loses focus
                list.addEventListener('mousedown', function (e) {
                    var li = e.target.closest('li');
                    if (!li) return;
                    e.preventDefault();
                    if (li.dataset.custom) choose(input.value.trim());
                    else if (li.dataset.i !== undefined) choose(items[+li.dataset.i]);
                });
                input.addEventListener('blur', function () {
                    setTimeout(close, 120);
                    if (opts.onBlur) opts.onBlur();
                });
                document.addEventListener('click', function (e) { if (!box.contains(e.target)) close(); });
            }

            function setCityState() {
                var prov = matchProvince($('province').value);
                $('city').disabled = !prov;
                $('city').placeholder = prov ? 'Search cities in ' + prov : 'Choose a province first';
            }

            combo({
                input: 'province', box: 'province-combo', list: 'province-list',
                source: function () { return PROVINCES; },
                onChoose: function () {
                    // a new province means the old city no longer applies
                    $('city').value = '';
                    $('city').classList.remove('valid', 'invalid');
                    $('city-msg').className = 'val-msg';
                    $('city-msg').innerHTML = '';
                    touched.city = false;
                    setCityState();
                    setTimeout(function () { $('city').focus(); }, 0);
                },
                onBlur: function () {
                    // "gauteng" typed by hand -> "Gauteng"
                    var m = matchProvince($('province').value);
                    if (m && $('province').value !== m) $('province').value = m;
                    setCityState();
                }
            });

            combo({
                input: 'city', box: 'city-combo', list: 'city-list',
                allowCustom: true,
                source: function () { var p = matchProvince($('province').value); return p ? PLACES[p] : []; },
                countLabel: function () { var p = matchProvince($('province').value); return p + ' · ' + PLACES[p].length + ' places'; }
            });
            setCityState();

            // ── Password requirements + strength ──────────────────
            function pwRules(v) {
                return {
                    length: v.length >= 8,
                    upper: /[A-Z]/.test(v),
                    number: /[0-9]/.test(v),
                    special: /[^A-Za-z0-9]/.test(v)
                };
            }
            var bars = document.querySelectorAll('.strength-bar span');
            var colors = ['#dc2626', '#ea580c', '#ca8a04', '#16a34a'];
            function updatePasswordUi() {
                var v = $('password').value;
                var r = pwRules(v);
                var score = 0;
                document.querySelectorAll('#pw-rules li').forEach(function (li) {
                    var met = r[li.dataset.rule];
                    li.classList.toggle('met', met);
                    if (met) score++;
                });
                bars.forEach(function (b, i) { b.style.background = v && i < score ? colors[score - 1] : ''; });
            }

            // ── Auto-fill / formatting ────────────────────────────
            $('email').addEventListener('input', function () {
                $('username').value = this.value.trim().toLowerCase();
            });

            $('idNumber').addEventListener('input', function () {
                var v = this.value.replace(/\D/g, '').slice(0, 13);
                if (this.value !== v) this.value = v;
                var iso = v.length >= 6 ? dobFromId(v) : null;
                if (iso) {
                    $('dateOfBirth').value = iso;
                    $('dob-hint').textContent = 'Filled in from your ID number.';
                    if (touched.dateOfBirth) checks.dateOfBirth(true);
                }
                if (touched.idNumber || v.length === 13) { touched.idNumber = true; checks.idNumber(true); }
            });

            $('cellphone').addEventListener('input', function () {
                // keep digits, show as 082 123 4567
                var d = this.value.replace(/\D/g, '').slice(0, 11);
                var out = d.length > 6 ? d.slice(0, 3) + ' ' + d.slice(3, 6) + ' ' + d.slice(6)
                        : d.length > 3 ? d.slice(0, 3) + ' ' + d.slice(3) : d;
                if (this.value !== out) this.value = out;
            });

            $('postalCode').addEventListener('input', function () {
                var v = this.value.replace(/\D/g, '').slice(0, 4);
                if (this.value !== v) this.value = v;
            });

            $('password').addEventListener('input', function () {
                updatePasswordUi();
                if (touched.password) checks.password(true);
                if (touched.confirmPassword) checks.confirmPassword(true);
            });

            document.querySelectorAll('.toggle-pw').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = $(btn.dataset.toggle);
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    btn.querySelector('.eye-show').style.display = show ? 'none' : '';
                    btn.querySelector('.eye-hide').style.display = show ? '' : 'none';
                    btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                });
            });

            // Validate a field when the user leaves it, then live while they fix it
            Object.keys(checks).forEach(function (id) {
                var input = $(id);
                input.addEventListener('blur', function () {
                    if (input.value !== '' || touched[id]) { touched[id] = true; checks[id](true); }
                    updateSteps();
                });
                input.addEventListener('input', function () {
                    if (touched[id] && id !== 'idNumber' && id !== 'password') checks[id](true);
                    updateSteps();
                });
            });

            // Changing the date of birth by hand re-checks that the ID still matches it
            $('dateOfBirth').addEventListener('change', function () {
                if (touched.idNumber) checks.idNumber(true);
            });

            // ── Progress bars for the three sections ──────────────
            var groups = { account: ['email'], personal: ['firstName', 'lastName', 'idNumber', 'dateOfBirth', 'cellphone', 'addressLine1', 'addressLine2', 'province', 'city', 'postalCode'], security: ['password', 'confirmPassword'] };
            function updateSteps() {
                Object.keys(groups).forEach(function (g) {
                    var ids = groups[g];
                    var ok = ids.filter(function (id) { return checks[id](false); }).length;
                    var step = $('step-' + g);
                    step.querySelector('i').style.width = Math.round(ok / ids.length * 100) + '%';
                    step.classList.toggle('done', ok === ids.length);
                });
            }

            // ── Submit ────────────────────────────────────────────
            form.addEventListener('submit', function (e) {
                $('username').value = $('email').value.trim().toLowerCase();
                var firstBad = null;
                Object.keys(checks).forEach(function (id) {
                    touched[id] = true;
                    if (!checks[id](true) && !firstBad) firstBad = $(id);
                });
                updateSteps();
                if (firstBad) {
                    e.preventDefault();
                    firstBad.focus();
                    firstBad.scrollIntoView({ block: 'center', behavior: 'smooth' });
                    return;
                }
                // send the cellphone as plain digits (0821234567)
                var digits = $('cellphone').value.replace(/\D/g, '');
                if (digits.indexOf('27') === 0 && digits.length === 11) digits = '0' + digits.substr(2);
                $('cellphone').value = digits;

                var btn = $('submitBtn');
                btn.disabled = true;
                btn.classList.add('loading');
                btn.querySelector('.btn-text').textContent = 'Creating your account…';
            });

            // Values sent back after a server error: show their state straight away
            Object.keys(checks).forEach(function (id) {
                if ($(id).value && id !== 'password' && id !== 'confirmPassword') { touched[id] = true; checks[id](true); }
            });
            $('cellphone').dispatchEvent(new Event('input'));
            if (!$('dateOfBirth').value) $('dob-hint').textContent = 'Filled in automatically when you enter your ID number.';
            updatePasswordUi();
            updateSteps();
        })();
    </script>
</body>
</html>
