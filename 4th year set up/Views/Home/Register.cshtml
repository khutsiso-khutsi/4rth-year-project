@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@@0;1&family=DM+Sans:wght@@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --teal: #0d9488;
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--navy);
            color: var(--navy);
            min-height: 100vh;
            display: flex;
            overflow: hidden;
        }

        .left-panel {
            width: 38%;
            min-width: 260px;
            background: var(--navy);
            display: flex;
            flex-direction: column;
            padding: clamp(24px, 4vw, 48px);
            position: relative;
            overflow: hidden;
            flex-shrink: 0;
        }

            .left-panel::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 70% 60% at 80% 30%, rgba(13,148,136,0.15) 0%, transparent 60%);
            }

            .left-panel::after {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
                background-size: 48px 48px;
            }

        .panel-content {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            height: 100%;
            justify-content: space-between;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .brand-logo {
            width: 38px;
            height: 38px;
            background: var(--teal);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .brand-logo svg {
                width: 20px;
                height: 20px;
                fill: white;
            }

        .brand-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: white;
            line-height: 1.2;
        }

            .brand-title span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.62rem;
                font-weight: 300;
                color: rgba(255,255,255,0.45);
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

        .panel-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 40px 0 24px;
        }

        .panel-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(13,148,136,0.15);
            border: 1px solid rgba(13,148,136,0.3);
            color: #5eead4;
            font-size: 0.7rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 5px 12px;
            border-radius: 100px;
            margin-bottom: 20px;
            width: fit-content;
        }

            .panel-tag::before {
                content: '';
                width: 6px;
                height: 6px;
                background: #5eead4;
                border-radius: 50%;
            }

        .panel-heading {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.6rem, 2.5vw, 2.8rem);
            color: white;
            line-height: 1.2;
            margin-bottom: 16px;
        }

            .panel-heading em {
                font-style: italic;
                color: #5eead4;
            }

        .panel-desc {
            color: rgba(255,255,255,0.5);
            font-size: 0.88rem;
            line-height: 1.75;
            font-weight: 300;
            max-width: 300px;
        }

        .info-tiles {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .info-tile {
            display: flex;
            align-items: center;
            gap: 14px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 12px;
            padding: 12px 16px;
        }

        .tile-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .tile-icon svg {
                width: 15px;
                height: 15px;
            }

        .tile-text {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.55);
            line-height: 1.4;
        }

            .tile-text strong {
                display: block;
                color: rgba(255,255,255,0.85);
                font-weight: 500;
                margin-bottom: 2px;
            }

        .right-panel {
            flex: 1;
            background: var(--offwhite);
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: clamp(16px, 3vw, 32px);
            overflow-y: auto;
            height: 100vh;
        }

        .form-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: clamp(24px, 3vw, 36px) clamp(20px, 2.5vw, 32px);
            width: 100%;
            max-width: 500px;
            box-shadow: 0 4px 40px rgba(11,31,58,0.08);
            margin: auto 0;
        }

        .form-header {
            margin-bottom: 20px;
        }

            .form-header h2 {
                font-family: 'DM Serif Display', serif;
                font-size: 1.7rem;
                color: var(--navy);
                margin-bottom: 6px;
            }

            .form-header p {
                color: var(--muted);
                font-size: 0.85rem;
            }

        /* SECTION LABEL */
        .section-label {
            font-size: 0.68rem;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin: 18px 0 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .section-label::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border);
            }

        .field {
            margin-bottom: 12px;
        }

            .field label {
                display: block;
                font-size: 0.8rem;
                font-weight: 600;
                color: var(--navy);
                margin-bottom: 5px;
            }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .input-wrap {
            position: relative;
        }

            .input-wrap input,
            .input-wrap select {
                width: 100%;
                padding: 10px 14px;
                border: 1.5px solid var(--border);
                border-radius: 9px;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.88rem;
                color: var(--navy);
                background: var(--offwhite);
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
                appearance: none;
            }

                .input-wrap input:focus,
                .input-wrap select:focus {
                    border-color: var(--teal);
                    background: white;
                    box-shadow: 0 0 0 3px rgba(13,148,136,0.1);
                }

                .input-wrap input.valid, .input-wrap select.valid {
                    border-color: var(--green);
                    background: white;
                }

                .input-wrap input.invalid, .input-wrap select.invalid {
                    border-color: var(--red);
                    background: white;
                }

        .select-arrow {
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            pointer-events: none;
            color: var(--muted);
        }

        .toggle-pw {
            position: absolute;
            right: 11px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            color: var(--muted);
            display: flex;
            align-items: center;
            transition: color 0.2s;
        }

            .toggle-pw:hover {
                color: var(--navy);
            }

            .toggle-pw svg {
                width: 16px;
                height: 16px;
            }

        .val-msg {
            font-size: 0.73rem;
            margin-top: 4px;
            min-height: 16px;
            display: flex;
            align-items: center;
            gap: 5px;
            opacity: 0;
            transition: opacity 0.2s;
        }

            .val-msg.show {
                opacity: 1;
            }

            .val-msg.error {
                color: var(--red);
            }

            .val-msg.success {
                color: var(--green);
            }

            .val-msg svg {
                width: 12px;
                height: 12px;
                flex-shrink: 0;
            }

        .strength-bar {
            display: flex;
            gap: 4px;
            margin-top: 6px;
        }

            .strength-bar span {
                flex: 1;
                height: 3px;
                border-radius: 100px;
                background: var(--border);
                transition: background 0.3s;
            }

        .strength-label {
            font-size: 0.7rem;
            color: var(--muted);
            margin-top: 4px;
            min-height: 14px;
        }

        .alert-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 9px;
            padding: 10px 14px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 16px;
            font-size: 0.82rem;
            color: var(--red);
        }

            .alert-error svg {
                width: 15px;
                height: 15px;
                flex-shrink: 0;
                margin-top: 1px;
            }

        .btn-submit {
            width: 100%;
            background: var(--teal);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 9px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.92rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 8px;
        }

            .btn-submit:hover {
                background: #0f7a70;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(13,148,136,0.3);
            }

            .btn-submit svg {
                width: 16px;
                height: 16px;
            }

        .signin-link {
            text-align: center;
            margin-top: 16px;
            font-size: 0.82rem;
            color: var(--muted);
        }

            .signin-link a {
                color: var(--teal);
                text-decoration: none;
                font-weight: 500;
            }

                .signin-link a:hover {
                    text-decoration: underline;
                }

        @@media (max-width: 700px) {
            body {
                flex-direction: column;
                overflow: auto;
            }

            .left-panel {
                width: 100%;
                min-width: unset;
                padding: 20px 24px;
            }

            .right-panel {
                height: auto;
                padding: 20px 16px 32px;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .info-tiles {
                display: none;
            }

            .panel-desc {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- LEFT PANEL -->
    <div class="left-panel">
        <div class="panel-content">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <div class="brand-logo">
                    <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
                </div>
                <div class="brand-title">
                    NMB-HLabSys
                    <span>Haematology Lab System</span>
                </div>
            </a>

            <div class="panel-body">
                <div class="panel-tag">New Account</div>
                <h2 class="panel-heading">Join <em>NMB</em><br />HLabSys</h2>
                <p class="panel-desc">Create your account to access your patient portal and manage your haematology lab results securely.</p>
            </div>

            <div class="info-tiles">
                <div class="info-tile">
                    <div class="tile-icon" style="background:rgba(13,148,136,0.15)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#5eead4" stroke-width="2" stroke-linecap="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </div>
                    <div class="tile-text">
                        <strong>Role-Based Access</strong>
                        Your portal loads automatically based on your role.
                    </div>
                </div>
                <div class="info-tile">
                    <div class="tile-icon" style="background:rgba(26,79,138,0.15)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#93c5fd" stroke-width="2" stroke-linecap="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        </svg>
                    </div>
                    <div class="tile-text">
                        <strong>Secure &amp; Private</strong>
                        All data is encrypted and access is fully audited.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="right-panel">
        <div class="form-card">
            <div class="form-header">
                <h2>Create Account</h2>
                <p>Fill in all your details to get started.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div class="alert-error">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        <span>@error.ErrorMessage</span>
                    </div>
                }
            }

            <form id="registerForm" asp-controller="Home" asp-action="Register" method="post" novalidate>
                @Html.AntiForgeryToken()

                <!-- ACCOUNT DETAILS SECTION -->
                <div class="section-label">Account Details</div>

                <!-- Username (auto-filled from Email) -->
                <div class="field">
                    <label for="username">Username</label>
                    <div class="input-wrap">
                        <input type="text" id="username" name="Username" placeholder="Your email will be used as username" autocomplete="username" readonly />
                    </div>
                    <div class="val-msg" id="username-msg"></div>
                </div>

                <!-- Email -->
                <div class="field">
                    <label for="email">Email Address</label>
                    <div class="input-wrap">
                        <input type="email" id="email" name="Email" placeholder="Enter your email address" autocomplete="email" />
                    </div>
                    <div class="val-msg" id="email-msg"></div>
                </div>

                <!-- PERSONAL DETAILS SECTION -->
                <div class="section-label">Personal Details</div>

                <!-- First Name & Last Name -->
                <div class="form-row">
                    <div class="field">
                        <label for="firstName">First Name</label>
                        <div class="input-wrap">
                            <input type="text" id="firstName" name="FirstName" placeholder="First name" />
                        </div>
                        <div class="val-msg" id="firstname-msg"></div>
                    </div>
                    <div class="field">
                        <label for="lastName">Last Name</label>
                        <div class="input-wrap">
                            <input type="text" id="lastName" name="LastName" placeholder="Last name" />
                        </div>
                        <div class="val-msg" id="lastname-msg"></div>
                    </div>
                </div>

                <!-- SA ID Number -->
                <div class="field">
                    <label for="idNumber">SA ID Number</label>
                    <div class="input-wrap">
                        <input type="text" id="idNumber" name="IDNumber" placeholder="13-digit SA ID number" maxlength="13" />
                    </div>
                    <div class="val-msg" id="idnumber-msg"></div>
                </div>

                <!-- Date of Birth & Cellphone -->
                <div class="form-row">
                    <div class="field">
                        <label for="dateOfBirth">Date of Birth</label>
                        <div class="input-wrap">
                            <input type="date" id="dateOfBirth" name="DateOfBirth" />
                        </div>
                        <div class="val-msg" id="dob-msg"></div>
                    </div>
                    <div class="field">
                        <label for="cellphone">Cellphone Number</label>
                        <div class="input-wrap" style="display:flex;gap:6px;align-items:stretch;">
                            <div style="position:relative;flex-shrink:0;width:110px;">
                                <select id="dialCode" name="DialCode" style="width:100%;height:100%;padding:10px 28px 10px 10px;border:1.5px solid var(--border);border-radius:9px;font-family:'DM Sans',sans-serif;font-size:0.82rem;color:var(--navy);background:var(--offwhite);outline:none;appearance:none;cursor:pointer;">
                                    <option value="+27" selected>🇿🇦 +27</option>
                                    <option value="+1">🇺🇸 +1</option>
                                    <option value="+1-CA">🇨🇦 +1</option>
                                    <option value="+44">🇬🇧 +44</option>
                                    <option value="+61">🇦🇺 +61</option>
                                    <option value="+64">🇳🇿 +64</option>
                                    <option value="+91">🇮🇳 +91</option>
                                    <option value="+86">🇨🇳 +86</option>
                                    <option value="+81">🇯🇵 +81</option>
                                    <option value="+82">🇰🇷 +82</option>
                                    <option value="+49">🇩🇪 +49</option>
                                    <option value="+33">🇫🇷 +33</option>
                                    <option value="+39">🇮🇹 +39</option>
                                    <option value="+34">🇪🇸 +34</option>
                                    <option value="+351">🇵🇹 +351</option>
                                    <option value="+31">🇳🇱 +31</option>
                                    <option value="+32">🇧🇪 +32</option>
                                    <option value="+41">🇨🇭 +41</option>
                                    <option value="+43">🇦🇹 +43</option>
                                    <option value="+46">🇸🇪 +46</option>
                                    <option value="+47">🇳🇴 +47</option>
                                    <option value="+45">🇩🇰 +45</option>
                                    <option value="+358">🇫🇮 +358</option>
                                    <option value="+48">🇵🇱 +48</option>
                                    <option value="+420">🇨🇿 +420</option>
                                    <option value="+36">🇭🇺 +36</option>
                                    <option value="+40">🇷🇴 +40</option>
                                    <option value="+7">🇷🇺 +7</option>
                                    <option value="+380">🇺🇦 +380</option>
                                    <option value="+30">🇬🇷 +30</option>
                                    <option value="+90">🇹🇷 +90</option>
                                    <option value="+972">🇮🇱 +972</option>
                                    <option value="+971">🇦🇪 +971</option>
                                    <option value="+966">🇸🇦 +966</option>
                                    <option value="+20">🇪🇬 +20</option>
                                    <option value="+234">🇳🇬 +234</option>
                                    <option value="+254">🇰🇪 +254</option>
                                    <option value="+233">🇬🇭 +233</option>
                                    <option value="+255">🇹🇿 +255</option>
                                    <option value="+256">🇺🇬 +256</option>
                                    <option value="+263">🇿🇼 +263</option>
                                    <option value="+260">🇿🇲 +260</option>
                                    <option value="+267">🇧🇼 +267</option>
                                    <option value="+264">🇳🇦 +264</option>
                                    <option value="+268">🇸🇿 +268</option>
                                    <option value="+266">🇱🇸 +266</option>
                                    <option value="+258">🇲🇿 +258</option>
                                    <option value="+55">🇧🇷 +55</option>
                                    <option value="+54">🇦🇷 +54</option>
                                    <option value="+56">🇨🇱 +56</option>
                                    <option value="+57">🇨🇴 +57</option>
                                    <option value="+51">🇵🇪 +51</option>
                                    <option value="+52">🇲🇽 +52</option>
                                    <option value="+63">🇵🇭 +63</option>
                                    <option value="+62">🇮🇩 +62</option>
                                    <option value="+60">🇲🇾 +60</option>
                                    <option value="+65">🇸🇬 +65</option>
                                    <option value="+66">🇹🇭 +66</option>
                                    <option value="+84">🇻🇳 +84</option>
                                    <option value="+880">🇧🇩 +880</option>
                                    <option value="+92">🇵🇰 +92</option>
                                    <option value="+94">🇱🇰 +94</option>
                                    <option value="+98">🇮🇷 +98</option>
                                </select>
                                <span class="select-arrow">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9" /></svg>
                                </span>
                            </div>
                            <input type="text" id="cellphone" name="CellphoneNumber" placeholder="e.g. 0821234567" maxlength="15" style="flex:1;" />
                        </div>
                        <div class="val-msg" id="cellphone-msg"></div>
                    </div>
                </div>

                <!-- Home Address -->
                <div class="field">
                    <label for="homeAddress">Home Address</label>
                    <div class="input-wrap">
                        <input type="text" id="homeAddress" name="HomeAddress" placeholder="Enter your home address" />
                    </div>
                    <div class="val-msg" id="address-msg"></div>
                </div>

                <!-- SECURITY SECTION -->
                <div class="section-label">Security</div>

                <!-- Password -->
                <div class="field">
                    <label for="password">Password</label>
                    <div class="input-wrap">
                        <input type="password" id="password" name="Password" placeholder="Create a password" autocomplete="new-password" />
                        <button type="button" class="toggle-pw" id="togglePw1">
                            <svg id="eye1Show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg id="eye1Hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" /><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                        </button>
                    </div>
                    <div class="strength-bar"><span id="s1"></span><span id="s2"></span><span id="s3"></span><span id="s4"></span></div>
                    <div class="strength-label" id="strengthLabel"></div>
                    <div class="val-msg" id="password-msg"></div>
                </div>

                <!-- Confirm Password -->
                <div class="field">
                    <label for="confirmPassword">Confirm Password</label>
                    <div class="input-wrap">
                        <input type="password" id="confirmPassword" name="ConfirmPassword" placeholder="Repeat your password" autocomplete="new-password" />
                        <button type="button" class="toggle-pw" id="togglePw2">
                            <svg id="eye2Show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg id="eye2Hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" /><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                        </button>
                    </div>
                    <div class="val-msg" id="confirm-msg"></div>
                </div>

                <button type="submit" class="btn-submit">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="8.5" cy="7" r="4" />
                        <line x1="20" y1="8" x2="20" y2="14" />
                        <line x1="23" y1="11" x2="17" y2="11" />
                    </svg>
                    Create Account
                </button>
            </form>

            <script>
                (function(){
                    // When email changes, copy into username (readonly)
                    var email = document.getElementById('email');
                    var username = document.getElementById('username');
                    var idNumber = document.getElementById('idNumber');
                    var dob = document.getElementById('dateOfBirth');

                    function syncEmailToUsername(){
                        if(!email || !username) return;
                        username.value = email.value || '';
                    }

                    email?.addEventListener('input', function(){
                        syncEmailToUsername();
                    });

                    // On load sync in case browser autofills
                    document.addEventListener('DOMContentLoaded', function(){ syncEmailToUsername(); });

                    // SA ID parsing: YYMMDDxxxxxx -> populate dateOfBirth
                    // Accepts 13-digit SA ID. Uses 2-digit year and assumes 1900/2000 century by reasonable cutoff.
                    function parseSAIDToDOB(id){
                        if(!id || id.length < 6) return null;
                        var y = id.substring(0,2);
                        var m = id.substring(2,4);
                        var d = id.substring(4,6);
                        if(!/^[0-9]{6}$/.test(y+m+d)) return null;
                        var yy = parseInt(y, 10);
                        var mm = parseInt(m, 10);
                        var dd = parseInt(d, 10);
                        if(mm < 1 || mm > 12) return null;
                        if(dd < 1 || dd > 31) return null;
                        // Choose century: if yy > currentYear%100 -> 1900s, else 2000s
                        var today = new Date();
                        var cutoff = today.getFullYear() % 100;
                        var century = (yy > cutoff) ? 1900 : 2000;
                        var fullYear = century + yy;
                        // Build ISO date string yyyy-mm-dd
                        var mmStr = (mm < 10 ? '0' + mm : '' + mm);
                        var ddStr = (dd < 10 ? '0' + dd : '' + dd);
                        return fullYear + '-' + mmStr + '-' + ddStr;
                    }

                    idNumber?.addEventListener('input', function(){
                        var v = idNumber.value.replace(/\D/g,'');
                        // limit to 13 numeric chars
                        if(v.length > 13) v = v.substr(0,13);
                        idNumber.value = v;
                        if(v.length >= 6){
                            var iso = parseSAIDToDOB(v);
                            if(iso){
                                dob.value = iso;
                                dob.classList.add('valid');
                            }
                        }
                    });

                    // Before submit ensure Username is set to Email (defensive)
                    var form = document.getElementById('registerForm');
                    form?.addEventListener('submit', function(e){
                        syncEmailToUsername();
                    });
                })();
            </script>

            <p class="signin-link">Already have an account? <a asp-controller="Home" asp-action="Login">Sign in</a></p>
        </div>
    </div>

    <script>
        // Password toggle
        function setupToggle(btnId, inputId, showId, hideId) {
            document.getElementById(btnId).addEventListener('click', () => {
                const input = document.getElementById(inputId);
                const isHidden = input.type === 'password';
                input.type = isHidden ? 'text' : 'password';
                document.getElementById(showId).style.display = isHidden ? 'none' : '';
                document.getElementById(hideId).style.display = isHidden ? '' : 'none';
            });
        }
        setupToggle('togglePw1', 'password', 'eye1Show', 'eye1Hide');
        setupToggle('togglePw2', 'confirmPassword', 'eye2Show', 'eye2Hide');

        // Strength meter
        const bars = ['s1','s2','s3','s4'].map(id => document.getElementById(id));
        const strengthLabel = document.getElementById('strengthLabel');
        const strengthColors = ['#dc2626','#ea580c','#ca8a04','#16a34a'];
        const strengthNames = ['Weak','Fair','Good','Strong'];

        function getStrength(val) {
            let score = 0;
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;
            return score;
        }

        document.getElementById('password').addEventListener('input', function() {
            const val = this.value;
            if (!val) { bars.forEach(b => b.style.background = ''); strengthLabel.textContent = ''; return; }
            const score = getStrength(val);
            bars.forEach((b, i) => b.style.background = i < score ? strengthColors[score - 1] : '');
            strengthLabel.style.color = strengthColors[score - 1];
            strengthLabel.textContent = strengthNames[score - 1] + ' password';
        });

        // Helpers
        function showMsg(id, type, text) {
            const el = document.getElementById(id);
            el.className = 'val-msg show ' + type;
            el.innerHTML = type === 'error'
                ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>${text}`
                : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>${text}`;
        }
        function clearMsg(id) { const el = document.getElementById(id); el.className = 'val-msg'; el.innerHTML = ''; }
        function setInputState(input, state) { input.classList.remove('valid','invalid'); if (state) input.classList.add(state); }

        // Validation functions
        function validateUsername() {
            const val = document.getElementById('username').value.trim();
            if (!val) { setInputState(document.getElementById('username'),'invalid'); showMsg('username-msg','error','Username is required.'); return false; }
            if (val.length < 3) { setInputState(document.getElementById('username'),'invalid'); showMsg('username-msg','error','At least 3 characters.'); return false; }
            if (/\s/.test(val)) { setInputState(document.getElementById('username'),'invalid'); showMsg('username-msg','error','No spaces allowed.'); return false; }
            setInputState(document.getElementById('username'),'valid'); showMsg('username-msg','success','Looks good!'); return true;
        }

        function validateEmail() {
            const val = document.getElementById('email').value.trim();
            if (!val) { setInputState(document.getElementById('email'),'invalid'); showMsg('email-msg','error','Email is required.'); return false; }
            if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(val)) { setInputState(document.getElementById('email'),'invalid'); showMsg('email-msg','error','Enter a valid email.'); return false; }
            setInputState(document.getElementById('email'),'valid'); showMsg('email-msg','success','Looks good!'); return true;
        }

        function validateFirstName() {
            const val = document.getElementById('firstName').value.trim();
            if (!val) { setInputState(document.getElementById('firstName'),'invalid'); showMsg('firstname-msg','error','First name is required.'); return false; }
            setInputState(document.getElementById('firstName'),'valid'); clearMsg('firstname-msg'); return true;
        }

        function validateLastName() {
            const val = document.getElementById('lastName').value.trim();
            if (!val) { setInputState(document.getElementById('lastName'),'invalid'); showMsg('lastname-msg','error','Last name is required.'); return false; }
            setInputState(document.getElementById('lastName'),'valid'); clearMsg('lastname-msg'); return true;
        }

                function validateIDNumber() {
            const val = document.getElementById('idNumber').value.trim();
            if (!val) {
                setInputState(document.getElementById('idNumber'), 'invalid');
                showMsg('idnumber-msg', 'error', 'SA ID number is required.');
                return false;
            }
            if (!/^\d{13}$/.test(val)) {
                setInputState(document.getElementById('idNumber'), 'invalid');
                showMsg('idnumber-msg', 'error', 'Must be exactly 13 digits.');
                return false;
            }

            // check dob match if dob already filled
            const dob = document.getElementById('dateOfBirth').value;
            if (dob) {
                const dobDate = new Date(dob);
                const yy = String(dobDate.getFullYear()).slice(-2);
                const mm = String(dobDate.getMonth() + 1).padStart(2, '0');
                const dd = String(dobDate.getDate()).padStart(2, '0');
                const expectedPrefix = yy + mm + dd;
                if (val.slice(0, 6) !== expectedPrefix) {
                    setInputState(document.getElementById('idNumber'), 'invalid');
                    showMsg('idnumber-msg', 'error', 'First 6 digits must match your date of birth (' + expectedPrefix + ').');
                    return false;
                }
            }

            setInputState(document.getElementById('idNumber'), 'valid');
            showMsg('idnumber-msg', 'success', 'Looks good!');
            return true;
        }

        function validateDOB() {
            const val = document.getElementById('dateOfBirth').value;
            if (!val) {
                setInputState(document.getElementById('dateOfBirth'), 'invalid');
                showMsg('dob-msg', 'error', 'Date of birth is required.');
                return false;
            }
            setInputState(document.getElementById('dateOfBirth'), 'valid');
            clearMsg('dob-msg');

            // re-validate ID if already filled so mismatch shows immediately
            const idVal = document.getElementById('idNumber').value.trim();
            if (idVal.length === 13) validateIDNumber();

            return true;
        }

        function validateCellphone() {
            const val = document.getElementById('cellphone').value.trim();
            const dialCode = document.getElementById('dialCode').value;

            if (!val) {
                setInputState(document.getElementById('cellphone'), 'invalid');
                showMsg('cellphone-msg', 'error', 'Cellphone is required.');
                return false;
            }

            // SA numbers must be 10 digits starting with 0
            if (dialCode === '+27') {
                if (!/^0\d{9}$/.test(val)) {
                    setInputState(document.getElementById('cellphone'), 'invalid');
                    showMsg('cellphone-msg', 'error', 'SA number must be 10 digits starting with 0.');
                    return false;
                }
            } else {
                // for other countries just check its all digits, 5-15 long
                if (!/^\d{5,15}$/.test(val)) {
                    setInputState(document.getElementById('cellphone'), 'invalid');
                    showMsg('cellphone-msg', 'error', 'Enter a valid phone number.');
                    return false;
                }
            }

            setInputState(document.getElementById('cellphone'), 'valid');
            clearMsg('cellphone-msg');
            return true;
        }

        function validateAddress() {
            const val = document.getElementById('homeAddress').value.trim();
            if (!val) { setInputState(document.getElementById('homeAddress'),'invalid'); showMsg('address-msg','error','Home address is required.'); return false; }
            setInputState(document.getElementById('homeAddress'),'valid'); clearMsg('address-msg'); return true;
        }

        function validatePassword() {
            const val = document.getElementById('password').value;
            if (!val) { setInputState(document.getElementById('password'),'invalid'); showMsg('password-msg','error','Password is required.'); return false; }
            if (val.length < 6) { setInputState(document.getElementById('password'),'invalid'); showMsg('password-msg','error','At least 6 characters.'); return false; }
            setInputState(document.getElementById('password'),'valid'); clearMsg('password-msg'); return true;
        }

        function validateConfirm() {
            const val = document.getElementById('confirmPassword').value;
            const pw = document.getElementById('password').value;
            if (!val) { setInputState(document.getElementById('confirmPassword'),'invalid'); showMsg('confirm-msg','error','Please confirm your password.'); return false; }
            if (val !== pw) { setInputState(document.getElementById('confirmPassword'),'invalid'); showMsg('confirm-msg','error','Passwords do not match.'); return false; }
            setInputState(document.getElementById('confirmPassword'),'valid'); showMsg('confirm-msg','success','Passwords match!'); return true;
        }

        
        document.getElementById('username').addEventListener('blur', validateUsername);
        document.getElementById('email').addEventListener('blur', validateEmail);
        document.getElementById('firstName').addEventListener('blur', validateFirstName);
        document.getElementById('lastName').addEventListener('blur', validateLastName);
        document.getElementById('idNumber').addEventListener('blur', validateIDNumber);
        document.getElementById('dateOfBirth').addEventListener('blur', validateDOB);
        document.getElementById('cellphone').addEventListener('blur', validateCellphone);
        document.getElementById('homeAddress').addEventListener('blur', validateAddress);
        document.getElementById('password').addEventListener('blur', validatePassword);
        document.getElementById('confirmPassword').addEventListener('blur', validateConfirm);
        document.getElementById('confirmPassword').addEventListener('input', () => {
            if (document.getElementById('confirmPassword').classList.contains('invalid')) validateConfirm();
        });

        // Submit
        document.getElementById('registerForm').addEventListener('submit', function(e) {
            const ok = [
                validateUsername(), validateEmail(),
                validateFirstName(), validateLastName(),
                validateIDNumber(), validateDOB(),
                validateCellphone(), validateAddress(),
                validatePassword(), validateConfirm()
            ];
            if (ok.includes(false)) e.preventDefault();
        });
    </script>
</body>
</html>