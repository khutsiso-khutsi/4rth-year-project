@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --teal: #0d9488;
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.06);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 28px;
        }

        .logo-icon {
            width: 38px;
            height: 38px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .logo-icon svg {
                width: 20px;
                height: 20px;
                fill: white;
            }

        .logo-text {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--navy);
        }

            .logo-text span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.6rem;
                font-weight: 300;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: 0.08em;
            }

        h2 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.5rem;
            color: var(--navy);
            margin-bottom: 8px;
        }

        .sub {
            font-size: 13.5px;
            color: var(--muted);
            margin-bottom: 24px;
            line-height: 1.6;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-label {
            display: block;
            font-size: 12.5px;
            font-weight: 500;
            color: var(--navy);
            margin-bottom: 6px;
        }

        .form-input {
            width: 100%;
            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            padding: 10px 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--navy);
            outline: none;
            transition: border-color 0.2s;
        }

            .form-input:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(13,148,136,0.1);
            }

        .btn {
            width: 100%;
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            font-weight: 500;
            padding: 11px;
            border-radius: 8px;
            border: none;
            background: var(--teal);
            color: white;
            cursor: pointer;
            transition: background 0.2s;
            margin-top: 8px;
        }

            .btn:hover {
                background: #0f7a70;
            }

        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 16px;
        }

        .alert-success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .alert-error {
            background: #fef2f2;
            color: var(--red);
            border: 1px solid #fecaca;
        }

        .alert-info {
            background: #e8f0fe;
            color: #1a4f8a;
            border: 1px solid #bfcfee;
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            font-size: 13px;
            color: var(--muted);
            text-decoration: none;
        }

            .back-link:hover {
                color: var(--teal);
            }

        .divider {
            border: none;
            border-top: 1px solid var(--border);
            margin: 20px 0;
        }

        .lock-icon {
            width: 48px;
            height: 48px;
            background: var(--teal-light, #e8f5f3);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
        }

            .lock-icon svg {
                width: 24px;
                height: 24px;
                stroke: var(--teal);
            }
    </style>
</head>
<body>
    <div class="card">
        <div class="logo">
            <div class="logo-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" />
                    <circle cx="12" cy="17" r="4" opacity="0.6" />
                </svg>
            </div>
            <div class="logo-text">NMB-HLabSys <span>Haematology Lab System</span></div>
        </div>

        <div class="lock-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
        </div>

        <h2>Forgot password?</h2>
        <p class="sub">Enter the email address linked to your account and we'll send you a new temporary password.</p>

        @if (TempData["Info"] != null)
        {
            <div class="alert alert-success">
                ✓ @TempData["Info"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">@TempData["Error"]</div>
        }

        <form method="post" asp-controller="Home" asp-action="ForgotPassword">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Email address</label>
                <input class="form-input" type="email" name="email" required placeholder="you@example.com" autofocus />
            </div>
            <button type="submit" class="btn">Send me a new password</button>
        </form>

        <hr class="divider" />
        <a class="back-link" asp-controller="Home" asp-action="Login">← Back to sign in</a>
    </div>
</body>
</html>