@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --teal: #0d9488;
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--navy);
            color: var(--navy);
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
        }

        /* ── LEFT PANEL ─────────────────────────── */
        .left-panel {
            width: 45%;
            min-width: 320px;
            height: 100vh;
            background: var(--navy);
            display: flex;
            flex-direction: column;
            padding: 48px;
            position: sticky;
            top: 0;
            overflow: hidden;
        }

            .left-panel::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 70% 60% at 80% 30%, rgba(13,148,136,0.15) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 10% 80%, rgba(26,79,138,0.25) 0%, transparent 55%);
            }

            .left-panel::after {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
                background-size: 48px 48px;
            }

        .panel-content {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            height: 100%;
            justify-content: space-between;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .brand-logo {
            width: 40px;
            height: 40px;
            background: var(--teal);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .brand-logo svg {
                width: 22px;
                height: 22px;
                fill: white;
            }

        .brand-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.15rem;
            color: var(--white);
            line-height: 1.2;
        }

            .brand-title span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.65rem;
                font-weight: 300;
                color: rgba(255,255,255,0.45);
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

        .panel-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 60px 0 40px;
        }

        .panel-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(13,148,136,0.15);
            border: 1px solid rgba(13,148,136,0.3);
            color: #5eead4;
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 5px 12px;
            border-radius: 100px;
            margin-bottom: 24px;
            width: fit-content;
        }

            .panel-tag::before {
                content: '';
                width: 6px;
                height: 6px;
                background: #5eead4;
                border-radius: 50%;
            }

        .panel-heading {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2rem, 3vw, 3rem);
            color: white;
            line-height: 1.2;
            margin-bottom: 20px;
        }

            .panel-heading em {
                font-style: italic;
                color: #5eead4;
            }

        .panel-desc {
            color: rgba(255,255,255,0.5);
            font-size: 0.9rem;
            line-height: 1.75;
            font-weight: 300;
            max-width: 340px;
        }

        .info-tiles {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .info-tile {
            display: flex;
            align-items: center;
            gap: 14px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 12px;
            padding: 14px 18px;
        }

        .tile-icon {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .tile-icon svg {
                width: 16px;
                height: 16px;
            }

        .tile-text {
            font-size: 0.82rem;
            color: rgba(255,255,255,0.55);
            line-height: 1.4;
        }

            .tile-text strong {
                display: block;
                color: rgba(255,255,255,0.85);
                font-weight: 500;
                margin-bottom: 2px;
            }

        /* ── RIGHT PANEL ────────────────────────── */
        .right-panel {
            flex: 1;
            background: var(--offwhite);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px;
            min-height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .form-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 24px;
            padding: 48px 44px;
            width: 100%;
            max-width: 440px;
            box-sizing: border-box;
            box-shadow: 0 4px 40px rgba(11,31,58,0.08);
        }

        .form-header {
            margin-bottom: 36px;
        }

            .form-header h2 {
                font-family: 'DM Serif Display', serif;
                font-size: 1.9rem;
                color: var(--navy);
                margin-bottom: 8px;
            }

            .form-header p {
                color: var(--muted);
                font-size: 0.875rem;
                line-height: 1.6;
            }

        /* ── FORM FIELDS ────────────────────────── */
        .field {
            margin-bottom: 20px;
        }

            .field label {
                display: block;
                font-size: 0.82rem;
                font-weight: 600;
                color: var(--navy);
                margin-bottom: 7px;
                letter-spacing: 0.01em;
            }

        .input-wrap {
            position: relative;
        }

            .input-wrap input {
                width: 100%;
                padding: 12px 42px 12px 16px;
                border: 1.5px solid var(--border);
                border-radius: 10px;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.92rem;
                color: var(--navy);
                background: var(--offwhite);
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            }

                .input-wrap input:focus {
                    border-color: var(--teal);
                    background: white;
                    box-shadow: 0 0 0 3px rgba(13,148,136,0.1);
                }

                .input-wrap input.valid {
                    border-color: var(--green);
                    background: white;
                }

                    .input-wrap input.valid:focus {
                        box-shadow: 0 0 0 3px rgba(22,163,74,0.1);
                    }

                .input-wrap input.invalid {
                    border-color: var(--red);
                    background: white;
                }

                    .input-wrap input.invalid:focus {
                        box-shadow: 0 0 0 3px rgba(220,38,38,0.1);
                    }

        .toggle-pw {
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            color: var(--muted);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s;
        }

            .toggle-pw:hover {
                color: var(--navy);
            }

            .toggle-pw svg {
                width: 17px;
                height: 17px;
            }

        .val-msg {
            font-size: 0.76rem;
            margin-top: 6px;
            min-height: 18px;
            display: flex;
            align-items: center;
            gap: 5px;
            opacity: 0;
            transition: opacity 0.2s;
        }

            .val-msg.show {
                opacity: 1;
            }

            .val-msg.error {
                color: var(--red);
            }

            .val-msg.success {
                color: var(--green);
            }

            .val-msg svg {
                width: 13px;
                height: 13px;
                flex-shrink: 0;
            }

        /* password strength */
        .strength-bar {
            display: flex;
            gap: 4px;
            margin-top: 8px;
        }

            .strength-bar span {
                flex: 1;
                height: 3px;
                border-radius: 100px;
                background: var(--border);
                transition: background 0.3s;
            }

        .strength-label {
            font-size: 0.72rem;
            color: var(--muted);
            margin-top: 5px;
            min-height: 16px;
            transition: color 0.2s;
        }

        /* remember + forgot */
        .form-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 28px;
            margin-top: 4px;
        }

        .remember {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            user-select: none;
        }

            .remember input[type="checkbox"] {
                width: 16px;
                height: 16px;
                accent-color: var(--teal);
                cursor: pointer;
            }

            .remember span {
                font-size: 0.82rem;
                color: var(--muted);
            }

        .forgot-link {
            font-size: 0.82rem;
            color: var(--teal);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }

            .forgot-link:hover {
                color: #0f7a70;
                text-decoration: underline;
            }

        /* error alert (server-side) */
        .alert-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 10px;
            padding: 12px 16px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 24px;
            font-size: 0.83rem;
            color: var(--red);
        }

            .alert-error svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
                margin-top: 1px;
            }

        /* submit */
        .btn-submit {
            width: 100%;
            background: var(--teal);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .btn-submit:hover {
                background: #0f7a70;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(13,148,136,0.3);
            }

            .btn-submit:active {
                transform: translateY(0);
            }

            .btn-submit svg {
                width: 17px;
                height: 17px;
            }

        .back-link {
            display: flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            color: var(--muted);
            font-size: 0.82rem;
            margin-top: 24px;
            justify-content: center;
            transition: color 0.2s;
        }

            .back-link:hover {
                color: var(--navy);
            }

            .back-link svg {
                width: 14px;
                height: 14px;
            }

        /* ── DEV SHORTCUT TILES ─────────────────────────── */
        .dev-shortcuts {
            width: 100%;
            max-width: 440px;
            margin-top: 20px;
        }

        .dev-shortcuts-label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

            .dev-shortcuts-label::before,
            .dev-shortcuts-label::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border);
            }

        .shortcut-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
        }

        .shortcut-tile {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            background: white;
            border: 1.5px solid var(--border);
            border-radius: 12px;
            padding: 10px 6px;
            text-decoration: none;
            cursor: pointer;
            transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s;
        }

            .shortcut-tile:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 16px rgba(11,31,58,0.1);
            }

            .shortcut-tile .st-icon {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .shortcut-tile .st-icon svg {
                    width: 16px;
                    height: 16px;
                }

            .shortcut-tile .st-name {
                font-size: 0.68rem;
                font-weight: 600;
                text-align: center;
                line-height: 1.2;
            }

        /* per-role colours */
        .st-admin { border-color: rgba(13,148,136,0.3); }
        .st-admin:hover { border-color: var(--teal); }
        .st-admin .st-icon { background: rgba(13,148,136,0.1); }
        .st-admin .st-icon svg { stroke: var(--teal); }
        .st-admin .st-name { color: var(--teal); }

        .st-manager { border-color: rgba(79,70,229,0.25); }
        .st-manager:hover { border-color: #4f46e5; }
        .st-manager .st-icon { background: rgba(79,70,229,0.08); }
        .st-manager .st-icon svg { stroke: #4f46e5; }
        .st-manager .st-name { color: #4f46e5; }

        .st-doctor { border-color: rgba(37,99,235,0.25); }
        .st-doctor:hover { border-color: #2563eb; }
        .st-doctor .st-icon { background: rgba(37,99,235,0.08); }
        .st-doctor .st-icon svg { stroke: #2563eb; }
        .st-doctor .st-name { color: #2563eb; }

        .st-tech { border-color: rgba(234,88,12,0.25); }
        .st-tech:hover { border-color: #ea580c; }
        .st-tech .st-icon { background: rgba(234,88,12,0.08); }
        .st-tech .st-icon svg { stroke: #ea580c; }
        .st-tech .st-name { color: #ea580c; }

        .st-patient { border-color: rgba(22,163,74,0.25); }
        .st-patient:hover { border-color: var(--green); }
        .st-patient .st-icon { background: rgba(22,163,74,0.08); }
        .st-patient .st-icon svg { stroke: var(--green); }
        .st-patient .st-name { color: var(--green); }

        @@media (max-width: 900px) {
            .left-panel {
                display: none;
            }

            .right-panel {
                padding: 32px 20px;
            }

            .form-card {
                padding: 36px 28px;
            }
        }
    </style>
</head>
<body>

    <!-- LEFT PANEL -->
    <div class="left-panel">
        <div class="panel-content">

            <a class="brand" asp-controller="Home" asp-action="Index">
                <div class="brand-logo">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" />
                        <circle cx="12" cy="17" r="4" opacity="0.6" />
                    </svg>
                </div>
                <div class="brand-title">
                    NMB-HLabSys
                    <span>Haematology Lab System</span>
                </div>
            </a>

            <div class="panel-body">
                <div class="panel-tag">Secure Access</div>
                <h2 class="panel-heading">
                    Welcome<br />Back to <em>NMB</em>
                </h2>
                <p class="panel-desc">
                    Sign in to access your role-based portal —
                    whether you're a doctor, technician, patient or administrator.
                </p>
            </div>

            <div class="info-tiles">
                <div class="info-tile">
                    <div class="tile-icon" style="background:rgba(13,148,136,0.15)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#5eead4" stroke-width="2" stroke-linecap="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                    </div>
                    <div class="tile-text">
                        <strong>Role-Based Access</strong>
                        Your portal loads automatically based on your role.
                    </div>
                </div>
                <div class="info-tile">
                    <div class="tile-icon" style="background:rgba(26,79,138,0.15)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#93c5fd" stroke-width="2" stroke-linecap="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        </svg>
                    </div>
                    <div class="tile-text">
                        <strong>Secure &amp; Private</strong>
                        All data is encrypted and access is fully audited.
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="right-panel">
        <div style="display:flex;flex-direction:column;align-items:center;width:100%;max-width:440px;overflow:hidden;">

            <div class="form-card">

                <div class="form-header">
                    <h2>Sign In</h2>
                    <p>Enter your credentials to access your portal.</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-error">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        <span>Invalid username or password. Please try again.</span>
                    </div>
                }

                <form id="loginForm" asp-controller="Home" asp-action="Login" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Username -->
                    <div class="field">
                        <label for="username">Username</label>
                        <div class="input-wrap">
                            <input type="text"
                                   id="username"
                                   name="Username"
                                   placeholder="Enter your username"
                                   autocomplete="username" />
                        </div>
                        <div class="val-msg" id="username-msg"></div>
                    </div>

                    <!-- Password -->
                    <div class="field">
                        <label for="password">Password</label>
                        <div class="input-wrap">
                            <input type="password"
                                   id="password"
                                   name="Password"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" />
                            <button type="button" class="toggle-pw" id="togglePw" aria-label="Toggle password visibility">
                                <svg id="eyeShow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg id="eyeHide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                </svg>
                            </button>
                        </div>
                        <div class="strength-bar">
                            <span id="s1"></span>
                            <span id="s2"></span>
                            <span id="s3"></span>
                            <span id="s4"></span>
                        </div>
                        <div class="strength-label" id="strengthLabel"></div>
                        <div class="val-msg" id="password-msg"></div>
                    </div>

                    <!-- Remember me + Forgot -->
                    <div class="form-row">
                        <label class="remember">
                            <input type="checkbox" id="rememberMe" name="RememberMe" />
                            <span>Remember me</span>
                        </label>
                        <a asp-controller="Home" asp-action="ForgotPassword" class="forgot-link">Forgot password?</a>
                    </div>

                    <!-- Submit -->
                    <button type="submit" class="btn-submit">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                            <polyline points="10 17 15 12 10 7" />
                            <line x1="15" y1="12" x2="3" y2="12" />
                        </svg>
                        Sign In
                    </button>
                </form>

                <a asp-controller="Home" asp-action="Index" class="back-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <polyline points="15 18 9 12 15 6" />
                    </svg>
                    Back to Home
                </a>
                <p class="signin-link" style="text-align:center;margin-top:20px;font-size:0.83rem;color:var(--muted)">
                    Don't have an account? <a asp-controller="Home" asp-action="Register" style="color:var(--teal);font-weight:500">Create one</a>
                </p>

            </div><!-- /form-card -->

            <!-- ── DEV SHORTCUTS ──────────────────────────────────── -->
            <div class="dev-shortcuts">
                <div class="dev-shortcuts-label">Dev shortcuts</div>
                <div class="shortcut-grid">

                    <!-- Admin -->
                    <a class="shortcut-tile st-admin" href="/Home/DevLogin?role=Admin">
                        <div class="st-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="4"/>
                                <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                                <polyline points="16 3 21 3 21 8"/>
                                <line x1="15" y1="9" x2="21" y2="3"/>
                            </svg>

                        </div>
                        <span class="st-name">Admin</span>
                    </a>

                    <!-- Manager -->
                    <a class="shortcut-tile st-manager" asp-controller="Manager" asp-action="Dashboard">
                        <div class="st-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="3" width="20" height="14" rx="2"/>
                                <line x1="8" y1="21" x2="16" y2="21"/>
                                <line x1="12" y1="17" x2="12" y2="21"/>
                            </svg>
                        </div>
                        <span class="st-name">Manager</span>
                    </a>

                    <!-- Doctor -->
                    <a class="shortcut-tile st-doctor" asp-controller="Doctor" asp-action="Dashboard">
                        <div class="st-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2a4 4 0 0 1 4 4 7 7 0 0 1-8 0 4 4 0 0 1 4-4z"/>
                                <path d="M4 20v-2a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v2"/>
                                <line x1="12" y1="12" x2="12" y2="16"/>
                                <line x1="10" y1="14" x2="14" y2="14"/>
                            </svg>
                        </div>
                        <span class="st-name">Doctor</span>
                    </a>

                    <!-- Technician -->
                    <a class="shortcut-tile st-tech" asp-controller="Technician" asp-action="Dashboard">
                        <div class="st-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2v-4M9 21H5a2 2 0 0 1-2-2v-4m0 0h18"/>
                            </svg>
                        </div>
                        <span class="st-name">Tech</span>
                    </a>

                    <!-- Patient -->
                    <a class="shortcut-tile st-patient" href="/Home/DevLogin?role=Patient">
                        <div class="st-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                        </div>
                        <span class="st-name">Patient</span>
                    </a>

                </div>
            </div>
           

        </div>
    </div>

    <script>
        /* ── TOGGLE PASSWORD VISIBILITY ─── */
        const pwInput   = document.getElementById('password');
        const toggleBtn = document.getElementById('togglePw');
        const eyeShow   = document.getElementById('eyeShow');
        const eyeHide   = document.getElementById('eyeHide');

        toggleBtn.addEventListener('click', () => {
            const isHidden = pwInput.type === 'password';
            pwInput.type          = isHidden ? 'text'    : 'password';
            eyeShow.style.display = isHidden ? 'none'   : '';
            eyeHide.style.display = isHidden ? ''       : 'none';
        });

        /* ── PASSWORD STRENGTH ──────────── */
        const bars         = ['s1','s2','s3','s4'].map(id => document.getElementById(id));
        const strengthLabel = document.getElementById('strengthLabel');
        const strengthColors = ['#dc2626','#ea580c','#ca8a04','#16a34a'];
        const strengthNames  = ['Weak','Fair','Good','Strong'];

        function getStrength(val) {
            let score = 0;
            if (val.length >= 8)           score++;
            if (/[A-Z]/.test(val))         score++;
            if (/[0-9]/.test(val))         score++;
            if (/[^A-Za-z0-9]/.test(val))  score++;
            return score;
        }

        function updateStrength(val) {
            if (!val) {
                bars.forEach(b => b.style.background = '');
                strengthLabel.textContent = '';
                return;
            }
            const score = getStrength(val);
            bars.forEach((b, i) => {
                b.style.background = i < score ? strengthColors[score - 1] : '';
            });
            strengthLabel.style.color = strengthColors[score - 1];
            strengthLabel.textContent = strengthNames[score - 1] + ' password';
        }

        pwInput.addEventListener('input', () => updateStrength(pwInput.value));

        /* ── VALIDATION HELPERS ─────────── */
        function showMsg(id, type, text) {
            const el = document.getElementById(id);
            el.className = 'val-msg show ' + type;
            el.innerHTML = type === 'error'
                ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>${text}`
                : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>${text}`;
        }

        function clearMsg(id) {
            const el = document.getElementById(id);
            el.className = 'val-msg';
            el.innerHTML = '';
        }

        function setInputState(input, state) {
            input.classList.remove('valid', 'invalid');
            if (state) input.classList.add(state);
        }

        /* ── USERNAME VALIDATION ────────── */
        const usernameInput = document.getElementById('username');

        function validateUsername() {
            const val = usernameInput.value.trim();
            if (!val) {
                setInputState(usernameInput, 'invalid');
                showMsg('username-msg', 'error', 'Username is required.');
                return false;
            }
            if (val.length < 3) {
                setInputState(usernameInput, 'invalid');
                showMsg('username-msg', 'error', 'Username must be at least 3 characters.');
                return false;
            }
            if (/\s/.test(val)) {
                setInputState(usernameInput, 'invalid');
                showMsg('username-msg', 'error', 'Username cannot contain spaces.');
                return false;
            }
            setInputState(usernameInput, 'valid');
            showMsg('username-msg', 'success', 'Looks good!');
            return true;
        }

        usernameInput.addEventListener('blur', validateUsername);
        usernameInput.addEventListener('input', () => {
            if (usernameInput.classList.contains('invalid')) validateUsername();
        });

        /* ── PASSWORD VALIDATION ────────── */
        function validatePassword() {
            const val = pwInput.value;
            if (!val) {
                setInputState(pwInput, 'invalid');
                showMsg('password-msg', 'error', 'Password is required.');
                return false;
            }
            if (val.length < 6) {
                setInputState(pwInput, 'invalid');
                showMsg('password-msg', 'error', 'Password must be at least 6 characters.');
                return false;
            }
            setInputState(pwInput, 'valid');
            clearMsg('password-msg');
            return true;
        }

        pwInput.addEventListener('blur', validatePassword);
        pwInput.addEventListener('input', () => {
            if (pwInput.classList.contains('invalid')) validatePassword();
        });

        /* ── FORM SUBMIT ────────────────── */
        document.getElementById('loginForm').addEventListener('submit', function (e) {
            const uOk = validateUsername();
            const pOk = validatePassword();
            if (!uOk || !pOk) e.preventDefault();
        });
    </script>
</body>
</html>
