@{
    ViewData["Title"] = "Verify Email";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Email — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@@0;1&family=DM+Sans:wght@@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy: #0b1f3a;
            --teal: #0d9488;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--navy);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            position: relative;
            overflow: hidden;
        }

        body::before {
            content: '';
            position: absolute; inset: 0;
            background: radial-gradient(ellipse 60% 60% at 80% 30%, rgba(13,148,136,0.15) 0%, transparent 60%);
        }

        body::after {
            content: '';
            position: absolute; inset: 0;
            background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
                              linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
            background-size: 48px 48px;
        }

        .card {
            background: white;
            border-radius: 24px;
            padding: 40px 36px;
            width: 100%; max-width: 420px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
            position: relative; z-index: 2;
            text-align: center;
        }

        .brand {
            display: flex; align-items: center;
            justify-content: center; gap: 10px;
            margin-bottom: 28px;
            text-decoration: none;
        }

        .brand-logo {
            width: 36px; height: 36px;
            background: var(--teal); border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
        }

        .brand-logo svg { width: 18px; height: 18px; fill: white; }

        .brand-name {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem; color: var(--navy);
        }

        .icon-wrap {
            width: 64px; height: 64px;
            background: rgba(13,148,136,0.1);
            border-radius: 50%; margin: 0 auto 20px;
            display: flex; align-items: center; justify-content: center;
        }

        .icon-wrap svg { width: 28px; height: 28px; stroke: var(--teal); }

        h2 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.6rem; color: var(--navy); margin-bottom: 10px;
        }

        .subtitle {
            color: var(--muted); font-size: 0.875rem;
            line-height: 1.6; margin-bottom: 28px;
        }

        .subtitle strong { color: var(--navy); }

        .alert {
            padding: 10px 16px; border-radius: 10px;
            font-size: 0.82rem; font-weight: 500;
            margin-bottom: 20px; text-align: left;
            display: flex; align-items: center; gap: 8px;
        }

        .alert-error { background: #fef2f2; color: var(--red); border: 1px solid #fecaca; }
        .alert-success { background: #f0fdf4; color: var(--green); border: 1px solid #bbf7d0; }

        /* CODE INPUT BOXES */
        .code-inputs {
            display: flex; gap: 10px;
            justify-content: center; margin-bottom: 24px;
        }

        .code-input {
            width: 52px; height: 60px;
            border: 2px solid var(--border);
            border-radius: 12px;
            font-family: 'DM Serif Display', serif;
            font-size: 1.6rem; text-align: center;
            color: var(--navy); background: var(--offwhite);
            outline: none; transition: all 0.2s;
        }

        .code-input:focus {
            border-color: var(--teal);
            background: white;
            box-shadow: 0 0 0 3px rgba(13,148,136,0.1);
        }

        .code-input.filled { border-color: var(--teal); background: white; }

        .btn-verify {
            width: 100%; background: var(--teal); color: white;
            border: none; padding: 13px; border-radius: 10px;
            font-family: 'DM Sans', sans-serif; font-size: 0.92rem;
            font-weight: 600; cursor: pointer;
            transition: all 0.2s; margin-bottom: 16px;
        }

        .btn-verify:hover { background: #0f7a70; }
        .btn-verify:disabled { background: var(--border); color: var(--muted); cursor: not-allowed; }

        .resend-row {
            display: flex; align-items: center;
            justify-content: center; gap: 6px;
            font-size: 0.82rem; color: var(--muted);
        }

        .resend-btn {
            background: none; border: none; cursor: pointer;
            color: var(--teal); font-weight: 600;
            font-family: 'DM Sans', sans-serif; font-size: 0.82rem;
            padding: 0; transition: color 0.2s;
        }

        .resend-btn:hover { color: #0f7a70; }
        .resend-btn:disabled { color: var(--muted); cursor: not-allowed; }

        .timer { font-weight: 600; color: var(--navy); }

        .back-link {
            display: block; margin-top: 20px;
            font-size: 0.82rem; color: var(--muted);
            text-decoration: none; transition: color 0.2s;
        }

        .back-link:hover { color: var(--navy); }
    </style>
</head>
<body>
    <div class="card">

        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <span class="brand-name">NMB-HLabSys</span>
        </a>

        <div class="icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                <polyline points="22,6 12,13 2,6" />
            </svg>
        </div>

        <h2>Check Your Email</h2>
        <p class="subtitle">
            We sent a 6-digit code to<br />
            <strong>@ViewBag.Email</strong><br />
            Enter it below to verify your account.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-error">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                @ViewBag.Error
            </div>
        }

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg>
                @ViewBag.Success
            </div>
        }

        <form asp-controller="Home" asp-action="VerifyEmail" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Code" id="hiddenCode" />

            <div class="code-inputs">
                <input type="text" class="code-input" maxlength="1" inputmode="numeric" />
                <input type="text" class="code-input" maxlength="1" inputmode="numeric" />
                <input type="text" class="code-input" maxlength="1" inputmode="numeric" />
                <input type="text" class="code-input" maxlength="1" inputmode="numeric" />
                <input type="text" class="code-input" maxlength="1" inputmode="numeric" />
                <input type="text" class="code-input" maxlength="1" inputmode="numeric" />
            </div>

            <button type="submit" class="btn-verify" id="verifyBtn" disabled>Verify Email</button>
        </form>

        <div class="resend-row">
            Didn't get a code?
            <form asp-controller="Home" asp-action="ResendCode" method="post" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="resend-btn" id="resendBtn" disabled>
                    Resend code
                </button>
            </form>
            <span class="timer" id="timer"></span>
        </div>

        <a class="back-link" asp-controller="Home" asp-action="Register">← Back to Register</a>
    </div>

    <script>
        // ── CODE INPUT LOGIC ──
        const inputs = document.querySelectorAll('.code-input');
        const hiddenCode = document.getElementById('hiddenCode');
        const verifyBtn = document.getElementById('verifyBtn');

        inputs.forEach((input, i) => {
            input.addEventListener('input', () => {
                input.value = input.value.replace(/\D/g, '');
                if (input.value) {
                    input.classList.add('filled');
                    if (i < inputs.length - 1) inputs[i + 1].focus();
                } else {
                    input.classList.remove('filled');
                }
                updateCode();
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !input.value && i > 0) {
                    inputs[i - 1].focus();
                    inputs[i - 1].value = '';
                    inputs[i - 1].classList.remove('filled');
                    updateCode();
                }
            });

            input.addEventListener('paste', (e) => {
                e.preventDefault();
                const paste = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
                paste.split('').forEach((char, idx) => {
                    if (inputs[idx]) {
                        inputs[idx].value = char;
                        inputs[idx].classList.add('filled');
                    }
                });
                updateCode();
                if (inputs[paste.length - 1]) inputs[paste.length - 1].focus();
            });
        });

        function updateCode() {
            const code = Array.from(inputs).map(i => i.value).join('');
            hiddenCode.value = code;
            verifyBtn.disabled = code.length !== 6;
        }

        // Auto focus first input
        inputs[0].focus();

        // ── RESEND COUNTDOWN ──
        const resendBtn = document.getElementById('resendBtn');
        const timerEl = document.getElementById('timer');
        let seconds = 60;

        function countdown() {
            if (seconds > 0) {
                timerEl.textContent = `(${seconds}s)`;
                seconds--;
                setTimeout(countdown, 1000);
            } else {
                timerEl.textContent = '';
                resendBtn.disabled = false;
            }
        }

        countdown();
    </script>
</body>
</html>