    <script>
        // ── FAQ ──
        function toggleFaq(btn) {
            const item = btn.closest('.faq-item');
            const isOpen = item.classList.contains('open');
            document.querySelectorAll('.faq-item.open').forEach(i => i.classList.remove('open'));
            if (!isOpen) item.classList.add('open');
        }

        // ── CHAT ──
        function toggleChat() {
            document.getElementById('chatWindow').classList.toggle('open');
        }

        const responses = {
            'register': 'To register, click the <strong>Register</strong> button in the navigation bar or on the hero section. Fill in your personal details including your SA ID number and you\'re good to go!',
            'results': 'After logging in, go to <strong>My Results</strong> in the sidebar of your patient dashboard. Results are visible once your doctor has released them.',
            'password': 'On the login page, click <strong>Forgot Password</strong>. Enter your email address and we\'ll send you a reset link.',
            'secure': 'Yes! All passwords are BCrypt encrypted, access is role-based, and every action is recorded in an audit trail.',
            'pdf': 'Yes! Once your results are released, click <strong>Download PDF</strong> on your results page.',
            'contact': 'You can email us at <strong>support@nmb-hlabsys.ac.za</strong> or keep chatting here!',
            'doctor': 'Doctors are assigned to patients by the system administrator. Contact your clinic to be assigned to a doctor.',
            'login': 'Click the <strong>Login</strong> button in the navigation bar and enter your username and password.',
        };

        function getBotResponse(msg) {
            const m = msg.toLowerCase();
            if (m.includes('register') || m.includes('sign up') || m.includes('create')) return responses['register'];
            if (m.includes('result') || m.includes('test')) return responses['results'];
            if (m.includes('password') || m.includes('forgot') || m.includes('reset')) return responses['password'];
            if (m.includes('secure') || m.includes('safe') || m.includes('privacy') || m.includes('data')) return responses['secure'];
            if (m.includes('pdf') || m.includes('download') || m.includes('export')) return responses['pdf'];
            if (m.includes('contact') || m.includes('support') || m.includes('help') || m.includes('email')) return responses['contact'];
            if (m.includes('doctor') || m.includes('assign') || m.includes('dr')) return responses['doctor'];
            if (m.includes('login') || m.includes('sign in')) return responses['login'];
            return "I'm not sure about that. Please email us at <strong>support@nmb-hlabsys.ac.za</strong> or check the FAQ section above for more answers.";
        }

        function addMessage(text, type) {
            const msgs = document.getElementById('chatMessages');
            const div = document.createElement('div');
            div.className = `msg ${type}`;
            div.innerHTML = type === 'bot'
                ? `<div class="msg-avatar">N</div><div class="msg-bubble">${text}</div>`
                : `<div class="msg-bubble">${text}</div>`;
            msgs.appendChild(div);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function addTyping() {
            const msgs = document.getElementById('chatMessages');
            const div = document.createElement('div');
            div.className = 'msg bot'; div.id = 'typingIndicator';
            div.innerHTML = `<div class="msg-avatar">N</div><div class="msg-bubble"><div class="typing"><span></span><span></span><span></span></div></div>`;
            msgs.appendChild(div);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function removeTyping() {
            const t = document.getElementById('typingIndicator');
            if (t) t.remove();
        }

        function askQuestion(q) {
            document.getElementById('chatSuggestions').style.display = 'none';
            addMessage(q, 'user');
            addTyping();
            setTimeout(() => {
                removeTyping();
                addMessage(getBotResponse(q), 'bot');
            }, 900);
        }

        function sendMessage() {
            const input = document.getElementById('chatInput');
            const msg = input.value.trim();
            if (!msg) return;
            document.getElementById('chatSuggestions').style.display = 'none';
            input.value = '';
            addMessage(msg, 'user');
            addTyping();
            setTimeout(() => {
                removeTyping();
                addMessage(getBotResponse(msg), 'bot');
            }, 900);
        }
    </script>
</body>
</html>