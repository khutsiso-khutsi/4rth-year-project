@{
    ViewData["Title"] = "Change Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Choose Your Password — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy: #0b1f3a;
            --teal: #0d9488;
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            padding: 16px;
        }

        .card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 40px;
            width: 100%; max-width: 440px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.06);
        }

        .logo { display: flex; align-items: center; gap: 10px; margin-bottom: 28px; }
        .logo-icon { width: 38px; height: 38px; background: var(--teal); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
        .logo-icon svg { width: 20px; height: 20px; fill: white; }
        .logo-text { font-family: 'DM Serif Display', serif; font-size: 1.1rem; color: var(--navy); }
        .logo-text span { display: block; font-family: 'DM Sans', sans-serif; font-size: 0.6rem; font-weight: 300; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }

        h2 { font-family: 'DM Serif Display', serif; font-size: 1.5rem; color: var(--navy); margin-bottom: 8px; }
        .sub { font-size: 13.5px; color: var(--muted); margin-bottom: 20px; line-height: 1.55; }
        .who { display: inline-block; background: rgba(13,148,136,0.08); color: var(--teal); font-weight: 600; font-size: 12.5px; padding: 3px 10px; border-radius: 100px; margin-bottom: 20px; }

        .form-group { margin-bottom: 16px; }
        .form-label { display: block; font-size: 12.5px; font-weight: 500; color: var(--navy); margin-bottom: 6px; }
        .pw-wrap { position: relative; }
        .form-input {
            width: 100%; font-family: 'DM Sans', sans-serif; font-size: 13.5px;
            padding: 10px 64px 10px 12px; border: 1px solid var(--border); border-radius: 8px;
            color: var(--navy); outline: none; transition: border-color 0.2s, box-shadow 0.2s;
        }
        .form-input:focus { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(13,148,136,0.1); }
        .toggle-pw { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--teal); font-size: 12px; font-weight: 600; cursor: pointer; font-family: 'DM Sans', sans-serif; padding: 4px 6px; }

        .rules { list-style: none; margin: 10px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 4px 12px; }
        .rules li { font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
        .rules li::before { content: '○'; font-size: 11px; }
        .rules li.ok { color: var(--green); }
        .rules li.ok::before { content: '✓'; font-weight: 700; }
        .match { font-size: 12px; margin-top: 6px; min-height: 16px; }
        .match.ok { color: var(--green); }
        .match.bad { color: var(--red); }

        .btn {
            width: 100%; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500;
            padding: 11px; border-radius: 8px; border: none; background: var(--teal); color: white;
            cursor: pointer; transition: background 0.2s, opacity 0.2s; margin-top: 8px;
        }
        .btn:hover { background: #0f7a70; }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; }

        .alert { padding: 12px 16px; border-radius: 8px; font-size: 13px; margin-bottom: 16px; background: #fef2f2; color: var(--red); border: 1px solid #fecaca; }

        .back-link { display: block; text-align: center; margin-top: 20px; font-size: 13px; color: var(--muted); text-decoration: none; }
        .back-link:hover { color: var(--teal); }

        @@media (max-width: 420px) { .card { padding: 28px 22px; } .rules { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="card">
        <div class="logo">
            <div class="logo-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" />
                    <circle cx="12" cy="17" r="4" opacity="0.6" />
                </svg>
            </div>
            <div class="logo-text">NMB-HLabSys <span>Haematology Lab System</span></div>
        </div>

        <h2>Choose your password</h2>
        <p class="sub">You signed in with a temporary password. For your security, set your own password before continuing.</p>
        @if (ViewBag.Email != null)
        {
            <span class="who">@ViewBag.Email</span>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert">@Html.ValidationSummary(false)</div>
        }

        <form method="post" asp-controller="Home" asp-action="ChangePassword" id="cpForm">
            <div class="form-group">
                <label class="form-label" for="NewPassword">New password</label>
                <div class="pw-wrap">
                    <input class="form-input" type="password" id="NewPassword" name="NewPassword" autocomplete="new-password" required />
                    <button type="button" class="toggle-pw" data-target="NewPassword">Show</button>
                </div>
                <ul class="rules" id="rules">
                    <li data-rule="len">8+ characters</li>
                    <li data-rule="upper">An uppercase letter</li>
                    <li data-rule="digit">A number</li>
                    <li data-rule="special">A special character</li>
                </ul>
            </div>
            <div class="form-group">
                <label class="form-label" for="ConfirmPassword">Confirm new password</label>
                <div class="pw-wrap">
                    <input class="form-input" type="password" id="ConfirmPassword" name="ConfirmPassword" autocomplete="new-password" required />
                    <button type="button" class="toggle-pw" data-target="ConfirmPassword">Show</button>
                </div>
                <div class="match" id="match"></div>
            </div>
            <button type="submit" class="btn" id="submitBtn" disabled>Save password and continue</button>
        </form>

        <a class="back-link" asp-controller="Home" asp-action="Logout">Sign out instead</a>
    </div>

    <script>
        (function () {
            var pw = document.getElementById('NewPassword');
            var cf = document.getElementById('ConfirmPassword');
            var btn = document.getElementById('submitBtn');
            var match = document.getElementById('match');
            var tests = {
                len: function (v) { return v.length >= 8; },
                upper: function (v) { return /[A-Z]/.test(v); },
                digit: function (v) { return /[0-9]/.test(v); },
                special: function (v) { return /[^A-Za-z0-9]/.test(v); }
            };

            function check() {
                var v = pw.value, allOk = true;
                document.querySelectorAll('#rules li').forEach(function (li) {
                    var ok = tests[li.getAttribute('data-rule')](v);
                    li.classList.toggle('ok', ok);
                    if (!ok) allOk = false;
                });
                var same = cf.value.length > 0 && cf.value === v;
                if (cf.value.length === 0) { match.textContent = ''; match.className = 'match'; }
                else if (same) { match.textContent = 'Passwords match'; match.className = 'match ok'; }
                else { match.textContent = 'Passwords do not match'; match.className = 'match bad'; }
                btn.disabled = !(allOk && same);
            }
            pw.addEventListener('input', check);
            cf.addEventListener('input', check);

            document.querySelectorAll('.toggle-pw').forEach(function (b) {
                b.addEventListener('click', function () {
                    var input = document.getElementById(b.getAttribute('data-target'));
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    b.textContent = show ? 'Hide' : 'Show';
                });
            });
            check();
        })();
    </script>
</body>
</html>
