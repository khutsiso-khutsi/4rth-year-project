@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Patient.Models.ConsentViewModel
@{
    ViewData["Title"] = "Consent Management";
    Layout = null;
    var activeConsents  = Model.Consents.Count(c => c.ConsentGranted);
    var revokedConsents = Model.Consents.Count(c => !c.ConsentGranted);
    var sharedRequests  = Model.TestRequests.Count(r => r.IsShared);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Consent Management — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --teal: #0d9488;
            --teal-light: rgba(13,148,136,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
            --amber: #d97706;
        }

        body { font-family: 'DM Sans', sans-serif; background: var(--offwhite); color: var(--navy); min-height: 100vh; }

        /* ── TOPBAR ── */
        .topbar {
            background: var(--navy);
            padding: 0 40px;
            display: flex; align-items: center; justify-content: space-between;
            height: 64px; position: sticky; top: 0; z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }
        .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
        .brand-logo { width: 34px; height: 34px; background: var(--teal); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
        .brand-logo svg { width: 18px; height: 18px; fill: white; }
        .brand-name { font-family: 'DM Serif Display', serif; color: white; font-size: 1.1rem; line-height: 1.1; }
        .brand-name span { display: block; font-family: 'DM Sans', sans-serif; font-size: 0.6rem; font-weight: 300; color: rgba(255,255,255,0.4); letter-spacing: 0.1em; text-transform: uppercase; }
        .topbar-right { display: flex; align-items: center; gap: 16px; }
        .user-chip { display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.1); border-radius: 100px; padding: 6px 14px 6px 8px; }
        .user-avatar { width: 28px; height: 28px; background: var(--teal); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 600; color: white; }
        .user-email { font-size: 0.8rem; color: rgba(255,255,255,0.75); max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .logout-btn { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); color: rgba(255,255,255,0.8); padding: 8px 16px; border-radius: 8px; text-decoration: none; font-size: 0.82rem; font-weight: 500; display: flex; align-items: center; gap: 6px; transition: all 0.2s; }
        .logout-btn:hover { background: rgba(255,255,255,0.15); color: white; }
        .logout-btn svg { width: 14px; height: 14px; }

        /* ── LAYOUT ── */
        .page { display: flex; min-height: calc(100vh - 64px); }

        /* ── SIDEBAR ── */
        .sidebar { width: 220px; background: white; border-right: 1px solid var(--border); padding: 24px 0; flex-shrink: 0; position: sticky; top: 64px; height: calc(100vh - 64px); overflow-y: auto; }
        .nav-section { margin-bottom: 8px; }
        .nav-label { font-size: 0.65rem; font-weight: 600; color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; padding: 0 20px; margin-bottom: 4px; }
        .nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 20px; color: var(--muted); text-decoration: none; font-size: 0.85rem; font-weight: 500; border-left: 3px solid transparent; transition: all 0.15s; }
        .nav-item:hover { background: var(--offwhite); color: var(--navy); }
        .nav-item.active { background: var(--teal-light); color: var(--teal); border-left-color: var(--teal); }
        .nav-item svg { width: 16px; height: 16px; flex-shrink: 0; }

        /* ── MAIN ── */
        .main { flex: 1; padding: clamp(24px, 3vw, 40px); overflow-y: auto; }

        /* ── HERO ── */
        .hero {
            background: var(--navy); border-radius: 20px; padding: 28px 32px;
            margin-bottom: 28px; position: relative; overflow: hidden;
        }
        .hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 60% 80% at 90% 50%, rgba(13,148,136,0.2) 0%, transparent 60%); }
        .hero::after { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px); background-size: 40px 40px; }
        .hero-content { position: relative; z-index: 2; }
        .hero-tag { display: inline-flex; align-items: center; gap: 6px; background: rgba(13,148,136,0.15); border: 1px solid rgba(13,148,136,0.3); color: #5eead4; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; padding: 4px 10px; border-radius: 100px; margin-bottom: 12px; }
        .hero-tag::before { content: ''; width: 5px; height: 5px; background: #5eead4; border-radius: 50%; }
        .hero h1 { font-family: 'DM Serif Display', serif; font-size: clamp(1.4rem, 2.2vw, 1.9rem); color: white; margin-bottom: 6px; line-height: 1.2; }
        .hero h1 span { color: #5eead4; font-style: italic; }
        .hero p { color: rgba(255,255,255,0.5); font-size: 0.85rem; font-weight: 300; }

        /* ── STATS ── */
        .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; margin-bottom: 28px; opacity: 0; transform: translateY(10px); transition: opacity 0.4s ease, transform 0.4s ease; }
        .stats.visible { opacity: 1; transform: translateY(0); }
        .stat-card { background: white; border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px; box-shadow: 0 2px 8px rgba(11,31,58,0.04); }
        .stat-icon { width: 34px; height: 34px; border-radius: 9px; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; }
        .stat-icon svg { width: 15px; height: 15px; }
        .stat-value { font-family: 'DM Serif Display', serif; font-size: 1.5rem; color: var(--navy); line-height: 1; margin-bottom: 3px; }
        .stat-label { font-size: 0.75rem; color: var(--muted); }

        /* ── INFO TIP ── */
        .info-tip { display: flex; align-items: flex-start; gap: 10px; background: var(--teal-light); border: 1px solid rgba(13,148,136,0.2); border-radius: 10px; padding: 12px 16px; margin-bottom: 18px; font-size: 0.8rem; color: var(--navy); line-height: 1.6; }
        .info-tip svg { width: 15px; height: 15px; stroke: var(--teal); flex-shrink: 0; margin-top: 1px; }

        /* ── LAYOUT GRID ── */
        .grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 20px; align-items: start; }

        /* ── SECTION CARD ── */
        .section-card { background: white; border: 1px solid var(--border); border-radius: 16px; padding: 24px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(11,31,58,0.04); opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
        .section-card.visible { opacity: 1; transform: translateY(0); }
        .section-card h3 { font-family: 'DM Serif Display', serif; font-size: 1.05rem; color: var(--navy); margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
        .section-card h3 svg { width: 17px; height: 17px; stroke: var(--teal); flex-shrink: 0; }

        /* ── FORM ELEMENTS ── */
        .form-group { display: flex; flex-direction: column; gap: 5px; margin-bottom: 14px; }
        .form-group label { font-size: 0.7rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
        .form-group select, .form-group input { background: white; border: 1px solid var(--border); color: var(--navy); padding: 9px 12px; border-radius: 9px; font-size: 0.85rem; font-family: 'DM Sans', sans-serif; outline: none; transition: border-color 0.15s, box-shadow 0.15s; width: 100%; }
        .form-group select:focus, .form-group input:focus { border-color: var(--teal); box-shadow: 0 0 0 3px var(--teal-light); }

        .btn { padding: 9px 20px; border: none; border-radius: 9px; font-size: 0.85rem; cursor: pointer; font-family: 'DM Sans', sans-serif; font-weight: 600; transition: all 0.15s; display: inline-flex; align-items: center; gap: 6px; }
        .btn svg { width: 14px; height: 14px; }
        .btn-primary { background: var(--teal); color: white; }
        .btn-primary:hover { background: #0b7a70; transform: translateY(-1px); }
        .btn-sm { padding: 5px 12px; font-size: 0.75rem; }

        /* ── DOCTOR CONSENT ITEMS ── */
        .consent-item { background: var(--offwhite); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; display: flex; align-items: center; gap: 12px; transition: box-shadow 0.15s, transform 0.15s; }
        .consent-item:hover { box-shadow: 0 4px 14px rgba(11,31,58,0.08); transform: translateY(-1px); }
        .doctor-avatar { width: 38px; height: 38px; border-radius: 10px; background: var(--teal-light); display: flex; align-items: center; justify-content: center; font-family: 'DM Serif Display', serif; font-size: 1rem; color: var(--teal); font-weight: 700; flex-shrink: 0; }
        .consent-info { flex: 1; min-width: 0; }
        .consent-name { font-size: 0.875rem; font-weight: 600; color: var(--navy); margin-bottom: 2px; }
        .consent-meta { font-size: 0.72rem; color: var(--muted); }

        /* ── TOGGLE SWITCH ── */
        .toggle-wrap { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
        .toggle-label { font-size: 0.72rem; font-weight: 600; color: var(--muted); white-space: nowrap; }
        .toggle { position: relative; display: inline-block; width: 42px; height: 24px; flex-shrink: 0; }
        .toggle input { opacity: 0; width: 0; height: 0; position: absolute; }
        .toggle-slider { position: absolute; cursor: pointer; inset: 0; background: #cbd5e1; border-radius: 100px; transition: background 0.25s; }
        .toggle-slider::before { content: ''; position: absolute; width: 18px; height: 18px; left: 3px; top: 3px; background: white; border-radius: 50%; transition: transform 0.25s; box-shadow: 0 1px 4px rgba(0,0,0,0.2); }
        .toggle input:checked + .toggle-slider { background: var(--teal); }
        .toggle input:checked + .toggle-slider::before { transform: translateX(18px); }

        /* ── BADGES ── */
        .badge { display: inline-block; padding: 3px 9px; border-radius: 100px; font-size: 0.68rem; font-weight: 600; }
        .badge-active { background: #dcfce7; color: var(--green); }
        .badge-revoked { background: #fee2e2; color: var(--red); }
        .badge-shared { background: var(--teal-light); color: var(--teal); }
        .badge-pending { background: #fef3c7; color: var(--amber); }

        /* ── REQUEST ACCESS PANEL ── */
        .doctor-selector { display: flex; align-items: center; gap: 10px; background: var(--offwhite); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; margin-bottom: 20px; }
        .doctor-selector label { font-size: 0.75rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.07em; white-space: nowrap; }
        .doctor-selector select { flex: 1; background: white; border: 1px solid var(--border); color: var(--navy); padding: 8px 12px; border-radius: 8px; font-size: 0.85rem; font-family: 'DM Sans', sans-serif; outline: none; transition: border-color 0.15s; }
        .doctor-selector select:focus { border-color: var(--teal); }

        /* ── REQUEST ITEMS ── */
        .request-list { display: flex; flex-direction: column; gap: 10px; }

        .request-item {
            background: var(--offwhite);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 14px;
            transition: box-shadow 0.15s, transform 0.15s;
        }
        .request-item:hover { box-shadow: 0 4px 14px rgba(11,31,58,0.08); transform: translateY(-1px); }
        .request-item.is-shared { border-left: 3px solid var(--teal); }
        .request-item.not-shared { border-left: 3px solid var(--border); }

        .req-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .req-icon svg { width: 16px; height: 16px; }
        .req-info { flex: 1; min-width: 0; }
        .req-number { font-size: 0.875rem; font-weight: 600; color: var(--navy); margin-bottom: 2px; }
        .req-meta { font-size: 0.72rem; color: var(--muted); display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
        .meta-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--border); display: inline-block; }

        /* ── EMPTY STATE ── */
        .empty-state { text-align: center; padding: 36px 24px; color: var(--muted); }
        .empty-state .empty-icon { width: 52px; height: 52px; background: var(--offwhite); border: 1px solid var(--border); border-radius: 14px; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; }
        .empty-state .empty-icon svg { width: 22px; height: 22px; opacity: 0.4; }
        .empty-state h4 { font-family: 'DM Serif Display', serif; font-size: 1rem; color: var(--navy); margin-bottom: 4px; }
        .empty-state p { font-size: 0.82rem; }

        /* ── BULK ACTIONS ── */
        .bulk-bar { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: var(--offwhite); border: 1px solid var(--border); border-radius: 10px; margin-bottom: 14px; flex-wrap: wrap; }
        .bulk-bar span { font-size: 0.78rem; color: var(--muted); font-weight: 500; flex: 1; }
        .bulk-btn { font-family: 'DM Sans', sans-serif; font-size: 0.75rem; font-weight: 600; padding: 6px 14px; border-radius: 7px; cursor: pointer; transition: all 0.15s; border: 1px solid var(--border); background: white; color: var(--navy); display: flex; align-items: center; gap: 5px; }
        .bulk-btn svg { width: 12px; height: 12px; }
        .bulk-btn.grant { border-color: rgba(13,148,136,0.3); color: var(--teal); }
        .bulk-btn.grant:hover { background: var(--teal); color: white; border-color: var(--teal); }
        .bulk-btn.revoke { border-color: rgba(220,38,38,0.3); color: var(--red); }
        .bulk-btn.revoke:hover { background: var(--red); color: white; border-color: var(--red); }

        /* ── LOGOUT MODAL ── */
        #logout-modal { display: none; position: fixed; inset: 0; z-index: 999; background: rgba(11,31,58,0.45); align-items: center; justify-content: center; }
        #logout-modal.open { display: flex; }

        /* ── TOAST ── */
        #toast { position: fixed; bottom: 24px; right: 24px; z-index: 1000; background: var(--navy); color: white; padding: 12px 18px; border-radius: 12px; font-size: 0.82rem; font-weight: 500; display: flex; align-items: center; gap: 10px; opacity: 0; transform: translateY(8px); transition: opacity 0.25s, transform 0.25s; pointer-events: none; max-width: 320px; }
    </style>
</head>
<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">NMB-HLabSys <span>Haematology Lab System</span></div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "P")</div>
                <span class="user-email">@ViewBag.Email</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn" id="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="nav-section">
                <div class="nav-label">Main</div>
                <a asp-controller="PatientDashboard" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                    Dashboard
                </a>
                <a asp-controller="PatientDashboard" asp-action="MyResults" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    My Results
                </a>
                <a asp-controller="PatientDashboard" asp-action="MedicalHistory" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                    Medical History
                </a>
                <a asp-controller="PatientDashboard" asp-action="Consent" class="nav-item active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    Consent
                </a>
                <a asp-controller="PatientDashboard" asp-action="Profile" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    Profile
                </a>
            </div>
            <div class="nav-section">
                <div class="nav-label">Support</div>
                <a href="#" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                    Help
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="main">

            <!-- HERO -->
            <div class="hero">
                <div class="hero-content">
                    <div class="hero-tag">Privacy &amp; Access</div>
                    <h1>Consent <span>Management</span></h1>
                    <p>Control exactly which doctors can view your test results and health records.</p>
                </div>
            </div>

            <!-- STATS -->
            <div class="stats" id="statsRow">
                <div class="stat-card">
                    <div class="stat-icon" style="background:#dcfce7">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    </div>
                    <div class="stat-value" data-target="@activeConsents">0</div>
                    <div class="stat-label">Doctors with Access</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:#fee2e2">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    </div>
                    <div class="stat-value" data-target="@revokedConsents">0</div>
                    <div class="stat-label">Revoked</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:var(--teal-light)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    </div>
                    <div class="stat-value" data-target="@sharedRequests">0</div>
                    <div class="stat-label">Shared Test Requests</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:#dbeafe">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#1d4ed8" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    </div>
                    <div class="stat-value" data-target="@Model.TestRequests.Count()">0</div>
                    <div class="stat-label">Total Requests</div>
                </div>
            </div>

            <!-- TWO-COLUMN GRID -->
            <div class="grid">

                <!-- ══ LEFT: DOCTOR ACCESS ══ -->
                <div>
                    <!-- Grant Access -->
                    <div class="section-card" id="sc1">
                        <h3>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" /></svg>
                            Grant Doctor Access
                        </h3>
                        <div class="info-tip">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
                            Granting access lets a doctor view all your test results and records. You can revoke this at any time.
                        </div>
                        <form asp-controller="PatientDashboard" asp-action="GrantConsent" method="post">
                            <div class="form-group">
                                <label>Select Doctor</label>
                                <select name="doctorId" required>
                                    <option value="">— Choose a doctor —</option>
                                    @foreach (var d in Model.AllDoctors ?? Enumerable.Empty<dynamic>())
                                    {
                                        <option value="@d.DoctorID">Dr. @d.DoctorName</option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                                Grant Access
                            </button>
                        </form>
                    </div>

                    <!-- Doctor List -->
                    <div class="section-card" id="sc2">
                        <h3>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                            Doctor Access List
                            <span style="margin-left:auto;font-family:'DM Sans',sans-serif;font-size:0.75rem;font-weight:500;color:var(--muted);">@Model.Consents.Count() total</span>
                        </h3>

                        @if (!Model.Consents.Any())
                        {
                            <div class="empty-state">
                                <div class="empty-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                                </div>
                                <h4>No doctors added yet</h4>
                                <p>Grant a doctor access above to get started.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var c in Model.Consents)
                            {
                                var initials = c.DoctorName?.Length > 0 ? c.DoctorName.Substring(0, 1).ToUpper() : "D";
                                <div class="consent-item">
                                    <div class="doctor-avatar">@initials</div>
                                    <div class="consent-info">
                                        <div class="consent-name">Dr. @c.DoctorName</div>
                                        <div class="consent-meta">
                                            @c.DoctorEmail ·
                                            @if (c.ConsentGranted)
                                            {
                                                <span>Since @c.GrantedDate.ToString("dd MMM yyyy")</span>
                                            }
                                            else
                                            {
                                                <span>Revoked @c.RevokedDate?.ToString("dd MMM yyyy")</span>
                                            }
                                        </div>
                                    </div>
                                    <span class="badge @(c.ConsentGranted ? "badge-active" : "badge-revoked")">
                                        @(c.ConsentGranted ? "Active" : "Revoked")
                                    </span>
                                    <div class="toggle-wrap">
                                        <span class="toggle-label">@(c.ConsentGranted ? "On" : "Off")</span>
                                        <form asp-controller="PatientDashboard" asp-action="@(c.ConsentGranted ? "RevokeConsent" : "GrantConsent")" method="post" class="toggle-form">
                                            <input type="hidden" name="doctorId" value="@c.DoctorID" />
                                            <label class="toggle" title="@(c.ConsentGranted ? "Click to revoke access" : "Click to grant access")">
                                                <input type="checkbox" @(c.ConsentGranted ? "checked" : "") onchange="this.closest('form').submit()" />
                                                <span class="toggle-slider"></span>
                                            </label>
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- ══ RIGHT: TEST REQUEST ACCESS ══ -->
                <div class="section-card" id="sc3" style="margin-bottom:0;">
                    <h3>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                        Test Request Access
                    </h3>

                    <div class="info-tip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
                        Choose a doctor, then use the toggles to share or hide individual test requests from them.
                    </div>

                    <!-- Doctor selector -->
                    <div class="doctor-selector">
                        <label>Doctor:</label>
                        <select id="doctorSelect" onchange="filterByDoctor(this.value)">
                            <option value="0">— Select a doctor —</option>
                            @foreach (var d in Model.AllDoctors ?? Enumerable.Empty<dynamic>())
                            {
                                <option value="@d.DoctorID" selected="@(Model.SelectedDoctorID == d.DoctorID ? "selected" : null)">
                                    Dr. @d.DoctorName
                                </option>
                            }
                        </select>
                    </div>

                    @if (Model.SelectedDoctorID == 0)
                    {
                        <div class="empty-state">
                            <div class="empty-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                            </div>
                            <h4>No doctor selected</h4>
                            <p>Pick a doctor above to manage their access to individual test requests.</p>
                        </div>
                    }
                    else if (!Model.TestRequests.Any())
                    {
                        <div class="empty-state">
                            <div class="empty-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /></svg>
                            </div>
                            <h4>No test requests</h4>
                            <p>You don't have any test requests on file yet.</p>
                        </div>
                    }
                    else
                    {
                        <!-- Bulk actions bar -->
                        <div class="bulk-bar">
                            <span>@Model.TestRequests.Count() request@(Model.TestRequests.Count() != 1 ? "s" : "") · @sharedRequests shared</span>
                            <form asp-controller="PatientDashboard" asp-action="GrantAllConsent" method="post" style="display:inline">
                                <input type="hidden" name="doctorId" value="@Model.SelectedDoctorID" />
                                <button type="submit" class="bulk-btn grant">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg>
                                    Share All
                                </button>
                            </form>
                            <form asp-controller="PatientDashboard" asp-action="RevokeAllConsent" method="post" style="display:inline">
                                <input type="hidden" name="doctorId" value="@Model.SelectedDoctorID" />
                                <button type="submit" class="bulk-btn revoke">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                                    Revoke All
                                </button>
                            </form>
                        </div>

                        <div class="request-list">
                            @foreach (var r in Model.TestRequests)
                            {
                                var urgencyColor = r.Urgency?.ToLower() switch {
                                    "urgent" => "#fee2e2",
                                    "stat"   => "#f3e8ff",
                                    _        => "#dbeafe"
                                };
                                var urgencyStroke = r.Urgency?.ToLower() switch {
                                    "urgent" => "#dc2626",
                                    "stat"   => "#7c3aed",
                                    _        => "#1d4ed8"
                                };
                                <div class="request-item @(r.IsShared ? "is-shared" : "not-shared")">
                                    <div class="req-icon" style="background:@urgencyColor">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="@urgencyStroke" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                                    </div>
                                    <div class="req-info">
                                        <div class="req-number">@r.RequestNumber</div>
                                        <div class="req-meta">
                                            <span>@r.RequestDate.ToString("dd MMM yyyy")</span>
                                            <span class="meta-dot"></span>
                                            <span>@r.RequestStatus</span>
                                            @if (!string.IsNullOrEmpty(r.Urgency))
                                            {
                                                <span class="meta-dot"></span>
                                                <span>@r.Urgency</span>
                                            }
                                        </div>
                                    </div>
                                    <span class="badge @(r.IsShared ? "badge-shared" : "badge-revoked")">
                                        @(r.IsShared ? "Shared" : "Hidden")
                                    </span>
                                    <div class="toggle-wrap">
                                        <span class="toggle-label">@(r.IsShared ? "On" : "Off")</span>
                                        <form asp-controller="PatientDashboard"
                                              asp-action="@(r.IsShared ? "RevokeTestRequestConsent" : "GrantTestRequestConsent")"
                                              method="post">
                                            <input type="hidden" name="doctorId" value="@Model.SelectedDoctorID" />
                                            <input type="hidden" name="requestId" value="@r.RequestID" />
                                            <label class="toggle" title="@(r.IsShared ? "Click to hide from doctor" : "Click to share with doctor")">
                                                <input type="checkbox" @(r.IsShared ? "checked" : "") onchange="this.closest('form').submit()" />
                                                <span class="toggle-slider"></span>
                                            </label>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

            </div><!-- end grid -->

        </main>
    </div>

    <!-- LOGOUT MODAL -->
    <div id="logout-modal" role="dialog" aria-modal="true" aria-labelledby="lo-title">
        <div style="background:white;border-radius:20px;padding:32px 28px;max-width:380px;width:90%;box-shadow:0 20px 60px rgba(11,31,58,0.2);">
            <div style="width:52px;height:52px;background:#fee2e2;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
            </div>
            <h3 id="lo-title" style="font-family:'DM Serif Display',serif;font-size:1.2rem;color:var(--navy);margin-bottom:8px;">Sign out?</h3>
            <p style="font-size:0.85rem;color:var(--muted);margin-bottom:24px;line-height:1.6;">You'll be returned to the login screen. Any unsaved changes will be lost.</p>
            <div style="display:flex;gap:10px;">
                <button id="logout-cancel" style="flex:1;padding:10px;border:1px solid var(--border);border-radius:10px;background:white;color:var(--navy);font-size:0.85rem;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;">Cancel</button>
                <a id="logout-confirm" href="#" style="flex:1;padding:10px;border:none;border-radius:10px;background:#dc2626;color:white;font-size:0.85rem;font-weight:600;cursor:pointer;text-align:center;text-decoration:none;font-family:'DM Sans',sans-serif;">Sign Out</a>
            </div>
        </div>
    </div>

    <!-- TOAST -->
    <div id="toast" role="status" aria-live="polite">
        <span id="toast-icon"></span>
        <span id="toast-msg"></span>
    </div>

    <script>
        (function () {
            'use strict';

            /* ─── STAGGERED ANIMATIONS ─── */
            var cards = document.querySelectorAll('.section-card');
            cards.forEach(function(card, i) {
                card.style.transitionDelay = (i * 80) + 'ms';
                requestAnimationFrame(function() {
                    requestAnimationFrame(function() { card.classList.add('visible'); });
                });
            });

            var statsRow = document.getElementById('statsRow');
            if (statsRow) requestAnimationFrame(function() { requestAnimationFrame(function() { statsRow.classList.add('visible'); }); });

            /* ─── ANIMATED COUNTERS ─── */
            function animateCounter(el, target, duration) {
                var start = null;
                function step(ts) {
                    if (!start) start = ts;
                    var p = Math.min((ts - start) / duration, 1);
                    var eased = 1 - Math.pow(1 - p, 3);
                    el.textContent = Math.round(target * eased);
                    if (p < 1) requestAnimationFrame(step);
                    else el.textContent = target;
                }
                requestAnimationFrame(step);
            }
            document.querySelectorAll('.stat-value[data-target]').forEach(function(el) {
                animateCounter(el, parseInt(el.getAttribute('data-target'), 10) || 0, 900);
            });

            /* ─── DOCTOR FILTER ─── */
            function filterByDoctor(doctorId) {
                window.location.href = '/PatientDashboard/Consent?selectedDoctorId=' + doctorId;
            }
            window.filterByDoctor = filterByDoctor;

            /* ─── TOGGLE LABEL UPDATE ─── */
            document.querySelectorAll('.toggle input[type="checkbox"]').forEach(function(cb) {
                cb.addEventListener('change', function() {
                    var label = cb.closest('.toggle-wrap').querySelector('.toggle-label');
                    if (label) label.textContent = cb.checked ? 'On' : 'Off';
                });
            });

            /* ─── TOAST ─── */
            var toast    = document.getElementById('toast');
            var toastMsg = document.getElementById('toast-msg');
            var toastIco = document.getElementById('toast-icon');
            var toastTimer;
            function showToast(msg, type) {
                type = type || 'info';
                var icons = { success:'✓', warning:'⚠', error:'✕', info:'ℹ' };
                toastMsg.textContent = msg;
                toastIco.textContent = icons[type] || 'ℹ';
                toast.style.opacity = '1';
                toast.style.transform = 'translateY(0)';
                clearTimeout(toastTimer);
                toastTimer = setTimeout(function() {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(8px)';
                }, 3200);
            }
            window.showToast = showToast;

            /* ─── BULK ACTIONS CONFIRM ─── */
            document.querySelectorAll('.bulk-btn.revoke').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    if (!confirm('Revoke access to all test requests for this doctor?')) e.preventDefault();
                });
            });

            /* ─── LOGOUT MODAL ─── */
            var logoutBtn    = document.getElementById('logout-btn');
            var logoutModal  = document.getElementById('logout-modal');
            var logoutCancel = document.getElementById('logout-cancel');
            var logoutConfirm = document.getElementById('logout-confirm');
            if (logoutBtn && logoutModal) {
                logoutConfirm.href = logoutBtn.href;
                logoutBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    logoutModal.classList.add('open');
                    logoutModal.style.display = 'flex';
                    if (logoutCancel) logoutCancel.focus();
                });
                function closeModal() { logoutModal.classList.remove('open'); logoutModal.style.display = 'none'; logoutBtn.focus(); }
                if (logoutCancel) logoutCancel.addEventListener('click', closeModal);
                logoutModal.addEventListener('click', function(e) { if (e.target === logoutModal) closeModal(); });
                document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && logoutModal.style.display === 'flex') closeModal(); });
            }

            /* ─── WELCOME TOAST ─── */
            if (!sessionStorage.getItem('consent_welcomed')) {
                sessionStorage.setItem('consent_welcomed', '1');
                setTimeout(function() { showToast('Consent settings loaded', 'success'); }, 600);
            }

        })();
    </script>

</body>
</html>
