@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Patient.Models.MedicalHistoryViewModel
@{
    ViewData["Title"] = "Medical History";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Medical History — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@@0;1&family=DM+Sans:wght@@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --teal: #0d9488;
            --teal-light: rgba(13,148,136,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
            --amber: #d97706;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
        }

        /* ── TOPBAR ── */
        .topbar {
            background: var(--navy);
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-logo {
            width: 34px;
            height: 34px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .brand-logo svg {
                width: 18px;
                height: 18px;
                fill: white;
            }

        .brand-name {
            font-family: 'DM Serif Display', serif;
            color: white;
            font-size: 1.1rem;
            line-height: 1.1;
        }

            .brand-name span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.6rem;
                font-weight: 300;
                color: rgba(255,255,255,0.4);
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 6px 14px 6px 8px;
        }

        .user-avatar {
            width: 28px;
            height: 28px;
            background: var(--teal);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
        }

        .user-email {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.75);
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .logout-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.8);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .logout-btn:hover {
                background: rgba(255,255,255,0.15);
                color: white;
            }

            .logout-btn svg {
                width: 14px;
                height: 14px;
            }

        /* ── LAYOUT ── */
        .page {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 220px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 24px 0;
            flex-shrink: 0;
            position: sticky;
            top: 64px;
            height: calc(100vh - 64px);
            overflow-y: auto;
        }

        .nav-section {
            margin-bottom: 8px;
        }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 20px;
            margin-bottom: 4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.15s;
            border-left: 3px solid transparent;
        }

            .nav-item:hover {
                background: var(--offwhite);
                color: var(--navy);
            }

            .nav-item.active {
                background: var(--teal-light);
                color: var(--teal);
                border-left-color: var(--teal);
            }

            .nav-item svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        /* ── MAIN ── */
        .main {
            flex: 1;
            padding: clamp(24px, 3vw, 40px);
            overflow-y: auto;
        }

        /* ── PAGE HEADER ── */
        .page-header {
            margin-bottom: 28px;
        }

            .page-header h1 {
                font-family: 'DM Serif Display', serif;
                font-size: clamp(1.4rem, 2.5vw, 2rem);
                color: var(--navy);
                margin-bottom: 4px;
            }

            .page-header p {
                font-size: 0.875rem;
                color: var(--muted);
                font-weight: 400;
            }

        /* ── TABS ── */
        .tabs {
            display: flex;
            gap: 4px;
            margin-bottom: 24px;
            border-bottom: 1px solid var(--border);
        }

        .tab-btn {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 10px 20px;
            background: transparent;
            border: none;
            color: var(--muted);
            font-size: 0.85rem;
            font-family: 'DM Sans', sans-serif;
            font-weight: 500;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            transition: all 0.2s;
        }

            .tab-btn svg {
                width: 15px;
                height: 15px;
            }

            .tab-btn.active {
                color: var(--teal);
                border-bottom-color: var(--teal);
                font-weight: 600;
            }

            .tab-btn:hover {
                color: var(--navy);
            }

        .tab-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border-radius: 100px;
            font-size: 0.65rem;
            font-weight: 700;
            background: var(--border);
            color: var(--muted);
            transition: all 0.2s;
        }

        .tab-btn.active .tab-count {
            background: var(--teal-light);
            color: var(--teal);
        }

        .tab-content {
            display: none;
            animation: fadeSlideIn 0.25s ease;
        }

            .tab-content.active {
                display: block;
            }

        @@keyframes fadeSlideIn {
            from { opacity: 0; transform: translateY(8px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ── HERO BANNER ── */
        .hero {
            background: var(--navy);
            border-radius: 20px;
            padding: 28px 32px;
            margin-bottom: 28px;
            position: relative;
            overflow: hidden;
        }

            .hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 60% 80% at 90% 50%, rgba(13,148,136,0.2) 0%, transparent 60%);
            }

            .hero::after {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
                                  linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
                background-size: 40px 40px;
            }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(13,148,136,0.15);
            border: 1px solid rgba(13,148,136,0.3);
            color: #5eead4;
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 100px;
            margin-bottom: 12px;
        }

            .hero-tag::before {
                content: '';
                width: 5px;
                height: 5px;
                background: #5eead4;
                border-radius: 50%;
            }

        .hero h1 {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.4rem, 2.2vw, 1.9rem);
            color: white;
            margin-bottom: 6px;
            line-height: 1.2;
        }

            .hero h1 span {
                color: #5eead4;
                font-style: italic;
            }

        .hero p {
            color: rgba(255,255,255,0.5);
            font-size: 0.85rem;
            font-weight: 300;
        }

        /* ── STATS ROW ── */
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 14px;
            margin-bottom: 28px;
            opacity: 0;
            transform: translateY(10px);
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

            .stats.visible {
                opacity: 1;
                transform: translateY(0);
            }

        .stat-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 18px 20px;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
        }

        .stat-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
        }

            .stat-icon svg {
                width: 15px;
                height: 15px;
            }

        .stat-value {
            font-family: 'DM Serif Display', serif;
            font-size: 1.5rem;
            color: var(--navy);
            line-height: 1;
            margin-bottom: 3px;
        }

        .stat-label {
            font-size: 0.75rem;
            color: var(--muted);
        }

        /* ── SECTION CARD ── */
        .section-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
            opacity: 0;
            transform: translateY(8px);
            transition: opacity 0.35s ease, transform 0.35s ease;
        }

            .section-card.visible {
                opacity: 1;
                transform: translateY(0);
            }

            .section-card h3 {
                font-family: 'DM Serif Display', serif;
                font-size: 1.05rem;
                color: var(--navy);
                margin-bottom: 18px;
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .section-card h3 svg {
                    width: 16px;
                    height: 16px;
                    color: var(--teal);
                }

        /* ── ADD FORM ── */
        .add-form {
            background: var(--offwhite);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 18px;
        }

        .form-row {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            align-items: flex-end;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex: 1;
            min-width: 160px;
        }

            .form-group label {
                font-size: 0.72rem;
                font-weight: 600;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: 0.07em;
            }

            .form-group select,
            .form-group input,
            .form-group textarea {
                background: white;
                border: 1px solid var(--border);
                color: var(--navy);
                padding: 9px 12px;
                border-radius: 8px;
                font-size: 0.875rem;
                font-family: 'DM Sans', sans-serif;
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s;
            }

                .form-group select:focus,
                .form-group input:focus,
                .form-group textarea:focus {
                    border-color: var(--teal);
                    box-shadow: 0 0 0 3px var(--teal-light);
                }

        .btn-add {
            padding: 9px 20px;
            background: var(--teal);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 0.85rem;
            font-family: 'DM Sans', sans-serif;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s;
            white-space: nowrap;
            align-self: flex-end;
        }

            .btn-add:hover {
                background: #0b7a71;
                transform: translateY(-1px);
            }

            .btn-add:active {
                transform: translateY(0);
            }

        /* ── ITEMS LIST ── */
        .items-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .item-card {
            background: var(--offwhite);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            transition: box-shadow 0.15s, transform 0.15s;
        }

            .item-card:hover {
                box-shadow: 0 4px 16px rgba(11,31,58,0.08);
                transform: translateY(-1px);
            }

        .item-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .item-icon svg {
                width: 15px;
                height: 15px;
            }

        .item-info {
            flex: 1;
        }

        .item-name {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--navy);
            margin-bottom: 3px;
        }

        .item-meta {
            font-size: 0.75rem;
            color: var(--muted);
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            align-items: center;
        }

        .meta-chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: white;
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 2px 8px;
            font-size: 0.7rem;
            color: var(--muted);
            font-weight: 500;
        }

            .meta-chip svg {
                width: 10px;
                height: 10px;
            }

        /* ── BADGES ── */
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 100px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .badge-mild {
            background: #dcfce7;
            color: var(--green);
        }

        .badge-moderate {
            background: #fef3c7;
            color: var(--amber);
        }

        .badge-severe {
            background: #fee2e2;
            color: var(--red);
        }

        .badge-default {
            background: var(--teal-light);
            color: var(--teal);
        }

        /* ── REMOVE BUTTON ── */
        .btn-remove {
            background: transparent;
            border: 1px solid rgba(220,38,38,0.25);
            color: var(--red);
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 0.75rem;
            font-family: 'DM Sans', sans-serif;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .btn-remove svg {
                width: 11px;
                height: 11px;
            }

            .btn-remove:hover {
                background: var(--red);
                color: white;
                border-color: var(--red);
            }

        /* ── EMPTY STATE ── */
        .empty-state {
            text-align: center;
            padding: 40px 24px;
            color: var(--muted);
            font-size: 0.875rem;
        }

            .empty-state .empty-icon {
                width: 52px;
                height: 52px;
                background: var(--offwhite);
                border: 1px solid var(--border);
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 14px;
            }

                .empty-state .empty-icon svg {
                    width: 22px;
                    height: 22px;
                    color: var(--muted);
                    opacity: 0.5;
                }

            .empty-state h4 {
                font-family: 'DM Serif Display', serif;
                font-size: 1rem;
                color: var(--navy);
                margin-bottom: 4px;
            }

            .empty-state p {
                color: var(--muted);
                font-size: 0.82rem;
            }

        /* ── INFO TIPS ── */
        .info-tip {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            background: var(--teal-light);
            border: 1px solid rgba(13,148,136,0.2);
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 18px;
            font-size: 0.8rem;
            color: var(--navy);
            line-height: 1.6;
        }

            .info-tip svg {
                width: 15px;
                height: 15px;
                stroke: var(--teal);
                flex-shrink: 0;
                margin-top: 1px;
            }

        /* ── SECTION DIVIDER ── */
        .section-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

            .section-divider span {
                font-size: 0.72rem;
                font-weight: 600;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: 0.08em;
                white-space: nowrap;
            }

            .section-divider::before,
            .section-divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border);
            }

        /* ── TOAST ── */
        #toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 1000;
            background: var(--navy);
            color: white;
            padding: 12px 18px;
            border-radius: 12px;
            font-size: 0.82rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
            opacity: 0;
            transform: translateY(8px);
            transition: opacity 0.25s, transform 0.25s;
            pointer-events: none;
            max-width: 320px;
        }

        /* ── LOGOUT MODAL ── */
        #logout-modal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 999;
            background: rgba(11,31,58,0.45);
            align-items: center;
            justify-content: center;
        }

            #logout-modal.open {
                display: flex;
            }

        @@keyframes modalIn {
            from { opacity: 0; transform: scale(0.96) translateY(8px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
        }

        @@keyframes countUp {
            from { opacity: 0; transform: translateY(6px); }
            to   { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "P")</div>
                <span class="user-email">@ViewBag.Email</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn" id="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="nav-section">
                <div class="nav-label">Main</div>
                <a asp-controller="PatientDashboard" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                    Dashboard
                </a>
                <a asp-controller="PatientDashboard" asp-action="MyResults" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    My Results
                </a>
                <a asp-controller="PatientDashboard" asp-action="MedicalHistory" class="nav-item active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                    Medical History
                </a>
                <a asp-controller="PatientDashboard" asp-action="Consent" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    Consent
                </a>
                <a asp-controller="PatientDashboard" asp-action="Profile" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    Profile
                </a>
            </div>
            <div class="nav-section">
                <div class="nav-label">Support</div>
                <a href="#" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                    Help
                </a>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main">

            <!-- HERO -->
            <div class="hero">
                <div class="hero-content">
                    <div class="hero-tag">Medical History</div>
                    <h1>Your <span>Health Profile</span></h1>
                    <p>Manage your chronic conditions, allergies and current medications in one place.</p>
                </div>
            </div>

            <!-- STATS -->
            @{
                var conditionCount  = Model.Conditions.Count();
                var allergyCount    = Model.Allergies.Count();
                var medicationCount = Model.Medications.Count();
                var severeCount     = Model.Allergies.Count(a => a.Severity == "Severe");
            }
            <div class="stats" id="statsRow">
                <div class="stat-card">
                    <div class="stat-icon" style="background:#dbeafe">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#1d4ed8" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                    </div>
                    <div class="stat-value" data-target="@conditionCount">0</div>
                    <div class="stat-label">Conditions</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:#fee2e2">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /></svg>
                    </div>
                    <div class="stat-value" data-target="@allergyCount">0</div>
                    <div class="stat-label">Allergies</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:#dcfce7">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round"><path d="M10.5 20H4a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H20a2 2 0 0 1 2 2v3" /><circle cx="18" cy="18" r="3" /></svg>
                    </div>
                    <div class="stat-value" data-target="@medicationCount">0</div>
                    <div class="stat-label">Medications</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:#fef3c7">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                    </div>
                    <div class="stat-value" data-target="@severeCount">0</div>
                    <div class="stat-label">Severe Allergies</div>
                </div>
            </div>

            <!-- TABS -->
            <div class="tabs">
                <button class="tab-btn active" onclick="switchTab('conditions', this)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                    Conditions
                    <span class="tab-count">@conditionCount</span>
                </button>
                <button class="tab-btn" onclick="switchTab('allergies', this)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                    Allergies
                    <span class="tab-count">@allergyCount</span>
                </button>
                <button class="tab-btn" onclick="switchTab('medications', this)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10.5 20H4a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H20a2 2 0 0 1 2 2v3" /><circle cx="18" cy="18" r="3" /><path d="m22 22-1.5-1.5" /></svg>
                    Medications
                    <span class="tab-count">@medicationCount</span>
                </button>
            </div>

            <!-- ══════════ CONDITIONS TAB ══════════ -->
            <div id="tab-conditions" class="tab-content active">

                @if (severeCount > 0)
                {
                    <!-- alert tip shown only when severe allergies exist, shown here as a general tip -->
                }

                <div class="section-card" id="sc-add-condition">
                    <h3>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" /></svg>
                        Add Condition
                    </h3>
                    <div class="info-tip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
                        Recording your conditions helps your doctor provide better care and ensures your lab results are interpreted in the correct clinical context.
                    </div>
                    <form asp-controller="PatientDashboard" asp-action="AddCondition" method="post">
                        <div class="add-form">
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Condition</label>
                                    <select name="conditionId" required>
                                        <option value="">— Select condition —</option>
                                        @foreach (var c in Model.AllConditions)
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Diagnosed Date</label>
                                    <input type="date" name="diagnosedDate" />
                                </div>
                                <div class="form-group">
                                    <label>Notes</label>
                                    <input type="text" name="notes" placeholder="Optional notes" />
                                </div>
                                <button type="submit" class="btn-add">+ Add</button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="section-card" id="sc-list-condition">
                    <h3>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                        My Conditions
                        <span style="margin-left:auto;font-family:'DM Sans',sans-serif;font-size:0.75rem;font-weight:500;color:var(--muted);">@conditionCount recorded</span>
                    </h3>
                    @if (!Model.Conditions.Any())
                    {
                        <div class="empty-state">
                            <div class="empty-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                            </div>
                            <h4>No conditions recorded</h4>
                            <p>Add a condition above to keep your health profile up to date.</p>
                        </div>
                    }
                    else
                    {
                        <div class="items-list">
                            @foreach (var c in Model.Conditions)
                            {
                                <div class="item-card">
                                    <div class="item-icon" style="background:#dbeafe">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="#1d4ed8" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                                    </div>
                                    <div class="item-info">
                                        <div class="item-name">@c.ConditionName</div>
                                        <div class="item-meta">
                                            @if (c.DiagnosedDate.HasValue)
                                            {
                                                <span class="meta-chip">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                                    Diagnosed @c.DiagnosedDate.Value.ToString("dd MMM yyyy")
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(c.Notes))
                                            {
                                                <span class="meta-chip">@c.Notes</span>
                                            }
                                        </div>
                                    </div>
                                    <form asp-controller="PatientDashboard" asp-action="RemoveCondition" method="post">
                                        <input type="hidden" name="patientConditionId" value="@c.PatientConditionID" />
                                        <button type="submit" class="btn-remove">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                                            Remove
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- ══════════ ALLERGIES TAB ══════════ -->
            <div id="tab-allergies" class="tab-content">

                <div class="section-card">
                    <h3>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" /></svg>
                        Add Allergy
                    </h3>
                    <div class="info-tip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
                        Allergy information is shared with your assigned doctors to help prevent adverse reactions during treatment and testing.
                    </div>
                    <form asp-controller="PatientDashboard" asp-action="AddAllergy" method="post">
                        <div class="add-form">
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Allergy</label>
                                    <select name="allergyId" required>
                                        <option value="">— Select allergy —</option>
                                        @foreach (var a in Model.AllAllergies)
                                        {
                                            <option value="@a.Id">@a.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Severity</label>
                                    <select name="severity">
                                        <option value="">— Select severity —</option>
                                        <option value="Mild">Mild</option>
                                        <option value="Moderate">Moderate</option>
                                        <option value="Severe">Severe</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Notes</label>
                                    <input type="text" name="notes" placeholder="Optional notes" />
                                </div>
                                <button type="submit" class="btn-add">+ Add</button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="section-card">
                    <h3>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                        My Allergies
                        <span style="margin-left:auto;font-family:'DM Sans',sans-serif;font-size:0.75rem;font-weight:500;color:var(--muted);">@allergyCount recorded</span>
                    </h3>
                    @if (!Model.Allergies.Any())
                    {
                        <div class="empty-state">
                            <div class="empty-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /></svg>
                            </div>
                            <h4>No allergies recorded</h4>
                            <p>Add an allergy above to alert your care team of any sensitivities.</p>
                        </div>
                    }
                    else
                    {
                        @if (severeCount > 0)
                        {
                            <div style="display:flex;align-items:center;gap:10px;background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:0.8rem;color:#991b1b;font-weight:500;">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                                You have @severeCount severe allerg@(severeCount == 1 ? "y" : "ies") on record. Your doctors have been notified.
                            </div>
                        }
                        <div class="items-list">
                            @foreach (var a in Model.Allergies)
                            {
                                var badgeClass = a.Severity switch
                                {
                                    "Mild"     => "badge-mild",
                                    "Moderate" => "badge-moderate",
                                    "Severe"   => "badge-severe",
                                    _          => "badge-default"
                                };
                                var iconBg = a.Severity switch
                                {
                                    "Mild"     => "#dcfce7",
                                    "Moderate" => "#fef3c7",
                                    "Severe"   => "#fee2e2",
                                    _          => "var(--teal-light)"
                                };
                                var iconStroke = a.Severity switch
                                {
                                    "Mild"     => "#16a34a",
                                    "Moderate" => "#d97706",
                                    "Severe"   => "#dc2626",
                                    _          => "var(--teal)"
                                };
                                <div class="item-card">
                                    <div class="item-icon" style="background:@iconBg">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="@iconStroke" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /></svg>
                                    </div>
                                    <div class="item-info">
                                        <div class="item-name">@a.AllergyName</div>
                                        <div class="item-meta">
                                            @if (!string.IsNullOrEmpty(a.Notes))
                                            {
                                                <span class="meta-chip">@a.Notes</span>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(a.Severity))
                                    {
                                        <span class="badge @badgeClass">@a.Severity</span>
                                    }
                                    <form asp-controller="PatientDashboard" asp-action="RemoveAllergy" method="post">
                                        <input type="hidden" name="allergyId" value="@a.AllergyID" />
                                        <button type="submit" class="btn-remove">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg>
                                            Remove
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- ══════════ MEDICATIONS TAB ══════════ -->
            <div id="tab-medications" class="tab-content">

                <div class="section-card">
                    <h3>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" /></svg>
                        Add Medication
                    </h3>
                    <div class="info-tip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
                        Keeping your medication list current allows the lab to flag any potential interactions with test results or reference ranges.
                    </div>
                    <form asp-controller="PatientDashboard" asp-action="AddMedication" method="post">
                        <div class="add-form">
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Medication</label>
                                    <select name="medicationId" required>
                                        <option value="">— Select medication —</option>
                                        @foreach (var m in Model.AllMedications)
                                        {
                                            <option value="@m.Id">@m.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Dosage</label>
                                    <input type="text" name="dosage" placeholder="e.g. 500mg" />
                                </div>
                                <div class="form-group">
                                    <label>Frequency</label>
                                    <input type="text" name="frequency" placeholder="e.g. Twice daily" />
                                </div>
                            </div>
                            <div class="form-row" style="margin-top:10px;">
                                <div class="form-group">
                                    <label>Start Date</label>
                                    <input type="date" name="startDate" />
                                </div>
                                <div class="form-group">
                                    <label>End Date</label>
                                    <input type="date" name="endDate" />
                                </div>
                                <div class="form-group">
                                    <label>Notes</label>
                                    <input type="text" name="notes" placeholder="Optional notes" />
                                </div>
                                <button type="submit" class="btn-add">+ Add</button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="section-card">
                    <h3>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10.5 20H4a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H20a2 2 0 0 1 2 2v3" /><circle cx="18" cy="18" r="3" /><path d="m22 22-1.5-1.5" /></svg>
                        My Medications
                        <span style="margin-left:auto;font-family:'DM Sans',sans-serif;font-size:0.75rem;font-weight:500;color:var(--muted);">@medicationCount active</span>
                    </h3>
                    @if (!Model.Medications.Any())
                    {
                        <div class="empty-state">
                            <div class="empty-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="10" /></svg>
                            </div>
                            <h4>No medications recorded</h4>
                            <p>Add a medication above to keep your prescriptions tracked.</p>
                        </div>
                    }
                    else
                    {
                        <div class="items-list">
                            @foreach (var m in Model.Medications)
                            {
                                var isActive = !m.EndDate.HasValue || m.EndDate.Value >= DateTime.Today;
                                <div class="item-card">
                                    <div class="item-icon" style="background:#dcfce7">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round"><path d="M10.5 20H4a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H20a2 2 0 0 1 2 2v3" /><circle cx="18" cy="18" r="3" /></svg>
                                    </div>
                                    <div class="item-info">
                                        <div class="item-name">
                                            @m.MedicationName
                                            @if (isActive)
                                            {
                                                <span style="display:inline-block;margin-left:8px;padding:2px 8px;border-radius:100px;font-size:0.65rem;font-weight:600;background:#dcfce7;color:#16a34a;">Active</span>
                                            }
                                            else
                                            {
                                                <span style="display:inline-block;margin-left:8px;padding:2px 8px;border-radius:100px;font-size:0.65rem;font-weight:600;background:#f3f4f6;color:#6b7280;">Ended</span>
                                            }
                                        </div>
                                        <div class="item-meta">
                                            @if (!string.IsNullOrEmpty(m.Dosage))
                                            {
                                                <span class="meta-chip">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/></svg>
                                                    @m.Dosage
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(m.Frequency))
                                            {
                                                <span class="meta-chip">@m.Frequency</span>
                                            }
                                            @if (m.StartDate.HasValue)
                                            {
                                                <span class="meta-chip">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                                    From @m.StartDate.Value.ToString("dd MMM yyyy")
                                                    @if (m.EndDate.HasValue) { <text> → @m.EndDate.Value.ToString("dd MMM yyyy")</text> }
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(m.Notes))
                                            {
                                                <span class="meta-chip">@m.Notes</span>
                                            }
                                        </div>
                                    </div>
                                    <form asp-controller="PatientDashboard" asp-action="RemoveMedication" method="post">
                                        <input type="hidden" name="medicationId" value="@m.MedicationID" />
                                        <button type="submit" class="btn-remove">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg>
                                            Remove
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </main>
    </div>

    <!-- LOGOUT MODAL -->
    <div id="logout-modal" role="dialog" aria-modal="true" aria-labelledby="logout-modal-title">
        <div style="background:white;border-radius:20px;padding:32px 28px;max-width:380px;width:90%;box-shadow:0 20px 60px rgba(11,31,58,0.2);animation:modalIn 0.18s ease;">
            <div style="width:52px;height:52px;background:#fee2e2;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
            </div>
            <h3 id="logout-modal-title" style="font-family:'DM Serif Display',serif;font-size:1.2rem;color:var(--navy);margin-bottom:8px;">Sign out?</h3>
            <p style="font-size:0.85rem;color:var(--muted);margin-bottom:24px;line-height:1.6;">You'll be returned to the login screen. Any unsaved changes will be lost.</p>
            <div style="display:flex;gap:10px;">
                <button id="logout-cancel" style="flex:1;padding:10px;border:1px solid var(--border);border-radius:10px;background:white;color:var(--navy);font-size:0.85rem;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;">Cancel</button>
                <a id="logout-confirm" href="#" style="flex:1;padding:10px;border:none;border-radius:10px;background:#dc2626;color:white;font-size:0.85rem;font-weight:600;cursor:pointer;text-align:center;text-decoration:none;font-family:'DM Sans',sans-serif;">Sign Out</a>
            </div>
        </div>
    </div>

    <!-- TOAST -->
    <div id="toast" role="status" aria-live="polite">
        <span id="toast-icon"></span>
        <span id="toast-msg"></span>
    </div>

    <script>
        (function () {
            'use strict';

            /* ─── TAB SWITCHING ─── */
            function switchTab(tab, btn) {
                document.querySelectorAll('.tab-content').forEach(function(t) { t.classList.remove('active'); });
                document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
                document.getElementById('tab-' + tab).classList.add('active');
                btn.classList.add('active');
            }
            window.switchTab = switchTab;

            /* ─── STAGGERED SECTION CARD ANIMATIONS ─── */
            var cards = document.querySelectorAll('.section-card');
            cards.forEach(function(card, i) {
                card.style.transitionDelay = (i * 80) + 'ms';
                requestAnimationFrame(function() {
                    requestAnimationFrame(function() { card.classList.add('visible'); });
                });
            });

            /* ─── STATS ROW ANIMATION ─── */
            var statsRow = document.getElementById('statsRow');
            if (statsRow) {
                requestAnimationFrame(function() {
                    requestAnimationFrame(function() { statsRow.classList.add('visible'); });
                });
            }

            /* ─── ANIMATED STAT COUNTERS ─── */
            function animateCounter(el, target, duration) {
                var start = null;
                function step(ts) {
                    if (!start) start = ts;
                    var p = Math.min((ts - start) / duration, 1);
                    var eased = 1 - Math.pow(1 - p, 3);
                    el.textContent = Math.round(target * eased);
                    if (p < 1) requestAnimationFrame(step);
                    else el.textContent = target;
                }
                requestAnimationFrame(step);
            }
            document.querySelectorAll('.stat-value[data-target]').forEach(function(el) {
                animateCounter(el, parseInt(el.getAttribute('data-target'), 10) || 0, 900);
            });

            /* ─── TOAST ─── */
            var toast    = document.getElementById('toast');
            var toastMsg = document.getElementById('toast-msg');
            var toastIco = document.getElementById('toast-icon');
            var toastTimer;
            function showToast(msg, type) {
                type = type || 'info';
                var icons = { success:'✓', warning:'⚠', error:'✕', info:'ℹ' };
                toastMsg.textContent = msg;
                toastIco.textContent = icons[type] || 'ℹ';
                toast.style.opacity = '1';
                toast.style.transform = 'translateY(0)';
                clearTimeout(toastTimer);
                toastTimer = setTimeout(function() {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(8px)';
                }, 3200);
            }
            window.showToast = showToast;

            /* ─── CONFIRM BEFORE REMOVE ─── */
            document.querySelectorAll('.btn-remove').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    if (!confirm('Remove this entry from your medical history?')) {
                        e.preventDefault();
                    }
                });
            });

            /* ─── LOGOUT MODAL ─── */
            var logoutBtn    = document.getElementById('logout-btn');
            var logoutModal  = document.getElementById('logout-modal');
            var logoutCancel = document.getElementById('logout-cancel');
            var logoutConfirm = document.getElementById('logout-confirm');
            if (logoutBtn && logoutModal) {
                logoutConfirm.href = logoutBtn.href;
                logoutBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    logoutModal.classList.add('open');
                    logoutModal.style.display = 'flex';
                    if (logoutCancel) logoutCancel.focus();
                });
                function closeModal() {
                    logoutModal.classList.remove('open');
                    logoutModal.style.display = 'none';
                    logoutBtn.focus();
                }
                if (logoutCancel) logoutCancel.addEventListener('click', closeModal);
                logoutModal.addEventListener('click', function(e) { if (e.target === logoutModal) closeModal(); });
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape' && logoutModal.style.display === 'flex') closeModal();
                });
            }

            /* ─── KEYBOARD SHORTCUTS ─── */
            document.addEventListener('keydown', function(e) {
                if (e.altKey) {
                    if (e.key === '1') window.location.href = '/PatientDashboard/Index';
                    if (e.key === '2') window.location.href = '/PatientDashboard/MyResults';
                    if (e.key === '3') window.location.href = '/PatientDashboard/MedicalHistory';
                    if (e.key === '4') window.location.href = '/PatientDashboard/Consent';
                    if (e.key === '5') window.location.href = '/PatientDashboard/Profile';
                }
            });

            /* ─── WELCOME TOAST ─── */
            if (!sessionStorage.getItem('medhistory_welcomed')) {
                sessionStorage.setItem('medhistory_welcomed', '1');
                setTimeout(function() { showToast('Medical history loaded', 'success'); }, 600);
            }

        })();
    </script>

</body>
</html>
