@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Patient.Models.MedicalHistoryViewModel
@{
    ViewData["Title"] = "Medical History";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Medical History — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@@0;1&family=DM+Sans:wght@@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --teal: #0d9488;
            --teal-light: rgba(13,148,136,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
            --amber: #d97706;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
        }

        /* ── TOPBAR ── */
        .topbar {
            background: var(--navy);
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-logo {
            width: 34px;
            height: 34px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .brand-logo svg {
                width: 18px;
                height: 18px;
                fill: white;
            }

        .brand-name {
            font-family: 'DM Serif Display', serif;
            color: white;
            font-size: 1.1rem;
            line-height: 1.1;
        }

            .brand-name span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.6rem;
                font-weight: 300;
                color: rgba(255,255,255,0.4);
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 6px 14px 6px 8px;
        }

        .user-avatar {
            width: 28px;
            height: 28px;
            background: var(--teal);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
        }

        .user-email {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.75);
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .logout-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.8);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .logout-btn:hover {
                background: rgba(255,255,255,0.15);
                color: white;
            }

            .logout-btn svg {
                width: 14px;
                height: 14px;
            }

        /* ── LAYOUT ── */
        .page {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 220px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 24px 0;
            flex-shrink: 0;
            position: sticky;
            top: 64px;
            height: calc(100vh - 64px);
            overflow-y: auto;
        }

        .nav-section {
            margin-bottom: 8px;
        }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 20px;
            margin-bottom: 4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.15s;
            border-left: 3px solid transparent;
        }

            .nav-item:hover {
                background: var(--offwhite);
                color: var(--navy);
            }

            .nav-item.active {
                background: var(--teal-light);
                color: var(--teal);
                border-left-color: var(--teal);
            }

            .nav-item svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        /* ── MAIN ── */
        .main {
            flex: 1;
            padding: clamp(24px, 3vw, 40px);
            overflow-y: auto;
        }

        /* ── PAGE HEADER ── */
        .page-header {
            margin-bottom: 28px;
        }

            .page-header h1 {
                font-family: 'DM Serif Display', serif;
                font-size: clamp(1.4rem, 2.5vw, 2rem);
                color: var(--navy);
                margin-bottom: 4px;
            }

            .page-header p {
                font-size: 0.875rem;
                color: var(--muted);
                font-weight: 400;
            }

        /* ── TABS ── */
        .tabs {
            display: flex;
            gap: 4px;
            margin-bottom: 24px;
            border-bottom: 1px solid var(--border);
        }

        .tab-btn {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 10px 20px;
            background: transparent;
            border: none;
            color: var(--muted);
            font-size: 0.85rem;
            font-family: 'DM Sans', sans-serif;
            font-weight: 500;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            transition: all 0.2s;
        }

            .tab-btn svg {
                width: 15px;
                height: 15px;
            }

            .tab-btn.active {
                color: var(--teal);
                border-bottom-color: var(--teal);
                font-weight: 600;
            }

            .tab-btn:hover {
                color: var(--navy);
            }

        .tab-content {
            display: none;
        }

            .tab-content.active {
                display: block;
            }

        /* ── SECTION CARD ── */
        .section-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
        }

            .section-card h3 {
                font-family: 'DM Serif Display', serif;
                font-size: 1.05rem;
                color: var(--navy);
                margin-bottom: 18px;
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .section-card h3 svg {
                    width: 16px;
                    height: 16px;
                    color: var(--teal);
                }

        /* ── ADD FORM ── */
        .add-form {
            background: var(--offwhite);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 18px;
        }

        .form-row {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            align-items: flex-end;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex: 1;
            min-width: 160px;
        }

            .form-group label {
                font-size: 0.72rem;
                font-weight: 600;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: 0.07em;
            }

            .form-group select,
            .form-group input,
            .form-group textarea {
                background: white;
                border: 1px solid var(--border);
                color: var(--navy);
                padding: 9px 12px;
                border-radius: 8px;
                font-size: 0.875rem;
                font-family: 'DM Sans', sans-serif;
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s;
            }

                .form-group select:focus,
                .form-group input:focus,
                .form-group textarea:focus {
                    border-color: var(--teal);
                    box-shadow: 0 0 0 3px var(--teal-light);
                }

        .btn-add {
            padding: 9px 20px;
            background: var(--teal);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 0.85rem;
            font-family: 'DM Sans', sans-serif;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
            white-space: nowrap;
            align-self: flex-end;
        }

            .btn-add:hover {
                background: #0b7a71;
            }

        /* ── ITEMS LIST ── */
        .items-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .item-card {
            background: var(--offwhite);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            transition: box-shadow 0.15s;
        }

            .item-card:hover {
                box-shadow: 0 4px 12px rgba(11,31,58,0.07);
            }

        .item-info {
            flex: 1;
        }

        .item-name {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--navy);
            margin-bottom: 3px;
        }

        .item-meta {
            font-size: 0.75rem;
            color: var(--muted);
        }

        /* ── BADGES ── */
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 100px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .badge-mild {
            background: #dcfce7;
            color: var(--green);
        }

        .badge-moderate {
            background: #fef3c7;
            color: var(--amber);
        }

        .badge-severe {
            background: #fee2e2;
            color: var(--red);
        }

        .badge-default {
            background: var(--teal-light);
            color: var(--teal);
        }

        /* ── REMOVE BUTTON ── */
        .btn-remove {
            background: transparent;
            border: 1px solid rgba(220,38,38,0.25);
            color: var(--red);
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 0.75rem;
            font-family: 'DM Sans', sans-serif;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }

            .btn-remove:hover {
                background: var(--red);
                color: white;
                border-color: var(--red);
            }

        /* ── EMPTY STATE ── */
        .empty-state {
            text-align: center;
            padding: 36px;
            color: var(--muted);
            font-size: 0.875rem;
        }

            .empty-state .empty-icon {
                width: 44px;
                height: 44px;
                background: var(--offwhite);
                border: 1px solid var(--border);
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 12px;
            }

                .empty-state .empty-icon svg {
                    width: 20px;
                    height: 20px;
                    color: var(--muted);
                }

            .empty-state p {
                color: var(--muted);
            }

        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .topbar {
                padding: 0 20px;
            }

            .user-email {
                display: none;
            }

            .sidebar {
                display: none;
            }

            .main {
                padding: 20px 16px;
            }
        }
    </style>
</head>
<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "P")</div>
                <span class="user-email">@ViewBag.Email</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="nav-section">
                <div class="nav-label">Main</div>
                <a asp-controller="PatientDashboard" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                    Dashboard
                </a>
                <a asp-controller="PatientDashboard" asp-action="MyResults" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    My Results
                </a>
                <a asp-controller="PatientDashboard" asp-action="MedicalHistory" class="nav-item active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                    Medical History
                </a>
                <a asp-controller="PatientDashboard" asp-action="Consent" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    Consent
                </a>
                <a asp-controller="PatientDashboard" asp-action="Profile" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    Profile
                </a>
            </div>
            <div class="nav-section">
                <div class="nav-label">Support</div>
                <a href="#" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                    Help
                </a>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main">

            <!-- PAGE HEADER -->
            <div class="page-header">
                <h1>Medical History</h1>
                <p>Manage your chronic conditions, allergies, and current medications</p>
            </div>

            <!-- TABS -->
            <div class="tabs">
                <button class="tab-btn active" onclick="switchTab('conditions', this)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                    Conditions
                </button>
                <button class="tab-btn" onclick="switchTab('allergies', this)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                    Allergies
                </button>
                <button class="tab-btn" onclick="switchTab('medications', this)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10.5 20H4a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H20a2 2 0 0 1 2 2v3" /><circle cx="18" cy="18" r="3" /><path d="m22 22-1.5-1.5" /></svg>
                    Medications
                </button>
            </div>

            <!-- CONDITIONS TAB -->
            <div id="tab-conditions" class="tab-content active">
                <div class="section-card">
                    <h3>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" /></svg>
                        Add Condition
                    </h3>
                    <form asp-controller="PatientDashboard" asp-action="AddCondition" method="post">
                        <div class="add-form">
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Condition</label>
                                    <select name="conditionId" required>
                                        <option value="">— Select condition —</option>
                                        @foreach (var c in Model.AllConditions)
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Diagnosed Date</label>
                                    <input type="date" name="diagnosedDate" />
                                </div>
                                <div class="form-group">
                                    <label>Notes</label>
                                    <input type="text" name="notes" placeholder="Optional notes" />
                                </div>
                                <button type="submit" class="btn-add">+ Add</button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="section-card">
                    <h3>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                        My Conditions
                    </h3>
                    @if (!Model.Conditions.Any())
                    {
                        <div class="empty-state">
                            <div class="empty-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                            </div>
                            <p>No conditions recorded yet</p>
                        </div>
                    }
                    else
                    {
                        <div class="items-list">
                            @foreach (var c in Model.Conditions)
                            {
                                <div class="item-card">
                                    <div class="item-info">
                                        <div class="item-name">@c.ConditionName</div>
                                        <div class="item-meta">
                                            @if (c.DiagnosedDate.HasValue)
                                            {
                                                <span>Diagnosed: @c.DiagnosedDate.Value.ToString("dd MMM yyyy")</span>
                                            }
                                            @if (!string.IsNullOrEmpty(c.Notes))
                                            {
                                                <span> · @c.Notes</span>
                                            }
                                        </div>
                                    </div>
                                    <form asp-controller="PatientDashboard" asp-action="RemoveCondition" method="post">
                                        <input type="hidden" name="patientConditionId" value="@c.PatientConditionID" />
                                        <button type="submit" class="btn-remove">Remove</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- ALLERGIES TAB -->
            <div id="tab-allergies" class="tab-content">
                <div class="section-card">
                    <h3>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" /></svg>
                        Add Allergy
                    </h3>
                    <form asp-controller="PatientDashboard" asp-action="AddAllergy" method="post">
                        <div class="add-form">
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Allergy</label>
                                    <select name="allergyId" required>
                                        <option value="">— Select allergy —</option>
                                        @foreach (var a in Model.AllAllergies)
                                        {
                                            <option value="@a.Id">@a.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Severity</label>
                                    <select name="severity">
                                        <option value="">— Select severity —</option>
                                        <option value="Mild">Mild</option>
                                        <option value="Moderate">Moderate</option>
                                        <option value="Severe">Severe</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Notes</label>
                                    <input type="text" name="notes" placeholder="Optional notes" />
                                </div>
                                <button type="submit" class="btn-add">+ Add</button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="section-card">
                    <h3>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                        My Allergies
                    </h3>
                    @if (!Model.Allergies.Any())
                    {
                        <div class="empty-state">
                            <div class="empty-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /></svg>
                            </div>
                            <p>No allergies recorded yet</p>
                        </div>
                    }
                    else
                    {
                        <div class="items-list">
                            @foreach (var a in Model.Allergies)
                            {
                                var badgeClass = a.Severity switch
                                {
                                    "Mild" => "badge-mild",
                                    "Moderate" => "badge-moderate",
                                    "Severe" => "badge-severe",
                                    _ => "badge-default"
                                };
                                <div class="item-card">
                                    <div class="item-info">
                                        <div class="item-name">@a.AllergyName</div>
                                        <div class="item-meta">
                                            @if (!string.IsNullOrEmpty(a.Notes))
                                            {
                                                <span>@a.Notes</span>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(a.Severity))
                                    {
                                        <span class="badge @badgeClass">@a.Severity</span>
                                    }
                                    <form asp-controller="PatientDashboard" asp-action="RemoveAllergy" method="post">
                                        <input type="hidden" name="allergyId" value="@a.AllergyID" />
                                        <button type="submit" class="btn-remove">Remove</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- MEDICATIONS TAB -->
            <div id="tab-medications" class="tab-content">
                <div class="section-card">
                    <h3>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" /></svg>
                        Add Medication
                    </h3>
                    <form asp-controller="PatientDashboard" asp-action="AddMedication" method="post">
                        <div class="add-form">
                            <div class="form-row">
                                <div class="form-group">
                                    <label>Medication</label>
                                    <select name="medicationId" required>
                                        <option value="">— Select medication —</option>
                                        @foreach (var m in Model.AllMedications)
                                        {
                                            <option value="@m.Id">@m.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Dosage</label>
                                    <input type="text" name="dosage" placeholder="e.g. 500mg" />
                                </div>
                                <div class="form-group">
                                    <label>Frequency</label>
                                    <input type="text" name="frequency" placeholder="e.g. Twice daily" />
                                </div>
                            </div>
                            <div class="form-row" style="margin-top: 10px;">
                                <div class="form-group">
                                    <label>Start Date</label>
                                    <input type="date" name="startDate" />
                                </div>
                                <div class="form-group">
                                    <label>End Date</label>
                                    <input type="date" name="endDate" />
                                </div>
                                <div class="form-group">
                                    <label>Notes</label>
                                    <input type="text" name="notes" placeholder="Optional notes" />
                                </div>
                                <button type="submit" class="btn-add">+ Add</button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="section-card">
                    <h3>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10.5 20H4a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H20a2 2 0 0 1 2 2v3" /><circle cx="18" cy="18" r="3" /><path d="m22 22-1.5-1.5" /></svg>
                        My Medications
                    </h3>
                    @if (!Model.Medications.Any())
                    {
                        <div class="empty-state">
                            <div class="empty-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="10" /></svg>
                            </div>
                            <p>No medications recorded yet</p>
                        </div>
                    }
                    else
                    {
                        <div class="items-list">
                            @foreach (var m in Model.Medications)
                            {
                                <div class="item-card">
                                    <div class="item-info">
                                        <div class="item-name">@m.MedicationName</div>
                                        <div class="item-meta">
                                            @if (!string.IsNullOrEmpty(m.Dosage))
                                            {
                                                <span>@m.Dosage</span>
                                            }
                                            @if (!string.IsNullOrEmpty(m.Frequency))
                                            {
                                                <span> · @m.Frequency</span>
                                            }
                                            @if (m.StartDate.HasValue)
                                            {
                                                <span> · From @m.StartDate.Value.ToString("dd MMM yyyy")</span>
                                            }
                                            @if (m.EndDate.HasValue)
                                            {
                                                <span> to @m.EndDate.Value.ToString("dd MMM yyyy")</span>
                                            }
                                            @if (!string.IsNullOrEmpty(m.Notes))
                                            {
                                                <span> · @m.Notes</span>
                                            }
                                        </div>
                                    </div>
                                    <form asp-controller="PatientDashboard" asp-action="RemoveMedication" method="post">
                                        <input type="hidden" name="medicationId" value="@m.MedicationID" />
                                        <button type="submit" class="btn-remove">Remove</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </main>
    </div>

    <script>
        function switchTab(tab, btn) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('tab-' + tab).classList.add('active');
            btn.classList.add('active');
        }
    </script>

</body>
</html>
