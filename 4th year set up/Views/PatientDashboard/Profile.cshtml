@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Patient.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Profile — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --teal: #0d9488;
            --teal-light: rgba(13,148,136,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
            --amber: #d97706;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
        }

        /* ── TOPBAR ── */
        .topbar {
            background: var(--navy);
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-logo {
            width: 34px;
            height: 34px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .brand-logo svg {
                width: 18px;
                height: 18px;
                fill: white;
            }

        .brand-name {
            font-family: 'DM Serif Display', serif;
            color: white;
            font-size: 1.1rem;
            line-height: 1.1;
        }

            .brand-name span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.6rem;
                font-weight: 300;
                color: rgba(255,255,255,0.4);
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 6px 14px 6px 8px;
        }

        .user-avatar {
            width: 28px;
            height: 28px;
            background: var(--teal);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
        }

        .user-email {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.75);
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .logout-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.8);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .logout-btn:hover {
                background: rgba(255,255,255,0.15);
                color: white;
            }

            .logout-btn svg {
                width: 14px;
                height: 14px;
            }

        /* ── LAYOUT ── */
        .page {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 220px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 24px 0;
            flex-shrink: 0;
            position: sticky;
            top: 64px;
            height: calc(100vh - 64px);
            overflow-y: auto;
        }

        .nav-section {
            margin-bottom: 8px;
        }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 20px;
            margin-bottom: 4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.15s;
            border-left: 3px solid transparent;
        }

            .nav-item:hover {
                background: var(--offwhite);
                color: var(--navy);
            }

            .nav-item.active {
                background: var(--teal-light);
                color: var(--teal);
                border-left-color: var(--teal);
            }

            .nav-item svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        /* ── MAIN ── */
        .main {
            flex: 1;
            padding: clamp(24px, 3vw, 40px);
            overflow-y: auto;
        }

        /* ── HERO ── */
        .hero {
            background: var(--navy);
            border-radius: 20px;
            padding: 32px 36px;
            margin-bottom: 32px;
            position: relative;
            overflow: hidden;
        }

            .hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 60% 80% at 90% 50%, rgba(13,148,136,0.2) 0%, transparent 60%);
            }

            .hero::after {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
                background-size: 40px 40px;
            }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(13,148,136,0.15);
            border: 1px solid rgba(13,148,136,0.3);
            color: #5eead4;
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 100px;
            margin-bottom: 14px;
        }

            .hero-tag::before {
                content: '';
                width: 5px;
                height: 5px;
                background: #5eead4;
                border-radius: 50%;
            }

        .hero h1 {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.5rem, 2.5vw, 2.2rem);
            color: white;
            margin-bottom: 8px;
            line-height: 1.2;
        }

            .hero h1 span {
                color: #5eead4;
                font-style: italic;
            }

        .hero p {
            color: rgba(255,255,255,0.5);
            font-size: 0.88rem;
            font-weight: 300;
        }

        /* ── ALERTS ── */
        .alert {
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 24px;
            font-size: 0.875rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid;
        }

            .alert svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        .alert-success {
            background: #f0fdf4;
            color: var(--green);
            border-color: #bbf7d0;
        }

        .alert-error {
            background: #fef2f2;
            color: var(--red);
            border-color: #fecaca;
        }

        /* ── GRID ── */
        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        @@media (max-width: 900px) {
            .grid {
                grid-template-columns: 1fr;
            }
        }

        /* ── CARDS ── */
        .card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
        }

        .card-title {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .card-title-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .card-title-icon svg {
                width: 15px;
                height: 15px;
            }

        .card-title h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.05rem;
            color: var(--navy);
            font-weight: 400;
        }

        .readonly-badge {
            font-size: 0.62rem;
            background: var(--offwhite);
            color: var(--muted);
            padding: 2px 8px;
            border-radius: 100px;
            border: 1px solid var(--border);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
            margin-left: auto;
        }

        /* ── AVATAR CARD ── */
        .avatar-card {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .avatar {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--teal), #0891b2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display', serif;
            font-size: 1.5rem;
            color: white;
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(13,148,136,0.3);
        }

        .avatar-info {
            flex: 1;
            min-width: 0;
        }

        .profile-name {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            color: var(--navy);
            line-height: 1.2;
        }

        .profile-meta {
            font-size: 0.78rem;
            color: var(--muted);
            margin-top: 3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .profile-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: var(--teal-light);
            color: var(--teal);
            font-size: 0.7rem;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 100px;
            margin-top: 8px;
            border: 1px solid rgba(13,148,136,0.2);
        }

            .profile-badge::before {
                content: '';
                width: 5px;
                height: 5px;
                background: var(--teal);
                border-radius: 50%;
            }

        /* ── FORM ── */
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 16px;
        }

            .form-group label {
                font-size: 0.72rem;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: 0.06em;
                font-weight: 600;
            }

            .form-group input {
                background: var(--offwhite);
                border: 1px solid var(--border);
                color: var(--navy);
                padding: 10px 14px;
                border-radius: 10px;
                font-size: 0.875rem;
                font-family: inherit;
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s;
            }

                .form-group input:focus {
                    border-color: var(--teal);
                    box-shadow: 0 0 0 3px var(--teal-light);
                    background: white;
                }

                .form-group input[readonly] {
                    color: var(--muted);
                    cursor: not-allowed;
                    background: var(--offwhite);
                    border-color: var(--border);
                }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .divider {
            border: none;
            border-top: 1px solid var(--border);
            margin: 20px 0;
        }

        /* ── BUTTONS ── */
        .btn {
            padding: 10px 24px;
            border: none;
            border-radius: 10px;
            font-size: 0.875rem;
            cursor: pointer;
            font-family: inherit;
            font-weight: 600;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

            .btn svg {
                width: 14px;
                height: 14px;
            }

        .btn-primary {
            background: var(--teal);
            color: white;
            box-shadow: 0 2px 8px rgba(13,148,136,0.25);
        }

            .btn-primary:hover {
                background: #0f766e;
                box-shadow: 0 4px 14px rgba(13,148,136,0.35);
            }

        .btn-danger {
            background: white;
            color: var(--red);
            border: 1px solid #fecaca;
            box-shadow: 0 2px 8px rgba(220,38,38,0.08);
        }

            .btn-danger:hover {
                background: var(--red);
                color: white;
                border-color: var(--red);
            }

        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .topbar {
                padding: 0 20px;
            }

            .user-email {
                display: none;
            }

            .sidebar {
                display: none;
            }

            .main {
                padding: 20px 16px;
            }

            .hero {
                padding: 24px 20px;
            }

            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "P")</div>
                <span class="user-email">@ViewBag.Email</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="nav-section">
                <div class="nav-label">Main</div>
                <a asp-controller="PatientDashboard" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                    Dashboard
                </a>
                <a asp-controller="PatientDashboard" asp-action="MyResults" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    My Results
                </a>
                <a asp-controller="PatientDashboard" asp-action="MedicalHistory" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                    Medical History
                </a>
                <a asp-controller="PatientDashboard" asp-action="Consent" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    Consent
                </a>
                <a asp-controller="PatientDashboard" asp-action="Profile" class="nav-item active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    Profile
                </a>
            </div>
            <div class="nav-section">
                <div class="nav-label">Support</div>
                <a href="#" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                    Help
                </a>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main">

            <!-- HERO -->
            <div class="hero">
                <div class="hero-content">
                    <div class="hero-tag">My Profile</div>
                    <h1>Account <span>Settings</span></h1>
                    <p>Manage your personal details and account security.</p>
                </div>
            </div>

            <!-- ALERTS -->
            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg>
                    @ViewBag.Success
                </div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-error">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
                    @ViewBag.Error
                </div>
            }

            <div class="grid">

                <!-- LEFT COLUMN -->
                <div>

                    <!-- AVATAR SUMMARY CARD -->
                    <div class="card">
                        <div class="avatar-card">
                            <div class="avatar">@Model.FirstName[0]@Model.LastName[0]</div>
                            <div class="avatar-info">
                                <div class="profile-name">@Model.FirstName @Model.LastName</div>
                                <div class="profile-meta">@Model.Email</div>
                                <div class="profile-meta">Member since @Model.RegistrationDate.ToString("dd MMM yyyy")</div>
                                <div class="profile-badge">Patient</div>
                            </div>
                        </div>
                    </div>

                    <!-- READ-ONLY INFO -->
                    <div class="card">
                        <div class="card-title">
                            <div class="card-title-icon" style="background:#dbeafe">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#1d4ed8" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                            </div>
                            <h3>Account Information</h3>
                            <span class="readonly-badge">Read Only</span>
                        </div>
                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="text" value="@Model.Email" readonly />
                        </div>
                        <div class="form-group">
                            <label>SA ID Number</label>
                            <input type="text" value="@Model.IDNumber" readonly />
                        </div>
                        <div class="form-group">
                            <label>Registration Date</label>
                            <input type="text" value="@Model.RegistrationDate.ToString("dd MMM yyyy")" readonly />
                        </div>
                    </div>

                </div>

                <!-- RIGHT COLUMN -->
                <div>

                    <!-- PERSONAL DETAILS -->
                    <div class="card">
                        <div class="card-title">
                            <div class="card-title-icon" style="background:rgba(13,148,136,0.1)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                            </div>
                            <h3>Personal Details</h3>
                        </div>
                        <form asp-controller="PatientDashboard" asp-action="UpdateProfile" method="post">
                            @Html.AntiForgeryToken()
                            <div class="form-row">
                                <div class="form-group">
                                    <label>First Name</label>
                                    <input type="text" name="FirstName" value="@Model.FirstName" required />
                                </div>
                                <div class="form-group">
                                    <label>Last Name</label>
                                    <input type="text" name="LastName" value="@Model.LastName" required />
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Date of Birth</label>
                                <input type="date" name="DateOfBirth" value="@Model.DateOfBirth.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="form-group">
                                <label>Cellphone Number</label>
                                <input type="text" name="CellphoneNumber" value="@Model.CellphoneNumber" required />
                            </div>
                            <div class="form-group">
                                <label>Home Address</label>
                                <input type="text" name="HomeAddress" value="@Model.HomeAddress" required />
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg>
                                Save Changes
                            </button>
                        </form>
                    </div>

                    <!-- CHANGE PASSWORD -->
                    <div class="card">
                        <div class="card-title">
                            <div class="card-title-icon" style="background:#fef3c7">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4" /></svg>
                            </div>
                            <h3>Change Password</h3>
                        </div>
                        <form asp-controller="PatientDashboard" asp-action="ChangePassword" method="post">
                            @Html.AntiForgeryToken()
                            <div class="form-group">
                                <label>Current Password</label>
                                <input type="password" name="CurrentPassword" required />
                            </div>
                            <hr class="divider" />
                            <div class="form-group">
                                <label>New Password</label>
                                <input type="password" name="NewPassword" required />
                            </div>
                            <div class="form-group">
                                <label>Confirm New Password</label>
                                <input type="password" name="ConfirmPassword" required />
                            </div>
