@using Patient.Models
@{
    ViewData["Title"] = "My Results";
    Layout = null;
    var requests = ViewData["Requests"] as List<TestRequest> ?? new();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Results — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --teal: #0d9488;
            --teal-light: rgba(13,148,136,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
            --amber: #d97706;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
        }

        .topbar {
            background: var(--navy);
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-logo {
            width: 34px;
            height: 34px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .brand-logo svg {
                width: 18px;
                height: 18px;
                fill: white;
            }

        .brand-name {
            font-family: 'DM Serif Display', serif;
            color: white;
            font-size: 1.1rem;
            line-height: 1.1;
        }

            .brand-name span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.6rem;
                font-weight: 300;
                color: rgba(255,255,255,0.4);
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 6px 14px 6px 8px;
        }

        .user-avatar {
            width: 28px;
            height: 28px;
            background: var(--teal);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
        }

        .user-email {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.75);
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .logout-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.8);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .logout-btn:hover {
                background: rgba(255,255,255,0.15);
                color: white;
            }

            .logout-btn svg {
                width: 14px;
                height: 14px;
            }

        .page {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        .sidebar {
            width: 220px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 24px 0;
            flex-shrink: 0;
            position: sticky;
            top: 64px;
            height: calc(100vh - 64px);
            overflow-y: auto;
        }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 20px;
            margin-bottom: 4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.15s;
            border-left: 3px solid transparent;
        }

            .nav-item:hover {
                background: var(--offwhite);
                color: var(--navy);
            }

            .nav-item.active {
                background: var(--teal-light);
                color: var(--teal);
                border-left-color: var(--teal);
            }

            .nav-item svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        .main {
            flex: 1;
            padding: clamp(24px, 3vw, 40px);
        }

        .page-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--teal);
            margin-bottom: 6px;
        }

        .page-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.8rem;
            color: var(--navy);
            margin-bottom: 4px;
        }

        .page-sub {
            font-size: 13.5px;
            color: var(--muted);
            margin-bottom: 28px;
        }

        /* STATUS BADGES */
        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 100px;
            font-size: 11px;
            font-weight: 600;
        }

        .badge-submitted {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .badge-progress {
            background: #fef3c7;
            color: var(--amber);
        }

        .badge-completed {
            background: #dcfce7;
            color: var(--green);
        }

        .badge-released {
            background: rgba(13,148,136,0.1);
            color: var(--teal);
        }

        .badge-cancelled {
            background: #fef2f2;
            color: var(--red);
        }

        .badge-abnormal {
            background: #fef2f2;
            color: var(--red);
        }

        .badge-normal {
            background: #dcfce7;
            color: var(--green);
        }

        .badge-urgent {
            background: #fef2f2;
            color: var(--red);
        }

        .badge-routine {
            background: #f3f4f6;
            color: #374151;
        }

        .badge-stat {
            background: #fdf2f8;
            color: #9333ea;
        }

        /* REQUEST CARDS */
        .request-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            margin-bottom: 16px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
        }

        .request-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 24px;
            cursor: pointer;
            transition: background 0.15s;
        }

            .request-header:hover {
                background: var(--offwhite);
            }

        .request-header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .request-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--teal-light);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .request-icon svg {
                width: 18px;
                height: 18px;
                stroke: var(--teal);
            }

        .request-number {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--navy);
        }

        .request-meta {
            font-size: 0.78rem;
            color: var(--muted);
            margin-top: 3px;
        }

        .request-header-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .chevron {
            width: 18px;
            height: 18px;
            stroke: var(--muted);
            transition: transform 0.2s;
        }

            .chevron.open {
                transform: rotate(180deg);
            }

        /* REQUEST BODY */
        .request-body {
            display: none;
            border-top: 1px solid var(--border);
            padding: 20px 24px;
        }

            .request-body.open {
                display: block;
            }

        .clinical-notes {
            background: var(--offwhite);
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 20px;
            font-size: 13px;
            color: var(--muted);
        }

            .clinical-notes strong {
                color: var(--navy);
                display: block;
                margin-bottom: 4px;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

        .release-notes {
            background: rgba(13,148,136,0.06);
            border: 1px solid rgba(13,148,136,0.2);
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 20px;
            font-size: 13px;
            color: var(--navy);
        }

            .release-notes strong {
                color: var(--teal);
                display: block;
                margin-bottom: 4px;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

        /* RESULTS TABLE */
        .results-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

            .results-table th {
                text-align: left;
                padding: 10px 14px;
                font-size: 11px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: var(--muted);
                border-bottom: 1px solid var(--border);
            }

            .results-table td {
                padding: 12px 14px;
                border-bottom: 1px solid var(--border);
                vertical-align: middle;
            }

            .results-table tr:last-child td {
                border-bottom: none;
            }

            .results-table tr.abnormal td {
                background: #fef9f9;
            }

            .results-table tr:hover td {
                background: var(--offwhite);
            }

        .abnormal-flag {
            display: flex;
            align-items: center;
            gap: 5px;
            color: var(--red);
            font-weight: 600;
        }

            .abnormal-flag svg {
                width: 13px;
                height: 13px;
            }

        .normal-range {
            font-size: 11px;
            color: var(--muted);
        }

        .pending-result {
            color: var(--muted);
            font-style: italic;
            font-size: 12px;
        }

        .empty-state {
            text-align: center;
            padding: 60px 24px;
            color: var(--muted);
        }

            .empty-state svg {
                width: 48px;
                height: 48px;
                margin: 0 auto 16px;
                display: block;
                opacity: 0.3;
            }

            .empty-state h3 {
                font-family: 'DM Serif Display', serif;
                font-size: 1.2rem;
                color: var(--navy);
                margin-bottom: 8px;
            }

            .empty-state p {
                font-size: 13.5px;
            }

        .filter-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .filter-select {
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            padding: 8px 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--navy);
            outline: none;
            background: white;
        }

            .filter-select:focus {
                border-color: var(--teal);
            }

        .search-input {
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            padding: 8px 14px;
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--navy);
            outline: none;
            flex: 1;
            min-width: 200px;
        }

            .search-input:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(13,148,136,0.1);
            }
    </style>
</head>
<body>

    <div class="topbar">
        <a class="brand" asp-controller="PatientDashboard" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">NMB-HLabSys <span>Haematology Lab System</span></div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "P")</div>
                <span class="user-email">@ViewBag.Email</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">
        <aside class="sidebar">
            <div style="margin-bottom:8px">
                <div class="nav-label">Main</div>
                <a class="nav-item" asp-controller="PatientDashboard" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                    Dashboard
                </a>
                <a class="nav-item active" asp-controller="PatientDashboard" asp-action="MyResults">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                    My Results
                </a>
                <a class="nav-item" asp-controller="PatientDashboard" asp-action="MedicalHistory">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                    Medical History
                </a>
                <a class="nav-item" asp-controller="PatientDashboard" asp-action="Consent">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    Consent
                </a>
                <a class="nav-item" asp-controller="PatientDashboard" asp-action="Profile">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    Profile
                </a>
            </div>
        </aside>

        <main class="main">
            <div class="page-label">Patient Portal</div>
            <h1 class="page-title">My Test Results</h1>
            <p class="page-sub">View your haematology test requests and results.</p>

            <div class="filter-bar">
                <input class="search-input" type="text" id="searchInput" placeholder="Search by request number or doctor..." onkeyup="filterRequests()" />
                <select class="filter-select" id="statusFilter" onchange="filterRequests()">
                    <option value="">All statuses</option>
                    <option value="Submitted">Submitted</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Completed">Completed</option>
                    <option value="Released">Released</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <select class="filter-select" id="urgencyFilter" onchange="filterRequests()">
                    <option value="">All urgency</option>
                    <option value="Routine">Routine</option>
                    <option value="Urgent">Urgent</option>
                    <option value="Stat">Stat</option>
                </select>
            </div>

            @if (!requests.Any())
            {
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    <h3>No test requests yet</h3>
                    <p>Your test requests and results will appear here once your doctor submits them.</p>
                </div>
            }
            else
            {
                <div id="requestsList">
                    @foreach (var req in requests)
                    {
                        var badgeClass = req.RequestStatus switch
                        {
                            "Submitted" => "badge-submitted",
                            "In Progress" => "badge-progress",
                            "Completed" => "badge-completed",
                            "Released" => "badge-released",
                            "Cancelled" => "badge-cancelled",
                            _ => "badge-submitted"
                        };
                        var urgencyClass = req.Urgency?.ToLower() switch
                        {
                            "urgent" => "badge-urgent",
                            "stat" => "badge-stat",
                            _ => "badge-routine"
                        };
                        var abnormalCount = req.Items.Count(i => i.IsAbnormal);

                        <div class="request-card" data-status="@req.RequestStatus" data-urgency="@req.Urgency" data-search="@req.RequestNumber @req.DoctorName">
                            <div class="request-header" onclick="toggleRequest(this)">
                                <div class="request-header-left">
                                    <div class="request-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                                    </div>
                                    <div>
                                        <div class="request-number">@req.RequestNumber</div>
                                        <div class="request-meta">
                                            Dr. @req.DoctorName · @req.RequestDate.ToString("dd MMM yyyy")
                                            · @req.Items.Count test@(req.Items.Count != 1 ? "s" : "")
                                            @if (abnormalCount > 0)
                                            {
                                                <span style="color:var(--red);font-weight:600;margin-left:8px">⚠ @abnormalCount abnormal</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="request-header-right">
                                    <span class="badge @urgencyClass">@req.Urgency</span>
                                    <span class="badge @badgeClass">@req.RequestStatus</span>
                                    <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9" /></svg>
                                </div>
                            </div>

                            <div class="request-body">
                                @if (!string.IsNullOrEmpty(req.ClinicalNotes))
                                {
                                    <div class="clinical-notes">
                                        <strong>Clinical Notes</strong>
                                        @req.ClinicalNotes
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(req.ReleaseNotes))
                                {
                                    <div class="release-notes">
                                        <strong>Doctor's Note</strong>
                                        @req.ReleaseNotes
                                    </div>
                                }

                                @if (!req.Items.Any())
                                {
                                    <p class="pending-result">No test items found for this request.</p>
                                }
                                else
                                {
                                    <table class="results-table">
                                        <thead>
                                            <tr>
                                                <th>Test</th>
                                                <th>Category</th>
                                                <th>Result</th>
                                                <th>Normal Range</th>
                                                <th>Status</th>
                                                <th>Completed</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in req.Items)
                                            {
                                                <tr class="@(item.IsAbnormal ? "abnormal" : "")">
                                                    <td><strong>@item.TestName</strong></td>
                                                    <td>@item.CategoryName</td>
                                                    <td>
                                                        @if (item.ResultValue.HasValue)
                                                        {
                                                            if (item.IsAbnormal)
                                                            {
                                                                <div class="abnormal-flag">
                                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                                                                    @item.ResultValue @item.UnitName
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span>@item.ResultValue @item.UnitName</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span class="pending-result">Pending</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (item.NormalRangeMin.HasValue && item.NormalRangeMax.HasValue)
                                                        {
                                                            <span class="normal-range">@item.NormalRangeMin – @item.NormalRangeMax @item.UnitName</span>
                                                        }
                                                        else
                                                        {

                                                            <span class="normal-range">—</span>
                                                        }
                                                </td>
                                                <td>
                                                    <span class="badge @(item.IsAbnormal ? "badge-abnormal" : item.ItemStatus == "Verified" ? "badge-normal" : "badge-submitted")">
                                                        @(item.IsAbnormal ? "Abnormal" : item.ItemStatus)
                                                    </span>
                                                </td>
                                                <td>
                                                    @(item.CompletionDateTime.HasValue
                                                                                            ? item.CompletionDateTime.Value.ToString("dd MMM yyyy HH:mm")
                                                                                            : "—")
                                    </td>
                                </tr>
                                                                }
                                        </tbody>
                                    </table>

                                    @if (!string.IsNullOrEmpty(req.Items.FirstOrDefault()?.ResultNotes))
                                    {
                                        <div class="clinical-notes" style="margin-top:16px">
                                            <strong>Result Notes</strong>
                                            @req.Items.FirstOrDefault()?.ResultNotes
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>

    <script>
        function toggleRequest(header) {
            const body = header.nextElementSibling;
            const chevron = header.querySelector('.chevron');
            body.classList.toggle('open');
            chevron.classList.toggle('open');
        }

        function filterRequests() {
            const search   = document.getElementById('searchInput').value.toLowerCase();
            const status   = document.getElementById('statusFilter').value.toLowerCase();
            const urgency  = document.getElementById('urgencyFilter').value.toLowerCase();

            document.querySelectorAll('.request-card').forEach(card => {
                const cardSearch  = card.dataset.search.toLowerCase();
                const cardStatus  = card.dataset.status.toLowerCase();
                const cardUrgency = card.dataset.urgency.toLowerCase();

                const matchSearch  = cardSearch.includes(search);
                const matchStatus  = status === '' || cardStatus.includes(status);
                const matchUrgency = urgency === '' || cardUrgency === urgency;

                card.style.display = matchSearch && matchStatus && matchUrgency ? '' : 'none';
            });
        }
    </script>

</body>
</html>