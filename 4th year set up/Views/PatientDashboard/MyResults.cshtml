@using Patient.Models
@{
    ViewData["Title"] = "My Results";
    Layout = null;
    var requests = ViewData["Requests"] as List<TestRequest> ?? new();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Results — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --teal: #0d9488;
            --teal-light: rgba(13,148,136,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
            --red: #dc2626;
            --green: #16a34a;
            --amber: #d97706;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
        }

        /* TOPBAR */
        .topbar {
            background: var(--navy);
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-logo {
            width: 34px;
            height: 34px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .brand-logo svg {
                width: 18px;
                height: 18px;
                fill: white;
            }

        .brand-name {
            font-family: 'DM Serif Display', serif;
            color: white;
            font-size: 1.1rem;
            line-height: 1.1;
        }

            .brand-name span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.6rem;
                font-weight: 300;
                color: rgba(255,255,255,0.4);
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 6px 14px 6px 8px;
        }

        .user-avatar {
            width: 28px;
            height: 28px;
            background: var(--teal);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
        }


        .logout-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.8);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .logout-btn:hover {
                background: rgba(255,255,255,0.15);
                color: white;
            }

            .logout-btn svg {
                width: 14px;
                height: 14px;
            }

        /* LAYOUT */
        .page {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        /* SIDEBAR */
        .sidebar {
            width: 220px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 24px 0;
            flex-shrink: 0;
            position: sticky;
            top: 64px;
            height: calc(100vh - 64px);
            overflow-y: auto;
        }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 20px;
            margin-bottom: 4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.15s;
            border-left: 3px solid transparent;
        }

            .nav-item:hover {
                background: var(--offwhite);
                color: var(--navy);
            }

            .nav-item.active {
                background: var(--teal-light);
                color: var(--teal);
                border-left-color: var(--teal);
            }

            .nav-item svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        /* MAIN */
        .main {
            flex: 1;
            padding: clamp(24px, 3vw, 40px);
            overflow-y: auto;
        }

        .page-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--teal);
            margin-bottom: 6px;
        }

        .page-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.8rem;
            color: var(--navy);
            margin-bottom: 4px;
        }

        .page-sub {
            font-size: 13.5px;
            color: var(--muted);
            margin-bottom: 28px;
        }

        /* BADGES */
        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 100px;
            font-size: 11px;
            font-weight: 600;
        }

        .badge-submitted {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .badge-progress {
            background: #fef3c7;
            color: var(--amber);
        }

        .badge-completed {
            background: #dcfce7;
            color: var(--green);
        }

        .badge-released {
            background: rgba(13,148,136,0.1);
            color: var(--teal);
        }

        .badge-cancelled {
            background: #fef2f2;
            color: var(--red);
        }

        .badge-abnormal {
            background: #fef2f2;
            color: var(--red);
        }

        .badge-normal {
            background: #dcfce7;
            color: var(--green);
        }

        .badge-urgent {
            background: #fef2f2;
            color: var(--red);
        }

        .badge-routine {
            background: #f3f4f6;
            color: #374151;
        }

        .badge-stat {
            background: #fdf2f8;
            color: #9333ea;
        }

        /* STATS ROW */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 14px;
            margin-bottom: 28px;
            opacity: 0;
            transform: translateY(10px);
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

            .stats-row.visible {
                opacity: 1;
                transform: translateY(0);
            }

        .stat-pill {
            background: white;
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 18px 20px;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
        }

        .stat-pill-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
        }

            .stat-pill-icon svg {
                width: 15px;
                height: 15px;
            }

        .stat-pill-value {
            font-family: 'DM Serif Display', serif;
            font-size: 1.5rem;
            color: var(--navy);
            line-height: 1;
            margin-bottom: 3px;
        }

        .stat-pill-label {
            font-size: 0.75rem;
            color: var(--muted);
        }

        /* FILTER BAR */
        .filter-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

        .filter-select {
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            padding: 8px 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--navy);
            outline: none;
            background: white;
            cursor: pointer;
        }

            .filter-select:focus {
                border-color: var(--teal);
            }

        .search-wrap {
            flex: 1;
            min-width: 200px;
            position: relative;
        }

            .search-wrap svg {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                width: 15px;
                height: 15px;
                stroke: var(--muted);
                pointer-events: none;
            }

        .search-input {
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            padding: 8px 34px;
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--navy);
            outline: none;
            width: 100%;
        }

            .search-input:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(13,148,136,0.1);
            }

        .search-clear {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            padding: 2px;
            display: none;
            color: var(--muted);
            font-size: 16px;
            line-height: 1;
        }

        .expand-all-btn {
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            padding: 8px 14px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: white;
            color: var(--navy);
            cursor: pointer;
            font-weight: 500;
            white-space: nowrap;
            transition: all 0.15s;
        }

            .expand-all-btn:hover {
                background: var(--offwhite);
                border-color: var(--teal);
                color: var(--teal);
            }

        /* RESULTS META */
        .results-meta-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 13px;
            color: var(--muted);
        }

        .results-count {
            font-weight: 600;
            color: var(--navy);
        }

        .no-filter-results {
            display: none;
            text-align: center;
            padding: 48px 24px;
            color: var(--muted);
            font-size: 0.88rem;
        }

        /* REQUEST CARDS */
        .request-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            margin-bottom: 16px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
            transition: box-shadow 0.2s, opacity 0.3s ease, transform 0.3s ease;
            opacity: 0;
            transform: translateY(8px);
        }

            .request-card.visible {
                opacity: 1;
                transform: translateY(0);
            }

            .request-card:hover {
                box-shadow: 0 4px 16px rgba(11,31,58,0.08);
            }

        .request-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 24px;
            cursor: pointer;
            transition: background 0.15s;
            user-select: none;
        }

            .request-header:hover {
                background: var(--offwhite);
            }

        .request-header-left {
            display: flex;
            align-items: center;
            gap: 16px;
            flex: 1;
            min-width: 0;
        }

        .request-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--teal-light);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .request-icon svg {
                width: 18px;
                height: 18px;
                stroke: var(--teal);
            }

        .request-number {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--navy);
        }

        .request-meta {
            font-size: 0.78rem;
            color: var(--muted);
            margin-top: 3px;
        }

        .request-header-right {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .chevron {
            width: 18px;
            height: 18px;
            stroke: var(--muted);
            transition: transform 0.25s ease;
            flex-shrink: 0;
        }

            .chevron.open {
                transform: rotate(180deg);
            }

        /* PROGRESS BAR */
        .progress-wrap {
            padding: 0 24px 16px;
        }

        .progress-label {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            color: var(--muted);
            margin-bottom: 6px;
            font-weight: 500;
        }

            .progress-label span:last-child {
                font-weight: 600;
            }

        .progress-track {
            height: 6px;
            background: var(--border);
            border-radius: 3px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            border-radius: 3px;
            transition: width 1s ease;
            width: 0;
        }

        /* REQUEST BODY */
        .request-body {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.35s ease;
            border-top: 0px solid var(--border);
        }

            .request-body.open {
                max-height: 3000px;
                border-top-width: 1px;
            }

        .request-body-inner {
            padding: 20px 24px;
        }

        .clinical-notes {
            background: var(--offwhite);
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 20px;
            font-size: 13px;
            color: var(--muted);
        }

            .clinical-notes strong {
                color: var(--navy);
                display: block;
                margin-bottom: 4px;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

        .release-notes {
            background: rgba(13,148,136,0.06);
            border: 1px solid rgba(13,148,136,0.2);
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 20px;
            font-size: 13px;
            color: var(--navy);
        }

            .release-notes strong {
                color: var(--teal);
                display: block;
                margin-bottom: 4px;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

        /* TABLE */
        .results-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

            .results-table th {
                text-align: left;
                padding: 10px 14px;
                font-size: 11px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: var(--muted);
                border-bottom: 1px solid var(--border);
            }

            .results-table td {
                padding: 12px 14px;
                border-bottom: 1px solid var(--border);
                vertical-align: middle;
            }

            .results-table tr:last-child td {
                border-bottom: none;
            }

            .results-table tr.abnormal td {
                background: #fef9f9;
            }

            .results-table tr:hover td {
                background: var(--offwhite);
                cursor: pointer;
            }

        .abnormal-flag {
            display: flex;
            align-items: center;
            gap: 5px;
            color: var(--red);
            font-weight: 600;
        }

            .abnormal-flag svg {
                width: 13px;
                height: 13px;
            }

        .normal-range {
            font-size: 11px;
            color: var(--muted);
        }

        .pending-result {
            color: var(--muted);
            font-style: italic;
            font-size: 12px;
        }

        /* RANGE BAR */
        .result-bar-wrap {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 4px;
        }

        .result-bar {
            flex: 1;
            height: 4px;
            background: var(--border);
            border-radius: 2px;
            position: relative;
            max-width: 80px;
        }

        .result-bar-fill {
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            border-radius: 2px;
            width: 100%;
            background: #dcfce7;
        }

        .result-bar-marker {
            position: absolute;
            top: -3px;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            transform: translateX(-50%);
            border: 2px solid white;
        }

        /* INLINE ACTION BUTTONS */
        .card-actions {
            display: flex;
            gap: 8px;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid var(--border);
        }

        .action-btn {
            font-family: 'DM Sans', sans-serif;
            font-size: 12px;
            font-weight: 600;
            padding: 8px 14px;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            transition: all 0.15s;
            border: 1px solid var(--border);
            background: white;
            color: var(--navy);
        }

            .action-btn:hover {
                background: var(--offwhite);
                border-color: var(--teal);
                color: var(--teal);
            }

            .action-btn svg {
                width: 13px;
                height: 13px;
            }

            .action-btn.primary {
                background: var(--teal);
                color: white;
                border-color: var(--teal);
            }

                .action-btn.primary:hover {
                    background: #0b7c72;
                    border-color: #0b7c72;
                    color: white;
                }

        /* EMPTY STATE */
        .empty-state {
            text-align: center;
            padding: 60px 24px;
            color: var(--muted);
        }

            .empty-state svg {
                width: 48px;
                height: 48px;
                margin: 0 auto 16px;
                display: block;
                opacity: 0.3;
            }

            .empty-state h3 {
                font-family: 'DM Serif Display', serif;
                font-size: 1.2rem;
                color: var(--navy);
                margin-bottom: 8px;
            }

            .empty-state p {
                font-size: 13.5px;
            }

        /* QUICK VIEW MODAL */
        .qv-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 200;
            background: rgba(11,31,58,0.5);
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

            .qv-overlay.open {
                display: flex;
            }

        .qv-modal {
            background: white;
            border-radius: 20px;
            width: 100%;
            max-width: 720px;
            max-height: 88vh;
            display: flex;
            flex-direction: column;
            animation: modalIn 0.2s ease;
            overflow: hidden;
        }

        .qv-header {
            padding: 24px 28px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            flex-shrink: 0;
        }

        .qv-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.3rem;
            color: var(--navy);
        }

        .qv-meta {
            font-size: 13px;
            color: var(--muted);
            margin-top: 4px;
        }

        .qv-close {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: background 0.15s;
        }

            .qv-close:hover {
                background: var(--offwhite);
            }

            .qv-close svg {
                width: 14px;
                height: 14px;
                stroke: var(--muted);
            }

        .qv-body {
            overflow-y: auto;
            padding: 24px 28px;
            flex: 1;
        }

        .qv-footer {
            padding: 16px 28px;
            border-top: 1px solid var(--border);
            display: flex;
            gap: 10px;
            flex-shrink: 0;
        }

        /* FULL PAGE VIEW MODAL */
        .fp-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 300;
            background: var(--offwhite);
            overflow-y: auto;
        }

            .fp-overlay.open {
                display: block;
            }

        .fp-topbar {
            background: var(--navy);
            padding: 0 40px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .fp-back {
            color: rgba(255,255,255,0.75);
            font-size: 13px;
            font-weight: 500;
            background: none;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            font-family: 'DM Sans', sans-serif;
            transition: color 0.15s;
        }

            .fp-back:hover {
                color: white;
            }

            .fp-back svg {
                width: 16px;
                height: 16px;
                stroke: currentColor;
            }

        .fp-actions {
            display: flex;
            gap: 10px;
        }

        .fp-body {
            max-width: 860px;
            margin: 0 auto;
            padding: 36px 24px 60px;
        }

        .fp-hero {
            background: var(--navy);
            border-radius: 16px;
            padding: 28px 32px;
            margin-bottom: 28px;
            position: relative;
            overflow: hidden;
        }

            .fp-hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 60% 80% at 90% 50%, rgba(13,148,136,0.2) 0%, transparent 60%);
            }

        .fp-hero-content {
            position: relative;
            z-index: 2;
        }

        .fp-hero h2 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.6rem;
            color: white;
            margin-bottom: 6px;
        }

        .fp-hero p {
            color: rgba(255,255,255,0.5);
            font-size: 13px;
        }

        .fp-badges {
            display: flex;
            gap: 8px;
            margin-top: 14px;
            flex-wrap: wrap;
        }

        .fp-section {
            background: white;
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
        }

        .fp-section-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1rem;
            color: var(--navy);
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }

        /* LOGOUT MODAL */
        .lo-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 999;
            background: rgba(11,31,58,0.45);
            align-items: center;
            justify-content: center;
        }

            .lo-overlay.open {
                display: flex;
            }

        /* TOAST */
        #toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 1000;
            background: var(--navy);
            color: white;
            padding: 12px 18px;
            border-radius: 12px;
            font-size: 0.82rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
            opacity: 0;
            transform: translateY(8px);
            transition: opacity 0.25s, transform 0.25s;
            pointer-events: none;
            max-width: 320px;
        }

       

            .user-email {
                display: none;
            }

            

            .main {
                padding: 20px 16px;
            }

            .fp-topbar {
                padding: 0 20px;
            }

            .fp-body {
                padding: 20px 16px 48px;
            }
        }
    </style>
</head>
<body>

    <div class="topbar">
        <a class="brand" asp-controller="PatientDashboard" asp-action="Index">
            <div class="brand-logo"><svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg></div>
            <div class="brand-name">NMB-HLabSys <span>Haematology Lab System</span></div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "P")</div>
                <span class="user-email">@ViewBag.Email</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn" id="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div style="margin-bottom:8px">
                <div class="nav-label">Main</div>
                <a class="nav-item" asp-controller="PatientDashboard" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                    Dashboard
                </a>
                <a class="nav-item active" asp-controller="PatientDashboard" asp-action="MyResults">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                    My Results
                </a>
                <a class="nav-item" asp-controller="PatientDashboard" asp-action="MedicalHistory">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                    Medical History
                </a>
                <a class="nav-item" asp-controller="PatientDashboard" asp-action="Consent">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    Consent
                </a>
                <a class="nav-item" asp-controller="PatientDashboard" asp-action="Profile">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    Profile
                </a>
            </div>
            <div style="margin-bottom:8px">
                <div class="nav-label">Support</div>
                <a href="#" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                    Help
                </a>
            </div>
        </aside>

        <main class="main">
            <div class="page-label">Patient Portal</div>
            <h1 class="page-title">My Test Results</h1>
            <p class="page-sub">View your haematology test requests and results.</p>

            <!-- STATS -->
            @{
                var totalRequests = requests.Count;
                var totalTests = requests.Sum(r => r.Items.Count);
                var totalAbnormal = requests.Sum(r => r.Items.Count(i => i.IsAbnormal));
                var totalCompleted = requests.Count(r => r.RequestStatus == "Completed" || r.RequestStatus == "Released");
                var totalPending = requests.Count(r => r.RequestStatus == "Submitted" || r.RequestStatus == "In Progress");
                var latestDate = requests.Any() ? requests.Max(r => r.RequestDate) : (DateTime?)null;
            }
            <div class="stats-row" id="statsRow">
                <div class="stat-pill" title="Total test requests on file">
                    <div class="stat-pill-icon" style="background:#dbeafe"><svg viewBox="0 0 24 24" fill="none" stroke="#1d4ed8" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg></div>
                    <div class="stat-pill-value" data-target="@totalRequests">0</div>
                    <div class="stat-pill-label">Total Requests</div>
                </div>
                <div class="stat-pill" title="Individual tests across all requests">
                    <div class="stat-pill-icon" style="background:rgba(13,148,136,0.1)"><svg viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2" stroke-linecap="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18" /></svg></div>
                    <div class="stat-pill-value" data-target="@totalTests">0</div>
                    <div class="stat-pill-label">Tests Run</div>
                </div>
                <div class="stat-pill" title="Results flagged outside normal range">
                    <div class="stat-pill-icon" style="background:#fee2e2"><svg viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg></div>
                    <div class="stat-pill-value" data-target="@totalAbnormal">0</div>
                    <div class="stat-pill-label">Abnormal</div>
                </div>
                <div class="stat-pill" title="Completed or released requests">
                    <div class="stat-pill-icon" style="background:#dcfce7"><svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg></div>
                    <div class="stat-pill-value" data-target="@totalCompleted">0</div>
                    <div class="stat-pill-label">Completed</div>
                </div>
                <div class="stat-pill" title="Requests still awaiting results">
                    <div class="stat-pill-icon" style="background:#fef3c7"><svg viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg></div>
                    <div class="stat-pill-value" data-target="@totalPending">0</div>
                    <div class="stat-pill-label">Pending</div>
                </div>
                <div class="stat-pill" title="Most recent test request date">
                    <div class="stat-pill-icon" style="background:#f3e8ff"><svg viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg></div>
                    <div class="stat-pill-value" style="font-size:1rem;font-family:'DM Sans',sans-serif;font-weight:600;">@(latestDate.HasValue? latestDate.Value.ToString("dd MMM") : "—")</div>
                    <div class="stat-pill-label">Latest Request</div>
                </div>
            </div>

            <!-- FILTER BAR -->
            <div class="filter-bar">
                <div class="search-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                    <input class="search-input" type="text" id="searchInput" placeholder="Search by request number or doctor…" autocomplete="off" />
                    <button class="search-clear" id="searchClear" aria-label="Clear search">×</button>
                </div>
                <select class="filter-select" id="statusFilter">
                    <option value="">All statuses</option>
                    <option value="Submitted">Submitted</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Completed">Completed</option>
                    <option value="Released">Released</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <select class="filter-select" id="urgencyFilter">
                    <option value="">All urgency</option>
                    <option value="Routine">Routine</option>
                    <option value="Urgent">Urgent</option>
                    <option value="Stat">Stat</option>
                </select>
                <select class="filter-select" id="sortSelect">
                    <option value="date-desc">Newest first</option>
                    <option value="date-asc">Oldest first</option>
                    <option value="abnormal">Abnormal first</option>
                    <option value="status">By status</option>
                </select>
                <button class="expand-all-btn" id="expandAllBtn">Expand all</button>
            </div>

            <div class="results-meta-bar">
                <span id="resultsCount" class="results-count">@totalRequests request@(totalRequests != 1 ? "s" : "")</span>
                <span id="activeFiltersNote" style="display:none;color:var(--teal);font-weight:500;font-size:12px;">Filters active — <a href="#" id="clearFilters" style="color:var(--teal);">Clear all</a></span>
            </div>

            @if (!requests.Any())
            {
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    <h3>No test requests yet</h3>
                    <p>Your test requests and results will appear here once your doctor submits them.</p>
                </div>
            }
            else
            {
                <div id="requestsList">
                    @foreach (var req in requests)
                    {
                        var badgeClass = req.RequestStatus switch
                        {
                                    "Submitted" => "badge-submitted",
                                    "In Progress" => "badge-progress",
                                    "Completed" => "badge-completed",
                                    "Released" => "badge-released",
                                    "Cancelled" => "badge-cancelled",
                            _ => "badge-submitted"
                        };
                        var urgencyClass = req.Urgency?.ToLower() switch
                        {
                                    "urgent" => "badge-urgent",
                                    "stat" => "badge-stat",
                            _ => "badge-routine"
                        };
                        var abnormalCount = req.Items.Count(i => i.IsAbnormal);
                        var completedItems = req.Items.Count(i => i.CompletionDateTime.HasValue || i.ItemStatus == "Verified" || i.ItemStatus == "Completed");
                        var totalItems = req.Items.Count;
                        var pctComplete = totalItems > 0 ? (int)Math.Round((double)completedItems / totalItems * 100) : 0;
                        var isCompleted = req.RequestStatus == "Completed" || req.RequestStatus == "Released";
                        var progressColor = isCompleted ? "#16a34a" : pctComplete > 50 ? "#0d9488" : "#d97706";

                        <div class="request-card"
                             data-status="@req.RequestStatus"
                             data-urgency="@req.Urgency"
                             data-search="@req.RequestNumber @req.DoctorName"
                             data-date="@req.RequestDate.ToString("yyyy-MM-dd")"
                             data-abnormal="@(abnormalCount > 0 ? "1" : "0")"
                             data-id="@req.RequestID"
                             data-reqnum="@req.RequestNumber"
                             data-doctor="@req.DoctorName"
                             data-reqdate="@req.RequestDate.ToString("o")"
                             data-items="@totalItems"
                             data-pct="@pctComplete">

                            <div class="request-header" role="button" tabindex="0"
                                 aria-expanded="false" aria-label="Toggle @req.RequestNumber">
                                <div class="request-header-left">
                                    <div class="request-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                                    </div>
                                    <div>
                                        <div class="request-number">@req.RequestNumber</div>
                                        <div class="request-meta">
                                            Dr. @req.DoctorName
                                            · <span class="req-date" data-iso="@req.RequestDate.ToString("o")">@req.RequestDate.ToString("dd MMM yyyy")</span>
                                            · @totalItems test@(totalItems != 1 ? "s" : "")
                                            @if (abnormalCount > 0)
                                            {
                                                <span style="color:var(--red);font-weight:600;margin-left:8px">⚠ @abnormalCount abnormal</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="request-header-right">
                                    <span class="badge @urgencyClass">@req.Urgency</span>
                                    <span class="badge @badgeClass">@req.RequestStatus</span>
                                    <!-- Quick View button -->
                                    <button class="quick-view-btn" title="Quick view"
                                            style="display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:8px;background:#f3e8ff;color:#7c3aed;border:1px solid rgba(124,58,237,0.2);cursor:pointer;transition:background 0.15s;flex-shrink:0;"
                                            aria-label="Quick view @req.RequestNumber">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                    </button>
                                    <!-- Download PDF -->
                                    <a href="/PatientDashboard/PrintResult?requestId=@req.RequestID"
                                       target="_blank" class="download-btn" title="Download PDF"
                                       aria-label="Download PDF for @req.RequestNumber"
                                       style="display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:8px;background:var(--teal-light);color:var(--teal);border:1px solid rgba(13,148,136,0.2);text-decoration:none;transition:background 0.15s;flex-shrink:0;">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                                    </a>
                                    <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9" /></svg>
                                </div>
                            </div>

                            <!-- PROGRESS BAR -->
                            <div class="progress-wrap">
                                <div class="progress-label">
                                    <span>Test completion</span>
                                    <span id="pct-@req.RequestID">@pctComplete%</span>
                                </div>
                                <div class="progress-track">
                                    <div class="progress-fill" id="bar-@req.RequestID"
                                         style="background:@progressColor; width:0%;"
                                         data-width="@pctComplete%"></div>
                                </div>
                            </div>

                            <!-- EXPANDABLE BODY -->
                            <div class="request-body">
                                <div class="request-body-inner">
                                    @if (!string.IsNullOrEmpty(req.ClinicalNotes))
                                    {
                                        <div class="clinical-notes"><strong>Clinical Notes</strong>@req.ClinicalNotes</div>
                                    }
                                    @if (!string.IsNullOrEmpty(req.ReleaseNotes))
                                    {
                                        <div class="release-notes"><strong>Doctor's Note</strong>@req.ReleaseNotes</div>
                                    }

                                    @if (!req.Items.Any())
                                    {
                                        <p class="pending-result">No test items found for this request.</p>
                                    }
                                    else
                                    {
                                        <table class="results-table">
                                            <thead>
                                                <tr>
                                                    <th>Test</th>
                                                    <th>Category</th>
                                                    <th>Result</th>
                                                    <th>Normal Range</th>
                                                    <th>Status</th>
                                                    <th>Completed</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in req.Items)
                                                {
                                                    <tr class="@(item.IsAbnormal ? "abnormal" : "")">
                                                        <td><strong>@item.TestName</strong></td>
                                                        <td>@item.CategoryName</td>
                                                        <td>
                                                            @if (item.ResultValue.HasValue)
                                                            {
                                                                if (item.IsAbnormal)
                                                                {
                                                                    <div class="abnormal-flag">
                                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                                                                        @item.ResultValue @item.UnitName
                                                                    </div>
                                                                }
                                                                else if (item.NormalRangeMin.HasValue && item.NormalRangeMax.HasValue)
                                                                {
                                                                    var p = Math.Min(100, Math.Max(0, (double)((item.ResultValue.Value - item.NormalRangeMin.Value) / (item.NormalRangeMax.Value - item.NormalRangeMin.Value) * 100)));
                                                                    <span>@item.ResultValue @item.UnitName</span>
                                                                    <div class="result-bar-wrap">
                                                                        <div class="result-bar">
                                                                            <div class="result-bar-fill"></div>
                                                                            <div class="result-bar-marker" style="left:@(p.ToString("F1"))%;background:#16a34a;"></div>
                                                                        </div>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <span>@item.ResultValue @item.UnitName</span>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span class="pending-result">Pending</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (item.NormalRangeMin.HasValue && item.NormalRangeMax.HasValue)
                                                            {
                                                                <span class="normal-range">@item.NormalRangeMin – @item.NormalRangeMax @item.UnitName</span>
                                                            }
                                                            else
                                                            {

                                                                <span class="normal-range">—</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <span class="badge @(item.IsAbnormal ? "badge-abnormal" : item.ItemStatus == "Verified" ? "badge-normal" : "badge-submitted")">
                                                                @(item.IsAbnormal ? "Abnormal" : item.ItemStatus)
                                                            </span>
                                                        </td>
                                                        <td>@(item.CompletionDateTime.HasValue? item.CompletionDateTime.Value.ToString("dd MMM yyyy HH:mm") : "—")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        @if (!string.IsNullOrEmpty(req.Items.FirstOrDefault()?.ResultNotes))
                                        {
                                            <div class="clinical-notes" style="margin-top:16px"><strong>Result Notes</strong>@req.Items.FirstOrDefault()?.ResultNotes</div>
                                        }
                                    }

                                    <div class="card-actions">
                                        <button class="action-btn quick-view-inline-btn">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                            Quick View
                                        </button>
                                        <button class="action-btn full-page-inline-btn">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
                                            Full Page View
                                        </button>
                                        <a href="/PatientDashboard/PrintResult?requestId=@req.RequestID" target="_blank" class="action-btn primary">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                                            Download PDF
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="no-filter-results" id="noFilterResults">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin:0 auto 12px;display:block;opacity:0.3"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                    No results match your filters. <a href="#" id="clearFilters2" style="color:var(--teal);">Clear filters</a>
                </div>
            }
        </main>
    </div>

    <!-- QUICK VIEW MODAL -->
    <div class="qv-overlay" id="qvOverlay" role="dialog" aria-modal="true" aria-labelledby="qv-title">
        <div class="qv-modal">
            <div class="qv-header">
                <div>
                    <div class="qv-title" id="qv-title">Request</div>
                    <div class="qv-meta" id="qv-meta"></div>
                </div>
                <button class="qv-close" id="qvClose" aria-label="Close quick view">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                </button>
            </div>
            <div class="qv-body" id="qv-body"></div>
            <div class="qv-footer">
                <button class="action-btn" id="qvToFullPage">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
                    Full Page View
                </button>
                <a id="qv-pdf-link" href="#" target="_blank" class="action-btn primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                    Download PDF
                </a>
                <button class="action-btn" id="qvClose2" style="margin-left:auto;">Close</button>
            </div>
        </div>
    </div>

    <!-- FULL PAGE VIEW OVERLAY -->
    <div class="fp-overlay" id="fpOverlay" role="dialog" aria-modal="true" aria-labelledby="fp-title">
        <div class="fp-topbar">
            <button class="fp-back" id="fpBack">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><polyline points="15 18 9 12 15 6" /></svg>
                Back to My Results
            </button>
            <div class="fp-actions">
                <a id="fp-pdf-link" href="#" target="_blank" class="action-btn primary" style="font-size:12px;padding:7px 14px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                    Download PDF
                </a>
            </div>
        </div>
        <div class="fp-body" id="fp-body"></div>
    </div>

    <!-- LOGOUT MODAL -->
    <div class="lo-overlay" id="logout-modal" role="dialog" aria-modal="true" aria-labelledby="lo-title">
        <div style="background:white;border-radius:20px;padding:32px 28px;max-width:380px;width:90%;animation:modalIn 0.18s ease;">
            <div style="width:52px;height:52px;background:#fee2e2;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
            </div>
            <h3 id="lo-title" style="font-family:'DM Serif Display',serif;font-size:1.2rem;color:var(--navy);margin-bottom:8px;">Sign out?</h3>
            <p style="font-size:0.85rem;color:var(--muted);margin-bottom:24px;line-height:1.6;">You'll be returned to the login screen.</p>
            <div style="display:flex;gap:10px;">
                <button id="logout-cancel" style="flex:1;padding:10px;border:1px solid var(--border);border-radius:10px;background:white;color:var(--navy);font-size:0.85rem;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;">Cancel</button>
                <a id="logout-confirm" href="#" style="flex:1;padding:10px;border:none;border-radius:10px;background:#dc2626;color:white;font-size:0.85rem;font-weight:600;cursor:pointer;text-align:center;text-decoration:none;font-family:'DM Sans',sans-serif;">Sign Out</a>
            </div>
        </div>
    </div>

    <!-- TOAST -->
    <div id="toast" role="status" aria-live="polite">
        <span id="toast-icon"></span><span id="toast-msg"></span>
    </div>

    <script>
        (function () {
            'use strict';

            /* ─── TOAST ─── */
            var toast = document.getElementById('toast');
            var toastMsg = document.getElementById('toast-msg');
            var toastIco = document.getElementById('toast-icon');
            var toastTimer;
            function showToast(msg, type) {
                type = type || 'info';
                var icons = { success:'✓', warning:'⚠', error:'✕', info:'ℹ' };
                toastMsg.textContent = msg;
                toastIco.textContent = icons[type] || 'ℹ';
                toast.style.opacity = '1';
                toast.style.transform = 'translateY(0)';
                clearTimeout(toastTimer);
                toastTimer = setTimeout(function() {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(8px)';
                }, 3200);
            }
            window.showToast = showToast;

            /* ─── STAGGERED CARD ANIMATIONS ─── */
            var cards = document.querySelectorAll('.request-card');
            cards.forEach(function(card, i) {
                card.style.transitionDelay = (i * 55) + 'ms';
                requestAnimationFrame(function() {
                    requestAnimationFrame(function() { card.classList.add('visible'); });
                });
            });

            var statsRow = document.getElementById('statsRow');
            if (statsRow) requestAnimationFrame(function() { requestAnimationFrame(function() { statsRow.classList.add('visible'); }); });

            /* ─── ANIMATED STAT COUNTERS ─── */
            function animateCounter(el, target, duration) {
                var start = null;
                function step(ts) {
                    if (!start) start = ts;
                    var p = Math.min((ts - start) / duration, 1);
                    var eased = 1 - Math.pow(1 - p, 3);
                    el.textContent = Math.round(target * eased);
                    if (p < 1) requestAnimationFrame(step);
                    else el.textContent = target;
                }
                requestAnimationFrame(step);
            }
            document.querySelectorAll('.stat-pill-value[data-target]').forEach(function(el) {
                animateCounter(el, parseInt(el.getAttribute('data-target'), 10) || 0, 800);
            });

            /* ─── PROGRESS BARS ─── */
            setTimeout(function() {
                document.querySelectorAll('.progress-fill[data-width]').forEach(function(bar) {
                    bar.style.width = bar.getAttribute('data-width');
                });
            }, 300);

            /* ─── ACCORDION ─── */
            function toggleCard(header) {
                var card  = header.closest('.request-card');
                var body  = card.querySelector('.request-body');
                var chev  = header.querySelector('.chevron');
                var isOpen = body.classList.contains('open');
                body.classList.toggle('open', !isOpen);
                chev.classList.toggle('open', !isOpen);
                header.setAttribute('aria-expanded', String(!isOpen));
            }

            document.querySelectorAll('.request-header').forEach(function(header) {
                header.addEventListener('click', function(e) {
                    if (e.target.closest('.quick-view-btn') || e.target.closest('.download-btn')) return;
                    toggleCard(header);
                });
                header.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleCard(header); }
                });
            });

            /* ─── EXPAND ALL ─── */
            var expandAllBtn = document.getElementById('expandAllBtn');
            var allExpanded  = false;
            if (expandAllBtn) {
                expandAllBtn.addEventListener('click', function() {
                    allExpanded = !allExpanded;
                    document.querySelectorAll('.request-card:not([style*="none"]) .request-header').forEach(function(h) {
                        var body = h.closest('.request-card').querySelector('.request-body');
                        var chev = h.querySelector('.chevron');
                        body.classList.toggle('open', allExpanded);
                        chev.classList.toggle('open', allExpanded);
                        h.setAttribute('aria-expanded', String(allExpanded));
                    });
                    expandAllBtn.textContent = allExpanded ? 'Collapse all' : 'Expand all';
                });
            }

            /* ─── AUTO-OPEN ABNORMAL ─── */
            document.querySelectorAll('.request-card[data-abnormal="1"]').forEach(function(card) {
                var header = card.querySelector('.request-header');
                var body   = card.querySelector('.request-body');
                var chev   = card.querySelector('.chevron');
                if (body && chev && header) {
                    body.classList.add('open');
                    chev.classList.add('open');
                    header.setAttribute('aria-expanded', 'true');
                }
            });

            /* ─── FILTERING & SORTING ─── */
            var searchInput   = document.getElementById('searchInput');
            var statusFilter  = document.getElementById('statusFilter');
            var urgencyFilter = document.getElementById('urgencyFilter');
            var sortSelect    = document.getElementById('sortSelect');
            var searchClear   = document.getElementById('searchClear');
            var resultsCount  = document.getElementById('resultsCount');
            var activeNote    = document.getElementById('activeFiltersNote');
            var noResults     = document.getElementById('noFilterResults');
            var list          = document.getElementById('requestsList');

            function applyFilters() {
                var search  = searchInput  ? searchInput.value.toLowerCase().trim() : '';
                var status  = statusFilter ? statusFilter.value.toLowerCase()       : '';
                var urgency = urgencyFilter? urgencyFilter.value.toLowerCase()      : '';
                var sort    = sortSelect   ? sortSelect.value                       : 'date-desc';
                var all     = list         ? Array.from(list.querySelectorAll('.request-card')) : [];
                var visible = [];

                all.forEach(function(card) {
                    var ok = (!search  || card.dataset.search.toLowerCase().includes(search))
                          && (!status  || card.dataset.status.toLowerCase()  === status)
                          && (!urgency || card.dataset.urgency.toLowerCase() === urgency);
                    card.style.display = ok ? '' : 'none';
                    if (ok) visible.push(card);
                });

                visible.sort(function(a, b) {
                    if (sort === 'date-asc')  return a.dataset.date.localeCompare(b.dataset.date);
                    if (sort === 'date-desc') return b.dataset.date.localeCompare(a.dataset.date);
                    if (sort === 'abnormal')  return parseInt(b.dataset.abnormal) - parseInt(a.dataset.abnormal);
                    if (sort === 'status')    return (a.dataset.status||'').localeCompare(b.dataset.status||'');
                    return 0;
                });
                if (list) visible.forEach(function(c) { list.appendChild(c); });

                var total = all.length, shown = visible.length;
                if (resultsCount) resultsCount.textContent = shown === total ? total + ' request' + (total !== 1 ? 's' : '') : shown + ' of ' + total + ' request' + (total !== 1 ? 's' : '');
                if (activeNote) activeNote.style.display = (search || status || urgency) ? '' : 'none';
                if (noResults)  noResults.style.display  = shown === 0 ? 'block' : 'none';
                if (searchClear) searchClear.style.display = search ? 'block' : 'none';
            }

            if (searchInput)   searchInput.addEventListener('input', applyFilters);
            if (statusFilter)  statusFilter.addEventListener('change', applyFilters);
            if (urgencyFilter) urgencyFilter.addEventListener('change', applyFilters);
            if (sortSelect)    sortSelect.addEventListener('change', applyFilters);
            if (searchClear)   searchClear.addEventListener('click', function() { searchInput.value=''; applyFilters(); searchInput.focus(); });

            function clearAllFilters() {
                if (searchInput)   searchInput.value  = '';
                if (statusFilter)  statusFilter.value  = '';
                if (urgencyFilter) urgencyFilter.value = '';
                applyFilters();
            }
            var cf1 = document.getElementById('clearFilters');
            var cf2 = document.getElementById('clearFilters2');
            if (cf1) cf1.addEventListener('click', function(e) { e.preventDefault(); clearAllFilters(); });
            if (cf2) cf2.addEventListener('click', function(e) { e.preventDefault(); clearAllFilters(); });

            document.addEventListener('keydown', function(e) {
                if ((e.ctrlKey && e.key === 'f') || (e.key === '/' && document.activeElement.tagName !== 'INPUT' && !fpOverlay.classList.contains('open'))) {
                    e.preventDefault();
                    if (searchInput) { searchInput.focus(); searchInput.select(); }
                }
            });

            /* ─── RELATIVE DATES ─── */
            document.querySelectorAll('.req-date[data-iso]').forEach(function(el) {
                var d = new Date(el.getAttribute('data-iso'));
                if (isNaN(d)) return;
                el.setAttribute('title', d.toLocaleDateString(undefined, { weekday:'long', year:'numeric', month:'long', day:'numeric' }));
                var days = Math.floor((Date.now() - d.getTime()) / 86400000);
                if (days === 0)      el.textContent = 'Today';
                else if (days === 1) el.textContent = 'Yesterday';
                else if (days < 7)   el.textContent = days + ' days ago';
                else                 el.textContent = d.toLocaleDateString(undefined, { day:'numeric', month:'short', year:'numeric' });
            });

            /* ─── DOWNLOAD FEEDBACK ─── */
            document.querySelectorAll('.download-btn, a[href*="PrintResult"]').forEach(function(btn) {
                btn.addEventListener('click', function(e) { e.stopPropagation(); showToast('Preparing PDF report…', 'info'); });
            });

            /* ─── BUILD QUICK VIEW HTML ─── */
            function buildQVContent(card) {
                var reqNum  = card.dataset.reqnum || '';
                var doctor  = card.dataset.doctor || '';
                var reqDate = card.dataset.reqdate ? new Date(card.dataset.reqdate).toLocaleDateString(undefined, { day:'numeric', month:'long', year:'numeric' }) : '';
                var pct     = card.dataset.pct || '0';
                var reqId   = card.dataset.id || '';
                var status  = card.dataset.status || '';
                var urgency = card.dataset.urgency || '';

                // clone the inner table from the accordion body
                var tableEl = card.querySelector('.results-table');
                var tableHTML = tableEl ? tableEl.outerHTML : '<p style="color:var(--muted);font-style:italic;font-size:13px;">No results available yet.</p>';
                var notes    = card.querySelector('.clinical-notes');
                var release  = card.querySelector('.release-notes');
                var notesHTML   = notes   ? notes.outerHTML   : '';
                var releaseHTML = release ? release.outerHTML : '';

                var progressColor = parseInt(pct) === 100 ? '#16a34a' : parseInt(pct) > 50 ? '#0d9488' : '#d97706';

                return '<div style="margin-bottom:20px;">'
                    + '<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">'
                    + '<span style="font-size:12px;font-weight:600;padding:4px 10px;border-radius:100px;background:#dbeafe;color:#1d4ed8;">' + urgency + '</span>'
                    + '<span style="font-size:12px;font-weight:600;padding:4px 10px;border-radius:100px;background:#dcfce7;color:#16a34a;">' + status + '</span>'
                    + '</div>'
                    + '<div style="background:var(--offwhite);border-radius:10px;padding:14px 16px;margin-bottom:16px;font-size:13px;">'
                    + '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">'
                    + '<div><div style="font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:3px;">Doctor</div><div style="font-weight:600;color:var(--navy);">Dr. ' + doctor + '</div></div>'
                    + '<div><div style="font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:3px;">Request Date</div><div style="font-weight:600;color:var(--navy);">' + reqDate + '</div></div>'
                    + '</div></div>'
                    + '<div style="margin-bottom:16px;"><div style="display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-bottom:6px;font-weight:500;"><span>Test completion</span><span style="font-weight:600;color:var(--navy);">' + pct + '%</span></div>'
                    + '<div style="height:6px;background:var(--border);border-radius:3px;overflow:hidden;"><div style="height:100%;border-radius:3px;width:' + pct + '%;background:' + progressColor + ';"></div></div></div>'
                    + '</div>'
                    + notesHTML + releaseHTML
                    + tableHTML;
            }

            /* ─── BUILD FULL PAGE HTML ─── */
            function buildFPContent(card) {
                var reqNum  = card.dataset.reqnum || '';
                var doctor  = card.dataset.doctor || '';
                var reqDate = card.dataset.reqdate ? new Date(card.dataset.reqdate).toLocaleDateString(undefined, { day:'numeric', month:'long', year:'numeric' }) : '';
                var pct     = card.dataset.pct || '0';
                var status  = card.dataset.status || '';
                var urgency = card.dataset.urgency || '';
                var items   = card.dataset.items || '0';

                var tableEl     = card.querySelector('.results-table');
                var tableHTML   = tableEl ? tableEl.outerHTML : '<p style="color:var(--muted);font-style:italic;font-size:13px;">No results available yet.</p>';
                var notes       = card.querySelector('.clinical-notes');
                var release     = card.querySelector('.release-notes');
                var notesHTML   = notes   ? notes.outerHTML   : '';
                var releaseHTML = release ? release.outerHTML : '';
                var progressColor = parseInt(pct) === 100 ? '#16a34a' : parseInt(pct) > 50 ? '#0d9488' : '#d97706';

                var statusBg = status === 'Completed' || status === 'Released' ? '#dcfce7' : status === 'In Progress' ? '#fef3c7' : '#dbeafe';
                var statusCol = status === 'Completed' || status === 'Released' ? '#16a34a' : status === 'In Progress' ? '#d97706' : '#1d4ed8';

                return '<div class="fp-hero"><div class="fp-hero-content">'
                    + '<h2 id="fp-title">' + reqNum + '</h2>'
                    + '<p>Dr. ' + doctor + ' · ' + reqDate + ' · ' + items + ' test' + (parseInt(items) !== 1 ? 's' : '') + '</p>'
                    + '<div class="fp-badges">'
                    + '<span style="font-size:12px;font-weight:600;padding:5px 12px;border-radius:100px;background:rgba(255,255,255,0.12);color:white;">' + urgency + '</span>'
                    + '<span style="font-size:12px;font-weight:600;padding:5px 12px;border-radius:100px;background:' + statusBg + ';color:' + statusCol + ';">' + status + '</span>'
                    + '</div></div></div>'
                    + '<div class="fp-section">'
                    + '<div class="fp-section-title">Test Completion</div>'
                    + '<div style="display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:8px;font-weight:500;"><span>Progress</span><span style="font-weight:700;color:var(--navy);font-size:14px;">' + pct + '%</span></div>'
                    + '<div style="height:8px;background:var(--border);border-radius:4px;overflow:hidden;"><div style="height:100%;border-radius:4px;width:' + pct + '%;background:' + progressColor + ';"></div></div>'
                    + '</div>'
                    + (notesHTML || releaseHTML ? '<div class="fp-section"><div class="fp-section-title">Notes</div>' + notesHTML + releaseHTML + '</div>' : '')
                    + '<div class="fp-section"><div class="fp-section-title">Test Results</div>' + tableHTML + '</div>';
            }

            /* ─── QUICK VIEW MODAL ─── */
            var qvOverlay = document.getElementById('qvOverlay');
            var qvBody    = document.getElementById('qv-body');
            var qvTitle   = document.getElementById('qv-title');
            var qvMeta    = document.getElementById('qv-meta');
            var qvPdfLink = document.getElementById('qv-pdf-link');
            var qvToFP    = document.getElementById('qvToFullPage');
            var activeCard = null;

            function openQV(card) {
                activeCard = card;
                qvTitle.textContent = card.dataset.reqnum || 'Request';
                var d = card.dataset.reqdate ? new Date(card.dataset.reqdate) : null;
                qvMeta.textContent = 'Dr. ' + (card.dataset.doctor || '') + (d ? ' · ' + d.toLocaleDateString(undefined, { day:'numeric', month:'long', year:'numeric' }) : '');
                qvBody.innerHTML = buildQVContent(card);
                qvPdfLink.href = '/PatientDashboard/PrintResult?requestId=' + (card.dataset.id || '');
                qvOverlay.classList.add('open');
                document.body.style.overflow = 'hidden';
            }

            function closeQV() {
                qvOverlay.classList.remove('open');
                document.body.style.overflow = '';
            }

            document.getElementById('qvClose').addEventListener('click', closeQV);
            document.getElementById('qvClose2').addEventListener('click', closeQV);
            qvOverlay.addEventListener('click', function(e) { if (e.target === qvOverlay) closeQV(); });

            if (qvToFP) qvToFP.addEventListener('click', function() {
                closeQV();
                if (activeCard) openFP(activeCard);
            });

            /* ─── FULL PAGE VIEW ─── */
            var fpOverlay = document.getElementById('fpOverlay');
            var fpBody    = document.getElementById('fp-body');
            var fpPdfLink = document.getElementById('fp-pdf-link');

            function openFP(card) {
                activeCard = card;
                fpBody.innerHTML = buildFPContent(card);
                fpPdfLink.href = '/PatientDashboard/PrintResult?requestId=' + (card.dataset.id || '');
                fpOverlay.classList.add('open');
                fpOverlay.scrollTop = 0;
                document.body.style.overflow = 'hidden';
            }

            function closeFP() {
                fpOverlay.classList.remove('open');
                document.body.style.overflow = '';
            }

            document.getElementById('fpBack').addEventListener('click', closeFP);

            /* ─── WIRE UP ALL VIEW BUTTONS ─── */
            document.querySelectorAll('.request-card').forEach(function(card) {
                // header quick-view button
                var qvBtn = card.querySelector('.quick-view-btn');
                if (qvBtn) qvBtn.addEventListener('click', function(e) { e.stopPropagation(); openQV(card); });

                // inline quick view button (inside expanded body)
                var qvInline = card.querySelector('.quick-view-inline-btn');
                if (qvInline) qvInline.addEventListener('click', function() { openQV(card); });

                // inline full page button
                var fpInline = card.querySelector('.full-page-inline-btn');
                if (fpInline) fpInline.addEventListener('click', function() { openFP(card); });
            });

            /* ─── ESCAPE KEY ─── */
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    if (fpOverlay.classList.contains('open')) { closeFP(); return; }
                    if (qvOverlay.classList.contains('open')) { closeQV(); return; }
                    var lo = document.getElementById('logout-modal');
                    if (lo && lo.classList.contains('open')) { lo.classList.remove('open'); lo.style.display = ''; }
                }
            });

            /* ─── LOGOUT MODAL ─── */
            var logoutBtn    = document.getElementById('logout-btn');
            var logoutModal  = document.getElementById('logout-modal');
            var logoutCancel = document.getElementById('logout-cancel');
            var logoutConfirm= document.getElementById('logout-confirm');
            if (logoutBtn && logoutModal) {
                logoutConfirm.href = logoutBtn.href;
                logoutBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    logoutModal.classList.add('open');
                    logoutModal.style.display = 'flex';
                    if (logoutCancel) logoutCancel.focus();
                });
                function closeLogout() { logoutModal.classList.remove('open'); logoutModal.style.display = ''; }
                if (logoutCancel) logoutCancel.addEventListener('click', closeLogout);
                logoutModal.addEventListener('click', function(e) { if (e.target === logoutModal) closeLogout(); });
            }

        })();
    </script>
</body>
</html>