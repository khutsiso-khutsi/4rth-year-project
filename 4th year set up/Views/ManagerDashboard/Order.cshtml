@* @model IEnumerable<ConsumableOrder>

@{
    ViewData["Title"] = "Consumables";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Consumable Orders</title>

    <!-- GOOGLE FONTS -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

        /* =========================================
           RESET
        ========================================= */

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        /* =========================================
           ROOT VARIABLES
        ========================================= */

        :root {

            --navy: #0b1f3a;
            --teal: #0d9488;
            --purple: #4f46e5;
            --amber: #d97706;
            --red: #dc2626;
            --green: #16a34a;

            --white: #ffffff;
            --offwhite: #f4f7fb;

            --muted: #6b7a99;
            --border: #dde4f0;

            --amber-light: rgba(217,119,6,0.1);
            --green-light: rgba(22,163,74,0.1);
        }

        /* =========================================
           BODY
        ========================================= */

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            padding: 30px;
        }

        /* =========================================
           PAGE HEADER
        ========================================= */

        .page-header {
            margin-bottom: 24px;
        }

        .page-header h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            margin-bottom: 8px;
        }

        .page-header p {
            color: var(--muted);
            font-size: 0.9rem;
        }

        /* =========================================
           CARD
        ========================================= */

        .card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
        }

        /* =========================================
           SEARCH BAR
        ========================================= */

        .search-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .app-select {
            width: 220px;
            height: 42px;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 0 12px;
            background: var(--offwhite);
            font-size: 0.85rem;
            outline: none;
        }

        /* =========================================
           BUTTONS
        ========================================= */

        .btn-sm {
            border: none;
            border-radius: 10px;
            padding: 11px 16px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-sm:hover {
            transform: translateY(-1px);
            opacity: 0.92;
        }

        .btn-teal {
            background: var(--teal);
            color: white;
        }

        .btn-red {
            background: var(--red);
            color: white;
        }

        /* =========================================
           TABLE
        ========================================= */

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            padding-bottom: 14px;
            border-bottom: 1px solid var(--border);

            color: var(--muted);
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            white-space: nowrap;
        }

        td {
            padding: 18px 0;
            border-bottom: 1px solid var(--offwhite);
            font-size: 0.85rem;
            white-space: nowrap;
        }

        tr:last-child td {
            border-bottom: none;
        }

        /* =========================================
           ORDER NUMBER
        ========================================= */

        .mono {
            font-family: monospace;
            font-weight: 600;
        }

        /* =========================================
           STATUS PILLS
        ========================================= */

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;

            padding: 7px 12px;
            border-radius: 999px;

            font-size: 0.78rem;
            font-weight: 600;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .sp-inprogress {
            background: var(--amber-light);
            color: var(--amber);
        }

        .sp-inprogress .dot {
            background: var(--amber);
        }

        .sp-completed {
            background: var(--green-light);
            color: var(--green);
        }

        .sp-completed .dot {
            background: var(--green);
        }

        /* =========================================
           ACTION BUTTONS
        ========================================= */

        .action-group {
            display: flex;
            gap: 8px;
        }

        /* =========================================
           COMPLETED TEXT
        ========================================= */

        .completed-text {
            color: var(--muted);
            font-size: 0.78rem;
        }

        /* =========================================
           RESPONSIVE
        ========================================= */

        @@media(max-width: 768px) {

            body {
                padding: 18px;
            }

            .search-bar {
                flex-direction: column;
                align-items: stretch;
            }

            .app-select {
                width: 100%;
            }

            .action-group {
                flex-direction: column;
            }
        }

    </style>

</head>

<body>

    <!-- PAGE -->
    <div id="mp-orders">

        <!-- PAGE HEADER -->
        <div class="page-header">

            <h1>Consumable Orders</h1>

            <p>
                Manage supplier orders and track delivery status.
            </p>

        </div>

        <!-- CARD -->
        <div class="card">

            <!-- SEARCH BAR -->
            <div class="search-bar">

                <select class="app-select">
                    <option>All Statuses</option>
                    <option>Ordered</option>
                    <option>Partially Complete</option>
                    <option>Complete</option>
                    <option>Cancelled</option>
                </select>

                <button class="btn-sm btn-teal">
                    + Create Order
                </button>

            </div>

            <!-- TABLE -->
            <div class="table-wrap">

                <table>

                    <thead>

                        <tr>
                            <th>Order #</th>
                            <th>Supplier</th>
                            <th>Items</th>
                            <th>Order Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var order in Model)
                        {
                            <tr>

                                <!-- ORDER NUMBER -->
                                <td class="mono">
                                    @order.OrderNumber
                                </td>

                                <!-- SUPPLIER -->
                                <td>
                                    @order.Supplier
                                </td>

                                <!-- ITEMS -->
                                <td>
                                    @order.Items
                                </td>

                                <!-- ORDER DATE -->
                                <td>
                                    @order.OrderDate.ToString("yyyy-MM-dd")
                                </td>

                                <!-- STATUS -->
                                <td>

                                    @if (order.Status == "Complete")
                                    {
                                        <span class="status-pill sp-completed">
                                            <span class="dot"></span>
                                            @order.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill sp-inprogress">
                                            <span class="dot"></span>
                                            @order.Status
                                        </span>
                                    }

                                </td>

                                <!-- ACTIONS -->
                                <td>

                                    @if (order.Status == "Complete")
                                    {
                                        <span class="completed-text">
                                            Completed
                                            @order.CompletedDate?.ToString("yyyy-MM-dd")
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="action-group">

                                            <button class="btn-sm btn-teal">
                                                Receive
                                            </button>

                                            <button class="btn-sm btn-red">
                                                Cancel
                                            </button>

                                        </div>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</body>

</html> *@