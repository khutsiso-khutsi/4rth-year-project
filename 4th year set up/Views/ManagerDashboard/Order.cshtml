@using LabManager.Models
@model IEnumerable<ConsumableOrder>


@{
    Layout = null;

    var current = ViewBag.StatusFilter as string ?? "All Statuses";
    var statuses = new[] { "All Statuses", "Ordered", "Partially Complete", "Complete", "Cancelled" };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Consumable Orders — NMB-HLabSys</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>

            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --navy: #0b1f3a;
                --teal: #0d9488;
                --teal-light: rgba(13,148,136,0.1);
                --offwhite: #f4f7fb;
                --white: #ffffff;
                --muted: #6b7a99;
                --border: #dde4f0;
                --green: #16a34a;
                --green-light: rgba(22,163,74,0.1);
                --amber: #d97706;
                --amber-light: rgba(217,119,6,0.1);
                --red: #dc2626;
                --red-light: rgba(220,38,38,0.1);
                --blue: #1d4ed8;
                --blue-light: rgba(29,78,216,0.1);
            }

            body {
                font-family: 'DM Sans', sans-serif;
                background: var(--offwhite);
                color: var(--navy);
                min-height: 100vh;
            }

            a {
                text-decoration: none;
            }

            /* ───────── TOPBAR ───────── */

            .topbar {
                background: var(--navy);
                padding: 0 40px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                height: 64px;
                position: sticky;
                top: 0;
                z-index: 100;
                box-shadow: 0 2px 20px rgba(0,0,0,0.15);
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .brand-logo {
                width: 34px;
                height: 34px;
                background: var(--teal);
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .brand-logo svg {
                    width: 18px;
                    height: 18px;
                    fill: white;
                }

            .brand-name {
                font-family: 'DM Serif Display', serif;
                color: white;
                font-size: 1.1rem;
                line-height: 1.1;
            }

                .brand-name span {
                    display: block;
                    font-family: 'DM Sans', sans-serif;
                    font-size: 0.6rem;
                    font-weight: 300;
                    color: rgba(255,255,255,0.4);
                    letter-spacing: 0.1em;
                    text-transform: uppercase;
                }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .user-chip {
                display: flex;
                align-items: center;
                gap: 10px;
                background: rgba(255,255,255,0.07);
                border: 1px solid rgba(255,255,255,0.1);
                border-radius: 100px;
                padding: 6px 14px 6px 8px;
            }

            .user-avatar {
                width: 28px;
                height: 28px;
                background: var(--teal);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.75rem;
                font-weight: 600;
                color: white;
            }

            .user-email {
                font-size: 0.8rem;
                color: rgba(255,255,255,0.75);
                max-width: 160px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .logout-btn {
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.12);
                color: rgba(255,255,255,0.8);
                padding: 8px 16px;
                border-radius: 8px;
                text-decoration: none;
                font-size: 0.82rem;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 6px;
                transition: all 0.2s;
            }

                .logout-btn:hover {
                    background: rgba(255,255,255,0.15);
                    color: white;
                }

                .logout-btn svg {
                    width: 14px;
                    height: 14px;
                }

            /* ───────── LAYOUT ───────── */

            .page {
                display: flex;
                min-height: calc(100vh - 64px);
            }

            /* ───────── SIDEBAR ───────── */

            .sidebar {
                width: 220px;
                background: white;
                border-right: 1px solid var(--border);
                padding: 24px 0;
                flex-shrink: 0;
                position: sticky;
                top: 64px;
                height: calc(100vh - 64px);
                overflow-y: auto;
            }

            .nav-section {
                margin-bottom: 8px;
            }

            .nav-label {
                font-size: 0.65rem;
                font-weight: 600;
                color: var(--muted);
                letter-spacing: 0.1em;
                text-transform: uppercase;
                padding: 0 20px;
                margin-bottom: 4px;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 20px;
                color: var(--muted);
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 500;
                transition: all 0.15s;
                border-left: 3px solid transparent;
            }

                .nav-item:hover {
                    background: var(--offwhite);
                    color: var(--navy);
                }

                .nav-item.active {
                    background: var(--teal-light);
                    color: var(--teal);
                    border-left-color: var(--teal);
                }

                .nav-item svg {
                    width: 16px;
                    height: 16px;
                    flex-shrink: 0;
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 2;
                    stroke-linecap: round;
                }

            /* ───────── MAIN ───────── */

            .main {
                flex: 1;
                padding: clamp(24px, 3vw, 40px);
                overflow-y: auto;
            }

            .page-header {
                margin-bottom: 24px;
            }

                .page-header h1 {
                    font-family: 'DM Serif Display', serif;
                    font-size: 1.8rem;
                    color: var(--navy);
                    margin-bottom: 4px;
                }

                .page-header p {
                    font-size: 0.875rem;
                    color: var(--muted);
                }

            .card {
                background: white;
                border: 1px solid var(--border);
                border-radius: 16px;
                padding: 28px;
                box-shadow: 0 2px 8px rgba(11,31,58,0.04);
            }

            /* ───────── TOOLBAR ───────── */

            .toolbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 16px;
                flex-wrap: wrap;
                margin-bottom: 24px;
            }

            .toolbar-left {
                display: flex;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

            .filter-select {
                height: 44px;
                min-width: 220px;
                border-radius: 10px;
                border: 1px solid var(--border);
                background: var(--offwhite);
                padding: 0 14px;
                outline: none;
                font-size: 0.85rem;
                font-family: 'DM Sans', sans-serif;
                color: var(--navy);
                transition: 0.2s;
                cursor: pointer;
            }

                .filter-select:focus {
                    border-color: var(--teal);
                    background: white;
                }

            .btn {
                height: 44px;
                padding: 0 18px;
                border: none;
                border-radius: 10px;
                cursor: pointer;
                font-size: 0.82rem;
                font-weight: 600;
                font-family: 'DM Sans', sans-serif;
                transition: 0.2s;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                text-decoration: none;
            }

                .btn:hover {
                    transform: translateY(-1px);
                }

            .btn-teal {
                background: var(--teal);
                color: white;
                box-shadow: 0 4px 14px rgba(13,148,136,0.25);
            }

            /* ───────── TABLE ───────── */

            .table-wrap {
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 900px;
            }

            thead th {
                text-align: left;
                padding: 0 16px 12px;
                font-size: 0.7rem;
                font-weight: 600;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: var(--muted);
                border-bottom: 1px solid var(--border);
            }

            tbody td {
                padding: 14px 16px;
                border-bottom: 1px solid var(--offwhite);
                font-size: 0.83rem;
                color: var(--navy);
                vertical-align: middle;
            }

            tbody tr:last-child td {
                border-bottom: none;
            }

            tbody tr:hover {
                background: var(--offwhite);
            }

            .order-number {
                font-weight: 700;
                color: var(--blue);
            }

            /* ───────── STATUS ───────── */

            .status {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 5px 10px;
                border-radius: 100px;
                font-size: 0.72rem;
                font-weight: 600;
            }

            .status-dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: currentColor;
            }

            .ordered {
                background: var(--blue-light);
                color: var(--blue);
            }

            .partial {
                background: var(--amber-light);
                color: var(--amber);
            }

            .complete {
                background: var(--green-light);
                color: var(--green);
            }

            .cancelled {
                background: var(--red-light);
                color: var(--red);
            }

            /* ───────── ACTIONS ───────── */

            .table-actions {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-wrap: wrap;
            }

            .action-btn {
                height: 34px;
                padding: 0 12px;
                border-radius: 8px;
                border: none;
                cursor: pointer;
                font-size: 0.75rem;
                font-weight: 600;
                font-family: 'DM Sans', sans-serif;
                display: inline-flex;
                align-items: center;
                text-decoration: none;
                transition: 0.2s;
            }

                .action-btn:hover {
                    transform: translateY(-1px);
                }

            .receive-btn {
                background: var(--green-light);
                color: var(--green);
            }

            .cancel-btn {
                background: var(--red-light);
                color: var(--red);
            }

            .completed-text {
                font-size: 0.75rem;
                color: var(--muted);
                line-height: 1.6;
            }

            /* ───────── EMPTY ───────── */

            .empty {
                text-align: center;
                padding: 60px 20px;
                color: var(--muted);
            }

                .empty svg {
                    width: 48px;
                    height: 48px;
                    stroke: #c0cadb;
                    fill: none;
                    stroke-width: 1.5;
                    margin-bottom: 12px;
                }

                .empty h3 {
                    color: var(--navy);
                    margin-bottom: 6px;
                }

            /* ───────── MODAL ───────── */

            .modal-bg {
                position: fixed;
                inset: 0;
                background: rgba(11,31,58,0.45);
                z-index: 999;
                display: none;
                align-items: center;
                justify-content: center;
                padding: 20px;
            }

                .modal-bg.open {
                    display: flex;
                }

            .modal {
                width: 100%;
                max-width: 600px;
                background: white;
                border-radius: 22px;
                padding: 32px;
                position: relative;
                animation: modalIn 0.18s ease;
            }

            @@keyframes modalIn {
                from {
                    opacity: 0;
                    transform: scale(0.96) translateY(8px);
                }

                to {
                    opacity: 1;
                    transform: scale(1) translateY(0);
                }
            }

            .modal-close {
                position: absolute;
                top: 18px;
                right: 18px;
                width: 36px;
                height: 36px;
                border: none;
                border-radius: 10px;
                background: var(--offwhite);
                cursor: pointer;
                font-size: 1rem;
            }

            .modal h2 {
                font-family: 'DM Serif Display', serif;
                margin-bottom: 6px;
                color: var(--navy);
            }

            .modal p {
                color: var(--muted);
                font-size: 0.875rem;
                line-height: 1.6;
                margin-bottom: 22px;
            }

            .form-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 18px;
            }

            .form-group {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

                .form-group.full {
                    grid-column: span 2;
                }

            .form-label {
                font-size: 0.8rem;
                font-weight: 600;
                color: var(--navy);
            }

            .form-input {
                height: 46px;
                border-radius: 10px;
                border: 1px solid var(--border);
                background: var(--offwhite);
                padding: 0 14px;
                outline: none;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.85rem;
            }

                .form-input:focus {
                    border-color: var(--teal);
                    background: white;
                }

            .modal-actions {
                display: flex;
                gap: 10px;
                margin-top: 26px;
            }

            .btn-modal {
                flex: 1;
                height: 46px;
                border: none;
                border-radius: 10px;
                font-size: 0.85rem;
                font-weight: 600;
                cursor: pointer;
                font-family: 'DM Sans', sans-serif;
                display: flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
            }

            .btn-save {
                background: var(--teal);
                color: white;
            }

            .btn-cancel-modal {
                background: var(--offwhite);
                color: var(--navy);
            }

            .modal-icon {
                width: 52px;
                height: 52px;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 18px;
            }

            /* ───────── RESPONSIVE ───────── */

            @@media (max-width: 768px) {

                .topbar {
                    padding: 0 20px;
                }

                .sidebar {
                    display: none;
                }

                .main {
                    padding: 20px 16px;
                }

                .user-email {
                    display: none;
                }

                .form-grid {
                    grid-template-columns: 1fr;
                }

                .form-group.full {
                    grid-column: span 1;
                }

                .modal-actions {
                    flex-direction: column;
                }
            }

    </style>
</head>
<body>

    <!-- TOPBAR -->

    <div class="topbar">

        <a class="brand"
           asp-controller="Home"
           asp-action="Index">

            <div class="brand-logo">
                <svg viewBox="0 0 24 24">
                    <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" />
                    <circle cx="12" cy="17" r="4" opacity="0.6" />
                </svg>
            </div>

            <div class="brand-name">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>

        </a>

        <div class="topbar-right">

            <div class="user-chip">
                <div class="user-avatar">
                    @(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "M")
                </div>
                <span class="user-email">@ViewBag.Email</span>
            </div>

            <a asp-controller="Home"
               asp-action="Logout"
               class="logout-btn"
               id="logout-btn">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round">

                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />

                </svg>

                Sign Out

            </a>

        </div>

    </div>

    <div class="page">

        <!-- SIDEBAR -->

        <aside class="sidebar">

            <div class="nav-section">

                <div class="nav-label">Main</div>

                <a asp-controller="ManagerDashboard"
                   asp-action="Index"
                   class="nav-item">
                    <svg viewBox="0 0 24 24">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                    </svg>
                    Dashboard
                </a>

                <a asp-controller="ManagerDashboard"
                   asp-action="TestCatalogue"
                   class="nav-item">
                    <svg viewBox="0 0 24 24">
                        <path d="M9 3v11a3 3 0 006 0V3" />
                        <line x1="6" y1="3" x2="18" y2="3" />
                    </svg>
                    Test Catalogue
                </a>

                <a asp-controller="ManagerDashboard"
                   asp-action="Consumables"
                   class="nav-item">
                    <svg viewBox="0 0 24 24">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                    </svg>
                    Consumables
                </a>

                <a asp-controller="ManagerDashboard"
                   asp-action="Staff"
                   class="nav-item">
                    <svg viewBox="0 0 24 24">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Staff
                </a>

                <a asp-controller="ManagerDashboard"
                   asp-action="Orders"
                   class="nav-item active">
                    <svg viewBox="0 0 24 24">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                    Orders
                </a>

                <a asp-controller="ManagerDashboard"
                   asp-action="Report"
                   class="nav-item">
                    <svg viewBox="0 0 24 24">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                    Reports
                </a>

            </div>

            <div class="nav-section">

                <div class="nav-label">System</div>

                <a asp-controller="ManagerDashboard"
                   asp-action="Profile"
                   class="nav-item">
                    <svg viewBox="0 0 24 24">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Profile
                </a>

                <a asp-controller="ManagerDashboard"
                   asp-action="AuditLog"
                   class="nav-item">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                    Audit Log
                </a>

            </div>

        </aside>

        <!-- MAIN -->

        <main class="main">

            <div class="page-header">
                <h1>Consumable Orders</h1>
                <p>Manage supplier orders and monitor delivery progress.</p>
            </div>

            <div class="card">

                <!-- TOOLBAR -->

                <div class="toolbar">

                    <div class="toolbar-left">

                        <select class="filter-select"
                                onchange="location.href='?status=' + this.value">

                            @foreach (var s in statuses)
                            {
                                <option value="@s" selected="@(s == current)">
                                    @s
                                </option>
                            }

                        </select>

                    </div>

                    <button class="btn btn-teal"
                            onclick="openModal('createModal')">
                        + Create Order
                    </button>

                </div>

                <!-- TABLE -->

                <div class="table-wrap">

                    <table>

                        <thead>
                            <tr>
                                <th>Order Number</th>
                                <th>Supplier</th>
                                <th>Items</th>
                                <th>Order Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model != null && Model.Any())
                            {
                                foreach (var o in Model)
                                {
                                    var statusClass = o.Status switch
                                    {
                                        "Ordered" => "status ordered",
                                        "Partially Complete" => "status partial",
                                        "Complete" => "status complete",
                                        "Cancelled" => "status cancelled",
                                        _ => "status ordered"
                                    };

                                    <tr>

                                        <td>
                                            <span class="order-number">
                                                @o.OrderNumber
                                            </span>
                                        </td>

                                        <td>@o.Supplier</td>

                                        <td>@o.Items</td>

                                        <td>
                                            @o.OrderDate.ToString("dd MMM yyyy")
                                        </td>

                                        <td>
                                            <span class="@statusClass">
                                                <span class="status-dot"></span>
                                                @o.Status
                                            </span>
                                        </td>

                                        <td>

                                            @if (o.Status == "Complete" || o.Status == "Cancelled")
                                            {
                                                <div class="completed-text">
                                                    @(o.Status == "Complete" ? "Completed" : "Cancelled")
                                                    <br />
                                                    @o.CompletedDate?.ToString("dd MMM yyyy")
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="table-actions">

                                                    <button class="action-btn receive-btn"
                                                            onclick="openConfirm('confirmReceive','@o.Id','receive')">
                                                        Receive
                                                    </button>

                                                    @if (o.Status == "Ordered")
                                                    {
                                                        <button class="action-btn cancel-btn"
                                                                onclick="openConfirm('confirmCancel','@o.Id','cancel')">
                                                            Cancel
                                                        </button>
                                                    }

                                                </div>
                                            }

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6">

                                        <div class="empty">

                                            <svg viewBox="0 0 24 24">
                                                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                                <path d="M16 10a4 4 0 0 1-8 0"></path>
                                            </svg>

                                            <h3>No Orders Found</h3>

                                            <p>
                                                No consumable orders are available right now.
                                            </p>

                                        </div>

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </main>

    </div>

    <!-- CREATE ORDER MODAL -->

    <div class="modal-bg"
         id="createModal"
         onclick="closeByBackground(event,this)">

        <div class="modal">

            <button class="modal-close"
                    onclick="closeModal('createModal')">
                ✕
            </button>

            <h2>Create New Order</h2>

            <p>
                Add a new consumable supplier order to the system.
            </p>

            <form asp-controller="ManagerDashboard"
                  asp-action="CreateOrder"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="form-grid">

                    <div class="form-group">

                        <label class="form-label">
                            Order Number
                        </label>

                        <input type="text"
                               class="form-input"
                               name="orderNumber"
                               value="ORD-@DateTime.Now.Year-@(new Random().Next(1000, 9999))"
                               required />

                    </div>

                    <div class="form-group">

                        <label class="form-label">
                            Supplier
                        </label>

                        <select class="form-input"
                                name="supplier"
                                required>

                            @if (ViewBag.Suppliers != null)
                            {
                                foreach (var s in ViewBag.Suppliers as IEnumerable<Supplier>)
                                {
                                    <option value="@s.SupplierName">
                                        @s.SupplierName
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="form-group full">

                        <label class="form-label">
                            Order Items
                        </label>

                        <input type="text"
                               class="form-input"
                               name="items"
                               placeholder="EDTA Tubes (200), Lancets (500)"
                               required />

                    </div>

                </div>

                <div class="modal-actions">

                    <button type="submit"
                            class="btn-modal btn-save">
                        Create Order
                    </button>

                    <button type="button"
                            class="btn-modal btn-cancel-modal"
                            onclick="closeModal('createModal')">
                        Cancel
                    </button>

                </div>

            </form>

        </div>

    </div>

    <!-- RECEIVE MODAL -->

    <div class="modal-bg"
         id="confirmReceive"
         onclick="closeByBackground(event,this)">

        <div class="modal"
             style="max-width:400px;">

            <button class="modal-close"
                    onclick="closeModal('confirmReceive')">
                ✕
            </button>

            <div class="modal-icon"
                 style="background:var(--green-light);">

                <svg width="22"
                     height="22"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="#16a34a"
                     stroke-width="2"
                     stroke-linecap="round">

                    <polyline points="20 6 9 17 4 12"></polyline>

                </svg>

            </div>

            <h2>Mark as Received?</h2>

            <p>
                This will update the order status and stock levels.
            </p>

            <div class="modal-actions">

                <button class="btn-modal btn-cancel-modal"
                        onclick="closeModal('confirmReceive')">
                    Cancel
                </button>

                <a id="receive-confirm-link"
                   href="#"
                   class="btn-modal btn-save"
                   style="background:var(--green);">
                    Mark Received
                </a>

            </div>

        </div>

    </div>

    <!-- CANCEL MODAL -->

    <div class="modal-bg"
         id="confirmCancel"
         onclick="closeByBackground(event,this)">

        <div class="modal"
             style="max-width:400px;">

            <button class="modal-close"
                    onclick="closeModal('confirmCancel')">
                ✕
            </button>

            <div class="modal-icon"
                 style="background:var(--red-light);">

                <svg width="22"
                     height="22"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="#dc2626"
                     stroke-width="2"
                     stroke-linecap="round">

                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>

                </svg>

            </div>

            <h2>Cancel this order?</h2>

            <p>
                This action cannot be undone.
            </p>

            <div class="modal-actions">

                <button class="btn-modal btn-cancel-modal"
                        onclick="closeModal('confirmCancel')">
                    Go Back
                </button>

                <a id="cancel-confirm-link"
                   href="#"
                   class="btn-modal btn-save"
                   style="background:var(--red);">
                    Cancel Order
                </a>

            </div>

        </div>

    </div>

    <!-- LOGOUT MODAL -->

    <div class="modal-bg"
         id="logoutModal"
         onclick="closeByBackground(event,this)">

        <div class="modal"
             style="max-width:400px;">

            <button class="modal-close"
                    onclick="closeModal('logoutModal')">
                ✕
            </button>

            <div class="modal-icon"
                 style="background:var(--red-light);">

                <svg width="22"
                     height="22"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="#dc2626"
                     stroke-width="2"
                     stroke-linecap="round">

                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />

                </svg>

            </div>

            <h2>Sign out?</h2>

            <p>
                You'll be returned to the login screen.
            </p>

            <div class="modal-actions">

                <button class="btn-modal btn-cancel-modal"
                        onclick="closeModal('logoutModal')">
                    Cancel
                </button>

                <a id="logout-confirm"
                   href="#"
                   class="btn-modal btn-save"
                   style="background:var(--red);">
                    Sign Out
                </a>

            </div>

        </div>

    </div>

    <script>

            function openModal(id) {
                document.getElementById(id).classList.add('open');
                document.body.style.overflow = 'hidden';
            }

            function closeModal(id) {
                document.getElementById(id).classList.remove('open');
                document.body.style.overflow = '';
            }

            function closeByBackground(event, element) {
                if (event.target === element) {
                    closeModal(element.id);
                }
            }

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    document.querySelectorAll('.modal-bg.open')
                        .forEach(m => m.classList.remove('open'));

                    document.body.style.overflow = '';
                }
            });

            function openConfirm(modalId, orderId, action) {

                if (action === 'receive') {

                    document.getElementById('receive-confirm-link').href =
                        '@Url.Action("ReceiveOrder", "ManagerDashboard")/' + orderId;
                }

                else if (action === 'cancel') {

                    document.getElementById('cancel-confirm-link').href =
                        '@Url.Action("CancelOrder", "ManagerDashboard")/' + orderId;
                }

                openModal(modalId);
            }

            // Logout Modal

            var logoutBtn = document.getElementById('logout-btn');
            var logoutConfirm = document.getElementById('logout-confirm');

            if (logoutBtn) {

                logoutConfirm.href = logoutBtn.href;

                logoutBtn.addEventListener('click', function (e) {

                    e.preventDefault();

                    openModal('logoutModal');

                });
            }

    </script>

</body>
</html>