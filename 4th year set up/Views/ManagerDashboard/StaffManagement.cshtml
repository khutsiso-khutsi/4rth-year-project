@model IEnumerable<TestCatalogue>

@{
    ViewData["Title"] = "Manager Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manager Dashboard — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --teal: #0d9488;
            --teal-light: rgba(13,148,136,0.1);
            --purple: #4f46e5;
            --purple-light: rgba(79,70,229,0.1);
            --amber: #d97706;
            --amber-light: rgba(217,119,6,0.1);
            --red: #dc2626;
            --red-light: rgba(220,38,38,0.1);
            --green: #16a34a;
            --green-light: rgba(22,163,74,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
        }

        /* ── TOPBAR ── */
        .topbar {
            background: var(--navy);
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-logo {
            width: 34px;
            height: 34px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .brand-logo svg {
                width: 18px;
                height: 18px;
                fill: white;
            }

        .brand-name {
            font-family: 'DM Serif Display', serif;
            color: white;
            font-size: 1.1rem;
            line-height: 1.1;
        }

            .brand-name span {
                display: block;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.6rem;
                font-weight: 300;
                color: rgba(255,255,255,0.4);
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 6px 14px 6px 8px;
        }

        .user-avatar {
            width: 28px;
            height: 28px;
            background: var(--purple);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
        }

        .user-email {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.75);
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .logout-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.8);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }

            .logout-btn:hover {
                background: rgba(255,255,255,0.15);
                color: white;
            }

            .logout-btn svg {
                width: 14px;
                height: 14px;
            }

        /* ── LAYOUT ── */
        .page {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 220px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 24px 0;
            flex-shrink: 0;
            position: sticky;
            top: 64px;
            height: calc(100vh - 64px);
            overflow-y: auto;
        }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 20px;
            margin-bottom: 4px;
            margin-top: 16px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all 0.15s;
        }

            .nav-item:hover {
                background: var(--offwhite);
                color: var(--navy);
            }

            .nav-item.active {
                background: var(--purple-light);
                color: var(--purple);
                border-left-color: var(--purple);
            }

            .nav-item svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        /* ── MAIN ── */
        .main {
            flex: 1;
            padding: 32px 40px;
        }

        /* ── WELCOME BANNER ── */
        .welcome-banner {
            background: linear-gradient(135deg, var(--navy) 0%, var(--navy2) 100%);
            border-radius: 20px;
            padding: 32px 36px;
            margin-bottom: 28px;
            position: relative;
            overflow: hidden;
        }

            .welcome-banner::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 60% 80% at 90% 50%, rgba(79,70,229,0.2) 0%, transparent 60%);
            }

            .welcome-banner::after {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
                background-size: 40px 40px;
            }

        .welcome-inner {
            position: relative;
            z-index: 2;
        }

        .welcome-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(79,70,229,0.2);
            border: 1px solid rgba(79,70,229,0.3);
            color: #a5b4fc;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 100px;
            margin-bottom: 12px;
        }

            .welcome-tag::before {
                content: '';
                width: 5px;
                height: 5px;
                background: #a5b4fc;
                border-radius: 50%;
            }

        .welcome-banner h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.8rem;
            color: white;
            margin-bottom: 6px;
        }

            .welcome-banner h1 em {
                font-style: italic;
                color: #a5b4fc;
            }

        .welcome-banner p {
            color: rgba(255,255,255,0.5);
            font-size: 0.875rem;
        }

        /* ── STAT CARDS ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
        }

        .stat-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }

        .stat-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .stat-icon svg {
                width: 18px;
                height: 18px;
            }

        .stat-trend {
            font-size: 0.72rem;
            font-weight: 600;
            padding: 3px 8px;
            border-radius: 100px;
        }

        .trend-up {
            background: var(--green-light);
            color: var(--green);
        }

        .trend-down {
            background: var(--red-light);
            color: var(--red);
        }

        .trend-neutral {
            background: var(--amber-light);
            color: var(--amber);
        }

        .stat-value {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            color: var(--navy);
            line-height: 1;
            margin-bottom: 4px;
        }

        .stat-label {
            font-size: 0.78rem;
            color: var(--muted);
            font-weight: 500;
        }

        /* ── SECTION GRID ── */
        .section-grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .section-grid-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
        }

        /* ── CARDS ── */
        .card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .card-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.05rem;
            color: var(--navy);
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .card-title svg {
                width: 17px;
                height: 17px;
                stroke: var(--teal);
            }

        .card-action {
            font-size: 0.78rem;
            color: var(--teal);
            text-decoration: none;
            font-weight: 500;
        }

            .card-action:hover {
                text-decoration: underline;
            }

        /* ── TABLE ── */
        .table {
            width: 100%;
            border-collapse: collapse;
        }

            .table th {
                font-size: 0.7rem;
                font-weight: 600;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: 0.08em;
                padding: 0 0 10px;
                text-align: left;
                border-bottom: 1px solid var(--border);
            }

            .table td {
                padding: 12px 0;
                font-size: 0.83rem;
                color: var(--navy);
                border-bottom: 1px solid var(--offwhite);
                vertical-align: middle;
            }

            .table tr:last-child td {
                border-bottom: none;
            }

        /* ── BADGES ── */
        .badge {
            display: inline-block;
            padding: 3px 9px;
            border-radius: 100px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .badge-completed {
            background: var(--green-light);
            color: var(--green);
        }

        .badge-pending {
            background: var(--amber-light);
            color: var(--amber);
        }

        .badge-urgent {
            background: var(--red-light);
            color: var(--red);
        }

        .badge-inprogress {
            background: var(--purple-light);
            color: var(--purple);
        }

        /* ── STAFF LIST ── */
        .staff-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid var(--offwhite);
        }

            .staff-item:last-child {
                border-bottom: none;
            }

        .staff-avatar {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: 600;
            color: white;
            flex-shrink: 0;
        }

        .staff-info {
            flex: 1;
        }

        .staff-name {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--navy);
        }

        .staff-role {
            font-size: 0.72rem;
            color: var(--muted);
            margin-top: 1px;
        }

        .staff-status {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .status-online {
            background: var(--green);
        }

        .status-offline {
            background: var(--border);
        }

        /* ── ACTIVITY LOG ── */
        .activity-item {
            display: flex;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid var(--offwhite);
        }

            .activity-item:last-child {
                border-bottom: none;
            }

        .activity-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-top: 6px;
            flex-shrink: 0;
        }

        .activity-text {
            font-size: 0.82rem;
            color: var(--navy);
            line-height: 1.5;
        }

        .activity-time {
            font-size: 0.72rem;
            color: var(--muted);
            margin-top: 2px;
        }

        /* ── QUICK ACTIONS ── */
        .quick-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .action-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 14px;
            background: var(--offwhite);
            border: 1px solid var(--border);
            border-radius: 10px;
            text-decoration: none;
            color: var(--navy);
            font-size: 0.82rem;
            font-weight: 500;
            transition: all 0.15s;
            cursor: pointer;
        }

            .action-btn:hover {
                background: white;
                border-color: var(--teal);
                color: var(--teal);
                box-shadow: 0 2px 8px rgba(13,148,136,0.1);
            }

            .action-btn svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
            }

        @@media (max-width: 1100px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .section-grid {
                grid-template-columns: 1fr;
            }

            .section-grid-3 {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            .topbar {
                padding: 0 20px;
            }

            .user-email {
                display: none;
            }

            .sidebar {
                display: none;
            }

            .main {
                padding: 20px 16px;
            }

            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">NMB-HLabSys<span>Haematology Lab System</span></div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "M")</div>
                <span class="user-email">@ViewBag.Email</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </div>

 

    <div class="container-fluid mt-4">

        <h1 class="text-white fw-bold">
            Test Catalogue
        </h1>

        <p class="text-secondary">
            Manage test categories, test types, and sample types.
        </p>

        <div class="card bg-dark border-0 p-4 mt-4">

            <div class="d-flex mb-4">

                <input type="text"
                       class="form-control w-25 me-3"
                       placeholder="Search tests..." />

                <button class="btn btn-warning me-2">
                    + Category
                </button>

                <button class="btn btn-success">
                    + Test Type
                </button>

            </div>

            <table class="table table-dark table-hover align-middle">

                <thead>
                    <tr>
                        <th>TEST NAME</th>
                        <th>CATEGORY</th>
                        <th>SAMPLE TYPE</th>
                        <th>UNITS</th>
                        <th>NORMAL RANGE</th>
                        <th>TAT (MIN)</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var test in Model)
                    {
                        <tr>

                            <td>@test.TestName</td>

                            <td>@test.Category</td>

                            <td>@test.SampleType</td>

                            <td>@test.Units</td>

                            <td>@test.NormalRange</td>

                            <td>@test.TAT</td>

                            <td>

                                <button class="btn btn-primary btn-sm">
                                    Edit
                                </button>

                                <button class="btn btn-danger btn-sm">
                                    Delete
                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</body>