@using LabManager.Models
@model StaffViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    ViewData["Title"] = "Staff Management";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Staff Management — NMB-HLabSys
    </title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap"
          rel="stylesheet" />

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: #f4f7fb;
                color: #0b1f3a;
                font-family: "DM Sans", sans-serif;
            }

            .topbar {
                height: 64px;
                background: white;
                border-bottom: 1px solid #dde4f0;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 28px;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 1000;
            }

            .brand {
                font-family: "DM Serif Display", serif;
                font-size: 23px;
            }

                .brand span {
                    color: #0d9488;
                }

            .top-user {
                display: flex;
                align-items: center;
                gap: 12px;
                color: #6b7a99;
                font-size: 14px;
            }

            .user-circle {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background: #0b1f3a;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
            }

            .sidebar {
                position: fixed;
                top: 64px;
                left: 0;
                bottom: 0;
                width: 220px;
                background: #0b1f3a;
                padding: 25px 14px;
                z-index: 900;
            }

            .nav-title {
                color: #8fa0bc;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 1px;
                padding: 0 14px 10px;
            }

            .nav-item {
                display: block;
                color: #d8e0ed;
                text-decoration: none;
                padding: 12px 14px;
                border-radius: 8px;
                margin-bottom: 5px;
                font-size: 14px;
            }

                .nav-item:hover,
                .nav-item.active {
                    background: #123257;
                    color: white;
                }

                .nav-item.active {
                    border-left: 3px solid #0d9488;
                }

            .main {
                margin-left: 220px;
                padding: 94px 28px 40px;
            }

            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 24px;
            }

                .page-header h1 {
                    margin: 0;
                    font-family: "DM Serif Display", serif;
                    font-size: 32px;
                }

                .page-header p {
                    color: #6b7a99;
                    margin: 6px 0 0;
                }

            .cards {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 22px;
            }

            .card {
                background: white;
                border: 1px solid #dde4f0;
                border-radius: 14px;
                overflow: hidden;
                box-shadow: 0 4px 15px rgba(11, 31, 58, 0.04);
            }

            .card-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 20px;
                border-bottom: 1px solid #dde4f0;
            }

            .card-title {
                font-size: 18px;
                font-weight: 700;
            }

            .count {
                background: #e8f7f5;
                color: #0d9488;
                padding: 4px 9px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 700;
            }

            .btn {
                border: none;
                border-radius: 7px;
                padding: 9px 15px;
                cursor: pointer;
                font-family: inherit;
                font-weight: 600;
            }

            .btn-primary {
                background: #0d9488;
                color: white;
            }

                .btn-primary:hover {
                    background: #087d73;
                }

            .btn-secondary {
                background: #eef2f7;
                color: #0b1f3a;
            }

            .btn-danger {
                background: #fee2e2;
                color: #b91c1c;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th {
                text-align: left;
                padding: 13px 18px;
                background: #f8fafc;
                color: #6b7a99;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: .5px;
            }

            td {
                padding: 15px 18px;
                border-top: 1px solid #edf1f6;
                font-size: 13px;
            }

            .row-clickable {
                cursor: pointer;
            }

                .row-clickable:hover {
                    background: #f8fbfc;
                }

            .status-badge {
                display: inline-block;
                padding: 4px 9px;
                border-radius: 20px;
                font-size: 11px;
                font-weight: 700;
            }

            .active {
                background: #dcfce7;
                color: #15803d;
            }

            .inactive {
                background: #fee2e2;
                color: #b91c1c;
            }

            .test-badge {
                display: inline-block;
                background: #e8f7f5;
                color: #0d9488;
                padding: 4px 8px;
                border-radius: 5px;
                font-size: 11px;
                font-weight: 600;
            }

            .empty {
                text-align: center;
                padding: 35px;
                color: #6b7a99;
            }

            /* ============================================================
                       MODAL
                       ============================================================ */

            .modal {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(11, 31, 58, .55);
                align-items: center;
                justify-content: center;
                z-index: 2000;
                padding: 20px;
            }

                .modal.show {
                    display: flex;
                }

            .modal-box {
                width: 100%;
                max-width: 550px;
                background: white;
                border-radius: 14px;
                box-shadow: 0 20px 50px rgba(0,0,0,.2);
                max-height: 90vh;
                overflow-y: auto;
            }

            .modal-header {
                padding: 20px 22px;
                border-bottom: 1px solid #dde4f0;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .modal-header h2 {
                    margin: 0;
                    font-size: 20px;
                }

            .close {
                border: none;
                background: none;
                font-size: 25px;
                cursor: pointer;
                color: #6b7a99;
            }

            .modal-body {
                padding: 22px;
            }

            .form-group {
                margin-bottom: 17px;
            }

                .form-group label {
                    display: block;
                    margin-bottom: 7px;
                    font-size: 13px;
                    font-weight: 600;
                }

            .form-control {
                width: 100%;
                padding: 11px 12px;
                border: 1px solid #ccd6e5;
                border-radius: 7px;
                outline: none;
                font-family: inherit;
                font-size: 14px;
                background: white;
            }

                .form-control:focus {
                    border-color: #0d9488;
                    box-shadow: 0 0 0 3px rgba(13,148,136,.1);
                }

            .modal-footer {
                padding: 18px 22px;
                border-top: 1px solid #dde4f0;
                display: flex;
                justify-content: flex-end;
                gap: 10px;
            }

            .detail-row {
                display: flex;
                justify-content: space-between;
                gap: 20px;
                padding: 12px 0;
                border-bottom: 1px solid #edf1f6;
            }

            .detail-label {
                color: #6b7a99;
                font-size: 13px;
            }

            .detail-value {
                font-weight: 600;
                text-align: right;
            }

            .alert {
                padding: 13px 16px;
                border-radius: 8px;
                margin-bottom: 20px;
                font-size: 13px;
            }

            .alert-success {
                background: #dcfce7;
                color: #166534;
            }

            .alert-error {
                background: #fee2e2;
                color: #991b1b;
            }

            @@media (max-width: 1000px) {

                .cards {
                    grid-template-columns: 1fr;
                }
            }

            @@media (max-width: 700px) {

                .sidebar {
                    width: 70px;
                }

                    .sidebar .nav-item {
                        font-size: 0;
                        text-align: center;
                    }

                    .sidebar .nav-title {
                        display: none;
                    }

                .main {
                    margin-left: 70px;
                }

                .top-user span {
                    display: none;
                }
            }

    </style>

</head>

<body>

    <!-- ============================================================
         TOP BAR
         ============================================================ -->

    <header class="topbar">

        <div class="brand">
            NMB-<span>HLabSys</span>
        </div>

        <div class="top-user">

            <span>
                @ViewBag.Email
            </span>

            <div class="user-circle">
                M
            </div>

        </div>

    </header>


    <!-- ============================================================
         SIDEBAR
         ============================================================ -->

    <aside class="sidebar">

        <div class="nav-title">
            Management
        </div>

        <a href="/ManagerDashboard/Index"
           class="nav-item">
            Dashboard
        </a>

        <a href="/ManagerDashboard/Staff"
           class="nav-item active">
            Staff
        </a>

        <a href="/ManagerDashboard/Consumables"
           class="nav-item">
            Consumables
        </a>

        <a href="/ManagerDashboard/Orders"
           class="nav-item">
            Orders
        </a>

        <a href="/ManagerDashboard/Reports"
           class="nav-item">
            Reports
        </a>

    </aside>


    <!-- ============================================================
         MAIN
         ============================================================ -->

    <main class="main">

        <div class="page-header">

            <div>

                <h1>
                    Staff Management
                </h1>

                <p>
                    Manage doctors and laboratory technicians.
                </p>

            </div>

        </div>


        <!-- ========================================================
             ALERTS
             ======================================================== -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">
                @TempData["Error"]
            </div>
        }


        <div class="cards">

            <!-- ====================================================
                 DOCTORS
                 ==================================================== -->

            <section class="card">

                <div class="card-header">

                    <div>
                        <span class="card-title">
                            Doctors
                        </span>

                        <span class="count">
                            @Model.Doctors.Count()
                        </span>
                    </div>

                    <button type="button"
                            class="btn btn-primary"
                            onclick="openAddDoctor()">

                        + Add Doctor

                    </button>

                </div>


                @if (Model.Doctors.Any())
                {

                    <table>

                        <thead>

                            <tr>
                                <th>Name</th>
                                <th>HPCSA</th>
                                <th>Email</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var d in Model.Doctors)
                            {

                                <tr class="row-clickable"
                                    data-id="@d.Id"
                                    data-fullname="@d.FullName"
                                    data-firstname="@d.FirstName"
                                    data-lastname="@d.LastName"
                                    data-email="@d.EmailAddress"
                                    data-hpcsa="@d.HCPSANumber"
                                    data-contact="@d.ContactNumber"
                                    data-active="@d.IsActive.ToString().ToLower()"
                                    onclick="openDoctorView(this)">

                                    <td>
                                        <strong>
                                            @d.FullName
                                        </strong>
                                    </td>

                                    <td>
                                        @d.HCPSANumber
                                    </td>

                                    <td>
                                        @d.EmailAddress
                                    </td>

                                    <td>

                                        @if (d.IsActive)
                                        {
                                            <span class="status-badge active">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge inactive">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                }
                else
                {

                    <div class="empty">
                        No doctors found.
                    </div>

                }

            </section>


            <!-- ====================================================
                 TECHNICIANS
                 ==================================================== -->

            <section class="card">

                <div class="card-header">

                    <div>
                        <span class="card-title">
                            Laboratory Technicians
                        </span>

                        <span class="count">
                            @Model.Technicians.Count()
                        </span>
                    </div>

                    <button type="button"
                            class="btn btn-primary"
                            onclick="openAddTechnician()">

                        + Add Technician

                    </button>

                </div>


                @if (Model.Technicians.Any())
                {

                    <table>

                        <thead>

                            <tr>
                                <th>Name</th>
                                <th>Employee No.</th>
                                <th>Test Type</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var t in Model.Technicians)
                            {

                                <tr class="row-clickable"
                                    data-id="@t.Id"
                                    data-fullname="@t.FullName"
                                    data-firstname="@t.FirstName"
                                    data-lastname="@t.LastName"
                                    data-email="@t.EmailAddress"
                                    data-employee="@t.EmployeeNumber"
                                    data-testtypeid="@t.TestTypeID"
                                    data-testname="@t.TestName"
                                    data-active="@t.IsActive.ToString().ToLower()"
                                    onclick="openTechnicianView(this)">

                                    <td>
                                        <strong>
                                            @t.FullName
                                        </strong>
                                    </td>

                                    <td>
                                        @t.EmployeeNumber
                                    </td>

                                    <td>

                                        <span class="test-badge">
                                            @t.TestName
                                        </span>

                                    </td>

                                    <td>

                                        @if (t.IsActive)
                                        {
                                            <span class="status-badge active">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge inactive">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                }
                else
                {

                    <div class="empty">
                        No laboratory technicians found.
                    </div>

                }

            </section>

        </div>

    </main>


    <!-- ============================================================
         DOCTOR VIEW MODAL
         ============================================================ -->

    <div id="doctorViewModal"
         class="modal">

        <div class="modal-box">

            <div class="modal-header">

                <h2>
                    Doctor Details
                </h2>

                <button class="close"
                        onclick="closeModal('doctorViewModal')">
                    &times;
                </button>

            </div>

            <div class="modal-body">

                <div class="detail-row">
                    <span class="detail-label">
                        Name
                    </span>

                    <span id="viewDoctorName"
                          class="detail-value">
                    </span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">
                        HPCSA Number
                    </span>

                    <span id="viewDoctorHpcsa"
                          class="detail-value">
                    </span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">
                        Email
                    </span>

                    <span id="viewDoctorEmail"
                          class="detail-value">
                    </span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">
                        Contact
                    </span>

                    <span id="viewDoctorContact"
                          class="detail-value">
                    </span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">
                        Status
                    </span>

                    <span id="viewDoctorStatus"
                          class="detail-value">
                    </span>
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        onclick="closeModal('doctorViewModal')">

                    Close

                </button>

                <button type="button"
                        class="btn btn-primary"
                        onclick="editCurrentDoctor()">

                    Edit

                </button>

            </div>

        </div>

    </div>


    <!-- ============================================================
         ADD / EDIT DOCTOR
         ============================================================ -->

    <div id="doctorModal"
         class="modal">

        <div class="modal-box">

            <div class="modal-header">

                <h2 id="doctorModalTitle">
                    Add Doctor
                </h2>

                <button class="close"
                        onclick="closeModal('doctorModal')">
                    &times;
                </button>

            </div>


            <form id="doctorForm"
                  method="post"
                  action="/ManagerDashboard/AddDoctor">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="doctorId"
                       name="id"
                       value="0" />


                <div class="modal-body">

                    <div class="form-group">

                        <label>
                            First Name
                        </label>

                        <input type="text"
                               id="doctorFirstName"
                               name="firstName"
                               class="form-control"
                               required />

                    </div>


                    <div class="form-group">

                        <label>
                            Last Name
                        </label>

                        <input type="text"
                               id="doctorLastName"
                               name="lastName"
                               class="form-control"
                               required />

                    </div>


                    <div class="form-group">

                        <label>
                            HPCSA Number
                        </label>

                        <input type="text"
                               id="doctorHpcsa"
                               name="hpcsaNumber"
                               class="form-control"
                               required />

                    </div>


                    <div class="form-group">

                        <label>
                            Email Address
                        </label>

                        <input type="email"
                               id="doctorEmail"
                               name="email"
                               class="form-control"
                               required />

                    </div>


                    <div class="form-group">

                        <label>
                            Contact Number
                        </label>

                        <input type="text"
                               id="doctorContact"
                               name="contactNumber"
                               class="form-control" />

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="closeModal('doctorModal')">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        Save Doctor

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- ============================================================
         TECHNICIAN VIEW MODAL
         ============================================================ -->

    <div id="technicianViewModal"
         class="modal">

        <div class="modal-box">

            <div class="modal-header">

                <h2>
                    Technician Details
                </h2>

                <button class="close"
                        onclick="closeModal('technicianViewModal')">
                    &times;
                </button>

            </div>

            <div class="modal-body">

                <div class="detail-row">

                    <span class="detail-label">
                        Name
                    </span>

                    <span id="viewTechnicianName"
                          class="detail-value">
                    </span>

                </div>


                <div class="detail-row">

                    <span class="detail-label">
                        Employee Number
                    </span>

                    <span id="viewTechnicianEmployee"
                          class="detail-value">
                    </span>

                </div>


                <div class="detail-row">

                    <span class="detail-label">
                        Email
                    </span>

                    <span id="viewTechnicianEmail"
                          class="detail-value">
                    </span>

                </div>


                <div class="detail-row">

                    <span class="detail-label">
                        Test Type
                    </span>

                    <span id="viewTechnicianTestType"
                          class="detail-value">
                    </span>

                </div>


                <div class="detail-row">

                    <span class="detail-label">
                        Status
                    </span>

                    <span id="viewTechnicianStatus"
                          class="detail-value">
                    </span>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        onclick="closeModal('technicianViewModal')">

                    Close

                </button>

                <button type="button"
                        class="btn btn-primary"
                        onclick="editCurrentTechnician()">

                    Edit

                </button>

            </div>

        </div>

    </div>


    <!-- ============================================================
         ADD / EDIT TECHNICIAN
         ============================================================ -->

    <div id="technicianModal"
         class="modal">

        <div class="modal-box">

            <div class="modal-header">

                <h2 id="technicianModalTitle">
                    Add Laboratory Technician
                </h2>

                <button class="close"
                        onclick="closeModal('technicianModal')">
                    &times;
                </button>

            </div>


            <form id="technicianForm"
                  method="post"
                  action="/ManagerDashboard/AddTechnician">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="technicianId"
                       name="id"
                       value="0" />


                <div class="modal-body">

                    <div class="form-group">

                        <label>
                            First Name
                        </label>

                        <input type="text"
                               id="technicianFirstName"
                               name="firstName"
                               class="form-control"
                               required />

                    </div>


                    <div class="form-group">

                        <label>
                            Last Name
                        </label>

                        <input type="text"
                               id="technicianLastName"
                               name="lastName"
                               class="form-control"
                               required />

                    </div>


                    <div class="form-group">

                        <label>
                            Employee Number
                        </label>

                        <input type="text"
                               id="technicianEmployeeNumber"
                               name="employeeNumber"
                               class="form-control"
                               required />

                    </div>


                    <div class="form-group">

                        <label>
                            Email Address
                        </label>

                        <input type="email"
                               id="technicianEmail"
                               name="email"
                               class="form-control"
                               required />

                    </div>


                    <!-- =================================================
                         TEST TYPE FOREIGN KEY DROPDOWN
                         ================================================= -->

                    <div class="form-group">

                        <label for="technicianTestType">

                            Test Type

                        </label>

                        <select id="technicianTestType"
                                name="testTypeID"
                                class="form-control"
                                required>

                            <option value="">
                                -- Select Test Type --
                            </option>

                            @foreach (var testType in Model.TestTypes)
                            {
                                <option value="@testType.TestId">
                                    @testType.TestName
                                </option>
                            }

                        </select>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="closeModal('technicianModal')">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        Save Technician

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- ============================================================
         JAVASCRIPT
         ============================================================ -->

    <script>

            let currentDoctorRow = null;
            let currentTechnicianRow = null;


            // ============================================================
            // GENERAL MODAL
            // ============================================================

            function closeModal(id) {

                document
                    .getElementById(id)
                    .classList.remove("show");

            }


            // ============================================================
            // DOCTOR VIEW
            // ============================================================

            function openDoctorView(row) {

                currentDoctorRow = row;

                document.getElementById("viewDoctorName").textContent =
                    row.dataset.fullname || "";

                document.getElementById("viewDoctorHpcsa").textContent =
                    row.dataset.hpcsa || "";

                document.getElementById("viewDoctorEmail").textContent =
                    row.dataset.email || "";

                document.getElementById("viewDoctorContact").textContent =
                    row.dataset.contact || "";

                const active =
                    row.dataset.active === "true";

                document.getElementById("viewDoctorStatus").innerHTML =
                    active
                        ? '<span class="status-badge active">Active</span>'
                        : '<span class="status-badge inactive">Inactive</span>';

                document
                    .getElementById("doctorViewModal")
                    .classList.add("show");

            }


            // ============================================================
            // ADD DOCTOR
            // ============================================================

            function openAddDoctor() {

                const form =
                    document.getElementById("doctorForm");

                form.action =
                    "/ManagerDashboard/AddDoctor";

                document.getElementById("doctorModalTitle").textContent =
                    "Add Doctor";

                document.getElementById("doctorId").value =
                    "0";

                document.getElementById("doctorFirstName").value =
                    "";

                document.getElementById("doctorLastName").value =
                    "";

                document.getElementById("doctorHpcsa").value =
                    "";

                document.getElementById("doctorEmail").value =
                    "";

                document.getElementById("doctorContact").value =
                    "";

                document
                    .getElementById("doctorModal")
                    .classList.add("show");

            }


            // ============================================================
            // EDIT DOCTOR
            // ============================================================

            function editCurrentDoctor() {

                if (!currentDoctorRow)
                    return;

                closeModal("doctorViewModal");

                const row =
                    currentDoctorRow;

                document.getElementById("doctorId").value =
                    row.dataset.id;

                document.getElementById("doctorFirstName").value =
                    row.dataset.firstname || "";

                document.getElementById("doctorLastName").value =
                    row.dataset.lastname || "";

                document.getElementById("doctorHpcsa").value =
                    row.dataset.hpcsa || "";

                document.getElementById("doctorEmail").value =
                    row.dataset.email || "";

                document.getElementById("doctorContact").value =
                    row.dataset.contact || "";

                document.getElementById("doctorModalTitle").textContent =
                    "Edit Doctor";

                document.getElementById("doctorForm").action =
                    "/ManagerDashboard/EditDoctor";

                document
                    .getElementById("doctorModal")
                    .classList.add("show");

            }


            // ============================================================
            // TECHNICIAN VIEW
            // ============================================================

            function openTechnicianView(row) {

                currentTechnicianRow = row;

                document.getElementById("viewTechnicianName").textContent =
                    row.dataset.fullname || "";

                document.getElementById("viewTechnicianEmployee").textContent =
                    row.dataset.employee || "";

                document.getElementById("viewTechnicianEmail").textContent =
                    row.dataset.email || "";

                document.getElementById("viewTechnicianTestType").textContent =
                    row.dataset.testname || "";

                const active =
                    row.dataset.active === "true";

                document.getElementById("viewTechnicianStatus").innerHTML =
                    active
                        ? '<span class="status-badge active">Active</span>'
                        : '<span class="status-badge inactive">Inactive</span>';

                document
                    .getElementById("technicianViewModal")
                    .classList.add("show");

            }


            // ============================================================
            // ADD TECHNICIAN
            // ============================================================

            function openAddTechnician() {

                document.getElementById("technicianForm").action =
                    "/ManagerDashboard/AddTechnician";

                document.getElementById("technicianModalTitle").textContent =
                    "Add Laboratory Technician";

                document.getElementById("technicianId").value =
                    "0";

                document.getElementById("technicianFirstName").value =
                    "";

                document.getElementById("technicianLastName").value =
                    "";

                document.getElementById("technicianEmployeeNumber").value =
                    "";

                document.getElementById("technicianEmail").value =
                    "";

                document.getElementById("technicianTestType").value =
                    "";

                document
                    .getElementById("technicianModal")
                    .classList.add("show");

            }


            // ============================================================
            // EDIT TECHNICIAN
            // ============================================================

            function editCurrentTechnician() {

                if (!currentTechnicianRow)
                    return;

                closeModal("technicianViewModal");

                const row =
                    currentTechnicianRow;

                document.getElementById("technicianId").value =
                    row.dataset.id;

                document.getElementById("technicianFirstName").value =
                    row.dataset.firstname || "";

                document.getElementById("technicianLastName").value =
                    row.dataset.lastname || "";

                document.getElementById("technicianEmployeeNumber").value =
                    row.dataset.employee || "";

                document.getElementById("technicianEmail").value =
                    row.dataset.email || "";

                document.getElementById("technicianTestType").value =
                    row.dataset.testtypeid || "";

                document.getElementById("technicianModalTitle").textContent =
                    "Edit Laboratory Technician";

                document.getElementById("technicianForm").action =
                    "/ManagerDashboard/EditTechnician";

                document
                    .getElementById("technicianModal")
                    .classList.add("show");

            }


            // ============================================================
            // CLOSE MODAL WHEN CLICKING OUTSIDE
            // ============================================================

            window.addEventListener("click", function (event) {

                document
                    .querySelectorAll(".modal")
                    .forEach(function (modal) {

                        if (event.target === modal) {

                            modal.classList.remove("show");

                        }

                    });

            });

    </script>

</body>

</html>