@using LabManager.Models
@model StaffViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Staff Management — NMB-HLabSys</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>

            *, *::before, *::after {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            :root {
                --bg: #081120;
                --navy: #0b1f3a;
                --card: #111c2d;
                --card2: #162338;
                --line: rgba(255,255,255,.06);
                --text: #f8fafc;
                --muted: #94a3b8;
                --blue: #3498db;
                --teal: #1abc9c;
                --orange: #f39c12;
                --red: #e74c3c;
                --green: #2ecc71;
                --font: 'DM Sans', sans-serif;
            }

            body {
                font-family: var(--font);
                background: #f5f7fb;
                color: var(--text);
                min-height: 100vh;
            }

            a {
                text-decoration: none;
            }

            /* TOPBAR */

            .topbar {
                height: 74px;
                background: #0b1f3a;
                border-bottom: 1px solid var(--line);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 28px;
                position: sticky;
                top: 0;
                z-index: 1000;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .brand-logo {
                width: 48px;
                height: 48px;
                border-radius: 14px;
                background: linear-gradient(135deg,#3498db,#1abc9c);
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 10px 25px rgba(52,152,219,.25);
            }

                .brand-logo svg {
                    width: 24px;
                    height: 24px;
                    fill: white;
                }

            .brand-name {
                display: flex;
                flex-direction: column;
                color: white;
                line-height: 1.1;
                font-weight: 700;
                font-size: 16px;
            }

                .brand-name span {
                    font-size: 11px;
                    font-weight: 500;
                    color: #b6c2d1;
                    margin-top: 3px;
                    letter-spacing: .5px;
                }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .user-chip {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 7px 14px;
                background: rgba(255,255,255,.08);
                border: 1px solid rgba(255,255,255,.08);
                border-radius: 999px;
            }

            .user-avatar {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: linear-gradient(135deg,#f39c12,#e67e22);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                font-weight: 700;
                color: white;
            }

            .user-email {
                font-size: 13px;
                color: #ffffff;
                font-weight: 500;
            }

            .logout-btn {
                height: 42px;
                padding: 0 18px;
                border-radius: 12px;
                background: rgba(231,76,60,.15);
                border: 1px solid rgba(231,76,60,.25);
                color: #ffb4ac;
                font-size: 13px;
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 8px;
                transition: .2s ease;
            }

                .logout-btn:hover {
                    background: rgba(231,76,60,.25);
                    color: white;
                }

                .logout-btn svg {
                    width: 16px;
                    height: 16px;
                }

            /* PAGE */

            .page {
                display: flex;
                min-height: calc(100vh - 74px);
            }

            /* SIDEBAR */

            .sidebar {
                width: 260px;
                background: #0b1f3a;
                border-right: 1px solid rgba(255,255,255,.05);
                padding: 26px 18px;
                position: sticky;
                top: 74px;
                height: calc(100vh - 74px);
            }

            .nav-label {
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: #93a4ba;
                margin: 18px 10px 12px;
                font-weight: 700;
            }

            .nav-item {
                height: 48px;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0 14px;
                border-radius: 14px;
                color: #d7e2f0;
                font-size: 14px;
                font-weight: 500;
                transition: .2s ease;
            }

                .nav-item svg {
                    width: 18px;
                    height: 18px;
                    stroke: currentColor;
                    fill: none;
                    stroke-width: 2;
                }

                .nav-item:hover {
                    background: rgba(255,255,255,.08);
                    transform: translateX(2px);
                }

                .nav-item.active {
                    background: linear-gradient(135deg,rgba(52,152,219,.25),rgba(26,188,156,.18));
                    border: 1px solid rgba(52,152,219,.25);
                    color: white;
                }

            /* MAIN */

            .main-content {
                flex: 1;
                padding: 34px;
            }

            .page-header {
                margin-bottom: 30px;
            }

                .page-header h1 {
                    font-size: 30px;
                    font-weight: 700;
                    margin-bottom: 8px;
                    color: #0b1f3a;
                }

                .page-header p {
                    color: #64748b;
                    font-size: 14px;
                }

            /* GRID */

            .content-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 24px;
            }

            /* CARDS */

            .card {
                background: white;
                border-radius: 24px;
                padding: 24px;
                border: 1px solid #e2e8f0;
                box-shadow: 0 10px 30px rgba(15,23,42,.06);
            }

            .card-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 20px;
            }

            .section-title {
                font-size: 15px;
                font-weight: 700;
                color: #0b1f3a;
            }

            .btn-add {
                height: 40px;
                padding: 0 16px;
                border: none;
                border-radius: 12px;
                background: linear-gradient(135deg,#3498db,#1abc9c);
                color: white;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                transition: .2s ease;
            }

                .btn-add:hover {
                    transform: translateY(-2px);
                }

            /* TABLE */

            .table-wrap {
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th {
                text-align: left;
                padding: 12px 10px;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: .7px;
                color: #64748b;
                border-bottom: 1px solid #e2e8f0;
            }

            td {
                padding: 16px 10px;
                border-bottom: 1px solid #edf2f7;
                font-size: 14px;
                color: #1e293b;
            }

            tr:last-child td {
                border-bottom: none;
            }

            tr:hover td {
                background: #f8fafc;
            }

            .staff-name {
                font-weight: 600;
                margin-bottom: 3px;
                color: #0f172a;
            }

            .staff-email {
                font-size: 12px;
                color: #64748b;
            }

            .mono {
                font-family: monospace;
                color: #2563eb;
                font-size: 12px;
            }

            .status-pill {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 6px 12px;
                border-radius: 999px;
                font-size: 12px;
                font-weight: 600;
            }

            .active {
                background: rgba(46,204,113,.12);
                color: #16a34a;
            }

            .inactive {
                background: rgba(148,163,184,.15);
                color: #64748b;
            }

            .dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: currentColor;
            }

            .tag {
                display: inline-flex;
                align-items: center;
                padding: 6px 12px;
                border-radius: 999px;
                background: rgba(155,89,182,.12);
                color: #9333ea;
                font-size: 12px;
                font-weight: 600;
            }

            /* MODAL */

            .modal-bg {
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.7);
                display: none;
                align-items: center;
                justify-content: center;
                z-index: 2000;
                padding: 20px;
            }

                .modal-bg.open {
                    display: flex;
                }

            .modal {
                width: 100%;
                max-width: 620px;
                background: #12233f;
                border-radius: 28px;
                border: 1px solid rgba(255,255,255,.08);
                padding: 30px;
                position: relative;
            }

                .modal h3 {
                    font-size: 24px;
                    margin-bottom: 6px;
                }

            .modal-sub {
                color: #94a3b8;
                font-size: 14px;
                margin-bottom: 24px;
            }

            .modal-close {
                position: absolute;
                top: 18px;
                right: 18px;
                width: 36px;
                height: 36px;
                border: none;
                border-radius: 10px;
                background: rgba(255,255,255,.05);
                color: white;
                cursor: pointer;
                font-size: 18px;
            }

                .modal-close:hover {
                    background: rgba(255,255,255,.12);
                }

            .form-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 16px;
            }

            .form-group {
                margin-bottom: 18px;
            }

            .form-label {
                display: block;
                margin-bottom: 7px;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: .7px;
                color: #94a3b8;
                font-weight: 700;
            }

            .form-input {
                width: 100%;
                height: 46px;
                padding: 0 14px;
                border-radius: 12px;
                border: 1px solid rgba(255,255,255,.08);
                background: rgba(255,255,255,.05);
                color: white;
                font-family: var(--font);
                font-size: 14px;
                outline: none;
            }

                .form-input:focus {
                    border-color: #3498db;
                }

            .checkbox-group {
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                margin-top: 10px;
            }

            .checkbox-item {
                display: flex;
                align-items: center;
                gap: 6px;
                padding: 8px 12px;
                border-radius: 10px;
                background: rgba(255,255,255,.05);
                border: 1px solid rgba(255,255,255,.08);
                font-size: 13px;
            }

            .modal-actions {
                display: flex;
                gap: 14px;
                margin-top: 26px;
            }

            .btn {
                flex: 1;
                height: 48px;
                border-radius: 14px;
                border: none;
                font-size: 14px;
                font-weight: 700;
                cursor: pointer;
                transition: .2s ease;
            }

            .btn-primary {
                background: linear-gradient(135deg,#3498db,#1abc9c);
                color: white;
            }

            .btn-outline {
                background: transparent;
                border: 1px solid rgba(255,255,255,.1);
                color: #d7e2f0;
            }

            @@media(max-width:1100px) {

                .content-grid {
                    grid-template-columns: 1fr;
                }
            }

            @@media(max-width:900px) {

                .sidebar {
                    display: none;
                }

                .main-content {
                    padding: 22px;
                }

                .form-grid {
                    grid-template-columns: 1fr;
                }

                .topbar {
                    padding: 0 18px;
                }

                .user-email {
                    display: none;
                }
            }

    </style>
</head>
<body>

    <!-- TOPBAR -->

    <div class="topbar">

        <a class="brand" asp-controller="Home" asp-action="Index">

            <div class="brand-logo">
                <svg viewBox="0 0 24 24">
                    <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z"></path>
                    <circle cx="12" cy="17" r="4" opacity="0.6"></circle>
                </svg>
            </div>

            <div class="brand-name">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>

        </a>

        <div class="topbar-right">

            <div class="user-chip">

                <div class="user-avatar">
                    @(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "M")
                </div>

                <span class="user-email">
                    @(ViewBag.Email ?? "Manager")
                </span>

            </div>

            <a asp-controller="Home"
               asp-action="Logout"
               class="logout-btn">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>

                </svg>

                Sign Out

            </a>

        </div>

    </div>

    <!-- PAGE -->

    <div class="page">

        <!-- SIDEBAR -->
       <aside class="sidebar">
        <div class="nav-label">Main</div>
        <a asp-controller="ManagerDashboard" asp-action="Index" class="nav-item active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
            Dashboard
        </a>
        <a asp-controller="ManagerDashboard" asp-action="TestCatalogue" class="nav-item">
            <svg viewBox="0 0 24 24"><path d="M9 3v11a3 3 0 006 0V3" /><line x1="6" y1="3" x2="18" y2="3" /></svg>
            Test Catalogue
        </a>
        <a asp-controller="ManagerDashboard" asp-action="Consumables" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
            Consumables
        </a>
        <a asp-controller="ManagerDashboard" asp-action="Staff" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
            Staff
        </a>
        <a asp-controller="ManagerDashboard" asp-action="Orders" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
            Orders
        </a>
        <a asp-controller="ManagerDashboard" asp-action="Report" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
            Reports
        </a>
        <div class="nav-label">System</div>
        <a asp-controller="ManagerDashboard" asp-action="Profile" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3" /><path d="M19.07 4.93A10 10 0 1 0 4.93 19.07 10 10 0 0 0 19.07 4.93z" /></svg>
            Profile
        </a>
        <a asp-controller="ManagerDashboard" asp-action="AuditLog" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
            Audit Log
        </a>
    </aside>

        <!-- MAIN CONTENT -->

        <main class="main-content">

            <div class="page-header">
                <h1>Staff Management</h1>
                <p>Manage doctors and laboratory technicians within the system.</p>
            </div>

            <div class="content-grid">

                <!-- DOCTORS -->

                <div class="card">

                    <div class="card-header">

                        <div class="section-title">
                            Doctors
                        </div>

                        <button class="btn-add"
                                onclick="openModal('doctorModal')">

                            + Add Doctor

                        </button>

                    </div>

                    <div class="table-wrap">

                        <table>

                            <thead>
                                <tr>
                                    <th>Doctor</th>
                                    <th>HPCSA</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (Model?.Doctors != null && Model.Doctors.Any())
                                {
                                    foreach (var d in Model.Doctors)
                                    {
                                        <tr>

                                            <td>

                                                <div class="staff-name">
                                                    @d.FullName
                                                </div>

                                                <div class="staff-email">
                                                    @d.Email
                                                </div>

                                            </td>

                                            <td>
                                                <span class="mono">
                                                    @d.HpcsaNumber
                                                </span>
                                            </td>

                                            <td>

                                                @if (d.IsActive)
                                                {
                                                    <span class="status-pill active">
                                                        <span class="dot"></span>
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-pill inactive">
                                                        <span class="dot"></span>
                                                        Inactive
                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3"
                                            style="text-align:center;padding:30px;color:var(--muted)">

                                            No doctors found.

                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

                <!-- TECHNICIANS -->

                <div class="card">

                    <div class="card-header">

                        <div class="section-title">
                            Laboratory Technicians
                        </div>

                        <button class="btn-add"
                                onclick="openModal('techModal')">

                            + Add Technician

                        </button>

                    </div>

                    <div class="table-wrap">

                        <table>

                            <thead>
                                <tr>
                                    <th>Technician</th>
                                    <th>Employee #</th>
                                    <th>Assigned Tests</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (Model?.Technicians != null && Model.Technicians.Any())
                                {
                                    foreach (var t in Model.Technicians)
                                    {
                                        <tr>

                                            <td>

                                                <div class="staff-name">
                                                    @t.FullName
                                                </div>

                                                <div class="staff-email">
                                                    @t.Email
                                                </div>

                                            </td>

                                            <td>
                                                <span class="mono">
                                                    @t.EmployeeNumber
                                                </span>
                                            </td>

                                            <td>
                                                <span class="tag">
                                                    @string.Join(", ", t.TestTypes)
                                                </span>
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3"
                                            style="text-align:center;padding:30px;color:var(--muted)">

                                            No technicians found.

                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </main>

    </div>

    <!-- DOCTOR MODAL -->

    <div class="modal-bg"
         id="doctorModal"
         onclick="bgClose(event,this)">

        <div class="modal">

            <button class="modal-close"
                    onclick="closeModal('doctorModal')">

                ✕

            </button>

            <h3>Add Doctor</h3>

            <p class="modal-sub">
                A temporary password will automatically be generated.
            </p>

            <form asp-controller="ManagerDashboard"
                  asp-action="AddDoctor"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="form-grid">

                    <div class="form-group">

                        <label class="form-label">
                            First Name
                        </label>

                        <input class="form-input"
                               name="firstName"
                               required />

                    </div>

                    <div class="form-group">

                        <label class="form-label">
                            Last Name
                        </label>

                        <input class="form-input"
                               name="lastName"
                               required />

                    </div>

                </div>

                <div class="form-grid">

                    <div class="form-group">

                        <label class="form-label">
                            HPCSA Number
                        </label>

                        <input class="form-input"
                               name="hpcsaNumber"
                               required />

                    </div>

                    <div class="form-group">

                        <label class="form-label">
                            Contact Number
                        </label>

                        <input class="form-input"
                               name="contactNumber" />

                    </div>

                </div>

                <div class="form-group">

                    <label class="form-label">
                        Email Address
                    </label>

                    <input class="form-input"
                           type="email"
                           name="email"
                           required />

                </div>

                <div class="modal-actions">

                    <button type="submit"
                            class="btn btn-primary">

                        Add Doctor

                    </button>

                    <button type="button"
                            class="btn btn-outline"
                            onclick="closeModal('doctorModal')">

                        Cancel

                    </button>

                </div>

            </form>

        </div>

    </div>

    <!-- TECH MODAL -->

    <div class="modal-bg"
         id="techModal"
         onclick="bgClose(event,this)">

        <div class="modal">

            <button class="modal-close"
                    onclick="closeModal('techModal')">

                ✕

            </button>

            <h3>Add Technician</h3>

            <p class="modal-sub">
                Assign laboratory test categories to the technician.
            </p>

            <form asp-controller="ManagerDashboard"
                  asp-action="AddTechnician"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="form-grid">

                    <div class="form-group">

                        <label class="form-label">
                            First Name
                        </label>

                        <input class="form-input"
                               name="firstName"
                               required />

                    </div>

                    <div class="form-group">

                        <label class="form-label">
                            Last Name
                        </label>

                        <input class="form-input"
                               name="lastName"
                               required />

                    </div>

                </div>

                <div class="form-grid">

                    <div class="form-group">

                        <label class="form-label">
                            Employee Number
                        </label>

                        <input class="form-input"
                               name="employeeNumber"
                               required />

                    </div>

                    <div class="form-group">

                        <label class="form-label">
                            Email Address
                        </label>

                        <input class="form-input"
                               type="email"
                               name="email"
                               required />

                    </div>

                </div>

                <div class="form-group">

                    <label class="form-label">
                        Test Categories
                    </label>

                    <div class="checkbox-group">

                        <label class="checkbox-item">
                            <input type="checkbox"
                                   name="testTypes"
                                   value="FBC" />
                            FBC
                        </label>

                        <label class="checkbox-item">
                            <input type="checkbox"
