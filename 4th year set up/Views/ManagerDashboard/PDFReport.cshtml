@using LabManager.Models
@model List<TestCategoryReport>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Lab Report</title>

    <style>

            :root {
                --navy: #0b1f3a;
                --teal: #0d9488;
                --teal-light: rgba(13,148,136,0.1);
                --white: #ffffff;
                --offwhite: #f4f7fb;
                --muted: #6b7a99;
                --border: #dde4f0;
            }

            * {
                box-sizing: border-box;
            }

            body {
                font-family: Arial;
                margin: 0;
                background: var(--offwhite);
                color: var(--navy);
            }

            /* ================= TOP NAVBAR ================= */

            .topbar {
                background: var(--navy);
                padding: 0 40px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                height: 64px;
                position: sticky;
                top: 0;
                z-index: 100;
                box-shadow: 0 2px 20px rgba(0,0,0,0.15);
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

            .brand-logo {
                width: 34px;
                height: 34px;
                background: var(--teal);
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .brand-logo svg {
                    width: 18px;
                    height: 18px;
                    fill: white;
                }

            .brand-name {
                color: white;
                font-size: 1.1rem;
                font-weight: bold;
                line-height: 1.1;
            }

                .brand-name span {
                    display: block;
                    font-size: 0.6rem;
                    font-weight: normal;
                    color: rgba(255,255,255,0.5);
                    letter-spacing: 0.1em;
                    text-transform: uppercase;
                }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .user-chip {
                display: flex;
                align-items: center;
                gap: 10px;
                background: rgba(255,255,255,0.07);
                border: 1px solid rgba(255,255,255,0.1);
                border-radius: 100px;
                padding: 6px 14px 6px 8px;
            }

            .user-avatar {
                width: 28px;
                height: 28px;
                background: var(--teal);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.75rem;
                font-weight: 600;
                color: white;
            }

            .user-email {
                font-size: 0.8rem;
                color: rgba(255,255,255,0.75);
            }

            .logout-btn {
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.12);
                color: rgba(255,255,255,0.8);
                padding: 8px 16px;
                border-radius: 8px;
                text-decoration: none;
                font-size: 0.82rem;
            }

                .logout-btn:hover {
                    background: rgba(255,255,255,0.15);
                    color: white;
                }


            /* ================= PAGE LAYOUT ================= */

            .page {
                display: flex;
                min-height: calc(100vh - 64px);
            }


            /* ================= SIDEBAR ================= */

            .sidebar {
                width: 220px;
                background: white;
                border-right: 1px solid var(--border);
                padding: 24px 0;
                flex-shrink: 0;
                position: sticky;
                top: 64px;
                height: calc(100vh - 64px);
            }

            .nav-section {
                margin-bottom: 8px;
            }

            .nav-label {
                font-size: 0.65rem;
                font-weight: bold;
                color: var(--muted);
                letter-spacing: 0.1em;
                text-transform: uppercase;
                padding: 0 20px;
                margin-bottom: 4px;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 20px;
                color: var(--muted);
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 500;
                border-left: 3px solid transparent;
            }

                .nav-item:hover {
                    background: var(--offwhite);
                    color: var(--navy);
                }

                .nav-item.active {
                    background: var(--teal-light);
                    color: var(--teal);
                    border-left-color: var(--teal);
                }


            /* ================= REPORT CONTENT ================= */

            .main {
                flex: 1;
                padding: 40px;
                overflow-y: auto;
            }

            .report-container {
                background: white;
                padding: 30px;
                border-radius: 12px;
                border: 1px solid var(--border);
            }


            /* ================= YOUR ORIGINAL REPORT ================= */

            h1 {
                color: #0b1f3a;
                margin-bottom: 10px;
            }

            .range {
                margin-bottom: 20px;
                color: #555;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th, td {
                border: 1px solid #ddd;
                padding: 12px;
                text-align: left;
            }

            th {
                background: #0d9488;
                color: white;
            }

            @@media (max-width: 768px) {

                .sidebar {
                    display: none;
                }

                .topbar {
                    padding: 0 20px;
                }

                .user-email {
                    display: none;
                }

                .main {
                    padding: 20px;
                }
            }
    </style>
</head>

<body>


    <!-- ================= TOP NAVBAR ================= -->

    <div class="topbar">

        <a class="brand"
           asp-controller="ManagerDashboard"
           asp-action="Index">

            <div class="brand-logo">
                <svg viewBox="0 0 24 24">
                    <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" />
                    <circle cx="12" cy="17" r="4" opacity="0.6" />
                </svg>
            </div>

            <div class="brand-name">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>

        </a>


        <div class="topbar-right">

            <div class="user-chip">
                <div class="user-avatar">
                    @(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "M")
                </div>

                <span class="user-email">
                    @ViewBag.Email
                </span>
            </div>


            <a asp-controller="Home"
               asp-action="Logout"
               class="logout-btn">

                Sign Out

            </a>

        </div>

    </div>



    <!-- ================= PAGE ================= -->

    <div class="page">


        <!-- ================= SIDEBAR ================= -->

        <aside class="sidebar">

            <div class="nav-section">

                <div class="nav-label">Main</div>


                <a asp-controller="ManagerDashboard"
                   asp-action="Index"
                   class="nav-item">

                    Dashboard

                </a>


                <a asp-controller="ManagerDashboard"
                   asp-action="TestCatalogue"
                   class="nav-item">

                    Test Catalogue

                </a>


                <a asp-controller="ManagerDashboard"
                   asp-action="Consumables"
                   class="nav-item">

                    Consumables

                </a>


                <a asp-controller="ManagerDashboard"
                   asp-action="Staff"
                   class="nav-item">

                    Staff

                </a>


                <a asp-controller="ManagerDashboard"
                   asp-action="Orders"
                   class="nav-item">

                    Orders

                </a>


                <a asp-controller="ManagerDashboard"
                   asp-action="TestsByCategory"
                   class="nav-item active">

                    Reports

                </a>

            </div>


            <div class="nav-section">

                <div class="nav-label">System</div>


                <a asp-controller="ManagerDashboard"
                   asp-action="Profile"
                   class="nav-item">

                    Profile

                </a>


                <a asp-controller="ManagerDashboard"
                   asp-action="AuditLog"
                   class="nav-item">

                    Audit Log

                </a>

            </div>

        </aside>



        <!-- ================= MAIN REPORT ================= -->

        <main class="main">

            <div class="report-container">


                <!-- YOUR ORIGINAL REPORT STRUCTURE -->

                <h1>Laboratory Test Report</h1>

                <div class="range">
                    From: @ViewBag.StartDate.ToString("dd MMM yyyy")
                    |
                    To: @ViewBag.EndDate.ToString("dd MMM yyyy")
                </div>


                <table>

                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Total Tests</th>
                        </tr>
                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Category</td>
                                <td>@item.TotalTests</td>
                            </tr>
                        }

                    </tbody>

                </table>


            </div>

        </main>


    </div>


</body>
</html>