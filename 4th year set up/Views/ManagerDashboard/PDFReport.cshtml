
@using LabManager.Models
@model List<TestCategoryReport>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Lab Report</title>

    <style>
            body {
                font-family: Arial;
                padding: 30px;
            }

            h1 {
                color: #0b1f3a;
                margin-bottom: 10px;
            }

            .range {
                margin-bottom: 20px;
                color: #555;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th, td {
                border: 1px solid #ddd;
                padding: 12px;
                text-align: left;
            }

            th {
                background: #0d9488;
                color: white;
            }
    </style>
</head>

<body>

    <h1>Laboratory Test Report</h1>

    <div class="range">
        From: @ViewBag.StartDate.ToString("dd MMM yyyy")
        |
        To: @ViewBag.EndDate.ToString("dd MMM yyyy")
    </div>

    <table>
        <thead>
            <tr>
                <th>Category</th>
                <th>Total Tests</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Category</td>
                    <td>@item.TotalTests</td>
                </tr>
            }
        </tbody>
    </table>

</body>
</html>