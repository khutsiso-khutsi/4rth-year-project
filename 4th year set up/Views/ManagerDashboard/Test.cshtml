@using LabManager.Models;
@model IEnumerable<TestCatalogue>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Test Catalogue — NMB-HLabSys</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <style>

            *, *::before, *::after {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            :root {
                --bg: #f4f7fb;
                --sidebar: #0b1f3a;
                --topbar: #0b1f3a;
                --panel: #ffffff;
                --border: #e2e8f0;
                --blue: #3498db;
                --teal: #1abc9c;
                --red: #e74c3c;
                --amber: #f39c12;
                --text: #1e293b;
                --muted: #94a3b8;
                --muted-2: #64748b;
                --font: 'DM Sans', sans-serif;
            }

            body {
                font-family: var(--font);
                background: var(--bg);
                color: var(--text);
                min-height: 100vh;
            }

            a {
                text-decoration: none;
            }

            /* TOPBAR */

            .topbar {
                height: 74px;
                background: var(--topbar);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 28px;
                position: sticky;
                top: 0;
                z-index: 999;
                border-bottom: 1px solid rgba(255,255,255,.06);
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .brand-logo {
                width: 48px;
                height: 48px;
                border-radius: 14px;
                background: linear-gradient(135deg,#3498db,#1abc9c);
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .brand-logo svg {
                    width: 24px;
                    height: 24px;
                    fill: white;
                }

            .brand-name {
                display: flex;
                flex-direction: column;
                color: white;
                font-size: 17px;
                font-weight: 700;
            }

                .brand-name span {
                    font-size: 11px;
                    font-weight: 500;
                    color: #cbd5e1;
                    margin-top: 3px;
                }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .user-chip {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 7px 14px;
                border-radius: 999px;
                background: rgba(255,255,255,.08);
                border: 1px solid rgba(255,255,255,.08);
            }

            .user-avatar {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: linear-gradient(135deg,#f39c12,#e67e22);
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 13px;
                font-weight: 700;
            }

            .user-email {
                color: white;
                font-size: 13px;
                font-weight: 500;
            }

            .logout-btn {
                height: 42px;
                padding: 0 18px;
                border-radius: 12px;
                background: rgba(231,76,60,.14);
                border: 1px solid rgba(231,76,60,.18);
                color: #ffc7c1;
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 13px;
                font-weight: 600;
                transition: .2s ease;
            }

                .logout-btn:hover {
                    background: rgba(231,76,60,.24);
                    color: white;
                }

                .logout-btn svg {
                    width: 16px;
                    height: 16px;
                }

            /* PAGE */

            .page {
                display: flex;
                min-height: calc(100vh - 74px);
            }

            /* SIDEBAR */

            .sidebar {
                width: 260px;
                background: var(--sidebar);
                padding: 24px 18px;
                border-right: 1px solid rgba(255,255,255,.05);
                position: sticky;
                top: 74px;
                height: calc(100vh - 74px);
            }

            .nav-label {
                margin: 18px 12px 12px;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: #94a3b8;
            }

            .nav-item {
                height: 48px;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0 14px;
                border-radius: 14px;
                color: #dbe7f4;
                font-size: 14px;
                font-weight: 500;
                transition: .2s ease;
            }

                .nav-item svg {
                    width: 18px;
                    height: 18px;
                    stroke: currentColor;
                    fill: none;
                    stroke-width: 2;
                }

                .nav-item:hover {
                    background: rgba(255,255,255,.06);
                    transform: translateX(2px);
                }

                .nav-item.active {
                    background: rgba(255,255,255,.10);
                    color: white;
                }

            /* MAIN CONTENT */

            .main-content {
                flex: 1;
                padding: 34px;
            }

            .page-header {
                margin-bottom: 28px;
            }

                .page-header h1 {
                    font-size: 30px;
                    font-weight: 700;
                    color: #0f172a;
                    margin-bottom: 8px;
                }

                .page-header p {
                    color: var(--muted-2);
                    font-size: 14px;
                }

            /* CARD */

            .card {
                background: var(--panel);
                border-radius: 22px;
                border: 1px solid var(--border);
                padding: 28px;
                box-shadow: 0 10px 30px rgba(15,23,42,.06);
            }

            /* TOOLBAR */

            .toolbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                margin-bottom: 24px;
                flex-wrap: wrap;
            }

            .search-box {
                flex: 1;
                max-width: 320px;
                min-width: 220px;
            }

            .search-input {
                width: 100%;
                height: 46px;
                padding: 0 16px;
                border-radius: 12px;
                border: 1px solid #dbe4ef;
                background: #f8fafc;
                color: #0f172a;
                font-size: 14px;
                outline: none;
            }

                .search-input::placeholder {
                    color: #94a3b8;
                }

            .action-group {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
            }

            .btn {
                height: 44px;
                padding: 0 18px;
                border: none;
                border-radius: 12px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                transition: .2s ease;
            }

                .btn:hover {
                    transform: translateY(-1px);
                }

            .btn-amber {
                background: rgba(243,156,18,.12);
                color: #d68910;
            }

            .btn-teal {
                background: rgba(26,188,156,.12);
                color: #0f9f84;
            }

            /* TABLE */

            .table-wrap {
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            thead th {
                padding: 14px;
                text-align: left;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: .7px;
                text-transform: uppercase;
                color: #64748b;
                border-bottom: 1px solid #e2e8f0;
            }

            tbody td {
                padding: 18px 14px;
                border-bottom: 1px solid #eef2f7;
                font-size: 14px;
                color: #334155;
            }

            tbody tr:hover td {
                background: #f8fafc;
            }

            .test-name {
                font-weight: 600;
                color: #0f172a;
            }

            .badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 6px 12px;
                border-radius: 999px;
                font-size: 11px;
                font-weight: 600;
            }

            .badge-blue {
                background: rgba(52,152,219,.12);
                color: #2980b9;
            }

            .badge-green {
                background: rgba(26,188,156,.12);
                color: #0f9f84;
            }

            .actions {
                display: flex;
                gap: 8px;
            }

            .action-btn {
                height: 34px;
                padding: 0 14px;
                border: none;
                border-radius: 10px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                transition: .2s ease;
            }

            .edit-btn {
                background: rgba(52,152,219,.12);
                color: #2980b9;
            }

            .delete-btn {
                background: rgba(231,76,60,.12);
                color: #d63031;
            }

            .action-btn:hover {
                transform: translateY(-1px);
            }

    </style>

</head>

<body>

    <!-- TOPBAR -->

    <div class="topbar">

        <a class="brand"
           asp-controller="Home"
           asp-action="Index">

            <div class="brand-logo">

                <svg viewBox="0 0 24 24">

                    <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" />

                    <circle cx="12"
                            cy="17"
                            r="4"
                            opacity="0.6" />

                </svg>

            </div>

            <div class="brand-name">

                NMB-HLabSys

                <span>
                    Haematology Lab System
                </span>

            </div>

        </a>

        <div class="topbar-right">

            <div class="user-chip">

                <div class="user-avatar">
                    @(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "M")
                </div>

                <span class="user-email">
                    @(ViewBag.Email ?? "Manager")
                </span>

            </div>

            <a asp-controller="Home"
               asp-action="Logout"
               class="logout-btn">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round">

                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />

                    <polyline points="16 17 21 12 16 7" />

                    <line x1="21"
                          y1="12"
                          x2="9"
                          y2="12" />

                </svg>

                Sign Out

            </a>

        </div>

    </div>

    <!-- PAGE -->

    <div class="page">

        <!-- SIDEBAR -->

        <aside class="sidebar">

            <div class="nav-label">Main</div>

            <a asp-controller="ManagerDashboard"
               asp-action="Index"
               class="nav-item">

                <svg viewBox="0 0 24 24">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>

                Dashboard

            </a>

            <a asp-controller="ManagerDashboard"
               asp-action="TestCatalogue"
               class="nav-item active">

                <svg viewBox="0 0 24 24">
                    <path d="M9 3v11a3 3 0 006 0V3" />
                    <line x1="6" y1="3" x2="18" y2="3" />
                </svg>

                Test Catalogue

            </a>

            <a asp-controller="ManagerDashboard"
               asp-action="Consumables"
               class="nav-item">

                <svg viewBox="0 0 24 24">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                </svg>

                Consumables

            </a>

            <a asp-controller="ManagerDashboard"
               asp-action="Staff"
               class="nav-item">

                <svg viewBox="0 0 24 24">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>

                Staff

            </a>

            <a asp-controller="ManagerDashboard"
               asp-action="Orders"
               class="nav-item">

                <svg viewBox="0 0 24 24">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                </svg>

                Orders

            </a>

            <a asp-controller="ManagerDashboard"
               asp-action="Report"
               class="nav-item">

                <svg viewBox="0 0 24 24">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                </svg>

                Reports

            </a>

            <div class="nav-label">System</div>

            <a asp-controller="ManagerDashboard"
               asp-action="Profile"
               class="nav-item">

                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.07 4.93A10 10 0 1 0 4.93 19.07 10 10 0 0 0 19.07 4.93z" />
                </svg>

                Profile

            </a>

            <a asp-controller="ManagerDashboard"
               asp-action="AuditLog"
               class="nav-item">

                <svg viewBox="0 0 24 24">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>

                Audit Log

            </a>

        </aside>

        <!-- MAIN CONTENT -->

        <main class="main-content">

            <div class="page-header">

                <h1>Test Catalogue</h1>

                <p>
                    Manage haematology tests, categories,
                    sample types and turnaround times.
                </p>

            </div>

            <div class="card">

                <div class="toolbar">

                    <div class="search-box">

                        <input type="text"
                               id="searchInput"
                               class="search-input"
                               placeholder="Search tests..." />

                    </div>

                    <div class="action-group">

                        <button class="btn btn-amber">
                            + Category
                        </button>

                        <button class="btn btn-teal">
                            + Test Type
                        </button>

                    </div>

                </div>

                <div class="table-wrap">

                    <table id="testTable">

                        <thead>

                            <tr>

                                <th>Test Name</th>
                                <th>Category</th>
                                <th>Sample Type</th>
                                <th>Units</th>
                                <th>Normal Range</th>
                                <th>TAT</th>
                                <th>Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (Model != null && Model.Any())
                            {
                                foreach (var t in Model)
                                {
                                    <tr>

                                        <td class="test-name">
                                            @t.TestName
                                        </td>

                                        <td>
                                            <span class="badge badge-blue">
                                                @t.Category
                                            </span>
                                        </td>

                                        <td>@t.SampleType</td>

                                        <td>@t.Units</td>

                                        <td>@t.NormalRange</td>

                                        <td>
                                            <span class="badge badge-green">
                                                @t.TAT mins
                                            </span>
                                        </td>

                                        <td>

                                            <div class="actions">

                                                <button class="action-btn edit-btn">
                                                    Edit
                                                </button>

                                                <a asp-controller="ManagerDashboard"
                                                   asp-action="DeleteTest"
                                                   asp-route-id="@t.TestId"
                                                   class="action-btn delete-btn"
                                                   onclick="return confirm('Delete @t.TestName?')">

                                                    Delete

                                                </a>

                                            </div>

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="7"
                                        style="text-align:center;padding:40px;color:var(--muted)">

                                        No test catalogue records found.

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </main>

    </div>

    <script>

            const searchInput = document.getElementById("searchInput");

            searchInput.addEventListener("keyup", function () {

                const searchValue = this.value.toLowerCase();

                const tableRows = document.querySelectorAll("#testTable tbody tr");

                tableRows.forEach(row => {

                    const rowText = row.textContent.toLowerCase();

                    if (rowText.includes(searchValue)) {

                        row.style.display = "";

                    }
                    else {

                        row.style.display = "none";

                    }

                });

            });

    </script>

</body>
</html>