@using LabManager.Models
@model IEnumerable<TestType>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    ViewData["Title"] = "Test Catalogue";
    var categories = ViewBag.Categories as IEnumerable<TestCategory> ?? Enumerable.Empty<TestCategory>();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Test Catalogue — NMB-HLabSys</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap"
          rel="stylesheet" />

    <style>

            :root {
                --navy: #0b1f3a;
                --navy-dark: #071629;
                --teal: #0f766e;
                --teal-light: #14b8a6;
                --teal-soft: #e6fffb;
                --white: #ffffff;
                --bg: #f5f7fa;
                --border: #dfe5eb;
                --text: #172033;
                --muted: #6b7280;
                --danger: #dc2626;
                --danger-soft: #fee2e2;
                --success: #15803d;
                --success-soft: #dcfce7;
                --warning: #d97706;
                --warning-soft: #fef3c7;
                --shadow: 0 8px 24px rgba(11, 31, 58, 0.08);
                --radius: 12px;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: "DM Sans", sans-serif;
                background: var(--bg);
                color: var(--text);
            }

            .topbar {
                height: 70px;
                background: var(--navy);
                color: white;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 28px;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 1000;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .brand-icon {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                background: var(--teal);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
            }

            .brand-text {
                display: flex;
                flex-direction: column;
            }

            .brand-name {
                font-family: "DM Serif Display", serif;
                font-size: 20px;
                line-height: 1;
            }

            .brand-subtitle {
                font-size: 11px;
                opacity: .7;
                margin-top: 4px;
            }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 18px;
            }

            .user-info {
                text-align: right;
            }

            .user-name {
                font-size: 13px;
                font-weight: 600;
            }

            .user-role {
                font-size: 11px;
                opacity: .65;
            }

            .avatar {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: var(--teal);
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
            }

            .sidebar {
                position: fixed;
                top: 70px;
                bottom: 0;
                left: 0;
                width: 245px;
                background: var(--white);
                border-right: 1px solid var(--border);
                padding: 25px 15px;
                z-index: 900;
            }

            .nav-section-title {
                font-size: 10px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: var(--muted);
                padding: 0 12px 10px;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 13px;
                border-radius: 9px;
                margin-bottom: 5px;
                color: #465268;
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                transition: .2s;
            }

                .nav-item:hover {
                    background: #f0fdfa;
                    color: var(--teal);
                }

                .nav-item.active {
                    background: var(--teal-soft);
                    color: var(--teal);
                    font-weight: 700;
                }

            .nav-icon {
                width: 20px;
                text-align: center;
                font-size: 16px;
            }

            .main {
                margin-left: 245px;
                padding: 100px 30px 40px;
            }

            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                margin-bottom: 25px;
            }

            .page-title {
                margin: 0;
                font-family: "DM Serif Display", serif;
                font-size: 32px;
                color: var(--navy);
            }

            .page-description {
                margin: 6px 0 0;
                font-size: 14px;
                color: var(--muted);
            }

            .btn {
                border: none;
                border-radius: 8px;
                padding: 10px 17px;
                font-family: inherit;
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 7px;
                text-decoration: none;
                transition: .2s;
            }

            .btn-primary {
                background: var(--teal);
                color: white;
            }

                .btn-primary:hover {
                    background: #0b625c;
                }

            .btn-secondary {
                background: #eef2f6;
                color: #374151;
            }

                .btn-secondary:hover {
                    background: #e2e8f0;
                }

            .btn-danger {
                background: var(--danger);
                color: white;
            }

                .btn-danger:hover {
                    background: #b91c1c;
                }

            .alert {
                padding: 13px 16px;
                border-radius: 9px;
                margin-bottom: 20px;
                font-size: 13px;
                font-weight: 600;
            }

            .alert-success {
                background: var(--success-soft);
                color: var(--success);
                border: 1px solid #bbf7d0;
            }

            .alert-error {
                background: var(--danger-soft);
                color: var(--danger);
                border: 1px solid #fecaca;
            }

            .card {
                background: var(--white);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                box-shadow: var(--shadow);
                overflow: hidden;
            }

            .card-header {
                padding: 18px 22px;
                border-bottom: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .card-title {
                font-size: 15px;
                font-weight: 700;
            }

            .record-count {
                font-size: 12px;
                color: var(--muted);
            }

            .table-container {
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 950px;
            }

            th {
                background: #f8fafc;
                color: #64748b;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: .5px;
                font-weight: 700;
                padding: 13px 15px;
                text-align: left;
                border-bottom: 1px solid var(--border);
            }

            td {
                padding: 15px;
                border-bottom: 1px solid #edf0f3;
                font-size: 13px;
                vertical-align: middle;
            }

            tr:hover td {
                background: #fbfdfd;
            }

            .test-name {
                font-weight: 700;
                color: var(--navy);
            }

            .category-badge {
                display: inline-block;
                padding: 5px 9px;
                border-radius: 20px;
                background: var(--teal-soft);
                color: var(--teal);
                font-size: 11px;
                font-weight: 700;
            }

            .sample-badge {
                display: inline-block;
                padding: 5px 9px;
                border-radius: 20px;
                background: #f1f5f9;
                color: #475569;
                font-size: 11px;
                font-weight: 600;
            }

            .range {
                font-weight: 600;
                color: #334155;
            }

            .tat {
                font-weight: 700;
                color: var(--navy);
            }

            .actions {
                display: flex;
                gap: 7px;
            }

            .action-btn {
                border: none;
                width: 34px;
                height: 34px;
                border-radius: 7px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
            }

            .edit-btn {
                background: #e0f2fe;
                color: #0369a1;
            }

                .edit-btn:hover {
                    background: #bae6fd;
                }

            .delete-btn {
                background: var(--danger-soft);
                color: var(--danger);
            }

                .delete-btn:hover {
                    background: #fecaca;
                }

            .empty-state {
                text-align: center;
                padding: 55px 20px;
                color: var(--muted);
            }

            .empty-icon {
                font-size: 40px;
                margin-bottom: 10px;
            }

            .empty-title {
                font-weight: 700;
                color: var(--navy);
                margin-bottom: 5px;
            }

            .modal-overlay {
                position: fixed;
                inset: 0;
                background: rgba(7, 22, 41, .62);
                display: none;
                align-items: center;
                justify-content: center;
                padding: 20px;
                z-index: 2000;
            }

                .modal-overlay.show {
                    display: flex;
                }

            .modal {
                width: 100%;
                max-width: 650px;
                max-height: 90vh;
                overflow-y: auto;
                background: white;
                border-radius: 14px;
                box-shadow: 0 25px 70px rgba(0,0,0,.25);
                animation: modalIn .2s ease;
            }

            @@keyframes modalIn {

                from {
                    opacity: 0;
                    transform: translateY(15px) scale(.98);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            .modal-header {
                padding: 20px 22px;
                border-bottom: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .modal-title {
                font-family: "DM Serif Display", serif;
                font-size: 22px;
                color: var(--navy);
                margin: 0;
            }

            .close-btn {
                width: 32px;
                height: 32px;
                border: none;
                border-radius: 7px;
                background: #f1f5f9;
                color: #475569;
                cursor: pointer;
                font-size: 18px;
            }

                .close-btn:hover {
                    background: #e2e8f0;
                }

            .modal-body {
                padding: 22px;
            }

            .modal-footer {
                padding: 16px 22px;
                border-top: 1px solid var(--border);
                display: flex;
                justify-content: flex-end;
                gap: 10px;
            }

            .form-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 17px;
            }

            .form-group {
                display: flex;
                flex-direction: column;
                gap: 7px;
            }

                .form-group.full {
                    grid-column: 1 / -1;
                }

            .form-label {
                font-size: 12px;
                font-weight: 700;
                color: #374151;
            }

            .required {
                color: var(--danger);
            }

            .form-control {
                width: 100%;
                border: 1px solid #cfd7e2;
                border-radius: 8px;
                padding: 11px 12px;
                font-family: inherit;
                font-size: 13px;
                color: var(--text);
                outline: none;
                background: white;
            }

                .form-control:focus {
                    border-color: var(--teal);
                    box-shadow: 0 0 0 3px rgba(15,118,110,.1);
                }

            textarea.form-control {
                min-height: 80px;
                resize: vertical;
            }

            .form-help {
                font-size: 11px;
                color: var(--muted);
            }

            .delete-content {
                text-align: center;
                padding: 10px 10px 5px;
            }

            .delete-icon {
                width: 55px;
                height: 55px;
                margin: 0 auto 15px;
                border-radius: 50%;
                background: var(--danger-soft);
                color: var(--danger);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 25px;
            }

            .delete-title {
                font-size: 18px;
                font-weight: 700;
                color: var(--navy);
            }

            .delete-message {
                margin: 8px 0 0;
                color: var(--muted);
                font-size: 13px;
                line-height: 1.6;
            }

            .footer {
                margin-top: 30px;
                display: flex;
                justify-content: space-between;
                color: var(--muted);
                font-size: 11px;
            }

            @@media (max-width: 850px) {

                .sidebar {
                    width: 70px;
                    padding: 20px 8px;
                }

                .nav-section-title,
                .nav-text {
                    display: none;
                }

                .nav-item {
                    justify-content: center;
                }

                .main {
                    margin-left: 70px;
                }

                .user-info {
                    display: none;
                }
            }

            @@media (max-width: 650px) {

                .main {
                    padding: 90px 15px 30px;
                }

                .page-header {
                    flex-direction: column;
                    gap: 15px;
                }

                .form-grid {
                    grid-template-columns: 1fr;
                }

                .form-group.full {
                    grid-column: auto;
                }

                .footer {
                    flex-direction: column;
                    gap: 5px;
                }
            }
    </style>

</head>

<body>

    <!-- =========================
         TOPBAR
    ========================= -->

    <header class="topbar">

        <div class="brand">

            <div class="brand-icon">
                🧪
            </div>

            <div class="brand-text">

                <div class="brand-name">
                    NMB-HLabSys
                </div>

                <div class="brand-subtitle">
                    Haematology Laboratory System
                </div>

            </div>

        </div>

        <div class="topbar-right">

            <div class="user-info">

                <div class="user-name">
                    @(ViewBag.Email ?? "Laboratory Manager")
                </div>

                <div class="user-role">
                    Laboratory Management
                </div>

            </div>

            <div class="avatar">
                LM
            </div>

        </div>

    </header>


    <!-- =========================
         SIDEBAR
    ========================= -->

    <aside class="sidebar">

        <div class="nav-section-title">
            Management
        </div>

        <a asp-controller="ManagerDashboard" asp-action="Index"
           class="nav-item">

            <span class="nav-icon">▦</span>

            <span class="nav-text">
                Dashboard
            </span>

        </a>

        <a asp-controller="TestCatalogue" asp-action="Index"
           class="nav-item active">

            <span class="nav-icon">🧪</span>

            <span class="nav-text">
                Test Catalogue
            </span>

        </a>

        <a asp-controller="Consumable" asp-action="Index"
           class="nav-item">

            <span class="nav-icon">📦</span>

            <span class="nav-text">
                Consumables
            </span>

        </a>

        <a asp-controller="Doctor" asp-action="Index"
           class="nav-item">

            <span class="nav-icon">👨‍⚕️</span>

            <span class="nav-text">
                Doctors
            </span>

        </a>

        <a asp-controller="Technician" asp-action="Index"
           class="nav-item">

            <span class="nav-icon">👤</span>

            <span class="nav-text">
                Technicians
            </span>

        </a>

        <a asp-controller="Report" asp-action="Index"
           class="nav-item">

            <span class="nav-icon">📊</span>

            <span class="nav-text">
                Reports
            </span>

        </a>

    </aside>


    <!-- =========================
         MAIN CONTENT
    ========================= -->

    <main class="main">

        <!-- PAGE HEADER -->

        <div class="page-header">

            <div>

                <h1 class="page-title">
                    Test Catalogue
                </h1>

                <p class="page-description">
                    Manage laboratory test types, reference ranges,
                    sample types and turnaround times.
                </p>

            </div>

            <button type="button"
                    class="btn btn-primary"
                    onclick="openAddModal()">

                <span>＋</span>

                Add Test Type

            </button>

        </div>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                ✓ @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">
                ⚠ @TempData["Error"]
            </div>
        }


        <!-- =========================
             TEST TABLE
        ========================= -->

        <div class="card">

            <div class="card-header">

                <div class="card-title">
                    Laboratory Test Types
                </div>

                <div class="record-count">

                    @(Model?.Count() ?? 0) test type(s)

                </div>

            </div>


            @if (Model != null && Model.Any())
            {

                <div class="table-container">

                    <table>

                        <thead>

                            <tr>

                                <th>Test</th>
                                <th>Category</th>
                                <th>Sample Type</th>
                                <th>Unit</th>
                                <th>Normal Range</th>
                                <th>TAT</th>
                                <th>Consumables</th>
                                <th>Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var test in Model)
                            {

                                <tr>

                                    <!-- TEST -->

                                    <td>
                                        <div class="test-name">
                                            @test.TestName
                                        </div>
                                    </td>


                                    <!-- CATEGORY -->

                                    <td>
                                        <span class="category-badge">
                                            @(test.CategoryName ?? "Uncategorised")
                                        </span>
                                    </td>


                                    <!-- SAMPLE TYPE -->

                                    <td>
                                        <span class="sample-badge">
                                            @test.SampleTypeId
                                        </span>
                                    </td>


                                    <!-- UNIT -->

                                    <td>
                                        @(test.UnitMeasurement ?? "—")
                                    </td>


                                    <!-- NORMAL RANGE -->

                                    <td>
                                        <span class="range">
                                            @test.NormalRangeDisplay
                                        </span>
                                    </td>


                                    <!-- TAT -->

                                    <td>
                                        <span class="tat">
                                            @test.TurnaroundTime hrs
                                        </span>
                                    </td>


                                    <!-- CONSUMABLES -->

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(test.ConsumablesUsed))
                                        {
                                            @test.ConsumablesUsed
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">
                                                None
                                            </span>
                                        }
                                    </td>


                                    <!-- ACTIONS -->

                                    <td>

                                        <div class="actions">

                                            <!-- EDIT -->

                                            <button type="button"
                                                    class="action-btn edit-btn"
                                                    title="Edit"
                                                    onclick="openEditModal(
                                                @test.TestId,
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(test.TestName ?? ""))',
                                                @test.CategoryId,
                                                @test.SampleTypeId,
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(test.UnitMeasurement ?? ""))',
                                                '@(test.NormalRangeMin?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")',
                                                '@(test.NormalRangeMax?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")',
                                                @test.TurnaroundTime,
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(test.ConsumablesUsed ?? ""))'
                                                )">

                                                ✎

                                            </button>


                                            <!-- DELETE -->

                                            <button type="button"
                                                    class="action-btn delete-btn"
                                                    title="Delete"
                                                    onclick="openDeleteModal(
                                                @test.TestId,
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(test.TestName ?? ""))'
                                                )">

                                                🗑

                                            </button>

                                        </div>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="empty-state">

                    <div class="empty-icon">
                        🧪
                    </div>

                    <div class="empty-title">
                        No test types found
                    </div>

                    <div>
                        Add your first laboratory test type to the catalogue.
                    </div>

                    <br />

                    <button type="button"
                            class="btn btn-primary"
                            onclick="openAddModal()">

                        ＋ Add Test Type

                    </button>

                </div>

            }

        </div>


        <!-- FOOTER -->

        <div class="footer">

            <span>
                NMB-HLabSys · Haematology Laboratory System
            </span>

            <span>
                Internal management system · @DateTime.Now.ToString("yyyy")
            </span>

        </div>

    </main>


    <!-- =====================================================
         ADD TEST TYPE MODAL
    ====================================================== -->

    <div id="addModal"
         class="modal-overlay">

        <div class="modal">

            <form asp-controller="TestCatalogue"
                  asp-action="AddTestType"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h2 class="modal-title">
                        Add Test Type
                    </h2>

                    <button type="button"
                            class="close-btn"
                            onclick="closeModal('addModal')">

                        ×

                    </button>

                </div>


                <div class="modal-body">

                    <div class="form-grid">


                        <!-- TEST NAME -->

                        <div class="form-group full">

                            <label class="form-label">
                                Test Name
                                <span class="required">*</span>
                            </label>

                            <input type="text"
                                   name="TestName"
                                   class="form-control"
                                   placeholder="e.g. Full Blood Count"
                                   required />

                        </div>


                        <!-- CATEGORY -->

                        <div class="form-group">

                            <label class="form-label">
                                Category
                                <span class="required">*</span>
                            </label>

                            <select name="CategoryId"
                                    class="form-control"
                                    required>

                                <option value="">
                                    Select category
                                </option>

                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.CategoryID">@cat.CategoryName</option>
                                }

                            </select>

                        </div>


                        <!-- SAMPLE TYPE -->

                        <div class="form-group">

                            <label class="form-label">
                                Sample Type
                                <span class="required">*</span>
                            </label>

                            <select name="SampleTypeId"
                                    class="form-control"
                                    required>

                                <option value="">
                                    Select sample type
                                </option>

                                <option value="Whole Blood">Whole Blood</option>
                                <option value="Plasma">Plasma</option>
                                <option value="Serum">Serum</option>
                                <option value="Bone Marrow">Bone Marrow</option>

                            </select>

                        </div>


                        <!-- UNIT -->

                        <div class="form-group">

                            <label class="form-label">
                                Unit Measurement
                            </label>

                            <input type="text"
                                   name="UnitMeasurement"
                                   class="form-control"
                                   placeholder="e.g. g/dL" />

                        </div>


                        <!-- TAT -->

                        <div class="form-group">

                            <label class="form-label">
                                Turnaround Time
                            </label>

                            <input type="number"
                                   name="TurnaroundTime"
                                   class="form-control"
                                   placeholder="e.g. 24"
                                   min="0" />

                            <span class="form-help">
                                Enter TAT in hours.
                            </span>

                        </div>


                        <!-- NORMAL MIN -->

                        <div class="form-group">
                            <label class="form-label">Normal Range Min</label>
                            <input type="number" name="NormalRangeMin" class="form-control" step="any" placeholder="e.g. 12.00" />
                        </div>

                        <!-- NORMAL MAX -->
                        <div class="form-group">
                            <label class="form-label">Normal Range Maximum</label>
                            <input type="number" name="NormalRangeMax" class="form-control" step="0.01" placeholder="e.g. 16.00" />
                        </div>


                        <!-- CONSUMABLES -->

                        <div class="form-group full">

                            <label class="form-label">
                                Consumables Used
                            </label>

                            <textarea name="ConsumablesUsed"
                                      class="form-control"
                                      placeholder="e.g. EDTA Tube, Reagent A"></textarea>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="closeModal('addModal')">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        ✓ Save Test Type

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- =====================================================
         EDIT TEST TYPE MODAL
    ====================================================== -->

    <div id="editModal"
         class="modal-overlay">

        <div class="modal">

            <form asp-controller="TestCatalogue"
                  asp-action="EditTestType"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="modal-header">

                    <h2 class="modal-title">
                        Edit Test Type
                    </h2>

                    <button type="button"
                            class="close-btn"
                            onclick="closeModal('editModal')">

                        ×

                    </button>

                </div>


                <div class="modal-body">

                    <input type="hidden"
                           id="edit-TestId"
                           name="TestId" />


                    <div class="form-grid">


                        <!-- TEST NAME -->

                        <div class="form-group full">

                            <label class="form-label">
                                Test Name
                                <span class="required">*</span>
                            </label>

                            <input type="text"
                                   id="edit-TestName"
                                   name="TestName"
                                   class="form-control"
                                   required />

                        </div>


                        <!-- CATEGORY -->

                        <div class="form-group">

                            <label class="form-label">
                                Category
                                <span class="required">*</span>
                            </label>

                            <select id="edit-CategoryId"
                                    name="CategoryId"
                                    class="form-control"
                                    required>

                                <option value="">
                                    Select category
                                </option>

                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.CategoryID">@cat.CategoryName</option>
                                }

                            </select>

                        </div>


                        <!-- SAMPLE TYPE -->

                        <div class="form-group">

                            <label class="form-label">
                                Sample Type
                                <span class="required">*</span>
                            </label>

                            <select id="edit-SampleTypeId"
                                    name="SampleTypeId"
                                    class="form-control"
                                    required>

                                <option value="">
                                    Select sample type
                                </option>

                                <option value="Whole Blood">Whole Blood</option>
                                <option value="Plasma">Plasma</option>
                                <option value="Serum">Serum</option>
                                <option value="Bone Marrow">Bone Marrow</option>

                            </select>

                        </div>


                        <!-- UNIT -->

                        <div class="form-group">

                            <label class="form-label">
                                Unit Measurement
                            </label>

                            <input type="text"
                                   id="edit-UnitMeasurement"
                                   name="UnitMeasurement"
                                   class="form-control" />

                        </div>


                        <!-- TAT -->

                        <div class="form-group">

                            <label class="form-label">
                                Turnaround Time
                            </label>

                            <input type="number"
                                   id="edit-TurnaroundTime"
                                   name="TurnaroundTime"
                                   class="form-control"
                                   min="0" />

                        </div>


                        <!-- NORMAL MIN -->

                        <div class="form-group">

                            <label class="form-label">
                                Normal Range Minimum
                            </label>

                            <input type="number"
                                   id="edit-NormalRangeMin"
                                   name="NormalRangeMin"
                                   class="form-control"
                                   step="any"
                                   placeholder="e.g. 12.00" />

                        </div>


                        <!-- NORMAL MAX -->

                        <div class="form-group">

                            <label class="form-label">
                                Normal Range Maximum
                            </label>

                            <input type="number"
                                   id="edit-NormalRangeMax"
                                   name="NormalRangeMax"
                                   class="form-control"
                                   step="0.01" />

                        </div>


                        <!-- CONSUMABLES -->

                        <div class="form-group full">

                            <label class="form-label">
                                Consumables Used
                            </label>

                            <textarea id="edit-ConsumablesUsed"
                                      name="ConsumablesUsed"
                                      class="form-control"></textarea>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="closeModal('editModal')">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        ✓ Update Test Type

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- =====================================================
         DELETE CONFIRMATION MODAL
    ====================================================== -->

    <div id="deleteModal"
         class="modal-overlay">

        <div class="modal"
             style="max-width:450px;">

            <form asp-controller="TestCatalogue"
                  asp-action="DeleteTest"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="delete-TestId"
                       name="id" />


                <div class="modal-header">

                    <h2 class="modal-title">
                        Delete Test Type
                    </h2>

                    <button type="button"
                            class="close-btn"
                            onclick="closeModal('deleteModal')">

                        ×

                    </button>

                </div>


                <div class="modal-body">

                    <div class="delete-content">

                        <div class="delete-icon">
                            !
                        </div>

                        <div class="delete-title">
                            Are you sure?
                        </div>

                        <p class="delete-message">

                            You are about to delete

                            <strong id="delete-TestName">
                                this test
                            </strong>.

                            This action cannot be undone.

                        </p>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="closeModal('deleteModal')">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        🗑 Delete Test

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script>

            function openAddModal() {

                document.getElementById("addModal")
                    .classList.add("show");

                document.body.style.overflow = "hidden";
            }


            function openEditModal(
                id,
                testName,
                categoryId,
                sampleType,
                unit,
                normalMin,
                normalMax,
                tat,
                consumables
            ) {

                document.getElementById("edit-TestId").value = id;
                document.getElementById("edit-TestName").value = testName;
                document.getElementById("edit-CategoryId").value = categoryId;
                document.getElementById("edit-SampleTypeId").value = sampleType;
                document.getElementById("edit-UnitMeasurement").value = unit;
                document.getElementById("edit-NormalRangeMin").value = normalMin;
                document.getElementById("edit-NormalRangeMax").value = normalMax;
                document.getElementById("edit-TurnaroundTime").value = tat;
                document.getElementById("edit-ConsumablesUsed").value = consumables;

                document.getElementById("editModal")
                    .classList.add("show");

                document.body.style.overflow = "hidden";
            }


            function openDeleteModal(id, testName) {

                document.getElementById("delete-TestId").value = id;
                document.getElementById("delete-TestName").textContent = testName;

                document.getElementById("deleteModal")
                    .classList.add("show");

                document.body.style.overflow = "hidden";
            }


            function closeModal(modalId) {

                document.getElementById(modalId)
                    .classList.remove("show");

                document.body.style.overflow = "";
            }


            document.querySelectorAll(".modal-overlay")
                .forEach(function (modal) {

                    modal.addEventListener("click", function (event) {

                        if (event.target === modal) {

                            modal.classList.remove("show");

                            document.body.style.overflow = "";

                        }

                    });

                });


            document.addEventListener("keydown", function (event) {

                if (event.key === "Escape") {

                    document.querySelectorAll(".modal-overlay.show")
                        .forEach(function (modal) {

                            modal.classList.remove("show");

                        });

                    document.body.style.overflow = "";

                }

            });


            setTimeout(function () {

                document.querySelectorAll(".alert")
                    .forEach(function (alert) {

                        alert.style.transition = "opacity .4s ease";
                        alert.style.opacity = "0";

                        setTimeout(function () {
                            alert.remove();
                        }, 400);

                    });

            }, 5000);

    </script>

</body>

</html>
