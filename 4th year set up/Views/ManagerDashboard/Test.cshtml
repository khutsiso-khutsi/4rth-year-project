@model IEnumerable<TestCatalogue>

@{
    ViewData["Title"] = "Test Catalogue";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test Catalogue — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --navy: #0b1f3a;
                --navy2: #122848;
                --teal: #0d9488;
                --teal-light: rgba(13,148,136,0.1);
                --purple: #4f46e5;
                --purple-light: rgba(79,70,229,0.1);
                --amber: #d97706;
                --amber-light: rgba(217,119,6,0.1);
                --red: #dc2626;
                --red-light: rgba(220,38,38,0.1);
                --green: #16a34a;
                --green-light: rgba(22,163,74,0.1);
                --white: #ffffff;
                --offwhite: #f4f7fb;
                --muted: #6b7a99;
                --border: #dde4f0;
            }

            body {
                font-family: 'DM Sans', sans-serif;
                background: var(--offwhite);
                color: var(--navy);
                min-height: 100vh;
            }

            /* TOPBAR */
            .topbar {
                background: var(--navy);
                padding: 0 40px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                height: 64px;
                position: sticky;
                top: 0;
                z-index: 100;
                box-shadow: 0 2px 20px rgba(0,0,0,0.15);
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

            .brand-logo {
                width: 34px;
                height: 34px;
                background: var(--teal);
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .brand-logo svg {
                    width: 18px;
                    height: 18px;
                    fill: white;
                }

            .brand-name {
                font-family: 'DM Serif Display', serif;
                color: white;
                font-size: 1.1rem;
                line-height: 1.1;
            }

                .brand-name span {
                    display: block;
                    font-family: 'DM Sans', sans-serif;
                    font-size: 0.6rem;
                    font-weight: 300;
                    color: rgba(255,255,255,0.4);
                    letter-spacing: 0.1em;
                    text-transform: uppercase;
                }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .user-chip {
                display: flex;
                align-items: center;
                gap: 10px;
                background: rgba(255,255,255,0.07);
                border: 1px solid rgba(255,255,255,0.1);
                border-radius: 100px;
                padding: 6px 14px 6px 8px;
            }

            .user-avatar {
                width: 28px;
                height: 28px;
                background: var(--purple);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.75rem;
                font-weight: 600;
                color: white;
            }

            .user-email {
                font-size: 0.8rem;
                color: rgba(255,255,255,0.75);
                max-width: 160px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .logout-btn {
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.12);
                color: rgba(255,255,255,0.8);
                padding: 8px 16px;
                border-radius: 8px;
                text-decoration: none;
                font-size: 0.82rem;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 6px;
                transition: all 0.2s;
            }

                .logout-btn:hover {
                    background: rgba(255,255,255,0.15);
                    color: white;
                }

                .logout-btn svg {
                    width: 14px;
                    height: 14px;
                }

            /* LAYOUT */
            .page {
                display: flex;
                min-height: calc(100vh - 64px);
            }

            /* SIDEBAR */
            .sidebar {
                width: 220px;
                background: white;
                border-right: 1px solid var(--border);
                padding: 24px 0;
                flex-shrink: 0;
                position: sticky;
                top: 64px;
                height: calc(100vh - 64px);
                overflow-y: auto;
            }

            .nav-label {
                font-size: 0.65rem;
                font-weight: 600;
                color: var(--muted);
                letter-spacing: 0.1em;
                text-transform: uppercase;
                padding: 0 20px;
                margin-bottom: 4px;
                margin-top: 16px;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 20px;
                color: var(--muted);
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 500;
                border-left: 3px solid transparent;
                transition: all 0.15s;
            }

                .nav-item:hover {
                    background: var(--offwhite);
                    color: var(--navy);
                }

                .nav-item.active {
                    background: var(--purple-light);
                    color: var(--purple);
                    border-left-color: var(--purple);
                }

                .nav-item svg {
                    width: 16px;
                    height: 16px;
                    flex-shrink: 0;
                }

            /* MAIN */
            .main {
                flex: 1;
                padding: 32px 40px;
            }

            /* PAGE HEADER */
            .page-header {
                margin-bottom: 28px;
            }

                .page-header h1 {
                    font-family: 'DM Serif Display', serif;
                    font-size: 1.8rem;
                    color: var(--navy);
                    margin-bottom: 4px;
                }

                .page-header p {
                    color: var(--muted);
                    font-size: 0.875rem;
                }

            /* CARD */
            .card {
                background: #0b1f3a;
                border: 1px solid var(--border);
                border-radius: 16px;
                padding: 24px;
                box-shadow: 0 2px 8px rgba(11,31,58,0.04);
            }

            /* TOOLBAR */
            .toolbar {
                display: flex;
                gap: 12px;
                margin-bottom: 20px;
                align-items: center;
                flex-wrap: wrap;
            }

            .app-finput {
                flex: 1;
                max-width: 300px;
                background: var(--offwhite);
                border: 1px solid var(--border);
                border-radius: 10px;
                padding: 10px 14px;
                color: var(--navy);
                outline: none;
                font-size: 0.85rem;
                font-family: 'DM Sans', sans-serif;
            }

                .app-finput::placeholder {
                    color: var(--muted);
                }

                .app-finput:focus {
                    border-color: var(--teal);
                }

            /* BUTTONS */
            .btn-sm {
                border: none;
                border-radius: 8px;
                padding: 10px 16px;
                cursor: pointer;
                font-weight: 600;
                font-size: 0.82rem;
                white-space: nowrap;
                font-family: 'DM Sans', sans-serif;
                transition: opacity 0.15s;
            }

                .btn-sm:hover {
                    opacity: 0.88;
                }

            .btn-teal {
                background: var(--teal);
                color: white;
            }

            .btn-amber {
                background: var(--amber);
                color: white;
            }

            .btn-blue {
                background: var(--purple);
                color: white;
            }

            .btn-red {
                background: var(--red);
                color: white;
            }

            /* TABLE */
            .table {
                width: 100%;
                border-collapse: collapse;
            }

                .table th {
                    font-size: 0.7rem;
                    font-weight: 600;
                    color: var(--muted);
                    text-transform: uppercase;
                    letter-spacing: 0.08em;
                    padding: 0 0 10px;
                    text-align: left;
                    border-bottom: 1px solid var(--border);
                    white-space: nowrap;
                }

                .table td {
                    padding: 14px 0;
                    font-size: 0.83rem;
                    color: white;
                    border-bottom: 1px solid var(--offwhite);
                    vertical-align: middle;
                    white-space: nowrap;
                    padding-right: 16px;
                }

                .table tr:last-child td {
                    border-bottom: none;
                }

                .table tbody tr:hover {
                    background: var(--offwhite);
                }

            .test-name {
                font-weight: 600;
                color: var(--navy);
            }

            .action-group {
                display: flex;
                gap: 8px;
            }

            @@media (max-width: 768px) {
                .topbar {
                    padding: 0 20px;
                }

                .user-email {
                    display: none;
                }

                .sidebar {
                    display: none;
                }

                .main {
                    padding: 20px 16px;
                }

                .app-finput {
                    max-width: 100%;
                }

                .toolbar {
                    flex-direction: column;
                    align-items: stretch;
                }
            }

            /* =========================
               SIDEBAR (FIXED + CLEAN)
            ========================= */

            .sidebar {
                width: 210px;
                background: #0b1f3a; /* navy */
                border-right: 1px solid rgba(255,255,255,0.08);
                padding: 14px 10px;
                flex-shrink: 0;
            }

            /* SECTION LABEL */
            .nav-label {
                font-size: 0.6rem;
                letter-spacing: 0.12em;
                margin: 14px 10px 6px;
                color: rgba(255,255,255,0.5);
                text-transform: uppercase;
            }

            /* NAV ITEM */
            .nav-item {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 10px;
                border-radius: 8px;
                font-size: 0.75rem; /* smaller text */
                font-weight: 500;
                color: rgba(255,255,255,0.65);
                text-decoration: none;
                transition: 0.2s ease-in-out;
                margin-bottom: 2px;
            }

                /* ICON SIZE (IMPORTANT FIX) */
                .nav-item svg {
                    width: 14px; /* smaller icons */
                    height: 14px;
                    stroke: currentColor;
                }

                /* HOVER */
                .nav-item:hover {
                    background: rgba(255,255,255,0.08);
                    color: #ffffff;
                }

                /* ACTIVE STATE */
                .nav-item.active {
                    background: rgba(13,148,136,0.25);
                    color: #14b8a8;
                    border-left: 3px solid #14b8a8;
                }
    </style>
</head>
<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">
                    @(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "M")
                </div>
                <span class="user-email">@ViewBag.Email</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="nav-label">Main</div>

            <a asp-controller="ManagerDashboard" asp-action="Index" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>
                Dashboard
            </a>

            <a asp-controller="ManagerDashboard" asp-action="Test" class="nav-item active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 3v11a3 3 0 006 0V3" />
                    <line x1="6" y1="3" x2="18" y2="3" />
                </svg>
                Test Catalogue
            </a>

            <a asp-controller="ManagerDashboard" asp-action="Consumables" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                </svg>
                Consumables
            </a>

            <a asp-controller="ManagerDashboard" asp-action="Staff" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                Staff
            </a>

            <a asp-controller="ManagerDashboard" asp-action="Orders" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <path d="M16 10a4 4 0 0 1-8 0" />
                </svg>
                Orders
            </a>

            <a asp-controller="ManagerDashboard" asp-action="Reports" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                </svg>
                Reports
            </a>

            <div class="nav-label">System</div>

            <a asp-controller="ManagerDashboard" asp-action="Profile" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.07 4.93A10 10 0 1 0 4.93 19.07 10 10 0 0 0 19.07 4.93z" />
                </svg>
               Profile
            </a>

            <a asp-controller="ManagerDashboard" asp-action="AuditLog" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
                Audit Log
            </a>

        </aside>

        <!-- MAIN -->
        <main class="main">

            <div class="page-header">
                <h1>Test Catalogue</h1>
                <p>Manage test categories, test types, and sample types.</p>
            </div>

            <div class="card">

                <!-- TOOLBAR -->
                <div class="toolbar">
                    <input class="app-finput" placeholder="🔍 Search tests..." />
                    <button class="btn-sm btn-amber">+ Category</button>
                    <button class="btn-sm btn-teal">+ Test Type</button>
                </div>

                <!-- TABLE -->
                <table class="table">
                    <thead>
                        <tr>
                            <th>Test Name</th>
                            <th>Category</th>
                            <th>Sample Type</th>
                            <th>Units</th>
                            <th>Normal Range</th>
                            <th>TAT (Min)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var test in Model)
                            {
                                <tr>
                                    <td class="test-name">@test.TestName</td>
                                    <td>@test.Category</td>
                                    <td>@test.SampleType</td>
                                    <td>@test.Units</td>
                                    <td>@test.NormalRange</td>
                                    <td>@test.TAT</td>
                                    <td>
                                        <div class="action-group">
                                            <button class="btn-sm btn-blue">Edit</button>
                                            <button class="btn-sm btn-red">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    style="text-align:center;padding:30px;color:var(--muted);">
                                    No tests found.
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>

        </main>
    </div>

</body>
</html>