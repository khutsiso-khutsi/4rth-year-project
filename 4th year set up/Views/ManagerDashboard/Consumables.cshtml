@using LabManager.Models
@model IEnumerable<Consumable>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Consumables | NMB-HLabSys</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            :root {
                --bg: #081420;
                --sidebar: #0d1b2d;
                --card: #13253d;
                --card2: #182f4d;
                --border: rgba(255,255,255,.06);
                --text: #f8fafc;
                --muted: #8fa3bf;
                --blue: #3b82f6;
                --blue-soft: rgba(59,130,246,.16);
                --green: #22c55e;
                --green-soft: rgba(34,197,94,.16);
                --orange: #f59e0b;
                --orange-soft: rgba(245,158,11,.16);
                --red: #ef4444;
                --red-soft: rgba(239,68,68,.16);
                --font: 'DM Sans', sans-serif;
            }

            body {
                background: var(--bg);
                color: var(--text);
                font-family: var(--font);
                overflow-x: hidden;
            }

            /* ── LAYOUT ── */

            .page {
                display: flex;
                min-height: calc(100vh - 64px);
            }

            /* ── TOPBAR ── */

            .topbar {
                background: #0b1f3a;
                padding: 0 40px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                height: 64px;
                position: sticky;
                top: 0;
                z-index: 100;
                box-shadow: 0 2px 20px rgba(0,0,0,0.15);
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

            .brand-logo {
                width: 34px;
                height: 34px;
                background: var(--blue);
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .brand-logo svg {
                    width: 18px;
                    height: 18px;
                    fill: white;
                }

            .brand-name {
                font-family: 'DM Sans', sans-serif;
                color: white;
                font-size: 1.1rem;
                font-weight: 700;
                line-height: 1.1;
            }

                .brand-name span {
                    display: block;
                    font-size: 0.6rem;
                    font-weight: 300;
                    color: rgba(255,255,255,0.4);
                    letter-spacing: 0.1em;
                    text-transform: uppercase;
                }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .user-chip {
                display: flex;
                align-items: center;
                gap: 10px;
                background: rgba(255,255,255,0.07);
                border: 1px solid rgba(255,255,255,0.1);
                border-radius: 100px;
                padding: 6px 14px 6px 8px;
            }

            .user-avatar {
                width: 28px;
                height: 28px;
                background: #4f46e5;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.75rem;
                font-weight: 600;
                color: white;
            }

            .user-email {
                font-size: 0.8rem;
                color: rgba(255,255,255,0.75);
                max-width: 160px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .logout-btn {
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.12);
                color: rgba(255,255,255,0.8);
                padding: 8px 16px;
                border-radius: 8px;
                text-decoration: none;
                font-size: 0.82rem;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 6px;
                transition: all 0.2s;
            }

                .logout-btn:hover {
                    background: rgba(255,255,255,0.15);
                    color: white;
                }

                .logout-btn svg {
                    width: 14px;
                    height: 14px;
                }

            /* ── SIDEBAR ── */

            .sidebar {
                width: 220px;
                background: var(--sidebar);
                border-right: 1px solid var(--border);
                padding: 24px 0;
                flex-shrink: 0;
                position: sticky;
                top: 64px;
                height: calc(100vh - 64px);
                overflow-y: auto;
            }

            .nav-label {
                font-size: 0.65rem;
                font-weight: 700;
                color: var(--muted);
                letter-spacing: 0.1em;
                text-transform: uppercase;
                padding: 0 20px;
                margin-bottom: 4px;
                margin-top: 16px;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 20px;
                color: #c5d3e6;
                text-decoration: none;
                font-size: 0.875rem;
                font-weight: 500;
                border-left: 3px solid transparent;
                transition: all 0.15s;
            }

                .nav-item svg {
                    width: 16px;
                    height: 16px;
                    flex-shrink: 0;
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 2;
                }

                .nav-item:hover {
                    background: rgba(255,255,255,.05);
                    color: white;
                }

                .nav-item.active {
                    background: rgba(59,130,246,.18);
                    color: #60a5fa;
                    border-left-color: var(--blue);
                }

            /* ── MAIN ── */

            .main {
                flex: 1;
                padding: 34px;
            }

            /* ── CARD ── */

            .card {
                background: var(--card);
                border: 1px solid var(--border);
                border-radius: 24px;
                padding: 28px;
            }

            /* ── TOOLBAR ── */

            .toolbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 18px;
                margin-bottom: 26px;
                flex-wrap: wrap;
            }

            .search-box {
                flex: 1;
                min-width: 260px;
                max-width: 360px;
            }

            .search-input {
                width: 100%;
                height: 48px;
                background: rgba(255,255,255,.04);
                border: 1px solid rgba(255,255,255,.08);
                border-radius: 14px;
                padding: 0 16px;
                color: white;
                font-size: 14px;
                outline: none;
                font-family: var(--font);
            }

                .search-input::placeholder {
                    color: #7b8ea8;
                }

                .search-input:focus {
                    border-color: var(--blue);
                }

            .toolbar-actions {
                display: flex;
                gap: 12px;
                flex-wrap: wrap;
            }

            .btn {
                height: 46px;
                padding: 0 18px;
                border: none;
                border-radius: 14px;
                cursor: pointer;
                font-size: 14px;
                font-weight: 600;
                font-family: var(--font);
                transition: .2s;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
            }

            .btn-green {
                background: var(--green-soft);
                color: var(--green);
            }

                .btn-green:hover {
                    background: rgba(34,197,94,.25);
                }

            .btn-orange {
                background: var(--orange-soft);
                color: var(--orange);
            }

                .btn-orange:hover {
                    background: rgba(245,158,11,.25);
                }

            /* ── TABLE ── */

            .table-wrap {
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 900px;
            }

            thead th {
                text-align: left;
                padding: 16px;
                color: #7f95b3;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: .08em;
                border-bottom: 1px solid var(--border);
            }

            tbody td {
                padding: 18px 16px;
                border-bottom: 1px solid rgba(255,255,255,.04);
                font-size: 14px;
            }

            tbody tr:hover {
                background: rgba(255,255,255,.02);
            }

            .fw-bold {
                font-weight: 600;
                color: white;
            }

            .badge {
                padding: 8px 12px;
                border-radius: 999px;
                font-size: 12px;
                font-weight: 700;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 70px;
            }

                .badge.green {
                    background: var(--green-soft);
                    color: var(--green);
                }

                .badge.orange {
                    background: var(--orange-soft);
                    color: var(--orange);
                }

                .badge.red {
                    background: var(--red-soft);
                    color: var(--red);
                }

            .status {
                padding: 8px 12px;
                border-radius: 999px;
                font-size: 12px;
                font-weight: 700;
            }

                .status.good {
                    background: var(--green-soft);
                    color: var(--green);
                }

                .status.medium {
                    background: var(--orange-soft);
                    color: var(--orange);
                }

                .status.low {
                    background: var(--red-soft);
                    color: var(--red);
                }

            .table-actions {
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .mini-btn {
                height: 36px;
                padding: 0 14px;
                border-radius: 10px;
                border: none;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                transition: .2s;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                font-family: var(--font);
            }

                .mini-btn.blue {
                    background: rgba(59,130,246,.14);
                    color: var(--blue);
                }

                .mini-btn.orange {
                    background: rgba(245,158,11,.14);
                    color: var(--orange);
                }

            /* ── RESPONSIVE ── */

            @@media(max-width:768px) {
                .sidebar {
                    display: none;
                }

                .user-email {
                    display: none;
                }

                .main {
                    padding: 18px;
                }

                .topbar {
                    padding: 0 20px;
                }
            }

    </style>

</head>

<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">NMB-HLabSys<span>Haematology Lab System</span></div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "M")</div>
                <span class="user-email">@ViewBag.Email</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="nav-label">Main</div>
            <a asp-controller="ManagerDashboard" asp-action="Index" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                Dashboard
            </a>
            <a asp-controller="ManagerDashboard" asp-action="TestCatalogue" class="nav-item">
                <svg viewBox="0 0 24 24"><path d="M9 3v11a3 3 0 006 0V3" /><line x1="6" y1="3" x2="18" y2="3" /></svg>
                Test Catalogue
            </a>
            <a asp-controller="ManagerDashboard" asp-action="Consumables" class="nav-item active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                Consumables
            </a>
            <a asp-controller="ManagerDashboard" asp-action="Staff" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                Staff
            </a>
            <a asp-controller="ManagerDashboard" asp-action="Orders" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                Orders
            </a>
            <a asp-controller="ManagerDashboard" asp-action="Report" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                Reports
            </a>
            <div class="nav-label">System</div>
            <a asp-controller="ManagerDashboard" asp-action="Profile" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3" /><path d="M19.07 4.93A10 10 0 1 0 4.93 19.07 10 10 0 0 0 19.07 4.93z" /></svg>
                Profile
            </a>
            <a asp-controller="ManagerDashboard" asp-action="AuditLog" class="nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                Audit Log
            </a>
        </aside>

        <!-- MAIN -->
        <main class="main">

            <div class="card">

                <!-- TOOLBAR -->
                <div class="toolbar">

                    <div class="search-box">
                        <input type="text"
                               class="search-input"
                               placeholder="Search consumables..."
                               oninput="filterTable(this,'cons-tbody')" />
                    </div>

                    <div class="toolbar-actions">
                        <button class="btn btn-green">+ Add Consumable</button>
                        <button class="btn btn-orange">+ Add Supplier</button>
                    </div>

                </div>

                <!-- TABLE -->
                <div class="table-wrap">

                    <table>

                        <thead>
                            <tr>
                                <th>Consumable</th>
                                <th>Supplier</th>
                                <th>On Hand</th>
                                <th>Reorder Level</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody id="cons-tbody">

                            @if (Model != null && Model.Any())
                            {
                                foreach (var c in Model)
                                {
                                    <tr>

                                        <td class="fw-bold">@c.ConsumableName</td>

                                        <td>@c.Supplier</td>

                                        <td>
                                            @if (c.OnHand < 10)
                                            {
                                                <span class="badge red">@c.OnHand</span>
                                            }
                                            else if (c.OnHand < 30)
                                            {
                                                <span class="badge orange">@c.OnHand</span>
                                            }
                                            else
                                            {
                                                <span class="badge green">@c.OnHand</span>
                                            }
                                        </td>

                                        <td>@c.ReorderLevel</td>

                                        <td>
                                            @if (c.StockStatus == "Low")
                                            {
                                                <span class="status low">Low Stock</span>
                                            }
                                            else if (c.StockStatus == "Medium")
                                            {
                                                <span class="status medium">Medium</span>
                                            }
                                            else
                                            {
                                                <span class="status good">Good</span>
                                            }
                                        </td>

                                        <td>
                                            <div class="table-actions">
                                                <button class="mini-btn blue">Adjust</button>
                                                @if (c.StockStatus != "Good")
                                                {
                                                    <a asp-controller="ManagerDashboard"
                                                       asp-action="Orders"
                                                       class="mini-btn orange">Order</a>
                                                }
                                            </div>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6"
                                        style="text-align:center;padding:50px;color:#8fa3bf;">
                                        No consumables found.
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </main>

    </div>

    <script>
            function filterTable(input, tbodyId) {
                const value = input.value.toLowerCase();
                document.querySelectorAll('#' + tbodyId + ' tr').forEach(row => {
                    row.style.display = row.textContent.toLowerCase().includes(value) ? '' : 'none';
                });
            }
    </script>

</body>
</html>