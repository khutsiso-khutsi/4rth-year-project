@model IEnumerable<Consumable>

@{
    ViewData["Title"] = "Consumables";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Consumables - NMB-HLabSys</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <style>

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1f3a;
            --navy2: #122848;
            --teal: #0d9488;
            --teal-light: rgba(13,148,136,0.1);
            --purple: #4f46e5;
            --purple-light: rgba(79,70,229,0.1);
            --amber: #d97706;
            --amber-light: rgba(217,119,6,0.1);
            --red: #dc2626;
            --red-light: rgba(220,38,38,0.1);
            --green: #16a34a;
            --green-light: rgba(22,163,74,0.1);
            --white: #ffffff;
            --offwhite: #f4f7fb;
            --muted: #6b7a99;
            --border: #dde4f0;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--offwhite);
            color: var(--navy);
            min-height: 100vh;
        }

        /* TOPBAR */

        .topbar {
            background: var(--navy);
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-logo {
            width: 34px;
            height: 34px;
            background: var(--teal);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            font-weight: bold;
        }

        .brand-name {
            font-family: 'DM Serif Display', serif;
            color: white;
            font-size: 1.1rem;
            line-height: 1.1;
        }

        .brand-name span {
            display: block;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.6rem;
            font-weight: 300;
            color: rgba(255,255,255,0.4);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 6px 14px 6px 8px;
        }

        .user-avatar {
            width: 28px;
            height: 28px;
            background: var(--purple);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
        }

        .user-email {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.75);
        }

        .logout-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.8);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            transition: all 0.2s;
        }

        .logout-btn:hover {
            background: rgba(255,255,255,0.15);
            color: white;
        }

        /* PAGE */

        .page {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        /* SIDEBAR */

        .sidebar {
            width: 220px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 24px 0;
            flex-shrink: 0;
        }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 20px;
            margin-bottom: 6px;
            margin-top: 16px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 20px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all 0.15s;
        }

        .nav-item:hover {
            background: var(--offwhite);
            color: var(--navy);
        }

        .nav-item.active {
            background: var(--purple-light);
            color: var(--purple);
            border-left-color: var(--purple);
        }

        /* MAIN */

        .main {
            flex: 1;
            padding: 32px 40px;
        }

        .page-header {
            margin-bottom: 24px;
        }

        .page-header h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            color: var(--navy);
            margin-bottom: 8px;
        }

        .page-header p {
            color: var(--muted);
            font-size: 0.9rem;
        }

        /* CARD */

        .card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(11,31,58,0.04);
        }

        /* SEARCH BAR */

        .search-bar {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 22px;
            flex-wrap: wrap;
        }

        .app-finput {
            flex: 1;
            max-width: 320px;
            border: 1px solid var(--border);
            background: var(--offwhite);
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 0.85rem;
            outline: none;
        }

        .app-finput:focus {
            border-color: var(--purple);
        }

        /* BUTTONS */

        .btn-sm {
            border: none;
            border-radius: 10px;
            padding: 11px 16px;
            cursor: pointer;
            font-size: 0.82rem;
            font-weight: 600;
            transition: 0.2s;
        }

        .btn-teal {
            background: var(--teal);
            color: white;
        }

        .btn-amber {
            background: var(--amber);
            color: white;
        }

        .btn-blue {
            background: var(--purple);
            color: white;
        }

        .btn-sm:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

        /* TABLE */

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            padding: 0 0 14px;
            color: var(--muted);
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        td {
            padding: 18px 0;
            border-bottom: 1px solid var(--offwhite);
            font-size: 0.84rem;
            white-space: nowrap;
        }

        tr:last-child td {
            border-bottom: none;
        }

        /* STOCK BAR */

        .stock-bar {
            width: 130px;
            height: 8px;
            background: var(--border);
            border-radius: 999px;
            overflow: hidden;
        }

        .stock-fill {
            height: 100%;
            border-radius: 999px;
        }

        .fill-red {
            background: var(--red);
        }

        .fill-amber {
            background: var(--amber);
        }

        .fill-green {
            background: var(--green);
        }

        /* ACTIONS */

        .action-group {
            display: flex;
            gap: 8px;
        }

        /* RESPONSIVE */

        @@media(max-width:900px) {

            .sidebar {
                display: none;
            }

            .main {
                padding: 20px;
            }

            .search-bar {
                flex-direction: column;
                align-items: stretch;
            }

            .app-finput {
                max-width: 100%;
            }
        }

    </style>

</head>

<body>

    <!-- TOPBAR -->

    <div class="topbar">

        <a class="brand"
           asp-controller="Home"
           asp-action="Index">

            <div class="brand-logo">
                +
            </div>

            <div class="brand-name">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>

        </a>

        <div class="topbar-right">

            <div class="user-chip">

                <div class="user-avatar">

                    @(
                        !string.IsNullOrEmpty(ViewBag.Email as string)
                        ? ViewBag.Email.ToString().Substring(0,1).ToUpper()
                        : "M"
                    )

                </div>

                <span class="user-email">

                    @(ViewBag.Email ?? "Manager")

                </span>

            </div>

            <a asp-controller="Home"
               asp-action="Logout"
               class="logout-btn">

                Logout

            </a>

        </div>

    </div>

    <div class="page">

        <!-- SIDEBAR -->

        <aside class="sidebar">

            <div class="nav-label">
                Main
            </div>

            <a asp-controller="ManagerDashboard"
               asp-action="Dashboard"
               class="nav-item">

                Dashboard

            </a>

            <a asp-controller="ManagerDashboard"
               asp-action="Test"
               class="nav-item">

                Test Catalogue

            </a>

            <a asp-controller="ManagerDashboard"
               asp-action="Consumables"
               class="nav-item active">

                Consumables

            </a>

            <a asp-controller="ManagerDashboard"
               asp-action="Staff"
               class="nav-item">

                Staff

            </a>

            <a asp-controller="Reports"
               asp-action="Index"
               class="nav-item">

                Reports

            </a>

            <div class="nav-label">
                System
            </div>

            <a asp-controller="Settings"
               asp-action="Index"
               class="nav-item">

                Settings

            </a>

            <a asp-controller="AuditLog"
               asp-action="Index"
               class="nav-item">

                Audit Log

            </a>

        </aside>

        <!-- MAIN -->

        <main class="main">

            <div class="page-header">

                <h1>
                    Consumables
                </h1>

                <p>
                    Track stock levels and manage suppliers.
                </p>

            </div>

            <div class="card">

                <!-- SEARCH BAR -->

                <div class="search-bar">

                    <input type="text"
                           class="app-finput"
                           placeholder="🔍 Search consumables..." />

                    <button class="btn-sm btn-teal">
                        + Add Consumable
                    </button>

                    <button class="btn-sm btn-amber">
                        + Add Supplier
                    </button>

                </div>

                <!-- TABLE -->

                <div class="table-wrap">

                    <table>

                        <thead>

                            <tr>

                                <th>Consumable</th>
                                <th>Supplier</th>
                                <th>On Hand</th>
                                <th>Reorder Level</th>
                                <th>Stock Status</th>
                                <th>Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>

                                        <!-- Consumable -->

                                        <td style="font-weight:600;">
                                            @item.ConsumableName
                                        </td>

                                        <!-- Supplier -->

                                        <td>
                                            @item.Supplier
                                        </td>

                                        <!-- On Hand -->

                                        <td>

                                            @if (item.OnHand < 10)
                                            {
                                                <span style="color:var(--red);font-weight:700;">
                                                    @item.OnHand
                                                </span>
                                            }
                                            else if (item.OnHand < 30)
                                            {
                                                <span style="color:var(--amber);font-weight:700;">
                                                    @item.OnHand
                                                </span>
                                            }
                                            else
                                            {
                                                <span style="color:var(--green);font-weight:700;">
                                                    @item.OnHand
                                                </span>
                                            }

                                        </td>

                                        <!-- Reorder -->

                                        <td>
                                            @item.ReorderLevel
                                        </td>

                                        <!-- Status -->

                                        <td>

                                            <div class="stock-bar">

                                                @if (item.StockStatus == "Low")
                                                {
                                                    <div class="stock-fill fill-red"
                                                         style="width:16%;">
                                                    </div>
                                                }
                                                else if (item.StockStatus == "Medium")
                                                {
                                                    <div class="stock-fill fill-amber"
                                                         style="width:45%;">
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="stock-fill fill-green"
                                                         style="width:90%;">
                                                    </div>
                                                }

                                            </div>

                                        </td>

                                        <!-- ACTIONS -->

                                        <td>

                                            <div class="action-group">

                                                <button class="btn-sm btn-blue">
                                                    Adjust Stock
                                                </button>

                                                @if (item.StockStatus != "Good")
                                                {
                                                    <button class="btn-sm btn-amber">
                                                        Order
                                                    </button>
                                                }

                                            </div>

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="6"
                                        style="text-align:center;
                                               padding:30px;
                                               color:var(--muted);">

                                        No consumables found.

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </main>

    </div>

</body>
</html>