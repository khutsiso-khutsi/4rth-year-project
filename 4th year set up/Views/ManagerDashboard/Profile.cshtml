@using LabManager.Models
@model UserProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile — NMB-HLabSys</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@300;400;600;700&display=swap" rel="stylesheet" />

    <style>

            /* =========================
                   RESET
                ========================= */

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            :root {
                --navy: #0b1f3a;
                --teal: #0d9488;
                --offwhite: #f4f7fb;
                --border: #dde4f0;
                --muted: #6b7a99;
                --red: #dc2626;
            }

            body {
                font-family: 'DM Sans', sans-serif;
                background: var(--offwhite);
                color: var(--navy);
            }

            /* =========================
                   TOPBAR
                ========================= */

            .topbar {
                height: 72px;
                background: var(--navy);
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0 24px;
                border-bottom: 1px solid rgba(255,255,255,0.06);
            }

            /* BRAND */
            .brand {
                display: flex;
                align-items: center;
                gap: 14px;
                text-decoration: none;
                color: white;
            }

            .brand-logo {
                width: 42px;
                height: 42px;
                min-width: 42px;
                border-radius: 12px;
                background: linear-gradient(135deg, #14b8a6, #0d9488);
                display: flex;
                justify-content: center;
                align-items: center;
            }

                .brand-logo svg {
                    width: 22px;
                    height: 22px;
                    fill: white;
                }

            .brand-name {
                display: flex;
                flex-direction: column;
                line-height: 1.1;
                font-family: 'DM Serif Display', serif;
                font-size: 1.05rem;
                color: white;
            }

                .brand-name span {
                    font-family: 'DM Sans', sans-serif;
                    font-size: 0.65rem;
                    letter-spacing: 0.08em;
                    text-transform: uppercase;
                    color: rgba(255,255,255,0.6);
                    margin-top: 2px;
                }

            /* RIGHT SIDE */
            .topbar-right {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            /* USER CHIP */
            .user-chip {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 6px 12px;
                border-radius: 999px;
                background: rgba(255,255,255,0.05);
                border: 1px solid rgba(255,255,255,0.08);
            }

            .user-avatar {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: #14b8a6;
                display: flex;
                justify-content: center;
                align-items: center;
                color: white;
                font-size: 0.85rem;
                font-weight: 700;
            }

            .user-email {
                color: rgba(255,255,255,0.9);
                font-size: 0.82rem;
                font-weight: 500;
            }

            /* LOGOUT */
            .logout-btn {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 10px 14px;
                border-radius: 10px;
                background: rgba(255,255,255,0.05);
                border: 1px solid rgba(255,255,255,0.08);
                color: white;
                text-decoration: none;
                font-size: 0.82rem;
                font-weight: 600;
                transition: 0.2s ease;
            }

                .logout-btn:hover {
                    background: rgba(255,255,255,0.12);
                }

                .logout-btn svg {
                    width: 16px;
                    height: 16px;
                }

            /* =========================
                   PAGE
                ========================= */

            .page {
                display: flex;
                min-height: calc(100vh - 72px);
            }

            /* =========================
                   SIDEBAR
                ========================= */

            .sidebar {
                width: 220px;
                background: var(--navy);
                border-right: 1px solid rgba(255,255,255,0.08);
                padding: 14px 10px;
                flex-shrink: 0;
            }

            .nav-label {
                font-size: 0.6rem;
                letter-spacing: 0.12em;
                margin: 14px 10px 6px;
                color: rgba(255,255,255,0.5);
                text-transform: uppercase;
                font-weight: 600;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 10px 12px;
                border-radius: 10px;
                font-size: 0.78rem;
                font-weight: 500;
                color: rgba(255,255,255,0.7);
                text-decoration: none;
                transition: 0.2s ease;
                margin-bottom: 4px;
            }

                .nav-item svg {
                    width: 15px;
                    height: 15px;
                    stroke: currentColor;
                    flex-shrink: 0;
                }

                .nav-item:hover {
                    background: rgba(255,255,255,0.08);
                    color: white;
                }

                .nav-item.active {
                    background: rgba(13,148,136,0.22);
                    color: #14b8a6;
                    border-left: 3px solid #14b8a6;
                }

            /* =========================
                   MAIN CONTENT
                ========================= */

            .main {
                flex: 1;
                padding: 30px;
            }

            .grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 20px;
            }

            /* =========================
                   CARDS
                ========================= */

            .card {
                background: white;
                border: 1px solid var(--border);
                border-radius: 16px;
                padding: 24px;
                margin-bottom: 20px;
            }

            .title {
                font-family: 'DM Serif Display', serif;
                font-size: 1.3rem;
                margin-bottom: 18px;
            }

            /* =========================
                   PROFILE HEADER
                ========================= */

            .profile-header {
                display: flex;
                align-items: center;
                gap: 18px;
            }

            .profile-avatar {
                width: 78px;
                height: 78px;
                border-radius: 50%;
                background: var(--teal);
                color: white;
                font-size: 30px;
                font-weight: 700;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .profile-name {
                font-size: 1.6rem;
                font-family: 'DM Serif Display', serif;
            }

            .profile-email {
                color: var(--muted);
                margin-top: 4px;
            }

            .badge {
                margin-top: 10px;
                display: inline-block;
                padding: 6px 12px;
                background: rgba(13,148,136,0.1);
                color: var(--teal);
                border-radius: 999px;
                font-size: 0.8rem;
                font-weight: 600;
            }

            /* =========================
                   FORM
                ========================= */

            .form-group {
                margin-bottom: 16px;
            }

            .form-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 14px;
            }

            label {
                display: block;
                margin-bottom: 6px;
                font-size: 0.75rem;
                font-weight: 700;
                text-transform: uppercase;
                color: var(--muted);
            }

            input {
                width: 100%;
                padding: 12px;
                border: 1px solid var(--border);
                border-radius: 10px;
                font-size: 0.95rem;
                background: white;
            }

                input:focus {
                    outline: none;
                    border-color: var(--teal);
                    box-shadow: 0 0 0 3px rgba(13,148,136,0.15);
                }

                input[readonly] {
                    background: #f7f9fc;
                }

            /* =========================
                   BUTTONS
                ========================= */

            .btn {
                padding: 12px 18px;
                border: none;
                border-radius: 10px;
                cursor: pointer;
                font-weight: 700;
                transition: 0.2s ease;
            }

            .btn-primary {
                background: var(--teal);
                color: white;
            }

                .btn-primary:hover {
                    opacity: 0.92;
                }

            .btn-danger {
                background: var(--red);
                color: white;
            }

                .btn-danger:hover {
                    opacity: 0.92;
                }

            /* =========================
                   RESPONSIVE
                ========================= */

            

            @@media (max-width: 768px) {

                .topbar {
                    padding: 0 16px;
                }

                .brand-name span {
                    display: none;
                }

                .user-email {
                    display: none;
                }

                .logout-btn span {
                    display: none;
                }

                .topbar-right {
                    gap: 10px;
                }

                .main {
                    padding: 18px;
                }

                .form-row {
                    grid-template-columns: 1fr;
                }
            }

    </style>
</head>

<body>

    <!-- TOPBAR -->
    <div class="topbar">

        <!-- BRAND -->
        <a class="brand"
           asp-controller="Home"
           asp-action="Index">

            <div class="brand-logo">

                <svg viewBox="0 0 24 24">

                    <path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z"></path>

                </svg>

            </div>

            <div class="brand-name">

                NMB-HLabSys

                <span>
                    Haematology Lab System
                </span>

            </div>

        </a>

        <!-- RIGHT -->
        <div class="topbar-right">

            <div class="user-chip">

                <div class="user-avatar">

                    @(Model.FirstName.Substring(0, 1).ToUpper())

                </div>

                <span class="user-email">

                    @Model.Email

                </span>

            </div>

            <a asp-controller="Home"
               asp-action="Logout"
               class="logout-btn">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>

                    <polyline points="16 17 21 12 16 7"></polyline>

                    <line x1="21"
                          y1="12"
                          x2="9"
                          y2="12"></line>

                </svg>

                <span>
                    Sign Out
                </span>

            </a>

        </div>

    </div>

    <!-- PAGE -->
    <div class="page">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="nav-label">
                Main
            </div>

            <a asp-controller="ManagerDashboard"
               asp-action="Index"
               class="nav-item">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <rect x="3" y="3" width="7" height="7"></rect>
                    <rect x="14" y="3" width="7" height="7"></rect>
                    <rect x="3" y="14" width="7" height="7"></rect>
                    <rect x="14" y="14" width="7" height="7"></rect>

                </svg>

                Dashboard

            </a>

            <a asp-controller="ManagerDashboard"
               asp-action="TestCatalogue"
               class="nav-item">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <path d="M9 3v11a3 3 0 0 0 6 0V3"></path>
                    <line x1="6" y1="3" x2="18" y2="3"></line>

                </svg>

                Test Catalogue

            </a>

            <a asp-controller="ManagerDashboard"
               asp-action="Consumables"
               class="nav-item">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>

                    <polyline points="14 2 14 8 20 8"></polyline>

                </svg>

                Consumables

            </a>

            <a asp-controller="ManagerDashboard"
               asp-action="Staff"
               class="nav-item">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>

                    <circle cx="12" cy="7" r="4"></circle>

                </svg>

                Staff

            </a>

            <a asp-controller="ManagerDashboard"
               asp-action="Orders"
               class="nav-item">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>

                </svg>

                Orders

            </a>

            <a asp-controller="ManagerDashboard"
               asp-action="Report"
               class="nav-item">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <path d="M3 3h18v18H3z"></path>
                    <path d="M8 12h8"></path>
                    <path d="M8 16h5"></path>

                </svg>

                Reports

            </a>

            <div class="nav-label">
                System
            </div>

            <a asp-controller="ManagerDashboard"
               asp-action="Profile"
               class="nav-item active">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <circle cx="12" cy="8" r="4"></circle>

                    <path d="M6 20c0-3.5 2.5-6 6-6s6 2.5 6 6"></path>

                </svg>

                Profile

            </a>

            <a asp-controller="ManagerDashboard"
               asp-action="AuditLog"
               class="nav-item">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>

                </svg>

                Audit Log

            </a>

        </aside>

        <!-- MAIN -->
        <main class="main">

            <div class="grid">

                <!-- LEFT -->
                <div>

                    <!-- PROFILE -->
                    <div class="card">

                        <div class="profile-header">

                            <div class="profile-avatar">

                                @(Model.FirstName.Substring(0, 1).ToUpper())

                            </div>

                            <div>

                                <div class="profile-name">

                                    @Model.FirstName @Model.LastName

                                </div>

                                <div class="profile-email">

                                    @Model.Email

                                </div>

                                <div class="badge">

                                    Patient

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- ACCOUNT INFO -->
                    <div class="card">

                        <h2 class="title">
                            Account Information
                        </h2>

                        <div class="form-group">

                            <label>Email Address</label>

                            <input type="email"
                                   value="@Model.Email"
                                   readonly />

                        </div>

                        <div class="form-group">

                            <label>SA ID Number</label>

                            <input type="text"
                                   value="@Model.IDNumber"
                                   readonly />

                        </div>

                        <div class="form-group">

                            <label>Registration Date</label>

                            <input type="text"
                                   value="@Model.RegistrationDate"
                                   readonly />

                        </div>

                    </div>

                </div>

                <!-- RIGHT -->
                <div>

                    <!-- PERSONAL DETAILS -->
                    <div class="card">

                        <h2 class="title">
                            Personal Details
                        </h2>

                        <form asp-controller="ManagerDashboard"
                              asp-action="UpdateProfile"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div class="form-row">

                                <div class="form-group">

                                    <label>First Name</label>

                                    <input type="text"
                                           name="FirstName"
                                           value="@Model.FirstName" />

                                </div>

                                <div class="form-group">

                                    <label>Last Name</label>

                                    <input type="text"
                                           name="LastName"
                                           value="@Model.LastName" />

                                </div>

                            </div>

                            <div class="form-group">

                                <label>Date of Birth</label>

                                <input type="date"
                                       name="DateOfBirth"
                                       value="@Model.DateOfBirth.ToString("yyyy-MM-dd")" />

                            </div>

                            <div class="form-group">

                                <label>Cellphone Number</label>

                                <input type="text"
                                       name="PhoneNumber"
                                       value="@Model.CellphoneNumber" />

                            </div>

                            <div class="form-group">

                                <label>Home Address</label>

                                <input type="text"
                                       name="Address"
                                       value="@Model.HomeAddress" />

                            </div>

                            <button class="btn btn-primary"
                                    type="submit">

                                Save Changes

                            </button>

                        </form>

                    </div>

                    <!-- PASSWORD -->
                    <div class="card">

                        <h2 class="title">
                            Change Password
                        </h2>

                        <form asp-controller="ManagerDashboard"
                              asp-action="ChangePassword"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div class="form-group">

                                <label>Current Password</label>

                                <input type="password"
                                       name="CurrentPassword"
                                       required />

                            </div>

                            <div class="form-group">

                                <label>New Password</label>

                                <input type="password"
                                       name="NewPassword"
                                       required />

                            </div>

                            <div class="form-group">

                                <label>Confirm Password</label>

                                <input type="password"
                                       name="ConfirmPassword"
                                       required />

                            </div>

                            <button class="btn btn-danger"
                                    type="submit">

                                Update Password

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </main>

    </div>

</body>
</html>