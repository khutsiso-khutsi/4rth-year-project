@using LabManager.Models
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<TestType>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    ViewData["Title"] = "Test Catalogue";

    // Number of test rows shown per page in the main table
    const int TestsPerPage = 5;

    var tests = Model ?? Enumerable.Empty<TestType>();

    var categories = ViewBag.Categories as IEnumerable<TestCategory>
                     ?? Enumerable.Empty<TestCategory>();

    var sampleTypes = ViewBag.SampleTypes as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();

    var deletedTests = ViewBag.DeletedTests as IEnumerable<TestType> ?? Enumerable.Empty<TestType>();

    var rawTechMap = ViewBag.TechnicianMap as object;

    var consumableOptions = ViewBag.Consumables as IEnumerable<SelectListItem>
                            ?? Enumerable.Empty<SelectListItem>();

    var catSelect = ViewBag.Category as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var sampleSelect = ViewBag.SampleType as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();

    // ── Unified category list (Id, Name, Description) ──
    Func<object, string> descOf = o =>
    {
        try { dynamic d = o; return (string)(d.Description ?? ""); }
        catch { return ""; }
    };

    var catItems = new List<(string Id, string Name, string Desc)>();
    foreach (var c in categories)
    {
        catItems.Add((c.CategoryID.ToString(), c.CategoryName ?? "", descOf(c)));
    }
    if (catItems.Count == 0)
    {
        foreach (var c in catSelect) { catItems.Add((c.Value, c.Text ?? "", "")); }
    }
    catItems = catItems.OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase).ToList();

    // ── Unified sample type list (Id, Name) ──
    var sampleItems = new List<(string Id, string Name)>();
    foreach (var s in sampleTypes)
    {
        sampleItems.Add((((object)s.SampleTypeId).ToString(), (string)(s.SampleName ?? "")));
    }
    if (sampleItems.Count == 0)
    {
        foreach (var s in sampleSelect) { sampleItems.Add((s.Value, s.Text ?? "")); }
    }
    sampleItems = sampleItems.OrderBy(s => s.Name, StringComparer.OrdinalIgnoreCase).ToList();

    // ── Usage counts (how many active tests use each category / sample type) ──
    var catUsage = tests.GroupBy(t => t.CategoryId.ToString()).ToDictionary(g => g.Key, g => g.Count());
    var sampleUsage = tests.GroupBy(t => t.SampleTypeId.ToString()).ToDictionary(g => g.Key, g => g.Count());

    var catNameById = catItems.GroupBy(c => c.Id).ToDictionary(g => g.Key, g => g.First().Name);
    var sampleNameById = sampleItems.GroupBy(s => s.Id).ToDictionary(g => g.Key, g => g.First().Name);

    var emailStr = Convert.ToString(ViewBag.Email);
    var initial = string.IsNullOrEmpty(emailStr) ? "M" : emailStr.Substring(0, 1).ToUpper();
    var testCount = tests.Count();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test Catalogue — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            [hidden] {
                display: none !important;
            }

            :root {
                --navy: #0b1f3a;
                --navy2: #122848;
                --teal: #0d9488;
                --teal-dark: #0b7c72;
                --teal-light: rgba(13,148,136,0.1);
                --white: #ffffff;
                --offwhite: #f4f7fb;
                --muted: #6b7a99;
                --border: #dde4f0;
                --red: #dc2626;
                --red-dark: #b91c1c;
                --red-light: rgba(220,38,38,0.1);
                --green: #16a34a;
                --green-light: rgba(22,163,74,0.1);
                --amber: #d97706;
                --amber-light: rgba(217,119,6,0.1);
                --purple: #4f46e5;
                --purple-light: rgba(79,70,229,0.1);
                --radius-sm: 8px;
                --radius: 12px;
                --radius-lg: 16px;
                --shadow-sm: 0 2px 8px rgba(11,31,58,.05);
                --shadow: 0 2px 8px rgba(11,31,58,.04);
                --shadow-lg: 0 20px 60px rgba(11,31,58,.20);
            }

            body {
                font-family: 'DM Sans', sans-serif;
                background: var(--offwhite);
                color: var(--navy);
                min-height: 100vh;
                line-height: 1.5;
            }

            button, input, select, textarea {
                font-family: inherit;
            }

            /* ── TOPBAR ── */
            .topbar {
                background: var(--navy);
                padding: 0 40px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                height: 64px;
                position: sticky;
                top: 0;
                z-index: 100;
                box-shadow: 0 2px 20px rgba(0,0,0,0.15);
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

            .brand-logo {
                width: 34px;
                height: 34px;
                background: var(--teal);
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .brand-logo svg {
                    width: 18px;
                    height: 18px;
                    fill: white;
                }

            .brand-name {
                font-family: 'DM Serif Display', serif;
                color: white;
                font-size: 1.1rem;
                line-height: 1.1;
            }

                .brand-name span {
                    display: block;
                    font-family: 'DM Sans', sans-serif;
                    font-size: 0.6rem;
                    font-weight: 300;
                    color: rgba(255,255,255,0.4);
                    letter-spacing: 0.1em;
                    text-transform: uppercase;
                }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .user-chip {
                display: flex;
                align-items: center;
                gap: 10px;
                background: rgba(255,255,255,0.07);
                border: 1px solid rgba(255,255,255,0.1);
                border-radius: 100px;
                padding: 6px 14px 6px 8px;
            }

            .user-avatar {
                width: 28px;
                height: 28px;
                background: var(--teal);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.75rem;
                font-weight: 600;
                color: white;
            }

            .user-email {
                font-size: 0.8rem;
                color: rgba(255,255,255,0.75);
                max-width: 160px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .logout-btn {
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.12);
                color: rgba(255,255,255,0.8);
                padding: 8px 16px;
                border-radius: 8px;
                text-decoration: none;
                font-size: 0.82rem;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 6px;
                transition: all 0.2s;
                cursor: pointer;
            }

                .logout-btn:hover {
                    background: rgba(255,255,255,0.15);
                    color: white;
                }

                .logout-btn svg {
                    width: 14px;
                    height: 14px;
                }

            /* ── LAYOUT ── */
            .page {
                display: flex;
                min-height: calc(100vh - 64px);
            }

            /* ── SIDEBAR ── */
            .sidebar {
                width: 220px;
                background: white;
                border-right: 1px solid var(--border);
                padding: 24px 0;
                flex-shrink: 0;
                position: sticky;
                top: 64px;
                height: calc(100vh - 64px);
                overflow-y: auto;
            }

            .nav-section {
                margin-bottom: 8px;
            }

            .nav-label {
                font-size: 0.65rem;
                font-weight: 600;
                color: var(--muted);
                letter-spacing: 0.1em;
                text-transform: uppercase;
                padding: 0 20px;
                margin-bottom: 4px;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 20px;
                color: var(--muted);
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 500;
                transition: all 0.15s;
                border-left: 3px solid transparent;
            }

                .nav-item:hover {
                    background: var(--offwhite);
                    color: var(--navy);
                }

                .nav-item.active {
                    background: var(--teal-light);
                    color: var(--teal);
                    border-left-color: var(--teal);
                    font-weight: 600;
                }

                .nav-item svg {
                    width: 16px;
                    height: 16px;
                    flex-shrink: 0;
                }

                .nav-item:focus-visible {
                    outline: 2px solid var(--teal);
                    outline-offset: -2px;
                }

            /* ── MAIN ── */
            .main {
                flex: 1;
                min-width: 0;
                padding: clamp(24px, 3vw, 40px);
                overflow-y: auto;
            }

            /* ── PAGE HEADER ── */
            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 25px;
                margin-bottom: 25px;
                flex-wrap: wrap;
            }

            .page-title {
                font-family: 'DM Serif Display', serif;
                font-size: 1.8rem;
                font-weight: 400;
                color: var(--navy);
                letter-spacing: -.4px;
                line-height: 1.15;
            }

            .page-description {
                margin-top: 6px;
                font-size: 0.85rem;
                color: var(--muted);
                font-weight: 300;
                max-width: 650px;
            }

            .header-actions {
                display: flex;
                gap: 9px;
                flex-wrap: wrap;
            }

            /* ── BUTTONS ── */
            .btn {
                border: none;
                border-radius: 10px;
                padding: 10px 16px;
                font-family: inherit;
                font-size: 0.82rem;
                font-weight: 600;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                text-decoration: none;
                transition: all .18s ease;
            }

                .btn:hover {
                    transform: translateY(-1px);
                }

                .btn:active {
                    transform: translateY(0);
                }

                .btn:disabled {
                    opacity: .5;
                    cursor: not-allowed;
                    transform: none;
                }

            .btn-sm {
                padding: 7px 12px;
                font-size: 0.78rem;
            }

            .btn-primary {
                background: var(--teal);
                color: var(--white);
                box-shadow: 0 2px 8px rgba(13,148,136,0.25);
            }

                .btn-primary:hover {
                    background: var(--teal-dark);
                    box-shadow: 0 4px 12px rgba(13,148,136,0.3);
                }

            .btn-secondary {
                background: var(--offwhite);
                color: var(--navy);
                border: 1px solid var(--border);
            }

                .btn-secondary:hover:not(:disabled) {
                    background: var(--white);
                    border-color: var(--teal);
                    color: var(--teal);
                    box-shadow: 0 2px 8px rgba(13,148,136,0.1);
                }

            .btn-danger {
                background: var(--red);
                color: var(--white);
                box-shadow: 0 2px 8px rgba(220,38,38,0.2);
            }

                .btn-danger:hover {
                    background: var(--red-dark);
                }

            .btn-amber {
                background: var(--amber-light);
                color: var(--amber);
                border: 1px solid rgba(217,119,6,.3);
            }

                .btn-amber:hover {
                    background: var(--amber);
                    color: var(--white);
                }

            .btn-badge {
                background: var(--amber);
                color: var(--white);
                border-radius: 100px;
                font-size: .68rem;
                padding: 1px 7px;
            }

            .btn-amber:hover .btn-badge {
                background: var(--white);
                color: var(--amber);
            }

            /* ── ALERTS ── */
            .alert {
                padding: 13px 16px;
                border-radius: 10px;
                margin-bottom: 20px;
                font-size: 0.8rem;
                font-weight: 600;
                display: flex;
                align-items: center;
                box-shadow: var(--shadow-sm);
            }

            .alert-success {
                background: var(--green-light);
                color: var(--green);
                border: 1px solid rgba(22,163,74,0.25);
            }

            .alert-error {
                background: var(--red-light);
                color: var(--red);
                border: 1px solid rgba(220,38,38,0.25);
            }

            /* ── CARD ── */
            .card {
                background: white;
                border: 1px solid var(--border);
                border-radius: 16px;
                box-shadow: var(--shadow);
                overflow: hidden;
            }

            .card-header {
                min-height: 66px;
                padding: 14px 24px;
                border-bottom: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 14px;
                flex-wrap: wrap;
                background: #ffffff;
            }

            .card-title {
                font-family: 'DM Serif Display', serif;
                font-size: 1.05rem;
                color: var(--navy);
            }

            .card-tools {
                display: flex;
                align-items: center;
                gap: 10px;
                flex-wrap: wrap;
            }

            .search-box {
                position: relative;
            }

                .search-box svg {
                    position: absolute;
                    left: 10px;
                    top: 50%;
                    transform: translateY(-50%);
                    width: 14px;
                    height: 14px;
                    color: var(--muted);
                    pointer-events: none;
                }

                .search-box input {
                    padding-left: 32px;
                    width: 230px;
                }

            .record-count {
                font-size: 0.72rem;
                font-weight: 600;
                color: var(--muted);
                background: var(--offwhite);
                border: 1px solid var(--border);
                padding: 5px 10px;
                border-radius: 100px;
                white-space: nowrap;
            }

            /* ── TABLE ── */
            .table-container {
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 950px;
            }

            th {
                background: var(--offwhite);
                color: var(--muted);
                font-size: 0.7rem;
                text-transform: uppercase;
                letter-spacing: .08em;
                font-weight: 600;
                padding: 12px 15px;
                text-align: left;
                border-bottom: 1px solid var(--border);
                white-space: nowrap;
            }

            td {
                padding: 14px 15px;
                border-bottom: 1px solid var(--offwhite);
                font-size: 0.83rem;
                vertical-align: middle;
                color: var(--navy);
            }

            tbody tr {
                transition: background .18s ease;
            }

                tbody tr:hover {
                    background: var(--offwhite);
                }

            /* ── TABLE CONTENT ── */
            .test-name {
                font-weight: 700;
                color: var(--navy);
                font-size: 0.85rem;
            }

            .tech-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 4px 10px;
                border-radius: 100px;
                background: var(--purple-light);
                color: var(--purple);
                font-size: 0.72rem;
                font-weight: 700;
                white-space: nowrap;
                cursor: default;
            }

            .tech-none {
                color: #94a3b8;
            }

            .sample-badge {
                display: inline-block;
                padding: 4px 10px;
                border-radius: 100px;
                background: var(--offwhite);
                color: var(--muted);
                font-size: 0.7rem;
                font-weight: 600;
                white-space: nowrap;
                border: 1px solid var(--border);
            }

            .range, .tat {
                font-weight: 600;
                color: var(--navy);
                white-space: nowrap;
            }

            .tat {
                font-weight: 700;
            }

            /* ── ACTION BUTTONS ── */
            .actions {
                display: flex;
                gap: 7px;
            }

            .action-icon-btn {
                border: none;
                width: 32px;
                height: 32px;
                border-radius: 8px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                transition: all .18s ease;
                flex-shrink: 0;
            }

                .action-icon-btn:hover:not(:disabled) {
                    transform: translateY(-1px);
                }

                .action-icon-btn:disabled {
                    opacity: .4;
                    cursor: not-allowed;
                }

            .edit-btn {
                background: var(--purple-light);
                color: var(--purple);
            }

                .edit-btn:hover:not(:disabled) {
                    background: rgba(79,70,229,0.2);
                    box-shadow: 0 3px 8px rgba(79,70,229,0.15);
                }

            .delete-btn {
                background: var(--red-light);
                color: var(--red);
            }

                .delete-btn:hover:not(:disabled) {
                    background: rgba(220,38,38,0.2);
                    box-shadow: 0 3px 8px rgba(220,38,38,0.15);
                }

            /* ── PAGINATION ── */
            .pagination-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 14px;
                flex-wrap: wrap;
                padding: 14px 24px;
                border-top: 1px solid var(--border);
                background: #fff;
            }

                .pagination-bar.compact {
                    padding: 10px 0 0;
                    border-top: none;
                    margin-top: 6px;
                }

            .page-info {
                font-size: 0.75rem;
                color: var(--muted);
            }

                .page-info strong {
                    color: var(--navy);
                }

            .pager {
                display: flex;
                align-items: center;
                gap: 5px;
                flex-wrap: wrap;
            }

            .pg-btn {
                min-width: 32px;
                height: 32px;
                padding: 0 9px;
                border: 1px solid var(--border);
                background: var(--white);
                color: var(--navy);
                border-radius: 8px;
                font-size: 0.78rem;
                font-weight: 600;
                cursor: pointer;
                transition: all .15s ease;
            }

                .pg-btn:hover:not(:disabled):not(.active) {
                    border-color: var(--teal);
                    color: var(--teal);
                    background: var(--teal-light);
                }

                .pg-btn.active {
                    background: var(--teal);
                    border-color: var(--teal);
                    color: var(--white);
                    cursor: default;
                }

                .pg-btn:disabled {
                    opacity: .45;
                    cursor: not-allowed;
                }

            .pg-gap {
                color: var(--muted);
                padding: 0 2px;
                font-size: .8rem;
            }

            /* ── EMPTY STATE ── */
            .empty-state {
                text-align: center;
                padding: 65px 20px;
                color: var(--muted);
            }

            .empty-icon {
                width: 70px;
                height: 70px;
                margin: 0 auto 17px;
                border-radius: 50%;
                background: var(--teal-light);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 32px;
            }

            .empty-title {
                font-size: 1rem;
                font-weight: 700;
                color: var(--navy);
                margin-bottom: 5px;
            }

            .empty-state > div:not(.empty-icon):not(.empty-title) {
                font-size: 0.8rem;
            }

            /* ── MODAL OVERLAY ── */
            .modal-overlay {
                position: fixed;
                inset: 0;
                background: rgba(11,31,58,.45);
                backdrop-filter: blur(3px);
                display: none;
                align-items: center;
                justify-content: center;
                padding: 20px;
                z-index: 2000;
            }

                .modal-overlay.show {
                    display: flex;
                }

                .modal-overlay.top {
                    z-index: 2200;
                }

            .modal {
                width: 100%;
                max-width: 650px;
                max-height: 90vh;
                overflow-y: auto;
                background: var(--white);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-lg);
                animation: modalIn .18s ease;
            }

            @@keyframes modalIn {
                from {
                    opacity: 0;
                    transform: scale(0.96) translateY(8px);
                }

                to {
                    opacity: 1;
                    transform: scale(1) translateY(0);
                }
            }

            .modal-header {
                padding: 19px 22px;
                border-bottom: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
                background: #ffffff;
                position: sticky;
                top: 0;
                z-index: 2;
            }

            .modal-title {
                font-family: 'DM Serif Display', serif;
                font-size: 1.3rem;
                font-weight: 400;
                color: var(--navy);
            }

            .close-btn {
                width: 32px;
                height: 32px;
                border: none;
                border-radius: 8px;
                background: var(--offwhite);
                color: var(--muted);
                cursor: pointer;
                font-size: 18px;
                transition: background .18s ease, transform .18s ease;
            }

                .close-btn:hover {
                    background: var(--border);
                    color: var(--navy);
                    transform: rotate(3deg);
                }

            .modal-body {
                padding: 23px;
            }

            .modal-footer {
                padding: 16px 22px;
                border-top: 1px solid var(--border);
                display: flex;
                justify-content: flex-end;
                gap: 10px;
                background: var(--offwhite);
            }

            /* ── FORM ── */
            .form-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 17px;
            }

            .form-group {
                display: flex;
                flex-direction: column;
                gap: 7px;
            }

                .form-group.full {
                    grid-column: 1 / -1;
                }

            .form-label {
                font-size: 0.75rem;
                font-weight: 700;
                color: var(--navy);
            }

            .required {
                color: var(--red);
                margin-left: 2px;
            }

            .form-control {
                width: 100%;
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 10px 12px;
                font-family: inherit;
                font-size: 0.82rem;
                color: var(--navy);
                outline: none;
                background: var(--white);
                transition: border-color .18s ease, box-shadow .18s ease;
            }

                .form-control:hover {
                    border-color: #b9c5d3;
                }

                .form-control:focus {
                    border-color: var(--teal);
                    box-shadow: 0 0 0 3px var(--teal-light);
                }

            textarea.form-control {
                min-height: 70px;
                resize: vertical;
                line-height: 1.5;
            }

            select.form-control {
                cursor: pointer;
            }

            .form-help {
                font-size: 0.7rem;
                color: var(--muted);
                margin-top: -2px;
            }

            .form-control.is-invalid {
                border-color: var(--red);
                box-shadow: 0 0 0 3px var(--red-light);
            }

            .field-error {
                display: none;
                font-size: .7rem;
                color: var(--red);
                font-weight: 600;
                margin-top: -2px;
            }

                .field-error.show {
                    display: block;
                }

            /* ── CONSUMABLE ROWS ── */
            .consumable-list {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .consumable-row, .consumable-head {
                display: grid;
                grid-template-columns: minmax(0, 1fr) 90px 36px;
                gap: 8px;
                align-items: center;
            }

            .consumable-head {
                font-size: 0.68rem;
                font-weight: 600;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: .06em;
                margin-bottom: -2px;
            }

            .consumable-row .form-control {
                min-width: 0;
            }

            .c-remove {
                width: 36px;
                height: 36px;
                border: none;
                border-radius: 8px;
                background: var(--red-light);
                color: var(--red);
                font-size: 14px;
                cursor: pointer;
                transition: background .18s ease;
            }

                .c-remove:hover {
                    background: rgba(220,38,38,0.2);
                }

            .consumable-actions {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-top: 2px;
                flex-wrap: wrap;
            }

            .consumable-empty, .legacy-note {
                font-size: 0.75rem;
                color: var(--muted);
            }

            .legacy-note {
                background: var(--amber-light);
                color: var(--amber);
                border: 1px solid rgba(217,119,6,.3);
                border-radius: 8px;
                padding: 8px 10px;
                font-weight: 600;
            }

            /* ── MANAGE MODALS ── */
            .manage-form {
                background: var(--offwhite);
                border: 1px solid var(--border);
                border-radius: 12px;
                padding: 16px;
                margin-bottom: 20px;
            }

            .manage-form-title {
                font-size: .8rem;
                font-weight: 700;
                margin-bottom: 12px;
                color: var(--navy);
            }

            .manage-form .form-grid {
                gap: 12px;
            }

            .manage-form-actions {
                display: flex;
                justify-content: flex-end;
                gap: 8px;
                margin-top: 12px;
            }

            .manage-list-head {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 10px;
            }

            .manage-list-title {
                font-size: .72rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .08em;
                color: var(--muted);
            }

            .manage-list {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .manage-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                padding: 11px 14px;
                border: 1px solid var(--border);
                border-radius: 10px;
                background: var(--white);
                transition: border-color .15s ease, background .15s ease;
            }

                .manage-row:hover {
                    border-color: #b9c5d3;
                }

                .manage-row.editing {
                    border-color: var(--teal);
                    background: var(--teal-light);
                }

            .manage-row-main {
                min-width: 0;
            }

            .manage-row-name {
                font-weight: 700;
                font-size: .84rem;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .manage-row-meta {
                font-size: .7rem;
                color: var(--muted);
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .manage-empty {
                text-align: center;
                font-size: .8rem;
                color: var(--muted);
                padding: 24px 10px;
                border: 1px dashed var(--border);
                border-radius: 10px;
            }

            /* ── DELETE MODAL ── */
            .delete-content {
                text-align: center;
                padding: 10px 10px 5px;
            }

            .delete-icon {
                width: 55px;
                height: 55px;
                margin: 0 auto 15px;
                border-radius: 14px;
                background: var(--red-light);
                color: var(--red);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 25px;
                font-weight: 800;
            }

            .delete-title {
                font-size: 1.2rem;
                font-weight: 700;
                color: var(--navy);
                font-family: 'DM Serif Display', serif;
            }

            .delete-message {
                margin: 8px 0 0;
                color: var(--muted);
                font-size: 0.85rem;
                line-height: 1.6;
            }

                .delete-message strong {
                    color: var(--navy);
                }

            /* ── RESTORE LIST ── */
            .restore-list {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .restore-item {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                padding: 12px 14px;
                border: 1px solid var(--border);
                border-radius: 10px;
                background: var(--offwhite);
            }

                .restore-item .meta {
                    font-size: .72rem;
                    color: var(--muted);
                }

                .restore-item form {
                    margin: 0;
                }

            /* ── FOOTER ── */
            .footer {
                margin-top: 28px;
                padding: 0 2px;
                display: flex;
                justify-content: space-between;
                color: var(--muted);
                font-size: 0.7rem;
            }

            /* ── SCROLLBAR ── */
            .modal::-webkit-scrollbar,
            .sidebar::-webkit-scrollbar,
            .table-container::-webkit-scrollbar {
                width: 7px;
                height: 7px;
            }

            .modal::-webkit-scrollbar-track,
            .sidebar::-webkit-scrollbar-track,
            .table-container::-webkit-scrollbar-track {
                background: var(--offwhite);
            }

            .modal::-webkit-scrollbar-thumb,
            .sidebar::-webkit-scrollbar-thumb,
            .table-container::-webkit-scrollbar-thumb {
                background: var(--border);
                border-radius: 20px;
            }

            /* ── RESPONSIVE ── */
            @@media (max-width: 768px) {
                .topbar {
                    padding: 0 20px;
                }

                .user-email {
                    display: none;
                }

                .sidebar {
                    display: none;
                }

                .main {
                    padding: 20px 16px;
                }

                .page-header {
                    flex-direction: column;
                    gap: 16px;
                }

                .page-title {
                    font-size: 1.5rem;
                }

                .header-actions {
                    width: 100%;
                }

                    .header-actions .btn {
                        flex: 1;
                    }

                .search-box input {
                    width: 100%;
                }

                .search-box {
                    flex: 1;
                    min-width: 160px;
                }

                .form-grid {
                    grid-template-columns: 1fr;
                }

                .form-group.full {
                    grid-column: auto;
                }

                .modal-overlay {
                    padding: 12px;
                }

                .modal {
                    max-height: 94vh;
                }

                .modal-body {
                    padding: 18px;
                }

                .modal-header {
                    padding: 17px 18px;
                }

                .modal-footer {
                    padding: 14px 18px;
                }

                    .modal-footer .btn {
                        flex: 1;
                    }

                .pagination-bar {
                    padding: 12px 16px;
                    justify-content: center;
                }

                .footer {
                    flex-direction: column;
                    gap: 6px;
                    line-height: 1.5;
                }
            }
    </style>
</head>
<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@initial</div>
                <span class="user-email">@(string.IsNullOrEmpty(emailStr) ? "Laboratory Manager" : emailStr)</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn" id="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="nav-section">
                <div class="nav-label">Management</div>

                <a asp-controller="ManagerDashboard" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                    </svg>
                    Dashboard
                </a>

                <a asp-controller="TestCatalogue" asp-action="Index" class="nav-item active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M9 3v11a3 3 0 006 0V3" />
                        <line x1="6" y1="3" x2="18" y2="3" />
                    </svg>
                    Test Catalogue
                </a>

                <a asp-controller="Consumables" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                    </svg>
                    Consumables
                </a>

                <a asp-controller="ConsumableOrder" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Orders
                </a>

                <a asp-controller="Technician" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                    </svg>
                    User
                </a>

                <a asp-controller="Report" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                    Reports
                </a>
            </div>

            <div class="nav-section">
                <div class="nav-label">System</div>
                <a asp-controller="User" asp-action="Profile" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Profile
                </a>
              
            </div>
        </aside>

        <!-- MAIN -->
        <main class="main">

            <!-- PAGE HEADER -->
            <div class="page-header">
                <div>
                    <h1 class="page-title">Test Catalogue</h1>
                    <p class="page-description">
                        Manage laboratory test types, categories, sample types,
                        reference ranges and turnaround times.
                    </p>
                </div>

                <div class="header-actions">
                    <button type="button" class="btn btn-amber" onclick="openModal('restoreModal')">
                        ↺ Restore Tests
                        @if (deletedTests.Any())
                        {
                            <span class="btn-badge">@deletedTests.Count()</span>
                        }
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="openModal('manageSampleModal')">
                        ⚙ Manage Sample Types
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="openModal('manageCategoryModal')">
                        ⚙ Manage Categories
                    </button>
                    <button type="button" class="btn btn-primary" onclick="openModal('addModal')">
                        <span>＋</span> Add Test Type
                    </button>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">✓ @TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">⚠ @TempData["Error"]</div>
            }

            <!-- TEST TABLE -->
            <div class="card">

                <div class="card-header">
                    <div class="card-title">Laboratory Test Types</div>
                    <div class="card-tools">
                        @if (testCount > 0)
                        {
                            <div class="search-box">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                                <input type="search" id="test-search" class="form-control" placeholder="Search tests, category, sample…" autocomplete="off" />
                            </div>
                        }
                        <div class="record-count" id="test-count">@testCount test type(s)</div>
                    </div>
                </div>

                @if (testCount > 0)
                {
                    <div class="table-container">
                        <table id="test-table" data-per-page="@TestsPerPage">
                            <thead>
                                <tr>
                                    <th>Test</th>
                                    <th>Category</th>
                                    <th>Sample Type</th>
                                    <th>Unit</th>
                                    <th>Normal Range</th>
                                    <th>TAT</th>
                                    <th>Consumables</th>
                                    <th>Technicians</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var test in tests)
                                {
                                    var categoryText = catNameById.TryGetValue(test.CategoryId.ToString(), out var cn) ? cn : "—";
                                    var sampleText = sampleNameById.TryGetValue(test.SampleTypeId.ToString(), out var sn) ? sn : "—";
                                    var unitText = System.Net.WebUtility.HtmlDecode(test.UnitMeasurement ?? "");

                                    // ConsumablesUsed holds JSON like [{"id":11,"name":"ReagentA","quantity":12}].
                                    // Older rows may hold plain text such as "Tubes", so handle both.
                                    var consumableItems = new List<(string Name, int Qty)>();
                                    var consumablesIsLegacy = false;
                                    var rawConsumables = (test.ConsumablesUsed ?? "").Trim();

                                    if (rawConsumables.StartsWith("["))
                                    {
                                        JsonDocument consumableDoc = null;
                                        try
                                        {
                                            consumableDoc = JsonDocument.Parse(rawConsumables);
                                            foreach (var el in consumableDoc.RootElement.EnumerateArray())
                                            {
                                                string cName = el.TryGetProperty("name", out var cNameProp) ? cNameProp.GetString() : null;
                                                int cQty = 0;
                                                if (el.TryGetProperty("quantity", out var cQtyProp)) { cQtyProp.TryGetInt32(out cQty); }
                                                if (!string.IsNullOrWhiteSpace(cName)) { consumableItems.Add((cName, cQty)); }
                                            }
                                        }
                                        catch (JsonException) { consumablesIsLegacy = true; }
                                        catch (InvalidOperationException) { consumablesIsLegacy = true; }
                                        finally { consumableDoc?.Dispose(); }
                                    }
                                    else if (rawConsumables.Length > 0)
                                    {
                                        consumablesIsLegacy = true;
                                    }

                                    // Technician names assigned to this test
                                    var techNames = new List<string>();

                                    if (rawTechMap is IDictionary<int, List<string>> techListMap
                                        && techListMap.TryGetValue(test.TestId, out var techListValue)
                                        && techListValue != null)
                                    {
                                        techNames = techListValue;
                                    }
                                    else if (rawTechMap is IDictionary<int, string> techStringMap
                                        && techStringMap.TryGetValue(test.TestId, out var techStringValue)
                                        && !string.IsNullOrWhiteSpace(techStringValue)
                                        && techStringValue != "—")
                                    {
                                        techNames = techStringValue
                                            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                                            .ToList();
                                    }

                                    techNames = techNames
                                        .Where(n => !string.IsNullOrWhiteSpace(n))
                                        .Distinct(StringComparer.OrdinalIgnoreCase)
                                        .ToList();

                                    var searchText = (test.TestName + " " + categoryText + " " + sampleText + " " + unitText).ToLowerInvariant();

                                    <tr class="test-row" data-search="@searchText">
                                        <td><div class="test-name">@test.TestName</div></td>
                                        <td>@categoryText</td>
                                        <td>@sampleText</td>
                                        <td>@(string.IsNullOrWhiteSpace(unitText) ? "—" : unitText)</td>
                                        <td><span class="range">@test.NormalRangeDisplay</span></td>
                                        <td><span class="tat">@test.TurnaroundTime hrs</span></td>
                                        <td>
                                            @if (consumableItems.Count > 0)
                                            {
                                                <div style="display:flex;flex-wrap:wrap;gap:4px;">
                                                    @foreach (var ci in consumableItems)
                                                    {
                                                        <span class="sample-badge">@ci.Name × @ci.Qty</span>
                                                    }
                                                </div>
                                            }
                                            else if (consumablesIsLegacy)
                                            {
                                                @rawConsumables
                                            }
                                            else
                                            {
                                                <span class="tech-none">None</span>
                                            }
                                        </td>
                                        <td>
                                            @if (techNames.Count > 0)
                                            {
                                                <span class="tech-badge" title="@(string.Join(", ", techNames))">
                                                    @techNames.Count technician@(techNames.Count == 1 ? "" : "s")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="tech-none">None</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="actions">
                                                @if (test.TestId > 0)
                                                {
                                                    <button type="button"
                                                            class="action-icon-btn edit-btn"
                                                            title="Edit"
                                                            data-testid="@test.TestId"
                                                            data-testname="@test.TestName"
                                                            data-categoryid="@test.CategoryId"
                                                            data-sampletypeid="@test.SampleTypeId"
                                                            data-unit="@unitText"
                                                            data-normalmin="@(test.NormalRangeMin?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                            data-normalmax="@(test.NormalRangeMax?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                            data-tat="@test.TurnaroundTime"
                                                            data-consumables="@test.ConsumablesUsed"
                                                            onclick="populateEditModal(this)">
                                                        ✎
                                                    </button>

                                                    <button type="button"
                                                            class="action-icon-btn delete-btn"
                                                            title="Delete"
                                                            data-testid="@test.TestId"
                                                            data-testname="@test.TestName"
                                                            onclick="populateDeleteModal(this)">
                                                        🗑
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="action-icon-btn edit-btn" title="Invalid test id" disabled>✎</button>
                                                    <button type="button" class="action-icon-btn delete-btn" title="Invalid test id" disabled>🗑</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div id="no-results" class="empty-state" style="padding:40px 20px;" hidden>
                        <div class="empty-title">No matching tests</div>
                        <div>Try a different search term.</div>
                    </div>

                    <!-- PAGINATION (fixed at @TestsPerPage rows per page) -->
                    <div class="pagination-bar" id="test-pagination">
                        <div class="page-info" id="test-page-info"></div>
                        <div class="pager" id="test-pager"></div>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">🧪</div>
                        <div class="empty-title">No test types found</div>
                        <div>Add your first laboratory test type to the catalogue.</div>
                        <br />
                        <button type="button" class="btn btn-primary" onclick="openModal('addModal')">
                            ＋ Add Test Type
                        </button>
                    </div>
                }

            </div>

            <!-- FOOTER -->
            <div class="footer">
                <span>NMB-HLabSys · Haematology Laboratory System</span>
                <span>Internal management system · @DateTime.Now.ToString("yyyy")</span>
            </div>

        </main>
    </div>

    <!-- Consumable option source for per-row dropdowns (never posted: no name, disabled) -->
    <select id="consumable-source" hidden disabled aria-hidden="true">
        <option value="">Select consumable</option>
        @foreach (var c in consumableOptions)
        {
            <option value="@c.Value">@c.Text</option>
        }
    </select>

    <!-- =====================================================
         ADD TEST TYPE MODAL
    ====================================================== -->
    <div id="addModal" class="modal-overlay">
        <div class="modal">
            <form asp-controller="TestCatalogue" asp-action="AddTestType" method="post" novalidate data-validate>
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h2 class="modal-title">Add Test Type</h2>
                    <button type="button" class="close-btn" onclick="closeModal('addModal')">×</button>
                </div>

                <div class="modal-body">
                    <div class="form-grid">

                        <div class="form-group full">
                            <label class="form-label">Test Name<span class="required">*</span></label>
                            <input type="text" name="TestName" class="form-control" placeholder="e.g. Full Blood Count" required
                                   data-required="Test name is required." data-minlength="2" data-maxlength="100"
                                   data-pattern="^[A-Za-z0-9 ()/.,&%+\-]+$" data-pattern-msg="Test name contains invalid characters." />
                            <span class="field-error"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Category<span class="required">*</span></label>
                            <select name="CategoryId" class="form-control cat-select" required
                                    data-required="Please select a category.">
                                <option value="">Select category</option>
                                @foreach (var cat in catItems)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                            <span class="field-error"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Sample Type<span class="required">*</span></label>
                            <select name="SampleTypeId" class="form-control sample-select" required
                                    data-required="Please select a sample type.">
                                <option value="">Select sample type</option>
                                @foreach (var st in sampleItems)
                                {
                                    <option value="@st.Id">@st.Name</option>
                                }
                            </select>
                            <span class="field-error"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Unit Measurement</label>
                            <select name="UnitMeasurement" class="form-control unit-select">
                                <option value="">Select unit</option>
                                <option value="µL">µL</option>
                                <option value="mcL">mcL</option>
                                <option value="g/dL">g/dL</option>
                                <option value="g/L">g/L</option>
                                <option value="g/mL">g/mL</option>
