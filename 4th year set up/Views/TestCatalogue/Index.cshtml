            /* =========================================================
                               MODAL BODY
                            ========================================================= */

            .modal-body {
                padding: 23px;
            }
        .modal-body {
            padding: 23px;
        }

        .modal-footer {
            padding: 16px 22px;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            background: var(--offwhite);
        }


            /* =========================================================
                               FORM
                            ========================================================= */

            .form-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 17px;
            }
        /* ── FORM ── */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 17px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

            .form-group.full {
                grid-column: 1 / -1;
            }

        .form-label {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--navy);
        }

        .required {
            color: var(--red);
            margin-left: 2px;
        }

        .form-control {
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 12px;
            font-family: inherit;
            font-size: 0.82rem;
            color: var(--navy);
            outline: none;
            background: var(--white);
            transition: border-color .18s ease, box-shadow .18s ease;
        }

            .form-control:hover {
                border-color: #b9c5d3;
            }

            .form-control:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 3px var(--teal-light);
            }

        textarea.form-control {
            min-height: 82px;
            resize: vertical;
            line-height: 1.5;
        }

        select.form-control {
            cursor: pointer;
        }

        .form-help {
            font-size: 0.7rem;
            color: var(--muted);
            margin-top: -2px;
        }

        .form-control.is-invalid {
            border-color: var(--red);
            box-shadow: 0 0 0 3px var(--red-light);
        }

            /* =========================================================
                               DELETE MODAL
                            ========================================================= */
        .field-error {
            display: none;
            font-size: .7rem;
            color: var(--red);
            font-weight: 600;
            margin-top: -2px;
        }

            .field-error.show {
                display: block;
            }

        /* ── CONSUMABLE ROWS (name + quantity + remove on ONE line) ── */
        .consumable-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .consumable-row {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 90px 36px;
            gap: 8px;
            align-items: center;
        }

        .consumable-head {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 90px 36px;
            gap: 8px;
            font-size: 0.68rem;
            font-weight: 600;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .06em;
            margin-bottom: -2px;
        }

        .consumable-row .form-control {
            min-width: 0;
        }

        .c-remove {
            width: 36px;
            height: 36px;
            border: none;
            border-radius: 8px;
            background: var(--red-light);
            color: var(--red);
            font-size: 14px;
            cursor: pointer;
            transition: background .18s ease;
        }

            .c-remove:hover {
                background: rgba(220,38,38,0.2);
            }

        .consumable-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 2px;
        }

        .consumable-empty {
            font-size: 0.75rem;
            color: var(--muted);
        }

        /* ── DELETE MODAL ── */
        .delete-content {
            text-align: center;
            padding: 10px 10px 5px;
        }

        .delete-icon {
            width: 55px;
            height: 55px;
            margin: 0 auto 15px;
            border-radius: 14px;
            background: var(--red-light);
            color: var(--red);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
            font-weight: 800;
        }

        .delete-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--navy);
            font-family: 'DM Serif Display', serif;
        }

        .delete-message {
            margin: 8px 0 0;
            color: var(--muted);
            font-size: 0.85rem;
            line-height: 1.6;
        }

            .delete-message strong {
                color: var(--navy);
            }

        /* ── RESTORE LIST ── */
        .restore-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

            /* =========================================================
                               FOOTER
                            ========================================================= */
        .restore-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--offwhite);
        }

            .restore-item .meta {
                font-size: .72rem;
                color: var(--muted);
            }

            .restore-item form {
                margin: 0;
            }

        /* ── FOOTER ── */
        .footer {
            margin-top: 28px;
            padding: 0 2px;
            display: flex;
            justify-content: space-between;
            color: var(--muted);
            font-size: 0.7rem;
        }


            /* =========================================================
                               SCROLLBAR
                            ========================================================= */

            .modal::-webkit-scrollbar,
            .sidebar::-webkit-scrollbar,
            .table-container::-webkit-scrollbar {
                width: 7px;
                height: 7px;
            }
        /* ── SCROLLBAR ── */
        .modal::-webkit-scrollbar,
        .sidebar::-webkit-scrollbar,
        .table-container::-webkit-scrollbar {
            width: 7px;
            height: 7px;
        }

        .modal::-webkit-scrollbar-track,
        .sidebar::-webkit-scrollbar-track,
        .table-container::-webkit-scrollbar-track {
            background: var(--offwhite);
        }

        .modal::-webkit-scrollbar-thumb,
        .sidebar::-webkit-scrollbar-thumb,
        .table-container::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 20px;
        }


            /* =========================================================
                               RESPONSIVE — TABLET
                            ========================================================= */

            @@media (max-width: 850px) {

                .sidebar {
                    width: 70px;
                    padding: 20px 8px;
                }

                .nav-section-title,
                .nav-text {
                    display: none;
                }

                .nav-item {
                    justify-content: center;
                    padding: 12px 8px;
                }

                    .nav-item.active {
                        box-shadow: none;
                    }

                .main {
                    margin-left: 70px;
                    padding-left: 22px;
                    padding-right: 22px;
                }

                .user-info {
                    display: none;
                }

                .page-title {
                    font-size: 30px;
                }
            }


            /* =========================================================
                               RESPONSIVE — MOBILE
                            ========================================================= */

            @@media (max-width: 650px) {

                .topbar {
                    padding: 0 16px;
                }
        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .topbar {
                padding: 0 20px;
            }

            .user-email {
                display: none;
            }

            .sidebar {
                display: none;
            }

            .main {
                padding: 20px 16px;
            }

            .page-header {
                flex-direction: column;
                gap: 16px;
            }

            .page-title {
                font-size: 1.5rem;
            }

            .header-actions {
                width: 100%;
            }

                .header-actions .btn {
                    flex: 1;
                }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full {
                grid-column: auto;
            }

            .modal-overlay {
                padding: 12px;
            }

            .modal {
                max-height: 94vh;
            }

            .modal-body {
                padding: 18px;
            }

            .modal-header {
                padding: 17px 18px;
            }

            .modal-footer {
                padding: 14px 18px;
            }

                .modal-footer .btn {
                    flex: 1;
                }

                .footer {
                    flex-direction: column;
                    gap: 6px;
                    line-height: 1.5;
                }
            }


            /* =========================================================
                               VERY SMALL SCREENS
                            ========================================================= */

            @@media (max-width: 420px) {

                .topbar {
                    height: 64px;
                }

                .sidebar {
                    top: 64px;
                }

                .main {
                    padding-top: 84px;
                }

                .brand-name {
                    font-size: 17px;
                }

                .avatar {
                    width: 36px;
                    height: 36px;
                }

                .page-title {
                    font-size: 25px;
                }

                .header-actions {
                    flex-direction: column;
                }

                    .header-actions .btn {
                        width: 100%;
                    }

                .card-header {
                    padding: 15px 17px;
                }

                .record-count {
                    font-size: 10px;
                }
            }

            .footer {
                flex-direction: column;
                gap: 6px;
                line-height: 1.5;
            }
        }
    </style>
</head>
<body>

    <!-- =========================
         TOPBAR
    ========================= -->

    <header class="topbar">

        <div class="brand">

            <div class="brand-icon">
                🧪
    <!-- TOPBAR -->
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@(ViewBag.Email?.ToString().Substring(0, 1).ToUpper() ?? "M")</div>
                <span class="user-email">@(ViewBag.Email ?? "Laboratory Manager")</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn" id="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">

        </div>

    </header>


    <!-- =========================
         SIDEBAR
    ========================= -->

    <aside class="sidebar">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="nav-section">
                <div class="nav-label">Management</div>

                <a asp-controller="ManagerDashboard" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                    </svg>
                    Dashboard
                </a>

                <a asp-controller="TestCatalogue" asp-action="Index" class="nav-item active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M9 3v11a3 3 0 006 0V3" />
                        <line x1="6" y1="3" x2="18" y2="3" />
                    </svg>
                    Test Catalogue
                </a>

                <a asp-controller="Consumables" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                    </svg>
                    Consumables
                </a>

                <a asp-controller="ConsumableOrder" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Orders
                </a>

                <a asp-controller="Technician" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                    </svg>
                   User
                </a>

                <a asp-controller="Report" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                    Reports
                </a>

                <div class="nav-section">
                <div class="nav-label">System</div>
                <a asp-controller="User" asp-action="Profile" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Profile
                </a>
                <a asp-controller="ManagerDashboard" asp-action="AuditLog" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                    Audit Log
                </a>
            </div>
            </div>
        </aside>


    <!-- =========================
         MAIN CONTENT
    ========================= -->

    <main class="main">
        <!-- MAIN -->
        <main class="main">

            <!-- PAGE HEADER -->
            <div class="page-header">
                <div>
                    <h1 class="page-title">Test Catalogue</h1>
                    <p class="page-description">
                        Manage laboratory test types, reference ranges,
                        sample types and turnaround times.
                    </p>
                </div>

                <div class="header-actions">
                    <button type="button" class="btn btn-amber" onclick="openModal('restoreModal')">
                        ↺ Restore Tests
                        @if (deletedTests.Any())
                        {
                            <span class="btn-badge">@deletedTests.Count()</span>
                        }
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="openModal('addSampleTypeModal')">
                        <span>＋</span> Add Sample Type
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="openModal('addCategoryModal')">
                        <span>＋</span> Add Category
                    </button>
                    <button type="button" class="btn btn-primary" onclick="openModal('addModal')">
                        <span>＋</span> Add Test Type
                    </button>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">✓ @TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">⚠ @TempData["Error"]</div>
            }


        <!-- =========================
             TEST TABLE
        ========================= -->

        <div class="card">
            <!-- TEST TABLE -->
            <div class="card">

                <div class="card-header">
                    <div class="card-title">Laboratory Test Types</div>
                    <div class="record-count">@(Model?.Count() ?? 0) test type(s)</div>
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Test</th>
                                    <th>Category</th>
                                    <th>Sample Type</th>
                                    <th>Unit</th>
                                    <th>Normal Range</th>
                                    <th>TAT</th>
                                    <th>Consumables</th>
                                    <th>Technicians</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var test in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="test-name">@test.TestName</div>
                                        </td>
                                        <td>
                                            @{
                                                var catList = ViewBag.Category as IEnumerable<SelectListItem>;
                                                var categoryText = catList?.FirstOrDefault(c => c.Value == test.CategoryId.ToString())?.Text
                                                    ?? categories.FirstOrDefault(c => c.CategoryID == test.CategoryId)?.CategoryName
                                                    ?? "—";
                                            }
                                            <div>@categoryText</div>
                                        </td>
                                        <td>
                                            @{
                                                var sampleList = ViewBag.SampleType as IEnumerable<SelectListItem>;
                                                var sampleText = sampleList?.FirstOrDefault(s => s.Value == test.SampleTypeId.ToString())?.Text
                                                    ?? sampleTypes.FirstOrDefault(s => s.SampleTypeID.ToString() == test.SampleTypeId.ToString())?.SampleName
                                                    ?? "—";
                                            }
                                            <div>@sampleText</div>
                                        </td>
                                        <td>@(System.Net.WebUtility.HtmlDecode(test.UnitMeasurement ?? "—"))</td>
                                        <td>
                                            <span class="range">@test.NormalRangeDisplay</span>
                                        </td>
                                        <td>
                                            <span class="tat">@test.TurnaroundTime hrs</span>
                                        </td>
                                        <td>
                                            @{
                                                // ConsumablesUsed holds JSON like [{"id":11,"name":"RegeantA","quantity":12}].
                                                // Older rows may hold plain text such as "Tubes", so handle both.
                                                var consumableItems = new List<(string Name, int Qty)>();
                                                var consumablesIsLegacy = false;
                                                var rawConsumables = (test.ConsumablesUsed ?? "").Trim();

                                                if (rawConsumables.StartsWith("["))
                                                {
                                                    JsonDocument consumableDoc = null;
                                                    try
                                                    {
                                                        consumableDoc = JsonDocument.Parse(rawConsumables);
                                                        foreach (var el in consumableDoc.RootElement.EnumerateArray())
                                                        {
                                                            string cName = el.TryGetProperty("name", out var cNameProp) ? cNameProp.GetString() : null;
                                                            int cQty = 0;
                                                            if (el.TryGetProperty("quantity", out var cQtyProp)) { cQtyProp.TryGetInt32(out cQty); }
                                                            if (!string.IsNullOrWhiteSpace(cName)) { consumableItems.Add((cName, cQty)); }
                                                        }
                                                    }
                                                    catch (JsonException) { consumablesIsLegacy = true; }
                                                    catch (InvalidOperationException) { consumablesIsLegacy = true; }
                                                    finally { consumableDoc?.Dispose(); }
                                                }
                                                else if (rawConsumables.Length > 0)
                                                {
                                                    consumablesIsLegacy = true;
                                                }
                                            }
                                            @if (consumableItems.Count > 0)
                                            {
                                                <div style="display:flex;flex-wrap:wrap;gap:4px;">
                                                    @foreach (var ci in consumableItems)
                                                    {
                                                        <span class="sample-badge">@ci.Name × @ci.Qty</span>
                                                    }
                                                </div>
                                            }
                                            else if (consumablesIsLegacy)
                                            {
                                                @rawConsumables
                                            }
                                            else
                                            {
                                                <span class="tech-none">None</span>
                                            }
                                        </td>
                                        <td>
                                            @{
                                                // Build the list of technician names assigned to this test
                                                var techNames = new List<string>();

                                                if (rawTechMap is IDictionary<int, List<string>> techListMap
                                                    && techListMap.TryGetValue(test.TestId, out var techListValue)
                                                    && techListValue != null)
                                                {
                                                    techNames = techListValue;
                                                }
                                                else if (rawTechMap is IDictionary<int, string> techStringMap
                                                    && techStringMap.TryGetValue(test.TestId, out var techStringValue)
                                                    && !string.IsNullOrWhiteSpace(techStringValue)
                                                    && techStringValue != "—")
                                                {
                                                    techNames = techStringValue
                                                        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                                                        .ToList();
                                                }

                                        @if (!string.IsNullOrWhiteSpace(test.ConsumablesUsed))
                                        {
                                            @test.ConsumablesUsed
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">
                                                None
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->

                                    <td>

                                        <div class="actions">


                                            <!-- EDIT -->

                                            <button type="button"
                                                    class="action-btn edit-btn"
                                                    title="Edit"
                                                    onclick="openEditModal(
                                                @test.TestId,
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(test.TestName ?? ""))',
                                                '@test.CategoryId',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(test.SampleTypeId ?? ""))',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(test.UnitMeasurement ?? ""))',
                                                '@(test.NormalRangeMin?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")',
                                                '@(test.NormalRangeMax?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")',
                                                '@test.TurnaroundTime',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(test.ConsumablesUsed ?? ""))'
                                                )">

                                                ✎

                                            </button>
                                                techNames = techNames
                                                    .Where(n => !string.IsNullOrWhiteSpace(n))
                                                    .Distinct(StringComparer.OrdinalIgnoreCase)
                                                    .ToList();
                                            }
                                            @if (techNames.Count > 0)
                                            {
                                                <span class="tech-badge" title="@(string.Join(", ", techNames))">
                                                    @techNames.Count technician@(techNames.Count == 1 ? "" : "s")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="tech-none">None</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="actions">
                                                @if (test.TestId > 0)
                                                {
                                                    <button type="button"
                                                            class="action-icon-btn edit-btn"
                                                            title="Edit"
                                                            data-testid="@test.TestId"
                                                            data-testname="@test.TestName"
                                                            data-categoryid="@test.CategoryId"
                                                            data-sampletypeid="@test.SampleTypeId"
                                                            data-unit="@(System.Net.WebUtility.HtmlDecode(test.UnitMeasurement ?? ""))"
                                                            data-normalmin="@(test.NormalRangeMin?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                            data-normalmax="@(test.NormalRangeMax?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                            data-tat="@test.TurnaroundTime"
                                                            data-consumables="@test.ConsumablesUsed"
                                                            onclick="populateEditModal(this)">
                                                        ✎
                                                    </button>

                                                    <button type="button"
                                                            class="action-icon-btn delete-btn"
                                                            title="Delete"
                                                            data-testid="@test.TestId"
                                                            data-testname="@test.TestName"
                                                            onclick="populateDeleteModal(this)">
                                                        🗑
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="action-icon-btn edit-btn" title="Invalid test id" disabled>✎</button>
