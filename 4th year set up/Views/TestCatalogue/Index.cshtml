    <!-- =====================================================
         DELETE CONFIRMATION MODAL
    ====================================================== -->
    <div id="deleteModal" class="modal-overlay">
        <div class="modal" style="max-width:450px;">
            <form asp-controller="TestCatalogue" asp-action="DeleteTest" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" id="delete-TestId" name="id" />

                <div class="modal-header">
                    <h2 class="modal-title">Delete Test Type</h2>
                    <button type="button" class="close-btn" onclick="closeModal('deleteModal')">×</button>
                </div>

                <div class="modal-body">
                    <div class="delete-content">
                        <div class="delete-icon">!</div>
                        <div class="delete-title">Are you sure?</div>
                        <p class="delete-message">
                            You are about to delete
                            <strong id="delete-TestName">this test</strong>.
                            This test type will be hidden from the active catalogue and can be restored later.
                        </p>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('deleteModal')">Cancel</button>
                    <button type="submit" class="btn btn-danger">🗑 Delete Test</button>
                </div>

            </form>
        </div>
    </div>

    <!-- =====================================================
         NEW: RESTORE DELETED TESTS MODAL
    ====================================================== -->
    <div id="restoreModal" class="modal-overlay">
        <div class="modal" style="max-width:560px;">
            <div class="modal-header">
                <h2 class="modal-title">Restore Deleted Tests</h2>
                <button type="button" class="close-btn" onclick="closeModal('restoreModal')">×</button>
            </div>

            <div class="modal-body">
                @if (deletedTests.Any())
                {
                    <div class="restore-list">
                        @foreach (var d in deletedTests)
                        {
                            <div class="restore-item">
                                <div>
                                    <div class="test-name">@d.TestName</div>
                                    <div class="meta">@d.NormalRangeDisplay · @d.TurnaroundTime hrs</div>
                                </div>
                                <form asp-controller="TestCatalogue" asp-action="RestoreTest" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@d.TestId" />
                                    <button type="submit" class="btn btn-primary" style="padding:7px 12px;">↺ Restore</button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state" style="padding:30px 10px;">
                        <div class="empty-title">Nothing to restore</div>
                        <div>There are no deleted test types.</div>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('restoreModal')">Close</button>
            </div>
        </div>
    </div>

    <!-- ── LOGOUT CONFIRMATION MODAL (matches dashboard) ── -->
    <div id="logout-modal" role="dialog" aria-modal="true" aria-labelledby="logout-modal-title"
         style="display:none;position:fixed;inset:0;z-index:999;background:rgba(11,31,58,0.45);align-items:center;justify-content:center;">
        <div style="background:white;border-radius:20px;padding:32px 28px;max-width:380px;width:90%;box-shadow:0 20px 60px rgba(11,31,58,0.2);animation:modalIn 0.18s ease;">
            <div style="width:52px;height:52px;background:#fee2e2;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
            </div>
            <h3 id="logout-modal-title" style="font-family:'DM Serif Display',serif;font-size:1.2rem;color:var(--navy);margin-bottom:8px;">Sign out?</h3>
            <p style="font-size:0.85rem;color:var(--muted);margin-bottom:24px;line-height:1.6;">You'll be returned to the login screen. Any unsaved changes will be lost.</p>
            <div style="display:flex;gap:10px;">
                <button id="logout-cancel" style="flex:1;padding:10px;border:1px solid var(--border);border-radius:10px;background:white;color:var(--navy);font-size:0.85rem;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;">Cancel</button>
                <a id="logout-confirm" href="#" style="flex:1;padding:10px;border:none;border-radius:10px;background:#dc2626;color:white;font-size:0.85rem;font-weight:600;cursor:pointer;text-align:center;text-decoration:none;font-family:'DM Sans',sans-serif;">Sign Out</a>
            </div>
        </div>
    </div>

    <script>

            function openAddModal() {
                document.getElementById("addModal").classList.add("show");
                document.body.style.overflow = "hidden";
            }

            function openAddCategoryModal() {
                document.getElementById("addCategoryModal").classList.add("show");
                document.body.style.overflow = "hidden";
            }

            // NEW: generic opener (used by Add Sample Type and Restore)
            function openModal(modalId) {
                document.getElementById(modalId).classList.add("show");
                document.body.style.overflow = "hidden";
            }

            function openEditModal(id, testName, categoryId, sampleType, unit, normalMin, normalMax, tat, consumables) {
                document.getElementById("edit-TestId").value = id;
                document.getElementById("edit-TestName").value = testName;
                document.getElementById("edit-CategoryId").value = categoryId;
                document.getElementById("edit-SampleTypeId").value = sampleType;
                document.getElementById("edit-UnitMeasurement").value = unit;
                document.getElementById("edit-NormalRangeMin").value = normalMin;
                document.getElementById("edit-NormalRangeMax").value = normalMax;
                document.getElementById("edit-TurnaroundTime").value = tat;
                document.getElementById("edit-ConsumablesUsed").value = consumables;

                document.getElementById("editModal").classList.add("show");
                document.body.style.overflow = "hidden";
            }

            function openDeleteModal(id, testName) {
                document.getElementById("delete-TestId").value = id;
                document.getElementById("delete-TestName").textContent = testName;

                document.getElementById("deleteModal").classList.add("show");
                document.body.style.overflow = "hidden";
            }

            // NEW: clear validation messages inside a modal
            function clearErrors(modal) {
                modal.querySelectorAll(".is-invalid").forEach(function (i) { i.classList.remove("is-invalid"); });
                modal.querySelectorAll(".field-error").forEach(function (s) { s.classList.remove("show"); s.textContent = ""; });
            }

            function closeModal(modalId) {
                var modal = document.getElementById(modalId);
                modal.classList.remove("show");
                clearErrors(modal);
                document.body.style.overflow = "";
            }

            // Populate the edit modal from the button's data-* attributes
            // Always open the modal even if TestId is missing or invalid — the form will handle submission validation.
            function populateEditModal(button) {
                if (!button) return;

                var dataset = button.dataset || {};
                var id = dataset.testid || button.getAttribute('data-testid') || "";
                var testName = dataset.testname || "";
                var categoryId = dataset.categoryid || "";
                var sampleType = dataset.sampletypeid || "";
                var unit = dataset.unit || "";
                var normalMin = dataset.normalmin || "";
                var normalMax = dataset.normalmax || "";
                var tat = dataset.tat || "";
                var consumables = dataset.consumables || "";

                openEditModal(id, testName, categoryId, sampleType, unit, normalMin, normalMax, tat, consumables);
            }

            document.querySelectorAll(".modal-overlay").forEach(function (modal) {
                modal.addEventListener("click", function (event) {
                    if (event.target === modal) {
                        modal.classList.remove("show");
                        clearErrors(modal);
                        document.body.style.overflow = "";
                    }
                });
            });

            // showInvalidIdWarning removed per request

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    document.querySelectorAll(".modal-overlay.show").forEach(function (modal) {
                        modal.classList.remove("show");
                        clearErrors(modal);
                    });
                    document.body.style.overflow = "";
                }
            });

            setTimeout(function () {
                document.querySelectorAll(".alert").forEach(function (alert) {
                    alert.style.transition = "opacity .4s ease";
                    alert.style.opacity = "0";
                    setTimeout(function () { alert.remove(); }, 400);
                });
            }, 5000);

            // NEW: form validation (forms marked with data-validate)
            (function () {
                function setError(input, msg) {
                    var err = input.parentElement.querySelector(".field-error");
                    input.classList.toggle("is-invalid", !!msg);
                    if (err) {
                        err.textContent = msg || "";
                        err.classList.toggle("show", !!msg);
                    }
                    return !msg;
                }

                function validateField(input, form) {
                    var d = input.dataset;
                    var v = (input.value || "").trim();

                    if (d.required !== undefined && v === "") return setError(input, d.required);
                    if (v === "") return setError(input, "");   // optional + empty = OK

                    if (d.minlength && v.length < +d.minlength)
                        return setError(input, "Must be at least " + d.minlength + " characters.");
                    if (d.maxlength && v.length > +d.maxlength)
                        return setError(input, "Must be at most " + d.maxlength + " characters.");
                    if (d.pattern && !new RegExp(d.pattern).test(v))
                        return setError(input, d.patternMsg || "Invalid format.");

                    if (input.type === "number") {
                        var n = parseFloat(v);
                        if (isNaN(n)) return setError(input, "Enter a valid number.");
                        if (d.integer !== undefined && !Number.isInteger(n)) return setError(input, d.integer);
                        if ((d.min !== undefined && n < +d.min) || (d.max !== undefined && n > +d.max))
                            return setError(input, d.rangeMsg || "Value out of range.");

                        if (d.lte) {
                            var other = form.querySelector('[name="' + d.lte + '"]');
                            if (other && other.value !== "" && n > parseFloat(other.value))
                                return setError(input, "Minimum cannot exceed maximum.");
                        }
                        if (d.gte) {
                            var other2 = form.querySelector('[name="' + d.gte + '"]');
                            if (other2 && other2.value !== "" && n < parseFloat(other2.value))
                                return setError(input, "Maximum cannot be less than minimum.");
                        }
                    }
                    return setError(input, "");
                }

                document.querySelectorAll("form[data-validate]").forEach(function (form) {
                    var fields = form.querySelectorAll("input[name], select[name], textarea[name]");

                    fields.forEach(function (f) {
                        if (f.type === "hidden") return;

                        f.addEventListener("blur", function () { validateField(f, form); });
                        f.addEventListener("change", function () { validateField(f, form); });
                        f.addEventListener("input", function () {
                            if (f.classList.contains("is-invalid")) validateField(f, form);
                            // keep the paired min/max fields in sync
                            var pair = f.dataset.lte || f.dataset.gte;
                            if (pair) {
                                var p = form.querySelector('[name="' + pair + '"]');
                                if (p && p.classList.contains("is-invalid")) validateField(p, form);
                            }
                        });
                    });

                    form.addEventListener("submit", function (e) {
                        var ok = true, first = null;
                        fields.forEach(function (f) {
                            if (f.type === "hidden") return;
                            if (!validateField(f, form)) { ok = false; first = first || f; }
                        });
                        if (!ok) {
                            e.preventDefault();
                            first.focus();
                        }
                    });
                });
            })();

            (function () {
                /* ── LOGOUT MODAL ── */
                var logoutBtn     = document.getElementById('logout-btn');
                var logoutModal   = document.getElementById('logout-modal');
                var logoutCancel  = document.getElementById('logout-cancel');
                var logoutConfirm = document.getElementById('logout-confirm');

                if (logoutBtn && logoutModal) {
                    logoutConfirm.href = logoutBtn.href;

                    logoutBtn.addEventListener('click', function (e) {
                        e.preventDefault();
                        logoutModal.style.display = 'flex';
                        logoutCancel.focus();
                    });

                    function closeLogoutModal() {
                        logoutModal.style.display = 'none';
                        logoutBtn.focus();
                    }

                    logoutCancel.addEventListener('click', closeLogoutModal);
                    logoutModal.addEventListener('click', function (e) {
                        if (e.target === logoutModal) closeLogoutModal();
                    });
                    document.addEventListener('keydown', function (e) {
                        if (e.key === 'Escape' && logoutModal.style.display === 'flex') closeLogoutModal();
                    });
                }
            })();

    </script>

</body>
</html>
