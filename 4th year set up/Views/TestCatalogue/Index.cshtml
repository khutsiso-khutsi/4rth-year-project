@using LabManager.Models
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<TestType>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    ViewData["Title"] = "Test Catalogue";

    var categories = ViewBag.Categories as IEnumerable<TestCategory>
                     ?? Enumerable.Empty<TestCategory>();

    // raw sample types list (optional). Controller may set ViewBag.SampleTypes for this.
    var sampleTypes = ViewBag.SampleTypes as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();

    // soft-deleted test types (controller sets ViewBag.DeletedTests)
    var deletedTests = ViewBag.DeletedTests as IEnumerable<TestType> ?? Enumerable.Empty<TestType>();

    <meta charset="UTF-8" />
    // Technician map: TestId -> list of technician names.
    // (Also tolerates the old shape: TestId -> single string.)
    var rawTechMap = ViewBag.TechnicianMap as object;

    // Consumables available for the dropdown (controller sets ViewBag.Consumables as a list of SelectListItem)
    var consumableOptions = ViewBag.Consumables as IEnumerable<SelectListItem>
                            ?? Enumerable.Empty<SelectListItem>();
}

