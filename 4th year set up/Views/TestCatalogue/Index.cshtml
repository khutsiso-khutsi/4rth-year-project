```cshtml
@using LabManager.Models
@model IEnumerable<TestType>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    ViewData["Title"] = "Test Catalogue";

    var categories = ViewBag.Categories as IEnumerable<TestCategory>
                     ?? Enumerable.Empty<TestCategory>();
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Test Catalogue — NMB-HLabSys</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap"
          rel="stylesheet" />

    <style>

            /* =========================================================
                               ROOT
                            ========================================================= */

            :root {
                --navy: #0b1f3a;
                --navy-dark: #071629;
                --navy-light: #16365f;
                --teal: #0f766e;
                --teal-dark: #0b625c;
                --teal-light: #14b8a6;
                --teal-soft: #e8f7f5;
                --white: #ffffff;
                --bg: #f4f7fb;
                --border: #e2e8f0;
                --border-dark: #cbd5e1;
                --text: #172033;
                --text-dark: #0f172a;
                --muted: #64748b;
                --danger: #dc2626;
                --danger-dark: #b91c1c;
                --danger-soft: #fee2e2;
                --success: #15803d;
                --success-soft: #dcfce7;
                --warning: #d97706;
                --warning-soft: #fef3c7;
                --blue-soft: #e0f2fe;
                --blue: #0369a1;
                --shadow-sm: 0 2px 8px rgba(11, 31, 58, .05);
                --shadow: 0 8px 28px rgba(11, 31, 58, .07);
                --shadow-lg: 0 20px 60px rgba(7, 22, 41, .20);
                --radius-sm: 8px;
                --radius: 12px;
                --radius-lg: 16px;
            }


            /* =========================================================
                               RESET
                            ========================================================= */

            * {
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                margin: 0;
                font-family: "DM Sans", sans-serif;
                background: var(--bg);
                color: var(--text);
                line-height: 1.5;
            }

            button,
            input,
            select,
            textarea {
                font-family: inherit;
            }


            /* =========================================================
                               TOPBAR
                            ========================================================= */

            .topbar {
                height: 70px;
                background: linear-gradient(135deg, var(--navy-dark), var(--navy));
                color: var(--white);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 1000;
                box-shadow: 0 2px 12px rgba(0, 0, 0, .12);
            }


            /* =========================================================
                               BRAND
                            ========================================================= */

            .brand {
                display: flex;
                align-items: center;
                gap: 13px;
            }

            .brand-icon {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                background: linear-gradient(135deg, var(--teal), var(--teal-light));
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 19px;
                box-shadow: 0 5px 14px rgba(20, 184, 166, .20);
            }

            .brand-text {
                display: flex;
                flex-direction: column;
            }

            .brand-name {
                font-family: "DM Serif Display", serif;
                font-size: 21px;
                line-height: 1;
                letter-spacing: .1px;
            }

            .brand-subtitle {
                font-size: 10px;
                opacity: .65;
                margin-top: 5px;
                letter-spacing: .2px;
            }


            /* =========================================================
                               TOPBAR USER
                            ========================================================= */

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .user-info {
                text-align: right;
            }

            .user-name {
                font-size: 13px;
                font-weight: 700;
            }

            .user-role {
                font-size: 10px;
                opacity: .62;
                margin-top: 2px;
            }

            .avatar {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--teal), var(--teal-light));
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
                font-weight: 800;
                border: 2px solid rgba(255, 255, 255, .15);
            }


            /* =========================================================
                               SIDEBAR
                            ========================================================= */

            .sidebar {
                position: fixed;
                top: 70px;
                bottom: 0;
                left: 0;
                width: 245px;
                background: var(--white);
                border-right: 1px solid var(--border);
                padding: 26px 14px;
                z-index: 900;
                box-shadow: 2px 0 12px rgba(11, 31, 58, .025);
                overflow-y: auto;
            }

            .nav-section-title {
                font-size: 10px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 1.2px;
                color: #94a3b8;
                padding: 0 13px 11px;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 13px;
                border-radius: 9px;
                margin-bottom: 5px;
                color: #475569;
                text-decoration: none;
                font-size: 13px;
                font-weight: 600;
                transition: background .2s ease, color .2s ease, transform .2s ease;
            }

                .nav-item:hover {
                    background: #f0fdfa;
                    color: var(--teal);
                    transform: translateX(2px);
                }

                .nav-item.active {
                    background: var(--teal-soft);
                    color: var(--teal);
                    font-weight: 800;
                    box-shadow: inset 3px 0 0 var(--teal);
                }

            .nav-icon {
                width: 21px;
                text-align: center;
                font-size: 16px;
                flex-shrink: 0;
            }


            /* =========================================================
                               MAIN
                            ========================================================= */

            .main {
                margin-left: 245px;
                padding: 104px 32px 40px;
                min-height: 100vh;
            }


            /* =========================================================
                               PAGE HEADER
                            ========================================================= */

            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 25px;
                margin-bottom: 25px;
            }

            .page-title {
                margin: 0;
                font-family: "DM Serif Display", serif;
                font-size: 34px;
                font-weight: 400;
                line-height: 1.15;
                color: var(--navy);
                letter-spacing: -.4px;
            }

            .page-description {
                margin: 7px 0 0;
                font-size: 13px;
                color: var(--muted);
                max-width: 650px;
            }

            .header-actions {
                display: flex;
                gap: 9px;
                flex-wrap: wrap;
            }


            /* =========================================================
                               BUTTONS
                            ========================================================= */

            .btn {
                border: none;
                border-radius: 8px;
                padding: 10px 16px;
                font-family: inherit;
                font-size: 12px;
                font-weight: 800;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                text-decoration: none;
                transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
            }

                .btn:hover {
                    transform: translateY(-1px);
                }

                .btn:active {
                    transform: translateY(0);
                }

            .btn-primary {
                background: var(--teal);
                color: var(--white);
                box-shadow: 0 4px 12px rgba(15, 118, 110, .18);
            }

                .btn-primary:hover {
                    background: var(--teal-dark);
                    box-shadow: 0 6px 16px rgba(15, 118, 110, .23);
                }

            .btn-secondary {
                background: #eef2f6;
                color: #374151;
            }

                .btn-secondary:hover {
                    background: #e2e8f0;
                }

            .btn-danger {
                background: var(--danger);
                color: var(--white);
                box-shadow: 0 4px 12px rgba(220, 38, 38, .14);
            }

                .btn-danger:hover {
                    background: var(--danger-dark);
                }


            /* =========================================================
                               ALERTS
                            ========================================================= */

            .alert {
                padding: 13px 16px;
                border-radius: 9px;
                margin-bottom: 20px;
                font-size: 12px;
                font-weight: 700;
                display: flex;
                align-items: center;
                box-shadow: var(--shadow-sm);
            }

            .alert-success {
                background: var(--success-soft);
                color: var(--success);
                border: 1px solid #bbf7d0;
            }

            .alert-error {
                background: var(--danger-soft);
                color: var(--danger);
                border: 1px solid #fecaca;
            }


            /* =========================================================
                               CARD
                            ========================================================= */

            .card {
                background: var(--white);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                box-shadow: var(--shadow);
                overflow: hidden;
            }

            .card-header {
                min-height: 66px;
                padding: 17px 22px;
                border-bottom: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
                background: #ffffff;
            }

            .card-title {
                font-size: 14px;
                font-weight: 800;
                color: var(--navy);
            }

            .record-count {
                font-size: 11px;
                font-weight: 600;
                color: var(--muted);
                background: #f8fafc;
                border: 1px solid var(--border);
                padding: 5px 9px;
                border-radius: 20px;
            }


            /* =========================================================
                               TABLE
                            ========================================================= */

            .table-container {
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 950px;
            }

            th {
                background: #f8fafc;
                color: #64748b;
                font-size: 10px;
                text-transform: uppercase;
                letter-spacing: .65px;
                font-weight: 800;
                padding: 13px 15px;
                text-align: left;
                border-bottom: 1px solid var(--border);
                white-space: nowrap;
            }

            td {
                padding: 15px;
                border-bottom: 1px solid #edf0f3;
                font-size: 12px;
                vertical-align: middle;
                color: #475569;
            }

            tbody tr:last-child td {
                border-bottom: none;
            }

            tbody tr {
                transition: background .18s ease;
            }

                tbody tr:hover {
                    background: #fbfefd;
                }

            tr:hover td {
                background: transparent;
            }


            /* =========================================================
                               TABLE CONTENT
                            ========================================================= */

            .test-name {
                font-weight: 800;
                color: var(--navy);
                font-size: 13px;
            }

            .category-badge {
                display: inline-block;
                padding: 5px 9px;
                border-radius: 20px;
                background: var(--teal-soft);
                color: var(--teal);
                font-size: 10px;
                font-weight: 800;
                white-space: nowrap;
            }

            .sample-badge {
                display: inline-block;
                padding: 5px 9px;
                border-radius: 20px;
                background: #f1f5f9;
                color: #475569;
                font-size: 10px;
                font-weight: 700;
                white-space: nowrap;
            }

            .range {
                font-weight: 700;
                color: #334155;
                white-space: nowrap;
            }

            .tat {
                font-weight: 800;
                color: var(--navy);
                white-space: nowrap;
            }


            /* =========================================================
                               ACTION BUTTONS
                            ========================================================= */

            .actions {
                display: flex;
                gap: 7px;
            }

            .action-btn {
                border: none;
                width: 34px;
                height: 34px;
                border-radius: 7px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                transition: transform .18s ease, background .18s ease, box-shadow .18s ease;
            }

                .action-btn:hover {
                    transform: translateY(-1px);
                }

            .edit-btn {
                background: var(--blue-soft);
                color: var(--blue);
            }

                .edit-btn:hover {
                    background: #bae6fd;
                    box-shadow: 0 3px 8px rgba(3, 105, 161, .12);
                }

            .delete-btn {
                background: var(--danger-soft);
                color: var(--danger);
            }

                .delete-btn:hover {
                    background: #fecaca;
                    box-shadow: 0 3px 8px rgba(220, 38, 38, .12);
                }


            /* =========================================================
                               EMPTY STATE
                            ========================================================= */

            .empty-state {
                text-align: center;
                padding: 65px 20px;
                color: var(--muted);
            }

            .empty-icon {
                width: 70px;
                height: 70px;
                margin: 0 auto 17px;
                border-radius: 50%;
                background: var(--teal-soft);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 32px;
            }

            .empty-title {
                font-size: 15px;
                font-weight: 800;
                color: var(--navy);
                margin-bottom: 5px;
            }

            .empty-state > div:not(.empty-icon):not(.empty-title) {
                font-size: 12px;
            }


            /* =========================================================
                               MODAL OVERLAY
                            ========================================================= */

            .modal-overlay {
                position: fixed;
                inset: 0;
                background: rgba(7, 22, 41, .68);
                backdrop-filter: blur(3px);
                display: none;
                align-items: center;
                justify-content: center;
                padding: 20px;
                z-index: 2000;
            }

                .modal-overlay.show {
                    display: flex;
                }


            /* =========================================================
                               MODAL
                            ========================================================= */

            .modal {
                width: 100%;
                max-width: 650px;
                max-height: 90vh;
                overflow-y: auto;
                background: var(--white);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-lg);
                animation: modalIn .22s ease;
                border: 1px solid rgba(255,255,255,.7);
            }

            @@keyframes modalIn {

                from {
                    opacity: 0;
                    transform: translateY(15px) scale(.98);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }


            /* =========================================================
                               MODAL HEADER
                            ========================================================= */

            .modal-header {
                padding: 19px 22px;
                border-bottom: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
                background: #ffffff;
            }

            .modal-title {
                font-family: "DM Serif Display", serif;
                font-size: 22px;
                font-weight: 400;
                color: var(--navy);
                margin: 0;
            }

            .close-btn {
                width: 32px;
                height: 32px;
                border: none;
                border-radius: 7px;
                background: #f1f5f9;
                color: #475569;
                cursor: pointer;
                font-size: 18px;
                transition: background .18s ease, transform .18s ease;
            }

                .close-btn:hover {
                    background: #e2e8f0;
                    transform: rotate(3deg);
                }


            /* =========================================================
                               MODAL BODY
                            ========================================================= */

            .modal-body {
                padding: 23px;
            }

            .modal-footer {
                padding: 16px 22px;
                border-top: 1px solid var(--border);
                display: flex;
                justify-content: flex-end;
                gap: 10px;
                background: #fbfcfe;
            }


            /* =========================================================
                               FORM
                            ========================================================= */

            .form-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 17px;
            }

            .form-group {
                display: flex;
                flex-direction: column;
                gap: 7px;
            }

                .form-group.full {
                    grid-column: 1 / -1;
                }

            .form-label {
                font-size: 11px;
                font-weight: 800;
                color: #374151;
            }

            .required {
                color: var(--danger);
                margin-left: 2px;
            }

            .form-control {
                width: 100%;
                border: 1px solid #cfd7e2;
                border-radius: 8px;
                padding: 10px 12px;
                font-family: inherit;
                font-size: 12px;
                color: var(--text);
                outline: none;
                background: var(--white);
                transition: border-color .18s ease, box-shadow .18s ease;
            }

                .form-control:hover {
                    border-color: #b9c5d3;
                }

                .form-control:focus {
                    border-color: var(--teal);
                    box-shadow: 0 0 0 3px rgba(15,118,110,.10);
                }

            textarea.form-control {
                min-height: 82px;
                resize: vertical;
                line-height: 1.5;
            }

            select.form-control {
                cursor: pointer;
            }

            .form-help {
                font-size: 10px;
                color: var(--muted);
                margin-top: -2px;
            }


            /* =========================================================
                               DELETE MODAL
                            ========================================================= */

            .delete-content {
                text-align: center;
                padding: 10px 10px 5px;
            }

            .delete-icon {
                width: 55px;
                height: 55px;
                margin: 0 auto 15px;
                border-radius: 50%;
                background: var(--danger-soft);
                color: var(--danger);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 25px;
                font-weight: 800;
            }

            .delete-title {
                font-size: 18px;
                font-weight: 800;
                color: var(--navy);
            }

            .delete-message {
                margin: 8px 0 0;
                color: var(--muted);
                font-size: 12px;
                line-height: 1.6;
            }

                .delete-message strong {
                    color: var(--text);
                }


            /* =========================================================
                               FOOTER
                            ========================================================= */

            .footer {
                margin-top: 28px;
                padding: 0 2px;
                display: flex;
                justify-content: space-between;
                color: #94a3b8;
                font-size: 10px;
            }


            /* =========================================================
                               SCROLLBAR
                            ========================================================= */

            .modal::-webkit-scrollbar,
            .sidebar::-webkit-scrollbar,
            .table-container::-webkit-scrollbar {
                width: 7px;
                height: 7px;
            }

            .modal::-webkit-scrollbar-track,
            .sidebar::-webkit-scrollbar-track,
            .table-container::-webkit-scrollbar-track {
                background: #f1f5f9;
            }

            .modal::-webkit-scrollbar-thumb,
            .sidebar::-webkit-scrollbar-thumb,
            .table-container::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 20px;
            }


            /* =========================================================
                               RESPONSIVE — TABLET
                            ========================================================= */

            @@media (max-width: 850px) {

                .sidebar {
                    width: 70px;
                    padding: 20px 8px;
                }

                .nav-section-title,
                .nav-text {
                    display: none;
                }

                .nav-item {
                    justify-content: center;
                    padding: 12px 8px;
                }

                    .nav-item.active {
                        box-shadow: none;
                    }

                .main {
                    margin-left: 70px;
                    padding-left: 22px;
                    padding-right: 22px;
                }

                .user-info {
                    display: none;
                }

                .page-title {
                    font-size: 30px;
                }
            }


            /* =========================================================
                               RESPONSIVE — MOBILE
                            ========================================================= */

            @@media (max-width: 650px) {

                .topbar {
                    padding: 0 16px;
                }

                .brand-subtitle {
                    display: none;
                }

                .brand-name {
                    font-size: 18px;
                }

                .brand-icon {
                    width: 36px;
                    height: 36px;
                }

                .sidebar {
                    width: 60px;
                }

                .main {
                    margin-left: 60px;
                    padding: 92px 15px 30px;
                }

                .page-header {
                    flex-direction: column;
                    gap: 16px;
                }

                .page-title {
                    font-size: 28px;
                }

                .page-description {
                    font-size: 12px;
                }

                .header-actions {
                    width: 100%;
                }

                    .header-actions .btn {
                        flex: 1;
                    }

                .form-grid {
                    grid-template-columns: 1fr;
                }

                .form-group.full {
                    grid-column: auto;
                }

                .modal-overlay {
                    padding: 12px;
                }

                .modal {
                    max-height: 94vh;
                }

                .modal-body {
                    padding: 18px;
                }

                .modal-header {
                    padding: 17px 18px;
                }

                .modal-footer {
                    padding: 14px 18px;
                }

                    .modal-footer .btn {
                        flex: 1;
                    }

                .footer {
                    flex-direction: column;
                    gap: 6px;
                    line-height: 1.5;
                }
            }


            /* =========================================================
                               VERY SMALL SCREENS
                            ========================================================= */

            @@media (max-width: 420px) {

                .topbar {
                    height: 64px;
                }

                .sidebar {
                    top: 64px;
                }

                .main {
                    padding-top: 84px;
                }

                .brand-name {
                    font-size: 17px;
                }

                .avatar {
                    width: 36px;
                    height: 36px;
                }

                .page-title {
                    font-size: 25px;
                }

                .header-actions {
                    flex-direction: column;
                }

                    .header-actions .btn {
                        width: 100%;
                    }

                .card-header {
                    padding: 15px 17px;
                }

                .record-count {
                    font-size: 10px;
                }
            }

    </style>

</head>

<body>

    <!-- =========================
         TOPBAR
    ========================= -->

    <header class="topbar">

        <div class="brand">

            <div class="brand-icon">
                🧪
            </div>

            <div class="brand-text">

                <div class="brand-name">
                    NMB-HLabSys
                </div>

                <div class="brand-subtitle">
                    Haematology Laboratory System
                </div>

            </div>

        </div>


        <div class="topbar-right">

            <div class="user-info">

                <div class="user-name">
                    @(ViewBag.Email ?? "Laboratory Manager")
                </div>

                <div class="user-role">
                    Laboratory Management
                </div>

            </div>

            <div class="avatar">
                LM
            </div>

        </div>

    </header>


    <!-- =========================
         SIDEBAR
    ========================= -->

    <aside class="sidebar">

        <div class="nav-section-title">
            Management
        </div>


        <a asp-controller="ManagerDashboard"
           asp-action="Index"
           class="nav-item">

            <span class="nav-icon">▦</span>

            <span class="nav-text">
                Dashboard
            </span>

        </a>


        <a asp-controller="TestCatalogue"
           asp-action="Index"
           class="nav-item active">

            <span class="nav-icon">🧪</span>

            <span class="nav-text">
                Test Catalogue
            </span>

        </a>


        <a asp-controller="Consumable"
           asp-action="Index"
           class="nav-item">

            <span class="nav-icon">📦</span>

            <span class="nav-text">
                Consumables
            </span>

        </a>


        <a asp-controller="Doctor"
           asp-action="Index"
           class="nav-item">

            <span class="nav-icon">👨‍⚕️</span>

            <span class="nav-text">
                Doctors
            </span>

        </a>


        <a asp-controller="Technician"
           asp-action="Index"
           class="nav-item">

            <span class="nav-icon">👤</span>

            <span class="nav-text">
                Technicians
            </span>

        </a>


        <a asp-controller="Report"
           asp-action="Index"
           class="nav-item">

            <span class="nav-icon">📊</span>

            <span class="nav-text">
                Reports
            </span>

        </a>

    </aside>


    <!-- =========================
         MAIN CONTENT
    ========================= -->

    <main class="main">


        <!-- PAGE HEADER -->

        <div class="page-header">

            <div>

                <h1 class="page-title">
                    Test Catalogue
                </h1>

                <p class="page-description">
                    Manage laboratory test types, reference ranges,
                    sample types and turnaround times.
                </p>

            </div>


            <div class="header-actions">

                <button type="button"
                        class="btn btn-secondary"
                        onclick="openAddCategoryModal()">

                    <span>＋</span>

                    Add Category

                </button>


                <button type="button"
                        class="btn btn-primary"
                        onclick="openAddModal()">

                    <span>＋</span>

                    Add Test Type

                </button>

            </div>

        </div>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                ✓ @TempData["Success"]
            </div>
        }


        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">
                ⚠ @TempData["Error"]
            </div>
        }


        <!-- =========================
             TEST TABLE
        ========================= -->

        <div class="card">

            <div class="card-header">

                <div class="card-title">
                    Laboratory Test Types
                </div>

                <div class="record-count">

                    @(Model?.Count() ?? 0) test type(s)

                </div>

            </div>


            @if (Model != null && Model.Any())
            {

                <div class="table-container">

                    <table>

                        <thead>

                            <tr>

                                <th>Test</th>
                                <th>Category</th>
                                <th>Sample Type</th>
                                <th>Unit</th>
                                <th>Normal Range</th>
                                <th>TAT</th>
                                <th>Consumables</th>
                                <th>Actions</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var test in Model)
                            {

                                <tr>


                                    <!-- TEST -->

                                    <td>

                                        <div class="test-name">
                                            @test.TestName
                                        </div>

                                    </td>


                                    <!-- CATEGORY -->

                                    <td>

                                        <span class="category-badge">

                                            @(test.CategoryName ?? "Uncategorised")

                                        </span>

                                    </td>


                                    <!-- SAMPLE TYPE -->

                                    <td>

                                        <span class="sample-badge">

                                            @test.SampleTypeId

                                        </span>

                                    </td>


                                    <!-- UNIT -->

                                    <td>

                                        @(test.UnitMeasurement ?? "—")

                                    </td>


                                    <!-- NORMAL RANGE -->

                                    <td>

                                        <span class="range">

                                            @test.NormalRangeDisplay

                                        </span>

                                    </td>


                                    <!-- TAT -->

                                    <td>

                                        <span class="tat">

                                            @test.TurnaroundTime hrs

                                        </span>

                                    </td>


                                    <!-- CONSUMABLES -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(test.ConsumablesUsed))
                                        {
                                            @test.ConsumablesUsed
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">
                                                None
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->

                                    <td>

                                        <div class="actions">


                                            <!-- EDIT -->

                                            <button type="button"
                                                    class="action-btn edit-btn"
                                                    title="Edit"
                                                    onclick="openEditModal(
                                                @test.TestId,
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(test.TestName ?? ""))',
                                                '@test.CategoryId',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(test.SampleTypeId ?? ""))',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(test.UnitMeasurement ?? ""))',
                                                '@(test.NormalRangeMin?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")',
                                                '@(test.NormalRangeMax?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")',
                                                '@test.TurnaroundTime',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(test.ConsumablesUsed ?? ""))'
                                                )">

                                                ✎

                                            </button>


                                            <!-- DELETE -->

                                            <button type="button"
                                                    class="action-btn delete-btn"
                                                    title="Delete"
                                                    onclick="openDeleteModal(
                                                @test.TestId,
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(test.TestName ?? ""))'
                                                )">

                                                🗑

                                            </button>

                                        </div>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="empty-state">

                    <div class="empty-icon">
                        🧪
                    </div>

                    <div class="empty-title">
                        No test types found
                    </div>

                    <div>
                        Add your first laboratory test type to the catalogue.
                    </div>

                    <br />

                    <button type="button"
                            class="btn btn-primary"
                            onclick="openAddModal()">

                        ＋ Add Test Type

                    </button>

                </div>

            }

        </div>


        <!-- =========================
             FOOTER
        ========================= -->

        <div class="footer">

            <span>
                NMB-HLabSys · Haematology Laboratory System
            </span>

            <span>
                Internal management system · @DateTime.Now.ToString("yyyy")
            </span>

        </div>

    </main>


    <!-- =====================================================
         ADD TEST TYPE MODAL
    ====================================================== -->

    <div id="addModal"
         class="modal-overlay">

        <div class="modal">

            <form asp-controller="TestCatalogue"
                  asp-action="AddTestType"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="modal-header">

                    <h2 class="modal-title">
                        Add Test Type
                    </h2>

                    <button type="button"
                            class="close-btn"
                            onclick="closeModal('addModal')">

                        ×

                    </button>

                </div>


                <div class="modal-body">

                    <div class="form-grid">


                        <!-- TEST NAME -->

                        <div class="form-group full">

                            <label class="form-label">

                                Test Name

                                <span class="required">*</span>

                            </label>

                            <input type="text"
                                   name="TestName"
                                   class="form-control"
                                   placeholder="e.g. Full Blood Count"
                                   required />

                        </div>


                        <!-- CATEGORY -->

                        <div class="form-group">

                            <label class="form-label">

                                Category

                                <span class="required">*</span>

                            </label>

                            <select id="add-CategoryId"
                                    name="CategoryId"
                                    class="form-control"
                                    required>

                                <option value="">
                                    Select category
                                </option>

                                @if (ViewBag.Category != null)
                                {
                                    @foreach (var sampleType in ViewBag.Category)
                                    {
                                        <option value="@sampleType.Value">
                                            @sampleType.Text
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- SAMPLE TYPE -->

                        <div class="form-group">

                            <label class="form-label">

                                Sample Type

                                <span class="required">*</span>

                            </label>

                            <select id="add-SampleTypeId"
                                    name="SampleTypeId"
                                    class="form-control"
                                    required>

                                <option value="">
                                    Select sample type
                                </option>

                                @if (ViewBag.SampleType != null)
                                {
                                    @foreach (var sampleType in ViewBag.SampleType)
                                    {
                                        <option value="@sampleType.Value">
                                            @sampleType.Text
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- UNIT -->

                        <div class="form-group">

                            <label class="form-label">
                                Unit Measurement
                            </label>

                            <select id="add-UnitMeasurement"
                                    name="UnitMeasurement"
                                    class="form-control">

                                <option value="">
                                    Select unit
                                </option>

                                <option value="µL">
                                    µL
                                </option>

                                <option value="mcL">
                                    mcL
                                </option>

                                <option value="g/dL">
                                    g/dL
                                </option>

                                <option value="g/L">
                                    g/L
                                </option>

                                <option value="g/mL">
                                    g/mL
                                </option>

                                <option value="k/µL">
                                    k/µL
                                </option>

                                <option value="x10³/µL">
                                    x10³/µL
                                </option>

                            </select>

                        </div>


                        <!-- TAT -->

                        <div class="form-group">

                            <label class="form-label">
                                Turnaround Time
                            </label>

                            <input type="number"
                                   name="TurnaroundTime"
                                   class="form-control"
                                   placeholder="e.g. 24"
                                   min="0" />

                            <span class="form-help">
                                Enter TAT in hours.
                            </span>

                        </div>


                        <!-- NORMAL MIN -->

                        <div class="form-group">

                            <label class="form-label">
                                Normal Range Minimum
                            </label>

                            <input type="number"
                                   name="NormalRangeMin"
                                   class="form-control"
                                   step="0.01"
                                   placeholder="e.g. 12.00" />

                        </div>


                        <!-- NORMAL MAX -->

                        <div class="form-group">

                            <label class="form-label">
                                Normal Range Maximum
                            </label>

                            <input type="number"
                                   name="NormalRangeMax"
                                   class="form-control"
                                   step="0.01"
                                   placeholder="e.g. 16.00" />

                        </div>


                        <!-- CONSUMABLES -->

                        <div class="form-group full">

                            <label class="form-label">
                                Consumables Used
                            </label>

                            <textarea name="ConsumablesUsed"
                                      class="form-control"
                                      placeholder="e.g. EDTA Tube, Reagent A"></textarea>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="closeModal('addModal')">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        ✓ Save Test Type

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- =====================================================
         ADD CATEGORY MODAL
    ====================================================== -->

    <div id="addCategoryModal"
         class="modal-overlay">

        <div class="modal"
             style="max-width:480px;">

            <form asp-controller="TestCatalogue"
                  asp-action="AddCategory"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="modal-header">

                    <h2 class="modal-title">
                        Add Category
                    </h2>

                    <button type="button"
                            class="close-btn"
                            onclick="closeModal('addCategoryModal')">

                        ×

                    </button>

                </div>


                <div class="modal-body">

                    <div class="form-grid">


                        <!-- CATEGORY NAME -->

                        <div class="form-group full">

                            <label class="form-label">

                                Category Name

                                <span class="required">*</span>

                            </label>

                            <input type="text"
                                   name="CategoryName"
                                   class="form-control"
                                   placeholder="e.g. Haematology"
                                   required />

                        </div>


                        <!-- DESCRIPTION -->

                        <div class="form-group full">

                            <label class="form-label">
                                Description
                            </label>

                            <textarea name="Description"
                                      class="form-control"
                                      placeholder="Optional short description"></textarea>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="closeModal('addCategoryModal')">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        ✓ Save Category

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- =====================================================
         EDIT TEST TYPE MODAL
    ====================================================== -->

    <div id="editModal"
         class="modal-overlay">

        <div class="modal">

            <form asp-controller="TestCatalogue"
                  asp-action="EditTestType"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="modal-header">

                    <h2 class="modal-title">
                        Edit Test Type
                    </h2>

                    <button type="button"
                            class="close-btn"
                            onclick="closeModal('editModal')">

                        ×

                    </button>

                </div>


                <div class="modal-body">

                    <input type="hidden"
                           id="edit-TestId"
                           name="TestId" />


                    <div class="form-grid">


                        <!-- TEST NAME -->

                        <div class="form-group full">

                            <label class="form-label">

                                Test Name

                                <span class="required">*</span>

                            </label>

                            <input type="text"
                                   id="edit-TestName"
                                   name="TestName"
                                   class="form-control"
                                   required />

                        </div>


                        <!-- CATEGORY -->

                        <div class="form-group">

                            <label class="form-label">

                                Category

                                <span class="required">*</span>

                            </label>

                            <select id="edit-CategoryId"
                                    name="CategoryId"
                                    class="form-control"
                                    required>

                                <option value="">
                                    Select category
                                </option>

                                @if (ViewBag.Category != null)
                                {
                                    @foreach (var sampleType in ViewBag.Category)
                                    {
                                        <option value="@sampleType.Value">
                                            @sampleType.Text
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- SAMPLE TYPE -->

                        <div class="form-group">

                            <label class="form-label">

                                Sample Type

                                <span class="required">*</span>

                            </label>

                            <select id="edit-SampleTypeId"
                                    name="SampleTypeId"
                                    class="form-control"
                                    required>

                                <option value="">
                                    Select sample type
                                </option>

                                @if (ViewBag.SampleType != null)
                                {
                                    @foreach (var sampleType in ViewBag.SampleType)
                                    {
                                        <option value="@sampleType.Value">
                                            @sampleType.Text
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- UNIT -->

                        <div class="form-group">

                            <label class="form-label">
                                Unit Measurement
                            </label>

                            <input type="text"
                                   id="edit-UnitMeasurement"
                                   name="UnitMeasurement"
                                   class="form-control" />

                        </div>


                        <!-- TAT -->

                        <div class="form-group">

                            <label class="form-label">
                                Turnaround Time
                            </label>

                            <input type="number"
                                   id="edit-TurnaroundTime"
                                   name="TurnaroundTime"
                                   class="form-control"
                                   min="0" />

                        </div>


                        <!-- NORMAL MIN -->

                        <div class="form-group">

                            <label class="form-label">
                                Normal Range Minimum
                            </label>

                            <input type="number"
                                   id="edit-NormalRangeMin"
                                   name="NormalRangeMin"
                                   class="form-control"
                                   step="0.01" />

                        </div>


                        <!-- NORMAL MAX -->

                        <div class="form-group">

                            <label class="form-label">
                                Normal Range Maximum
                            </label>

                            <input type="number"
                                   id="edit-NormalRangeMax"
                                   name="NormalRangeMax"
                                   class="form-control"
                                   step="0.01" />

                        </div>


                        <!-- CONSUMABLES -->

                        <div class="form-group full">

                            <label class="form-label">
                                Consumables Used
                            </label>

                            <textarea id="edit-ConsumablesUsed"
                                      name="ConsumablesUsed"
                                      class="form-control"></textarea>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="closeModal('editModal')">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        ✓ Update Test Type

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- =====================================================
         DELETE CONFIRMATION MODAL
    ====================================================== -->

    <div id="deleteModal"
         class="modal-overlay">

        <div class="modal"
             style="max-width:450px;">

            <form asp-controller="TestCatalogue"
                  asp-action="DeleteTest"
                  method="post">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       id="delete-TestId"
                       name="id" />


                <div class="modal-header">

                    <h2 class="modal-title">
                        Delete Test Type
                    </h2>

                    <button type="button"
                            class="close-btn"
                            onclick="closeModal('deleteModal')">

                        ×

                    </button>

                </div>


                <div class="modal-body">

                    <div class="delete-content">

                        <div class="delete-icon">
                            !
                        </div>

                        <div class="delete-title">
                            Are you sure?
                        </div>

                        <p class="delete-message">

                            You are about to delete

                            <strong id="delete-TestName">
                                this test
                            </strong>.

                            This action cannot be undone.

                        </p>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="closeModal('deleteModal')">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        🗑 Delete Test

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script>

            function openAddModal() {

                document.getElementById("addModal")
                    .classList.add("show");

                document.body.style.overflow = "hidden";
            }


            function openAddCategoryModal() {

                document.getElementById("addCategoryModal")
                    .classList.add("show");

                document.body.style.overflow = "hidden";
            }


            function openEditModal(
                id,
                testName,
                categoryId,
                sampleType,
                unit,
                normalMin,
                normalMax,
                tat,
                consumables
            ) {

                document.getElementById("edit-TestId").value = id;

                document.getElementById("edit-TestName").value = testName;

                document.getElementById("edit-CategoryId").value = categoryId;

                document.getElementById("edit-SampleTypeId").value = sampleType;

                document.getElementById("edit-UnitMeasurement").value = unit;

                document.getElementById("edit-NormalRangeMin").value = normalMin;

                document.getElementById("edit-NormalRangeMax").value = normalMax;

                document.getElementById("edit-TurnaroundTime").value = tat;

                document.getElementById("edit-ConsumablesUsed").value = consumables;


                document.getElementById("editModal")
                    .classList.add("show");

                document.body.style.overflow = "hidden";
            }


            function openDeleteModal(id, testName) {

                document.getElementById("delete-TestId").value = id;

                document.getElementById("delete-TestName").textContent = testName;


                document.getElementById("deleteModal")
                    .classList.add("show");

                document.body.style.overflow = "hidden";
            }


            function closeModal(modalId) {

                document.getElementById(modalId)
                    .classList.remove("show");

                document.body.style.overflow = "";
            }


            document.querySelectorAll(".modal-overlay")
                .forEach(function (modal) {

                    modal.addEventListener("click", function (event) {

                        if (event.target === modal) {

                            modal.classList.remove("show");

                            document.body.style.overflow = "";

                        }

                    });

                });


            document.addEventListener("keydown", function (event) {

                if (event.key === "Escape") {

                    document.querySelectorAll(".modal-overlay.show")
                        .forEach(function (modal) {

                            modal.classList.remove("show");

                        });

                    document.body.style.overflow = "";

                }

            });


            setTimeout(function () {

                document.querySelectorAll(".alert")
                    .forEach(function (alert) {

                        alert.style.transition = "opacity .4s ease";

                        alert.style.opacity = "0";

                        setTimeout(function () {

                            alert.remove();

                        }, 400);

                    });

            }, 5000);

    </script>


</body>

</html>