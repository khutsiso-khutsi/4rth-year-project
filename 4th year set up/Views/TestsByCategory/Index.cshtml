 @using LabManager.Models
@model TestsByCategoryReportViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;

    var email = ViewBag.Email?.ToString() ?? "Laboratory Manager";
    var initial = string.IsNullOrWhiteSpace(email)
        ? "M"
        : email.Substring(0, 1).ToUpperInvariant();

    var startDate = ViewBag.StartDate != null
        ? Convert.ToDateTime(ViewBag.StartDate)
        : DateTime.Today.AddDays(-30);

    var endDate = ViewBag.EndDate != null
        ? Convert.ToDateTime(ViewBag.EndDate)
        : DateTime.Today;

    var reportRows = Model?.Categories
        ?? new List<TestsByCategoryReportItem>();

    var totalTests = Model?.TotalTests
        ?? reportRows.Sum(x => x.TestCount);

    var totalCategories = reportRows
        .Select(x => x.CategoryName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .Count();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tests by Category | NMB-HLabSys</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap"
          rel="stylesheet" />

    <style>
        :root {
            --navy: #0b1f3a;
            --navy-light: #122848;
            --teal: #0d9488;
            --teal-light: #e5f5f3;
            --background: #f3f6fb;
            --surface: #ffffff;
            --text: #17253d;
            --muted: #71809b;
            --border: #dfe7f2;
            --sidebar-width: 235px;
            --topbar-height: 72px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--background);
            color: var(--text);
            font-family: 'DM Sans', Arial, sans-serif;
        }

        a {
            text-decoration: none;
        }

        button, input {
            font: inherit;
        }

        .topbar {
            height: var(--topbar-height);
            padding: 0 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            position: sticky;
            top: 0;
            z-index: 100;
            background: var(--navy);
            box-shadow: 0 3px 18px rgba(11, 31, 58, .13);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
            color: white;
        }

        .brand-logo {
            width: 39px;
            height: 39px;
            display: grid;
            place-items: center;
            border-radius: 10px;
            background: var(--teal);
            color: white;
            font-size: 23px;
            font-weight: 600;
        }

        .brand-name {
            font-size: 18px;
            font-weight: 700;
        }

        .brand-name small {
            display: block;
            margin-top: 3px;
            color: #9caec8;
            font-size: 9px;
            letter-spacing: 1.3px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 13px 6px 7px;
            border: 1px solid rgba(255,255,255,.13);
            border-radius: 30px;
            background: rgba(255,255,255,.07);
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: var(--teal);
            color: white;
            font-size: 13px;
            font-weight: 700;
        }

        .user-email {
            max-width: 210px;
            overflow: hidden;
            color: #d8e2f0;
            font-size: 12px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .logout-btn {
            padding: 10px 14px;
            border: 1px solid rgba(255,255,255,.16);
            border-radius: 9px;
            color: white;
            background: rgba(255,255,255,.06);
            font-size: 12px;
            font-weight: 600;
        }

        .logout-btn:hover {
            background: rgba(255,255,255,.14);
        }

        .page {
            display: flex;
            min-height: calc(100vh - var(--topbar-height));
        }

        .sidebar {
            width: var(--sidebar-width);
            flex-shrink: 0;
            padding: 22px 12px;
            position: sticky;
            top: var(--topbar-height);
            height: calc(100vh - var(--topbar-height));
            overflow-y: auto;
            border-right: 1px solid var(--border);
            background: white;
        }

        .nav-label {
            margin: 15px 12px 10px;
            color: #8290a8;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 5px;
            padding: 11px 12px;
            border-left: 3px solid transparent;
            border-radius: 0 9px 9px 0;
            color: #62718d;
            font-size: 13px;
            font-weight: 600;
            transition: .2s ease;
        }

        .nav-icon {
            width: 27px;
            height: 27px;
            display: grid;
            place-items: center;
            border-radius: 8px;
            background: #f0f3f8;
            color: #64748b;
            font-size: 15px;
        }

        .nav-item:hover {
            background: #f2f7fb;
            color: var(--navy);
        }

        .nav-item.active {
            border-left-color: var(--teal);
            background: var(--teal-light);
            color: var(--teal);
        }

        .nav-item.active .nav-icon {
            background: var(--teal);
            color: white;
        }

        .main {
            min-width: 0;
            flex: 1;
            padding: 32px;
        }

        .breadcrumb {
            margin-bottom: 12px;
            color: var(--muted);
            font-size: 12px;
        }

        .page-heading {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 25px;
        }

        h1 {
            margin: 0;
            color: var(--navy);
            font-family: 'DM Serif Display', Georgia, serif;
            font-size: 34px;
            font-weight: 400;
        }

        .subtitle {
            max-width: 670px;
            margin: 8px 0 0;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.7;
        }

        .report-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            border: 1px solid #bce8e2;
            border-radius: 30px;
            background: var(--teal-light);
            color: #087c73;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--teal);
        }

        .filter-card {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            flex-wrap: wrap;
            gap: 18px;
            padding: 20px;
            margin-bottom: 22px;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: white;
            box-shadow: 0 4px 16px rgba(11,31,58,.025);
        }

        .filter-title {
            margin-bottom: 12px;
            color: var(--navy);
            font-size: 13px;
            font-weight: 700;
        }

        .filter-fields {
            display: flex;
            flex-wrap: wrap;
            gap: 13px;
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .field label {
            color: var(--muted);
            font-size: 11px;
            font-weight: 600;
        }

        .field input {
            min-height: 40px;
            padding: 9px 11px;
            border: 1px solid var(--border);
            border-radius: 8px;
            outline: none;
            background: #fbfcfe;
            color: var(--text);
            font-size: 12px;
        }

        .field input:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 3px rgba(13,148,136,.1);
        }

        .btn {
            min-height: 40px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            padding: 10px 15px;
            border: 0;
            border-radius: 8px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 700;
            transition: .2s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-primary {
            background: var(--teal);
            color: white;
            box-shadow: 0 4px 10px rgba(13,148,136,.16);
        }

        .btn-primary:hover {
            background: #087e76;
        }

        .btn-secondary {
            border: 1px solid var(--border);
            background: white;
            color: var(--navy);
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 17px;
            margin-bottom: 22px;
        }

        .summary-card {
            position: relative;
            overflow: hidden;
            padding: 22px;
            border: 1px solid var(--border);
            border-radius: 15px;
            background: white;
            box-shadow: 0 5px 18px rgba(11,31,58,.035);
        }

        .summary-card::after {
            content: "";
            position: absolute;
            top: -30px;
            right: -25px;
            width: 95px;
            height: 95px;
            border-radius: 50%;
            background: var(--tint);
        }

        .summary-top {
            position: relative;
            z-index: 1;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .summary-label {
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
        }

        .summary-icon {
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            border-radius: 10px;
            background: var(--tint);
            color: var(--accent);
            font-size: 17px;
            font-weight: 700;
        }

        .summary-value {
            position: relative;
            z-index: 1;
            margin-top: 15px;
            color: var(--accent);
            font-size: 31px;
            font-weight: 700;
            letter-spacing: -.7px;
        }

        .summary-caption {
            position: relative;
            z-index: 1;
            margin-top: 5px;
            color: var(--muted);
            font-size: 11px;
        }

        .report-container {
            overflow: hidden;
            border: 1px solid var(--border);
            border-radius: 15px;
            background: white;
            box-shadow: 0 6px 22px rgba(11,31,58,.035);
        }

        .report-banner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 18px;
            padding: 22px 24px;
            border-bottom: 1px solid var(--border);
            background: linear-gradient(110deg, white, #f1f8fb);
        }

        .report-title {
            margin: 0;
            color: var(--navy);
            font-size: 16px;
            font-weight: 700;
        }

        .report-period {
            margin-top: 8px;
            color: var(--muted);
            font-size: 11px;
            line-height: 1.8;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
        }

        .table-wrap {
            padding: 22px 24px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        thead th {
            padding: 15px 17px;
            background: var(--navy);
            color: white;
            text-align: left;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .8px;
            text-transform: uppercase;
        }

        thead th:first-child {
            border-radius: 8px 0 0 8px;
        }

        thead th:last-child {
            border-radius: 0 8px 8px 0;
            text-align: right;
        }

        tbody td {
            padding: 16px 17px;
            border-bottom: 1px solid #edf1f7;
            color: #44516a;
            font-size: 13px;
        }

        tbody tr:hover {
            background: #f7fbfc;
        }

        tbody tr:last-child td {
            border-bottom: 0;
        }

        .category-cell {
            display: flex;
            align-items: center;
            gap: 11px;
            color: var(--navy);
            font-weight: 600;
        }

        .category-icon {
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            border-radius: 10px;
            background: var(--teal-light);
            color: var(--teal);
            font-size: 17px;
            font-weight: 700;
        }

        .count-cell {
            text-align: right;
        }

        .count-pill {
            display: inline-block;
            min-width: 50px;
            padding: 7px 12px;
            border-radius: 8px;
            background: var(--teal-light);
            color: #087c73;
            text-align: center;
            font-weight: 700;
        }

        .empty-state {
            padding: 42px 20px;
            color: var(--muted);
            text-align: center;
            line-height: 1.9;
        }

        .empty-icon {
            width: 47px;
            height: 47px;
            display: grid;
            place-items: center;
            margin: 0 auto 12px;
            border-radius: 14px;
            background: var(--teal-light);
            color: var(--teal);
            font-size: 22px;
        }

        .table-footer {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            padding: 15px 24px;
            border-top: 1px solid var(--border);
            background: #fafbfd;
            color: var(--muted);
            font-size: 11px;
        }

        .table-footer strong {
            color: var(--navy);
        }

        .error-message {
            padding: 13px 16px;
            margin-bottom: 18px;
            border: 1px solid #fecaca;
            border-radius: 9px;
            background: #fff1f2;
            color: #b91c1c;
            font-size: 13px;
        }

        .site-footer {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            padding: 22px 2px 0;
            color: var(--muted);
            font-size: 11px;
        }

        @@media (max-width: 1050px) {
            .sidebar {
                width: 195px;
            }

            .main {
                padding: 24px;
            }
        }

        @@media (max-width: 760px) {
            .topbar {
                padding: 0 15px;
            }

            .user-email {
                display: none;
            }

            .sidebar {
                display: none;
            }

            .main {
                padding: 20px 14px;
            }

            .page-heading {
                flex-direction: column;
            }

            h1 {
                font-size: 29px;
            }

            .summary-grid {
                grid-template-columns: 1fr;
            }

            .filter-card {
                align-items: stretch;
            }

            .filter-fields {
                display: grid;
                grid-template-columns: 1fr;
            }

            .filter-fields .field input {
                width: 100%;
            }

            .actions,
            .actions .btn {
                width: 100%;
            }

            .report-banner {
                padding: 19px;
            }

            .table-wrap {
                padding: 15px;
            }
        }

        @@page {
            size: A4 portrait;
            margin: 12mm;
        }

        @@media print {
            body {
                background: white;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .topbar {
                position: static;
                box-shadow: none;
            }

            .topbar-right,
            .sidebar,
            .filter-card,
            .actions,
            .breadcrumb {
                display: none !important;
            }

            .page {
                display: block;
                min-height: 0;
            }

            .main {
                padding: 15px 0;
                overflow: visible;
            }

            .summary-card,
            .report-container {
                box-shadow: none;
                break-inside: avoid;
            }

            thead {
                display: table-header-group;
            }

            tr {
                break-inside: avoid;
            }
        }
    </style>
</head>

<body>
    <header class="topbar">
        <a class="brand"
           asp-controller="ManagerDashboard"
           asp-action="Index">
            <div class="brand-logo">✣</div>
            <div class="brand-name">
                NMB-HLabSys
                <small>HAEMATOLOGY LABORATORY SYSTEM</small>
            </div>
        </a>

        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@initial</div>
                <span class="user-email">@email</span>
            </div>

            <a asp-controller="Home"
               asp-action="Logout"
               class="logout-btn">
                ⇥ Sign Out
            </a>
        </div>
    </header>

    <div class="page">
        <aside class="sidebar">
            <div class="nav-label">Main</div>

            <a asp-controller="ManagerDashboard" asp-action="Index" class="nav-item">
                <span class="nav-icon">⌂</span> Dashboard
            </a>

            <a asp-controller="ManagerDashboard" asp-action="TestCatalogue" class="nav-item">
                <span class="nav-icon">▤</span> Test Catalogue
            </a>

            <a asp-controller="ManagerDashboard" asp-action="Consumables" class="nav-item">
                <span class="nav-icon">◇</span> Consumables
            </a>

            <a asp-controller="ManagerDashboard" asp-action="Staff" class="nav-item">
                <span class="nav-icon">♙</span> Staff
            </a>

            <a asp-controller="ManagerDashboard" asp-action="Orders" class="nav-item">
                <span class="nav-icon">▣</span> Orders
            </a>

            <a asp-controller="TestsByCategory" asp-action="Index" class="nav-item active">
                <span class="nav-icon">▥</span> Tests by Category
            </a>

            <div class="nav-label">System</div>

            <a asp-controller="ManagerDashboard" asp-action="Profile" class="nav-item">
                <span class="nav-icon">◎</span> Profile
            </a>

            <a asp-controller="ManagerDashboard" asp-action="AuditLog" class="nav-item">
                <span class="nav-icon">≡</span> Audit Log
            </a>
        </aside>

        <main class="main">
            <div class="breadcrumb">Manager Dashboard / Reports / Tests by Category</div>

            <div class="page-heading">
                <div>
                    <h1>Laboratory Test Report</h1>
                    <p class="subtitle">
                        Monitor the number of tests performed in each laboratory category
                        over a selected reporting period.
                    </p>
                </div>

                <div class="report-tag">
                    <span class="status-dot"></span>
                    Internal management report
                </div>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="error-message">@TempData["Error"]</div>
            }

            <section class="filter-card">
                <div>
                    <div class="filter-title">Report date range</div>

                    <form method="get"
                          asp-controller="TestsByCategory"
                          asp-action="Index"
                          class="filter-fields">
                        <div class="field">
                            <label for="from">Start date</label>
                            <input type="date"
                                   id="from"
                                   name="from"
                                   value="@startDate.ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                        <div class="field">
                            <label for="to">End date</label>
                            <input type="date"
                                   id="to"
                                   name="to"
                                   value="@endDate.ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                        <div class="field">
                            <label>&nbsp;</label>
                            <button type="submit" class="btn btn-primary">
                                Apply filter
                            </button>
                        </div>
                    </form>
                </div>
            </section>

            <section class="summary-grid">
                <div class="summary-card"
                     style="--accent:#0b1f3a;--tint:#e7edf6;">
                    <div class="summary-top">
                        <div class="summary-label">Total tests performed</div>
                        <div class="summary-icon">Σ</div>
                    </div>
                    <div class="summary-value">@totalTests.ToString("N0")</div>
                    <div class="summary-caption">Tests recorded during this period</div>
                </div>

                <div class="summary-card"
                     style="--accent:#0d9488;--tint:#e1f6f2;">
                    <div class="summary-top">
                        <div class="summary-label">Categories reported</div>
                        <div class="summary-icon">▦</div>
                    </div>
                    <div class="summary-value">@totalCategories.ToString("N0")</div>
                    <div class="summary-caption">Categories with recorded activity</div>
                </div>

                <div class="summary-card"
                     style="--accent:#5472b8;--tint:#e9efff;">
                    <div class="summary-top">
                        <div class="summary-label">Reporting period</div>
                        <div class="summary-icon">◷</div>
                    </div>
                    <div class="summary-value" style="font-size:27px;">
                        @Math.Max(0, (endDate.Date - startDate.Date).Days + 1)
                        <span style="font-size:13px;font-weight:500;">days</span>
                    </div>
                    <div class="summary-caption">
                        @startDate.ToString("dd MMM yyyy") – @endDate.ToString("dd MMM yyyy")
                    </div>
                </div>
            </section>

            <section class="report-container">
                <div class="report-banner">
                    <div>
                        <h2 class="report-title">Tests by Category</h2>
                        <div class="report-period">
                            <strong>From:</strong> @startDate.ToString("dd MMMM yyyy")
                            &nbsp; | &nbsp;
                            <strong>To:</strong> @endDate.ToString("dd MMMM yyyy")
                            <br />
                            Generated: @DateTime.Now.ToString("dd MMMM yyyy, HH:mm")
                        </div>
                    </div>

                    <div class="actions">
                        <button type="button"
                                class="btn btn-primary"
                                onclick="downloadPdf()">
                            ↓ Download PDF
                        </button>

                        <button type="button"
                                class="btn btn-secondary"
                                onclick="window.print()">
                            Print report
                        </button>
                    </div>
                </div>

                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th style="text-align:right;">Total Tests</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (reportRows.Any())
                            {
                                @foreach (var item in reportRows)
                                {
                                    <tr>
                                        <td>
                                            <div class="category-cell">
                                                <div class="category-icon">+</div>
                                                <span>
                                                    @(string.IsNullOrWhiteSpace(item.CategoryName)
                                                        ? "Uncategorised"
                                                        : item.CategoryName)
                                                </span>
                                            </div>
                                        </td>
                                        <td class="count-cell">
                                            <span class="count-pill">
                                                @item.TestCount.ToString("N0")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2">
                                        <div class="empty-state">
                                            <div class="empty-icon">▤</div>
                                            <strong>No report data available</strong>
                                            <br />
                                            No tests were found for the selected dates.
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="table-footer">
                    <span>
                        Showing <strong>@reportRows.Count</strong>
                        report @(reportRows.Count == 1 ? "row" : "rows")
                    </span>
                    <span>
                        Total tests: <strong>@totalTests.ToString("N0")</strong>
                    </span>
                </div>
            </section>

            <footer class="site-footer">
                <span>NMB-HLabSys · Haematology Laboratory System</span>
                <span>Internal management report · @DateTime.Now.Year</span>
            </footer>
        </main>
    </div>

    <script>
        function downloadPdf() {
            // In the print dialog, choose "Save as PDF".
            window.print();
        }

        const fromInput = document.getElementById("from");
        const toInput = document.getElementById("to");

        if (fromInput && toInput) {
            fromInput.addEventListener("change", function () {
                toInput.min = fromInput.value;
            });

            toInput.addEventListener("change", function () {
                fromInput.max = toInput.value;
            });
        }
    </script>
</body>
</html>
