    <div class="modal-overlay" id="m-edit-consumable">
        <div class="modal">

            <div class="modal-header">

                <div class="modal-title">
                    Edit Consumable
                </div>

                <button type="button"
                        class="modal-close"
                        onclick="closeModal('m-edit-consumable')">

                    ×

                </button>

                <div class="modal-title">Edit Consumable</div>
                <button type="button" class="modal-close" onclick="closeModal('m-edit-consumable')">×</button>
            </div>


            <form asp-controller="ManagerDashboard"
                  asp-action="UpdateConsumable"
                  method="post">

                @Html.AntiForgeryToken()

            <form asp-controller="Consumables" asp-action="UpdateConsumable" method="post">
                <div class="modal-body">

                    <input type="hidden"
                           id="edit-id"
                           name="ConsumableID" />

                    <input type="hidden" id="edit-id" name="ConsumableID" />

                    <div class="fgroup2">

                        <label class="app-label">
