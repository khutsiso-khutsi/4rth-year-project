                            </option>

                            @foreach (var supplier in suppliers)
                        <label class="app-label">Supplier <span class="required">*</span></label>
                        <select id="edit-supplier" name="SupplierID" class="app-finput app-select" required>
                            <option value="">Select a supplier</option>
