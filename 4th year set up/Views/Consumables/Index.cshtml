                <div class="modal-actions">
                    <button type="button" class="btn-full purple" id="cv-adjust-btn">Adjust Stock</button>
                    <button type="button" class="btn-full teal" id="cv-edit-btn">Edit</button>
                    <a asp-controller="ConsumableOrder" asp-action="Index" class="btn-full order-btn" style="text-decoration:none;text-align:center;background:var(--green);color:white;">Order</a>
                    <button type="button" class="btn-full btn-outline" onclick="closeModal('m-view-consumable')">Close</button>
                </div>

