    <!-- LOGOUT CONFIRMATION MODAL (matches dashboard) -->
    <div id="logout-modal" role="dialog" aria-modal="true" aria-labelledby="logout-modal-title"
         style="display:none;position:fixed;inset:0;z-index:3100;background:rgba(11,31,58,0.45);align-items:center;justify-content:center;">
        <div style="background:white;border-radius:20px;padding:32px 28px;max-width:380px;width:90%;box-shadow:0 20px 60px rgba(11,31,58,0.2);animation:modalIn 0.18s ease;">
            <div style="width:52px;height:52px;background:#fee2e2;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
            </div>
            <h3 id="logout-modal-title" style="font-family:'DM Serif Display',serif;font-size:1.2rem;color:var(--navy);margin-bottom:8px;">Sign out?</h3>
            <p style="font-size:0.85rem;color:var(--muted);margin-bottom:24px;line-height:1.6;">You'll be returned to the login screen. Any unsaved changes will be lost.</p>
            <div style="display:flex;gap:10px;">
                <button id="logout-cancel" style="flex:1;padding:10px;border:1px solid var(--border);border-radius:10px;background:white;color:var(--navy);font-size:0.85rem;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;">Cancel</button>
                <a id="logout-confirm" href="#" style="flex:1;padding:10px;border:none;border-radius:10px;background:#dc2626;color:white;font-size:0.85rem;font-weight:600;cursor:pointer;text-align:center;text-decoration:none;font-family:'DM Sans',sans-serif;">Sign Out</a>
            </div>
        </div>
    </div>

    <!-- ==========================================================
         JAVASCRIPT
    =========================================================== -->
    <script>

            /* ── MODAL FUNCTIONS ── */
            function openModal(id) {
                var modal = document.getElementById(id);
                if (modal) modal.classList.add("show");
            }

            function closeModal(id) {
                var modal = document.getElementById(id);
                if (modal) modal.classList.remove("show");
            }

            document.querySelectorAll(".modal-overlay").forEach(function (modal) {
                modal.addEventListener("click", function (event) {
                    if (event.target === modal) modal.classList.remove("show");
                });
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    document.querySelectorAll(".modal-overlay.show").forEach(function (modal) {
                        modal.classList.remove("show");
                    });
                }
            });

            /* ── SEARCH ── */
            function searchConsumables() {
                var input = document.getElementById("searchInput");
                var filter = input.value.toLowerCase();
                var table = document.getElementById("consumablesTable");
                var rows = table.querySelectorAll("tbody tr.row-clickable");

                rows.forEach(function (row) {
                    var name = row.dataset.name || "";
                    var supplier = row.dataset.supplier || "";
                    var status = row.dataset.status || "";
                    var combined = (name + " " + supplier + " " + status).toLowerCase();
                    row.style.display = combined.includes(filter) ? "" : "none";
                });
            }

            /* ── VIEW CONSUMABLE ── */
            function openConsumableView(row) {
                var id = row.dataset.id;
                var name = row.dataset.name;
                var supplier = row.dataset.supplier;
                var onHand = parseInt(row.dataset.onhand || "0");
                var reorder = parseInt(row.dataset.reorder || "0");
                var status = row.dataset.status;

                document.getElementById("cv-name").textContent = name;
                document.getElementById("cv-supplier").textContent = supplier;
                document.getElementById("cv-reorder").textContent = reorder;
                document.getElementById("cv-onhand").textContent = onHand;
                document.getElementById("cv-status").textContent = status;

                document.getElementById("cv-adjust-btn").onclick = function () {
                    closeModal("m-view-consumable");
                    openAdjustModal(parseInt(id, 10), name, onHand, reorder);
                };

                document.getElementById("cv-edit-btn").onclick = function () {
                    closeModal("m-view-consumable");
                    var supplierId = row.dataset.supplierId || "";
                    openEditModal(id, name, supplierId, reorder);
                };

                openModal("m-view-consumable");
            }

            /* ── ADJUST STOCK ── */
            function openAdjustModal(id, name, onHand, reorderLevel) {
                if (!id || parseInt(id, 10) <= 0) {
                    alert("Invalid consumable ID: " + id);
                    return;
                }

                document.getElementById("adj-id").value = parseInt(id, 10);
                document.getElementById("adj-name").textContent = name;
                document.getElementById("adj-meta").textContent =
                    "Current: " + onHand + " units · Reorder level: " + reorderLevel;
                document.getElementById("stock-adj-val").value = "";
                document.getElementById("stock-adj-type").value = "Increase";

                openModal("m-adjust-stock");
            }

            /* ── EDIT ── */
            function openEditModal(id, name, supplierId, reorderLevel) {
                document.getElementById("edit-id").value = id;
                document.getElementById("edit-name").value = name;
                document.getElementById("edit-supplier").value = supplierId || "";
                document.getElementById("edit-reorder").value = reorderLevel;

                openModal("m-edit-consumable");
            }

            /* ── ACTION BUTTONS ── */
            document.querySelectorAll(".js-adjust").forEach(function (button) {
                button.addEventListener("click", function (event) {
                    event.stopPropagation();
                    openAdjustModal(
                        button.dataset.id,
                        button.dataset.name || "",
                        button.dataset.onhand || "0",
                        button.dataset.reorder || "0"
                    );
                });
            });

            document.querySelectorAll(".js-edit").forEach(function (button) {
                button.addEventListener("click", function (event) {
                    event.stopPropagation();
                    openEditModal(
                        button.dataset.id,
                        button.dataset.name || "",
                        button.dataset.supplierId || "",
                        button.dataset.reorder || "0"
                    );
                });
            });

            /* ── PREVENT NEGATIVE VALUES ── */
            document.querySelectorAll('input[type="number"]').forEach(function (input) {
                input.addEventListener("input", function () {
                    if (this.value < 0) this.value = 0;
                });
            });

            /* ── LOGOUT MODAL ── */
            (function () {
                var logoutBtn     = document.getElementById('logout-btn');
                var logoutModal   = document.getElementById('logout-modal');
                var logoutCancel  = document.getElementById('logout-cancel');
                var logoutConfirm = document.getElementById('logout-confirm');

                if (logoutBtn && logoutModal) {
                    logoutConfirm.href = logoutBtn.href;

                    logoutBtn.addEventListener('click', function (e) {
                        e.preventDefault();
                        logoutModal.style.display = 'flex';
                        logoutCancel.focus();
                    });

                    function closeLogoutModal() {
                        logoutModal.style.display = 'none';
                        logoutBtn.focus();
                    }

                    logoutCancel.addEventListener('click', closeLogoutModal);
                    logoutModal.addEventListener('click', function (e) {
                        if (e.target === logoutModal) closeLogoutModal();
                    });
                    document.addEventListener('keydown', function (e) {
                        if (e.key === 'Escape' && logoutModal.style.display === 'flex') closeLogoutModal();
                    });
                }
            })();

    </script>

</body>
</html>
