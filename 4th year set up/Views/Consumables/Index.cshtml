                            {
                                <option value="@supplier.SupplierID">
                                    @supplier.SupplierName
                                </option>
                                <option value="@s.SupplierID">@s.SupplierName</option>
                            }

                        </select>

                    </div>


                    <div class="fgroup2">

                        <label class="app-label">
                            Reorder Level *
                        </label>

                        <input class="app-finput"
                               id="edit-reorder"
                               name="ReorderLevel"
                               type="number"
                               min="0"
                               required />

                        <label class="app-label">Reorder Level <span class="required">*</span></label>
                        <input class="app-finput" id="edit-reorder" name="ReorderLevel" type="number" min="0" required />
                    </div>


                    <div class="modal-actions">

                        <button type="submit"
                                class="btn-full teal">

                            Save Changes

                        </button>

                        <button type="button"
                                class="btn-full btn-outline"
                                onclick="closeModal('m-edit-consumable')">

                            Cancel

                        </button>

                        <button type="submit" class="btn-full teal">Save Changes</button>
                        <button type="button" class="btn-full btn-outline" onclick="closeModal('m-edit-consumable')">Cancel</button>
                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ==========================================================
         DELETE CONSUMABLE MODAL
    =========================================================== -->

    <div class="modal-overlay"
         id="m-delete-consumable">

        <div class="modal">

            <div class="modal-header">

                <div class="modal-title">
                    Delete Consumable
                </div>

                <button type="button"
                        class="modal-close"
                        onclick="closeModal('m-delete-consumable')">

                    ×

                </button>

            </div>


            <form asp-controller="ManagerDashboard"
                  asp-action="DeleteConsumable"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden"
                           id="delete-id"
                           name="ConsumableID" />


                    <div class="delete-warning">

                        <div class="delete-icon">
                            !
                        </div>

                        <h3>
                            Delete <span id="delete-name"></span>?
                        </h3>

                        <p>
                            This consumable will be removed from the active
                            inventory list. This action cannot be undone
                            from this page.
                        </p>

                    </div>


                    <div class="modal-actions">

                        <button type="submit"
                                class="btn-full red">

                            Delete Consumable

                        </button>

                        <button type="button"
                                class="btn-full btn-outline"
                                onclick="closeModal('m-delete-consumable')">

                            Cancel

                        </button>

    <!-- LOGOUT CONFIRMATION MODAL -->
    <div id="logout-modal" role="dialog" aria-modal="true" aria-labelledby="logout-modal-title"
         style="display:none;position:fixed;inset:0;z-index:3100;background:rgba(11,31,58,0.45);align-items:center;justify-content:center;">
        <div style="background:white;border-radius:20px;padding:32px 28px;max-width:380px;width:90%;box-shadow:0 20px 60px rgba(11,31,58,0.2);animation:modalIn 0.18s ease;">
            <div style="width:52px;height:52px;background:#fee2e2;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                    </div>

            <h3 id="logout-modal-title" style="font-family:'DM Serif Display',serif;font-size:1.2rem;color:var(--navy);margin-bottom:8px;">Sign out?</h3>
            <p style="font-size:0.85rem;color:var(--muted);margin-bottom:24px;line-height:1.6;">You'll be returned to the login screen. Any unsaved changes will be lost.</p>
            <div style="display:flex;gap:10px;">
                <button id="logout-cancel" style="flex:1;padding:10px;border:1px solid var(--border);border-radius:10px;background:white;color:var(--navy);font-size:0.85rem;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;">Cancel</button>
                <a id="logout-confirm" href="#" style="flex:1;padding:10px;border:none;border-radius:10px;background:#dc2626;color:white;font-size:0.85rem;font-weight:600;cursor:pointer;text-align:center;text-decoration:none;font-family:'DM Sans',sans-serif;">Sign Out</a>
                </div>

            </form>

        </div>

    </div>


    <!-- ==========================================================
         JAVASCRIPT
    =========================================================== -->

    <script>

            /* =========================
               MODAL FUNCTIONS
            ========================= */

        /* ── MODAL FUNCTIONS ── */
            function openModal(id) {

                var modal = document.getElementById(id);

                if (modal) {
                    modal.classList.add("show");
                }
            if (modal) modal.classList.add("show");
            }


            function closeModal(id) {

                var modal = document.getElementById(id);

                if (modal) {
                    modal.classList.remove("show");
                }
            if (modal) modal.classList.remove("show");
            }


            /* =========================
               CLOSE MODAL WHEN CLICKING
               OUTSIDE
            ========================= */

            document.querySelectorAll(".modal-overlay").forEach(function (modal) {

                modal.addEventListener("click", function (event) {

                    if (event.target === modal) {
                        modal.classList.remove("show");
                    }

                if (event.target === modal) modal.classList.remove("show");
                });

            });


            /* =========================
               ESC KEY
            ========================= */

            document.addEventListener("keydown", function (event) {

                if (event.key === "Escape") {

                    document.querySelectorAll(".modal-overlay.show")
                        .forEach(function (modal) {

                document.querySelectorAll(".modal-overlay.show").forEach(function (modal) {
                            modal.classList.remove("show");

                        });

                }

            });


            /* =========================
               SEARCH
            ========================= */

        /* ── SEARCH: CONSUMABLES ── */
            function searchConsumables() {

                var input =
                    document.getElementById("searchInput");

                var filter =
                    input.value.toLowerCase();

                var table =
                    document.getElementById("consumablesTable");

                var rows =
                    table.querySelectorAll("tbody tr.row-clickable");
            var filter = document.getElementById("searchInput").value.toLowerCase();
            var rows = document.querySelectorAll("#consumablesTable tbody tr.row-clickable");

                rows.forEach(function (row) {

                    var name =
                        row.dataset.name || "";

                    var supplier =
                        row.dataset.supplier || "";

                    var status =
                        row.dataset.status || "";

                    var combined =
                        (name + " " + supplier + " " + status)
                        .toLowerCase();
                var combined = ((row.dataset.name || "") + " " +
                                (row.dataset.supplier || "") + " " +
                                (row.dataset.status || "")).toLowerCase();
                row.style.display = combined.includes(filter) ? "" : "none";
            });
        }

                    row.style.display =
                        combined.includes(filter)
                            ? ""
                            : "none";
        /* ── SEARCH: SUPPLIERS ── */
        function searchSuppliers() {
            var filter = document.getElementById("supplierSearch").value.toLowerCase();
            var rows = document.querySelectorAll("#supplierTable tbody tr[data-search]");

            rows.forEach(function (row) {
                row.style.display = row.dataset.search.includes(filter) ? "" : "none";
                });

            }


            /* =========================
               VIEW CONSUMABLE
            ========================= */

        /* ── VIEW CONSUMABLE ── */
            function openConsumableView(row) {

                var id =
                    row.dataset.id;

                var name =
                    row.dataset.name;

                var supplier =
                    row.dataset.supplier;

                var onHand =
                    parseInt(row.dataset.onhand || "0");

                var reorder =
                    parseInt(row.dataset.reorder || "0");

                var status =
                    row.dataset.status;


                document.getElementById("cv-name")
                    .textContent = name;

                document.getElementById("cv-supplier")
                    .textContent = supplier;

                document.getElementById("cv-reorder")
                    .textContent = reorder;

                document.getElementById("cv-onhand")
                    .textContent = onHand;

                document.getElementById("cv-status")
                    .textContent = status;

            var id = row.dataset.id;
            var name = row.dataset.name;
            var supplier = row.dataset.supplier;
            var onHand = parseInt(row.dataset.onhand || "0", 10);
            var reorder = parseInt(row.dataset.reorder || "0", 10);
            var status = row.dataset.status;

                document.getElementById("cv-adjust-btn")
                    .onclick = function () {
            document.getElementById("cv-name").textContent = name;
            document.getElementById("cv-supplier").textContent = supplier;
            document.getElementById("cv-reorder").textContent = reorder;
            document.getElementById("cv-onhand").textContent = onHand;
            document.getElementById("cv-status").textContent = status;

            document.getElementById("cv-adjust-btn").onclick = function () {
                        closeModal("m-view-consumable");

                        openAdjustModal(
                            id,
                            name,
                            onHand,
                            reorder
                        );

                openAdjustModal(id, name, onHand, reorder);
                    };


                document.getElementById("cv-edit-btn")
                    .onclick = function () {

            document.getElementById("cv-edit-btn").onclick = function () {
                        closeModal("m-view-consumable");

                        var supplierId =
                            row.dataset.supplierId || "";

                        openEditModal(
                            id,
                            name,
                            supplierId,
                            reorder
                        );

                openEditModal(id, name, row.dataset.supplierId || "", reorder);
                    };


                openModal("m-view-consumable");
        }

        /* ── ADJUST STOCK ── */
        function openAdjustModal(id, name, onHand, reorderLevel) {
            var parsedId = parseInt(id, 10);
            if (!parsedId || parsedId <= 0) {
                alert("Invalid consumable ID: " + id);
                return;
            }


            /* =========================
               ADJUST STOCK
            ========================= */

            function openAdjustModal(
                id,
                name,
                onHand,
                reorderLevel) {

                document.getElementById("adj-id")
                    .value = id;

                document.getElementById("adj-name")
                    .textContent = name;

                document.getElementById("adj-meta")
                    .textContent =
                    "Current: " +
                    onHand +
                    " units · Reorder level: " +
                    reorderLevel;

                document.getElementById("stock-adj-val")
                    .value = "";

                document.getElementById("stock-adj-type")
                    .selectedIndex = 0;
            document.getElementById("adj-id").value = parsedId;
            document.getElementById("adj-name").textContent = name;
            document.getElementById("adj-meta").textContent =
                "Current: " + onHand + " units · Reorder level: " + reorderLevel;
            document.getElementById("stock-adj-val").value = "";
            document.getElementById("stock-adj-type").value = "Increase";

                openModal("m-adjust-stock");
            }


            /* =========================
               EDIT
            ========================= */

            function openEditModal(
                id,
                name,
                supplierId,
                reorderLevel) {

                document.getElementById("edit-id")
                    .value = id;

                document.getElementById("edit-name")
                    .value = name;

                document.getElementById("edit-supplier")
                    .value = supplierId;

                document.getElementById("edit-reorder")
                    .value = reorderLevel;
        /* ── EDIT CONSUMABLE ── */
        function openEditModal(id, name, supplierId, reorderLevel) {
            document.getElementById("edit-id").value = id;
            document.getElementById("edit-name").value = name;
            document.getElementById("edit-supplier").value = supplierId || "";
            document.getElementById("edit-reorder").value = reorderLevel;

                openModal("m-edit-consumable");
            }

        /* ── EDIT SUPPLIER ── */
        function openEditSupplier(button) {
            closeModal("m-manage-suppliers");

            /* =========================
               DELETE
            ========================= */
            document.getElementById("es-id").value = button.dataset.id;
            document.getElementById("es-name").value = button.dataset.name || "";
            document.getElementById("es-contact").value = button.dataset.contact || "";
            document.getElementById("es-email").value = button.dataset.email || "";

            function openDeleteModal(
                id,
                name) {
            openModal("m-edit-supplier");
        }

                document.getElementById("delete-id")
                    .value = id;
        /* ── ROW ACTION BUTTONS ── */
        document.querySelectorAll(".js-adjust").forEach(function (button) {
            button.addEventListener("click", function (event) {
                event.stopPropagation();
                openAdjustModal(
                    button.dataset.id,
                    button.dataset.name || "",
                    button.dataset.onhand || "0",
                    button.dataset.reorder || "0"
                );
            });
        });

                document.getElementById("delete-name")
                    .textContent = name;
        document.querySelectorAll(".js-edit-supplier").forEach(function (button) {
            button.addEventListener("click", function () {
                openEditSupplier(button);
            });
        });

                openModal("m-delete-consumable");
        document.querySelectorAll(".js-delete-supplier-form").forEach(function (form) {
            form.addEventListener("submit", function (event) {
                var name = form.dataset.name || "this supplier";
                if (!confirm("Delete " + name + "? This cannot be undone.")) {
                    event.preventDefault();
            }
            });
        });

        /* ── PREVENT NEGATIVE VALUES ── */
        document.querySelectorAll('input[type="number"]').forEach(function (input) {
            input.addEventListener("input", function () {
                if (this.value < 0) this.value = 0;
            });
        });

            /* =========================
               PREVENT NEGATIVE VALUES
            ========================= */
        /* ── LOGOUT MODAL ── */
        (function () {
            var logoutBtn     = document.getElementById('logout-btn');
            var logoutModal   = document.getElementById('logout-modal');
            var logoutCancel  = document.getElementById('logout-cancel');
            var logoutConfirm = document.getElementById('logout-confirm');

            document
                .querySelectorAll('input[type="number"]')
                .forEach(function (input) {
            if (logoutBtn && logoutModal) {
                logoutConfirm.href = logoutBtn.href;

                    input.addEventListener("input", function () {
                logoutBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    logoutModal.style.display = 'flex';
                    logoutCancel.focus();
                });

                        if (this.value < 0) {
                            this.value = 0;
                function closeLogoutModal() {
                    logoutModal.style.display = 'none';
                    logoutBtn.focus();
                        }

                logoutCancel.addEventListener('click', closeLogoutModal);
                logoutModal.addEventListener('click', function (e) {
                    if (e.target === logoutModal) closeLogoutModal();
                    });

                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && logoutModal.style.display === 'flex') closeLogoutModal();
                });
            }
        })();

    </script>

</body>
</html>

