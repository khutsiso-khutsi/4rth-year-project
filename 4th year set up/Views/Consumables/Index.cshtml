@using System.Text.Json
@using LabManager.Models
@model IEnumerable<Consumable>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    ViewData["Title"] = "Consumables Management";

    var suppliers = ViewBag.Supplier as IEnumerable<Supplier>
                    ?? Enumerable.Empty<Supplier>();

    var supplierDictionary = new Dictionary<string, string>();

    if (ViewBag.Supplier is IEnumerable<dynamic> supplier)
    {
        // Populate the dictionary with valid fridge data
        supplierDictionary = supplier.ToDictionary(supplier => (string)supplier.Value, supplier => (string)supplier.Text);
    }

    var email = ViewBag.Email as string ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Consumables Management — NMB-HLabSys</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --navy: #0b1f3a;
                --navy2: #122848;
                --teal: #0d9488;
                --teal-dark: #0b7c72;
                --teal-light: rgba(13,148,136,0.1);
                --white: #ffffff;
                --offwhite: #f4f7fb;
                --muted: #6b7a99;
                --border: #dde4f0;
                --red: #dc2626;
                --red-dark: #b91c1c;
                --red-light: rgba(220,38,38,0.1);
                --green: #16a34a;
                --green-dark: #128a3e;
                --green-light: rgba(22,163,74,0.1);
                --amber: #d97706;
                --amber-light: rgba(217,119,6,0.1);
                --purple: #4f46e5;
                --purple-light: rgba(79,70,229,0.1);
                --radius: 16px;
                --shadow: 0 2px 8px rgba(11,31,58,.04);
                --shadow-lg: 0 20px 60px rgba(11,31,58,.20);
            }

            body {
                font-family: 'DM Sans', sans-serif;
                background: var(--offwhite);
                color: var(--navy);
                min-height: 100vh;
                line-height: 1.5;
            }

            button, input, select {
                font-family: inherit;
            }

            /* ── TOPBAR (matches dashboard) ── */
            .topbar {
                background: var(--navy);
                padding: 0 40px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                height: 64px;
                position: sticky;
                top: 0;
                z-index: 100;
                box-shadow: 0 2px 20px rgba(0,0,0,0.15);
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

            .brand-icon {
                width: 34px;
                height: 34px;
                background: var(--teal);
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .brand-icon svg {
                    width: 18px;
                    height: 18px;
                    fill: white;
                }

            .brand-name {
                font-family: 'DM Serif Display', serif;
                color: white;
                font-size: 1.1rem;
                line-height: 1.1;
            }

                .brand-name span {
                    display: block;
                    font-family: 'DM Sans', sans-serif;
                    font-size: 0.6rem;
                    font-weight: 300;
                    color: rgba(255,255,255,0.4);
                    letter-spacing: 0.1em;
                    text-transform: uppercase;
                }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .user-chip {
                display: flex;
                align-items: center;
                gap: 10px;
                background: rgba(255,255,255,0.07);
                border: 1px solid rgba(255,255,255,0.1);
                border-radius: 100px;
                padding: 6px 14px 6px 8px;
            }

            .user-avatar {
                width: 28px;
                height: 28px;
                background: var(--teal);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.75rem;
                font-weight: 600;
                color: white;
            }

            .user-email {
                font-size: 0.8rem;
                color: rgba(255,255,255,0.75);
                max-width: 160px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .logout-btn {
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.12);
                color: rgba(255,255,255,0.8);
                padding: 8px 16px;
                border-radius: 8px;
                text-decoration: none;
                font-size: 0.82rem;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 6px;
                transition: all 0.2s;
                cursor: pointer;
            }

                .logout-btn:hover {
                    background: rgba(255,255,255,0.15);
                    color: white;
                }

                .logout-btn svg {
                    width: 14px;
                    height: 14px;
                }

            /* ── LAYOUT ── */
            .page {
                display: flex;
                min-height: calc(100vh - 64px);
            }

            /* ── SIDEBAR (matches dashboard, includes Profile + Audit Log) ── */
            .sidebar {
                width: 220px;
                background: white;
                border-right: 1px solid var(--border);
                padding: 24px 0;
                flex-shrink: 0;
                position: sticky;
                top: 64px;
                height: calc(100vh - 64px);
                overflow-y: auto;
            }

            .nav-section {
                margin-bottom: 8px;
            }

            .nav-label {
                font-size: 0.65rem;
                font-weight: 600;
                color: var(--muted);
                letter-spacing: 0.1em;
                text-transform: uppercase;
                padding: 0 20px;
                margin-bottom: 4px;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 20px;
                color: var(--muted);
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 500;
                transition: all 0.15s;
                border-left: 3px solid transparent;
            }

                .nav-item:hover {
                    background: var(--offwhite);
                    color: var(--navy);
                }

                .nav-item.active {
                    background: var(--teal-light);
                    color: var(--teal);
                    border-left-color: var(--teal);
                    font-weight: 600;
                }

                .nav-item svg {
                    width: 16px;
                    height: 16px;
                    flex-shrink: 0;
                }

                .nav-item:focus-visible {
                    outline: 2px solid var(--teal);
                    outline-offset: -2px;
                }

            /* ── MAIN (matches dashboard) ── */
            .main {
                flex: 1;
                padding: clamp(24px, 3vw, 40px);
                overflow-y: auto;
            }

            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                margin-bottom: 24px;
                gap: 20px;
                flex-wrap: wrap;
            }

            .page-title {
                font-family: 'DM Serif Display', serif;
                font-size: 1.8rem;
                font-weight: 400;
                color: var(--navy);
            }

            .page-description {
                margin-top: 6px;
                color: var(--muted);
                font-size: 0.85rem;
                font-weight: 300;
            }

            .header-actions {
                display: flex;
                gap: 9px;
                flex-wrap: wrap;
            }

            /* ── BUTTONS (recolored to dashboard palette) ── */
            .btn {
                border: none;
                border-radius: 10px;
                padding: 10px 16px;
                font-size: 0.82rem;
                font-weight: 600;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                transition: all .18s ease;
            }

                .btn:hover {
                    transform: translateY(-1px);
                }

            .btn-teal {
                background: var(--teal);
                color: white;
                box-shadow: 0 2px 8px rgba(13,148,136,0.25);
            }

                .btn-teal:hover {
                    background: var(--teal-dark);
                }

            .btn-outline {
                background: white;
                border: 1px solid var(--border);
                color: var(--navy);
            }

                .btn-outline:hover {
                    border-color: var(--teal);
                    color: var(--teal);
                }

            /* ── ALERTS ── */
            .alert {
                padding: 13px 16px;
                border-radius: 10px;
                margin-bottom: 20px;
                font-size: 0.82rem;
                font-weight: 600;
            }

            .alert-success {
                background: var(--green-light);
                color: var(--green);
                border: 1px solid rgba(22,163,74,0.25);
            }

            .alert-error {
                background: var(--red-light);
                color: var(--red);
                border: 1px solid rgba(220,38,38,0.25);
            }

            /* ── STAT CARDS (matches dashboard) ── */
            .stats-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 16px;
                margin-bottom: 24px;
            }

            .stat-card {
                background: white;
                border: 1px solid var(--border);
                border-radius: 16px;
                padding: 20px;
                box-shadow: var(--shadow);
            }

            .stat-top {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 14px;
            }

            .stat-icon {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .stat-icon svg {
                    width: 18px;
                    height: 18px;
                }

            .stat-value {
                font-family: 'DM Serif Display', serif;
                font-size: 2rem;
                color: var(--navy);
                line-height: 1;
                margin-bottom: 4px;
            }

            .stat-label {
                font-size: 0.78rem;
                color: var(--muted);
                font-weight: 600;
            }

            .stat-description {
                margin-top: 3px;
                font-size: 0.7rem;
                color: var(--muted);
            }

            /* ── TABLE CARD ── */
            .card {
                background: white;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                box-shadow: var(--shadow);
                overflow: hidden;
            }

            .card-header {
                padding: 17px 22px;
                border-bottom: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 20px;
                flex-wrap: wrap;
            }

            .card-title {
                font-family: 'DM Serif Display', serif;
                font-size: 1.05rem;
                font-weight: 400;
                color: var(--navy);
            }

            .card-subtitle {
                margin-top: 4px;
                font-size: 0.72rem;
                color: var(--muted);
            }

            .search-box {
                width: 270px;
                position: relative;
            }

                .search-box input {
                    width: 100%;
                    padding: 10px 12px 10px 35px;
                    border: 1px solid var(--border);
                    border-radius: 8px;
                    outline: none;
                    font-size: 0.8rem;
                    background: var(--offwhite);
                    color: var(--navy);
                }

                    .search-box input:focus {
                        border-color: var(--teal);
                        box-shadow: 0 0 0 3px var(--teal-light);
                        background: white;
                    }

            .search-icon {
                position: absolute;
                left: 12px;
                top: 10px;
                color: var(--muted);
                font-size: 13px;
            }

            .table-wrapper {
                width: 100%;
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 850px;
            }

            thead {
                background: var(--offwhite);
            }

            th {
                padding: 12px 20px;
                text-align: left;
                font-size: 0.7rem;
                font-weight: 700;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: .06em;
                border-bottom: 1px solid var(--border);
            }

            td {
                padding: 14px 20px;
                border-bottom: 1px solid var(--offwhite);
                font-size: 0.82rem;
                color: var(--navy);
            }

            tbody tr:last-child td {
                border-bottom: none;
            }

            .row-clickable {
                cursor: pointer;
                transition: background .15s;
            }

                .row-clickable:hover {
                    background: var(--offwhite);
                }

            .consumable-name {
                color: var(--navy);
                font-weight: 700;
            }

            .supplier-name {
                color: var(--muted);
            }

            .quantity {
                font-weight: 700;
                color: var(--navy);
            }

            .status {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 4px 10px;
                border-radius: 100px;
                font-size: 0.68rem;
                font-weight: 700;
            }

            .status-good {
                background: var(--green-light);
                color: var(--green);
            }

            .status-medium {
                background: var(--amber-light);
                color: var(--amber);
            }

            .status-low {
                background: var(--red-light);
                color: var(--red);
            }

            .status-dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: currentColor;
            }

            .actions {
                display: flex;
                gap: 6px;
                flex-wrap: wrap;
            }

            .action-btn {
                border: none;
                border-radius: 7px;
                padding: 6px 10px;
                font-size: 0.68rem;
                font-weight: 700;
                cursor: pointer;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
            }

            .adjust-btn {
                background: var(--purple-light);
                color: var(--purple);
            }

                .adjust-btn:hover {
                    background: rgba(79,70,229,0.2);
                }

            .edit-btn {
                background: var(--teal-light);
                color: var(--teal);
            }

                .edit-btn:hover {
                    background: rgba(13,148,136,0.2);
                }

            .order-btn {
                background: var(--green-light);
                color: var(--green);
            }

                .order-btn:hover {
                    background: rgba(22,163,74,0.2);
                }

            .empty-state {
                padding: 60px 20px;
                text-align: center;
                color: var(--muted);
                font-size: 0.82rem;
            }

            .empty-icon {
                width: 70px;
                height: 70px;
                margin: 0 auto 17px;
                border-radius: 50%;
                background: var(--teal-light);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 32px;
            }

            /* ── MODAL ── */
            .modal-overlay {
                position: fixed;
                inset: 0;
                background: rgba(11,31,58,.45);
                backdrop-filter: blur(3px);
                display: none;
                align-items: center;
                justify-content: center;
                z-index: 3000;
                padding: 20px;
            }

                .modal-overlay.show {
                    display: flex;
                }

            .modal {
                width: 100%;
                max-width: 520px;
                background: white;
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                animation: modalIn .18s ease;
                max-height: 90vh;
                overflow-y: auto;
            }

            @@keyframes modalIn {
                from {
                    opacity: 0;
                    transform: translateY(8px) scale(.98);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            .modal-header {
                padding: 19px 22px;
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .modal-title {
                font-family: 'DM Serif Display', serif;
                font-size: 1.2rem;
                font-weight: 400;
                color: var(--navy);
            }

            .modal-close {
                width: 32px;
                height: 32px;
                border: none;
                background: var(--offwhite);
                color: var(--muted);
                border-radius: 8px;
                cursor: pointer;
                font-size: 18px;
                transition: background .18s ease, color .18s ease;
            }

                .modal-close:hover {
                    background: var(--border);
                    color: var(--navy);
                }

            .modal-body {
                padding: 22px;
            }

            .modal-actions {
                display: flex;
                gap: 10px;
                margin-top: 22px;
            }

            .btn-full {
                flex: 1;
                border: none;
                padding: 11px;
                border-radius: 10px;
                cursor: pointer;
                font-size: 0.82rem;
                font-weight: 700;
            }

                .btn-full.teal {
                    background: var(--teal);
                    color: white;
                }

                    .btn-full.teal:hover {
                        background: var(--teal-dark);
                    }

                .btn-full.purple {
                    background: var(--purple);
                    color: white;
                }

                .btn-full.btn-outline {
                    background: white;
                    border: 1px solid var(--border);
                    color: var(--navy);
                }

                    .btn-full.btn-outline:hover {
                        border-color: var(--teal);
                        color: var(--teal);
                    }

            .fgroup2 {
                margin-bottom: 17px;
            }

            .app-label {
                display: block;
                margin-bottom: 7px;
                font-size: 0.72rem;
                font-weight: 700;
                color: var(--navy);
            }

            .required {
                color: var(--red);
            }

            .app-finput {
                width: 100%;
                padding: 10px 12px;
                border: 1px solid var(--border);
                border-radius: 8px;
                background: white;
                outline: none;
                font-size: 0.82rem;
                color: var(--navy);
            }

                .app-finput:focus {
                    border-color: var(--teal);
                    box-shadow: 0 0 0 3px var(--teal-light);
                }

            .app-select {
                cursor: pointer;
            }

            .fgrid2 {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 14px;
            }

            /* ── DETAIL VIEW ── */
            .detail-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 14px;
            }

            .detail-item {
                padding: 14px;
                background: var(--offwhite);
                border: 1px solid var(--border);
                border-radius: 10px;
            }

            .detail-label {
                font-size: 0.65rem;
                text-transform: uppercase;
                color: var(--muted);
                font-weight: 700;
                letter-spacing: .05em;
            }

            .detail-value {
                margin-top: 5px;
                color: var(--navy);
                font-size: 0.95rem;
                font-weight: 700;
            }

            .stock-display {
                margin: 18px 0;
                padding: 17px;
                background: var(--teal-light);
                border-radius: 10px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .stock-number {
                font-family: 'DM Serif Display', serif;
                font-size: 1.9rem;
                color: var(--teal);
            }

            .stock-label {
                font-size: 0.65rem;
                color: var(--muted);
                font-weight: 700;
            }

            /* ── RESPONSIVE (matches dashboard breakpoints) ── */
            @@media (max-width: 1100px) {
                .stats-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @@media (max-width: 768px) {
                .topbar {
                    padding: 0 20px;
                }

                .user-email {
                    display: none;
                }

                .sidebar {
                    display: none;
                }

                .main {
                    padding: 20px 16px;
                }

                .page-header {
                    flex-direction: column;
                    gap: 16px;
                }

                .header-actions {
                    width: 100%;
                }

                    .header-actions .btn {
                        flex: 1;
                    }

                .card-header {
                    flex-direction: column;
                    align-items: stretch;
                }

                .search-box {
                    width: 100%;
                }

                .stats-grid {
                    grid-template-columns: 1fr;
                }

                .fgrid2, .detail-grid {
                    grid-template-columns: 1fr;
                }
            }
    </style>
</head>
<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <div class="brand-icon">
                <svg viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 1 1v4h4a1 1 0 0 1 0 2h-4v4a1 1 0 0 1-2 0V9H7a1 1 0 0 1 0-2h4V3a1 1 0 0 1 1-1z" /><circle cx="12" cy="17" r="4" opacity="0.6" /></svg>
            </div>
            <div class="brand-name">
                NMB-HLabSys
                <span>Haematology Lab System</span>
            </div>
        </a>
        <div class="topbar-right">
            <div class="user-chip">
                <div class="user-avatar">@(string.IsNullOrWhiteSpace(email) ? "M" : email.Substring(0, 1).ToUpper())</div>
                <span class="user-email">@(string.IsNullOrWhiteSpace(email) ? "Laboratory Manager" : email)</span>
            </div>
            <a asp-controller="Home" asp-action="Logout" class="logout-btn" id="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Sign Out
            </a>
        </div>
    </div>

    <div class="page">

        <!-- SIDEBAR (Main + System, matches dashboard) -->
        <aside class="sidebar">
            <div class="nav-section">
                <div class="nav-label">Main</div>

                <a asp-controller="ManagerDashboard" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                    </svg>
                    Dashboard
                </a>

                <a asp-controller="TestCatalogue" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M9 3v11a3 3 0 006 0V3" />
                        <line x1="6" y1="3" x2="18" y2="3" />
                    </svg>
                    Test Catalogue
                </a>

                <a asp-controller="Consumable" asp-action="Index" class="nav-item active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                    </svg>
                    Consumables
                </a>

                <a asp-controller="Staff" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Staff
                </a>

                <a asp-controller="ConsumableOrder" asp-action="Index" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                    </svg>
                    Orders
                </a>

                <a asp-controller="ManagerDashboard" asp-action="TestsByCategory" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                    Reports
                </a>
            </div>

            <div class="nav-section">
                <div class="nav-label">System</div>

                <a asp-controller="ManagerDashboard" asp-action="Profile" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Profile
                </a>

                <a asp-controller="ManagerDashboard" asp-action="AuditLog" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                    Audit Log
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="main">

            <!-- PAGE HEADER -->
            <div class="page-header">
                <div>
                    <h1 class="page-title">Consumables</h1>
                    <div class="page-description">Manage laboratory consumables, suppliers and stock levels.</div>
                </div>

                <div class="header-actions">
                    <button type="button" class="btn btn-outline" onclick="openModal('m-add-supplier')">
                        + Supplier
                    </button>
                    <button type="button" class="btn btn-teal" onclick="openModal('m-add-consumable')">
                        + Add Consumable
                    </button>
                </div>
            </div>

            <!-- ALERTS -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">✓ @TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">⚠ @TempData["Error"]</div>
            }

            <!-- STATISTICS -->
            @{
                var consumableList = Model?.ToList()
                                     ?? new List<Consumable>();

                var totalConsumables = consumableList.Count;

                var lowStock = consumableList.Count(x =>
                    x.QuantityOnHand <= x.ReorderLevel);

                var mediumStock = consumableList.Count(x =>
                    x.QuantityOnHand > x.ReorderLevel &&
                    x.QuantityOnHand <= x.ReorderLevel + 20);

                var totalUnits = consumableList.Sum(x => x.QuantityOnHand);
            }

            <div class="stats-grid">

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon" style="background:var(--teal-light)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                        </div>
                    </div>
                    <div class="stat-value">@totalConsumables</div>
                    <div class="stat-label">Total Consumables</div>
                    <div class="stat-description">Active inventory items</div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon" style="background:var(--purple-light)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="var(--purple)" stroke-width="2" stroke-linecap="round"><path d="M20 7h-9M14 17H5M20 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM10 17a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" /></svg>
                        </div>
                    </div>
                    <div class="stat-value">@totalUnits</div>
                    <div class="stat-label">Total Units</div>
                    <div class="stat-description">Units currently available</div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon" style="background:var(--red-light)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                        </div>
                    </div>
                    <div class="stat-value" style="color:var(--red);">@lowStock</div>
                    <div class="stat-label">Low Stock</div>
                    <div class="stat-description">Items requiring attention</div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-icon" style="background:var(--amber-light)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                        </div>
                    </div>
                    <div class="stat-value" style="color:var(--amber);">@mediumStock</div>
                    <div class="stat-label">Medium Stock</div>
                    <div class="stat-description">Items approaching reorder level</div>
                </div>

            </div>

            <!-- TABLE CARD -->
            <div class="card">

                <div class="card-header">
                    <div>
                        <div class="card-title">Consumable Inventory</div>
                        <div class="card-subtitle">Click a row to view complete consumable information.</div>
                    </div>

                    <div class="search-box">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="searchInput" placeholder="Search consumables..." onkeyup="searchConsumables()" />
                    </div>
                </div>

                <div class="table-wrapper">
                    <table id="consumablesTable">
                        <thead>
                            <tr>
                                <th>Consumable</th>
                                <th>Supplier</th>
                                <th>On Hand</th>
                                <th>Reorder Level</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (consumableList.Any())
                            {
                                foreach (var c in consumableList)
                                {
                                    var status = c.QuantityOnHand <= c.ReorderLevel
                                        ? "Low"
                                        : c.QuantityOnHand <= c.ReorderLevel + 20
                                            ? "Medium"
                                            : "Good";

                                    var statusClass = status == "Low"
                                        ? "status-low"
                                        : status == "Medium"
                                            ? "status-medium"
                                            : "status-good";

                                    <tr class="row-clickable"
                                        data-id="@c.ConsumableID"
                                        data-name="@c.ConsumableName"
                                        data-supplier="@c.Supplier"
                                        data-supplier-id="@c.SupplierID"
                                        data-onhand="@c.QuantityOnHand"
                                        data-reorder="@c.ReorderLevel"
                                        data-status="@status"
                                        onclick="openConsumableView(this)">

                                        <td><div class="consumable-name">@c.ConsumableName</div></td>

                                        <td>
                                            @{
                                                var supplierItem = ((IEnumerable<SelectListItem>)ViewBag.Supplier)
                                                    .FirstOrDefault(s => s.Value == c.SupplierID.ToString());
                                            }
                                            @(supplierItem?.Text ?? "No supplier")
                                        </td>

                                        <td><span class="quantity">@c.QuantityOnHand</span></td>

                                        <td>@c.ReorderLevel</td>

                                        <td>
                                            <span class="status @statusClass">
                                                <span class="status-dot"></span>
                                                @status
                                            </span>
                                        </td>

                                        <td>
                                            <div class="actions">

                                                <!-- ADJUST -->
                                                <button type="button"
                                                        class="action-btn adjust-btn"
                                                        onclick="event.stopPropagation();
                                                    openAdjustModal(
                                                    @c.ConsumableID,
                                                    @Html.Raw(JsonSerializer.Serialize(c.ConsumableName)),
                                                    @c.QuantityOnHand,
                                                    @c.ReorderLevel
                                                    )">
                                                    Adjust
                                                </button>

                                                <!-- EDIT -->
                                                <button type="button"
                                                        class="action-btn edit-btn js-edit"
                                                        data-id="@c.ConsumableID"
                                                        data-name="@c.ConsumableName"
                                                        data-supplier-id="@c.SupplierID"
                                                        data-reorder="@c.ReorderLevel">
                                                    Edit
                                                </button>

                                                <!-- ORDER (replaces Delete) -->
                                                <a asp-controller="ConsumableOrder"
                                                   asp-action="Index"
                                                   class="action-btn order-btn"
                                                   onclick="event.stopPropagation();"
                                                   title="Order more @c.ConsumableName">
                                                    Order
                                                </a>

                                            </div>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6">
                                        <div class="empty-state">
                                            <div class="empty-icon">📦</div>
                                            No consumables found.
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

        </main>
    </div>

    <!-- ==========================================================
         ADD CONSUMABLE MODAL
    =========================================================== -->
    <div class="modal-overlay" id="m-add-consumable">
        <div class="modal">
            <div class="modal-header">
                <div class="modal-title">Add Consumable</div>
                <button type="button" class="modal-close" onclick="closeModal('m-add-consumable')">×</button>
            </div>

            <form asp-controller="Consumables" asp-action="AddConsumable" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <div class="fgroup2">
                        <label class="app-label">Consumable Name *</label>
                        <input type="text" class="app-finput" name="ConsumableName" placeholder="e.g. EDTA Tubes" required />
                    </div>

                    <div class="fgrid2">
                        <div class="fgroup2">
                            <label class="app-label">Quantity on Hand *</label>
                            <input type="number" class="app-finput" name="QuantityOnHand" min="0" placeholder="e.g. 100" required />
                        </div>

                        <div class="fgroup2">
                            <label class="app-label">Reorder Level *</label>
                            <input type="number" class="app-finput" name="ReorderLevel" min="0" placeholder="e.g. 50" required />
                        </div>
                    </div>

                    <div class="fgrid2">
                        <div class="fgroup2">
                            <label class="app-label">SupplierName <span class="required">*</span></label>
                            <select id="add-SupplierID" name="SupplierID" class="app-finput" required>
                                <option value="">Select supplier</option>
                                @if (ViewBag.Supplier != null)
                                {
                                    @foreach (var supplier in ViewBag.Supplier)
                                    {
                                        <option value="@supplier.Value">@supplier.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="modal-actions">
                        <button type="submit" class="btn-full teal">Add Consumable</button>
                        <button type="button" class="btn-full btn-outline" onclick="closeModal('m-add-consumable')">Cancel</button>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- ==========================================================
         ADD SUPPLIER MODAL
    =========================================================== -->
    <div class="modal-overlay" id="m-add-supplier">
        <div class="modal">
            <div class="modal-header">
                <div class="modal-title">Add Supplier</div>
                <button type="button" class="modal-close" onclick="closeModal('m-add-supplier')">×</button>
            </div>

            <form asp-controller="Consumables" asp-action="AddSupplier" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <div class="fgroup2">
                        <label class="app-label">Supplier Name *</label>
                        <input class="app-finput" name="SupplierName" placeholder="e.g. MediPath SA" required />
                    </div>

                    <div class="fgrid2">
                        <div class="fgroup2">
                            <label class="app-label">Contact Person</label>
                            <input class="app-finput" name="ContactPerson" placeholder="Contact person name" />
                        </div>

                        <div class="fgroup2">
                            <label class="app-label">Email Address *</label>
                            <input class="app-finput" type="email" name="Email" placeholder="supplier@company.co.za" required />
                        </div>
                    </div>

                    <div class="modal-actions">
                        <button type="submit" class="btn-full teal">Add Supplier</button>
                        <button type="button" class="btn-full btn-outline" onclick="closeModal('m-add-supplier')">Cancel</button>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- ==========================================================
         ADJUST STOCK MODAL
    =========================================================== -->
    <div class="modal-overlay" id="m-adjust-stock">
        <div class="modal">
            <div class="modal-header">
                <div>
                    <div class="modal-title">Adjust Stock</div>
                    <div id="adj-name" style="margin-top:4px;color:var(--muted);font-size:11px;"></div>
                </div>
                <button type="button" class="modal-close" onclick="closeModal('m-adjust-stock')">×</button>
            </div>

            <form asp-controller="Consumables" asp-action="AdjustStock" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden" id="adj-id" name="ConsumableID" value="" />

                    <div id="adj-meta" style="padding:12px 14px;margin-bottom:18px;background:var(--offwhite);border:1px solid var(--border);border-radius:8px;color:var(--muted);font-size:11px;"></div>

                    <div class="fgroup2">
                        <label class="app-label" for="stock-adj-type">Adjustment Type</label>
                        <select class="app-finput app-select" id="stock-adj-type" name="AdjustmentType" required>
                            <option value="Increase">Increase by amount</option>
                            <option value="Decrease">Decrease by amount</option>
                            <option value="Set">Set to specific value</option>
                        </select>
                    </div>

                    <div class="fgroup2">
                        <label class="app-label" for="stock-adj-val">Quantity</label>
                        <input class="app-finput" id="stock-adj-val" name="Quantity" type="number" min="0" step="1" value="" placeholder="Enter quantity" required />
                    </div>

                    <div class="modal-actions">
                        <button type="submit" class="btn-full purple">Apply Adjustment</button>
                        <button type="button" class="btn-full btn-outline" onclick="closeModal('m-adjust-stock')">Cancel</button>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- ==========================================================
         VIEW CONSUMABLE MODAL
    =========================================================== -->
    <div class="modal-overlay" id="m-view-consumable">
        <div class="modal">
            <div class="modal-header">
                <div class="modal-title">Consumable Details</div>
                <button type="button" class="modal-close" onclick="closeModal('m-view-consumable')">×</button>
            </div>

            <div class="modal-body">

                <div class="detail-grid">
                    <div class="detail-item">
                        <div class="detail-label">Consumable</div>
                        <div class="detail-value" id="cv-name"></div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Supplier</div>
                        <div class="detail-value" id="cv-supplier"></div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Reorder Level</div>
                        <div class="detail-value" id="cv-reorder"></div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Status</div>
                        <div class="detail-value" id="cv-status"></div>
                    </div>
                </div>

                <div class="stock-display">
                    <div>
                        <div class="stock-label">CURRENT STOCK</div>
                        <div class="stock-number" id="cv-onhand"></div>
