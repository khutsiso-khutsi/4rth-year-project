@using System.Text.Json
@using LabManager.Models
@model IEnumerable<Consumable>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    ViewData["Title"] = "Consumables Management";

    var suppliers = ViewBag.Suppliers as IEnumerable<Supplier>
                    ?? Enumerable.Empty<Supplier>();
    // Full supplier records come from the controller (ViewBag.SupplierList)
    var suppliers = (ViewBag.SupplierList as IEnumerable<Supplier>)?.ToList()
                    ?? new List<Supplier>();

    // SupplierID -> SupplierName lookup (string keys so int / int? both work)
    var supplierNames = suppliers.ToDictionary(s => s.SupplierID.ToString(), s => s.SupplierName);

    var email = ViewBag.Email as string ?? "";

    var consumableList = Model?.ToList() ?? new List<Consumable>();

    var totalConsumables = consumableList.Count;
    var lowStock = consumableList.Count(x => x.QuantityOnHand <= x.ReorderLevel);
    var mediumStock = consumableList.Count(x =>
        x.QuantityOnHand > x.ReorderLevel &&
        x.QuantityOnHand <= x.ReorderLevel + 20);
    var totalUnits = consumableList.Sum(x => x.QuantityOnHand);
}

